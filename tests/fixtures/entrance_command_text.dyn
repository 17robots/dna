// Drive command key and its ignored native text event in separate real frames.
entrance_event_app:*App
entrance_event_frames:usize
fn entrance_event_present() {
  entrance_event_frames+=1
  app:=entrance_event_app
  if entrance_event_frames==1 {
    event:=sdl.Event{}
    key:=#cast(*sdl.KeyEvent, &event)
    key.kind=768
    key.key=KeyV
    if !sdl.push(&event) {
      #panic("command entrance key queue")
    }
  } else if entrance_event_frames==2 {
    focused:=app.view.focused
    if !app.view.panes[0].branch || !app.view.panes[focused].geometry.active {
      #panic("split opening must start animation")
    }
    text:[2]u8=['v', 0]
    event:=sdl.Event{}
    input:=#cast(*sdl.TextEvent, &event)
    input.kind=771
    input.text=&text[0]
    if !sdl.push(&event) {
      #panic("command entrance text queue")
    }
  } else if entrance_event_frames==3 {
    if !app.view.panes[app.view.focused].geometry.active {
      #panic("ignored command text prematurely ended split animation")
    }
    if !buffer.equal(buffer.all(app.documents.current), "unchanged\n") {
      #panic("command text leaked into document")
    }
    app.view.insert=true
    text:[2]u8=['x', 0]
    event:=sdl.Event{}
    input:=#cast(*sdl.TextEvent, &event)
    input.kind=771
    input.text=&text[0]
    if !sdl.push(&event) {
      #panic("genuine entrance text queue")
    }
  } else if entrance_event_frames==4 {
    if app.view.panes[app.view.focused].geometry.active {
      #panic("genuine text must interrupt opening decoration")
    }
    if !buffer.equal(buffer.all(app.documents.current), "xunchanged\n") {
      #panic("genuine text was not inserted immediately")
    }
    app.running=false
  }
}
fn startup_probe(app:*App, typography:*Typography, renderer, window:rawptr, input_storage:[]u8) {
  entrance_event_app=app
  app.view.reduced_motion=false
  app.config.popup_transitions=true
  app.config.popup_animation_ms=50.0
  app.config.smooth_cursor=false
  app.config.smooth_scroll=false
  app.config.reload_config=false
  app.config.automatic_completion=false
  app.config.vim_keys=false
  _=buffer.load(app.documents.current, "unchanged\n")
  app.view.insert=false
  app.prompt_state.panel=Panel.Windows
  sdl.entrance_event_setup(entrance_event_present)
}
fn finish_probe(app:*App) {
  if entrance_event_frames!=4 {
    #panic("command entrance did not finish proof")
  }
}
