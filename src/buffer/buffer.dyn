use "std/unicode/utf8"
use "std/mem"


// Largest text copied in one piece: a single insertion or clipboard transfer.
// Documents themselves have no fixed
// limit; their text lives in a piece tree (rope.dyn).
pub const Capacity: usize = 268435455
// Position marks that follow edits: pane views use 0-989, the jump list 992-1023.
pub const MarkCount: usize = 1024
// Documents of this size use mapping, background operations and windowed syntax.
pub const LargeFile: usize = 16777216

pub struct RowAnchors { count: usize, offsets: [256]usize }
pub struct Snapshot {
  line_positions: bool,
  prefix: usize,
  removed: usize,
  inserted: usize,
  // Private memory this step keeps alive: its removed and inserted bytes,
  // except those still in a mapped file, which cost no private memory.
  cost: usize,
  length: usize,
  cursor: usize,
  anchor: usize,
  root: *RopeNode,
  secondary: SelectionSet,
  rows: RowAnchors,
}

// Allocate Document in an arena, not on the call stack. All retained bytes are
// owned here; no slices from file I/O, native rendering, or frame scratch survive a call.
pub struct Document {
  // Optional owner notification. It only marks deferred work; callbacks must not
  // edit the document, execute services, or retain temporary mutation storage.
  change_context: rawptr,
  on_change: fn(rawptr),
  notification_depth: usize,
  notification_pending: bool,
  batching, goal_valid: bool,
  dirty_cached, dirty_text: bool,
  dirty_revision, dirty_epoch, dirty_scans: u64,
  // Runs known equal to the saved text, measured from either end. Edits only
  // shrink these bounds; a proven clean state or save resets them.
  saved_prefix, saved_suffix: usize,
  checkpoint_prefix, checkpoint_suffix: usize,
  changes: [128]TextChange,
  // Text is a persistent piece tree. The saved baseline and every undo entry
  // retain their own root; unchanged subtrees are shared, not copied.
  root, saved_root: *RopeNode,
  // A tail still loading in the background (lazy.dyn) and LoadComplete,
  // LoadRunning or LoadFailed.
  lazy: *LazyLoad,
  load_state: u8,
  // Last leaf read by byte_at, so sequential reads cost no tree descent.
  cache_data: *const u8,
  cache_low, cache_high: usize,
  views: *TextView,
  view_count: usize,
  secondary: SelectionSet,
  length, cursor, anchor, saved_length, history_count, history_at, line_count, goal_column, goal_cursor, goal_anchor: usize,
  history: [64]Snapshot,
  saved_epoch, checkpoint_revision, revision, goal_revision: u64,
  marks: [MarkCount]usize,
  rows, saved_rows: RowAnchors,
}

// The document borrows the context until cleared or its owner releases it.
// Rebinding replaces the prior observer without calling either callback.
pub fn observe(document: *Document, context: rawptr, changed: fn(rawptr)) {
  document.change_context = context
  document.on_change = changed
}
pub fn clear_observer(document: *Document) {
  document.on_change = nil
  document.change_context = nil
}
// Compound edits rebuild marks/selections after nested text replacements. Only
// their outer completion publishes the notification; the revision journal stays
// unchanged and still records each internal edit for incremental consumers.
fn begin_change(document: *Document) {
  document.notification_depth += 1
}
fn end_change(document: *Document) {
  document.notification_depth -= 1
  if document.notification_depth == 0 && document.notification_pending {
    notify_changed(document)
  }
}
fn notify_changed(document: *Document) {
  document.notification_pending = true
  if document.notification_depth != 0 {
    return
  }
  document.notification_pending = false
  if document.on_change != nil {
    document.on_change(document.change_context)
  }
}


// Own the full bounded address range without eagerly touching unused text/undo
// pages. Works with reused/poisoned arenas too: metadata is explicitly zeroed,
// and load/checkpoint initialize every byte before it becomes readable.
pub fn try_allocate(arena: *mem.Arena) *Document {
  allocated := mem.arena_try_push_uninit(arena, #sizeof(Document), #alignof(Document))
  if !allocated.ok {
    return nil
  }
  document := #cast(*Document, allocated.memory)
  memory := #cast(*u8, document)
  mem.zero(memory[..#sizeof(Document)])
  _ = load(document, "")
  return document
}
pub fn allocate(arena: *mem.Arena) *Document {
  result := try_allocate(arena)
  if result == nil {
    #panic("cannot allocate document")
  }
  return result
}
pub fn equal(a: []const u8, b: []const u8) bool {
  if #len(a) != #len(b) {
    return false
  }
  if #len(a) == 0 {
    return true
  }
  return compare_bytes(&a[0], &b[0], #len(a)) == 0
}
// UTF-8 without NUL. Aligned ASCII runs are checked a word at a time, so
// loading a large file costs a fraction of decoding it byte by byte.
pub fn valid(text: []const u8) bool {
  length := #len(text)
  at: usize = 0
  for at < length {
    if length - at >= 8 && (#cast(usize, &text[at]) & 7) == 0 {
      word := (#cast(*const u64, &text[at])).*
      // No high bits means every byte is ASCII; adding 0x7f to each byte then
      // sets its high bit exactly when the byte is nonzero, without carries.
      if (word & 0x8080808080808080) == 0 && ((word + 0x7f7f7f7f7f7f7f7f) & 0x8080808080808080) == 0x8080808080808080 {
        at += 8
        continue
      }
    }
    byte := text[at]
    if byte == 0 {
      return false
    }
    if byte < 128 {
      at += 1
      continue
    }
    decoded := utf8.decode(text, at)
    if !decoded.ok {
      return false
    }
    at += decoded.width
  }
  return true
}
fn snapshot(document: *Document, index: usize) {
  document.checkpoint_revision = document.revision
  document.checkpoint_prefix = document.length
  document.checkpoint_suffix = document.length
  entry := &document.history[index]
  entry.secondary = document.secondary
  entry.rows = document.rows
  entry.length = document.length
  entry.cursor = document.cursor
  entry.anchor = document.anchor
  retained := rope_retain(document.root)
  rope_release(entry.root)
  entry.root = retained
}
fn set_saved(document: *Document) {
  document.saved_epoch += 1
  document.saved_rows = document.rows
  document.saved_length = document.length
  retained := rope_retain(document.root)
  rope_release(document.saved_root)
  document.saved_root = retained
  document.saved_prefix = document.length
  document.saved_suffix = document.length
}
pub fn mark_saved(document: *Document) {
  set_saved(document)
  notify_changed(document)
}
// Baselines preserve only original bytes inside the changed range. Equal
// prefixes/suffixes remain borrowed from current text, including shifted suffixes.
// Equal prefix/suffix runs shrink to exclude every changed range, so dirty
// checks and checkpoint diffs compare only what may differ.
fn shrink_bounds(document: *Document, prefix: *usize, suffix: *usize, low: usize, high: usize) {
  if low < prefix.* {
    prefix.* = low
  }
  remaining := document.length - high
  if remaining < suffix.* {
    suffix.* = remaining
  }
}
fn saved_change(document: *Document, low: usize, high: usize) {
  shrink_bounds(document, &document.saved_prefix, &document.saved_suffix, low, high)
}
fn before_change(document: *Document, low: usize, high: usize) {
  note_change(document, low, high)
  saved_change(document, low, high)
  shrink_bounds(document, &document.checkpoint_prefix, &document.checkpoint_suffix, low, high)
}
pub fn load(document: *Document, text: []const u8) bool {
  if !valid(text) {
    return false
  }
  // Build first: text may be a view of this document.
  return load_root(document, rope_from(text))
}
// Install an owned tree as freshly loaded text with empty undo history.
fn load_root(document: *Document, root: *RopeNode) bool {
  lazy_cancel(document)
  for marker in 0..MarkCount {
    document.marks[marker] = 0
  }
  document.secondary.count = 0
  document.rows.count = 0
  set_root(document, root)
  document.cursor = 0
  document.anchor = 0
  // Reload deliberately resets undo history.
  for index in 0..document.history_count {
    rope_release(document.history[index].root)
    document.history[index].root = nil
  }
  document.history_at = 0
  document.history_count = 1
  document.revision += 1
  document.history[0].prefix = 0
  document.history[0].removed = 0
  document.history[0].inserted = 0
  set_saved(document)
  snapshot(document, 0)
  notify_changed(document)
  return true
}
fn same_rows(a: *const RowAnchors, b: *const RowAnchors) bool {
  if a.count != b.count {
    return false
  }
  for index in 0..a.count {
    if a.offsets[index] != b.offsets[index] {
      return false
    }
  }
  return true
}
// Optional stable row identities, kept outside editable/clipboard text and in history.
pub fn track_rows(document: *Document, count: usize) {
  if count > 256 {
    return
  }

  checkpoint(document)
  document.rows.count = count
  offset: usize = 0

  for index in 0..count {
    document.rows.offsets[index] = offset
    offset = line_end(document, offset) + 1
  }

  set_saved(document)
  snapshot(document, document.history_at)
  notify_changed(document)
}
// 257 means an ambiguous join of two existing rows. Callers must not apply it.
pub fn row_id(document: *const Document, offset: usize) usize {
  beginning := line_start(document, offset)
  found: usize = 0

  for index in 0..document.rows.count {
    if document.rows.offsets[index] == beginning {
      if found != 0 {
        return 257
      }
      found = index + 1
    }
  }
  return found
}
// Text equality is stable until content or the saved baseline changes. Row
// identities remain independently compared because explorer staging edits them.
pub fn dirty_cached(document: *Document) bool {
  if !document.dirty_cached || document.dirty_revision != document.revision || document.dirty_epoch != document.saved_epoch {
    document.dirty_text = saved_text_changed(document)
    if !document.dirty_text {
      document.saved_prefix = document.length
      document.saved_suffix = document.length
    }
    document.dirty_revision = document.revision
    document.dirty_epoch = document.saved_epoch
    document.dirty_cached = true
    document.dirty_scans += 1
  }
  return document.dirty_text || !same_rows(&document.rows, &document.saved_rows)
}
pub fn dirty(document: *const Document) bool {
  return saved_text_changed(document) || !same_rows(&document.rows, &document.saved_rows)
}
fn saved_text_changed(document: *const Document) bool {
  if document.root == document.saved_root {
    return false
  }
  if document.length != document.saved_length {
    return true
  }
  low := document.saved_prefix
  high := document.length - document.saved_suffix
  if low >= high {
    return false
  }
  return !rope_equal(document.root, low, document.saved_root, low, high - low)
}
pub fn start(document: *const Document) usize {
  if document.cursor < document.anchor {
    return document.cursor
  }
  return document.anchor
}
pub fn end(document: *const Document) usize {
  if document.cursor > document.anchor {
    return document.cursor
  }
  return document.anchor
}
// Retained view positions follow edits, including changes applied by undo/redo.
fn move_marks(document: *Document, low: usize, high: usize, inserted: usize) {
  for mark in 0..MarkCount {
    offset := document.marks[mark]
    if offset > document.length {
      offset = document.length
    }
    if offset >= high {
      offset = offset - (high - low) + inserted
    }
    else if offset > low {
      offset = low + inserted
    }
    document.marks[mark] = offset
  }
  selection: usize = 0
  for selection < document.secondary.count {
    range := &document.secondary.ranges[selection]
    range.cursor = shifted_mark(range.cursor, low, high, inserted, document.length)
    range.anchor = shifted_mark(range.anchor, low, high, inserted, document.length)
    selection += 1
  }
}
fn shifted_mark(position: usize, low: usize, high: usize, inserted: usize, length: usize) usize {
  offset := position
  if offset > length {
    offset = length
  }
  if offset >= high {
    return offset - (high - low) + inserted
  }
  if offset > low {
    return low + inserted
  }
  return offset
}
pub fn replace(document: *Document, text: []const u8) bool {
  if !valid(text) {
    return false
  }
  // Build the new tree before anything is released: text may be a view.
  replace_built(document, rope_replace(rope_retain(document.root), start(document), end(document), text), #len(text))
  return true
}
// Install root, an owned tree equal to the document with the selection
// replaced by inserted bytes, as one edit.
fn replace_built(document: *Document, root: *RopeNode, inserted: usize) {
  low := start(document)
  high := end(document)
  removed := high - low
  before_change(document, low, high)
  move_marks(document, low, high, inserted)
  // Whole-row deletion removes its identity; filename replacement retains it.
  // Inserting at a row start moves its identity with the original text.
  identity: usize = 0
  for identity < document.rows.count {
    offset := document.rows.offsets[identity]
    if offset <= document.length {
      ending := line_end(document, offset)
      if low <= offset && high > ending {
        offset = Capacity + 1
      }
      else if offset >= high {
        offset = offset - removed + inserted
      }
      else if offset >= low {
        offset = low
      }
      document.rows.offsets[identity] = offset
    }
    identity += 1
  }
  set_root(document, root)
  document.cursor = low + inserted
  document.anchor = document.cursor
  document.revision += 1
  identity = 0
  for identity < document.rows.count {
    if document.rows.offsets[identity] <= document.length {
      document.rows.offsets[identity] = line_start(document, document.rows.offsets[identity])
    }
    identity += 1
  }
  notify_changed(document)
}
// Shrinking block sizes for the checkpoint diff's prefix and suffix scans.
const Blocks: [4]usize = [65536, 1024, 16, 1]
pub fn checkpoint(document: *Document) {
  if document.batching {
    return
  }
  entry := &document.history[document.history_at]
  if !checkpoint_changed(document) && same_rows(&document.rows, &entry.rows) {
    entry.cursor = document.cursor
    entry.anchor = document.anchor
    entry.secondary = document.secondary
    document.checkpoint_revision = document.revision
    document.checkpoint_prefix = document.length
    document.checkpoint_suffix = document.length
    // Equal text: share the current tree so later comparisons are free.
    retained := rope_retain(document.root)
    rope_release(entry.root)
    entry.root = retained
    return
  }
  previous := entry.root
  prefix := document.checkpoint_prefix
  old_length := entry.length
  old_end := old_length - document.checkpoint_suffix
  new_end := document.length - document.checkpoint_suffix
  if old_end < prefix {
    old_end = prefix
  }
  if new_end < prefix {
    new_end = prefix
  }
  // Narrow the recorded bounds to the bytes that really differ, with
  // shrinking block sizes; a large file costs a few thousand comparisons.
  for block in Blocks {
    for prefix + block <= old_end && prefix + block <= new_end && rope_equal(previous, prefix, document.root, prefix, block) {
      prefix += block
    }
  }
  for block in Blocks {
    for old_end >= prefix + block && new_end >= prefix + block && rope_equal(previous, old_end - block, document.root, new_end - block, block) {
      old_end -= block
      new_end -= block
    }
  }
  // A new edit discards redo entries.
  for discarded in document.history_at + 1..document.history_count {
    rope_release(document.history[discarded].root)
    document.history[discarded].root = nil
  }
  document.history_count = document.history_at + 1
  if document.history_count == 64 {
    rope_release(document.history[0].root)
    for shifted in 1..document.history_count {
      document.history[shifted - 1] = document.history[shifted]
    }
    document.history[63].root = nil
    document.history_count -= 1
  }
  document.history_at = document.history_count
  document.history_count += 1
  target := &document.history[document.history_at]
  target.line_positions = false
  target.prefix = prefix
  target.removed = old_end - prefix
  target.inserted = new_end - prefix
  target.cost = rope_private_bytes(previous, prefix, old_end) + rope_private_bytes(document.root, prefix, new_end)
  snapshot(document, document.history_at)
  // Trees share unchanged text, but each step can keep its replaced bytes
  // alive. Drop the oldest steps once their changes exceed the budget.
  for document.history_count > 2 && history_bytes(document) > HistoryBudget {
    rope_release(document.history[0].root)
    for shifted in 1..document.history_count {
      document.history[shifted - 1] = document.history[shifted]
    }
    document.history[document.history_count - 1].root = nil
    document.history_count -= 1
    document.history_at -= 1
  }
}
// Private bytes removed or inserted by retained undo steps.
const HistoryBudget: usize = 1073741824
fn history_bytes(document: *const Document) usize {
  total: usize = 0
  for index in 1..document.history_count {
    total += document.history[index].cost
  }
  return total
}
fn restore(document: *Document, delta: *const Snapshot, forward: bool) {
  retained_positions: [MarkCount]TextPosition = []
  if delta.line_positions {
    for saved_mark in 0..MarkCount {
      retained_positions[saved_mark] = text_position(document, document.marks[saved_mark])
    }
  }
  removed := delta.inserted
  inserted := delta.removed
  if forward {
    removed = delta.removed
    inserted = delta.inserted
  }
  low := delta.prefix
  high := low + removed
  note_change(document, low, high)
  saved_change(document, low, high)
  move_marks(document, low, high, inserted)
  entry := &document.history[document.history_at]
  set_root(document, rope_retain(entry.root))
  document.secondary = entry.secondary
  document.rows = entry.rows
  document.cursor = entry.cursor
  document.anchor = entry.anchor
  document.revision += 1
  document.checkpoint_revision = document.revision
  document.checkpoint_prefix = document.length
  document.checkpoint_suffix = document.length
  if delta.line_positions {
    for restored_mark in 0..MarkCount {
      document.marks[restored_mark] = position_offset(document, retained_positions[restored_mark])
    }
  }
  notify_changed(document)
}
pub fn undo(document: *Document) {
  checkpoint(document)
  if document.history_at > 0 {
    delta := &document.history[document.history_at]
    document.history_at -= 1
    restore(document, delta, false)
  }
}
pub fn redo(document: *Document) {
  entry := &document.history[document.history_at]
  if checkpoint_changed(document) || !same_rows(&document.rows, &entry.rows) {
    return
  }
  if document.history_at + 1 < document.history_count {
    document.history_at += 1
    restore(document, &document.history[document.history_at], true)
  }
}
pub fn move_to(document: *Document, position: usize, extend: bool) {
  if position > document.length {
    return
  }
  document.goal_valid = false
  document.cursor = position
  if !extend {
    document.anchor = position
  }
}
pub fn line_start(document: *const Document, position: usize) usize {
  return row_start(document, row_at(document, position))
}
pub fn line_end(document: *const Document, position: usize) usize {
  row := row_at(document, position)
  if row + 1 >= document.line_count {
    return document.length
  }
  return row_start(document, row + 1) - 1
}
fn vertical_goal_valid(document: *const Document) bool {
  return document.goal_valid && document.goal_cursor == document.cursor && document.goal_anchor == document.anchor && document.goal_revision == document.revision
}
fn remember_vertical(document: *Document, column: usize) {
  document.goal_valid = true
  document.goal_column = column
  document.goal_cursor = document.cursor
  document.goal_anchor = document.anchor
  document.goal_revision = document.revision
}
pub fn vertical(document: *Document, down: bool, extend: bool) {
  beginning := line_start(document, document.cursor)
  // A boundary motion has no destination and must not scan a giant line.
  if (!down && beginning == 0) || (down && line_end(document, document.cursor) == document.length) {
    return
  }
  column: usize = 0
  scan := beginning
  if vertical_goal_valid(document) {
    column = document.goal_column
  }
  else {
    for scan < document.cursor {
      scan = next(document, scan)
      column += 1
    }
  }
  remember_vertical(document, column)
  destination: usize = 0
  if down {
    ending := line_end(document, document.cursor)
    if ending == document.length {
      return
    }
    destination = ending + 1
  } else {
    if beginning == 0 {
      return
    }
    destination = line_start(document, beginning - 1)
  }
  moved: usize = 0
  for moved < column && destination < document.length && byte_at(document, destination) != 10 {
    destination = next(document, destination)
    moved += 1
  }
  move_to(document, destination, extend)
  remember_vertical(document, column)
}
pub fn erase(document: *Document, backward: bool) {
  if document.cursor == document.anchor {
    if backward {
      document.anchor = previous(document, document.cursor)
    }
    else {
      document.anchor = next(document, document.cursor)
    }
  }
  _ = replace(document, "")
}
// Select every line the selection touches. A one-character selection on a
// newline belongs to that newline's line, not the following one.
pub fn select_line(document: *Document) {
  low := start(document)
  high := end(document)
  last := high
  if high > low {
    last = high - 1
  }
  document.anchor = line_start(document, low)
  document.cursor = line_end(document, last)
  if document.cursor < document.length {
    document.cursor += 1
  }
}
// Whole lines already selected: starts at a line start and ends after a
// newline or at the document end. A cursor on an empty line counts.
pub fn lines_selected(document: *const Document) bool {
  low := start(document)
  high := end(document)
  if high <= low || line_start(document, low) != low {
    return false
  }
  if high != document.length && byte_at(document, high - 1) != 10 {
    return false
  }
  return true
}
// Extend the selection by one whole line upward, keeping the head on top.
pub fn extend_line_above(document: *Document) {
  if !lines_selected(document) {
    select_line(document)
  }
  low := start(document)
  high := end(document)
  if low > 0 {
    low = line_start(document, low - 1)
  }
  document.goal_valid = false
  document.anchor = high
  document.cursor = low
}
pub fn find(document: *Document, query: []const u8, backwards: bool) bool {
  if #len(query) == 0 || #len(query) > document.length {
    return false
  }
  base := document.cursor
  if backwards {
    base = start(document)
  }
  step: usize = 0
  for step <= document.length + 1 {
    at := (base + step) % (document.length + 1)
    if backwards {
      at = (base + document.length - (step % (document.length + 1))) % (document.length + 1)
    }
    if at + #len(query) <= document.length && equal(range(document, at, at + #len(query)), query) {
      document.anchor = at
      document.cursor = at + #len(query)
      return true
    }
    step += 1
  }
  return false
}

// Whitespace, identifier text (including UTF-8), and punctuation form runs.
fn word_class(document: *const Document, at: usize, big: bool) u8 {
  if at >= document.length {
    return 0
  }
  byte := byte_at(document, at)
  if byte == 32 || byte == 9 || byte == 10 || byte == 13 {
    return 0
  }
  if byte >= 128 && !big {
    rune := utf8.decode(decode_window(document, at), 0)
    category := unicode_category(#cast(i32, rune.codepoint))
    if category >= 23 && category <= 25 {
      return 0
    }
    if category >= 1 && category <= 11 {
      return 1
    }
    return 2
  }
  if big || byte >= 128 || byte == 95 || (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) {
    return 1
  }
  return 2
}
pub fn word(document: *Document, direction: u8, big: bool, extend: bool) {
  at := document.cursor
  origin := document.cursor
  single := document.cursor > document.anchor && next(document, document.anchor) == document.cursor
  if single {
    if direction == 1 {
      at = document.anchor
    }
    else {
      origin = document.anchor
    }
  }
  if direction == 0 {
    kind := word_class(document, at, big)
    for at < document.length && word_class(document, at, big) == kind {
      at = next(document, at)
    }
    for at < document.length && word_class(document, at, big) == 0 {
      at = next(document, at)
    }
  } else if direction == 1 {
    at = previous(document, at)
    for at > 0 && word_class(document, at, big) == 0 {
      at = previous(document, at)
    }
    backward_kind := word_class(document, at, big)
    for at > 0 && word_class(document, previous(document, at), big) == backward_kind {
      at = previous(document, at)
    }
  } else {
    for at < document.length && word_class(document, at, big) == 0 {
      at = next(document, at)
    }
    ending_kind := word_class(document, at, big)
    for at < document.length && word_class(document, at, big) == ending_kind {
      at = next(document, at)
    }
  }
  // Selection-first: word motions select their traversed range in normal mode.
  if !extend {
    document.anchor = origin
  }
  document.cursor = at
}
pub fn boundary(document: *const Document, offset: usize) usize {
  at := offset
  if at > document.length {
    at = document.length
  }
  for at > 0 && at < document.length && (byte_at(document, at) & 192) == 128 {
    at -= 1
  }
  if at > 0 && at < document.length && (byte_at(document, at) >= 128 || byte_at(document, at - 1) >= 128) {
    preceding := previous(document, at)
    if next(document, preceding) > at {
      at = preceding
    }
  }
  return at
}

pub fn line_nonblank(document: *const Document, position: usize) usize {
  beginning := line_start(document, position)
  ending := line_end(document, position)
  at := beginning
  for at < ending && (byte_at(document, at) == 32 || byte_at(document, at) == 9 || byte_at(document, at) == 13) {
    at += 1
  }
  if at == ending {
    return beginning
  }
  return at
}
pub fn line_last(document: *const Document, position: usize) usize {
  beginning := line_start(document, position)
  ending := line_end(document, position)
  if ending > beginning && byte_at(document, ending - 1) == 13 {
    ending -= 1
  }
  if ending > beginning {
    return previous(document, ending)
  }
  return beginning
}

// Zero-based line lookup. The final empty line after a newline is a real row.
pub fn row_at(document: *const Document, position: usize) usize {
  offset := position
  if offset > document.length {
    offset = document.length
  }
  return rope_newlines_before(document.root, offset)
}
pub fn row_start(document: *const Document, row: usize) usize {
  if row >= document.line_count {
    return document.length
  }
  if row == 0 {
    return 0
  }
  return rope_after_newline(document.root, row)
}

// Count UTF-8 leading bytes directly in each leaf. Word-sized batches avoid
// per-byte document access and debug call tracing on giant status columns.
pub fn codepoints(document: *const Document, low: usize, high: usize) usize {
  count: usize = 0
  at := low
  for at < high {
    text := chunk_at(document, at)
    length := #len(text)
    if length > high - at {
      length = high - at
    }
    index: usize = 0
    for index < length {
      if length - index >= 8 && (#cast(usize, &text[index]) & 7) == 0 {
        word := (#cast(*const u64, &text[index])).*
        // A continuation byte has its top bit set and next bit clear.
        bits := ((word & ~((word & 0x4040404040404040) << 1)) & 0x8080808080808080) >> 7
        pairs := (bits & 0x00ff00ff00ff00ff) + ((bits >> 8) & 0x00ff00ff00ff00ff)
        halves := (pairs & 0x0000ffff0000ffff) + ((pairs >> 16) & 0x0000ffff0000ffff)
        count += 8 - #cast(usize, (halves + (halves >> 32)) & 255)
        index += 8
      } else {
        if (text[index] & 192) != 128 {
          count += 1
        }
        index += 1
      }
    }
    at += length
  }
  return count
}
// Up to four bytes from offset, enough to decode one UTF-8 code point.
fn decode_window(document: *const Document, offset: usize) []const u8 {
  high := offset + 4
  if high > document.length {
    high = document.length
  }
  return range(document, offset, high)
}
