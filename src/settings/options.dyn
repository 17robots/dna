// Every option DNA reads from configuration, in one table: its names, its
// default, its description and the rule its value must follow. Parsing,
// defaults, :set, :settings and the settings list all read this table.
pub enum Kind { Flag, Number, Text, Choice, Key }
pub struct Option {
  // The top-level spelling and the name :set, :settings and locks use.
  key: str,
  // The sectioned spelling: [section] local = value.
  section: str,
  local: str,
  // Configuration text that defaults() applies; empty leaves the field zero.
  default_value: str,
  // The default as people read it, when the configuration text is not it.
  shown_default: str,
  description: str,
  kind: Kind,
  // Number: the accepted range, and whether the value must be whole.
  minimum: f32,
  maximum: f32,
  integer: bool,
  // Text: the longest value in bytes, whether "" is accepted, and whether
  // control characters, quotes and backslashes are refused.
  limit: usize,
  empty: bool,
  plain: bool,
  // Choice: the accepted names, space separated; the field holds the index.
  choices: str,
  // How you like to work, rather than what a project needs: a dna.toml never
  // sets it. [project."PATH"] sections in the global file can.
  personal: bool,
  // Runs programs or makes DNA load files: a project needs trust to set it.
  trusted: bool,
  // Spelled only as [section] local; the top-level key is refused.
  only_in_section: bool,
}
pub const OptionCount: usize = 59

options: [OptionCount]Option = [
  Option{key: "font", section: "editor", local: "font", default_value: "", shown_default: "automatic", description: "Explicit font file; takes priority over font_family.", kind: .Text, limit: 4095, empty: true, plain: true, personal: true, trusted: true},
