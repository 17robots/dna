use "std/io"
use "std/mem"
use "std/errors"

// Paths are UTF-8 on every host. Native adapters reserve room for a trailing NUL.
// Zero means failure; a successful current directory is never empty.
pub fn current_directory(destination: []u8) usize {
  if #len(destination) < 2 { return 0 }
  destination[0] = 0
  return native_current_directory(destination)
}
pub fn change_directory(path: []const u8) bool {
  if #len(path) == 0 { return false }
  for byte in path { if byte == 0 { return false } }
  return native_change_directory(path)
}
pub fn process_id() u32 { return native_process_id() }
pub fn write_error(text: []const u8) { _ = io.write(io.stderr(), text) }
// This is an optional residency optimization, never required for correctness.
pub fn small_pages(memory: []u8) {
  if #len(memory) > 0 { native_small_pages(memory) }
}

// Environment values borrow destination. Argument values belong to the arena.
pub struct EnvironmentResult { value: []u8, found: bool, error: isize, kind: errors.Kind, ok: bool }
pub struct ArgumentsResult { values: [][]const u8, error: isize, kind: errors.Kind, ok: bool }
pub fn environment(name: []const u8, destination: []u8) EnvironmentResult {
  if #len(name) == 0 { return EnvironmentResult{error: -22, kind: errors.Kind.InvalidInput} }
  for byte in name {
    if byte == 0 || byte == '=' { return EnvironmentResult{error: -22, kind: errors.Kind.InvalidInput} }
  }
  return native_environment(name, destination)
}
pub fn arguments(arena: *mem.Arena) ArgumentsResult {
  mark := mem.arena_mark(arena)
  result := native_arguments(arena)
  if !result.ok { mem.arena_rewind(arena, mark) }
  return result
}
