use io "std/io"
use arena_owner "./owned_arena"
use files "./files"
use buffer "./buffer"
use "std/mem"
use std_fs "std/fs"
fn main() {
  owner := arena_owner.create(#sizeof(buffer.Document) + 2097152)
  defer arena_owner.release(owner)
  doc := buffer.allocate(owner)
  state := files.State{}
  if files.open(&state, doc, "original.txt", owner).len != 0 {
    #panic("open")
  }
  doc.anchor = 0
  doc.cursor = doc.length
  _ = buffer.replace(doc, "A replacement deliberately longer than the imposed write limit.")
  if files.save(&state, doc, "original.txt", owner).len == 0 {
    #panic("failed save accepted")
  }
  old := std_fs.read_all(owner, "original.txt", 100) catch {
    #panic("failed save lost original or unsaved changes")
  }
  if !buffer.equal(old, "original") || !buffer.dirty(doc) {
    #panic("failed save lost original or unsaved changes")
  }
}
