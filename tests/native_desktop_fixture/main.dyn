use window "vendor/window/native"
use "vendor/window/events"
use "std/ui/software"
use "std/mem"
use "std/io"
use presenter "./presenter"

fn check(ok:bool, message:[]const u8) {
  if !ok {
    #panic(message)
  }
}
fn render(renderer:*presenter.Presenter, surface:software.Surface) {
  presenter.draw(renderer, surface) catch { #panic("desktop upload") }
  pixel:[4]u8
  renderer.api.pixel_store_i(3333, 1)
  renderer.api.read_pixels(0, surface.height-1, 1, 1, 6408, 5121, #cast(rawptr, &pixel[0]))
  if pixel[0]!=17 || pixel[1]!=83 || pixel[2]!=201 || pixel[3]!=255 {
    io.println_to(io.stderr(), "desktop readback {} {} {} {} at {}x{}; GL error {}", pixel[0], pixel[1], pixel[2], pixel[3], surface.width, surface.height, renderer.api.get_error()) catch {}
    #panic("desktop GL pixel readback")
  }
  renderer.api.read_pixels(surface.width-1, 0, 1, 1, 6408, 5121, #cast(rawptr, &pixel[0]))
  check(pixel[0]==201 && pixel[1]==31 && pixel[2]==19 && pixel[3]==255, "desktop upload orientation")
}
fn main() {
  host:=window.Window{}
  window.open(&host, "DNA isolated desktop", 96, 64) catch { #panic("desktop open") }
  defer window.close(&host)
  window.listen_events(&host, true)
  window.set_title(&host, "DNA isolated desktop updated") catch err {
    case err {
      .Unsupported => {}
      _ => { #panic("desktop title") }
    }
  }
  invalid_size:=true
  window.set_size(&host, 0, 64) catch { invalid_size=false }
  check(!invalid_size, "invalid desktop size")
  resized_ok:=true
  window.set_size(&host, 112, 80) catch err {
    resized_ok=false
    case err {
      .Unsupported => {}
      _ => { #panic("desktop size request") }
    }
  }
  for attempt in 0..100 {
    window.poll(&host) catch { #panic("desktop resize poll") }
    if !resized_ok || (host.width==112 && host.height==80) { break }
    window.wait(&host, 10)
  }
  check(!resized_ok || (host.width==112 && host.height==80), "desktop resized dimensions")
  invalid_pacing:=true
  window.set_swap_interval(&host, -1) catch { invalid_pacing=false }
  check(!invalid_pacing, "invalid desktop pacing")
  // Vsync control is optional on a valid desktop context.
  window.set_swap_interval(&host, 0) catch err {
    case err {
      .Unsupported => {}
      _ => { #panic("desktop pacing control") }
    }
  }
  // EGL may acquire the resized default back buffer only at swap. Realize
  // that buffer before asserting pixels at the new drawable's outer edges.
  window.swap(&host) catch { #panic("desktop resized back buffer") }
  event:=events.Event{}
  for window.next_event(&host, &event) {}
  window.wake(&host) catch { #panic("desktop wake") }
  saved:=events.Event{}
  found:=false
  for attempt in 0..100 {
    window.poll(&host) catch { #panic("desktop wake poll") }
    for window.next_event(&host, &event) {
      if event.kind==events.Kind.Wake {
        saved=event
        found=true
      }
    }
    if found { break }
    window.wait(&host, 10)
  }
  check(found, "desktop ordered wake")
  event.kind=events.Kind.Close
  check(saved.kind==events.Kind.Wake, "desktop owned event copy")
  renderer:=presenter.Presenter{}
  presenter.open(&renderer) catch { #panic("desktop presenter open") }
  dup_open:=true
  presenter.open(&renderer) catch { dup_open=false }
  check(!dup_open, "desktop duplicate presenter open")
  owner:=mem.arena_alloc(0)
  defer mem.arena_release(owner)
  pixels:=mem.push_bytes(owner, #cast(usize, host.width)*#cast(usize, host.height)*4)
  for i in 0..pixels.len/4 {
    pixels[i*4]=17
    pixels[i*4+1]=83
    pixels[i*4+2]=201
    pixels[i*4+3]=255
  }
  last:=pixels.len-4
  pixels[last]=201
  pixels[last+1]=31
  pixels[last+2]=19
  surface:=software.Surface{pixels:pixels, width:host.width, height:host.height, stride:#cast(usize, host.width)*4}
  render(&renderer, surface)
  window.swap(&host) catch { #panic("desktop present") }
  presenter.close(&renderer)
  check(renderer.program==0 && renderer.texture==0, "desktop presenter invalidated")
  closed_draw:=true
  presenter.draw(&renderer, surface) catch { closed_draw=false }
  check(!closed_draw, "closed desktop presenter rejects draw")
  presenter.close(&renderer)
  presenter.open(&renderer) catch { #panic("desktop presenter recreate") }
  render(&renderer, surface)
  presenter.close(&renderer)
  window.close(&host)
  closed_title:=true
  window.set_title(&host, "closed") catch { closed_title=false }
  closed_size:=true
  window.set_size(&host, 112, 80) catch { closed_size=false }
  check(!closed_title && !closed_size, "closed desktop controls")
}
