// Run only when the test runner supplies an isolated fixture directory.
fn workflow_smoke(app: *App, typography: *Typography) {
  location: [4096]u8 = [] configured := process.environment("DNA_WORKFLOW_TEST", location[..])
  if !configured.ok || !configured.found { return }
  app.directory_length = copy_text(app.directory[..], configured.value)
  path: [4096]u8 = [] initial := joined(app, "input.txt", path[..])
  key_input(app, typography, 111, 64) text_input(app, initial) key_input(app, typography, 13, 0)
  if app.panel != Panel.None || !buffer.equal(app.document.bytes[..app.document.length], "first\nsecond\n") { #panic("open workflow") }
  key_input(app, typography, 105, 0) text_input(app, "edited ") key_input(app, typography, 27, 0)
  key_input(app, typography, 113, 64)
  if app.panel != Panel.Quit { #panic("dirty quit confirmation") }
  key_input(app, typography, 27, 0)
  if !app.running || !buffer.dirty(app.document) { #panic("quit cancellation") }
  key_input(app, typography, 115, 64)
  if app.panel != Panel.None || buffer.dirty(app.document) { #panic("save workflow") }
  key_input(app, typography, 102, 64) text_input(app, "second") key_input(app, typography, 13, 0)
  if app.document.anchor != 13 || app.document.cursor != 19 { #panic("search workflow") }
  key_input(app, typography, 112, 64) text_input(app, "wide") key_input(app, typography, 13, 0)
  if app.popup_width != 0.86 || app.document.anchor != 13 { #panic("palette layout preserves selection") }
  action(app, typography, 8)
  layout_storage: [4096]u8 = [] layout_path := joined(app, "test.dna-layout", layout_storage[..])
  text_input(app, layout_path) key_input(app, typography, 13, 0)
  if app.panel != Panel.None || typography.points != 22.0 || app.popup_width != 0.8 { #panic("layout file workflow") }
  key_input(app, typography, 101, 64) key_input(app, typography, 99, 0)
  text_input(app, "created.txt") key_input(app, typography, 13, 0)
  if app.panel != Panel.Directory { #panic("create workflow") }
  target: usize = 0 for target < app.entry_count && !buffer.equal(app.entries[target].name[..app.entries[target].length], "created.txt") { target += 1 }
  if target == app.entry_count { #panic("created entry missing") }
  app.entry_selected = target key_input(app, typography, 114, 0) text_input(app, "renamed.txt") key_input(app, typography, 13, 0)
  if app.panel != Panel.Directory { #panic("rename workflow") }
  renamed: usize = 0 for renamed < app.entry_count && !buffer.equal(app.entries[renamed].name[..app.entries[renamed].length], "renamed.txt") { renamed += 1 }
  if renamed == app.entry_count { #panic("renamed entry missing") }
  app.entry_selected = renamed key_input(app, typography, 100, 0)
  if app.panel != Panel.Trash { #panic("trash confirmation") }
  key_input(app, typography, 27, 0)
  action(app, typography, 7)
  app.entry_selected = renamed key_input(app, typography, 100, 0) key_input(app, typography, 13, 0)
  if app.panel != Panel.Directory { #panic("trash workflow") }
  trash_storage: [4096]u8 = [] trashed := joined(app, ".dna-trash/renamed.txt", trash_storage[..])
  if !files.metadata(trashed).ok { #panic("recoverable trash missing") }
  app.panel = Panel.None
  // Layout/zoom must produce real multiline font geometry.
  if !ttf.set(typography.document, &app.document.bytes[0], app.document.length) { #panic("smoke text") }
  width: i32 = 0 height: i32 = 0
  if !ttf.size(typography.document, &width, &height) || #cast(f32) height < typography.line * 2.0 { #panic("multiline geometry") }
  typography.points = 30.0 resize_font(typography)
  larger: i32 = 0
  if !ttf.size(typography.document, &width, &larger) || larger <= height { #panic("font zoom") }
  typography.points = 20.0 resize_font(typography)
}
fn whitespace_smoke(app: *App, typography: *Typography) {
  doc := app.document
  _ = buffer.load(doc, "a") app.insert = true buffer.move_to(doc, 1, false)
  text_input(app, " ")
  if !ttf.set(typography.document, &doc.bytes[0], doc.length) { #panic("space text update") }
  first := ttf.Substring{}
  if !ttf.substring(typography.document, #cast(i32) doc.cursor, &first) { #panic("space cursor") }
  text_input(app, " ")
  if !ttf.set(typography.document, &doc.bytes[0], doc.length) { #panic("second space update") }
  second := ttf.Substring{}
  if !ttf.substring(typography.document, #cast(i32) doc.cursor, &second) || second.x <= first.x { #panic("trailing space must advance cursor") }
  text_input(app, "\n    ")
  if !ttf.set(typography.document, &doc.bytes[0], doc.length) { #panic("indent text update") }
  indent := ttf.Substring{} space := ttf.Substring{}
  if !ttf.substring(typography.document, #cast(i32) doc.cursor, &indent) || indent.x <= 0 || indent.y <= second.y { #panic("indentation must advance cursor") }
  if !ttf.substring(typography.document, #cast(i32) doc.cursor - 1, &space) || space.width <= 0 { #panic("selected trailing space must have width") }
  if !buffer.equal(doc.bytes[..doc.length], "a  \n    ") { #panic("spaces must remain in document") }
  _ = buffer.load(doc, "") app.insert = false
}
fn session_smoke(app: *App, typography: *Typography) {
  original := app.active
  original_doc := app.document
  buffer.move_to(original_doc, 2, false) app.scroll_y = 30.0
  _ = buffer.replace(original_doc, "first edit") buffer.checkpoint(original_doc)
  key_input(app, typography, 58, 0) text_input(app, "enew") key_input(app, typography, 13, 0)
  if app.document == original_doc || app.buffer_count != 2 { #panic("new buffer must retain old document") }
  second := app.active
  _ = buffer.replace(app.document, "second edit") buffer.checkpoint(app.document)
  key_input(app, typography, 32, 0) key_input(app, typography, 112, 0)
  if app.active != original || app.scroll_y != 30.0 || !buffer.dirty(app.document) { #panic("buffer view restoration") }
  buffer.undo(app.document)
  if buffer.dirty(app.document) { #panic("independent undo") }
  activate(app, second)
  if !buffer.equal(app.document.bytes[..app.document.length], "second edit") { #panic("other buffer edits retained") }
  key_input(app, typography, 32, 0) key_input(app, typography, 99, 0)
  if app.panel != Panel.Quit || !app.closing_one { #panic("dirty close confirmation") }
  key_input(app, typography, 27, 0)
  if app.buffer_count != 2 { #panic("close cancellation") }
  action(app, typography, 24) key_input(app, typography, 100, 0)
  if app.buffer_count != 1 || app.active != original { #panic("close only selected buffer") }
  // Quit must discover edits in an inactive buffer.
  _ = buffer.replace(app.document, "unsaved")
  _ = new_buffer(app)
  request_quit(app)
  if app.panel != Panel.Quit || app.active != original || !app.running { #panic("hidden dirty buffer quit") }
  key_input(app, typography, 27, 0)
  _ = buffer.load(app.document, app.document.saved[..app.document.saved_length])
  next_buffer(app, false) close_clean(app)
  app.scroll_y = 0.0 app.insert = false app.extend = false
  // Palette toggles remain accessible without control modifiers.
  key_input(app, typography, 59, 1) text_input(app, "toggle status line") key_input(app, typography, 13, 0)
  if app.status_line { #panic("status toggle") }
  action(app, typography, 26)
}
fn completion_smoke(app: *App, typography: *Typography) {
  storage: [4096]u8 = [] directory := process.environment("DNA_WORKFLOW_TEST", storage[..])
  if !directory.ok || !directory.found { return }
  old := app.active before := app.buffer_count
  key_input(app, typography, 32, 0) key_input(app, typography, 102, 0)
  if app.panel != Panel.Open { #panic("leader open") }
  text_input(app, directory.value) text_input(app, "/sub")
  if app.completion_count != 1 || !app.completions[0].directory { #panic("directory suggestions") }
  key_input(app, typography, 9, 0)
  if app.prompt[app.prompt_length - 1] != '/' { #panic("Tab directory completion") }
  text_input(app, "other") key_input(app, typography, 13, 0)
  if app.panel != Panel.None || !buffer.equal(app.document.bytes[..app.document.length], "other file\n") || app.buffer_count != before + 1 { #panic("file completion and new buffer") }
  open_file(app, files.name(app.file))
  if app.buffer_count != before + 1 { #panic("duplicate open buffer") }
  key_input(app, typography, 32, 0) key_input(app, typography, 98, 0)
  text_input(app, "input.txt") key_input(app, typography, 13, 0)
  if app.active != old { #panic("filtered buffer switcher") }
  next_buffer(app, false) close_clean(app)
  expanded: [4096]u8 = [] home: [4096]u8 = [] env := process.environment("HOME", home[..])
  result := expand_home("~/", expanded[..])
  if env.ok && env.found && (#len(result) != #len(env.value) + 1 || !buffer.equal(result[..#len(env.value)], env.value)) { #panic("home expansion") }
}
