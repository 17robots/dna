extern fn startup_clock "clock_gettime"(kind: i32, time: *StartupTime) i32
extern fn startup_number "strtod"(text: *const u8, end: rawptr) f64
struct StartupTime { seconds, nanoseconds: i64 }
reported: bool = false
pub fn SDL_RenderPresent(renderer: rawptr) bool {
  next := #cast(*fn(rawptr) bool) probe_next("SDL_RenderPresent\0")
  result := next(renderer)
  if !reported {
    reported = true
    now := StartupTime{}
    _ = startup_clock(1, &now)
    start := startup_number(probe_env("DNA_STARTUP_BEGIN\0"), nil)
    elapsed := (#cast(f64) now.seconds + #cast(f64) now.nanoseconds / 1000000000.0 - start) * 1000.0
    probe_log("DNA first frame ")
    probe_decimal(elapsed)
    probe_log(" ms\n")
    event := ProbeEvent{}
    probe_kind(#cast(rawptr) &event).* = 256
    _ = probe_push(#cast(rawptr) &event)
  }
  return result
}

fn startup_now() f64 {
  now := StartupTime{}
  _ = startup_clock(1, &now)
  return #cast(f64) now.seconds * 1000.0 + #cast(f64) now.nanoseconds / 1000000.0
}
fn startup_phase(name: []const u8, start: f64) {
  if probe_env("DNA_STARTUP_TRACE\0") != nil {
    probe_log(name)
    probe_decimal(startup_now() - start)
    probe_log(" ms\n")
  }
}
pub fn SDL_Init(flags: u32) bool {
  next := #cast(*fn(u32) bool) probe_next("SDL_Init\0")
  start := startup_now()
  result := next(flags)
  startup_phase("SDL init ", start)
  return result
}
pub fn SDL_CreateWindow(title: *const u8, width: i32, height: i32, flags: u64) rawptr {
  next := #cast(*fn(*const u8, i32, i32, u64) rawptr) probe_next("SDL_CreateWindow\0")
  start := startup_now()
  result := next(title, width, height, flags)
  startup_phase("window ", start)
  return result
}
pub fn SDL_CreateRenderer(window: rawptr, name: *const u8) rawptr {
  next := #cast(*fn(rawptr, *const u8) rawptr) probe_next("SDL_CreateRenderer\0")
  start := startup_now()
  result := next(window, name)
  startup_phase("renderer ", start)
  return result
}
pub fn TTF_OpenFont(path: *const u8, size: f32) rawptr {
  next := #cast(*fn(*const u8, f32) rawptr) probe_next("TTF_OpenFont\0")
  start := startup_now()
  result := next(path, size)
  startup_phase("font ", start)
  return result
}
