#target(kernel: darwin)
#link("System")

extern fn frontend_isatty "isatty"(descriptor: i32) i32
extern fn handoff_unsetenv "unsetenv"(name: *const u8) i32
extern fn handoff_setenv "setenv"(name: *const u8, value: *const u8, overwrite: i32) i32
extern fn operation_clock_raw "clock_gettime"(kind: i32, time: *ThreadTime) i32
fn thread_clock(kind: i32, time: *ThreadTime) i32 {
  native := kind
  if kind == 3 {
    native = 16
  }
  if kind == 2 {
    native = 12
  }
  return operation_clock_raw(native, time)
}
fn frontend_display_available() bool {
  return true
}
