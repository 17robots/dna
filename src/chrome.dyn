fn add_number(output: []u8, used: *usize, number: usize) {
  digits: [24]u8 = [] value := number count: usize = 0
  for true { digits[count] = #cast(u8) (value % 10) + 48 count += 1 value /= 10 if value == 0 { break } }
  for count > 0 { count -= 1 add_text(output, used, digits[count..count + 1]) }
}
fn line_number(doc: *const buffer.Document) usize {
  row: usize = 1 at: usize = 0 for at < doc.cursor { if doc.bytes[at] == 10 { row += 1 } at += 1 } return row
}
fn chrome_text(typography: *Typography, text: []const u8, x: f32, y: f32, active: bool) {
  red: u8 = 115 green: u8 = 131 blue: u8 = 144
  if active { red = 190 green = 209 blue = 214 }
  if !ttf.color(typography.chrome, red, green, blue, 255) || !ttf.set(typography.chrome, &text[0], #len(text)) || !ttf.draw(typography.chrome, x, y) { #panic("chrome draw failed") }
}
fn draw_chrome(renderer: rawptr, app: *App, typography: *Typography, width: i32, height: i32, margin: f32, gutter: f32) {
  doc := app.document current := line_number(doc)
  if app.line_numbers {
    row: usize = 1 at: usize = 0 y := margin - app.scroll_y
    bottom := #cast(f32) height if app.status_line { bottom -= typography.line }
    for true {
      if y >= bottom { break }
      if y + typography.line > 0.0 {
        number := row
        if app.relative_numbers && row != current { if row > current { number = row - current } else { number = current - row } }
        label: [32]u8 = [] length: usize = 0 add_number(label[..], &length, number)
        x := margin + gutter - (#cast(f32) length + 2.0) * typography.cell
        chrome_text(typography, label[..length], x, y, row == current)
      }
      for at < doc.length && doc.bytes[at] != 10 { at += 1 }
      if at == doc.length { break } at += 1 row += 1 y += typography.line
    }
  }
  if app.status_line {
    bar := sdl.Rect{x: 0.0, y: #cast(f32) height - typography.line, width: #cast(f32) width, height: typography.line}
    if !sdl.color(renderer, 30, 37, 44, 255) || !sdl.fill(renderer, &bar) { #panic("status background") }
    text: [8192]u8 = [] used: usize = 0
    if app.insert { add_text(text[..], &used, "INSERT") } else if app.extend { add_text(text[..], &used, "SELECT") } else { add_text(text[..], &used, "NORMAL") }
    add_text(text[..], &used, "  ")
    path := files.name(app.file) leaf := #len(path) for leaf > 0 && path[leaf - 1] != '/' { leaf -= 1 }
    if #len(path) == 0 { add_text(text[..], &used, "Untitled") } else { add_text(text[..], &used, path[leaf..]) }
    if buffer.dirty(doc) { add_text(text[..], &used, " [+]") }
    add_text(text[..], &used, "  ") add_number(text[..], &used, app.buffer_count) if app.buffer_count == 1 { add_text(text[..], &used, " buffer  ") } else { add_text(text[..], &used, " buffers  ") }
    add_number(text[..], &used, current) add_text(text[..], &used, ":")
    column: usize = 1 offset := buffer.line_start(doc, doc.cursor)
    for offset < doc.cursor { column += 1 offset = buffer.next(doc, offset) }
    add_number(text[..], &used, column)
    if doc.anchor != doc.cursor {
      count: usize = 0 selected := buffer.start(doc)
      for selected < buffer.end(doc) { count += 1 selected = buffer.next(doc, selected) }
      add_text(text[..], &used, "  selected ") add_number(text[..], &used, count)
    }
    add_text(text[..], &used, "  : commands")
    chrome_text(typography, text[..used], margin, bar.y, true)
  }
}
