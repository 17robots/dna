// Bounded text cache with hash chains and global least-recently-used eviction.
// Content and font identity define a reusable layout;
// tint and screen position are applied per draw. Long labels use the existing path.
// A 1440p pane plus picker uses more than 128 simultaneous labels. Leave
// bounded room for that working set and changing cursor/status labels.
const UiTextCapacity: usize = 256
const UiTextBuckets: usize = 64
const UiTextBytes: usize = 512
struct UiCachedText {
  handle: rawptr,
  hash: u64,
  stamp: u64,
  length: usize,
  next: usize
}
struct UiTextCache {
  serial: u64,
  count: usize,
  buckets: [UiTextBuckets]usize,
  entries: [UiTextCapacity]UiCachedText,
  bytes: [UiTextCapacity * UiTextBytes]u8,
}
fn ui_cache_clear(typography: *Typography) {
  cache := typography.ui_cache

  if cache == nil { return }


  for index in 0..UiTextCapacity {
    entry := &cache.entries[index]

    if entry.handle != nil {
      ttf.destroy(entry.handle)
      entry.handle = nil
    }

    entry.length = 0
    entry.stamp = 0
    entry.next = UiTextCapacity
  }

  cache.count = 0

  for index in 0..UiTextBuckets {
    cache.buckets[index] = UiTextCapacity
  }
}
fn ui_cache_release(typography: *Typography) {
  ui_cache_clear(typography)

  if typography.ui_cache != nil {
    arena_owner.release(typography.ui_owner)
    typography.ui_owner = nil

    if typography.observer != nil {
      allocation_record(typography.observer, "ui_text_cache", #sizeof(UiTextCache) + 16, typography.ui_born, true)
    }

    typography.ui_cache = nil
  }
}
fn cached_ui_text(typography: *Typography, text: str) rawptr {
  if text.len == 0 || text.len >= UiTextBytes { return nil }

  if typography.ui_cache == nil {
    allocated := arena_owner.create(#sizeof(UiTextCache) + 16)
    host.small_pages(allocated.data)
    typography.ui_owner = allocated
    allocated = nil

    if typography.observer != nil {
      if typography.observer.render_trace.enabled {
        typography.ui_born = render_clock()
      }
      allocation_record(typography.observer, "ui_text_cache", #sizeof(UiTextCache) + 16, typography.ui_born, false)
    }

    // Fresh OS pages stay untouched by push_array; only buckets need non-zero sentinels.
    created_cache := &mem.push_array<UiTextCache>(typography.ui_owner, 1)[0]
    for bucket_index in 0..UiTextBuckets {
      created_cache.buckets[bucket_index] = UiTextCapacity
    }
    typography.ui_cache = created_cache
  }

  cache := typography.ui_cache
  cache.serial += 1
  hash: u64 = 5381
  for byte in text {
    hash = #wrapping(hash * 33) ^ byte
  }
  bucket := #cast(usize, (hash ^ (hash >> 16)) & (UiTextBuckets - 1))
  index := cache.buckets[bucket]

  for index != UiTextCapacity {
    entry := &cache.entries[index]

    if entry.hash == hash && entry.length == text.len && buffer.equal(cache.bytes[index * UiTextBytes..index * UiTextBytes + entry.length], text) {
      entry.stamp = cache.serial
      typography.ui_hits += 1
      return entry.handle
    }

    index = entry.next
  }

  chosen := cache.count

  if chosen == UiTextCapacity {
    chosen = 0
    for slot in 1..UiTextCapacity {
      if cache.entries[slot].stamp < cache.entries[chosen].stamp {
        chosen = slot
      }
    }

    previous := &cache.entries[chosen]
    old_bucket := #cast(usize, (previous.hash ^ (previous.hash >> 16)) & (UiTextBuckets - 1))
    link := &cache.buckets[old_bucket]

    for link.* != UiTextCapacity && link.* != chosen {
      link = &cache.entries[link.*].next
    }

    if link.* == chosen {
      link.* = previous.next
    }
  } else {
    cache.count += 1
  }

  selected := &cache.entries[chosen]

  if selected.handle == nil {
    blank: [1]u8 = [0]
    selected.handle = ttf.create(typography.engine, typography.font, &blank[0], 0)

    if selected.handle != nil {
      typography.ui_creations += 1
    }
  }
  if selected.handle == nil {
    selected.stamp = 0
    selected.next = UiTextCapacity
    return nil
  }
  if !ttf.set(selected.handle, &text[0], text.len) {
    selected.stamp = 0
    selected.length = 0
    selected.next = UiTextCapacity
    return nil
  }

  selected.length = copy_text(cache.bytes[chosen * UiTextBytes..(chosen + 1) * UiTextBytes], text)
  selected.hash = hash
  selected.stamp = cache.serial
  selected.next = cache.buckets[bucket]
  cache.buckets[bucket] = chosen
  typography.ui_updates += 1
  return selected.handle
}
