use "./workspace"

struct RecoveryState {
  checked, disabled: bool,
  project: [4096]u8,
  worker: rawptr,
  active: usize,
  project_length: usize,
  time: u64,
  view: u64,
  generation: u64,
  ready: bool,
  // Size of the last snapshot; larger workspaces snapshot less often.
  last_size: usize,
}
// Snapshot interval: recovery_interval_ms for small workspaces, one more
// interval per 256 KiB of snapshot, at most ten intervals. Limits disk writes
// while typing in large files; a crash loses at most a few seconds.
fn recovery_delay(app: *const App) u64 {
  base := #cast(u64, app.config.recovery_interval_ms)
  steps := app.recovery.last_size / 262144 + 1
  if steps > 10 {
    steps = 10
  }
  return base * #cast(u64, steps)
}
struct RestoredDocument { arena: *mem.Arena, document: *buffer.Document, colors: []u8, stamp: fs.Stamp }

extern fn recovery_open "dna_recovery_open"(directory: *const u8) rawptr
extern fn recovery_submit "dna_recovery_submit"(recovery: rawptr, bytes: *const u8, length: usize) i32
extern fn recovery_error "dna_recovery_error"(recovery: rawptr) i32
extern fn recovery_close "dna_recovery_close"(recovery: rawptr)

fn session_path(app: *App, argument: []const u8, output: []u8) []const u8 {
  if #len(argument) > 0 {
    return expand_home(argument, output)
  }
  length := copy_text(output, app.configuration.path[..app.configuration.path_length])
  add_text(output, &length, ".session")
  return output[..length]
}
// Recovery snapshots record large files (buffer.LargeFile and up) by path, to
// be reloaded from disk; rewriting them every few seconds would cost hundreds
// of megabytes of writes. Explicit session saves keep all text.
// Unsaved edits as one replacement against the saved file. Refuse a capture
// that cannot retain every edit; never replace recovery with a path-only entry
// for a dirty document. The worker's whole-record bound is checked separately.
// Largest single replaced region or total of new bytes a recovery record
// holds: what a session decodes as one text.
const RecoveryPatchLimit: usize = buffer.Capacity
// Edited regions above this are recorded as pieces rather than one patch.
const RecoveryPiecesMinimum: usize = 1048576
// Whole recovery record; the native worker enforces the same bound.
const RecoveryRecordLimit: usize = 1073741824
fn recovery_pieces(saved: *workspace.SavedBuffer, state: *workspace.State, doc: *const buffer.Document) bool {
  if state.patches == nil {
    state.patches = mem.arena_create(RecoveryPatchLimit + 268435456)
  }
  list := buffer.saved_pieces(doc, state.patches, RecoveryPatchLimit)
  if !list.ok {
    return false
  }
  records := mem.arena_try_push_uninit(state.patches, #len(list.pieces) * 24 + 1, 8)
  if !records.ok {
    return false
  }
  encoded := (#cast(*u8, records.memory))[..#len(list.pieces) * 24]
  for index in 0..#len(list.pieces) {
    piece := list.pieces[index]
    kind: usize = 0
    if piece.literal {
      kind = 1
    }
    words: [3]usize = [kind, piece.offset, piece.length]
    for word in 0..3 {
      for byte in 0..8 {
        encoded[index * 24 + word * 8 + byte] = #cast(u8, (words[word] >> (byte * 8)) & 255)
      }
    }
  }
  saved.patched = true
  saved.pieces = encoded
  saved.patch = list.literals
  return true
}
fn recovery_patch(saved: *workspace.SavedBuffer, state: *workspace.State, slot: *Slot) bool {
  doc := slot.document
  // Edits against a partly loaded file are recorded once it completes.
  if buffer.load_state(doc) != buffer.LoadComplete {
    return true
  }
  if !buffer.dirty_cached(doc) {
    return true
  }
  stamp := files.saved_stamp(&slot.file)
  if !stamp.ok {
    return false
  }
  low := doc.saved_prefix
  if low > doc.saved_length || low > doc.length {
    return false
  }
  suffix := doc.saved_suffix
  if suffix > doc.saved_length - low || suffix > doc.length - low {
    return false
  }
  high := doc.length - suffix
  saved.stamp = [stamp.inode, stamp.size, stamp.modify_seconds, stamp.modify_nanos]
  if high - low > RecoveryPiecesMinimum {
    // A large edited region: record pieces of the saved file plus only the
    // new bytes, never more than the region itself.
    return recovery_pieces(saved, state, doc)
  }
  saved.patched = true
  saved.patch_low = low
  saved.patch_high = doc.saved_length - suffix
  saved.patch = buffer.range(doc, low, high)
  saved.stamp = [stamp.inode, stamp.size, stamp.modify_seconds, stamp.modify_nanos]
  return true
}
fn recovery_apply_pieces(doc: *buffer.Document, saved: *const workspace.SavedBuffer) bool {
  count := #len(saved.pieces) / 24
  arena := arena_owner.create(count * #sizeof(buffer.Piece) + 64)
  defer arena_owner.release(arena)
  pieces := (#cast(*buffer.Piece, &mem.push_bytes_uninit(arena, count * #sizeof(buffer.Piece) + 16)[0]))[..count]
  for index in 0..count {
    words: [3]usize = []
    for word in 0..3 {
      for byte in 0..8 {
        words[word] |= #cast(usize, saved.pieces[index * 24 + word * 8 + byte]) << (byte * 8)
      }
    }
    if words[0] > 1 {
      return false
    }
    pieces[index] = buffer.Piece{literal: words[0] == 1, offset: words[1], length: words[2]}
  }
  if !buffer.apply_pieces(doc, pieces, saved.patch) {
    return false
  }
  buffer.checkpoint(doc)
  return true
}
fn session_capture(app: *App, state: *workspace.State, recovery: bool) bool {
  pane_init(app)
  pane_store(app)
  mem.clear(state)
  if !workspace.prepare(state, #len(app.documents.slots)) {
    notice(app, "Could not allocate session metadata. Workspace unchanged.")
    return false
  }
  state.project = app.workspace.project[..app.workspace.project_length]
  state.active = app.documents.active
  state.focused = app.view.focused
  for index in 0..#len(app.documents.slots) {
    slot := app.documents.slots[index]
    saved := workspace.buffer_mut(state, index)
    if slot.document != nil {
      doc := slot.document
      filetype: []const u8 = slot.filetype[..slot.filetype_length]
      if slot.inferred_filetype {
        filetype = ""
      }
      if slot.terminal.handle != nil {
        saved.* = workspace.SavedBuffer{used: true}
      }
      else if recovery && doc.length >= buffer.LargeFile && slot.file.length > 0 {
        saved.* = workspace.SavedBuffer{used: true, reload: true, path: files.name(&slot.file), filetype: filetype, cursor: doc.cursor, anchor: doc.anchor}
        if !recovery_patch(saved, state, slot) {
          plugin_log(app, "Cannot capture every large-file edit within the recovery limit. Previous recovery retained; save explicitly.")
          return false
        }
      }
      else {
        saved.* = workspace.SavedBuffer{used: true, path: files.name(&slot.file), text: buffer.all(doc), saved_parts: buffer.saved_parts(doc), split_saved: true, filetype: filetype, cursor: doc.cursor, anchor: doc.anchor, secondary: doc.secondary}
      }
    }
  }
  for index in 0..15 {
    pane := &app.view.panes[index]
    if pane.used {
      cursor: usize = 0
      anchor: usize = 0
      if !pane.branch && app.documents.slots[pane.slot].terminal.handle == nil {
        doc_view := app.documents.slots[pane.slot].document
        cursor = doc_view.marks[index * 2]
        anchor = doc_view.marks[index * 2 + 1]
      }
      percent: usize = 50
      if pane.branch {
        percent = #cast(usize, (pane.split_fraction * 100.0))
      }
      state.panes[index] = workspace.SavedPane{used: true, branch: pane.branch, vertical: pane.vertical, parent: pane.parent, first: pane.first, second: pane.second, slot: pane.slot, cursor: cursor, anchor: anchor, percent: percent, scroll_x: #cast(usize, pane.scroll_x), scroll_y: #cast(usize, pane.scroll_y)}
      if !pane.branch && app.documents.slots[pane.slot].terminal.handle == nil {
        state.panes[index].secondary.count = pane.secondary_count
        for selected in 0..pane.secondary_count {
          offset := #cast(usize, 32) + index * 64 + selected * 2
          target_doc := app.documents.slots[pane.slot].document
          state.panes[index].secondary.ranges[selected] = buffer.Selection{cursor: target_doc.marks[offset], anchor: target_doc.marks[offset + 1]}
        }
      }
    }
  }
  return true
}
fn session_save(app: *App, argument: []const u8) bool {
  path_storage: [4096]u8 = []
  path := session_path(app, argument, path_storage[..])
  if #len(path) == 0 || #len(path) > 3980 {
    notice(app, "Invalid session path.")
    return false
  }
  state := workspace.State{}
  defer workspace.release(&state)
  if !session_capture(app, &state, false) {
    return false
  }
  snapshot_size := workspace.encoded_size(&state)
  allocated := arena_owner.try_create(snapshot_size)
  if allocated == nil {
    notice(app, "Could not allocate a session snapshot. Workspace unchanged.")
    return false
  }
  defer arena_owner.release(allocated)
  bytes := mem.push_bytes_uninit(allocated, snapshot_size)
  length := workspace.encode(&state, bytes)
  if length == 0 {
    notice(app, "Session exceeds snapshot capacity.")
    return false
  }
  temporary: [4096]u8 = []
  used := copy_text(temporary[..], path)
  add_text(temporary[..], &used, ".tmp")
  tx := fs.atomic_begin_private(path, temporary[..used])
  if !tx.ok {
    notice(app, "Cannot create session snapshot. Ensure its parent directory exists and no .tmp file remains.")
    return false
  }
  defer {
    if tx.transaction.active {
      _ = fs.atomic_abort(&tx.transaction)
    }
  }
  if !fs.set_permissions(&tx.transaction.file, 384).ok || !fs.write(&tx.transaction.file, bytes[..length]).ok || !fs.atomic_commit(&tx.transaction).ok {
    notice(app, "Session write failed.")
    return false
  }
  notice(app, "Session saved, including unsaved text, filetypes, splits, and cursor positions.")
  return true
}
fn session_restore(app: *App, argument: []const u8) bool {
  if explorer_dirty(app) {
    notice(app, "Apply or discard explorer edits before restoring a session.")
    return false
  }
  for slot_index in 0..#len(app.documents.slots) {
    if app.documents.slots[slot_index].document != nil && (buffer.dirty_cached(app.documents.slots[slot_index].document) || app.documents.slots[slot_index].terminal.handle != nil) {
      notice(app, "Save/discard edits and close terminals before restoring a session.")
      return false
    }
  }
  path_storage: [4096]u8 = []
  path := session_path(app, argument, path_storage[..])
  info := files.metadata(path)
  if !info.ok || (info.mode & 61440) != 32768 {
    notice(app, "Session must be a regular file.")
    return false
  }
  if info.size > #cast(u64, #cast(usize, -1) - 4096) {
    return false
  }
  session_limit := #cast(usize, info.size)
  allocated := arena_owner.try_create(session_limit + 4096)
  if allocated == nil {
    notice(app, "Could not allocate session input. Workspace unchanged.")
    return false
  }
  defer arena_owner.release(allocated)
  read := fs.read_all(allocated, path, session_limit)
  state := workspace.State{}
  defer workspace.release(&state)
  if !read.ok || !workspace.decode(read.value, &state) {
    notice(app, "Invalid, truncated, or unsupported session. Workspace unchanged.")
    return false
  }
  count := workspace.buffer_count(&state)
  if count > #cast(usize, -1) / #sizeof(RestoredDocument) || #cast(u64, count) > #cast(u64, -1) - app.documents.next_identity {
    return false
  }
  metadata := arena_owner.try_create(count * #sizeof(RestoredDocument))
  if metadata == nil {
    notice(app, "Could not allocate restored buffer metadata. Workspace unchanged.")
    return false
  }
  defer arena_owner.release(metadata)
  restored := mem.try_push_array(RestoredDocument, metadata, count)
  if #len(restored) != count {
    notice(app, "Could not initialize restored metadata. Workspace unchanged.")
    return false
  }
  committed := false
  defer {
    if !committed {
      cleanup_restored(restored[..])
    }
  }
  for index in 0..count {
    saved := workspace.buffer_at(&state, index)
    if saved.used {
      memory := arena_owner.try_create(#sizeof(buffer.Document) + buffer.Capacity + 129)
      if memory == nil {
        notice(app, "Could not allocate a restored buffer. Workspace unchanged.")
        return false
      }
      restored[index].arena = memory
      memory = nil
      restored[index].document = buffer.try_allocate(restored[index].arena)
      colors := mem.arena_try_push_uninit(restored[index].arena, buffer.Capacity + 1, 1)
      if restored[index].document == nil || !colors.ok {
        notice(app, "Could not initialize a restored buffer. Workspace unchanged.")
        return false
      }
      restored[index].colors = colors.memory[..buffer.Capacity + 1]
      doc := restored[index].document
      if saved.reload {
        // Read (or map) the file straight into storage the document adopts.
        disk := files.read_document(saved.path)
        loaded := disk.ok && buffer.load_storage(doc, &disk.storage, #len(disk.data))
        stamp := disk.stamp
        restored[index].stamp = stamp
        files.release_text(&disk)
        if !loaded {
          notice(app, "A large file in the session can no longer be read. Workspace unchanged.")
          return false
        }
        if saved.patched {
          // Edits apply only to the exact file they were made against.
          same := stamp.ok && stamp.inode == saved.stamp[0] && stamp.size == saved.stamp[1] && stamp.modify_seconds == saved.stamp[2] && stamp.modify_nanos == saved.stamp[3]
          if same && #len(saved.pieces) > 0 {
            if !recovery_apply_pieces(doc, saved) {
              notice(app, "Cannot apply recovered edits. Workspace and recovery record unchanged.")
              return false
            }
          } else if same && saved.patch_high <= doc.length {
            doc.anchor = saved.patch_low
            doc.cursor = saved.patch_high
            if !buffer.replace(doc, saved.patch) {
              notice(app, "Cannot apply recovered edits. Workspace and recovery record unchanged.")
              return false
            }
            buffer.checkpoint(doc)
          } else {
            notice(app, "A large file changed on disk since its unsaved edits were recorded. Workspace and recovery record unchanged.")
            return false
          }
        }
      }
      else {
        _ = buffer.load(doc, saved.saved)
      }
      if !saved.reload && !buffer.equal(saved.text, saved.saved) {
        doc.anchor = 0
        doc.cursor = doc.length
        _ = buffer.replace(doc, saved.text)
        buffer.checkpoint(doc)
      }
      doc.secondary = saved.secondary
      selected: usize = 0
      for selected < doc.secondary.count {
        selection := &doc.secondary.ranges[selected]
        selection.cursor = buffer.boundary(doc, selection.cursor)
        selection.anchor = buffer.boundary(doc, selection.anchor)
        selected += 1
      }
      doc.cursor = buffer.boundary(doc, saved.cursor)
      doc.anchor = buffer.boundary(doc, saved.anchor)
    }
  }
  // Growing the directory never moves existing Slot records. Restore failure
  // keeps any new empty metadata unpublished and reusable by a later attempt.
  previous_length := #len(app.documents.slots)
  for #len(app.documents.slots) < count {
    if documents_append_slot(app) == nil {
      app.documents.slots = app.documents.index_storage[..previous_length]
      notice(app, "Could not grow restored buffer storage. Workspace unchanged.")
      return false
    }
  }
  if !host.change_directory(state.project) {
    app.documents.slots = app.documents.index_storage[..previous_length]
    notice(app, "Session project directory is unavailable. Workspace unchanged.")
    return false
  }
  // All parsing/allocation completed before releasing the current buffers.
  syntax_release(app)
  app.view.pane_ready = false
  app.documents.current = nil
  app.documents.file = nil
  app.documents.count = 0
  for index in 0..#len(app.documents.slots) {
    current := app.documents.slots[index]
    if current.document != nil {
      files.discard_recovery(&current.file)
      document_release(app, current)
    }
    document_lifecycle_changed(app, index)
    current.document = nil
    current.arena = nil
    if index < count {
      current.document = restored[index].document
      current.arena = restored[index].arena
      restored[index].arena = nil
    }
    current.file.length = 0
    current.file.recovery_owned = false
    current.file.path[0] = 0
    current.file.stamp = fs.Stamp{}
    current.scroll_x = 0.0
    current.scroll_y = 0.0
    current.insert = false
    current.extend = false
    current.syntax_checked = false
    current.syntax_revision = 0
    current.filetype_length = 0
    current.inferred_filetype = false
    if current.document != nil {
      current.arena_born = 0
      if app.render_trace.enabled {
        current.arena_born = render_clock()
      }
      allocation_record(app, "document", #sizeof(buffer.Document) + buffer.Capacity + 129, current.arena_born, false)
      current.colors = restored[index].colors
      current.file.stamp = restored[index].stamp
      current.disk_changed = false
      current.diagnostics.count = 0
      app.documents.next_identity += 1
      current.identity = app.documents.next_identity
      record := workspace.buffer_at(&state, index)
      if #len(record.path) > 0 {
        _ = files.set_name(&current.file, record.path)
      }
      current.filetype_length = copy_text(current.filetype[..], record.filetype)
      document_observe(app, current)
      app.documents.count += 1
    }
  }
  app.workspace.project_length = copy_text(app.workspace.project[..], state.project)
  app.directory_state.length = copy_text(app.directory_state.path[..], state.project)
  app.workspace.previous_project_length = 0
  if app.picker_state.index != nil {
    app.picker_state.index.root_length = 0
  }
  for index in 0..15 {
    source := &state.panes[index]
    pane := &app.view.panes[index]
    pane.* = Pane{}
    if source.used {
      pane.used = true
      pane.branch = source.branch
      pane.vertical = source.vertical
      pane.parent = source.parent
      pane.first = source.first
      pane.second = source.second
      pane.slot = source.slot
      pane.split_fraction = #cast(f32, source.percent) / 100.0
      pane.scroll_x = #cast(f32, source.scroll_x)
      pane.scroll_y = #cast(f32, source.scroll_y)
      if !pane.branch {
        pane.secondary_count = source.secondary.count
        for extra in 0..source.secondary.count {
          offset := #cast(usize, 32) + index * 64 + extra * 2
          extra_doc := app.documents.slots[pane.slot].document
          extra_doc.marks[offset] = buffer.boundary(extra_doc, source.secondary.ranges[extra].cursor)
          extra_doc.marks[offset + 1] = buffer.boundary(extra_doc, source.secondary.ranges[extra].anchor)
        }
        target := app.documents.slots[pane.slot].document
        target.marks[index * 2] = buffer.boundary(target, source.cursor)
        target.marks[index * 2 + 1] = buffer.boundary(target, source.anchor)
      }
    }
  }
  app.view.pane_ready = true
  app.view.focused = state.focused
  pane_load(app, app.view.focused)
  app.view.revision += 1
  app.picker_state.preview.ready = false
  app.prompt_state.panel = Panel.None
  committed = true
  return true
}
fn cleanup_restored(documents: []RestoredDocument) {
  index: usize = 0
  for index < #len(documents) {
    if documents[index].arena != nil {
      if documents[index].document != nil {
        buffer.release(documents[index].document)
      }
      arena_owner.release(documents[index].arena)
      documents[index].arena = nil
    }
    index += 1
  }
}

fn recovery_release(app: *App) {
  if app.recovery.worker != nil {
    recovery_close(app.recovery.worker)
    app.recovery.worker = nil
  }
}
fn recovery_tick(app: *App) {
  if !app.config.recovery_enabled {
    return
  }
  now := sdl.ticks()
  if now - app.recovery.time < recovery_delay(app) {
    return
  }
  app.recovery.time = now
  if !recovery_allowed(app) {
    return
  }
  if recovery_error(app.recovery.worker) != 0 {
    app.recovery.ready = false
    plugin_log(app, "Session recovery write failed. Save important edits explicitly.")
  }
  changed := recovery_needed(app)
  if !changed {
    return
  }
  if app.recovery.worker == nil {
    path: [4096]u8 = []
    parent := app.configuration.path_length
    for parent > 0 && app.configuration.path[parent - 1] != '/' {
      parent -= 1
    }
    length := copy_text(path[..], app.configuration.path[..parent])
    add_text(path[..], &length, "recovery")
    app.recovery.worker = recovery_open(&path[0])
    if app.recovery.worker == nil {
      plugin_log(app, "Cannot create session recovery directory.")
      return
    }
  }
  state := workspace.State{}
  defer workspace.release(&state)
  if !session_capture(app, &state, true) {
    return
  }
  snapshot_size := workspace.encoded_size(&state)
  if snapshot_size > RecoveryRecordLimit {
    plugin_log(app, "Recovery snapshot exceeds its size limit. Previous recovery retained; save explicitly.")
    return
  }
  work := &app.operations.recovery_encode
  if !work_acquire(app, work, snapshot_size, "recovery_encode") {
    return
  }
  defer work_finish(app, work, "recovery_encode")
  bytes := mem.push_bytes_uninit(work.arena, snapshot_size)
  encode_started := operation_begin(app)
  encoded_length := workspace.encode(&state, bytes)
  app.recovery.last_size = encoded_length
  operation_end(app, "recovery_encode", encode_started)
  copy_started := operation_begin(app)
  submitted: i32 = 0
  if encoded_length > 0 {
    submitted = recovery_submit(app.recovery.worker, &bytes[0], encoded_length)
  }
  operation_end(app, "recovery_submit", copy_started)
  if submitted != 0 {
    operation_bytes(app, "recovery_worker_copy", encoded_length)
  }
  if encoded_length > 0 && submitted != 0 {
    app.recovery.ready = true
    app.recovery.view = app.view.revision
    app.recovery.active = app.documents.active
    app.recovery.project_length = copy_text(app.recovery.project[..], app.workspace.project[..app.workspace.project_length])
    app.recovery.generation = app.documents.generation
  }
}

fn recovery_allowed(app: *App) bool {
  if !app.config.recovery_enabled {
    return false
  }
  if !app.recovery.checked {
    env: [32]u8 = []
    disabled := host.environment("DNA_RECOVERY", env[..])
    app.recovery.disabled = disabled.ok && disabled.found && buffer.equal(disabled.value, "0")
    smoke := host.environment("DYN_EDITOR_SMOKE", env[..])
    if smoke.found {
      app.recovery.disabled = true
    }
    app.recovery.checked = true
  }
  return !app.recovery.disabled
}
fn recovery_needed(app: *const App) bool {
  return !app.recovery.ready || app.documents.generation != app.recovery.generation || app.documents.active != app.recovery.active || app.view.revision != app.recovery.view || !buffer.equal(app.workspace.project[..app.workspace.project_length], app.recovery.project[..app.recovery.project_length])
}
