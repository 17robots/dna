// Pause the worker's first file read, then force short reads. The controller
// supersedes the generation before release; cancelled work must not read again.
use "std/sync"
#link("c")
extern fn search_read_delay "usleep"(microseconds: u32) i32
read_armed: sync.AtomicU32 = sync.AtomicU32{}
read_waiting: sync.AtomicU32 = sync.AtomicU32{}
read_released: sync.AtomicU32 = sync.AtomicU32{}
read_calls: sync.AtomicU32 = sync.AtomicU32{}
read_target: sync.AtomicU32 = sync.AtomicU32{}
pub fn dna_test_search_arm() {
  sync.store_u32(&read_armed, 1)
}
pub fn dna_test_search_waiting() u32 {
  return sync.load_u32(&read_waiting)
}
pub fn dna_test_search_release() {
  sync.store_u32(&read_released, 1)
}
pub fn dna_test_search_reads() u32 {
  return sync.load_u32(&read_calls)
}
pub fn read(fd: i32, output: *u8, length: usize) isize {
  if sync.load_u32(&read_armed) != 0 && length >= 65536 {
    sync.store_u32(&read_target, #cast(u32, fd) + 1)
    sync.store_u32(&read_armed, 0)
    sync.store_u32(&read_waiting, 1)
    for sync.load_u32(&read_released) == 0 {
      _ = search_read_delay(1000)
    }
  }
  if fd >= 0 && #cast(u32, fd) + 1 == sync.load_u32(&read_target) {
    _ = sync.fetch_add_u32(&read_calls, 1)
    if length > 4096 {
      length = 4096
    }
  }
  return #cast(isize, #syscall(0, fd, output, length))
}
