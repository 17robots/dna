// Reuse the editor's language classification without guessing comments in text.
fn match_syntax(app: *App, explorer: bool) buffer.ObjectSyntax {
  if explorer { return buffer.ObjectSyntax{} }
  name := filetype_name(app.documents.slots[app.documents.active])
  token := comment_token(app)
  blocks := buffer.equal(token, "\x2f/") || buffer.equal(name, "css")
  if buffer.equal(name, "css") {
    token = ""
  }
  nested := buffer.equal(name, "rust") || buffer.equal(name, "swift") || buffer.equal(name, "kotlin")
  return buffer.ObjectSyntax{line_comment: token, block_comments: blocks, nested_comments: nested}
}

// The match menu, then the step after it: inside or around an object, add,
// delete or replace a surround (the old delimiter, then the new one).
enum MatchStage { Menu, Inside, Around, Add, Delete, ReplaceOld, ReplaceNew }
struct MatchState { stage: MatchStage, from: u8, count: usize, explorer, error, syntax_error: bool }

fn match_open(app: *App, explorer: bool) {
  count := app.input_state.repeat_count
  if count == 0 {
    count = 1
  }
  app.match_state = MatchState{explorer: explorer, count: count}
  panel(app, .Match)
}
fn match_close(app: *App) {
  app.prompt_state.panel = .None
  if app.match_state.explorer {
    app.prompt_state.panel = .Directory
  }
  app.match_state.stage = .Menu
}
fn match_key(app: *App, key: u32) {
  state := &app.match_state
  if state.stage != .Menu { return }
  state.error = false
  if key == KeyI {
    state.stage = .Inside
  } else if key == KeyA {
    state.stage = .Around
  } else if key == KeyS {
    state.stage = .Add
  } else if key == KeyD {
    state.stage = .Delete
  } else if key == KeyR {
    state.stage = .ReplaceOld
  } else if key == KeyM {
    doc := app.documents.current
    extending := app.view.extend
    if state.explorer {
      doc = app.explorer.document
      extending = app.explorer.extend
    }
    if buffer.select_objects_with_syntax(doc, 109, true, state.count, true, extending, match_syntax(app, state.explorer)) {
      match_close(app)
    } else {
      state.error = true
    }
  }
}
fn match_character(app: *App, text: str) {
  state := &app.match_state
  if state.stage == .Menu || text.len == 0 { return }
  if text.len != 1 || text[0] < 32 || text[0] > 126 {
    state.error = true
    return
  }
  state.syntax_error = false
  key := text[0]
  doc := app.documents.current
  if state.explorer {
    doc = app.explorer.document
  }
  ok: bool = false
  case state.stage {
    .Inside, .Around => {
      if key == 102 || key == 116 || key == 97 || key == 99 {
        if !state.explorer && syntax_textobject(app, key, state.stage == .Around, state.count) {
          match_close(app)
        } else {
          state.error = true
          state.syntax_error = true
        }
        return
      }
      if key == 84 || key == 103 {
        state.error = true
        state.syntax_error = true
        return
      }
      ok = buffer.select_objects_with_syntax(doc, key, state.stage == .Around, state.count, false, false, match_syntax(app, state.explorer))
    }
    .Add => {
      ok = buffer.surround_with_syntax(doc, 0, 0, key, 1, match_syntax(app, state.explorer))
    }
    .Delete => {
      ok = buffer.surround_with_syntax(doc, 1, key, 0, state.count, match_syntax(app, state.explorer))
    }
    .ReplaceOld => {
      state.from = key
      state.stage = .ReplaceNew
      state.error = false
      return
    }
    .ReplaceNew => {
      ok = buffer.surround_with_syntax(doc, 2, state.from, key, state.count, match_syntax(app, state.explorer))
    }
    _ => {}
  }
  if ok {
    match_close(app)
  } else {
    state.error = true
  }
}
fn match_title(app: *const App) str {
  case app.match_state.stage {
    .Inside => { return "select inside (mi)" }
    .Around => { return "select around (ma)" }
    .Add => { return "add surround (ms): delimiter" }
    .Delete => { return "delete surround (md): delimiter" }
    .ReplaceOld => { return "replace surround (mr): old delimiter" }
    .ReplaceNew => { return "replace surround: new delimiter" }
    _ => { return "match (m)" }
  }
}
fn match_hint(stage: MatchStage, index: usize) KeyHint {
  if stage == .Menu {
    case index {
      0 => { return KeyHint{key: "m", label: "matching bracket"} }
      1 => { return KeyHint{key: "i", label: "select inside..."} }
      2 => { return KeyHint{key: "a", label: "select around..."} }
      3 => { return KeyHint{key: "s", label: "add surround..."} }
      4 => { return KeyHint{key: "r", label: "replace surround..."} }
      _ => { return KeyHint{key: "d", label: "delete surround..."} }
    }
  }
  case index {
    0 => { return KeyHint{key: "w", label: "word"} }
    1 => { return KeyHint{key: "W", label: "WORD"} }
    2 => { return KeyHint{key: "p", label: "paragraph"} }
    3 => { return KeyHint{key: "m", label: "nearest pair"} }
    4 => { return KeyHint{key: "()", label: "parentheses"} }
    5 => { return KeyHint{key: "[]", label: "square brackets"} }
    6 => { return KeyHint{key: "{}", label: "braces"} }
    7 => { return KeyHint{key: "\"", label: "double quotes"} }
    8 => { return KeyHint{key: "'", label: "single quotes"} }
    9 => { return KeyHint{key: "`", label: "backticks"} }
    10 => { return KeyHint{key: "f", label: "function (syntax)"} }
    11 => { return KeyHint{key: "t", label: "type (syntax)"} }
    12 => { return KeyHint{key: "a", label: "parameter (syntax)"} }
    _ => { return KeyHint{key: "c", label: "comment (syntax)"} }
  }
}
