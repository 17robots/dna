// Finite, interruptible visual transitions. Time comes from the caller so tests
// do not sleep and input/document state never depends on animation progress.
pub struct Tween { value, from, target, started: f32, ready, active: bool, velocity, sampled: f32 }

// Persistent panel edges. Exponential settling matches RAD's frame-rate
// independent current += (target-current)*(1-2^(-rate*dt)) response.
pub struct Rectangle { current, target: [4]f32, sampled: f32, ready, active: bool }
pub fn rectangle_seed(rect: *Rectangle, edges: [4]f32, now: f32) {
  rect.current = edges
  rect.target = edges
  rect.sampled = now
  rect.ready = true
  rect.active = false
}
pub fn rectangle_step(rect: *Rectangle, target: [4]f32, now, elapsed_ms, rate: f32, immediate: bool) {
  if !rect.ready || immediate || rate <= 0.0 {
    rectangle_seed(rect, target, now)
    return
  }
  elapsed := elapsed_ms / 1000.0
  if elapsed < 0.0 {
    elapsed = 0.0
  }
  if elapsed > 0.25 {
    elapsed = 0.25
  }
  rect.sampled = now
  rect.target = target
  amount := 1.0 - exponential(-0.69314718056 * rate * elapsed)
  rect.active = false
  for axis in 0..4 {
    rect.current[axis] += (target[axis] - rect.current[axis]) * amount
    error := target[axis] - rect.current[axis]
    if error < 0.0 {
      error = -error
    }
    if error >= 0.5 {
      rect.active = true
    }
  }
  if !rect.active {
    rect.current = target
  }
}

pub fn snap(tween: *Tween, value: f32) {
  tween.velocity = 0.0
  tween.value = value
  tween.from = value
  tween.target = value
  tween.ready = true
  tween.active = false
}
pub fn sample(tween: *Tween, now: f32, duration: f32) {
  if !tween.active {
    return
  }
  progress := (now - tween.started) / duration
  if progress >= 1.0 {
    snap(tween, tween.target)
    return
  }
  if progress < 0.0 {
    progress = 0.0
  }
  remaining := 1.0 - progress
  tween.value = tween.from + (tween.target - tween.from) * (1.0 - remaining * remaining * remaining)
}
pub fn move(tween: *Tween, target: f32, now: f32, duration: f32, immediate: bool) f32 {
  if !tween.ready || immediate {
    snap(tween, target)
    return target
  }
  sample(tween, now, duration)
  if target != tween.target {
    tween.from = tween.value
    tween.target = target
    tween.started = now
    tween.active = true
  }
  return tween.value
}

// Critically damped spring toward target, for scrolling and cursor motion.
// Retargeting keeps velocity that approaches the new target without passing
// it. Reversals shed opposing momentum rather than moving away from input.
// Reaches 99% of a jump within duration milliseconds and
// is exact for any frame timing (closed-form step, not integration).
pub fn follow(tween: *Tween, target: f32, now: f32, duration: f32, immediate: bool) f32 {
  if !tween.ready || immediate || duration <= 0.0 {
    snap(tween, target)
    tween.velocity = 0.0
    tween.sampled = now
    return target
  }
  if target != tween.target {
    delta := target - tween.value
    limit := 6.6 / (duration / 1000.0) * delta
    if delta >= 0.0 {
      if tween.velocity < 0.0 {
        tween.velocity = 0.0
      }
      if tween.velocity > limit {
        tween.velocity = limit
      }
    } else {
      if tween.velocity > 0.0 {
        tween.velocity = 0.0
      }
      if tween.velocity < limit {
        tween.velocity = limit
      }
    }
  }
  tween.target = target
  // A spring at rest starts from one short frame ago: motion begins on this
  // frame, and a stale timestamp cannot skip the whole animation.
  if !tween.active {
    tween.sampled = now - 8.0
  }
  elapsed := (now - tween.sampled) / 1000.0
  tween.sampled = now
  if elapsed > 0.0 {
    if elapsed > 0.25 {
      elapsed = 0.25
    }
    omega := 6.6 / (duration / 1000.0)
    offset := tween.value - target
    decay := exponential(-omega * elapsed)
    carried := tween.velocity + omega * offset
    tween.value = target + (offset + carried * elapsed) * decay
    tween.velocity = (tween.velocity - omega * carried * elapsed) * decay
  }
  remaining := tween.value - target
  if remaining < 0.0 {
    remaining = -remaining
  }
  speed := tween.velocity
  if speed < 0.0 {
    speed = -speed
  }
  // Settled below half a pixel and nearly at rest.
  if remaining < 0.5 && speed < 20.0 {
    tween.value = target
    tween.from = target
    tween.velocity = 0.0
    tween.active = false
  }
  else {
    tween.active = true
  }
  return tween.value
}
// e^x for the spring step; x <= 0 here. Range reduction keeps it accurate.
fn exponential(x: f32) f32 {
  if x < -30.0 {
    return 0.0
  }
  halvings: u32 = 0
  reduced := x
  for reduced < -0.5 {
    reduced = reduced * 0.5
    halvings += 1
  }
  term: f32 = 1.0
  sum: f32 = 1.0
  index: f32 = 1.0
  for index < 9.0 {
    term = term * reduced / index
    sum += term
    index += 1.0
  }
  for halvings > 0 {
    sum = sum * sum
    halvings -= 1
  }
  return sum
}
