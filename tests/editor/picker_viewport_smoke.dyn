// Logical picker rows and scroll following must agree with the actual viewport.
fn picker_viewport_setup(app: *App) {
  settings.defaults(&app.config)
  app.config.picker_preview = false
  app.config.smooth_scroll = false
  app.view.reduced_motion = true
  app.prompt_state.panel = Panel.Open
  app.resource_state.kind = 1
  app.completion.count = 24
  app.completion.selected = 9
  for index in 0..app.completion.count {
    entry := &app.completion.entries[index]
    entry.length = 0
    add_text(entry.name[..], &entry.length, "candidate ")
    add_number(entry.name[..], &entry.length, index)
  }
}
fn picker_selected_visible(app: *App, typography: *Typography) {
  found := false
  for index in 1..UiCapacity {
    item := &app.ui.boxes[index]
    if item.touched == app.ui.frame && (item.flags & UiScroll) != 0 {
      found = true
      top := #cast(f32, app.completion.selected) * typography.line
      if top < item.scroll.value - 0.1 || top + typography.line > item.scroll.value + item.rect.height + 0.1 {
        #panic("picker resize hides unchanged selected row")
      }
    }
  }
  if !found {
    #panic("picker viewport fixture has no list")
  }
}
fn picker_resize_smoke(app: *App, typography: *Typography, renderer: rawptr) {
  for style in 0..3 {
    for smooth in 0..2 {
      picker_viewport_setup(app)
      app.config.picker_style = #cast(u8, style)
      app.config.smooth_scroll = smooth != 0
      app.view.reduced_motion = smooth == 0
      app.view.animation.panel = Panel.None
      draw_picker(renderer, app, typography, 1000, 800, typography.line)
      app.view.animation.panel = Panel.Open
      draw_picker(renderer, app, typography, 1000, 300, typography.line)
      picker_selected_visible(app, typography)
      draw_picker(renderer, app, typography, 1000, 800, typography.line)
      picker_selected_visible(app, typography)
    }
  }
}
fn picker_slim_viewport_smoke(app: *App, typography: *Typography, renderer: rawptr) {
  picker_viewport_setup(app)
  for style in 1..3 {
    app.config.picker_style = #cast(u8, style)
    app.config.places[SurfacePicker] = settings.Placement{mode:settings.PlaceFloat, width:500.0, height:120.0}
    geometry := picker_geometry(app, typography, 1000, 800, typography.line, app.completion.count)
    body_bottom := geometry.body_y + #cast(f32, geometry.rows) * typography.line
    if body_bottom > geometry.rect.y + geometry.rect.height - geometry.padding + 0.1 {
      #panic("slim picker logical rows extend below its placed viewport")
    }
    draw_picker(renderer, app, typography, 1000, 800, typography.line)
    picker_selected_visible(app, typography)
    app.view.animation.panel = Panel.Open
  }
}
