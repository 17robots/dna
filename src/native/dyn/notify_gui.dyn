// Callback replacement and delivery share the existing notification mutex.
notify_gui_callback: fn(rawptr) = nil
notify_gui_data: rawptr = nil
pub fn dna_native_gui_attach(callback: fn(rawptr), data: rawptr) {
  _ = sync_mutex_lock(#cast(rawptr, &notify_delivery))
  notify_gui_callback = callback
  notify_gui_data = data
  _ = sync_mutex_unlock(#cast(rawptr, &notify_delivery))
}
fn notify_gui() {
  if notify_gui_callback != nil {
    notify_gui_callback(notify_gui_data)
  }
}
