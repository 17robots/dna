#target(kernel: darwin, arch: x86_64)
extern fn darwin_stat "stat$INODE64"(path: *const u8, result: *DarwinStat) i32
extern fn darwin_lstat "lstat$INODE64"(path: *const u8, result: *DarwinStat) i32
extern fn darwin_fstat "fstat$INODE64"(file: i32, result: *DarwinStat) i32
extern fn darwin_opendir "opendir$INODE64"(path: *const u8) *u8
extern fn darwin_readdir "readdir$INODE64"(directory: *u8) *DarwinEntry
