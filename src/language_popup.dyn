// Cursor coordinates are pane-local; popup rectangles use window coordinates.
// Prefer below the cursor, flip above when needed, and stay inside the pane.
fn language_popup_rect(pane: sdl.PixelRect, cursor_x: f32, cursor_y: f32, width: f32, height: f32, line: f32, scale: f32) sdl.Rect {
  edge := 4.0 * scale
  left := #cast(f32) pane.x + edge
  top := #cast(f32) pane.y + edge
  right := #cast(f32) (pane.x + pane.width) - edge
  bottom := #cast(f32) (pane.y + pane.height) - line - edge
  result := sdl.Rect{x: #cast(f32) pane.x + cursor_x, y: #cast(f32) pane.y + cursor_y + line, width: width, height: height}
  if result.width > right - left {
    result.width = right - left
  }
  if result.height > line * 12.0 {
    result.height = line * 12.0
  }
  if result.height > bottom - top {
    result.height = bottom - top
  }
  if result.width < 1.0 {
    result.width = 1.0
  }
  if result.height < 1.0 {
    result.height = 1.0
  }
  if result.y + result.height > bottom {
    result.y = #cast(f32) pane.y + cursor_y - result.height
  }
  if result.x + result.width > right {
    result.x = right - result.width
  }
  if result.x < left {
    result.x = left
  }
  if result.y < top {
    result.y = top
  }
  return result
}
