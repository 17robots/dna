use "vendor/window" window_api

pub fn character(window:*window_api.Window, scancode:u32, modifiers:u16, snapshot:u32) u32 {
  if scancode>255 {
    return 0
  }
  x_state:u32=0
  if (modifiers&3)!=0 {
    x_state|=1
  }
  if (modifiers&8192)!=0 {
    x_state|=2
  }
  if (modifiers&192)!=0 {
    x_state|=4
  }
  if (modifiers&768)!=0 {
    x_state|=8
  }
  if (modifiers&4096)!=0 {
    x_state|=16
  }
  if (modifiers&3072)!=0 {
    x_state|=64
  }
  consumed:u32=0
  key:usize=0
  if native_x_character(window.display, #cast(u8, scancode), x_state, &consumed, &key)==0 {
    return 0
  }
  if key<=255 {
    return #cast(u32, key)
  }
  if (key&4278190080)==16777216 {
    return #cast(u32, key&16777215)
  }
  return 0
}


extern fn native_x_character "XkbLookupKeySym"(display:rawptr, code:u8, state:u32, consumed:*u32, key:*usize) i32
