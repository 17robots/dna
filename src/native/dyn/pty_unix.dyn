#target(family: unix)

fn terminal_close_on_exec(fd: i32) {
  _ = proc_fcntl(fd, 2, 1)
}

fn terminal_start(t: *Terminal, cwd, shell, command: *const u8) bool {
  return terminal_posix_start(t, cwd, shell, command, PosixTerminalHooks{
    fork: term_forkpty, chdir: term_chdir, exit: term_exit,
    exec: term_execve, exit_descriptor: terminal_exit_descriptor,
    close_on_exec: terminal_close_on_exec,
  })
}

fn terminal_exit_native(t: *Terminal) bool {
  return proc_wait(t.pid, &t.status, 1) == t.pid
}

fn terminal_stop(t: *Terminal) {
  terminal_posix_stop(t, proc_kill, proc_wait)
}

fn terminal_resize_host(t: *Terminal, size: *const TtySize) {
  terminal_resize_native(t.fd, size)
}

fn terminal_needs_exit_poll(t: *Terminal) bool {
  return t.exited == 0 && t.read_closed != 0 && t.exit_fd < 0
}
