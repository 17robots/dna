#target(kernel: darwin, arch: aarch64)
extern fn install_darwin_stat "stat"(path:*const u8, info:*DarwinStat) i32
extern fn install_darwin_lstat "lstat"(path:*const u8, info:*DarwinStat) i32
extern fn install_darwin_fstat "fstat"(fd:i32, info:*DarwinStat) i32
extern fn install_darwin_fstatat "fstatat"(fd:i32, path:*const u8, info:*DarwinStat, flags:i32) i32
extern fn install_darwin_readdir "readdir"(directory:rawptr) *DarwinEntry
extern fn install_darwin_fdopendir "fdopendir"(fd:i32) rawptr
