struct DirectoryState {
  path: [4096]u8,
  length: usize,
  entries: [256]Entry,
  count: usize,
  selected: usize,
}

enum FileAction { Create, CreateDirectory, Rename, Trash }

struct FileEdit { kind: FileAction, name: [512]u8, original, length: usize }
struct Explorer {
  arena: *mem.Arena,
  path: [4096]u8,
  context: ExplorerContext,
  document: *buffer.Document,
  vim: VimState, vim_borrowed:bool, dispatch_pending:u8,
  insert: bool,
  extend: bool,
  commands: bool,
  stale: bool,
  quit_after_discard: bool,
  scroll_x: f32,
  scroll_y: f32,
  edits: [256]FileEdit,
  root_inode: u64,
  plan_revision: u64,
  root_device: u64,
  path_length: usize,
  edit_count: usize,
  preview_row: usize,
  retiring_text: [8192]u8,
  retiring_length: usize,
  columns_geometry: motion.Rectangle,
  columns_frame: u64,
}

fn explorer_dirty(app: *const App) bool {
  return app.explorer.document != nil && buffer.dirty_cached(app.explorer.document)
}
// Space e: the tree when that explorer style is chosen, else this one.
fn explorer_open(app: *App) {
  if app.config.explorer_style == 1 {
    tree_toggle(app)
    return
  }
  explorer_buffer_open(app)
}
fn explorer_buffer_open(app: *App) {
  if explorer_dirty(app) {
    app.directory_state.length = copy_text(app.directory_state.path[..], app.explorer.path[..app.explorer.path_length])
    app.prompt_state.panel = Panel.Directory
    return
  }
  // A fresh opening starts without ancestor columns.
  explorer_context_restart(app)
  if app.explorer.document != nil && buffer.equal(app.directory_state.path[..app.directory_state.length], app.explorer.path[..app.explorer.path_length]) && !app.explorer.stale {
    app.prompt_state.panel = Panel.Directory
    explorer_context_reset(app)
    return
  }
  app.prompt_state.panel = Panel.Directory
  directory_refresh(app)
}
fn explorer_load(app: *App) {
  if app.explorer.document == nil {
    allocated := arena_owner.create((#sizeof(buffer.Document)))
    app.explorer.arena = allocated
    allocated = nil
    app.explorer.document = buffer.allocate(app.explorer.arena)
    _ = buffer.load(app.explorer.document, "")
  }
  listing: [65536]u8 = []
  used: usize = 0
  index: usize = 0
  selected_cursor: usize = 0
  for index < app.directory_state.count {
    entry := &app.directory_state.entries[index]
    if !valid_leaf(entry.name[..entry.length]) {
      app.explorer.stale = true
      notice(app, "Directory contains a filename that cannot be edited safely.")
      return
    }
    storage: [4096]u8 = []
    path := joined(app, entry.name[..entry.length], storage[..])
    info := files.metadata(path)
    entry.inode = info.inode
    entry.device = info.device
    entry.mode = info.mode
    if info.ok {
      entry.directory = (info.mode & 61440) == 16384
    }
    if used + entry.length + 16 >= 65536 {
      app.explorer.stale = true
      notice(app, "Directory listing exceeds the editable buffer capacity.")
      return
    }
    if index == app.directory_state.selected {
      selected_cursor = used
    }
    add_text(listing[..], &used, entry.name[..entry.length])
    if entry.directory {
      add_text(listing[..], &used, "/")
    }
    add_text(listing[..], &used, "\n")
    index += 1
  }
  root := files.metadata(app.directory_state.path[..app.directory_state.length])
  app.explorer.root_inode = root.inode
  app.explorer.root_device = root.device
  retiring_length := app.explorer.document.length
  if retiring_length > 8191 {
    retiring_length = 8191
    // Do not retain half a UTF-8 scalar at the bounded snapshot's edge.
    for retiring_length > 0 && (app.explorer.document.bytes[retiring_length] & 192) == 128 {
      retiring_length -= 1
    }
  }
  app.explorer.retiring_length = copy_text(app.explorer.retiring_text[..], app.explorer.document.bytes[..retiring_length])
  _ = buffer.load(app.explorer.document, listing[..used])
  buffer.track_rows(app.explorer.document, app.directory_state.count)
  buffer.move_to(app.explorer.document, selected_cursor, false)
  app.explorer.path_length = copy_text(app.explorer.path[..], app.directory_state.path[..app.directory_state.length])
  app.explorer.scroll_x = 0.0
  app.explorer.scroll_y = 0.0
  app.explorer.insert = false
  app.explorer.extend = false
  app.explorer.vim=VimState{}
  app.explorer.stale = false
  app.explorer.edit_count = 0
  explorer_context_reset(app)
}
fn explorer_selected(app: *App) {
  doc := app.explorer.document
  if doc == nil {
    return
  }
  id := buffer.row_id(doc, doc.cursor)
  if id > 0 && id <= app.directory_state.count {
    app.directory_state.selected = id - 1
  }
  else {
    app.directory_state.selected = app.directory_state.count
  }
}
fn explorer_add_edit(app: *App, kind: FileAction, original: usize, name: []const u8) bool {
  if app.explorer.edit_count == 256 {
    return false
  }
  edit := &app.explorer.edits[app.explorer.edit_count]
  edit.kind = kind
  edit.original = original
  edit.length = copy_text(edit.name[..], name)
  app.explorer.edit_count += 1
  return true
}
fn explorer_plan(app: *App) []const u8 {
  state := &app.explorer
  doc := state.document
  state.edit_count = 0
  if doc == nil {
    return "Open the explorer first."
  }
  if state.stale {
    return "Explorer listing is stale. Discard the draft and refresh before applying more changes."
  }
  // Slices borrow the stable draft only during this function; plans own names.
  names: [256][]const u8 = []
  seen: [256]bool = []
  count: usize = 0
  at: usize = 0
  for at < doc.length {
    end := buffer.line_end(doc, at)
    id := buffer.row_id(doc, at)
    name := doc.bytes[at..end]
    at = end + 1
    if id == 257 {
      return "Two existing rows were joined. Undo the join before applying changes."
    }
    if #len(name) == 0 {
      continue
    }
    if count == 256 {
      return "Explorer supports at most 256 rows."
    }
    is_directory: bool = false
    if id > 0 {
      if id > app.directory_state.count || seen[id - 1] {
        return "Ambiguous row identity. Undo the edit before applying changes."
      }
      seen[id - 1] = true
      original := &app.directory_state.entries[id - 1]
      is_directory = original.directory
      if is_directory {
        if name[#len(name) - 1] != '/' {
          return "Keep directory rows unchanged, including their trailing slash."
        }
        name = name[..#len(name) - 1]
        if !buffer.equal(name, original.name[..original.length]) {
          return "Directory renames are not supported yet; keep that row unchanged."
        }
      }
      if !valid_leaf(name) {
        return "Each row must contain one filename without slashes or control characters."
      }
      if !is_directory && !buffer.equal(name, original.name[..original.length]) {
        if !explorer_add_edit(app, FileAction.Rename, id, name) {
          return "Too many filesystem operations."
        }
      }
    } else {
      creation := FileAction.Create
      if name[#len(name) - 1] == '/' {
        creation = FileAction.CreateDirectory
        name = name[..#len(name) - 1]
      }
      if !valid_leaf(name) {
        return "New rows need one filename, or folder name ending in /; nested paths and control characters are not allowed."
      }
      if !explorer_add_edit(app, creation, 0, name) {
        return "Too many filesystem operations."
      }
    }
    for duplicate in 0..count {
      if buffer.equal(names[duplicate], name) {
        return "Two rows name the same destination. Nothing has been applied."
      }
    }
    names[count] = name
    count += 1
  }
  missing: usize = 0
  for missing < app.directory_state.count {
    if !seen[missing] {
      original_entry := &app.directory_state.entries[missing]
      if buffer.equal(original_entry.name[..original_entry.length], ".dna-trash") {
        return "The trash directory cannot be moved into itself; restore its row."
      }
      trash_name: [512]u8 = []
      trash_length := trash_leaf(app, original_entry.name[..original_entry.length], trash_name[..])
      if trash_length == 0 {
        return "Cannot choose a free name inside .dna-trash."
      }
      if !explorer_add_edit(app, FileAction.Trash, missing + 1, trash_name[..trash_length]) {
        return "Too many filesystem operations."
      }
    }
    missing += 1
  }
  state.plan_revision = doc.revision
  return ""
}
fn edit_paths(app: *App, edit: *const FileEdit, source: []u8, destination: []u8) bool {
  if edit.original > 0 {
    entry := &app.directory_state.entries[edit.original - 1]
    if #len(joined(app, entry.name[..entry.length], source)) == 0 {
      return false
    }
  }
  if edit.kind == FileAction.Trash {
    leaf: [1024]u8 = []
    used: usize = 0
    add_text(leaf[..], &used, ".dna-trash/")
    add_text(leaf[..], &used, edit.name[..edit.length])
    return #len(joined(app, leaf[..used], destination)) > 0
  }
  return #len(joined(app, edit.name[..edit.length], destination)) > 0
}
fn explorer_affected(path: []const u8, source: []const u8, directory: bool) bool {
  if buffer.equal(path, source) {
    return true
  }
  return directory && #len(path) > #len(source) && path[#len(source)] == '/' && buffer.equal(path[..#len(source)], source)
}
fn explorer_validate(app: *App) []const u8 {
  state := &app.explorer
  if state.document == nil || state.document.revision != state.plan_revision {
    return "Draft changed after preview. Run :write again."
  }
  root := files.metadata(app.directory_state.path[..app.directory_state.length])
  if !root.ok || root.inode != state.root_inode || root.device != state.root_device {
    return "Directory changed externally; refresh before applying."
  }
  trash_storage: [4096]u8 = []
  trash_path := joined(app, ".dna-trash", trash_storage[..])
  trash := files.metadata(trash_path)
  index: usize = 0
  for index < state.edit_count {
    edit := &state.edits[index]
    source: [4096]u8 = []
    destination: [4096]u8 = []
    if !edit_paths(app, edit, source[..], destination[..]) {
      return "A filesystem path is too long."
    }
    source_length := c.string_length(&source[0], 4096)
    destination_length := c.string_length(&destination[0], 4096)
    if edit.original > 0 {
      original := &app.directory_state.entries[edit.original - 1]
      info := files.metadata(source[..source_length])
      if !info.ok || info.inode != original.inode || info.device != original.device || info.mode != original.mode {
        return "A source entry changed externally. Nothing further will be applied."
      }
      for slot_index in 0..#len(app.documents.slots) {
        slot := app.documents.slots[slot_index]
        if slot.document != nil && explorer_affected(files.name(&slot.file), source[..source_length], original.directory) {
          if buffer.dirty_cached(slot.document) {
            return "An affected file has unsaved edits in an open buffer. Save it first."
          }
          if destination_length + slot.file.length - source_length >= 4000 {
            return "An affected open file path would be too long."
          }
        }
      }
    }
    if edit.kind == FileAction.Trash && trash.ok && (trash.mode & 61440) != 16384 {
      return ".dna-trash must be a real directory, not a symlink or file."
    }
    if files.metadata(destination[..destination_length]).ok {
      return "A destination already exists. Renames cannot overwrite files or swap names in one batch."
    }
    index += 1
  }
  return ""
}
fn explorer_preview(app: *App) {
  app.explorer.commands = false
  if app.explorer.document == nil {
    notice(app, "Open the explorer first.")
    return
  }
  app.directory_state.length = copy_text(app.directory_state.path[..], app.explorer.path[..app.explorer.path_length])
  buffer.checkpoint(app.explorer.document)
  error := explorer_plan(app)
  if #len(error) == 0 {
    error = explorer_validate(app)
  }
  if #len(error) > 0 {
    notice(app, error)
    return
  }
  if app.explorer.edit_count == 0 {
    app.prompt_state.panel = Panel.Directory
    return
  }
  app.explorer.preview_row = 0
  app.prompt_state.panel = Panel.DirectoryApply
}
fn explorer_plan_text(app: *App, output: []u8) usize {
  used: usize = 0
  add_text(output, &used, "Apply ")
  add_number(output, &used, app.explorer.edit_count)
  add_text(output, &used, " filesystem changes?\n")
  add_text(output, &used, app.explorer.path[..app.explorer.path_length])
  add_text(output, &used, "\n\n")
  at := app.explorer.preview_row
  for at < app.explorer.edit_count && at < app.explorer.preview_row + 7 {
    edit := &app.explorer.edits[at]
    if edit.kind == FileAction.Create {
      add_text(output, &used, "+ create  ")
    }
    else if edit.kind == FileAction.CreateDirectory {
      add_text(output, &used, "+ folder  ")
    }
    else if edit.kind == FileAction.Trash {
      add_text(output, &used, "- trash   ")
      trashed := &app.directory_state.entries[edit.original - 1]
      if !buffer.equal(trashed.name[..trashed.length], edit.name[..edit.length]) {
        add_text(output, &used, trashed.name[..trashed.length])
        add_text(output, &used, " as ")
      }
    }
    else {
      entry := &app.directory_state.entries[edit.original - 1]
      add_text(output, &used, "~ rename  ")
      add_text(output, &used, entry.name[..entry.length])
      add_text(output, &used, " -> ")
    }
    add_text(output, &used, edit.name[..edit.length])
    if edit.kind == FileAction.CreateDirectory || (edit.original > 0 && app.directory_state.entries[edit.original - 1].directory) {
      add_text(output, &used, "/")
    }
    add_text(output, &used, "\n")
    at += 1
  }
  add_text(output, &used, "\nArrows scroll / Enter applies / Escape keeps draft\nDeleted rows move to .dna-trash. Filesystem changes are not text undo.")
  return used
}
fn explorer_apply(app: *App) {
  error := explorer_validate(app)
  if #len(error) > 0 {
    notice(app, error)
    return
  }
  completed: usize = 0
  failed: bool = false
  for completed < app.explorer.edit_count {
    edit := &app.explorer.edits[completed]
    source: [4096]u8 = []
    destination: [4096]u8 = []
    if !edit_paths(app, edit, source[..], destination[..]) {
      failed = true
      break
    }
    source_length := c.string_length(&source[0], 4096)
    destination_length := c.string_length(&destination[0], 4096)
    if edit.kind == FileAction.CreateDirectory {
      if !fs.make_directory(destination[..destination_length], 493).ok {
        failed = true
        break
      }
    } else if edit.kind == FileAction.Create {
      created := fs.create_exclusive(destination[..destination_length])
      if !created.ok {
        failed = true
        break
      }
      if !fs.close(&created.value).ok {
        completed += 1
        failed = true
        break
      }
    } else {
      original := &app.directory_state.entries[edit.original - 1]
      current := files.metadata(source[..source_length])
      if !current.ok || current.inode != original.inode || current.device != original.device {
        failed = true
        break
      }
      if edit.kind == FileAction.Trash {
        trash_storage: [4096]u8 = []
        trash_path := joined(app, ".dna-trash", trash_storage[..])
        info := files.metadata(trash_path)
        if !info.ok {
          if !fs.make_directory(trash_path, 448).ok {
            failed = true
            break
          }
        }
        else if (info.mode & 61440) != 16384 {
          failed = true
          break
        }
      }
      if !fs.rename_noreplace(source[..source_length], destination[..destination_length]).ok {
        failed = true
        break
      }
      for slot_index in 0..#len(app.documents.slots) {
        slot := app.documents.slots[slot_index]
        if slot.document != nil && explorer_affected(files.name(&slot.file), source[..source_length], original.directory) {
          moved: [4096]u8 = []
          moved_length: usize = 0
          add_text(moved[..], &moved_length, destination[..destination_length])
          add_text(moved[..], &moved_length, files.name(&slot.file)[source_length..])
          files.discard_recovery(&slot.file)
          _ = files.set_name(&slot.file, moved[..moved_length])
          document_lifecycle_changed(app, slot_index)
        }
      }
    }
    completed += 1
  }
  tree_invalidate(app)
  if failed {
    app.explorer.stale = true
    message: [512]u8 = []
    used: usize = 0
    add_number(message[..], &used, completed)
    add_text(message[..], &used, " of ")
    add_number(message[..], &used, app.explorer.edit_count)
    add_text(message[..], &used, " changes completed before a filesystem error. No rollback was attempted. The draft is kept for reference; discard and refresh before retrying.")
    notice(app, message[..used])
    return
  }
  buffer.mark_saved(app.explorer.document)
  app.prompt_state.panel = Panel.Directory
  directory_refresh(app)
}
// Borrow the draft's document, modal key state and scroll only while dispatching
// its input (including its search prompt). Nested dot/macro playback shares the
// live borrow; the owning file and its Vim state are restored exactly once.
struct ExplorerVimBorrow {
  active:bool, document:*buffer.Document, insert:bool, extend:bool,
  scroll_x:f32, scroll_y:f32, draft_scroll_x:f32, draft_scroll_y:f32, vim:VimState,
}
fn explorer_vim_begin(app:*App)ExplorerVimBorrow {
  owned:=app.prompt_state.panel==Panel.Directory || (search_prompt(app.prompt_state.panel) && app.search_state.explorer)
  if !app.config.vim_keys || !owned || app.explorer.document==nil || app.explorer.vim_borrowed {
    return ExplorerVimBorrow{}
  }
  saved:=ExplorerVimBorrow{active:true, document:app.documents.current, insert:app.view.insert, extend:app.view.extend, scroll_x:app.view.scroll_x, scroll_y:app.view.scroll_y, draft_scroll_x:app.explorer.scroll_x, draft_scroll_y:app.explorer.scroll_y, vim:app.vim}
  app.explorer.vim_borrowed=true
  app.documents.current=app.explorer.document
  app.view.insert=app.explorer.insert
  app.view.extend=app.explorer.extend
  app.view.scroll_x=app.explorer.scroll_x
  app.view.scroll_y=app.explorer.scroll_y
  app.vim=app.explorer.vim
  return saved
}
fn explorer_vim_end(app:*App, saved:*ExplorerVimBorrow) {
  if !saved.active {
    return
  }
  saved.active=false
  app.explorer.vim=app.vim
  app.explorer.insert=app.view.insert
  app.explorer.extend=app.view.extend
  if app.view.scroll_x!=saved.draft_scroll_x {
    app.explorer.scroll_x=app.view.scroll_x
  }
  if app.view.scroll_y!=saved.draft_scroll_y {
    app.explorer.scroll_y=app.view.scroll_y
  }
  app.documents.current=saved.document
  app.view.insert=saved.insert
  app.view.extend=saved.extend
  app.view.scroll_x=saved.scroll_x
  app.view.scroll_y=saved.scroll_y
  app.vim=saved.vim
  app.explorer.vim_borrowed=false
}
// File activation and listing replacement must see the real owning slot and
// view, never the temporarily borrowed draft. Inner replay frames only queue;
// the outermost input frame restores ownership before running the action.
fn explorer_vim_finish(app:*App, typography:*Typography, saved:*ExplorerVimBorrow) {
  explorer_vim_end(app, saved)
  if app.explorer.vim_borrowed {
    return
  }
  pending:=app.explorer.dispatch_pending
  app.explorer.dispatch_pending=0
  if pending==1 {
    submit(app, typography)
  }
  else if pending==2 {
    command_execute(app, typography)
  }
  else if pending==3 {
    explorer_parent(app)
  }
}
fn explorer_vim_key(app:*App, typography:*Typography, key:u32, modifiers:u16) {
  saved:=explorer_vim_begin(app)
  defer explorer_vim_finish(app, typography, &saved)
  control:=(modifiers&ModCtrl)!=0
  shift:=(modifiers&ModShift)!=0
  idle:=vim_idle(app)
  if key==KeyEscape {
    if app.view.insert || !idle {
      if app.view.insert {
        vim_insert_finish(app)
        buffer.leave_insert(app.documents.current)
      }
      app.view.insert=false
      app.view.extend=false
      vim_escape(app)
      buffer.checkpoint(app.documents.current)
    } else {
      app.prompt_state.panel=Panel.None
    }
    return
  }
  if control && key==KeyS {
    explorer_preview(app)
    return
  }
  if idle && !control && !shift && key==KeyQ {
    app.prompt_state.panel=Panel.None
    return
  }
  if !app.view.insert && !control && (key==KeyColon || (key==KeySemicolon && shift)) {
    vim_escape(app)
    panel(app, Panel.Commands)
    app.explorer.commands=true
    return
  }
  if idle && !control && key==KeySpace {
    app.input_state.leader_explorer=true
    panel(app, Panel.Leader)
    return
  }
  if idle && !control && (key==KeyBackspace || key==KeyMinus) {
    app.explorer.dispatch_pending=3
    return
  }
  if idle && key==KeyReturn {
    app.explorer.dispatch_pending=1
    return
  }
  if !app.view.insert && !control && (key==KeySlash || key==KeyQuestion) {
    vim_escape(app)
    app.input_state.search_backwards=shift || key==KeyQuestion
    search_open(app, Panel.Search, true)
    return
  }
  if idle && !control && key==KeyN {
    search_repeat(app, shift, true)
    return
  }
  if !vim_key(app, typography, key, modifiers) {
    edit_key(app, key, modifiers)
  }
  explorer_selected(app)
}
fn explorer_key(app: *App, typography: *Typography, key: u32, modifiers: u16) {
  if app.config.vim_keys && app.explorer.document!=nil {
    explorer_vim_key(app, typography, key, modifiers)
    return
  }
  doc := app.explorer.document
  if doc == nil {
    app.prompt_state.panel = Panel.None
    return
  }
  shift := (modifiers & ModShift) != 0
  control := (modifiers & ModCtrl) != 0
  if key == KeyEscape {
    app.input_state.pending = 0
    app.input_state.repeat_count = 0
    buffer.checkpoint(doc)
    if app.explorer.insert || app.explorer.extend {
      if app.explorer.insert {
        buffer.leave_insert(doc)
      }
      app.explorer.insert = false
      app.explorer.extend = false
    }
    else {
      app.prompt_state.panel = Panel.None
    }
    return
  }
  if !app.explorer.insert && (modifiers & ModAlt) == 0 && (key == KeyColon || (key == KeySemicolon && shift)) {
    buffer.checkpoint(doc)
    panel(app, Panel.Commands)
    app.explorer.commands = true
    return
  }
  // q closes, like Escape in normal mode; staged edits stay until applied
  // or discarded.
  if !app.explorer.insert && !app.explorer.extend && !control && !shift && key == KeyQ {
    app.input_state.pending = 0
    app.input_state.repeat_count = 0
    buffer.checkpoint(doc)
    app.prompt_state.panel = Panel.None
    return
  }
  if !app.explorer.insert && !control && key == KeyM {
    match_open(app, true)
    return
  }
  if !app.explorer.insert && !control && key == KeySpace {
    app.input_state.leader_explorer = true
    panel(app, Panel.Leader)
    return
  }
  if !app.explorer.insert && !control && !shift && key == KeyG {
    app.input_state.goto_count = app.input_state.repeat_count
    app.input_state.goto_explorer = true
    panel(app, Panel.Goto)
    return
  }
  if !app.explorer.insert && !control && shift && key == KeyK {
    filter_kind := Panel.Keep
    if (modifiers & ModAlt) != 0 {
      filter_kind = Panel.Remove
    }
    search_open(app, filter_kind, true)
    return
  }
  if !app.explorer.insert && !control && (key == KeyS || key == KeySlash || key == KeyQuestion) {
    kind := Panel.Select
    if key == KeyS && shift {
      kind = Panel.Split
    } else if key != KeyS {
      kind = Panel.Search
      app.input_state.search_backwards = shift || key == KeyQuestion
    }
    search_open(app, kind, true)
    return
  }
  if !app.explorer.insert && !control && key == KeyN {
    search_repeat(app, shift, true)
    return
  }
  if control && key == KeyS {
    explorer_preview(app)
    return
  }
  if !app.explorer.insert && key == KeyReturn {
    submit(app, typography)
    return
  }
  if !app.explorer.insert && !app.explorer.extend && !control && (key == KeyBackspace || key == KeyH || key == KeyLeft) {
    explorer_parent(app)
    return
  }
  // l walks into the selected folder; on a file it opens it, like Enter.
  if !app.explorer.insert && !app.explorer.extend && !control && (key == KeyL || key == KeyRight) {
    submit(app, typography)
    return
  }
  // Borrow the same editing engine without changing the active file/view.
  saved_doc := app.documents.current
  saved_insert := app.view.insert
  saved_extend := app.view.extend
  app.documents.current = doc
  app.view.insert = app.explorer.insert
  app.view.extend = app.explorer.extend
  if control {
    if key == KeyZ {
      if shift {
        buffer.redo(doc)
      } else {
        buffer.undo(doc)
      }
    }
    else if key == KeyY {
      buffer.redo(doc)
    }
    else if key == KeyA {
      doc.anchor = 0
      doc.cursor = doc.length
    }
    else if key == KeyC {
      _ = clipboard_copy(app)
    }
    else if key == KeyV {
      clipboard_paste(app)
    }
  } else {
    edit_key(app, key, modifiers)
  }
  app.explorer.insert = app.view.insert
  app.explorer.extend = app.view.extend
  app.documents.current = saved_doc
  app.view.insert = saved_insert
  app.view.extend = saved_extend
  explorer_selected(app)
}
// Side column of directory entries (parent or contents). Rows are clickable;
// the selected entry keeps a highlight. Returns nothing: icons draw after
// layout from the recorded rows.
fn explorer_column(ui: *UiState, app: *App, typography: *Typography, name: []const u8, title: []const u8, entries: []Entry, selected: usize, width: f32, kind: usize) {
  scale := typography.scale
  column := ui_make(ui, ui_key(ui, name), UiBackground | UiBorder | UiClip)
  ui.boxes[column].fill = theme().surface
  ui.boxes[column].padding[0] = 14.0 * scale
  ui.boxes[column].padding[1] = 14.0 * scale
  ui_size(ui, column, UiAxisX, UiSizeKind.Pixels, width / scale, 1.0)
  ui_size(ui, column, UiAxisY, UiSizeKind.Percent, 1.0, 1.0)
  ui_push(ui, column)
  header: [8192]u8 = []
  header_length: usize = 0
  if kind <= ExplorerTrail {
    add_text(header[..], &header_length, "PARENT  ")
  }
  else {
    add_text(header[..], &header_length, "PREVIEW  ")
  }
  add_text(header[..], &header_length, title)
  heading := ui_label(ui, "title", header[..header_length], 0)
  ui_size(ui, heading, UiAxisX, UiSizeKind.Percent, 1.0, 0.0)
  ui_size(ui, heading, UiAxisY, UiSizeKind.Pixels, typography.line * 1.5 / scale, 1.0)
  previous := ui.boxes[column].rect.height
  rows: usize = 8
  if previous > 28.0 * scale + typography.line * 3.0 {
    rows = #cast(usize, ((previous - 28.0 * scale - typography.line * 1.5) / typography.line))
  }
  first: usize = 0
  if rows > 2 && selected < #len(entries) && selected >= rows - 2 {
    first = selected - (rows - 2) / 2
  }
  index := first
  for index < #len(entries) && index < first + rows {
    entry := &entries[index]
    flags := UiClickable | UiHover | UiText
    row := ui_make(ui, ui_hash(ui.boxes[column].key, entry.name[..entry.length]), flags)
    label: [1024]u8 = []
    length: usize = 0
    add_text(label[..], &length, entry.name[..entry.length])
    if entry.directory {
      add_text(label[..], &length, "/")
    }
    ui_text_set(ui, row, label[..length])
    ui.boxes[row].value = kind * 65536 + index
    if app.view.line_numbers {
      ui.boxes[row].padding[0] = typography.cell * 7.0
    }
    if app.config.explorer_icons {
      ui.boxes[row].padding[0] += typography.cell * 2.0
    }
    ui_size(ui, row, UiAxisX, UiSizeKind.Percent, 1.0, 1.0)
    ui_size(ui, row, UiAxisY, UiSizeKind.Pixels, typography.line / scale, 1.0)
    ui_animate(app, ui, row, index == selected)
    index += 1
  }
  if #len(entries) == 0 {
    _ = ui_label(ui, "empty", "(empty or unreadable)", UiMuted)
  }
  if #len(entries) == 64 {
    _ = ui_label(ui, "limit", "First 64 entries", UiMuted)
  }
  ui_pop(ui)
}
// Draw file and folder icons into the text padding of recorded rows.
fn explorer_column_icons(renderer: rawptr, app: *App, ui: *UiState, typography: *Typography, name: []const u8, entries: []Entry, selected: usize) {
  column := ui_make_lookup(ui, ui_child_key("explorer", name))
  if column == 0 {
    return
  }
  clip := sdl.PixelRect{x: #cast(i32, ui.boxes[column].rect.x), y: #cast(i32, ui.boxes[column].rect.y), width: #cast(i32, ui.boxes[column].rect.width), height: #cast(i32, ui.boxes[column].rect.height)}
  if !sdl.clip(renderer, &clip) {
    #panic("explorer icon clip")
  }
  row := ui.boxes[column].first
  for row != 0 {
    item := &ui.boxes[row]
    if (item.flags & UiClickable) != 0 {
      index := item.value % 65536
      if index < #len(entries) {
        entry := &entries[index]
        gutter: f32 = 0.0
        if app.view.line_numbers {
          gutter = typography.cell * 7.0
          number := index + 1
          if app.view.relative_numbers && selected < #len(entries) && index != selected {
            if index > selected {
              number = index - selected
            } else {
              number = selected - index
            }
          }
          digits: [32]u8 = []
          length: usize = 0
          add_number(digits[..], &length, number)
          chrome_text(typography, digits[..length], item.rect.x + gutter - (#cast(f32, length) + 2.0) * typography.cell, item.rect.y, index == selected)
        }
        if app.config.explorer_icons {
          explorer_icon(renderer, typography, entry.name[..entry.length], entry.directory, item.rect.x + gutter, item.rect.y)
        }
      }
    }
    row = item.next
  }
  if !sdl.clip(renderer, nil) {
    #panic("explorer icon clip reset")
  }
}
// Existing columns retain their left-to-right order. Animate the column count
// so only the new rightmost column grows from zero; never insert at the left.
fn explorer_columns_progress(app: *App, columns: usize) f32 {
  state := &app.explorer.columns_geometry
  animation := &app.view.animation
  target := #cast(f32, columns) * 1000.0
  edges: [4]f32 = [target, 0.0, 0.0, 0.0]
  changed := !state.ready || state.target[0] != target
  fresh := !state.ready || app.explorer.columns_frame + 1 < app.ui.frame
  answering := answering_input(app)
  immediate := fresh || !surface_motion_enabled(app) || animation.resized || !animation.surfaces_ready || (!changed && answering && app.explorer.columns_frame != app.ui.frame)
  elapsed := animation.geometry_elapsed
  if app.explorer.columns_frame == app.ui.frame {
    elapsed = 0.0
  }
  rate: f32 = 70.0
  if app.config.popup_animation_ms > 0.0 {
    rate = 2800.0 / app.config.popup_animation_ms
  }
  motion.rectangle_step(state, edges, animation.now, elapsed, rate, immediate)
  app.explorer.columns_frame = app.ui.frame
  if state.active {
    animation.active = true
    animation.geometry_active = true
  }
  return state.current[0] / 1000.0
}
fn explorer_column_fraction(progress: f32, index: usize) f32 {
  value := progress - #cast(f32, index)
  if value < 0.0 {
    return 0.0
  }
  if value > 1.0 {
    return 1.0
  }
  return value
}
fn explorer_column_extent(progress: f32, index: usize, width, gap: f32) f32 {
  if progress < 1.0 {
    progress = 1.0
  }
  return explorer_column_fraction(progress, index) * (width - gap * (progress - 1.0)) / progress
}
fn draw_explorer(renderer: rawptr, app: *App, typography: *Typography, width: i32, height: i32) {
  doc := app.explorer.document
  if doc == nil {
    return
  }
  ui := &app.ui
  ui_panel_begin(ui, typography)
  scale := typography.scale
  padding := 14.0 * scale
  status: f32 = 0.0
  if app.view.status_line {
    status = typography.line
  }
  target_rect := place_rect(app, SurfaceExplorer, width, height, status, scale, window_popup_rect(width, height, status))
  rect := animated_surface(app, SurfaceExplorer, target_rect, scale)
  // Keep the column set stable while its outer frame settles.
  gap := 8.0 * scale
  minimum := typography.cell * 22.0
  slots: usize = 1
  for slots < 4 && #cast(f32, (slots + 1)) * minimum + #cast(f32, slots) * gap <= target_rect.width {
    slots += 1
  }
  context := &app.explorer.context
  preview := app.config.explorer_preview && slots >= 2
  if preview {
    explorer_context_preview(app)
  }
  fixed: usize = 1
  if preview {
    fixed = 2
  }
  shown := context.trail_count
  if shown > slots - fixed {
    shown = slots - fixed
  }
  columns := shown + fixed
  progress := explorer_columns_progress(app, columns)
  column_width := explorer_column_extent(progress, shown, rect.width, gap)
  preview_width := explorer_column_extent(progress, shown + 1, rect.width, gap)
  root := ui_make(ui, ui_hash(0, "explorer"), UiFloating)
  ui.boxes[root].axis = UiAxisX
  ui.boxes[root].floating[0] = rect.x
  ui.boxes[root].floating[1] = rect.y
  ui_size(ui, root, UiAxisX, UiSizeKind.Pixels, rect.width / scale, 1.0)
  ui_size(ui, root, UiAxisY, UiSizeKind.Pixels, rect.height / scale, 1.0)
  ui_push(ui, root)
  for index in context.trail_count - shown..context.trail_count {
    column := &context.trail[index]
    names: [6][]const u8 = ["trail 0", "trail 1", "trail 2", "trail 3", "trail 4", "trail 5"]
    explorer_column(ui, app, typography, names[index], column.path[..column.path_length], column.entries[..column.count], column.selected, explorer_column_extent(progress, index - (context.trail_count - shown), rect.width, gap), index + 1)
    space := ui_make(ui, ui_hash(ui_key(ui, "gap"), names[index]), 0)
    ui_size(ui, space, UiAxisX, UiSizeKind.Pixels, gap * explorer_column_fraction(progress, index - (context.trail_count - shown) + 1) / scale, 1.0)
  }
  main := ui_make(ui, ui_key(ui, "main"), UiBackground | UiBorder | UiClip | UiFocus)
  ui.boxes[main].fill = theme().surface
  ui_size(ui, main, UiAxisX, UiSizeKind.Pixels, column_width / scale, 1.0)
  ui_size(ui, main, UiAxisY, UiSizeKind.Percent, 1.0, 1.0)
  preview_body: usize = 0
  if preview {
    space_right := ui_make(ui, ui_key(ui, "right gap"), 0)
    ui_size(ui, space_right, UiAxisX, UiSizeKind.Pixels, gap * explorer_column_fraction(progress, shown + 1) / scale, 1.0)
    if context.preview_directory {
      explorer_column(ui, app, typography, "contents", "", context.children[..context.child_count], 64, preview_width, ExplorerTrail + 1)
    }
    else {
      pane := ui_make(ui, ui_key(ui, "preview"), UiBackground | UiBorder | UiClip)
      ui.boxes[pane].fill = theme().surface
      ui.boxes[pane].padding[0] = padding
      ui.boxes[pane].padding[1] = padding
      ui_size(ui, pane, UiAxisX, UiSizeKind.Pixels, preview_width / scale, 1.0)
      ui_size(ui, pane, UiAxisY, UiSizeKind.Percent, 1.0, 1.0)
      ui_push(ui, pane)
      preview_body = ui_make(ui, ui_key(ui, "body"), UiClip)
      ui_size(ui, preview_body, UiAxisX, UiSizeKind.Percent, 1.0, 1.0)
      ui_size(ui, preview_body, UiAxisY, UiSizeKind.Percent, 1.0, 0.0)
      ui_pop(ui)
    }
  }
  retiring_body: usize = 0
  if progress > #cast(f32, columns) {
    used_width: f32 = 0.0
    for index in 0..columns {
      used_width += explorer_column_extent(progress, index, rect.width, gap)
      if index > 0 {
        used_width += gap * explorer_column_fraction(progress, index)
      }
    }
    remaining := rect.width - used_width
    if remaining > 0.0 {
      retiring := ui_make(ui, ui_key(ui, "retiring right pane"), UiBackground | UiBorder | UiClip)
      ui.boxes[retiring].fill = theme().surface
      ui.boxes[retiring].padding[0] = padding
      ui.boxes[retiring].padding[1] = padding
      ui_size(ui, retiring, UiAxisX, UiSizeKind.Pixels, remaining / scale, 1.0)
      ui_size(ui, retiring, UiAxisY, UiSizeKind.Percent, 1.0, 1.0)
      ui_push(ui, retiring)
      retiring_body = ui_make(ui, ui_key(ui, "body"), UiClip)
      ui_size(ui, retiring_body, UiAxisX, UiSizeKind.Percent, 1.0, 1.0)
      ui_size(ui, retiring_body, UiAxisY, UiSizeKind.Percent, 1.0, 0.0)
      ui_pop(ui)
    }
  }
  ui_pop(ui)
  ui_layout(ui)
  ui_render(renderer, ui, typography, width, height)
  if app.config.explorer_icons || app.view.line_numbers {
    trail_names: [6][]const u8 = ["trail 0", "trail 1", "trail 2", "trail 3", "trail 4", "trail 5"]
    for index in context.trail_count - shown..context.trail_count {
      explorer_column_icons(renderer, app, ui, typography, trail_names[index], context.trail[index].entries[..context.trail[index].count], context.trail[index].selected)
    }
    explorer_column_icons(renderer, app, ui, typography, "contents", context.children[..context.child_count], 64)
  }
  if preview_body != 0 {
    area := ui.boxes[preview_body].rect
    preview_clip := sdl.PixelRect{x: #cast(i32, area.x), y: #cast(i32, area.y), width: #cast(i32, area.width), height: #cast(i32, area.height)}
    if !sdl.clip(renderer, &preview_clip) {
      #panic("file preview clip")
    }
    explorer_preview_text(app, typography, context.preview[..context.preview_length], context.preview_path[..context.preview_path_length], area.x, area.y, area.height)
    if !sdl.clip(renderer, nil) {
      #panic("file preview reset")
    }
  }
  if retiring_body != 0 {
    area := ui.boxes[retiring_body].rect
    clip := sdl.PixelRect{x:#cast(i32, area.x), y:#cast(i32, area.y), width:#cast(i32, area.width), height:#cast(i32, area.height)}
    if !sdl.clip(renderer, &clip) {
      #panic("retiring explorer clip")
    }
    explorer_preview_text(app, typography, app.explorer.retiring_text[..app.explorer.retiring_length], "", area.x, area.y, area.height)
    if !sdl.clip(renderer, nil) {
      #panic("retiring explorer clip reset")
    }
  }
  rect = ui.boxes[main].rect
  outer_clip := sdl.PixelRect{x: #cast(i32, rect.x), y: #cast(i32, rect.y), width: #cast(i32, rect.width), height: #cast(i32, rect.height)}
  if !sdl.clip(renderer, &outer_clip) {
    #panic("explorer header clip")
  }
  header: [8192]u8 = []
  used: usize = 0
  if app.explorer.insert {
    add_text(header[..], &used, "INSERT  ")
  } else if app.explorer.extend {
    add_text(header[..], &used, "SELECT  ")
  } else {
    add_text(header[..], &used, "NORMAL  ")
  }
  // From the folder the explorer opened on; the trail shows the rest.
  shown_path := app.explorer.path[..app.explorer.path_length]
  anchor := app.explorer.context.anchor[..app.explorer.context.anchor_length]
  anchor_leaf := explorer_parent_length(anchor)
  if #len(anchor) > 1 && anchor_leaf < #len(shown_path) && buffer.equal(shown_path[..#len(anchor)], anchor) {
    shown_path = shown_path[anchor_leaf..]
    if #len(shown_path) > 0 && shown_path[0] == 47 {
      shown_path = shown_path[1..]
    }
  }
  add_text(header[..], &used, shown_path)
  if buffer.dirty_cached(doc) {
    add_text(header[..], &used, " [+]")
  }
  chrome_text(typography, header[..used], rect.x + padding, rect.y + padding, true)
  top := rect.y + padding + typography.line * 1.5
  body_height := rect.height - padding * 2.0 - typography.line * 1.5
  if body_height < typography.line {
    body_height = typography.line
  }
  _ = text_viewport(doc, typography.line, body_height, &app.explorer.scroll_y)
  head := doc.cursor
  if !app.explorer.insert {
    head = buffer.head(doc)
  }
  caret := measure_position(doc, typography, head)
  x := text_caret_x(&caret, app.explorer.insert)
  y := #cast(f32, (line_at(doc, head) - 1)) * typography.line
  if x < app.explorer.scroll_x {
    app.explorer.scroll_x = x
  }
  gutter: f32 = 0.0
  if app.view.line_numbers {
    gutter = 7.0 * typography.cell
  }
  icon_width: f32 = 0.0
  if app.config.explorer_icons {
    icon_width = typography.cell * 2.0
  }
  origin := rect.x + padding + gutter + icon_width
  available := rect.width - padding * 2.0 - gutter - icon_width
  if available < typography.cell {
    available = typography.cell
  }
  if x + typography.cell > app.explorer.scroll_x + available {
    app.explorer.scroll_x = x + typography.cell - available
  }
  visual := &app.view.animation.directory
  reset := app.view.animation.reset || app.view.animation.panel != Panel.Directory
  animated_scroll(app, visual, app.explorer.scroll_x, app.explorer.scroll_y, body_height, reset)
  if app.explorer.insert {
    editing_scroll_visible(visual, x, y, typography.cell, typography.line, available, body_height, app.explorer.scroll_x, app.explorer.scroll_y)
  }
  scroll_x := visual.x.value
  scroll_y := visual.y.value
  ui.explorer_top = top
  ui.explorer_scroll = scroll_y
  ui.explorer_body = sdl.Rect{x: rect.x, y: top, width: rect.width, height: body_height}
  viewport := visible_viewport(doc, typography.line, body_height, scroll_y)
  _ = line_layout_update(typography, &typography.directory_layout, doc, 0, viewport)
  if typography.directory_revision != doc.revision || typography.directory_start != viewport.start || typography.directory_end != viewport.end {
    typography.directory_revision = doc.revision
    typography.directory_start = viewport.start
    typography.directory_end = viewport.end
  }
  gutter_clip := sdl.PixelRect{x: #cast(i32, (rect.x + padding)), y: #cast(i32, top), width: #cast(i32, gutter), height: #cast(i32, body_height)}
  if app.view.line_numbers {
    if !sdl.clip(renderer, &gutter_clip) {
      #panic("explorer gutter clip")
    }
    draw_gutter(doc, typography, origin - icon_width, top, top + body_height, scroll_y, app.view.relative_numbers, head)
  }
  if app.config.explorer_icons {
    icon_clip := sdl.PixelRect{x: #cast(i32, (origin - icon_width)), y: #cast(i32, top), width: #cast(i32, icon_width), height: #cast(i32, body_height)}
    if !sdl.clip(renderer, &icon_clip) {
      #panic("icon clip")
    }
    row := buffer.row_at(doc, viewport.start)
    at := viewport.start
    for at < viewport.end {
      ending := buffer.line_end(doc, at)
      name := doc.bytes[at..ending]
      directory := #len(name) > 0 && name[#len(name) - 1] == 47
      if #len(name) > 0 {
        explorer_icon(renderer, typography, name, directory, origin - icon_width, top + #cast(f32, row) * typography.line - scroll_y)
      }
      at = ending + 1
      row += 1
    }
  }
  clip := sdl.PixelRect{x: #cast(i32, origin), y: #cast(i32, top), width: #cast(i32, available), height: #cast(i32, body_height)}
  if clip.width < 1 {
    clip.width = 1
  }
  if clip.height < 1 {
    clip.height = 1
  }
  if !sdl.clip(renderer, &clip) {
    #panic("explorer clip")
  }
  draw_selection(renderer, doc, &typography.directory_layout, viewport, typography, origin, top, scroll_x, scroll_y, origin + available)
  draw_extra_cursors(renderer, doc, &typography.directory_layout, viewport, typography, origin, top, scroll_x, scroll_y, app.explorer.insert)
  cursor_width := typography.cell
  if app.explorer.insert {
    cursor_width = app.config.cursor_thickness * typography.scale
  }
  // The editable listing shares the document caret's immediate feedback.
  cursor_x := animated_follow(app, &visual.cursor_x, origin + x - scroll_x, app.config.cursor_animation_ms, true)
  cursor_y := animated_follow(app, &visual.cursor_y, top + y - scroll_y, app.config.cursor_animation_ms, true)
  cursor := sdl.Rect{x: cursor_x, y: cursor_y, width: cursor_width, height: typography.points * typography.scale + 5.0 * typography.scale}
  if !paint(renderer, theme().cursor) || !sdl.fill(renderer, &cursor) {
    #panic("explorer draw")
  }
  line_layout_draw(&typography.directory_layout, theme().text, origin - scroll_x, top + viewport.y - scroll_y)
  if !sdl.clip(renderer, nil) {
    #panic("explorer clip reset")
  }
}

fn explorer_release(app: *App) {
  if app.explorer.document != nil {
    arena_owner.release(app.explorer.arena)
    app.explorer.arena = nil
    app.explorer.document = nil
  }
}
// Mouse in the explorer: click a row to select it, double-click to open;
// side columns open their entries; the wheel moves the selection.
fn explorer_mouse(app: *App, typography: *Typography, x: f32, y: f32, pressed: bool, moved: bool, clicks: u8) {
  ui := &app.ui
  doc := app.explorer.document
  if doc == nil {
    return
  }
  if moved {
    ui_pointer(ui, x, y)
    return
  }
  if !pressed {
    return
  }
  if ui_contains(ui.explorer_body, x, y) {
    row := #cast(usize, ((y - ui.explorer_top + ui.explorer_scroll) / typography.line))
    if row >= doc.line_count {
      return
    }
    position := buffer.row_start(doc, row)
    buffer.checkpoint(doc)
    if app.explorer.insert {
      buffer.move_to(doc, position, false)
    }
    else {
      buffer.select_to(doc, position, false)
      app.explorer.extend = false
    }
    explorer_selected(app)
    if clicks >= 2 && !app.explorer.insert {
      explorer_key(app, typography, KeyReturn, 0)
    }
    return
  }
  hit := ui_hit(ui, x, y)
  if hit != 0 {
    kind := ui.boxes[hit].value / 65536
    index := ui.boxes[hit].value % 65536
    explorer_open_entry(app, kind, index)
    return
  }
  root := ui_make_lookup(ui, ui_hash(0, "explorer"))
  if (root == 0 || !ui_contains(ui.boxes[root].rect, x, y)) && !app.explorer.insert {
    explorer_key(app, typography, KeyEscape, 0)
  }
}
// Open an entry from a column: 1..ExplorerTrail are the trail columns, left
// to right; ExplorerTrail + 1 is the contents preview of the selected
// folder. Folders are browsed; files open.
fn explorer_open_entry(app: *App, kind: usize, index: usize) {
  context := &app.explorer.context
  base: [4096]u8 = []
  base_length := copy_text(base[..], app.explorer.path[..app.explorer.path_length])
  entry: *Entry = nil
  if kind >= 1 && kind <= context.trail_count {
    column := &context.trail[kind - 1]
    if index >= column.count {
      return
    }
    // Trail column k lists the folder (trail_count - k + 1) levels up.
    for level in 0..context.trail_count - kind + 1 {
      base_length = explorer_parent_length(base[..base_length])
    }
    entry = &column.entries[index]
  }
  else if kind == ExplorerTrail + 1 && index < context.child_count && app.directory_state.selected < app.directory_state.count {
    selected := &app.directory_state.entries[app.directory_state.selected]
    if base_length > 0 && base[base_length - 1] != '/' {
      add_text(base[..], &base_length, "/")
    }
    add_text(base[..], &base_length, selected.name[..selected.length])
    entry = &context.children[index]
  }
  if entry == nil {
    return
  }
  path: [4096]u8 = []
  length := copy_text(path[..], base[..base_length])
  if length > 0 && path[length - 1] != '/' {
    add_text(path[..], &length, "/")
  }
  add_text(path[..], &length, entry.name[..entry.length])
  if !entry.directory {
    open_file(app, path[..length])
    return
  }
  if explorer_dirty(app) {
    notice(app, "Apply or discard staged edits before changing directory.")
    return
  }
  app.directory_state.length = copy_text(app.directory_state.path[..], path[..length])
  directory_refresh(app)
}
