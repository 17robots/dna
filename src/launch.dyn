// Resolve existing paths before inspecting metadata so directory symlinks
// behave like their targets. Other paths retain open_file's validation.
fn launch_open(app: *App, requested: []const u8) bool {
  expanded: [4096]u8 = []
  path := expand_home(requested, expanded[..])
  absolute: [4096]u8 = []
  length := files.directory_path(path, absolute[..])
  if length > 0 {
    info := files.metadata(absolute[..length])
    if info.ok && (info.mode & 61440) == 16384 {
      project_cd(app, absolute[..length])
      return app.prompt_state.panel == Panel.None
    }
  }
  open_file(app, path)
  return false
}
