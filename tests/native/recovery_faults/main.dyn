extern fn fault_errno "__errno_location"() *i32
extern fn fault_pid "getpid"() i32
extern fn fault_pause "pause"() i32
pub fn fsync(fd: i32) i32 {
  if probe_env("DNA_TEST_FAIL_FSYNC\0") != nil {
    fault_errno().* = 5
    return -1
  }
  if probe_env("DNA_TEST_STOP_FSYNC\0") != nil {
    _ = #syscall(62, fault_pid(), 19)
    for true {
      _ = fault_pause()
    }
  }
  next := #cast(*fn(i32) i32) probe_next("fsync\0")
  return next(fd)
}
