struct CompletionState {
  entries: [128]Entry,
  count: usize,
  selected: usize,
  chosen: bool,
  error: bool,
  prefix: [4096]u8,
  prefix_length: usize,
}

struct PickerIndex {
  entries: []Entry,
  count: usize,
  visited: usize,
  root: [4096]u8,
  root_length: usize,
  limited: bool,
  error: bool,
}

fn expand_home(path: []const u8, output: []u8) []const u8 {
  if #len(path) > 0 && path[0] == '~' && (#len(path) == 1 || path[1] == '/') {
    home_storage: [4096]u8 = []
    result := host.environment("HOME", home_storage[..])
    if !result.ok || !result.found || #len(result.value) + #len(path) >= #len(output) {
      return output[..0]
    }
    used: usize = 0
    add_text(output, &used, result.value)
    if #len(path) == 1 {
      add_text(output, &used, "/")
    } else {
      add_text(output, &used, path[1..])
    }
    return output[..used]
  }
  length := copy_text(output, path)
  return output[..length]
}
// Bounded, cached file-only index. Typing filters memory, not the filesystem.
fn picker_match(name: []const u8, query: []const u8) bool {
  at: usize = 0
  for byte in name {
    if at < #len(query) && lower(byte) == lower(query[at]) {
      at += 1
    }
  }
  return at == #len(query)
}
fn completion_refresh(app: *App) {
  if app.resource_state.kind == 6 { language_manager_refresh(app) return }
  if app.resource_state.kind == 5 {
    task_refresh(app)
    return
  }
  if app.resource_state.fonts || app.resource_state.kind != 0 {
    font_refresh(app)
    return
  }
  app.completion.count = 0
  app.completion.selected = 0
  app.completion.chosen = false
  app.completion.error = false
  expanded: [4096]u8 = []
  path := expand_home(app.prompt_state.text[..app.prompt_state.length], expanded[..])
  split := #len(path)
  for split > 0 && path[split - 1] != '/' {
    split -= 1
  }
  app.completion.prefix_length = copy_text(app.completion.prefix[..], path[..split])
  directory: []const u8 = "."
  if split > 0 {
    directory = path[..split]
  }
  fragment := path[split..]
  if app.picker_state.index == nil {
    allocated := mem.arena_create(#sizeof(PickerIndex) + #alignof(Entry) + #sizeof(Entry) * 2048)
    if !allocated.ok {
      app.completion.error = true
      return
    }
    app.picker_state.arena = mem.arena_take(&allocated.arena)
    // A fresh mapping is already zero; only touched entries become resident.
    app.picker_state.index = #cast(*PickerIndex) mem.arena_push_uninit_or_panic(&app.picker_state.arena, #sizeof(PickerIndex), #alignof(PickerIndex))
    entries := #cast(*Entry) mem.arena_push_uninit_or_panic(&app.picker_state.arena, #sizeof(Entry) * 2048, #alignof(Entry))
    app.picker_state.index.entries = entries[..2048]
  }
  index := app.picker_state.index
  if !buffer.equal(directory, index.root[..index.root_length]) || !app.picker_state.watching {
    index.root_length = copy_text(index.root[..], directory)
    index.count = 0
    index.visited = 0
    index.error = false
    index.limited = false
    picker_index_submit(app)
  }
  _ = picker_index_receive(app)
  app.completion.error = index.error
  for pass in 0..3 {
    row: usize = 0
    for row < index.count && app.completion.count < 128 {
      entry := &index.entries[row]
      name := entry.name[..entry.length]
      prefix := #len(fragment) <= #len(name) && contains(name[..#len(fragment)], fragment)
      substring := contains(name, fragment)
      if (pass == 0 && prefix) || (pass == 1 && !prefix && substring) || (pass == 2 && !substring && picker_match(name, fragment)) {
        output := &app.completion.entries[app.completion.count]
        output.length = copy_text(output.name[..], name)
        output.directory = false
        app.completion.count += 1
      }
      row += 1
    }
  }
}
fn complete_path(app: *App) bool {
  if app.completion.count == 0 {
    return false
  }
  entry := &app.completion.entries[app.completion.selected]
  if app.completion.prefix_length + entry.length >= 4096 {
    notice(app, "Completed path is too long.")
    return false
  }
  app.prompt_state.length = copy_text(app.prompt_state.text[..], app.completion.prefix[..app.completion.prefix_length])
  add_text(app.prompt_state.text[..], &app.prompt_state.length, entry.name[..entry.length])
  completion_refresh(app)
  return true
}
fn open_prompt(app: *App, typography: *Typography) {
  if app.resource_state.kind != 0 {
    resource_select(app, typography)
    return
  }
  if app.resource_state.fonts {
    if app.completion.count > 0 {
      entry := &app.completion.entries[app.completion.selected]
      font_select(app, typography, entry.name[..entry.length])
    }
    return
  }
  expanded: [4096]u8 = []
  path := expand_home(app.prompt_state.text[..app.prompt_state.length], expanded[..])
  info := files.metadata(path)
  if !app.completion.chosen && info.ok && (info.mode & 61440) == 32768 {
    open_file(app, path)
    return
  }
  if app.completion.count > 0 {
    if complete_path(app) {
      selected: [4096]u8 = []
      chosen := expand_home(app.prompt_state.text[..app.prompt_state.length], selected[..])
      open_file(app, chosen)
    }
    return
  }
  // Keep an empty result in the picker; directories never turn into explorer rows.
}
// Enter in the palette: a selected suggestion fills in first; a folder or an
// option name waits for the rest of the input.
fn command_submit(app: *App, typography: *Typography) {
  if palette_enter(app) {
    return
  }
  command_execute(app, typography)
}
// Run the palette text exactly as written (key bindings run theirs this way).
fn command_execute(app: *App, typography: *Typography) {
  text := app.prompt_state.text[..app.prompt_state.length]
  if app.terminal_state.commands {
    app.terminal_state.commands = false
    if buffer.equal(text, "q") || buffer.equal(text, "quit") {
      app.prompt_state.panel = Panel.None
      return
    }
    if buffer.equal(text, "bd") {
      activate(app, app.terminal_state.slot)
      request_buffer_close(app)
      return
    }
  }
  if app.explorer.commands {
    app.explorer.commands = false
    if buffer.equal(text, "write") || buffer.equal(text, "w") {
      explorer_preview(app)
      return
    }
    if buffer.equal(text, "q") || buffer.equal(text, "quit") {
      app.prompt_state.panel = Panel.None
      return
    }
    if buffer.equal(text, "undo") {
      buffer.undo(app.explorer.document)
      app.prompt_state.panel = Panel.Directory
      return
    }
    if buffer.equal(text, "redo") {
      buffer.redo(app.explorer.document)
      app.prompt_state.panel = Panel.Directory
      return
    }
    if buffer.equal(text, "discard") {
      action(app, typography, 30)
      return
    }
    if buffer.equal(text, "refresh") {
      action(app, typography, 31)
      return
    }
    app.explorer.commands = true
    matches(app)
    app.explorer.commands = false
    if app.prompt_state.match_count > 0 {
      if explorer_command(app, typography, app.prompt_state.matches[app.prompt_state.selected]) {
        return
      }
    }
    notice(app, "Explorer commands: write, undo, redo, refresh, discard, quit. Explorer :write takes no path.")
    return
  }
  if vim_ex_command(app, text) {
    return
  }
  split: usize = 0
  for split < #len(text) && text[split] != ' ' {
    split += 1
  }
  verb := text[..split]
  argument := split
  for argument < #len(text) && text[argument] == ' ' {
    argument += 1
  }
  // Bare, these do something of their own; their palette rows ask for an argument.
  if buffer.equal(text, "cd") {
    project_cd(app, "")
    return
  }
  if buffer.equal(text, "theme") {
    theme_current(app)
    return
  }
  if (buffer.equal(verb, "set") || buffer.equal(verb, "se")) && argument < #len(text) {
    set_command(app, typography, text[argument..])
    return
  }
  if argument == #len(text) {
    command := command_named(verb)
    if command < BuiltinCommands {
      action(app, typography, command)
      return
    }
  }
  if buffer.equal(text, "comment") {
    comment_toggle(app)
    app.prompt_state.panel = Panel.None
    return
  }
  if buffer.equal(verb, "keymap") {
    keymap_command(app, settings.trim(text[argument..]))
    return
  }
  if buffer.equal(verb, "frontend") {
    frontend_switch(app, settings.trim(text[argument..]))
    return
  }
  if buffer.equal(verb, "place") {
    place_command(app, settings.trim(text[argument..]))
    return
  }
  if buffer.equal(verb, "module") || buffer.equal(verb, "modules") {
    module_command(app, settings.trim(text[argument..]))
    return
  }
  if buffer.equal(verb, "reload") {
    disk_reload(app, false)
    return
  }
  if buffer.equal(verb, "format") {
    format_start(app, false, "")
    return
  }
  if buffer.equal(verb, "format-cancel") {
    format_release(app)
    save_cancel(app)
    app.prompt_state.panel = Panel.None
    return
  }
  if buffer.equal(verb, "server-install") || buffer.equal(verb, "server-update") || buffer.equal(verb, "server-start") {
    server_tool(app, verb, settings.trim(text[argument..]))
    return
  }
  if lsp_command(app, verb, text[argument..]) {
    return
  }
  if (buffer.equal(verb, "open") || buffer.equal(verb, "e")) && argument < #len(text) {
    storage: [4096]u8 = []
    path := expand_home(text[argument..], storage[..])
    open_file(app, path)
    return
  }
  if (buffer.equal(verb, "write") || buffer.equal(verb, "w")) && argument < #len(text) {
    output: [4096]u8 = []
    destination := expand_home(text[argument..], output[..])
    save_file(app, destination)
    return
  }
  if buffer.equal(verb, "search-global") {
    query: [4096]u8 = []
    query_length := copy_text(query[..], text[argument..])
    project_search_open(app)
    app.prompt_state.length = copy_text(app.prompt_state.text[..], query[..query_length])
    project_search_refresh(app)
    return
  }
  if buffer.equal(verb, "resize") {
    pane_resize(app, settings.number(text[argument..]))
    return
  }
  if buffer.equal(verb, "replace-preview") {
    app.replacement.text_length = copy_text(app.replacement.text[..], text[argument..])
    replace_prepare(app, app.replacement.text[..app.replacement.text_length])
    return
  }
  if buffer.equal(verb, "session-save") {
    _ = session_save(app, text[argument..])
    return
  }
  if buffer.equal(verb, "session-load") {
    _ = session_restore(app, text[argument..])
    return
  }
  if buffer.equal(verb, "plugin-load") {
    plugin_load_named(app, text[argument..])
    return
  }
  if buffer.equal(verb, "plugin-rollback") {
    plugin_rollback(app, text[argument..])
    return
  }
  if buffer.equal(verb, "plugin-update") {
    plugin_update(app, text[argument..])
    return
  }
  if buffer.equal(verb, "plugin-remove") {
    plugin_remove(app, text[argument..])
    return
  }
  if buffer.equal(verb, "plugin-disable") {
    plugin_disable_named(app, text[argument..])
    return
  }
  if buffer.equal(verb, "plugin-install") {
    plugin_install_named(app, text[argument..])
    return
  }
  if buffer.equal(verb, "layout-save") {
    layout_save(app, text[argument..])
    return
  }
  if buffer.equal(verb, "layout") && argument < #len(text) {
    target: [4096]u8 = []
    target_length := copy_text(target[..], text[argument..])
    panel(app, Panel.Layout)
    app.prompt_state.length = copy_text(app.prompt_state.text[..], target[..target_length])
    submit(app, typography)
    return
  }
  if buffer.equal(verb, "filetype") || buffer.equal(verb, "ft") || buffer.equal(verb, "set-language") {
    filetype_command(app, settings.trim(text[argument..]))
    return
  }
  if #len(text) > 17 && buffer.equal(text[..17], "language-install ") {
    language_install(app, settings.trim(text[17..]))
    return
  }
  if #len(text) > 4 && buffer.equal(text[..4], "run ") {
    terminal_show(app, true, text[4..])
    return
  }
  if #len(text) > 6 && buffer.equal(text[..6], "theme ") {
    theme_switch(app, typography, settings.trim(text[6..]))
    return
  }
  if #len(text) > 5 && buffer.equal(text[..5], "font ") {
    font_select(app, typography, text[5..])
    return
  }
  if #len(text) > 3 && buffer.equal(text[..3], "cd ") {
    project_cd(app, settings.trim(text[3..]))
    return
  }
  matches(app)
  if app.prompt_state.match_count > 0 {
    action(app, typography, app.prompt_state.matches[app.prompt_state.selected])
  }
}
