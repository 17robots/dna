// Document text laid out one line per text object. Each pane keeps a pool
// keyed by line content, so an edit re-shapes only the changed line and a
// scroll shapes only lines newly on screen, instead of the whole viewport.
const LineSlots: usize = 256

struct LineText { text: rawptr, hash: u64, length: usize, used: bool }
struct LineLayout {
  builds:u64,
  lines: [256]LineText,
  // Pool slot drawn on each visible row.
  rows: [256]usize,
  origins: [256]usize,
  window: usize,
  first_row: usize,
  count: usize,
  line: f32,
  // What the layout was built from, to skip unchanged frames.
  document: *const buffer.Document,
  identity: u64,
  revision: u64,
  start: usize,
  end: usize,
}

// Polynomial hash modulo a prime below 2^56: Dyn arithmetic is checked, so
// every intermediate stays under 2^64. Matches also compare lengths.
fn line_hash(bytes: []const u8) u64 {
  hash: u64 = 1
  for byte in bytes {
    hash = (hash * 251 + #cast(u64, byte) + 1) % 72057594037927931
  }
  return hash
}
// Shape a bounded window of each line. On the cursor line, the window follows
// the cursor in half-window steps so distant text stays editable and visible.
// A megabyte-sized window still makes debug shaping and terminal geometry
// block input for seconds. Keep enough context for wide views without making
// each cursor move shape an enormous off-screen prefix.
const LineDrawLimit: usize = 65536
fn line_bytes(doc: *const buffer.Document, row: usize) []const u8 {
  low := buffer.row_start(doc, row)
  high := doc.length
  if row + 1 < doc.line_count {
    high = buffer.row_start(doc, row + 1)
  }
  low = line_draw_start(doc, low, buffer.line_end(doc, low))
  return buffer.range(doc, low, line_draw_end(doc, low, high))
}
// Share this origin across drawing, caret geometry, selections and hit tests.
fn line_draw_start(doc: *const buffer.Document, low: usize, high: usize) usize {
  position := buffer.head(doc)
  half := LineDrawLimit / 2
  if high - low <= LineDrawLimit || position < low || position > high || position - low < LineDrawLimit {
    return low
  }
  start := low + ((position - low) / half - 1) * half
  return buffer.boundary(doc, start)
}
fn line_window_key(doc: *const buffer.Document) usize {
  position := buffer.head(doc)
  low := buffer.line_start(doc, position)
  start := line_draw_start(doc, low, buffer.line_end(doc, position))
  if start == low {
    return 0
  }
  return start
}
// End of the shaped part of the line low..high: high, or LineDrawLimit bytes
// in at a character boundary.
fn line_draw_end(doc: *const buffer.Document, low: usize, high: usize) usize {
  if high - low <= LineDrawLimit {
    return high
  }
  end := low + LineDrawLimit
  for end > low && (buffer.byte_at(doc, end) & 192) == 128 {
    end -= 1
  }
  return end
}
// Bring the visible rows up to date. Returns the number of lines shaped.
fn line_layout_update(typography: *Typography, arranged: *LineLayout, doc: *const buffer.Document, identity: u64, viewport: TextViewport) usize {
  if arranged.document == doc && arranged.identity == identity && arranged.start == viewport.start && arranged.end == viewport.end && arranged.line == typography.line && arranged.window == line_window_key(doc) {
    if arranged.revision == doc.revision {
      return 0
    }
    changed:=buffer.changes_since(doc, arranged.revision)
    // The journal's common prefix proves every edit was strictly after these
    // complete visible lines. Boundary edits and missing history rebuild.
    if changed.found && changed.low>arranged.end {
      arranged.revision=doc.revision
      return 0
    }
  }
  arranged.builds+=1
  first := buffer.row_at(doc, viewport.start)
  count: usize = 0
  for count < LineSlots && first + count < doc.line_count && (count == 0 || buffer.row_start(doc, first + count) < viewport.end) {
    count += 1
  }
  for slot in 0..LineSlots {
    arranged.lines[slot].used = false
  }
  hashes: [256]u64
  // Lines already shaped keep their text objects wherever they moved.
  for index in 0..count {
    bytes := line_bytes(doc, first + index)
    hashes[index] = line_hash(bytes)
    arranged.rows[index] = LineSlots
    for slot in 0..LineSlots {
      candidate := &arranged.lines[slot]
      if candidate.text != nil && !candidate.used && candidate.hash == hashes[index] && candidate.length == #len(bytes) {
        candidate.used = true
        arranged.rows[index] = slot
        break
      }
    }
  }
  shaped: usize = 0
  free_slot: usize = 0
  for index in 0..count {
    if arranged.rows[index] != LineSlots {
      continue
    }
    for free_slot < LineSlots && arranged.lines[free_slot].used {
      free_slot += 1
    }
    entry := &arranged.lines[free_slot]
    entry.used = true
    arranged.rows[index] = free_slot
    if entry.text == nil {
      blank: [1]u8 = [0]
      entry.text = ttf.create(typography.engine, typography.font, &blank[0], 0)
      if entry.text == nil || !ttf.whitespace_visible(entry.text, true) || !ttf.wrap(entry.text, 0) {
        #panic("line text allocation")
      }
    }
    bytes := line_bytes(doc, first + index)
    // the native text backend reads length 0 as a C string; give empty lines a real one.
    empty: [1]u8 = [0]
    source: *const u8 = &empty[0]
    if #len(bytes) > 0 {
      source = &bytes[0]
    }
    if !ttf.set(entry.text, source, #len(bytes)) {
      #panic("line text update")
    }
    entry.hash = hashes[index]
    entry.length = #len(bytes)
    shaped += 1
  }
  for index in 0..count {
    low := buffer.row_start(doc, first + index)
    high := buffer.line_end(doc, low)
    arranged.origins[index] = line_draw_start(doc, low, high)
  }
  arranged.window = line_window_key(doc)
  arranged.first_row = first
  arranged.count = count
  arranged.line = typography.line
  arranged.document = doc
  arranged.identity = identity
  arranged.revision = doc.revision
  arranged.start = viewport.start
  arranged.end = viewport.end
  return shaped
}
fn line_layout_draw(arranged: *LineLayout, color: Rgb, x: f32, y: f32) {
  for index in 0..arranged.count {
    text := arranged.lines[arranged.rows[index]].text
    if !tint(text, color) || !ttf.draw(text, x, y + #cast(f32, index) * arranged.line) {
      #panic("text draw failed")
    }
  }
}
// Geometry of a document position, relative to the first visible row, like
// the old whole-viewport substring query.
fn layout_substring(arranged: *const LineLayout, doc: *const buffer.Document, position: usize, output: *ttf.Substring) bool {
  row := buffer.row_at(doc, position)
  if row < arranged.first_row || row >= arranged.first_row + arranged.count {
    return false
  }
  index := row - arranged.first_row
  origin := arranged.origins[index]
  if position < origin || position - origin > arranged.lines[arranged.rows[index]].length {
    return false
  }
  if !ttf.substring(arranged.lines[arranged.rows[index]].text, #cast(i32, (position - origin)), output) {
    return false
  }
  output.y += #cast(i32, (#cast(f32, index) * arranged.line))
  return true
}
fn line_layout_font(arranged: *LineLayout, font: rawptr) {
  for slot in 0..LineSlots {
    if arranged.lines[slot].text != nil {
      _ = ttf.set_font(arranged.lines[slot].text, font)
      arranged.lines[slot].hash = 0
      arranged.lines[slot].length = 0
    }
  }
  arranged.document = nil
}
fn line_layout_release(arranged: *LineLayout) {
  for slot in 0..LineSlots {
    if arranged.lines[slot].text != nil {
      ttf.destroy(arranged.lines[slot].text)
    }
  }
  arranged.* = LineLayout{}
}
