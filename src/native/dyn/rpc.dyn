// Bounded main-thread LSP framing. Bytes belong to this handle until take/close.
struct RpcTransport {
  child: OwnedProcess,
  failed: bool,
  error_eof: bool,
  incoming: *u8,
  queue: *u8,
  log: [4096]u8,
  used: usize,
  capacity: usize,
  sent: usize,
  pending: usize,
  header: usize,
  body: usize,
  building: bool,
  build_capacity: usize,
  // A parked reservation is still being written, by worker threads, after
  // send_park. Messages begun meanwhile go to later, which follows the queue
  // once the parked message is finished and written.
  parked: bool,
  parked_capacity: usize,
  build_later: bool,
  later: *u8,
  later_length: usize,
  log_length: usize,
}

pub fn dna_rpc_open(command: *const u8, directory: *const u8) *RpcTransport {
  child := proc_open(command, directory, true)
  if child.pid == 0 {
    return nil
  }
  state := #cast(*RpcTransport, rec_alloc(1, #sizeof(RpcTransport)))
  if state == nil {
    proc_close(&child)
    return nil
  }
  state.child = proc_take(&child)
  proc_watch(state.child.output, 0)
  proc_watch(state.child.error, 0)
  return state
}
// Outgoing document messages can be larger than incoming server responses.
// Begin/commit lets the UI encode tree chunks straight into the owned queue.
// The returned view expires on commit, abort, send, or close; calls are confined
// to the main thread, with no event-loop re-entry while a message is building.
const RpcOutgoingLimit: usize = 1073741824
pub fn dna_rpc_send_begin(state: *RpcTransport, capacity: usize) *u8 {
  if state == nil || state.failed || state.building || capacity == 0 || capacity > RpcOutgoingLimit {
    return nil
  }
  if state.parked || state.later_length > 0 {
    if state.later_length > RpcOutgoingLimit + 8192 - capacity - 64 {
      return nil
    }
    later := proc_realloc(state.later, state.later_length + capacity + 64)
    if later == nil {
      return nil
    }
    state.later = later
    state.building = true
    state.build_later = true
    state.build_capacity = capacity
    return &later[..state.later_length + capacity + 64][state.later_length + 64]
  }
  remaining := state.pending - state.sent
  if remaining > RpcOutgoingLimit + 8192 - capacity - 64 {
    return nil
  }
  if remaining > 0 && state.sent > 0 {
    _ = proc_move(state.queue, &state.queue[..state.pending][state.sent], remaining)
  }
  state.pending = remaining
  state.sent = 0
  queue := proc_realloc(state.queue, remaining + capacity + 64)
  if queue == nil {
    return nil
  }
  state.queue = queue
  state.building = true
  state.build_later = false
  state.build_capacity = capacity
  return &queue[..remaining + capacity + 64][remaining + 64]
}
pub fn dna_rpc_send_abort(state: *RpcTransport) {
  if state != nil {
    state.building = false
  }
}
// Content-Length header for length into header; returns its size.
fn rpc_header(header: []u8, length: usize) usize {
  prefix: []const u8 = "Content-Length: "
  suffix: []const u8 = "\r\n\r\n"
  _ = copy(&header[0], &prefix[0], #len(prefix))
  used := #len(prefix)
  digits: [20]u8 = []
  count: usize = 0
  number := length
  for number > 0 {
    digits[count] = #cast(u8, (number % 10)) + 48
    count += 1
    number /= 10
  }
  for count > 0 {
    count -= 1
    header[used] = digits[count]
    used += 1
  }
  _ = copy(&header[used], &suffix[0], 4)
  return used + 4
}
// Frame the reservation's length body bytes into the queue (or later).
fn rpc_commit(state: *RpcTransport, length: usize) {
  header: [64]u8 = []
  used := rpc_header(header[..], length)
  if state.build_later {
    at := state.later_length
    capacity := at + state.build_capacity + 64
    _ = proc_move(&state.later[..capacity][at + used], &state.later[..capacity][at + 64], length)
    _ = copy(&state.later[..capacity][at], &header[0], used)
    state.later_length = at + used + length
    proc_watch(state.child.input, 1)
    return
  }
  remaining := state.pending
  capacity := remaining + state.build_capacity + 64
  if state.sent == remaining {
    // Nothing left to write ahead: put the header right before the body,
    // which then stays where it was written instead of moving.
    _ = copy(&state.queue[..capacity][remaining + 64 - used], &header[0], used)
    state.sent = remaining + 64 - used
    state.pending = remaining + 64 + length
    proc_watch(state.child.input, 1)
    return
  }
  _ = proc_move(&state.queue[..capacity][remaining + used], &state.queue[..capacity][remaining + 64], length)
  _ = copy(&state.queue[..capacity][remaining], &header[0], used)
  state.pending = remaining + used + length
  proc_watch(state.child.input, 1)
}
pub fn dna_rpc_send_commit(state: *RpcTransport, length: usize) i32 {
  if state == nil || !state.building {
    return 0
  }
  state.building = false
  if state.failed || length == 0 || length > state.build_capacity {
    return 0
  }
  rpc_commit(state, length)
  return 1
}
// Hand the open reservation to other threads. Its view stays valid until
// send_finish; messages begun meanwhile queue behind it, in order.
pub fn dna_rpc_send_park(state: *RpcTransport) i32 {
  if state == nil || !state.building || state.build_later {
    return 0
  }
  state.building = false
  state.parked = true
  state.parked_capacity = state.build_capacity
  return 1
}
// Frame the parked message, or drop it when length is 0. Fails while another
// reservation is open.
pub fn dna_rpc_send_finish(state: *RpcTransport, length: usize) i32 {
  if state == nil || !state.parked || state.building {
    return 0
  }
  state.parked = false
  if state.failed || length == 0 || length > state.parked_capacity {
    return 0
  }
  state.build_later = false
  state.build_capacity = state.parked_capacity
  rpc_commit(state, length)
  return 1
}
pub fn dna_rpc_send(state: *RpcTransport, bytes: *const u8, length: usize) i32 {
  if bytes == nil {
    return 0
  }
  target := dna_rpc_send_begin(state, length)
  if target == nil {
    return 0
  }
  _ = copy(target, bytes, length)
  return dna_rpc_send_commit(state, length)
}
fn rpc_parse(state: *RpcTransport) bool {
  if state.body > 0 {
    return state.used >= state.header + state.body
  }
  if state.used < 4 {
    return false
  }
  text := state.incoming[..state.used]
  header: usize = 0
  at: usize = 0
  for at + 3 < state.used && at < 8192 {
    if text[at] == 13 && text[at + 1] == 10 && text[at + 2] == 13 && text[at + 3] == 10 {
      header = at + 4
      break
    }
    at += 1
  }
  if header == 0 {
    if state.used > 8192 {
      state.failed = true
    }
    return false
  }
  if header > 8192 {
    state.failed = true
    return false
  }
  state.header = header
  at = 0
  found: bool = false
  name: []const u8 = "content-length:"
  for at < header - 2 {
    end := at
    for end + 1 < header && !(text[end] == 13 && text[end + 1] == 10) {
      end += 1
    }
    if end + 1 >= header {
      state.failed = true
      return false
    }
    matched := end - at >= 15
    index: usize = 0
    for matched && index < 15 {
      character := text[at + index]
      if character >= 65 && character <= 90 {
        character += 32
      }
      if character != name[index] {
        matched = false
      }
      index += 1
    }
    if matched {
      if found {
        state.failed = true
        return false
      }
      found = true
      index = at + 15
      for index < end && (text[index] == 32 || text[index] == 9) {
        index += 1
      }
      if index == end {
        state.failed = true
        return false
      }
      length: usize = 0
      for index < end {
        digit := text[index]
        if digit < 48 || digit > 57 || length > 838860 {
          state.failed = true
          return false
        }
        length = length * 10 + #cast(usize, (digit - 48))
        index += 1
      }
      if length == 0 || length > 8388608 {
        state.failed = true
        return false
      }
      state.body = length
    }
    at = end + 2
  }
  if !found {
    state.failed = true
    return false
  }
  return state.used >= state.header + state.body
}
fn rpc_flush(state: *RpcTransport) {
  if state.pending <= state.sent {
    // Later messages follow once the queue (and any parked message) is out.
    if state.parked || state.later_length == 0 || (state.building && state.build_later) {
      return
    }
    rec_free(#cast(rawptr, state.queue))
    state.queue = state.later
    state.sent = 0
    state.pending = state.later_length
    state.later = nil
    state.later_length = 0
  }
  amount := state.pending - state.sent
  if amount > 65536 {
    amount = 65536
  }
  written := proc_write(state.child.input, &state.queue[..state.pending][state.sent], amount)
  if written > 0 {
    state.sent += #cast(usize, written)
  }
  else if written < 0 && written != -11 && written != -4 {
    state.failed = true
  }
  if state.sent == state.pending && !state.parked && !state.building {
    rec_free(#cast(rawptr, state.queue))
    state.queue = nil
    state.sent = 0
    state.pending = 0
  }
}
fn rpc_drain_errors(state: *RpcTransport) {
  bytes: [1024]u8 = []
  attempt: usize = 0
  for attempt < 4 && !state.error_eof {
    received := proc_read(state.child.error, &bytes[0], 1024)
    if received <= 0 {
      if received == 0 {
        state.error_eof = true
      }
      break
    }
    proc_log(state.log[..], &state.log_length, bytes[..#cast(usize, received)])
    attempt += 1
  }
}
pub fn dna_rpc_size(state: *RpcTransport) isize {
  if state == nil || state.failed {
    return -1
  }
  rpc_flush(state)
  rpc_drain_errors(state)
  ready := rpc_parse(state)
  attempt: usize = 0
  for attempt < 4 && !ready && !state.failed {
    need := state.used + 65536
    if need > 8396800 {
      need = 8396800
    }
    if need == state.used {
      state.failed = true
      break
    }
    if need > state.capacity {
      bytes := proc_realloc(state.incoming, need)
      if bytes == nil {
        state.failed = true
        break
      }
      state.incoming = bytes
      state.capacity = need
    }
    received := proc_read(state.child.output, &state.incoming[..state.capacity][state.used], need - state.used)
    if received > 0 {
      state.used += #cast(usize, received)
      ready = rpc_parse(state)
    }
    else if received == -11 || received == -4 {
      break
    }
    else {
      state.failed = true
      break
    }
    attempt += 1
  }
  if state.pending > state.sent || (state.later_length > 0 && !state.parked) {
    proc_watch(state.child.input, 1)
  } else {
    proc_unwatch(state.child.input)
  }
  if state.error_eof {
    proc_unwatch(state.child.error)
  } else {
    proc_watch(state.child.error, 0)
  }
  proc_watch(state.child.output, 0)
  if state.failed {
    return -1
  }
  if ready {
    return #cast(isize, state.body)
  }
  return 0
}
pub fn dna_rpc_take(state: *RpcTransport, output: *u8, capacity: usize) isize {
  if state == nil || output == nil || state.body == 0 || state.used < state.header + state.body || capacity <= state.body {
    return -1
  }
  length := state.body
  total := state.header + length
  _ = copy(output, &state.incoming[..state.capacity][state.header], length)
  output[..capacity][length] = 0
  if state.used > total {
    _ = proc_move(state.incoming, &state.incoming[..state.capacity][total], state.used - total)
  }
  state.used -= total
  state.header = 0
  state.body = 0
  if state.used > 0 {
    rec_notify()
  }
  return #cast(isize, length)
}
pub fn dna_rpc_log(state: *RpcTransport, output: *u8, capacity: usize) usize {
  if state == nil || output == nil || capacity == 0 {
    return 0
  }
  length := state.log_length
  if length >= capacity {
    length = capacity - 1
  }
  _ = copy(output, &state.log[0], length)
  output[..capacity][length] = 0
  return length
}
pub fn dna_rpc_close(state: *RpcTransport) {
  if state == nil {
    return
  }
  proc_close(&state.child)
  rec_free(#cast(rawptr, state.queue))
  rec_free(#cast(rawptr, state.later))
  rec_free(#cast(rawptr, state.incoming))
  rec_free(#cast(rawptr, state))
}
