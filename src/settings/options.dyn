pub const ExtraCount: usize = 33

pub struct Option {
  key: []const u8,
  section: []const u8,
  local: []const u8,
  default_value: []const u8,
  description: []const u8,
  minimum: f32,
  maximum: f32,
  integer: bool,
  flag: bool,
}

pub fn option(index: usize) Option {
  if index == 0 {
    return Option{key: "document_padding", section: "editor", local: "padding", default_value: "18", description: "Space around document text.", minimum: 0.0, maximum: 100.0, integer: false, flag: false}
  }
  if index == 1 {
    return Option{key: "scroll_margin", section: "editor", local: "scroll_margin", default_value: "3", description: "Lines retained above and below the cursor.", minimum: 0.0, maximum: 30.0, integer: true, flag: false}
  }
  if index == 2 {
    return Option{key: "horizontal_scroll_margin", section: "editor", local: "horizontal_scroll_margin", default_value: "2", description: "Columns retained beside the cursor.", minimum: 0.0, maximum: 30.0, integer: true, flag: false}
  }
  if index == 3 {
    return Option{key: "cursor_animation_ms", section: "cursor", local: "animation_ms", default_value: "50", description: "Cursor transition duration; zero disables animation.", minimum: 0.0, maximum: 500.0, integer: true, flag: false}
  }
  if index == 4 {
    return Option{key: "scroll_animation_ms", section: "scroll", local: "animation_ms", default_value: "50", description: "Scroll transition duration; zero disables animation.", minimum: 0.0, maximum: 500.0, integer: true, flag: false}
  }
  if index == 5 {
    return Option{key: "popup_animation_ms", section: "popups", local: "animation_ms", default_value: "50", description: "Popup fade duration; zero disables animation.", minimum: 0.0, maximum: 500.0, integer: true, flag: false}
  }
  if index == 6 {
    return Option{key: "cursor_thickness", section: "cursor", local: "thickness", default_value: "2", description: "Bar and underline thickness in logical pixels.", minimum: 1.0, maximum: 8.0, integer: false, flag: false}
  }
  if index == 7 {
    return Option{key: "split_ratio", section: "layout", local: "split_ratio", default_value: "0.5", description: "First pane fraction for new splits when equalize_splits is false.", minimum: 0.1, maximum: 0.9, integer: false, flag: false}
  }
  if index == 8 {
    return Option{key: "popup_width", section: "popups", local: "width", default_value: "0.64", description: "Command and message popup width fraction.", minimum: 0.25, maximum: 1.0, integer: false, flag: false}
  }
  if index == 9 {
    return Option{key: "popup_height", section: "popups", local: "height", default_value: "0.56", description: "Maximum dialog height fraction; longer content scrolls.", minimum: 0.2, maximum: 1.0, integer: false, flag: false}
  }
  if index == 10 {
    return Option{key: "popup_padding", section: "popups", local: "padding", default_value: "10", description: "Inner padding for compact popups.", minimum: 0.0, maximum: 40.0, integer: false, flag: false}
  }
  if index == 11 {
    return Option{key: "recovery_interval_ms", section: "recovery", local: "interval_ms", default_value: "500", description: "Minimum delay between recovery snapshots.", minimum: 100.0, maximum: 60000.0, integer: true, flag: false}
  }
  if index == 12 {
    return Option{key: "lsp_timeout_ms", section: "lsp", local: "timeout_ms", default_value: "10000", description: "Language-server request and startup deadline.", minimum: 1000.0, maximum: 120000.0, integer: true, flag: false}
  }
  if index == 13 {
    return Option{key: "lsp_change_delay_ms", section: "lsp", local: "change_delay_ms", default_value: "50", description: "Delay before synchronizing changed documents.", minimum: 0.0, maximum: 2000.0, integer: true, flag: false}
  }
  if index == 14 {
    return Option{key: "plugin_timeout_ms", section: "plugins", local: "timeout_ms", default_value: "5000", description: "Plugin initialization and command deadline.", minimum: 1000.0, maximum: 120000.0, integer: true, flag: false}
  }
  if index == 15 {
    return Option{key: "frame_interval_ms", section: "performance", local: "frame_interval_ms", default_value: "4", description: "Minimum interval between animated frames; frames otherwise follow the display refresh.", minimum: 4.0, maximum: 50.0, integer: true, flag: false}
  }
  if index == 16 {
    return Option{key: "smooth_cursor", section: "cursor", local: "smooth", default_value: "true", description: "Animate cursor movement.", minimum: 0.0, maximum: 1.0, integer: false, flag: true}
  }
  if index == 17 {
    return Option{key: "smooth_scroll", section: "scroll", local: "smooth", default_value: "true", description: "Animate scrolling.", minimum: 0.0, maximum: 1.0, integer: false, flag: true}
  }
  if index == 18 {
    return Option{key: "popup_transitions", section: "popups", local: "transitions", default_value: "true", description: "Animate popup visibility.", minimum: 0.0, maximum: 1.0, integer: false, flag: true}
  }
  if index == 19 {
    return Option{key: "mouse_enabled", section: "mouse", local: "enabled", default_value: "true", description: "Allow mouse selection and pane focus.", minimum: 0.0, maximum: 1.0, integer: false, flag: true}
  }
  if index == 20 {
    return Option{key: "picker_preview", section: "picker", local: "preview", default_value: "true", description: "Show file and buffer previews when space permits.", minimum: 0.0, maximum: 1.0, integer: false, flag: true}
  }
  if index == 21 {
    return Option{key: "syntax_enabled", section: "highlighting", local: "enabled", default_value: "true", description: "Enable Tree-sitter highlighting.", minimum: 0.0, maximum: 1.0, integer: false, flag: true}
  }
  if index == 22 {
    return Option{key: "recovery_enabled", section: "recovery", local: "enabled", default_value: "true", description: "Write automatic crash-recovery snapshots.", minimum: 0.0, maximum: 1.0, integer: false, flag: true}
  }
  if index == 23 {
    return Option{key: "reload_clean_buffers", section: "files", local: "reload_clean", default_value: "true", description: "Reload clean buffers after external changes.", minimum: 0.0, maximum: 1.0, integer: false, flag: true}
  }
  if index == 24 {
    return Option{key: "insert_tabs", section: "editor", local: "insert_tabs", default_value: "false", description: "Insert a tab instead of spaces with Tab.", minimum: 0.0, maximum: 1.0, integer: false, flag: true}
  }
  if index == 25 {
    return Option{key: "final_newline", section: "files", local: "final_newline", default_value: "false", description: "Ensure a final newline when saving nonempty files.", minimum: 0.0, maximum: 1.0, integer: false, flag: true}
  }
  if index == 26 {
    return Option{key: "trim_trailing_whitespace", section: "files", local: "trim_trailing_whitespace", default_value: "false", description: "Remove trailing spaces and tabs on save.", minimum: 0.0, maximum: 1.0, integer: false, flag: true}
  }
  if index == 27 {
    return Option{key: "automatic_completion", section: "lsp", local: "automatic_completion", default_value: "true", description: "Offer completion after a typing pause without taking text input focus.", flag: true}
  }
  if index == 28 {
    return Option{key: "completion_delay_ms", section: "lsp", local: "completion_delay_ms", default_value: "25", description: "Typing pause before automatic completion.", minimum: 10.0, maximum: 2000.0, integer: true}
  }
  if index == 29 {
    return Option{key: "reload_config", section: "files", local: "reload_config", default_value: "true", description: "Reload changed configuration once per second; invalid changes keep the previous settings.", flag: true}
  }
  if index == 30 {
    return Option{key: "cursor_trail_size", section: "cursor", local: "trail_size", default_value: "1", description: "Neovide-style trail on cursor jumps; leading edges arrive first. Zero disables it.", minimum: 0.0, maximum: 1.0}
  }
  if index == 32 {
    return Option{key: "default_servers", section: "lsp", local: "default_servers", default_value: "true", description: "Start a language's default server (rust-analyzer, gopls, zls, clangd...) when it is on PATH and none is configured.", flag: true}
  }
  if index == 31 {
    return Option{key: "equalize_splits", section: "layout", local: "equalize_splits", default_value: "true", description: "Keep panes evenly sized when splitting or closing; false uses split_ratio.", flag: true}
  }
  return Option{}
}

// Bit for KEY in Settings.explicit_extra, or 0 when KEY is not an extra option.
pub fn explicit_extra_bit(key: []const u8) u64 {
  index := extra_find(key)
  if index == ExtraCount {
    return 0
  }
  return #cast(u64) 1 << index
}
fn extra_find(key: []const u8) usize {
  for index in 0..ExtraCount {
    if buffer.equal(option(index).key, key) {
      return index
    }
  }
  return ExtraCount
}
fn extra_apply(result: *Settings, index: usize, text: []const u8) bool {
  spec := option(index)
  numeric: f32 = 0.0
  flag := buffer.equal(text, "true")
  if spec.flag {
    if !flag && !buffer.equal(text, "false") {
      return false
    }
  }
  else {
    numeric = number(text)
    if numeric < spec.minimum || numeric > spec.maximum || (spec.integer && #cast(f32) (#cast(usize) numeric) != numeric) {
      return false
    }
  }
  if index == 0 {
    result.document_padding = numeric
    return true
  }
  if index == 1 {
    result.scroll_margin = numeric
    return true
  }
  if index == 2 {
    result.horizontal_scroll_margin = numeric
    return true
  }
  if index == 3 {
    result.cursor_animation_ms = numeric
    return true
  }
  if index == 4 {
    result.scroll_animation_ms = numeric
    return true
  }
  if index == 5 {
    result.popup_animation_ms = numeric
    return true
  }
  if index == 6 {
    result.cursor_thickness = numeric
    return true
  }
  if index == 7 {
    result.split_ratio = numeric
    return true
  }
  if index == 8 {
    result.popup_width = numeric
    return true
  }
  if index == 9 {
    result.popup_height = numeric
    return true
  }
  if index == 10 {
    result.popup_padding = numeric
    return true
  }
  if index == 11 {
    result.recovery_interval_ms = numeric
    return true
  }
  if index == 12 {
    result.lsp_timeout_ms = numeric
    return true
  }
  if index == 13 {
    result.lsp_change_delay_ms = numeric
    return true
  }
  if index == 14 {
    result.plugin_timeout_ms = numeric
    return true
  }
  if index == 15 {
    result.frame_interval_ms = numeric
    return true
  }
  if index == 16 {
    result.smooth_cursor = flag
    return true
  }
  if index == 17 {
    result.smooth_scroll = flag
    return true
  }
  if index == 18 {
    result.popup_transitions = flag
    return true
  }
  if index == 19 {
    result.mouse_enabled = flag
    return true
  }
  if index == 20 {
    result.picker_preview = flag
    return true
  }
  if index == 21 {
    result.syntax_enabled = flag
    return true
  }
  if index == 22 {
    result.recovery_enabled = flag
    return true
  }
  if index == 23 {
    result.reload_clean_buffers = flag
    return true
  }
  if index == 24 {
    result.insert_tabs = flag
    return true
  }
  if index == 25 {
    result.final_newline = flag
    return true
  }
  if index == 26 {
    result.trim_trailing_whitespace = flag
    return true
  }
  if index == 27 {
    result.automatic_completion = flag
    return true
  }
  if index == 28 {
    result.completion_delay_ms = numeric
    return true
  }
  if index == 29 {
    result.reload_config = flag
    return true
  }
  if index == 30 {
    result.cursor_trail_size = numeric
    return true
  }
  if index == 31 {
    result.equalize_splits = flag
    return true
  }
  if index == 32 {
    result.default_servers = flag
    return true
  }
  return false
}
pub fn option_value(result: *const Settings, index: usize) f32 {
  if index == 0 {
    return result.document_padding
  }
  if index == 1 {
    return result.scroll_margin
  }
  if index == 2 {
    return result.horizontal_scroll_margin
  }
  if index == 3 {
    return result.cursor_animation_ms
  }
  if index == 4 {
    return result.scroll_animation_ms
  }
  if index == 5 {
    return result.popup_animation_ms
  }
  if index == 6 {
    return result.cursor_thickness
  }
  if index == 7 {
    return result.split_ratio
  }
  if index == 8 {
    return result.popup_width
  }
  if index == 9 {
    return result.popup_height
  }
  if index == 10 {
    return result.popup_padding
  }
  if index == 11 {
    return result.recovery_interval_ms
  }
  if index == 12 {
    return result.lsp_timeout_ms
  }
  if index == 13 {
    return result.lsp_change_delay_ms
  }
  if index == 14 {
    return result.plugin_timeout_ms
  }
  if index == 15 {
    return result.frame_interval_ms
  }
  if index == 16 {
    if result.smooth_cursor {
      return 1.0
    }
    return 0.0
  }
  if index == 17 {
    if result.smooth_scroll {
      return 1.0
    }
    return 0.0
  }
  if index == 18 {
    if result.popup_transitions {
      return 1.0
    }
    return 0.0
  }
  if index == 19 {
    if result.mouse_enabled {
      return 1.0
    }
    return 0.0
  }
  if index == 20 {
    if result.picker_preview {
      return 1.0
    }
    return 0.0
  }
  if index == 21 {
    if result.syntax_enabled {
      return 1.0
    }
    return 0.0
  }
  if index == 22 {
    if result.recovery_enabled {
      return 1.0
    }
    return 0.0
  }
  if index == 23 {
    if result.reload_clean_buffers {
      return 1.0
    }
    return 0.0
  }
  if index == 24 {
    if result.insert_tabs {
      return 1.0
    }
    return 0.0
  }
  if index == 25 {
    if result.final_newline {
      return 1.0
    }
    return 0.0
  }
  if index == 26 {
    if result.trim_trailing_whitespace {
      return 1.0
    }
    return 0.0
  }
  if index == 27 {
    if result.automatic_completion {
      return 1.0
    }
    return 0.0
  }
  if index == 28 {
    return result.completion_delay_ms
  }
  if index == 29 {
    if result.reload_config {
      return 1.0
    }
    return 0.0
  }
  if index == 30 {
    return result.cursor_trail_size
  }
  if index == 31 {
    if result.equalize_splits {
      return 1.0
    }
    return 0.0
  }
  if index == 32 {
    if result.default_servers {
      return 1.0
    }
    return 0.0
  }
  return 0.0
}
fn known_section(section: []const u8) bool {
  for index in 0..ExtraCount {
    if buffer.equal(option(index).section, section) {
      return true
    }
  }
  return buffer.equal(section, "theme") || buffer.equal(section, "tasks") || buffer.equal(section, "explorer") || buffer.equal(section, "modules")
}
fn section_key(section: []const u8, key: []const u8) []const u8 {
  if #len(section) == 0 {
    return key
  }
  for index in 0..ExtraCount {
    spec := option(index)
    if buffer.equal(spec.section, section) && buffer.equal(spec.local, key) {
      return spec.key
    }
  }
  if buffer.equal(section, "editor") && buffer.equal(key, "font") {
    return "font"
  }
  if buffer.equal(section, "editor") && buffer.equal(key, "font_size") {
    return "font_size"
  }
  if buffer.equal(section, "editor") && buffer.equal(key, "line_height") {
    return "line_height"
  }
  if buffer.equal(section, "editor") && buffer.equal(key, "fallback_font") {
    return "fallback_font"
  }
  if buffer.equal(section, "editor") && buffer.equal(key, "indent_width") {
    return "indent_width"
  }
  if buffer.equal(section, "editor") && buffer.equal(key, "line_numbers") {
    return "line_numbers"
  }
  if buffer.equal(section, "editor") && buffer.equal(key, "relative_numbers") {
    return "relative_numbers"
  }
  if buffer.equal(section, "editor") && buffer.equal(key, "status_line") {
    return "status_line"
  }
  if buffer.equal(section, "editor") && buffer.equal(key, "highlight_line") {
    return "highlight_line"
  }
  if buffer.equal(section, "editor") && buffer.equal(key, "reduced_motion") {
    return "reduced_motion"
  }
  if buffer.equal(section, "terminal") && buffer.equal(key, "shell") {
    return "shell"
  }
  if buffer.equal(section, "files") && buffer.equal(key, "close_last_buffer") {
    return "close_last_buffer"
  }
  if buffer.equal(section, "terminal") && buffer.equal(key, "terminal_escape") {
    return "terminal_escape"
  }
  if buffer.equal(section, "tasks") && buffer.equal(key, "build_command") {
    return "build_command"
  }
  if buffer.equal(section, "tasks") && buffer.equal(key, "test_command") {
    return "test_command"
  }
  if buffer.equal(section, "tasks") && buffer.equal(key, "run_command") {
    return "run_command"
  }
  if buffer.equal(section, "theme") && buffer.equal(key, "theme") {
    return "theme"
  }
  if buffer.equal(section, "explorer") && buffer.equal(key, "icons") {
    return "explorer_icons"
  }
  if buffer.equal(section, "explorer") && buffer.equal(key, "columns") {
    return "explorer_columns"
  }
  if buffer.equal(section, "explorer") && buffer.equal(key, "preview") {
    return "explorer_preview"
  }
  if buffer.equal(section, "editor") && buffer.equal(key, "font_family") {
    return "font_family"
  }
  if (buffer.equal(section, "modules") || buffer.equal(section, "editor")) && buffer.equal(key, "keymap") {
    return "keymap"
  }
  if buffer.equal(section, "modules") && buffer.equal(key, "frontend") {
    return "frontend"
  }
  if buffer.equal(section, "modules") && buffer.equal(key, "explorer") {
    return "explorer_style"
  }
  if buffer.equal(section, "modules") && buffer.equal(key, "picker") {
    return "picker_style"
  }
  return "!unknown-section-setting"
}
