#target(kernel: darwin)

#link("System")

extern fn operation_clock_raw "clock_gettime"(kind: i32, time: *ThreadTime) i32

fn thread_clock(kind: i32, moment: *ThreadTime) i32 {
  native := kind
  if kind == 3 {
    native = 16
  }
  if kind == 2 {
    native = 12
  }
  return operation_clock_raw(native, moment)
}

fn frontend_display_available() bool {
  return true
}

fn egl_vendor_set() bool {
  return false
}

fn egl_vendor_clear() {
}
