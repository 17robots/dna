#target(kernel: windows)
use "../buffer" raster_buffer
fn native_span_copy(destination:*u8, source:*const u8, length, capacity:usize) rawptr {
  _ = capacity
  return raster_buffer.copy_bytes(destination, source, length)
}
fn native_span_fill(destination:*u8, value:i32, length, capacity:usize) rawptr {
  _ = capacity
  return raster_buffer.fill_bytes(destination, value, length)
}
