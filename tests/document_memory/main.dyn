use "./owned_arena" arena_owner
use "./buffer" buffer
use "std/mem"
extern fn memory_test_fill "__memset_chk"(target: *u8, byte: i32, length: usize, room: usize) rawptr
extern fn memory_test_write "write"(fd: i32, bytes: *const u8, length: usize) isize
extern fn memory_test_read "read"(fd: i32, bytes: *u8, length: usize) isize
const Size: usize = 4194304
fn phase(label: []const u8) {
  _ = memory_test_write(1, &label[0], #len(label))
  token: u8 = 0
  if memory_test_read(0, &token, 1) != 1 {
    #panic("memory phase acknowledgment")
  }
}
fn main() {
  text := arena_owner.create(Size)
  defer arena_owner.release(text)
  payload := mem.push_bytes_uninit(text, Size)
  _ = memory_test_fill(&payload[0], 97, Size, Size + 1)
  owners: [8]*mem.Arena = []
  documents: [8]*buffer.Document = []
  defer {
    for index in 0..8 {
      arena_owner.release(owners[index])
    }
  }
  for index in 0..8 {
    owner := arena_owner.create(#sizeof(buffer.Document))
    owners[index] = owner
    owner = nil
    documents[index] = buffer.allocate(owners[index])
  }
  phase("empty\n")
  for index in 0..8 {
    _ = buffer.load(documents[index], payload)
  }
  phase("clean\n")
  for index in 0..8 {
    _ = buffer.replace(documents[index], "x")
  }
  phase("first_edit\n")
  for index in 0..8 {
    doc := documents[index]
    // Saving midway through a group must retain its older undo baseline.
    buffer.mark_saved(doc)
    _ = buffer.replace(doc, "?")
    if buffer.saved_text(doc)[0] != 'x' || buffer.saved_text(doc)[1] != 'a' || buffer.checkpoint_text(doc)[0] != 'a' {
      #panic("save within edit group corrupts baseline")
    }
    buffer.checkpoint(doc)
    buffer.mark_saved(doc)
  }
  phase("saved\n")
  for index in 0..8 {
    doc := documents[index]
    buffer.undo(doc)
    if doc.length != Size || buffer.byte_at(doc, 0) != 'a' || !buffer.dirty(doc) {
      #panic("undo after page reclamation")
    }
    buffer.redo(doc)
    if doc.length != Size + 2 || buffer.byte_at(doc, 0) != 'x' || buffer.byte_at(doc, 1) != '?' || buffer.dirty(doc) {
      #panic("redo after page reclamation")
    }
    buffer.mark_saved(doc)
  }
  phase("resaved\n")
  for index in 0..8 {
    doc := documents[index]
    _ = buffer.replace(doc, "z")
    buffer.erase(doc, true)
    buffer.checkpoint(doc)
    buffer.mark_saved(doc)
  }
  phase("unchanged_save\n")
  for index in 0..8 {
    doc := documents[index]
    doc.anchor = 0
    doc.cursor = doc.length
    _ = buffer.replace(doc, "x\n")
    buffer.checkpoint(doc)
    buffer.mark_saved(doc)
    buffer.undo(doc)
    if doc.length != Size + 2 || buffer.byte_at(doc, 0) != 'x' || buffer.byte_at(doc, 1) != '?' {
      #panic("large undo delta remains usable")
    }
    buffer.redo(doc)
  }
  phase("history_retained\n")
  for index in 0..8 {
    _ = buffer.load(documents[index], "tiny\n")
  }
  phase("tiny_after_history\n")
  // Keep dirty text and distinct undo groups across thousands of distant edits.
  // The original saved bytes remain an independent oracle throughout the run.
  dirty_document := documents[0]
  _ = buffer.load(dirty_document, payload)
  phase("sustained_clean\n")
  for batch in 0..4 {
    for step in 0..1000 {
      position := (batch * 1000 + step) * 997 % Size
      dirty_document.cursor = position
      dirty_document.anchor = position + 1
      _ = buffer.replace(dirty_document, "z")
      buffer.checkpoint(dirty_document)
    }
    if !buffer.dirty(dirty_document) || dirty_document.history_count != 64 || !buffer.saved_equal(dirty_document, payload) {
      #panic("sustained edits corrupt saved text or history bounds")
    }
    if batch == 0 {
      phase("dirty_1000\n")
    }
  }
  phase("dirty_4000\n")
  for step in 0..63 {
    buffer.undo(dirty_document)
  }
  for step in 0..63 {
    buffer.redo(dirty_document)
  }
  for position in 0..Size {
    expected: u8 = 'a'
    // All 4,000 positions are distinct and below Size.
    if position % 997 == 0 && position / 997 < 4000 {
      expected = 'z'
    }
    if buffer.byte_at(dirty_document, position) != expected {
      #panic("sustained undo/redo text")
    }
  }
  if !buffer.saved_equal(dirty_document, payload) {
    #panic("sustained undo/redo saved text")
  }
  phase("dirty_redo\n")
  _ = buffer.load(dirty_document, "tiny\n")
  phase("tiny_after_dirty\n")
  // A newline-dense file commits a much larger line index than ordinary text.
  _ = memory_test_fill(&payload[0], 10, Size, Size + 1)
  for index in 0..8 {
    _ = buffer.load(documents[index], payload)
    if documents[index].line_count != Size + 1 {
      #panic("large line index")
    }
  }
  phase("many_lines\n")
  for index in 0..8 {
    doc := documents[index]
    // Loading from an alias must consume the source before reclaiming its pages.
    _ = buffer.load(doc, buffer.range(doc, Size - 5, Size))
    if doc.length != 5 || doc.line_count != 6 || buffer.byte_at(doc, 4) != 10 {
      #panic("aliased small reload")
    }
    buffer.undo(doc)
    if doc.length != 5 || doc.history_count != 1 {
      #panic("reload resets history")
    }
  }
  phase("tiny_after_lines\n")
}
