use fs "../../src/filesystem"
use "std/io"
use host "../../src/host"

fn equal(a: []const u8, b: []const u8) bool {
  if a.len != b.len { return false }
  for i in 0..a.len {
    if a[i] != b[i] { return false }
  }
  return true
}
fn exists(path: []const u8) bool {
  _ = fs.metadata(path) catch { return false }
  return true
}
fn content(path: []const u8, expected: []const u8) {
  opened := fs.open(path) catch {
    #panic("open content")
  }
  defer fs.close(&opened)
  storage: [128]u8
  read := fs.read(&opened, storage[..]) catch {
    #panic("content changed unexpectedly")
  }
  if !equal(storage[..read], expected) {
    #panic("content changed unexpectedly")
  }
}
fn clone_and_patch() {
  fs.write_all("clone-source.txt", "0123456789") catch { #panic("clone fixture") }
  source := fs.open("clone-source.txt") catch {
    #panic("clone source open")
  }
  defer fs.close(&source)
  cloned := fs.clone_exclusive(&source, "clone-output.txt") catch {
    expected: [8]u8
    required := host.environment("DNA_TEST_REQUIRE_APFS", expected[..]) catch expected[..0]
    if equal(required, "1") {
      #panic("APFS clone required on this test volume")
    }
    return
  }
  // Editing a clone must not alter the source; shrinking removes its old tail.
  _ = fs.seek(&cloned, 5) catch { #panic("clone seek") }
  fs.write(&cloned, "EDIT") catch { #panic("clone patch") }
  fs.resize(&cloned, 9) catch { #panic("clone resize") }
  fs.close(&cloned)
  content("clone-output.txt", "01234EDIT")
  content("clone-source.txt", "0123456789")
  _ = fs.clone_exclusive(&source, "clone-output.txt") catch {
    content("clone-output.txt", "01234EDIT")
    io.println("PASS native exclusive whole-file clone, patch, resize and unchanged origin")
    return
  }
  #panic("clone replaced existing file")
}
fn mapping_and_ranges() {
  bytes: [262144]u8
  for index in 0..bytes.len {
    bytes[index] = #cast(u8, index % 251 + 1)
  }
  fs.write_all("mapped.bin", bytes[..]) catch { #panic("mapping fixture") }
  source := fs.open("mapped.bin") catch {
    #panic("mapping open")
  }
  defer fs.close(&source)
  mapped := fs.map_file(source.descriptor, #cast(u64, bytes.len))
  expected: [8]u8
  native := host.environment("DNA_TEST_FILE_MAPPING", expected[..]) catch expected[..0]
  if mapped == nil && equal(native, "1") {
    #panic("native mapping unavailable")
  }
  if mapped != nil {
    if #slice(mapped, bytes.len)[0] != bytes[0] || #slice(mapped, bytes.len)[200000] != bytes[200000] {
      #panic("mapping contents")
    }
    // Darwin protects inaccessible backing pages, while already resident
    // private pages may retain old bytes. Windows refuses truncation while
    // views exist. Reads must remain safe and source metadata authoritative.
    truncated := fs.create("mapped.bin") catch fs.File{}
    if truncated.active {
      fs.close(&truncated)
      changed := fs.file_metadata(&source) catch {
        #panic("source truncation not observed")
      }
      if changed.size != 0 {
        #panic("source truncation not observed")
      }
      for position in [100000, 200000] {
        observed := #slice(mapped, bytes.len)[position]
        if observed != 0 && observed != bytes[position] {
          #panic("unexpected truncated mapping contents")
        }
      }
    } else if #slice(mapped, bytes.len)[200000] != bytes[200000] {
      #panic("mapping after refused truncation")
    }
    fs.unmap_file(mapped, #cast(u64, bytes.len))
  }
  fs.write_all("range-source.bin", bytes[..]) catch { #panic("range fixture") }
  origin := fs.open("range-source.bin") catch { #panic("range files") }
  target := fs.create("range-target.bin") catch { #panic("range files") }
  fs.write(&target, "Z") catch { #panic("range prefix") }
  copied: usize = 0
  fs.copy_range(&origin, 1, &target, 200000, &copied) catch {
    if copied != 0 {
      #panic("partial range copy")
    }
    fs.write(&target, bytes[1..200001]) catch { #panic("range fallback") }
  }
  one: [1]u8
  _ = fs.read(&origin, one[..]) catch { #panic("range changed source position") }
  if one[0] != bytes[0] {
    #panic("range changed source position")
  }
  fs.close(&origin)
  fs.close(&target)
  result := fs.open("range-target.bin") catch { #panic("range output size") }
  meta := fs.metadata("range-target.bin") catch { #panic("range output size") }
  if meta.size != 200001 {
    #panic("range output size")
  }
  offset: usize = 0
  part: [16384]u8
  for offset < 200001 {
    read := fs.read(&result, part[..]) catch { #panic("range output read") }
    if read == 0 {
      #panic("range output read")
    }
    for index in 0..read {
      wanted := bytes[offset + index]
      if offset + index == 0 {
        wanted = 90
      }
      if part[index] != wanted {
        #panic("range output bytes")
      }
    }
    offset += read
  }
  fs.close(&result)
}
fn open_nofollow_fails(path: []const u8) bool {
  refused := fs.open_nofollow(path) catch { return true }
  fs.close(&refused)
  return false
}
fn main() {
  mapping_and_ranges()
  clone_and_patch()
  private := fs.create_private_exclusive("private.txt") catch {
    #panic("private create")
  }
  fs.write(&private, "private") catch { #panic("private write") }
  fs.set_permissions(&private, 384) catch { #panic("private chmod") }
  fs.close(&private)
  fs.make_directory("private-directory", 448) catch {
    #panic("private directory permissions")
  }
  copied := fs.create_private_exclusive("copied-permissions.txt") catch {
    #panic("create permission copy")
  }
  fs.preserve_permissions(&copied, "private.txt") catch { #panic("preserve permissions") }
  fs.write(&copied, "copied") catch { #panic("permission copy write") }
  fs.close(&copied)
  private_transaction := fs.atomic_begin_private("session.txt", "session.tmp") catch {
    #panic("private atomic save")
  }
  fs.write(&private_transaction.file, "session") catch { #panic("private atomic save") }
  fs.atomic_commit(&private_transaction) catch { #panic("private atomic save") }
  if exists("absent") {
    #panic("missing metadata")
  }
  fs.write_all("source café.txt", "source") catch { #panic("create fixtures") }
  fs.write_all("target 日本語.txt", "target") catch { #panic("create fixtures") }
  safe := fs.open_nofollow("source café.txt") catch {
    #panic("safe open regular file")
  }
  info := fs.file_metadata(&safe) catch { #panic("handle metadata") }
  if info.size != 6 {
    #panic("handle metadata")
  }
  fs.close(&safe)
  source := fs.metadata("source café.txt") catch { #panic("regular metadata") }
  if source.size != 6 || (source.mode & 61440) != 32768 {
    #panic("regular metadata")
  }
  renamed_existing := true
  fs.rename_noreplace("source café.txt", "target 日本語.txt") catch { renamed_existing = false }
  if renamed_existing {
    #panic("rename overwrote destination")
  }
  content("source café.txt", "source")
  content("target 日本語.txt", "target")
  fs.rename_noreplace("source café.txt", "moved.txt") catch { #panic("rename to new path") }
  if exists("source café.txt") {
    #panic("rename to new path")
  }
  content("moved.txt", "source")
  transaction := fs.atomic_begin("target 日本語.txt", "temporary.txt") catch { #panic("atomic begin/write") }
  fs.write(&transaction.file, "replacement") catch { #panic("atomic begin/write") }
  content("target 日本語.txt", "target")
  fs.atomic_commit(&transaction) catch { #panic("atomic commit") }
  if transaction.active || exists("temporary.txt") {
    #panic("atomic commit")
  }
  content("target 日本語.txt", "replacement")
  aborted := fs.atomic_begin("target 日本語.txt", "temporary.txt") catch { #panic("atomic abort") }
  fs.write(&aborted.file, "discard") catch { #panic("atomic abort") }
  fs.atomic_abort(&aborted) catch { #panic("atomic abort") }
  content("target 日本語.txt", "replacement")
  if exists("temporary.txt") {
    #panic("abort left temporary")
  }
  // A directory cannot be overwritten with a regular file. Abort must still
  // clean the temporary after commit has closed its handle and rename fails.
  failed := fs.atomic_begin("protected-directory", "temporary.txt") catch { #panic("failure fixture") }
  fs.write(&failed.file, "discard") catch { #panic("failure fixture") }
  committed_dir := true
  fs.atomic_commit(&failed) catch { committed_dir = false }
  if committed_dir || !failed.active {
    #panic("invalid replacement succeeded")
  }
  fs.atomic_abort(&failed) catch {
    #panic("abort after failed commit")
  }
  protected_meta := fs.metadata("protected-directory") catch { #panic("directory lost") }
  if (protected_meta.mode & 61440) != 16384 {
    #panic("directory lost")
  }
  storage: [8192]u8
  opened := fs.open_directory(".", storage[..]) catch {
    #panic("open directory")
  }
  found: usize = 0
  for true {
    entry := fs.directory_next(&opened) catch {
      #panic("directory enumeration failed")
    }
    if opened.ended { break }
    if equal(entry.name, ".") || equal(entry.name, "..") {
      #panic("dot entry")
    }
    if equal(entry.name, "target 日本語.txt") {
      found += 1
    }
    if equal(entry.name, "moved.txt") {
      found += 1
    }
    if equal(entry.name, "protected-directory") {
      found += 1
    }
  }
  if found != 3 {
    #panic("directory names or close")
  }
  if exists("link-enabled") {
    if !open_nofollow_fails("link.txt") {
      #panic("safe open followed symlink")
    }
    link := fs.metadata_nofollow("link.txt") catch { #panic("symlink metadata") }
    followed := fs.metadata("link.txt") catch { #panic("symlink metadata") }
    if (link.mode & 61440) != 40960 || followed.size != 11 {
      #panic("symlink metadata")
    }
    target: [4096]u8
    result := fs.read_link("link.txt", target[..]) catch { #panic("symlink target") }
    if !equal(result, "target 日本語.txt") {
      #panic("symlink target")
    }
    fs.remove("link.txt") catch { #panic("unlink symlink") }
    content("target 日本語.txt", "replacement")
  }
  fs.remove("moved.txt") catch { #panic("remove") }
  if exists("moved.txt") {
    #panic("remove")
  }
  io.println("PASS filesystem Unicode, metadata, enumeration, no-overwrite, atomic commit/abort")
}
