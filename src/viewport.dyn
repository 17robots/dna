// Shape only complete lines intersecting the viewport. Keep document offsets
// separate from text-object offsets; UTF-8 shaping stays with SDL_ttf.
struct TextViewport { start, end: usize, y: f32 }

fn text_viewport(doc: *const buffer.Document, line, height: f32, scroll: *f32) TextViewport {
  cursor_y := #cast(f32) (line_number(doc) - 1) * line

  if cursor_y < scroll.* {
    scroll.* = cursor_y
  }
  if cursor_y + line > scroll.* + height {
    scroll.* = cursor_y + line - height
  }
  if scroll.* < 0.0 {
    scroll.* = 0.0
  }

  return visible_viewport(doc, line, height, scroll.*)
}
fn visible_viewport(doc: *const buffer.Document, line, height, scroll: f32) TextViewport {
  first := #cast(usize) (scroll / line)
  count := #cast(usize) (height / line) + 2
  row := first
  if row >= doc.line_count {
    row = doc.line_count - 1
  }

  return TextViewport{  start: buffer.row_start(doc, row), end: buffer.row_start(doc, row + count), y: #cast(f32) row * line  }
}
