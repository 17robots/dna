use "./files" files
use "./buffer" buffer
use "std/mem" mem
use "std/fs" fs
fn main() {
  owner := buffer.reserve(#sizeof(buffer.Document) + 2097152)
  if !owner.ok {
    #panic("arena")
  }
  defer _ = mem.arena_release(&owner.arena)
  doc := buffer.allocate(&owner.arena)
  state := files.State{}
  if #len(files.open(&state, doc, "original.txt", &owner.arena)) != 0 {
    #panic("open")
  }
  doc.anchor = 0
  doc.cursor = doc.length
  _ = buffer.replace(doc, "A replacement deliberately longer than the imposed write limit.")
  if #len(files.save(&state, doc, "original.txt", &owner.arena)) == 0 {
    #panic("failed save accepted")
  }
  old := fs.read_all(&owner.arena, "original.txt", 100)
  if !old.ok || !buffer.equal(old.data, "original") || !buffer.dirty(doc) {
    #panic("failed save lost original or unsaved changes")
  }
}
