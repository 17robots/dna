use "std/enums"

// Command metadata shared by palette, exact command aliases and leader menu.
// Context-sensitive/argument commands keep their domain-specific parsers.
// arguments names what follows the command, for palette suggestions (see
// palette_arguments.dyn); a leading "!" means it is required, so choosing the
// command types its name into the palette instead of running it.
struct CommandInfo { label, aliases, key, hint, arguments: str }

enum Command {
  OpenFile,
  Write,
  SaveAs,
  Search,
  FindNext,
  Undo,
  Redo,
  Explorer,
  LayoutLoad,
  LayoutCompact,
  LayoutWide,
  ZoomIn,
  ZoomOut,
  ZoomReset,
  Recover,
  DiscardChanges,
  QuitAll,
  NewBuffer,
  FileCreate,
  FileRename,
  FileTrash,
  Buffers,
  NextBuffer,
  PrevBuffer,
  CloseBuffer,
  ToggleLineNumbers,
  ToggleStatusLine,
  ToggleRelativeNums,
  ToggleHighlightLine,
  ExplorerWrite,
  ExplorerDiscard,
  ExplorerRefresh,
  VSplit,
  HSplit,
  WindowClose,
  WindowOnly,
  TerminalPopup,
  TerminalNew,
  TerminalSplit,
  ConfigReload,
  ConfigEdit,
  ProjectDirectory,
  ChooseFont,
  ManageLanguages,
  ReloadLanguages,
  TaskBuild,
  TaskTest,
  TaskRun,
  TaskNextError,
  ChangeDirectory,
  LanguageInstall,
  SwitchTheme,
  VNew,
  HNew,
  SetFiletype,
  GlobalSearch,
  ChooseTheme,
  ChooseLayout,
  FindSetting,
  ResizePane,
  EqualizePanes,
  SessionSave,
  SessionLoad,
  PluginLoad,
  PluginLog,
  PluginsDisable,
  ReplacePreview,
  TaskDiagnostics,
  TaskPrevError,
  Recoveries,
  LayoutSave,
  PluginInstall,
  PluginUpdate,
  PluginList,
  LspComplete,
  LspHover,
  LspDefinition,
  LspReferences,
  LspRenameSymbol,
  LspCodeActions,
  LspDiagnostics,
  LspConfig,
  LspStart,
  LspRestart,
  LspLog,
  LspStop,
  DiskReload,
  PluginDisable,
  PluginRemove,
  WindowsMenu,
  GotoMenu,
  CommandsMenu,
  BufferDelete,
  SaveClose,
  SaveAll,
  SaveAllQuit,
  TrustProject,
  ConfigSources,
  PlacePanel,
  ShowModules,
  SwitchModule,
  SwitchKeymap,
  SwitchFrontend,
  Suspend,
  ToggleComment,
  FormatDocument,
  FormatCancel,
  PluginRollback,
  ServerInstall,
  ServerUpdate,
  ServerStart,
  SetOption,
  FileSymbols,
  WorkspaceSymbols,
  TreeFocus,
}

const BuiltinCommands: usize = 115
const PluginCommandBase: usize = 128
const DiscardConfirmId: usize = 15

fn command_id(cmd: Command) usize {
  return #cast(usize, cmd)
}
fn command_from_id(id: usize) Command {
  return enums.from_int<Command>(id)
}
fn command_info(id: usize) CommandInfo {
  if id >= BuiltinCommands { return CommandInfo{} }
  case command_from_id(id) {
    .OpenFile => { return CommandInfo{label: "Open file                     Space f", aliases: "open|e", key: "f", hint: "file picker", arguments: "file"} }
    .Write => { return CommandInfo{label: "Write / Save                  :write", aliases: "write|w", key: "", hint: "", arguments: "path"} }
    .SaveAs => { return CommandInfo{label: "Save as", aliases: "", key: "", hint: ""} }
    .Search => { return CommandInfo{label: "Search                        /", aliases: "", key: "", hint: ""} }
    .FindNext => { return CommandInfo{label: "Find next                     n", aliases: "", key: "", hint: ""} }
