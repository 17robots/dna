// SDL keycodes and modifier masks used by input handling. Letters and
// punctuation are their ASCII values; navigation keys carry SDL's scancode
// bit. Names keep dispatch readable and give keymaps one vocabulary.
const KeyBackspace: u32 = 8
const KeyTab: u32 = 9
const KeyReturn: u32 = 13
const KeyEscape: u32 = 27
const KeySpace: u32 = 32
const KeyQuote: u32 = 34
const KeyAmpersand: u32 = 38
const KeyAsterisk: u32 = 42
const Key7: u32 = 55
const Key8: u32 = 56
const KeyLeftBracket: u32 = 91
const KeyRightBracket: u32 = 93
const KeyDollar: u32 = 36
const KeyPercent: u32 = 37
const KeyApostrophe: u32 = 39
const KeyLeftParen: u32 = 40
const KeyRightParen: u32 = 41
const KeyPlus: u32 = 43
const KeyComma: u32 = 44
const KeyMinus: u32 = 45
const KeyPeriod: u32 = 46
const KeySlash: u32 = 47
const Key0: u32 = 48
const Key4: u32 = 52
const Key5: u32 = 53
const Key9: u32 = 57
const KeyColon: u32 = 58
const KeySemicolon: u32 = 59
const KeyLess: u32 = 60
const KeyEquals: u32 = 61
const KeyGreater: u32 = 62
const KeyQuestion: u32 = 63
const KeyUpperT: u32 = 84
const KeyUpperW: u32 = 87
const KeyBackslash: u32 = 92
const KeyUnderscore: u32 = 95
const KeyGrave: u32 = 96
