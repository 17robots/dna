struct InputState {
  pending: u8,
  pending_count: usize,
  goto_count: usize,
  repeat_count: usize,
  search_backwards: bool,
  goto_explorer: bool,
  leader_explorer: bool,
  // z (one command) or Z (sticky) view mode; ]/[ direction.
  view_sticky, bracket_forward: bool,
  // DNA_KEY_TRACE=1 prints how each key is routed, to stderr.
  trace_checked, trace: bool,
  // The typed character for the current key event (layout and Shift
  // applied), or 0 when unknown; the Vim profile reads commands from it.
  character: u32,
  // Last f/t/F/T motion (pending 1-4) for Alt-. repeat.
  last_find, last_find_length: u8,
  last_find_count: usize,
  last_find_text: [4]u8,
}

struct Clipboard {
  arena: *mem.Arena,
  owned: bool,
  text: str,
  count: usize,
  starts: [32]usize,
  lengths: [32]usize,
  // Vim: the text is whole lines (dd, yy) and puts below or above.
  linewise: bool,
}

// a-z are 1-26; " + * are the system clipboard (0); 32 means invalid.
fn register_code(text: str) usize {
  if text.len != 1 { return 32 }
  byte := text[0]
  if byte >= 'a' && byte <= 'z' { return #cast(usize, (byte - 'a')) + 1 }
  if byte == '"' || byte == '+' || byte == '*' { return 0 }
  if byte == '_' { return RegisterBlackHole }
  if byte == '/' { return RegisterSearch }
  if byte == '%' { return RegisterFile }
  if byte == '#' { return RegisterIndices }
  if byte == '.' { return RegisterSelections }
  return 32
}
fn selected_clipboard(app: *App) *Clipboard {
  if app.register_state.selected > 0 && app.register_state.selected <= 26 {
    return &app.register_state.named[app.register_state.selected - 1]
  }
  return &app.register_state.clipboard
}
fn clipboard_release(app: *App) {
  if app.register_state.clipboard.owned {
    arena_owner.release(app.register_state.clipboard.arena)
    app.register_state.clipboard.arena = nil
  }
  app.register_state.clipboard.owned = false
  app.register_state.clipboard.count = 0
}
fn clipboard_replace(app: *App, doc: *buffer.Document, text: str) bool {
  retained := selected_clipboard(app)
  if retained.owned && retained.count == doc.secondary.count + 1 && buffer.equal(retained.text, text) {
    fragments: [32]str
    for index in 0..retained.count {
      fragments[index] = text[retained.starts[index]..retained.starts[index] + retained.lengths[index]]
    }
    return buffer.replace_fragments(doc, fragments[..retained.count])
  }
  return buffer.replace_all(doc, text)
}
// All input paths feed the same document operations, including smoke events.
fn prompting(app: *const App) bool {
  return app.prompt_state.panel == .ProjectSearch || app.prompt_state.panel == .Buffers || app.prompt_state.panel == .Commands || app.prompt_state.panel == .Open || app.prompt_state.panel == .SaveAs || search_prompt(app.prompt_state.panel) || app.prompt_state.panel == .Layout || app.prompt_state.panel == .FileOp
}
// Keep text input enabled both while waiting and while draining queued events.
fn wants_text_input(app: *App) bool {
  if app.prompt_state.panel==.Tree && app.tree.searching { return true }
  if app.prompt_state.panel == .Open && app.resource_state.kind == .Languages {
    return app.language_manager.searching
  }
  if terminal_target(app) != nil { return terminal_mode(app).input }
  return (app.prompt_state.panel == .LspResults && (app.lsp.results.kind == 13 || app.lsp.results.kind == 14)) || (app.prompt_state.panel == .Hover && app.view.insert) || app.register_state.pending || completion_visible(app) || (app.prompt_state.panel == .Match && app.match_state.stage != 0) || app.input_state.pending != 0 || prompting(app) || (app.prompt_state.panel == .None && app.view.insert) || (app.prompt_state.panel == .Directory && app.explorer.insert)
}
fn changed(app: *App, text: str) {
  if snippet_replace(app, text) { return }
  if !buffer.replace_all(app.documents.current, text) {
    notice(app, "Edit rejected: invalid UTF-8, NUL, or an insertion over 256 MiB.")
  }
}
fn text_input(app: *App, text: str) {
  explorer_borrow:=explorer_vim_begin(app)
  defer explorer_vim_end(app, &explorer_borrow)
  if app.prompt_state.panel == .Open && app.resource_state.kind == .Languages && !app.language_manager.searching {
    return
  }
  if macro_active(app) && !app.macro_state.replaying { return }
  // The text of a key a binding took (insert-mode "j k") does not type.
  swallow := app.binding_state.swallow
  app.binding_state.swallow = 0
  if swallow != 0 {
    encoded: [4]u8
    if buffer.equal(text, encoded[..vim_encode(swallow, encoded[..])]) { return }
  }
  macro_text(app, text)
  vim_record_text(app, text)
  if app.view.insert && app.prompt_state.panel == .None {
    insert_repeat_text(app, text)
  }
  app.composition.length = 0
  if app.prompt_state.panel == .Hover {
    app.prompt_state.panel = .None
  }
  // Word characters keep an open completion and refilter it; anything else closes it.
  refilter := false
  if completion_visible(app) && !completion_session(app) {
    app.prompt_state.panel = .None
    lsp_results_release(app)
  }
  if completion_session(app) {
    refilter = text.len > 0
    for byte in text {
      if !completion_word_byte(byte) {
        refilter = false
      }
    }
    if !refilter {
      app.prompt_state.panel = .None
      lsp_results_release(app)
    }
  }
  if !buffer.valid(text) {
    notice(app, "Input must be UTF-8 text without NUL bytes.")
    return
  }
  if app.prompt_state.panel==.Tree && app.tree.searching {
    tree_search_text(app, text)
    return
  }
  if app.prompt_state.panel == .LspResults && (app.lsp.results.kind == 13 || app.lsp.results.kind == 14) {
    lsp_symbol_query(app, text, false)
    return
  }
  target := terminal_target(app)
  if target != nil {
    if terminal_mode(app).input && text.len > 0 {
      terminal_escape_flush(app)
      terminal_text(target, &text[0], text.len)
    }
    return
  }
  if app.register_state.pending {
    app.register_state.pending = false
    app.register_state.selected = register_code(text)
    if app.register_state.selected > 31 {
      app.register_state.selected = 0
      notice(app, "Register must be a-z, \", +, *, _, /, %, # or .")
    }
    return
  }
  if app.prompt_state.panel == .Match {
    match_character(app, text)
    return
  }
  if app.input_state.pending != 0 {
    character_input(app, text)
    return
  }
  if prompting(app) {
    if app.prompt_state.length + text.len >= 4096 {
      notice(app, "Input is too long.")
      return
    }
    add_text(app.prompt_state.text[..], &app.prompt_state.length, text)
    app.prompt_state.selected = 0
    if app.prompt_state.panel == .Open {
      completion_refresh(app)
    }
    if search_prompt(app.prompt_state.panel) {
      search_preview_request(app)
    }
    if app.prompt_state.panel == .ProjectSearch {
      project_search_refresh(app)
    }
  } else if app.prompt_state.panel == .Directory && app.explorer.insert {
    if !buffer.replace_all(app.explorer.document, text) {
      notice(app, "Explorer edit exceeds text capacity.")
    }
  } else if (app.prompt_state.panel == .None || completion_visible(app)) && app.view.insert && app.config.vim_keys && app.vim.replacing {
    vim_replace_text(app, text)
  } else if (app.prompt_state.panel == .None || completion_visible(app)) && app.view.insert {
    changed(app, text)
    app.lsp.completion_typed = true
    if refilter {
      completion_refilter(app)
    }
  }
}
fn clipboard_copy(app: *App) bool {
  if app.register_state.selected == RegisterBlackHole { return true }
  if app.register_state.selected > 26 {
    notice(app, "Register is read-only.")
    return false
  }
  doc := app.documents.current
  selections: [32]buffer.Selection
  selections[0] = buffer.Selection{anchor: buffer.start(doc), cursor: buffer.end(doc)}
  count := doc.secondary.count + 1
  for index in 1..count {
    selection := doc.secondary.ranges[index - 1]
    if selection.anchor > selection.cursor {
      swap := selection.anchor
      selection.anchor = selection.cursor
      selection.cursor = swap
    }
    selections[index] = selection
  }
  for index in 1..count {
    moving := selections[index]
    at := index
    for at > 0 && selections[at - 1].anchor > moving.anchor {
      selections[at] = selections[at - 1]
      at -= 1
    }
    selections[at] = moving
  }
  // Selected text plus one newline separator per selection bounds the joined size.
  total: usize = 0
  for index in 0..count {
    total += selections[index].cursor - selections[index].anchor + 1
  }
  if total == count { return true }
  allocated := arena_owner.create(total + 1)
  storage := mem.push_bytes(allocated, total + 1)
  offsets: [32]usize
  lengths: [32]usize
  used: usize = 0
  for index in 0..count {
    selected := selections[index]
    if used > 0 && storage[used - 1] != 10 {
      add_text(storage, &used, "\n")
    }
    offsets[index] = used
    lengths[index] = selected.cursor - selected.anchor
    add_text(storage, &used, buffer.range(doc, selected.anchor, selected.cursor))
  }
  storage[used] = 0
  if app.register_state.selected == 0 && !sdl.clipboard_set(&storage[0]) {
    notice(app, "Clipboard copy failed.")
    arena_owner.release(allocated)
    return false
  }
  slot := selected_clipboard(app)
  if slot.owned {
    arena_owner.release(slot.arena)
    slot.arena = nil
  }
  slot.arena = allocated
  allocated = nil
  slot.owned = true
  slot.text = storage[..used]
  slot.linewise = false
  slot.count = count
  slot.starts = offsets
  slot.lengths = lengths
  return true
}
// A paste from the terminal the TUI runs in. Terminal panes get it as a
// bracketed paste; prompts and panels as typed text; documents take it raw
// (no auto-pairs or indentation), at the caret in insert mode and before the
// selection otherwise.
fn paste_input(app: *App, text: str) {
  if text.len == 0 { return }
  if !buffer.valid(text) {
    notice(app, "Paste must be UTF-8 text without NUL bytes.")
    return
  }
  target := terminal_target(app)
  if target != nil {
    if terminal_mode(app).input {
      terminal_escape_flush(app)
      terminal_paste(target, &text[0], text.len)
    }
    return
  }
  if app.prompt_state.panel != .None || app.input_state.pending != 0 || app.register_state.pending {
    text_input(app, text)
    return
  }
  if text.len > buffer.Capacity {
    notice(app, "Paste exceeds document capacity.")
    return
  }
  doc := app.documents.current
  buffer.checkpoint(doc)
  if !app.view.insert {
    start := doc.anchor
    if doc.cursor < start {
      start = doc.cursor
    }
    buffer.move_to(doc, start, false)
  }
  if !clipboard_replace(app, doc, text) {
    notice(app, "Paste exceeds capacity or has conflicting selections.")
  }
  buffer.checkpoint(doc)
}
fn clipboard_paste(app: *App) {
  incoming := sdl.clipboard_get()
  if incoming == nil {
    status_error(app, "Clipboard unavailable.")
    return
  }
  defer sdl.free(#cast(rawptr, incoming))
  length := c.string_length(incoming, buffer.Capacity + 1)
  if length > buffer.Capacity {
    notice(app, "Clipboard exceeds document capacity.")
    return
  }
  buffer.checkpoint(app.documents.current)
  if !clipboard_replace(app, app.documents.current, #slice(incoming, length)) {
    notice(app, "Paste exceeds capacity or has conflicting selections.")
  }
  buffer.checkpoint(app.documents.current)
}
fn key_trace(app: *App, key: u32, modifiers: u16) {
  if !app.input_state.trace_checked {
    app.input_state.trace_checked = true
    storage: [8]u8
    setting := host.environment("DNA_KEY_TRACE", storage[..]) catch storage[..0]
    app.input_state.trace = buffer.equal(setting, "1")
  }
  if !app.input_state.trace { return }
  line: [512]u8
  used: usize = 0
  add_text(line[..], &used, "key ")
  add_number(line[..], &used, key)
  add_text(line[..], &used, " mods ")
  add_number(line[..], &used, modifiers)
  add_text(line[..], &used, " panel ")
  add_text(line[..], &used, render_panel(app.prompt_state.panel))
  add_text(line[..], &used, " active ")
  add_number(line[..], &used, app.documents.active)
  slot := app.documents.slots[app.documents.active]
  if slot.terminal.handle != nil {
    add_text(line[..], &used, " terminal")
    if slot.terminal.input {
      add_text(line[..], &used, " input")
    } else {
      add_text(line[..], &used, " normal")
    }
  }
  if terminal_target(app) != nil {
    add_text(line[..], &used, " target")
  }
  if app.view.insert {
    add_text(line[..], &used, " insert")
  }
  add_text(line[..], &used, " focused-pane ")
  add_number(line[..], &used, app.view.focused)
  add_text(line[..], &used, "\n")
  host.write_error(line[..used])
}
fn key_input(app: *App, typography: *Typography, key: u32, modifiers: u16) {
  // The native backend sends modifier presses separately from the modified character.
  // They are not commands: e.g. Shift between vi and { must not cancel i.
  // Ignore them before prefix dispatch, completion/snippet handling, or recording.
  if (key >= 1073742048 && key <= 1073742055) || key == 1073742081 { return }
  // A status message lasts until the next key; the key may set a new one.
  status_message_clear(app)
  explorer_borrow:=explorer_vim_begin(app)
  defer explorer_vim_end(app, &explorer_borrow)
  // Helix `.` repeats the last insert.
  if !app.config.vim_keys && !app.view.insert && app.prompt_state.panel == .None && key == KeyPeriod && modifiers == 0 && app.input_state.pending == 0 && insert_repeat_run(app, typography) {
    return
  }
  defer insert_repeat_after_key(app, key, modifiers, app.view.insert)
  recorded_panel:=app.prompt_state.panel
  if app.explorer.vim_borrowed {
    app.prompt_state.panel=.None
  }
  vim_record_key(app, key, modifiers)
  app.prompt_state.panel=recorded_panel
  key_dispatch(app, typography, key, modifiers)
  vim_settle(app)
  explorer_vim_finish(app, typography, &explorer_borrow)
}
// Enter normal mode through the same path whether completion is open or not.
fn input_normal_mode(app: *App) {
  doc := app.documents.current
  app.input_state.repeat_count = 0
  app.input_state.pending = 0
  app.register_state.pending = false
  app.register_state.selected = 0
  if snippet_valid(app) {
    app.lsp.snippet.active = false
    doc.secondary.count = 0
  }
  if app.config.vim_keys && app.view.insert {
    vim_insert_finish(app)
  }
  buffer.checkpoint(doc)
  if app.view.insert {
    buffer.leave_insert(doc)
  }
  app.view.insert = false
  app.view.extend = false
  if app.config.vim_keys {
    vim_escape(app)
  }
}
fn key_early_panel(app: *App, key: u32) bool {
  case app.prompt_state.panel {
    .Setting => {
      if key == KeyEscape {
        app.prompt_state.panel = .None
      } else if key == KeyReturn {
        setting_edit(app)
      }
      return true
    }
    .FileConflict => {
      if key == KeyEscape || key == KeyK {
        app.prompt_state.panel = .None
      } else if key == KeyR {
        disk_reload(app, true)
      } else if key == KeyS {
        panel(app, .SaveAs)
      }
      return true
    }
    .LspResults, .LspEdit, .Diagnostics => {
      if key == KeyEscape {
        if app.prompt_state.panel == .LspResults && app.lsp.results.kind == 1 {
          completion_cancel_refresh(app)
          lsp_results_release(app)
          app.prompt_state.panel = .None
          input_normal_mode(app)
          return true
        }
        if app.prompt_state.panel == .LspEdit {
          lsp_edits_release(app)
        }
        app.prompt_state.panel = .None
        return true
      }
      if key == KeyReturn || (key == KeyTab && app.prompt_state.panel == .LspResults && app.lsp.results.kind == 1) {
        if app.prompt_state.panel == .LspEdit {
          lsp_apply(app)
        } else if app.prompt_state.panel == .LspResults {
          lsp_accept(app)
        } else {
          diagnostics := &app.documents.slots[app.documents.active].diagnostics
          if app.prompt_state.selected < diagnostics.count && diagnostics.revision == app.documents.current.revision {
            item := &diagnostics.items[app.prompt_state.selected]
            position := lsp.offset(buffer.all(app.documents.current), lsp.Position{line: item.line, character: item.character})
            if position.valid {
              jump_push(app)
              buffer.move_to(app.documents.current, position.value, false)
              buffer.select_current(app.documents.current)
            }
          }
          app.prompt_state.panel = .None
        }
        return true
      }
      if key == KeyBackspace && app.prompt_state.panel == .LspResults && (app.lsp.results.kind == 13 || app.lsp.results.kind == 14) {
        lsp_symbol_query(app, "", true)
        return true
      }
      count := app.lsp.results.count
      if app.prompt_state.panel == .Diagnostics {
        count = app.documents.slots[app.documents.active].diagnostics.count
      }
      if key == KeyDown && app.prompt_state.selected + 1 < count {
        app.prompt_state.selected += 1
      }
      if key == KeyUp && app.prompt_state.selected > 0 {
        app.prompt_state.selected -= 1
      }
      return true
    }
    _ => { return false }
  }
}
fn key_modal_panel(app: *App, key: u32) bool {
  case app.prompt_state.panel {
    .PluginGrant, .PluginEdit => {
      if key == KeyEscape {
        app.prompt_state.panel = .None
      } else if key == KeyReturn {
        if app.prompt_state.panel == .PluginGrant {
          plugin_start_pending(app)
        } else {
          plugin_apply_edit(app)
        }
      }
      return true
    }
    .ReplacePreview => {
      if key == KeyEscape {
        replace_release(app)
        app.prompt_state.panel = .None
      } else if key == KeyReturn {
        replace_apply(app)
      } else if key == KeyDown && app.prompt_state.selected + 1 < app.replacement.plan.count {
        app.prompt_state.selected += 1
      } else if key == KeyUp && app.prompt_state.selected > 0 {
        app.prompt_state.selected -= 1
      }
      return true
    }
    .TerminalClose => {
      if key == KeyEscape || key == KeyC {
        cancel_buffer_close(app)
      } else if key == KeyReturn {
        if app.picker_state.closing {
          close_slot(app, app.picker_state.close_target)
          finish_picker_close(app)
        } else if app.terminal_state.closing_all {
          app.terminal_state.quit_confirmed = true
          request_quit(app)
        } else {
          close_clean(app)
        }
      }
      return true
    }
    _ => { return false }
  }
}
fn key_panel_escape(app: *App) {
  if app.prompt_state.panel == .ProjectSearch {
    project_search_close(app)
    return
  }
  if app.prompt_state.panel == .Open {
    app.resource_state.fonts = false
    app.resource_state.kind = .None
  }
  if app.prompt_state.panel == .Commands && app.terminal_state.commands {
    app.terminal_state.commands = false
    app.prompt_state.panel = .Terminal
    return
  }
  app.input_state.repeat_count = 0
  app.input_state.pending = 0
  app.register_state.pending = false
  app.register_state.selected = 0
  case app.prompt_state.panel {
    .Match => { match_close(app) }
    // A cancelled file action returns to the explorer that started it.
    .FileOp, .Trash => { file_op_finish(app, "") }
    .Leader => {
      app.prompt_state.panel = .None
      if app.input_state.leader_explorer {
        app.prompt_state.panel = .Directory
      }
      app.input_state.leader_explorer = false
    }
    .Goto => {
      app.prompt_state.panel = .None
      if app.input_state.goto_explorer {
        app.prompt_state.panel = .Directory
      }
      app.input_state.goto_explorer = false
    }
    .None => { input_normal_mode(app) }
    _ => {
      if search_prompt(app.prompt_state.panel) {
        search_restore(app)
        search_close(app)
      } else if app.prompt_state.panel == .Commands && app.explorer.commands {
        app.explorer.commands = false
        app.prompt_state.panel = .Directory
      } else {
        cancel_buffer_close(app)
      }
    }
  }
}
fn key_leader_dispatch(app: *App, typography: *Typography, key: u32, shift: bool) {
  normalized := key
  if key == KeyUpperT {
    normalized = KeyT
  }
  if key == KeySpace || (key == KeySemicolon && shift) {
    normalized = KeyColon
  }
  chosen := PluginCommandBase
  for index in 0..LeaderCommands {
    id := leader_command(index)
    info := command_info(id)
    if info.key.len == 1 && normalized == info.key[0] {
      chosen = id
      break
    }
  }
  if chosen == PluginCommandBase { return }
  if chosen == command_id(.CloseBuffer) && app.input_state.leader_explorer {
    app.prompt_state.panel = .None
  } else {
    action(app, typography, chosen)
  }
  app.input_state.leader_explorer = false
}
fn key_control_dispatch(app: *App, typography: *Typography, key: u32, shift: bool) {
  doc := app.documents.current
  if !app.view.insert && (key == KeyB || key == KeyF || key == KeyD || key == KeyU) {
    page_motion(app, typography, key == KeyF || key == KeyD, key == KeyD || key == KeyU)
    return
  }
  case key {
    KeyW => { panel(app, .Windows) }
    KeyO => {
      if !app.view.insert {
        jump_back(app)
      }
    }
    KeyI => {
      if !app.view.insert {
        jump_forward(app)
      }
    }
    KeyS => {
      if !app.view.insert {
        jump_push(app)
        status_note(app, "Saved the selection to the jump list")
      }
    }
    KeyP => { panel(app, .Commands) }
    KeyF => { run_command(app, typography, .Search) }
    KeyE => { run_command(app, typography, .Explorer) }
    KeyQ => { run_command(app, typography, .QuitAll) }
    KeyZ => {
      if shift {
        buffer.redo(doc)
      } else {
        buffer.undo(doc)
      }
    }
    KeyY => { buffer.redo(doc) }
    KeyA => {
      if !app.view.insert {
        amount := app.input_state.repeat_count
        if amount == 0 {
          amount = 1
        }
        app.input_state.repeat_count = 0
        increment_selections(app, amount, false)
      } else {
        doc.anchor = 0
        doc.cursor = doc.length
      }
    }
    KeyC => { _ = clipboard_copy(app) }
    KeyV => { clipboard_paste(app) }
    KeyEquals, KeyPlus => { run_command(app, typography, .ZoomIn) }
    KeyMinus => { run_command(app, typography, .ZoomOut) }
    Key0 => { run_command(app, typography, .ZoomReset) }
    KeyLeft, KeyRight => {
      buffer.checkpoint(doc)
      word_direction: u8 = 0
      if key == KeyLeft {
        word_direction = 1
      }
      buffer.word(doc, word_direction, false, app.view.extend || shift)
      if !app.view.extend && !shift {
        doc.anchor = doc.cursor
      }
    }
    _ => {}
  }
}
fn key_normal_dispatch(app: *App, typography: *Typography, key: u32, modifiers: u16, shift: bool) {
  doc := app.documents.current
  if app.view.insert {
    edit_key(app, key, modifiers)
    return
  }
  if key == KeyQuote || (key == KeyApostrophe && shift) {
    app.register_state.pending = true
  } else if key == KeyM {
    match_open(app, false)
  } else if key == KeyK && shift {
    filter_kind := Panel.Keep
    if (modifiers & ModAlt) != 0 {
      filter_kind = .Remove
    }
    search_open(app, filter_kind, false)
  } else if key == KeyG && !shift {
    app.input_state.goto_count = app.input_state.repeat_count
    app.input_state.goto_explorer = false
    panel(app, .Goto)
  } else if key == KeySlash || key == KeyQuestion {
    app.input_state.search_backwards = shift || key == KeyQuestion
    run_command(app, typography, .Search)
  } else if key == KeyN && (modifiers & ModAlt) == 0 {
    search_repeat(app, shift, false)
  } else if key == KeyS {
    kind := Panel.Select
    if shift {
      kind = .Split
    }
    search_open(app, kind, false)
  } else if key == KeySpace {
    app.input_state.leader_explorer = false
    panel(app, .Leader)
  } else if (modifiers & ModAlt) == 0 && (key == KeyColon || (key == KeySemicolon && shift) || key == KeyF1) {
    panel(app, .Commands)
  } else if key == KeyZ && (modifiers & ModAlt) == 0 {
    view_open(app, shift)
  } else if (key == KeyRightBracket || key == KeyLeftBracket) && !shift {
    bracket_open(app, key == KeyRightBracket)
  } else if key == KeyAsterisk || (key == Key8 && shift) {
    search_selection(app, (modifiers & ModAlt) == 0)
  } else if key == KeyAmpersand || (key == Key7 && shift) {
    align_selections(app)
  } else if key == KeyTab && modifiers == 0 {
    jump_forward(app)
  } else if (modifiers & ModCtrl) == 0 && (key == KeyBar || (key == KeyBackslash && shift)) {
    if (modifiers & ModAlt) != 0 {
      shell_prompt(app, "pipe-to ")
    } else {
      shell_prompt(app, "pipe ")
    }
  } else if (modifiers & ModCtrl) == 0 && (key == KeyExclaim || (key == Key1 && shift)) {
    if (modifiers & ModAlt) != 0 {
      shell_prompt(app, "append-output ")
    } else {
      shell_prompt(app, "insert-output ")
    }
  } else if key == KeyX && (modifiers & ModAlt) != 0 {
    buffer.checkpoint(doc)
    shrink_to_lines(doc)
  } else {
    edit_key(app, key, modifiers)
  }
}
fn key_dispatch(app: *App, typography: *Typography, key: u32, modifiers: u16) {
  key_trace(app, key, modifiers)
  if macro_active(app) && !app.macro_state.replaying {
    if key == KeyEscape {
      macro_cancel(app)
    } else {
      return
    }
  }
  // Terminal input mode owns the keyboard: every key goes to the program
  // (Ctrl-X for nano, Ctrl-W for shells, q for htop). Only the terminal's
  // own escape, Esc Esc or the configured terminal_escape chord, leaves it.
  if terminal_target(app) != nil && terminal_mode(app).input {
    _ = terminal_input_key(app, key, modifiers)
    return
  }
  if key == KeyEscape && app.lsp.kind == 1 {
    completion_cancel_refresh(app)
  }
  if dialog_key(app, typography, key, modifiers) { return }
  // Macros only replay editing in text buffers, never in terminals.
  if !app.config.vim_keys && app.prompt_state.panel == .None && terminal_target(app) == nil && !app.view.insert && app.input_state.pending == 0 && !app.register_state.pending && key == KeyQ && (modifiers & ModCtrlAlt) == 0 {
    if (modifiers & ModShift) != 0 {
      macro_toggle(app)
    } else {
      macro_play(app, typography)
    }
    return
  }
  macro_key(app, key, modifiers)
  // :s///c owns the keyboard until it finishes.
  if app.vim.ex.confirming && vim_confirm_key(app, typography, key, modifiers) { return }
  if app.prompt_state.panel == .None && snippet_valid(app) {
    if key == KeyTab {
      _ = snippet_jump(app, (modifiers & ModShift) != 0)
      return
    }
    if key == KeyBackspace || key == KeyDelete {
      snippet_doc := app.documents.current
      saved_anchor := snippet_doc.anchor
      saved_cursor := snippet_doc.cursor
      if snippet_doc.anchor == snippet_doc.cursor {
        if key == KeyBackspace {
          snippet_doc.anchor = buffer.previous(snippet_doc, snippet_doc.cursor)
        } else {
          snippet_doc.cursor = buffer.next(snippet_doc, snippet_doc.cursor)
        }
      }
      if snippet_replace(app, "") { return }
      snippet_doc.anchor = saved_anchor
      snippet_doc.cursor = saved_cursor
    }
    if key == KeyEscape || key >= 1073741881 || (modifiers & ModCtrlAlt) != 0 {
      app.lsp.snippet.active = false
      app.documents.current.secondary.count = 0
    }
  }
  if app.prompt_state.panel == .Hover {
    if key == KeyDown {
      app.prompt_state.selected += 1
      return
    }
    if key == KeyUp {
      if app.prompt_state.selected > 0 {
        app.prompt_state.selected -= 1
      }
      return
    }
    app.prompt_state.panel = .None
    if key == KeyEscape { return }
  }
  // Printable keys reach text_input, which refilters or closes the completion.
  if key == KeyBackspace && modifiers == 0 && completion_session(app) && app.documents.current.cursor > app.lsp.results.prefix_start {
    buffer.erase_all(app.documents.current, true)
    app.lsp.completion_typed = true
    completion_refilter(app)
    return
  }
  printable := key >= KeySpace && key < KeyDelete && (modifiers & ModCtrlAlt) == 0
  if completion_visible(app) && !printable && key != KeyTab && key != KeyEscape && key != KeyReturn && key != KeyDown && key != KeyUp {
    app.prompt_state.panel = .None
    lsp_results_release(app)
  }
  if key_early_panel(app, key) { return }
  if app.prompt_state.panel == .None && terminal_target(app) == nil && (modifiers & ModCtrl) != 0 && key == KeySpace {
    lsp_request(app, 1, "")
    return
  }
  if key != KeyEscape {
    terminal_escape_flush(app)
  }
  if key_modal_panel(app, key) { return }
  app.binding_state.swallow = 0
  if configured_key(app, typography, key, modifiers) { return }
  if key == KeyX && (modifiers & ModCtrl) != 0 && app.prompt_state.panel == .Buffers {
    picker_close_selected(app)
    return
  }
  // In the Vim profile Ctrl-x decrements numbers; :q closes instead.
  if key == KeyX && (modifiers & ModCtrl) != 0 && ((app.prompt_state.panel == .None && !(app.config.vim_keys && terminal_target(app) == nil)) || app.prompt_state.panel == .Terminal) {
    if app.prompt_state.panel == .Terminal {
      activate(app, app.terminal_state.slot)
    }
    app.input_state.pending = 0
    app.input_state.repeat_count = 0
    request_buffer_close(app)
    return
  }
  if terminal_input_key(app, key, modifiers) { return }
  shift := (modifiers & ModShift) != 0
  control := (modifiers & ModCtrl) != 0
  doc := app.documents.current
  if (app.input_state.pending != 0 || app.register_state.pending) && key != KeyEscape { return }
  if app.prompt_state.panel == .Directory {
    explorer_key(app, typography, key, modifiers)
    return
  }
  if app.prompt_state.panel == .Tree {
    tree_key(app, key, modifiers)
    return
  }
  if app.prompt_state.panel == .DirectoryApply {
    if key == KeyEscape {
      app.prompt_state.panel = .Directory
    } else if key == KeyReturn {
      explorer_apply(app)
    } else if key == KeyDown && app.explorer.preview_row + 1 < app.explorer.edit_count {
      app.explorer.preview_row += 1
    } else if key == KeyUp && app.explorer.preview_row > 0 {
      app.explorer.preview_row -= 1
    }
    return
  }
  if app.prompt_state.panel == .DirectoryDiscard {
    if key == KeyEscape {
      app.prompt_state.panel = .Directory
      app.explorer.quit_after_discard = false
    } else if key == KeyD {
      if app.explorer.document != nil {
        buffer.mark_saved(app.explorer.document)
      }
      app.prompt_state.panel = .Directory
      directory_refresh(app)
      if app.explorer.quit_after_discard {
        app.explorer.quit_after_discard = false
        request_quit(app)
      }
    }
    return
  }
  if app.prompt_state.panel == .Open && app.resource_state.kind == .Languages && language_manager_key(app, key, modifiers) {
    return
  }
  if key == KeyEscape {
    key_panel_escape(app)
    return
  }
  case app.prompt_state.panel {
    .Quit => {
      if key == KeyC {
        cancel_buffer_close(app)
      } else if key == KeyS {
        if app.picker_state.closing {
          activate(app, app.picker_state.close_target)
        }
        app.documents.quit_after_save = true
        run_command(app, typography, .Write)
      } else if key == KeyD {
        if app.picker_state.closing {
          close_slot(app, app.picker_state.close_target)
          finish_picker_close(app)
          return
        }
        files.discard_recovery(app.documents.file)
        if app.documents.closing_one {
          close_clean(app)
        } else {
          _ = buffer.load(doc, buffer.saved_text(doc)[..doc.saved_length])
          request_quit(app)
        }
      }
      return
    }
    .Match => {
      match_key(app, key)
      return
    }
    .Windows => {
      window_key(app, key)
      return
    }
    .Goto => {
      goto_key(app, typography, key)
      return
    }
    .View => {
      view_key(app, typography, key)
      return
    }
    .Bracket => {
      bracket_key(app, key, modifiers)
      return
    }
    .Leader => {
      key_leader_dispatch(app, typography, key, shift)
      return
    }
    .Message => {
      if app.prompt_state.selected == DiscardConfirmId && key == KeyD {
        files.discard_recovery(app.documents.file)
        _ = buffer.load(doc, buffer.saved_text(doc)[..doc.saved_length])
        app.prompt_state.panel = .None
        app.view.extend = false
      } else if app.prompt_state.selected != DiscardConfirmId && key == KeyReturn {
        if explorer_dirty(app) {
          app.prompt_state.panel = .Directory
        } else {
          app.prompt_state.panel = .None
        }
      }
      return
    }
    .None => {}
    _ => {
      prompt_key(app, typography, key, modifiers)
      return
    }
  }
  // Normal-mode document keys go to the active keymap profile first.
  if app.config.vim_keys && vim_key(app, typography, key, modifiers) { return }
  if app.view.insert && !app.config.vim_keys && (control || (modifiers & ModAlt) != 0) && insert_edit_key(app, key, modifiers) {
    return
  }
  if control {
    key_control_dispatch(app, typography, key, shift)
    return
  }
  key_normal_dispatch(app, typography, key, modifiers, shift)
}

fn registers_release(app: *App) {
  for index in 0..26 {
    register := &app.register_state.named[index]
    if register.owned {
      arena_owner.release(register.arena)
      register.arena = nil
      register.owned = false
    }
  }
  clipboard_release(app)
}
