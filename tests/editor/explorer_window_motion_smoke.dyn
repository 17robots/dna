struct ExplorerWindowProbe {time:fn(u64), resize:fn(i32, i32), pixels:fn()[]const u8}
fn explorer_window_pixels(probe:ExplorerWindowProbe) u64 {
  total:u64=0
  for byte in probe.pixels() {
    total+=#cast(u64, byte)
  }
  return total
}
fn explorer_window_frame(app:*App, typography:*Typography, renderer, window:rawptr, probe:ExplorerWindowProbe, now:u64, cause:u32) {
  probe.time(now)
  app.render_pending=cause
  draw(renderer, window, app, typography)
}
fn explorer_window_motion_smoke(app:*App, typography:*Typography, renderer, window:rawptr, probe:ExplorerWindowProbe) {
  app.config.popup_transitions=true
  app.config.popup_animation_ms=40.0
  app.view.reduced_motion=false
  app.config.smooth_scroll=false
  app.config.smooth_cursor=false
  probe.resize(960, 640)
  explorer_window_frame(app, typography, renderer, window, probe, 1000, 0)
  explorer_buffer_open(app)
  explorer_window_frame(app, typography, renderer, window, probe, 1010, RenderKey)
  state:=&app.view.animation.surface_geometry[SurfaceExplorer]
  target:=state.target
  first:=state.current[2]-state.current[0]
  if first<=0.0 || first>=target[2]-target[0] || state.current[0]!=target[0] || state.current[1]!=target[1] || state.current[3]!=target[3] {
    #panic("explorer must expand horizontally from its left edge")
  }
  explorer_window_frame(app, typography, renderer, window, probe, 1026, RenderAnimation)
  if state.current[2]-state.current[0]<=first {
    #panic("explorer entrance must continue")
  }
  explorer_window_frame(app, typography, renderer, window, probe, 1030, RenderKey)
  if state.active {
    #panic("explorer input must finish entrance immediately")
  }
  app.prompt_state.panel=Panel.None
  explorer_window_frame(app, typography, renderer, window, probe, 1040, RenderKey)
  close_width:=state.current[2]-state.current[0]
  closing_pixels:=explorer_window_pixels(probe)
  if !app.view.animation.explorer_closing || close_width<=0.0 || close_width>=target[2]-target[0] {
    #panic("closed explorer must retract its cached layer")
  }
  if app.prompt_state.panel!=Panel.None {
    #panic("explorer exit must release input immediately")
  }
  explorer_window_frame(app, typography, renderer, window, probe, 1056, RenderAnimation)
  if state.current[2]-state.current[0]>=close_width {
    #panic("explorer exit must continue shrinking")
  }
  explorer_window_frame(app, typography, renderer, window, probe, 1400, RenderAnimation)
  if explorer_window_pixels(probe)==closing_pixels {
    #panic("explorer exit must paint its retained layer until closed")
  }
  if app.view.animation.explorer_closing || state.current[2]!=state.current[0] {
    #panic("explorer exit must settle exactly")
  }
  explorer_buffer_open(app)
  explorer_window_frame(app, typography, renderer, window, probe, 1500, RenderKey)
  explorer_window_frame(app, typography, renderer, window, probe, 1800, RenderAnimation)
  app.prompt_state.panel=Panel.None
  explorer_window_frame(app, typography, renderer, window, probe, 1810, RenderKey)
  app.view.insert=true
  before:=app.documents.current.length
  text_input(app, "z")
  explorer_window_frame(app, typography, renderer, window, probe, 1811, RenderText)
  if app.view.animation.explorer_closing || app.documents.current.length!=before+1 {
    #panic("typing must finish exit and edit immediately")
  }
  app.view.reduced_motion=true
  explorer_buffer_open(app)
  explorer_window_frame(app, typography, renderer, window, probe, 1900, RenderKey)
  if state.active {
    #panic("reduced motion explorer entrance must be immediate")
  }
  app.prompt_state.panel=Panel.None
  explorer_window_frame(app, typography, renderer, window, probe, 1910, RenderKey)
  if app.view.animation.explorer_closing {
    #panic("reduced motion explorer exit must be immediate")
  }
  app.running=false
}
