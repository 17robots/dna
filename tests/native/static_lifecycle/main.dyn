// Link the native archive through its public ABI. Shared-library constructors
// must not be required for callback tables or descriptor sentinels to work.
#link("c")
#link("dna_native")
extern fn native_open "dna_terminal_open"(directory: *const u8, shell: *const u8, command: *const u8) rawptr
extern fn native_poll "dna_terminal_poll"(terminal: rawptr) i32
extern fn native_alive "dna_terminal_alive"(terminal: rawptr) i32
extern fn native_review "dna_terminal_review"(terminal: rawptr, output: *u8, capacity: usize) usize
extern fn native_close "dna_terminal_close"(terminal: rawptr)
extern fn native_snapshot "dna_memory_snapshot"(category: u32, output: *u64)
extern fn native_notify_start "dna_notify_start"() i32
extern fn native_notify_stop "dna_notify_stop"()
extern fn native_sleep "usleep"(microseconds: u32) i32
extern fn native_find "memmem"(bytes: *const u8, length: usize, needle: *const u8, size: usize) rawptr
extern fn native_write "write"(fd: i32, bytes: *const u8, length: usize) isize
extern fn native_exit "_Exit"(status: i32)
fn check(ok: bool, message: []const u8) {
  if !ok {
    _ = native_write(2, &message[0], #len(message))
    native_exit(1)
  }
}
fn contains(bytes: []const u8, needle: []const u8) bool {
  return native_find(&bytes[0], #len(bytes), &needle[0], #len(needle)) != nil
}
fn main() {
  before: [7]u64 = []
  native_snapshot(2, &before[0])
  directory: []const u8 = "/tmp\0"
  shell: []const u8 = "/bin/sh\0"
  command: []const u8 = "i=0; while [ $i -lt 150 ]; do printf 'row-%03d \\303\\251\\344\\270\\255\\n' $i; i=$((i+1)); done\0"
  for cycle in 0..2 {
    check(native_notify_start() != 0, "FAIL static native: notification startup\n")
    terminal := native_open(&directory[0], &shell[0], &command[0])
    check(terminal != nil, "FAIL static native: terminal startup\n")
    for attempt in 0..300 {
      _ = native_poll(terminal)
      if native_alive(terminal) == 0 { break }
      _ = native_sleep(10000)
    }
    _ = native_poll(terminal)
    check(native_alive(terminal) == 0, "FAIL static native: child exit\n")
    output: [262144]u8 = []
    length := native_review(terminal, &output[0], 262144)
    check(length > 0 && length < 262144, "FAIL static native: review length\n")
    check(contains(output[..length], "row-000"), "FAIL static native: scrollback callback omitted oldest row\n")
    check(contains(output[..length], "row-149"), "FAIL static native: newest row missing\n")
    check(contains(output[..length], "é中"), "FAIL static native: Unicode review\n")
    native_close(terminal)
    native_notify_stop()
  }
  after: [7]u64 = []
  native_snapshot(2, &after[0])
  check(after[0] > before[0], "FAIL static native: tracking disabled\n")
  check(after[2] == before[2] && after[6] == before[6], "FAIL static native: terminal allocations retained\n")
  check(after[0] - before[0] == after[1] - before[1], "FAIL static native: allocation/free imbalance\n")
  message: []const u8 = "PASS static native archive: callbacks, scrollback, Unicode, notification restart, balanced ownership\n"
  _ = native_write(1, &message[0], #len(message))
}
