// Linux/glibc x86_64 disk adapter. Workers publish snapshots under an opaque
// DNA mutex
// UI owns registrations and results. Parent watches survive rename.
struct DiskWatched {
  path: [4096]u8, identity: u64, generation: u64, baseline: u64,
  baseline_length: usize, stamp: InstallStat, stamped: bool, pending: bool,
  // Set by dna_disk_watch_stamped: the baseline is not known yet, but the file
  // held the saved text while it carried this stamp (inode, size, modified
  // and changed seconds and nanoseconds). The first check adopts its hash.
  trusted: bool, trust: [6]u64,
  status: i32, bytes: *u8, length: usize,
  ready_next: usize, queued: bool,
}
struct DiskWorker {
  thread: rawptr, lock: rawptr, wake: rawptr, stop: bool,
  changes: i32, control: [2]i32, watches: []i32, files: []DiskWatched,
  ready_first, ready_last: usize,
}
struct DiskPathWatch { fd, parent:i32, path:[4096]u8 }
struct DiskDirectoryWatch { fd: i32, count: usize, watches: [256]i32 }
struct DiskEvent { descriptor: i32, mask: u32, cookie: u32, length: u32 }


// Queue links are one-based stable slot indices; vector growth preserves them.
fn disk_ready_push(d: *DiskWorker, index: usize) {
  target := &d.files[index]
  if target.queued {
    return
  }
  target.queued = true
  target.ready_next = 0
  if d.ready_last == 0 {
    d.ready_first = index + 1
  }
  else {
    d.files[d.ready_last - 1].ready_next = index + 1
  }
  d.ready_last = index + 1
}
struct DiskReady { index: usize, identity: u64 }
pub fn dna_disk_next_ready(d: *DiskWorker, output: *DiskReady) i32 {
  if d == nil || output == nil {
    return 0
  }
  rec_lock(d.lock)
  for d.ready_first != 0 {
    index := d.ready_first - 1
    target := &d.files[index]
    d.ready_first = target.ready_next
    if d.ready_first == 0 {
      d.ready_last = 0
    }
    target.ready_next = 0
    target.queued = false
    if target.pending && target.identity != 0 {
      output.index = index
      output.identity = target.identity
      rec_unlock(d.lock)
      return 1
    }
  }
  rec_unlock(d.lock)
  return 0
}

extern fn disk_lseek "lseek"(fd: i32, offset: i64, whence: i32) i64
fn disk_hash(bytes: *const u8, length: usize) u64 {
  value: u64 = 1469598103934665603
  for i in 0..length {
    // Preserve the historical seed and modulo-2^64 FNV result exactly.
    value = #wrap((value ^ #cast(u64, bytes[..length][i])) * 1099511628211)
  }
  return value
}
struct DiskStreamHash { hash: u64, ok: bool }
// FNV-1a over a file's first size bytes, read through a fixed buffer.
fn disk_stream_hash(fd: i32, size: usize) DiskStreamHash {
  chunk: [65536]u8 = []
  value: u64 = 1469598103934665603
  done: usize = 0
  for done < size {
    want := size - done
    if want > #len(chunk) {
      want = #len(chunk)
    }
    count := proc_read_raw(fd, &chunk[0], want)
    if count < 0 && rec_errno().* == 4 {
      continue
    }
    if count <= 0 {
      return DiskStreamHash{}
    }
    for i in 0..#cast(usize, count) {
      value = #wrap((value ^ #cast(u64, chunk[i])) * 1099511628211)
    }
    done += #cast(usize, count)
  }
  return DiskStreamHash{hash: value, ok: true}
}
fn disk_same(a: *const InstallStat, b: *const InstallStat) bool {
  return a.device == b.device && a.inode == b.inode && a.size == b.size && a.mode == b.mode && a.modify_seconds == b.modify_seconds && a.modify_nanos == b.modify_nanos && a.change_seconds == b.change_seconds && a.change_nanos == b.change_nanos
}
fn disk_parent(path: *const u8, output: *u8) {
  length := string_length(path)
  _ = copy(output, path, length + 1)
  slash: isize = -1
  for i in 0..length {
    if output[..4096][i] == 47 {
      slash = #cast(isize, i)
    }
  }
  if slash < 0 {
    output[..4096][0] = 46
    output[..4096][1] = 0
  }
  else if slash == 0 {
    output[..4096][1] = 0
  }
  else {
    output[..4096][#cast(usize, slash)] = 0
  }
}
fn disk_wake(d: *DiskWorker) {
  byte: u8 = 1
  if d.control[1] >= 0 {
    _ = rec_write(d.control[1], &byte, 1)
  }
  rec_signal(d.wake)
}
fn disk_directories(d: *DiskWorker) bool {
  complete := d.changes >= 0 && d.control[0] >= 0
  count := #len(d.files)
  if count == 0 {
    return complete
  }
  previous := #cast(*i32, search_alloc(count * #sizeof(i32), 3))
  if previous == nil {
    return false
  }
  _ = copy(#cast(*u8, previous), #cast(*u8, &d.watches[0]), count * #sizeof(i32))
  for i in 0..count {
    d.watches[i] = -1
  }
  disk_targets_begin(d.changes)
  for i in 0..count {
    if d.files[i].identity == 0 {
      continue
    }
    parent: [4096]u8 = []
    disk_parent(&d.files[i].path[0], &parent[0])
    wd: i32 = -1
    if d.changes >= 0 {
      wd = disk_add(d.changes, &parent[0], 16781262)
    }
    d.watches[i] = wd
    if wd < 0 || !disk_target_watch(d.changes, &d.files[i].path[0], wd) {
      complete = false
    }
  }
  disk_targets_end(d.changes)
  for i in 0..count {
    used := false
    for j in 0..count {
      if d.watches[j] == previous[..count][i] {
        used = true
      }
    }
    for j in 0..i {
      if previous[..count][j] == previous[..count][i] {
        used = true
      }
    }
    if previous[..count][i] >= 0 && !used {
      _ = disk_remove(d.changes, previous[..count][i])
    }
  }
  search_free(#cast(rawptr, previous))
  return complete
}
fn disk_wait(d: *DiskWorker, complete: bool) {
  if d.control[0] < 0 {
    rec_lock(d.lock)
    if !d.stop {
      // The predicate remains protected by the same mutex on every return.
      _ = sync.condition_wait_timeout(#cast(*NativeCondition, d.wake), #cast(*NativeMutex, d.lock), 250000000)
    }
    rec_unlock(d.lock)
    return
  }
  fds: [2]PollDescriptor = [PollDescriptor{fd: d.control[0], events: 1}, PollDescriptor{fd: d.changes, events: 1}]
  timeout: i32 = 250
  if complete {
    timeout = 30000
  }
  for {
    if proc_poll(&fds[0], 2, timeout) >= 0 || rec_errno().* != 4 {
      break
    }
  }
  events: [8192]u8 = []
  for i in 0..2 {
    if (fds[i].returned & 1) != 0 {
      for proc_read_raw(fds[i].fd, &events[0], 8192) > 0 {}
    }
  }
}
fn disk_worker(context: rawptr) i32 {
  d := #cast(*DiskWorker, context)
  for {
    rec_lock(d.lock)
    complete := disk_directories(d)
    slot_count := #len(d.files)
    rec_unlock(d.lock)
    for i in 0..slot_count {
      rec_lock(d.lock)
      if d.stop {
        rec_unlock(d.lock)
        return 0
      }
      snapshot := d.files[i]
      rec_unlock(d.lock)
      if snapshot.identity == 0 {
        continue
      }
      stamp := InstallStat{}
      status: i32 = 0
      bytes: *u8 = nil
      length: usize = 0
      unchanged_hash := false
      if install_lstat(&snapshot.path[0], &stamp) != 0 {
        status = 3
        if rec_errno().* == 2 {
          status = 2
        }
      } else if (stamp.mode & 61440) != 32768 {
        status = 3
      }
      else if stamp.size < 0 || stamp.size > 1099511627776 {
        status = 4
      }
      if snapshot.stamped && disk_same(&snapshot.stamp, &stamp) && (snapshot.status == status || (status == 0 && snapshot.status == 5)) {
        continue
      }
      if status == 0 {
        fd := rec_open(&snapshot.path[0], 657408, 0)
        opened := InstallStat{}
        if fd < 0 || install_fstat(fd, &opened) != 0 || (opened.mode & 61440) != 32768 || !disk_same(&stamp, &opened) {
          status = 3
        }
        else {
          // Hash in a small buffer first; most checks find the file unchanged
          // and never hold its whole contents in memory.
          streamed := disk_stream_hash(fd, #cast(usize, stamp.size))
          if !streamed.ok {
            status = 3
          } else if snapshot.trusted && disk_trusted(&snapshot, &stamp) {
            length = #cast(usize, stamp.size)
            unchanged_hash = true
            snapshot.baseline = streamed.hash
          } else if streamed.hash == snapshot.baseline && #cast(usize, stamp.size) == snapshot.baseline_length {
            length = #cast(usize, stamp.size)
            unchanged_hash = true
          } else if disk_lseek(fd, 0, 0) != 0 {
            status = 3
          } else {
            bytes = search_alloc(#cast(usize, stamp.size) + 1, 3)
            if bytes == nil {
              status = 3
            }
          }
          for status == 0 && !unchanged_hash && length < #cast(usize, stamp.size) {
            count := proc_read_raw(fd, &bytes[..#cast(usize, stamp.size) + 1][length], #cast(usize, stamp.size) - length)
            if count < 0 && rec_errno().* == 4 {
              continue
            }
            if count <= 0 {
              status = 3
              break
            }
            length += #cast(usize, count)
          }
          after := InstallStat{}
          if status == 0 && (install_fstat(fd, &after) != 0 || !disk_same(&stamp, &after)) {
            status = 3
          }
        }
        if fd >= 0 {
          _ = rec_close(fd)
        }
      }
      // A trusted watch whose file no longer carries its stamp has no
      // baseline to compare; report the contents as changed.
      changed := status != 0 || (!unchanged_hash && (snapshot.trusted || length != snapshot.baseline_length || disk_hash(bytes, length) != snapshot.baseline))
      rec_lock(d.lock)
      target := &d.files[i]
      if target.generation == snapshot.generation {
        target.stamp = stamp
        target.stamped = true
        target.status = status
        if target.trusted && unchanged_hash {
          target.baseline = snapshot.baseline
        }
        target.trusted = false
        search_free(#cast(rawptr, target.bytes))
        target.bytes = nil
        target.length = 0
        target.pending = true
        disk_ready_push(d, i)
        if changed {
          target.bytes = bytes
          bytes = nil
          if status == 0 {
            target.length = length
          }
        } else {
          target.status = 5
        }
      }
      rec_unlock(d.lock)
      search_free(#cast(rawptr, bytes))
      rec_notify()
    }
    disk_wait(d, complete)
    rec_lock(d.lock)
    stop := d.stop
    rec_unlock(d.lock)
    if stop {
      return 0
    }
  }
  return 0
}
fn disk_release(d: *DiskWorker) {
  if #len(d.files) > 0 {
    search_free(#cast(rawptr, &d.files[0]))
  }
  if #len(d.watches) > 0 {
    search_free(#cast(rawptr, &d.watches[0]))
  }
  if d.wake != nil {
    rec_condition_free(d.wake)
  }
  if d.lock != nil {
    rec_mutex_free(d.lock)
  }
  if d.changes >= 0 {
    disk_changes_close(d.changes)
  }
  if d.control[0] >= 0 {
    _ = rec_close(d.control[0])
    _ = rec_close(d.control[1])
  }
  search_free(#cast(rawptr, d))
}
pub fn dna_disk_open() *DiskWorker {
  d := #cast(*DiskWorker, search_calloc(1, #sizeof(DiskWorker), 3))
  if d == nil {
    return nil
  }
  d.changes = disk_inotify(526336)
  d.control[0] = -1
  d.control[1] = -1
  if proc_pipe(&d.control[0], 526336) != 0 {
    d.control[0] = -1
    d.control[1] = -1
  }
  d.lock = rec_mutex()
  d.wake = rec_condition()
  if d.lock == nil || d.wake == nil {
    disk_release(d)
    return nil
  }
  d.thread = rec_thread(disk_worker, #cast(rawptr, d))
  if d.thread == nil {
    disk_release(d)
    return nil
  }
  return d
}
// Call only under d.lock. The worker retains values, never element pointers,
// across unlock; replace both containers together or preserve the old owners.
fn disk_reserve(d: *DiskWorker, index: usize) bool {
  if index < #len(d.files) {
    return true
  }
  maximum := #cast(usize, -1) / #sizeof(DiskWatched)
  if index >= maximum {
    return false
  }
  capacity := #len(d.files)
  if capacity == 0 {
    capacity = 8
  }
  for capacity <= index {
    if capacity > maximum / 2 {
      capacity = index + 1
      break
    }
    capacity *= 2
  }
  files := #cast(*DiskWatched, search_calloc(capacity, #sizeof(DiskWatched), 3))
  if files == nil {
    return false
  }
  watches := #cast(*i32, search_alloc(capacity * #sizeof(i32), 3))
  if watches == nil {
    search_free(#cast(rawptr, files))
    return false
  }
  for i in 0..capacity {
    watches[..capacity][i] = -1
  }
  if #len(d.files) > 0 {
    _ = copy(#cast(*u8, files), #cast(*u8, &d.files[0]), #len(d.files) * #sizeof(DiskWatched))
    _ = copy(#cast(*u8, watches), #cast(*u8, &d.watches[0]), #len(d.watches) * #sizeof(i32))
    search_free(#cast(rawptr, &d.files[0]))
    search_free(#cast(rawptr, &d.watches[0]))
  }
  d.files = files[..capacity]
  d.watches = watches[..capacity]
  return true
}
pub fn dna_disk_watch_checked(d: *DiskWorker, index: usize, identity: u64, path: *const u8, saved: *const u8, length: usize) i32 {
  if d == nil {
    return 0
  }
  if identity != 0 && (path == nil || string_length(path) >= 4096 || (saved == nil && length != 0)) {
    return 0
  }
  baseline: u64 = 0
  if identity != 0 {
    baseline = disk_hash(saved, length)
  }
  return disk_watch_baseline(d, index, identity, path, baseline, length)
}
// Same as dna_disk_watch_checked with the saved text's FNV-1a hash computed
// by the caller, which can hash its storage chunk by chunk.
pub fn dna_disk_watch_hashed(d: *DiskWorker, index: usize, identity: u64, path: *const u8, baseline: u64, length: usize) i32 {
  if d == nil {
    return 0
  }
  if identity != 0 && (path == nil || string_length(path) >= 4096) {
    return 0
  }
  return disk_watch_baseline(d, index, identity, path, baseline, length)
}
// Watch a file whose saved text is length bytes, without hashing it here:
// stamp (six values, as filesystem.Stamp: inode, size, modified seconds and
// nanoseconds, changed seconds and nanoseconds) is the file's state when it
// held that text. The watcher thread hashes the file on its first check while
// the stamp still matches; otherwise it reports the file changed.
pub fn dna_disk_watch_stamped(d: *DiskWorker, index: usize, identity: u64, path: *const u8, stamp: *const u64, length: usize) i32 {
  if d == nil || identity == 0 || stamp == nil || path == nil || string_length(path) >= 4096 {
    return 0
  }
  if disk_watch_baseline(d, index, identity, path, 0, length) == 0 {
    return 0
  }
  rec_lock(d.lock)
  w := &d.files[index]
  w.trusted = true
  for i in 0..6 {
    w.trust[i] = stamp[..6][i]
  }
  rec_unlock(d.lock)
  return 1
}
fn disk_trusted(w: *const DiskWatched, stamp: *const InstallStat) bool {
  return w.trust[0] == stamp.inode && w.trust[1] == #cast(u64, stamp.size) && w.trust[1] == #cast(u64, w.baseline_length) && w.trust[2] == #cast(u64, stamp.modify_seconds) && w.trust[3] == #cast(u64, stamp.modify_nanos) && w.trust[4] == #cast(u64, stamp.change_seconds) && w.trust[5] == #cast(u64, stamp.change_nanos)
}
fn disk_watch_baseline(d: *DiskWorker, index: usize, identity: u64, path: *const u8, baseline: u64, length: usize) i32 {
  rec_lock(d.lock)
  if !d.stop && identity == 0 && index >= #len(d.files) {
    rec_unlock(d.lock)
    return 1
  }
  if d.stop || !disk_reserve(d, index) {
    rec_unlock(d.lock)
    return 0
  }
  w := &d.files[index]
  search_free(#cast(rawptr, w.bytes))
  next_generation := w.generation + 1
  ready_next := w.ready_next
  queued := w.queued
  w.* = DiskWatched{}
  w.ready_next = ready_next
  w.queued = queued
  w.generation = next_generation
  w.identity = identity
  if identity != 0 {
    _ = copy(&w.path[0], path, string_length(path) + 1)
  }
  w.baseline = baseline
  w.baseline_length = length
  disk_wake(d)
  rec_unlock(d.lock)
  return 1
}
pub fn dna_disk_watch(d: *DiskWorker, index: u32, identity: u64, path: *const u8, saved: *const u8, length: usize) {
  _ = dna_disk_watch_checked(d, #cast(usize, index), identity, path, saved, length)
}
pub fn dna_disk_pending_at(d: *DiskWorker, index: usize, identity: u64) isize {
  if d == nil {
    return 0
  }
  rec_lock(d.lock)
  if index >= #len(d.files) {
    rec_unlock(d.lock)
    return 0
  }
  w := &d.files[index]
  result: isize = 0
  if w.identity == identity && w.pending {
    result = #cast(isize, w.length) + 1
    if w.status != 0 {
      result = -#cast(isize, w.status)
    }
  }
  rec_unlock(d.lock)
  return result
}
pub fn dna_disk_pending(d: *DiskWorker, index: u32, identity: u64) isize {
  return dna_disk_pending_at(d, #cast(usize, index), identity)
}
pub fn dna_disk_take_at(d: *DiskWorker, index: usize, identity: u64, output: *u8, capacity: usize) i32 {
  if d == nil {
    return 0
  }
  rec_lock(d.lock)
  if index >= #len(d.files) {
    rec_unlock(d.lock)
    return 0
  }
  w := &d.files[index]
  result: i32 = 0
  if w.identity == identity && w.pending {
    result = w.status
    if w.status == 0 {
      result = 1
      if capacity > w.length {
        _ = copy(output, w.bytes, w.length)
        output[..capacity][w.length] = 0
      }
      else {
        result = 0
      }
    }
    if result != 0 {
      w.pending = false
      search_free(#cast(rawptr, w.bytes))
      w.bytes = nil
      w.length = 0
    }
  }
  rec_unlock(d.lock)
  return result
}
pub fn dna_disk_take(d: *DiskWorker, index: u32, identity: u64, output: *u8, capacity: usize) i32 {
  return dna_disk_take_at(d, #cast(usize, index), identity, output, capacity)
}
pub fn dna_disk_close(d: *DiskWorker) {
  if d == nil {
    return
  }
  rec_lock(d.lock)
  d.stop = true
  disk_wake(d)
  rec_unlock(d.lock)
  rec_join(d.thread, nil)
  for i in 0..#len(d.files) {
    search_free(#cast(rawptr, d.files[i].bytes))
  }
  disk_release(d)
}
pub fn dna_file_stamp(path: *const u8, output: *u64) i32 {
  info := InstallStat{}
  if disk_stat(path, &info) != 0 || (info.mode & 61440) != 32768 {
    return 0
  }
  values := output[..6]
  values[0] = info.device
  values[1] = info.inode
  values[2] = #cast(u64, info.size)
  values[3] = #cast(u64, info.modify_seconds)
  values[4] = #cast(u64, info.modify_nanos)
  values[5] = #cast(u64, info.change_nanos)
  return 1
}
pub fn dna_path_watch_open(path: *const u8) *DiskPathWatch {
  if path == nil || string_length(path) >= 4096 {
    return nil
  }
  parent: [4096]u8 = []
  disk_parent(path, &parent[0])
  fd := disk_inotify(526336)
  if fd < 0 {
    return nil
  }
  parent_watch := disk_add(fd, &parent[0], 16781262)
  if parent_watch < 0 {
    disk_changes_close(fd)
    return nil
  }
  watch := #cast(*DiskPathWatch, search_alloc(#sizeof(DiskPathWatch), 3))
  if watch == nil {
    disk_changes_close(fd)
    return nil
  }
  watch.fd = fd
  watch.parent = parent_watch
  _=copy(&watch.path[0], path, string_length(path)+1)
  _=disk_target_watch(fd, path, parent_watch)
  proc_watch(fd, 0)
  return watch
}
pub fn dna_path_watch_poll(watch: *DiskPathWatch) i32 {
  if watch == nil {
    return -1
  }
  storage: [1024]u64 = []
  bytes := #cast(*u8, &storage[0])
  changed: i32 = 0
  invalid := false
  for {
    count := proc_read_raw(watch.fd, bytes, 8192)
    if count < 0 && rec_errno().* == 4 {
      continue
    }
    if count < 0 && !rec_retry() {
      invalid = true
    }
    if count <= 0 {
      break
    }
    changed = 1
    offset: usize = 0
    for offset < #cast(usize, count) {
      event := #cast(*DiskEvent, &bytes[..8192][offset])
      if (event.mask & 44032) != 0 {
        invalid = true
      }
      offset += #sizeof(DiskEvent) + #cast(usize, event.length)
    }
  }
  if !disk_target_watch(watch.fd, &watch.path[0], watch.parent) {
    invalid=true
  }
  proc_watch(watch.fd, 0)
  if invalid {
    return -1
  }
  return changed
}
pub fn dna_path_watch_close(watch: *DiskPathWatch) {
  if watch == nil {
    return
  }
  proc_unwatch(watch.fd)
  disk_changes_close(watch.fd)
  search_free(#cast(rawptr, watch))
}
pub fn dna_directory_watch_open() *DiskDirectoryWatch {
  fd := disk_inotify(526336)
  if fd < 0 {
    return nil
  }
  watch := #cast(*DiskDirectoryWatch, search_calloc(1, #sizeof(DiskDirectoryWatch), 3))
  if watch == nil {
    disk_changes_close(fd)
    return nil
  }
  watch.fd = fd
  proc_watch(fd, 0)
  return watch
}
pub fn dna_directory_watch_add(watch: *DiskDirectoryWatch, path: *const u8) i32 {
  if watch == nil || watch.count == 256 {
    return 0
  }
  wd := disk_add(watch.fd, path, 83890112)
  if wd < 0 {
    return 0
  }
  watch.watches[watch.count] = wd
  watch.count += 1
  return 1
}
pub fn dna_directory_watch_clear(watch: *DiskDirectoryWatch) {
  if watch == nil {
    return
  }
  for i in 0..watch.count {
    _ = disk_remove(watch.fd, watch.watches[i])
  }
  watch.count = 0
}
pub fn dna_directory_watch_poll(watch: *DiskDirectoryWatch) i32 {
  if watch == nil {
    return 0
  }
  storage: [1024]u64 = []
  bytes := #cast(*u8, &storage[0])
  changed: i32 = 0
  for {
    count := proc_read_raw(watch.fd, bytes, 8192)
    if count < 0 && rec_errno().* == 4 {
      continue
    }
    if count <= 0 {
      break
    }
    offset: usize = 0
    for offset < #cast(usize, count) {
      event := #cast(*DiskEvent, &bytes[..8192][offset])
      if (event.mask & 32768) == 0 {
        changed = 1
      }
      offset += #sizeof(DiskEvent) + #cast(usize, event.length)
    }
  }
  proc_watch(watch.fd, 0)
  return changed
}
pub fn dna_directory_watch_close(watch: *DiskDirectoryWatch) {
  if watch == nil {
    return
  }
  proc_unwatch(watch.fd)
  disk_changes_close(watch.fd)
  search_free(#cast(rawptr, watch))
}
