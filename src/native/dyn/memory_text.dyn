#link("SDL3_ttf")
extern fn memory_text_create "TTF_CreateText"(engine: rawptr, font: rawptr, text: *const u8, length: usize) rawptr
extern fn memory_text_destroy "TTF_DestroyText"(text: rawptr)
pub fn dna_text_create(engine: rawptr, font: rawptr, text: *const u8, length: usize) rawptr {
  result := memory_text_create(engine, font, text, length)
  if result != nil && memory_active() {
    memory_record(5, 0, 0, false)
  }
  return result
}
pub fn dna_text_destroy(text: rawptr) {
  if text != nil && memory_active() {
    memory_record(5, 0, 0, true)
  }
  memory_text_destroy(text)
}
