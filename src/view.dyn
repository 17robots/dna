// Animation frames wait for vertical blank (even pacing, no tearing); frames
// answering input present immediately, so typing never waits for a refresh.
fn present_pacing(app: *App, renderer: rawptr) {
  answering := answering_input(app)
  wanted := app.view.vsync_supported && app.view.animation.active && !answering
  if wanted != app.view.vsync {
    interval: i32 = 0
    if wanted {
      interval = 1
    }
    if platform.render_vsync(renderer, interval) {
      app.view.vsync = wanted
    }
  }
}
fn update_window_title(window: rawptr, app: *App, doc: *buffer.Document) {
  dirty := buffer.dirty_cached(doc)
  name := files.name(app.documents.file)
  state := &app.title_state
  if state.ready && state.dirty == dirty && state.insert == app.view.insert && state.extend == app.view.extend && buffer.equal(name, state.text[state.name_start..state.name_end]) {
    return
  }
  used: usize = 0
  if dirty {
    add_text(state.text[..8191], &used, "[+] ")
  }
  if app.view.insert {
    add_text(state.text[..8191], &used, "INSERT  ")
  } else if app.view.extend {
    add_text(state.text[..8191], &used, "SELECT  ")
  } else {
    add_text(state.text[..8191], &used, "NORMAL  ")
  }
  name_start := used
  if name.len == 0 {
    add_text(state.text[..8191], &used, "Untitled")
  } else {
    add_text(state.text[..8191], &used, name)
  }
  name_end := used
  if name.len == 0 {
    name_end = name_start
  }
  add_text(state.text[..8191], &used, " — DNA")
  state.text[used] = 0
  if !platform.title(window, &state.text[0]) {
    #panic("title update failed")
  }
  state.name_start = name_start
  state.name_end = name_end
  state.dirty = dirty
  state.insert = app.view.insert
  state.extend = app.view.extend
  state.ready = true
}
fn draw(renderer: rawptr, window: rawptr, app: *App, typography: *Typography) {
  render_trace_begin(app, typography)

  if !paint(renderer, theme().background) || !platform.clear(renderer) {
    #panic("clear failed")
  }

  width: i32 = 0
  height: i32 = 0

  if !platform.size(renderer, &width, &height) {
    #panic("size failed")
  }

  animation_begin(app, typography, width, height)
  // One UI frame per draw: status lines, split handles and every panel share
  // it, so hit-testing sees everything on screen.
  ui_begin(&app.ui, typography)
  app.ui.in_draw = true
  // A closed dialog forgets its button focus; the next one starts at its default.
  if !dialog_panel(app) {
    app.ui.dialog_focus_set = false
  }
  draw_panes(renderer, app, typography, width, height)
  draw_split_handles(renderer, app, typography, width, height)
  if !tree_docked(app) {
    app.view.animation.tree_geometry.ready = false
  }
  // A docked tree is part of the layout, drawn whether or not it has focus.
  if tree_docked(app) {
    draw_tree(renderer, app, typography, width, height)
  }

  if app.render_trace.enabled {
    app.render_trace.panes_finished = render_clock()
  }
  doc := app.documents.current
  status_height: f32 = 0.0
  if app.view.status_line {
    status_height = typography.line
  }

  if (search_prompt(app.prompt_state.panel) && app.search_state.explorer) || (app.prompt_state.panel == .Match && app.match_state.explorer) {
    draw_explorer(renderer, app, typography, width, height)
  }
  if popup_shown(app) {
    popup_begin(renderer, app)
  }
  if app.prompt_state.panel == .Terminal {
    draw_terminal(renderer, app, typography, width, height, true, true)
  } else if app.prompt_state.panel == .Directory {
    draw_explorer(renderer, app, typography, width, height)
  } else if key_menu_is(app.prompt_state.panel) || vim_menu_active(app) {
    // Menus opened from the explorer overlay it instead of hiding it.
    if (app.prompt_state.panel == .Goto && app.input_state.goto_explorer) || (app.prompt_state.panel == .Leader && app.input_state.leader_explorer) {
      draw_explorer(renderer, app, typography, width, height)
    }
    draw_key_menu(renderer, app, typography, width, height, status_height)
  } else if app.prompt_state.panel == .Hover {
    draw_hover(renderer, app, typography, width, height)
  } else if completion_visible(app) {
    draw_completion(renderer, app, typography, width, height)
  } else if app.prompt_state.panel == .Commands {
    if app.explorer.commands {
      draw_explorer(renderer, app, typography, width, height)
    }
    draw_command_palette(renderer, app, typography, width, height)
  } else if app.prompt_state.panel == .ReplacePreview {
    draw_replace_preview(renderer, app, typography, width, height, status_height)
  } else if app.prompt_state.panel == .ProjectSearch {
    draw_project_search(renderer, app, typography, width, height, status_height)
  } else if app.prompt_state.panel == .Open || app.prompt_state.panel == .Buffers {
    draw_picker(renderer, app, typography, width, height, status_height)
  } else if app.prompt_state.panel == .Tree {
    if !tree_docked(app) {
      draw_tree(renderer, app, typography, width, height)
    }
  } else if app.prompt_state.panel != .None {
    draw_dialog(renderer, app, typography, width, height, status_height)
  }
  popup_present(renderer, app)
  composition_draw(renderer, window, app, typography, width, height)
  update_window_title(window, app, doc)
  if app.render_trace.enabled {
    app.render_trace.present_started = render_clock()
  }
  app.ui.in_draw = false
  // Drawing computes whether motion is still active on this frame.
  present_pacing(app, renderer)
  if !platform.present(renderer) {
    #panic("present failed")
  }

  render_trace_end(app, typography)
  app.view.animation.surfaces_ready = true
}

fn draw_document(renderer: rawptr, app: *App, typography: *Typography, width: i32, height: i32, focused: bool) {
  if app.documents.slots[app.documents.active].terminal.handle != nil {
    draw_terminal(renderer, app, typography, width, height, false, focused)
    return
  }

  margin := app.config.document_padding * typography.scale
  doc := app.documents.current
  gutter: f32 = 0.0
  if app.view.line_numbers {
    gutter = typography.cell * 7.0
  }
  origin := margin + gutter
  status_height: f32 = 0.0
  if app.view.status_line {
    status_height = typography.line
  }
  visible_width := #cast(f32, width) - origin - margin
  visible_height := #cast(f32, height) - margin * 2.0 - status_height

  if visible_width < typography.cell {
    visible_width = typography.cell
  }
  if visible_height < typography.line {
    visible_height = typography.line
  }

  camera_width := visible_width
  camera_height := visible_height
  if app.view.pane_ready {
    pane := &app.view.panes[typography.current_pane]
    if pane.geometry.active {
      camera_width = #cast(f32, pane.target_rect.width) - origin - margin
      camera_height = #cast(f32, pane.target_rect.height) - margin * 2.0 - status_height
      if camera_width < typography.cell {
        camera_width = typography.cell
      }
      if camera_height < typography.line {
        camera_height = typography.line
      }
    }
  }

  head := doc.cursor
  if !app.view.insert {
    head = buffer.head(doc)
  }
  caret_y := #cast(f32, (line_at(doc, head) - 1)) * typography.line
  scroll_margin := app.config.scroll_margin * typography.line
  if scroll_margin > (camera_height - typography.line) * 0.5 {
    scroll_margin = (camera_height - typography.line) * 0.5
  }

  if caret_y - scroll_margin < app.view.scroll_y {
    app.view.scroll_y = caret_y - scroll_margin
  }
  if caret_y + typography.line + scroll_margin > app.view.scroll_y + camera_height {
    app.view.scroll_y = caret_y + typography.line + scroll_margin - camera_height
  }
  if app.view.scroll_y < 0.0 {
    app.view.scroll_y = 0.0
  }

  caret := measure_position(doc, typography, head)
  caret_x := text_caret_x(&caret, app.view.insert)
  horizontal_margin := app.config.horizontal_scroll_margin * typography.cell
  if horizontal_margin > camera_width * 0.4 {
    horizontal_margin = camera_width * 0.4
  }

  if caret_x - horizontal_margin < app.view.scroll_x {
    app.view.scroll_x = caret_x - horizontal_margin
  }
  if caret_x + typography.cell + horizontal_margin > app.view.scroll_x + camera_width {
    app.view.scroll_x = caret_x + typography.cell + horizontal_margin - camera_width
  }
  if app.view.scroll_x < 0.0 {
    app.view.scroll_x = 0.0
  }

  visual := &app.view.animation.file
  animated_scroll(app, visual, app.view.scroll_x, app.view.scroll_y, visible_height, app.view.animation.reset)
  if focused && app.view.insert {
    editing_scroll_visible(visual, caret_x, caret_y, typography.cell, typography.line, visible_width, visible_height, app.view.scroll_x, app.view.scroll_y)
  }
  scroll_x := visual.x.value
  scroll_y := visual.y.value
  viewport := visible_viewport(doc, typography.line, visible_height, visual.y.value)

  shaped := line_layout_update(typography, &typography.pane.layout, doc, app.documents.slots[app.documents.active].identity, viewport)
  if shaped > 0 {
    typography.document_updates += 1
  }
  rendered := typography.pane
  if rendered.revision != doc.revision || rendered.document != doc || typography.rendered_view_revision != app.view.revision || rendered.start != viewport.start || rendered.end != viewport.end {
    rendered.revision = doc.revision
    rendered.document = doc
    typography.rendered_view_revision = app.view.revision
    rendered.start = viewport.start
    rendered.end = viewport.end
  }

  clipping_document := platform.PixelRect{x: #cast(i32, origin), y: 0, width: width - #cast(i32, origin), height: height - #cast(i32, status_height)}

  if clipping_document.width < 1 {
    clipping_document.width = 1
  }
  if clipping_document.height < 1 {
    clipping_document.height = 1
  }
  if !platform.clip(renderer, &clipping_document) {
    #panic("document clip")
  }
  if app.view.highlight_line {
    highlight := platform.Rect{x: origin, y: margin + caret_y - scroll_y, width: #cast(f32, width) - origin, height: typography.line}
    if !paint(renderer, theme().line) || !platform.fill(renderer, &highlight) {
      #panic("current line")
    }
  }

  draw_selection(renderer, doc, &typography.pane.layout, viewport, typography, origin, margin, scroll_x, scroll_y, #cast(f32, width))
  cursor_width := typography.cell
  if app.view.insert {
    cursor_width = app.config.cursor_thickness * typography.scale
  }
  cursor_target_x := origin + caret_x - scroll_x
  cursor_target_y := margin + caret_y - scroll_y
  cursor_snap := app.view.animation.reset || !app.config.smooth_cursor || cursor_step_snaps(&visual.cursor_x, &visual.cursor_y, cursor_target_x, cursor_target_y, typography.cell, typography.line)
  // The editing caret is always at its logical destination. Only the trailing
  // decoration follows time; retain the last logical point for jump policy.
  _ = animated_follow(app, &visual.cursor_x, cursor_target_x, app.config.cursor_animation_ms, true)
  _ = animated_follow(app, &visual.cursor_y, cursor_target_y, app.config.cursor_animation_ms, true)
  cursor := platform.Rect{x: cursor_target_x, y: cursor_target_y, width: cursor_width, height: typography.points * typography.scale + 5.0 * typography.scale}

  cursor_target := platform.Rect{x: cursor_target_x, y: cursor_target_y, width: cursor.width, height: cursor.height}
  if focused {
    _ = draw_cursor_trail(renderer, app, &visual.trail, cursor_target, cursor_snap, theme().cursor)
    if !paint(renderer, theme().cursor) || !platform.fill(renderer, &cursor) {
      #panic("cursor draw failed")
    }
  }
  if focused {
    draw_extra_cursors(renderer, doc, &typography.pane.layout, viewport, typography, origin, margin, scroll_x, scroll_y, app.view.insert)
  }
  if platform.tui_active() {
    line_layout_draw(&typography.pane.layout, theme().text, origin - scroll_x, margin + viewport.y - scroll_y)
    _ = draw_syntax(renderer, app, typography, viewport, origin - scroll_x, margin + viewport.y - scroll_y, clipping_document)
  } else if !draw_syntax(renderer, app, typography, viewport, origin - scroll_x, margin + viewport.y - scroll_y, clipping_document) {
    line_layout_draw(&typography.pane.layout, theme().text, origin - scroll_x, margin + viewport.y - scroll_y)
  }
  _ = draw_diagnostics(renderer, app, typography, viewport, origin - scroll_x, margin - scroll_y)

  if !platform.clip(renderer, nil) {
    #panic("document clip reset")
  }
  ui_scrollbar(renderer, typography.scale, platform.Rect{x: 0.0, y: margin, width: #cast(f32, width), height: visible_height}, #cast(f32, doc.line_count) * typography.line, scroll_y)

  draw_chrome(renderer, app, typography, width, height, margin, gutter, scroll_y)

  if focused {
    draw_diagnostic_hover(renderer, app, typography, width, height)
  }
}

fn draw_panes(renderer: rawptr, app: *App, typography: *Typography, width: i32, height: i32) {
  pane_init(app)
  pane_store(app)


  for stale in 0..15 {
    if !app.view.panes[stale].used || app.view.panes[stale].branch {
      release_pane_cache(typography, stale)
    }
  }

  pane_layout(app, 0, editor_area(app, width, height, typography.scale))
  for index in 0..15 {
    pane := &app.view.panes[index]
    if pane.used {
      edges := rectangle_edges(pane.target_rect)
      for axis in 0..4 {
        if edges[axis] != pane.geometry.target[axis] {
          app.view.animation.geometry_retargeted = true
        }
      }
    }
  }
  pane_animate_layout(app, 0)
  saved_visual := app.view.animation.file
  saved_reset := app.view.animation.reset
  // Draw inactive views first and restore the focused editing context last.
  for pass in 0..2 {
    for index in 0..15 {
      pane := &app.view.panes[index]
      focused := index == app.view.focused
      if pane.used && !pane.branch && ((pass == 0 && !focused) || (pass == 1 && focused)) {
        pane_load(app, index)
        if pane.rect.width <= 0 || pane.rect.height <= 0 { continue }
        app.view.animation.reset = saved_reset || !focused

        if focused {
          app.view.animation.file = saved_visual
        }
        if !platform.viewport(renderer, &pane.rect) {
          #panic("pane viewport")
        }

        cached := pane_text_ready(typography, index)
        typography.current_pane = index
        typography.pane = cached
        // Identity protects against arena addresses reused by another buffer.
        if cached.identity != app.documents.slots[app.documents.active].identity {
          cached.document = nil
          cached.caret_document = nil
        }
        typography.rendered_view_revision = app.view.revision
        if !tint(cached.text, theme().text) {
          #panic("pane text color")
        }

        draw_document(renderer, app, typography, pane.rect.width, pane.rect.height, focused)
        cached.identity = app.documents.slots[app.documents.active].identity
        pane.scroll_x = app.view.scroll_x
        pane.scroll_y = app.view.scroll_y

        if app.view.panes[0].branch {
          // In a terminal the top line would cost a row of text; the status
          // line above already separates stacked panes there.
          if !platform.tui_active() {
            border := platform.Rect{x: 0.0, y: 0.0, width: #cast(f32, pane.rect.width), height: typography.scale}
            color := theme().border
            if focused {
              color = theme().cursor
            }

            if !paint(renderer, color) || !platform.fill(renderer, &border) {
              #panic("pane border")
            }
          }
          if pane.rect.x > 0 {
            divider := platform.Rect{x: 0.0, y: 0.0, width: typography.scale, height: #cast(f32, pane.rect.height)}
            if !paint(renderer, theme().border) || !platform.fill(renderer, &divider) {
              #panic("pane divider")
            }
          }
        }
      }
    }
  }
  pane_load(app, app.view.focused)
  app.view.animation.reset = saved_reset
  if !platform.viewport(renderer, nil) {
    #panic("pane viewport reset")
  }
}
fn pane_text_font(typography: *Typography, font: rawptr) {
  ui_cache_clear(typography)
  line_layout_font(&typography.directory_layout, font)
  preview_text_release(typography)
  for index in 0..15 {
    cached := typography.pane_text[index]
    if cached==nil { continue }
    if cached.text != nil {
      _ = ttf.set_font(cached.text, font)
      cached.document = nil
    }
    if cached.caret != nil {
      _ = ttf.set_font(cached.caret, font)
      cached.caret_document = nil
    }
    line_layout_font(&cached.layout, font)
    for span in 0..128 {
      item := &cached.spans[span]
      item.geometry_ready = false
      item.text_ready = false
      if item.text != nil {
        _ = ttf.set_font(item.text, font)
      }
    }
  }
  _ = ttf.set_font(typography.primary_document, font)
  _ = ttf.set_font(typography.primary_caret, font)
}
fn release_pane_cache(typography: *Typography, index: usize) {
  cached := typography.pane_text[index]

  if cached == nil { return }
  if cached.text != nil && cached.text != typography.primary_document {
    ttf.destroy(cached.text)
  }
  if cached.caret != nil && cached.caret != typography.primary_caret {
    ttf.destroy(cached.caret)
  }

  for span in 0..128 {
    if cached.spans[span].text != nil {
      ttf.destroy(cached.spans[span].text)
    }
  }
  line_layout_release(&cached.layout)
  if typography.pane==cached {
    typography.pane=nil
  }
  owner:=cached.owner
  if typography.observer!=nil {
    allocation_record(typography.observer, "pane_text", #sizeof(PaneText)+16, cached.born, true)
  }
  typography.pane_text[index]=nil
  arena_owner.release(owner)
}
fn release_pane_text(typography: *Typography) {
  preview_text_release(typography)
  for index in 0..15 {
    release_pane_cache(typography, index)
  }
  line_layout_release(&typography.directory_layout)
  typography.pane = nil
}
