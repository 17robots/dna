#target(kernel: linux)
#link("c")
use "../filesystem" server_files
fn server_path_separator()u8 {
  return 58
}
fn server_path_component(text:[]const u8)[]const u8 {
  return text
}
extern fn server_access "access"(path:*const u8, mode:i32)i32
fn server_executable(path:[]const u8)bool {
  terminated:[4608]u8=[]
  if #len(path)==0 || #len(path)>=#len(terminated) {
    return false
  }
  _=copy_text(terminated[..], path)
  return server_files.executable(path) && server_access(&terminated[0], 1)==0
}
