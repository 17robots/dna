#target(kernel: windows)
use "../filesystem" server_files
fn server_path_separator()u8 {
  return 59
}
fn server_path_component(text:[]const u8)[]const u8 {
  if #len(text)>=2 && text[0]==34 && text[#len(text)-1]==34 {
    return text[1..#len(text)-1]
  }
  return text
}
fn server_executable(path:[]const u8)bool {
  leaf:usize=0
  for at in 0..#len(path) {
    if path[at]==47 || path[at]==92 {
      leaf=at+1
    }
  }
  for at in leaf..#len(path) {
    if path[at]==46 {
      return server_files.executable(path)
    }
  }
  storage:[4096]u8=[]
  configured:=host.environment("PATHEXT", storage[..])
  extensions:[]const u8=".COM;.EXE;.BAT;.CMD"
  if configured.ok && configured.found {
    extensions=configured.value
  }
  at:usize=0
  for at<#len(extensions) {
    end:=at
    for end<#len(extensions) && extensions[end]!=59 {
      end+=1
    }
    suffix:=extensions[at..end]
    if #len(suffix)>1 && suffix[0]==46 && #len(path)+#len(suffix)<4608 {
      candidate:[4608]u8=[]
      valid:=true
      for byte in suffix {
        if byte==47 || byte==92 || byte==34 || byte==58 {
          valid=false
        }
      }
      if valid {
        length:=copy_text(candidate[..], path)
        add_text(candidate[..], &length, suffix)
        if server_files.executable(candidate[..length]) {
          return true
        }
      }
    }
    at=end+1
  }
  return false
}
