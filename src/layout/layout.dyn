use "../buffer"

pub struct Layout {
  nodes: [15]Node,
  node_count: usize,
  width: f32,
  height: f32,
  font_size: f32,
  line_numbers: bool,
  relative_numbers: bool,
  status_line: bool,
  highlight_line: bool,
  tree_set: bool,
  font_size_set: bool,
  reduced_motion: bool,
  valid: bool,
}

fn trim(text: str) str {
  start: usize = 0
  end := text.len
  for start < end && (text[start] == 32 || text[start] == 9 || text[start] == 13) {
    start += 1
  }
  for end > start && (text[end - 1] == 32 || text[end - 1] == 9 || text[end - 1] == 13) {
    end -= 1
  }
  return text[start..end]
}
pub fn parse(source: str) Layout {
  result := layout_defaults()
  offset: usize = 0
  seen: u16 = 0
  for offset < source.len {
    end := offset
    for end < source.len && source[end] != 10 {
      end += 1
    }
    line := trim(source[offset..end])
    offset = end + 1
    if line.len == 0 || line[0] == '#' { continue }
    split: usize = 0
    for split < line.len && line[split] != '=' {
      split += 1
    }
    if split == line.len { return layout_defaults() }
    key := trim(line[..split])
    digits := trim(line[split + 1..])
    if buffer.equal(key, "tree") {
      if result.tree_set || digits.len < 3 || digits[0] != 34 || digits[digits.len - 1] != 34 {
        return layout_defaults()
      }
      tree := digits[1..digits.len - 1]
      position: usize = 0
      if parse_tree_node(tree, &position, &result, 0) != 0 || position != tree.len {
        return layout_defaults()
      }
      result.tree_set = true
      seen = seen | 256
      continue
    }
    if digits.len == 0 || digits.len > 8 { return layout_defaults() }
    value: f32 = 0.0
    divisor: f32 = 1.0
    decimal := false
    count: usize = 0
    for byte in digits {
      if byte == '.' && !decimal {
        decimal = true
        continue
      }
      if byte < 48 || byte > 57 { return layout_defaults() }
      count += 1
      value = value * 10.0 + (byte - 48)
      if decimal {
        divisor *= 10.0
      }
    }
    if count == 0 { return layout_defaults() }
    value /= divisor
    case key {
      "popup_width" => {
        if (seen & 1) != 0 || value < 0.25 || value > 1.0 { return layout_defaults() }
        result.width = value
        seen = seen | 1
      }
      "popup_height" => {
        if (seen & 2) != 0 || value < 0.25 || value > 1.0 { return layout_defaults() }
        result.height = value
        seen = seen | 2
      }
      "font_size" => {
        if (seen & 4) != 0 || value < 12.0 || value > 36.0 { return layout_defaults() }
        result.font_size = value
        result.font_size_set = true
        seen = seen | 4
      }
      "line_numbers" => {
        if (seen & 8) != 0 || (value != 0.0 && value != 1.0) { return layout_defaults() }
        result.line_numbers = value == 1.0
        seen = seen | 8
      }
      "relative_numbers" => {
        if (seen & 16) != 0 || (value != 0.0 && value != 1.0) { return layout_defaults() }
        result.relative_numbers = value == 1.0
        seen = seen | 16
      }
      "status_line" => {
        if (seen & 32) != 0 || (value != 0.0 && value != 1.0) { return layout_defaults() }
        result.status_line = value == 1.0
        seen = seen | 32
      }
      "highlight_line" => {
        if (seen & 64) != 0 || (value != 0.0 && value != 1.0) { return layout_defaults() }
        result.highlight_line = value == 1.0
        seen = seen | 64
      }
      "reduced_motion" => {
        if (seen & 128) != 0 || (value != 0.0 && value != 1.0) { return layout_defaults() }
        result.reduced_motion = value == 1.0
        seen = seen | 128
      }
      _ => {
        return layout_defaults()
      }
    }
  }
  result.valid = seen != 0
  return result
}

fn layout_defaults() Layout {
  result := Layout{ width: 0.64, height: 0.56, font_size: 20.0, line_numbers: true, relative_numbers: true, status_line: true, highlight_line: true }
  for i in 0..result.nodes.len {
    result.nodes[i].percent = 50
  }
  return result
}

pub struct Node {
  branch: bool,
  vertical: bool,
  first: usize,
  second: usize,
  parent: usize,
  percent: usize,
}
fn parse_tree_node(text: str, at: *usize, result: *Layout, parent: usize) usize {
  if at.* >= text.len || result.node_count == 15 { return 15 }
  index := result.node_count
  result.node_count += 1
  result.nodes[index].parent = parent
  character := text[at.*]
  at.* += 1
  if character == 'f' { return index }
  if character != 'v' && character != 'h' { return 15 }
  node := &result.nodes[index]
  node.branch = true
  node.vertical = character == 'v'
  percent: usize = 0
  digits: usize = 0
  for at.* < text.len && text[at.*] >= 48 && text[at.*] <= 57 {
    percent = percent * 10 + (text[at.*] - 48)
    digits += 1
    at.* += 1
    if digits > 2 { return 15 }
  }
  if digits == 0 || percent < 10 || percent > 90 || at.* >= text.len || text[at.*] != '(' {
    return 15
  }
  node.percent = percent
  at.* += 1
  node.first = parse_tree_node(text, at, result, index)
  if node.first == 15 || at.* >= text.len || text[at.*] != ',' { return 15 }
  at.* += 1
  node.second = parse_tree_node(text, at, result, index)
  if node.second == 15 || at.* >= text.len || text[at.*] != ')' { return 15 }
  at.* += 1
  return index
}
