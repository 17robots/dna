#target(kernel: darwin)
#link("System")
extern fn load_sysctl "sysctlbyname"(name: *const u8, output: *i32, size: *usize, value: rawptr, value_size: usize) i32
fn load_cpus() usize {
  name: []const u8 = "hw.activecpu\0"
  count: i32 = 0
  size := #sizeof(i32)
  if load_sysctl(&name[0], &count, &size, nil, 0) != 0 || size != #sizeof(i32) || count < 1 {
    return 1
  }
  return #cast(usize, count)
}
