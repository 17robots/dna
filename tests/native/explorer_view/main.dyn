extern fn ticks "SDL_GetTicksNS"() u64
extern fn read_pixels "SDL_RenderReadPixels"(renderer: rawptr, rectangle: rawptr) rawptr
extern fn save_bmp "SDL_SaveBMP"(surface: rawptr, path: *const u8) bool

stage: u32 = 0
frames: u32 = 0
started: u64 = 0
total: u64 = 0
maximum: u64 = 0
extern fn destroy_surface "SDL_DestroySurface"(surface: rawptr)
pub fn SDL_CreateWindow(title: *const u8, width: i32, height: i32, flags: u64) rawptr {
  next := #cast(*fn(*const u8, i32, i32, u64) rawptr) probe_next("SDL_CreateWindow\0")
  actual_width := width
  if probe_env("DNA_EXPLORER_NARROW\0") != nil {
    actual_width = 620
  }
  return next(title, actual_width, height, flags)
}
pub fn SDL_WaitEventTimeout(event: rawptr, timeout: i32) bool {
  probe_clear(event)
  if stage < 4 {
    probe_kind(event).* = 768
    code: u32 = 106
    if stage == 0 {
      code = 32
    }
    else if stage == 1 {
      code = 101
    }
    probe_u32(event, 28).* = code
    probe_byte(event, 36).* = 1
    stage += 1
  } else {
    probe_kind(event).* = 514
    started = ticks()
  }
  return true
}
fn milliseconds(nanoseconds: u64) {
  hundredths := (nanoseconds + 5000) / 10000
  probe_number(hundredths / 100)
  probe_log(".")
  if hundredths % 100 < 10 {
    probe_log("0")
  }
  probe_number(hundredths % 100)
}
pub fn SDL_RenderPresent(renderer: rawptr) bool {
  next := #cast(*fn(rawptr) bool) probe_next("SDL_RenderPresent\0")
  if started != 0 {
    elapsed := ticks() - started
    total += elapsed
    if elapsed > maximum {
      maximum = elapsed
    }
    started = 0
    frames += 1
    if frames == 20 {
      surface := read_pixels(renderer, nil)
      probe_check(surface != nil && save_bmp(surface, probe_env("DNA_EXPLORER_CAPTURE\0")), "explorer capture failed")
      destroy_surface(surface)
      probe_log("explorer redraw mean ")
      milliseconds(total / #cast(u64) frames)
      probe_log(" ms, max ")
      milliseconds(maximum)
      probe_log(" ms\n")
      probe_exit(0)
    }
  }
  return next(renderer)
}
