struct DiskWatch { identity, epoch: u64, path: [4096]u8, length: usize, dirty, ready: bool, next: *Slot }
struct DiskState { worker: rawptr, retry, initialized: bool, first, last: *Slot }
struct DiskReady { index: usize, identity: u64 }
extern fn disk_next "dna_disk_next_ready"(disk: rawptr, output: *DiskReady) i32

extern fn disk_open "dna_disk_open"() rawptr
extern fn disk_close "dna_disk_close"(disk: rawptr)
extern fn disk_watch "dna_disk_watch_checked"(disk: rawptr, index: usize, identity: u64, path: *const u8, saved: *const u8, length: usize) i32
extern fn disk_pending "dna_disk_pending_at"(disk: rawptr, index: usize, identity: u64) isize
extern fn disk_take "dna_disk_take_at"(disk: rawptr, index: usize, identity: u64, bytes: *u8, capacity: usize) i32

fn disk_release(app: *App) {
  if app.disk.worker != nil {
    disk_close(app.disk.worker)
    app.disk.worker = nil
  }
}
fn disk_replace(doc: *buffer.Document, bytes: []const u8) {
  cursor := doc.cursor
  anchor := doc.anchor
  marks: [992]usize = []
  for saved_index in 0..992 {
    marks[saved_index] = doc.marks[saved_index]
  }
  _ = buffer.load(doc, bytes)
  if cursor > doc.length {
    cursor = doc.length
  }
  if anchor > doc.length {
    anchor = doc.length
  }
  for cursor > 0 && cursor < doc.length && (doc.bytes[cursor] & 192) == 128 {
    cursor -= 1
  }
  for anchor > 0 && anchor < doc.length && (doc.bytes[anchor] & 192) == 128 {
    anchor -= 1
  }
  doc.cursor = cursor
  doc.anchor = anchor
  for index in 0..992 {
    position := marks[index]
    if position > doc.length {
      position = doc.length
    }
    for position > 0 && position < doc.length && (doc.bytes[position] & 192) == 128 {
      position -= 1
    }
    doc.marks[index] = position
  }
}
// Only registration changes and worker-published results enter this workset.
fn disk_dirty_slot(app: *App, index: usize) {
  if index >= #len(app.documents.slots) {
    return
  }
  slot := app.documents.slots[index]
  if slot.watch.dirty {
    return
  }
  slot.watch.dirty = true
  slot.watch.next = nil
  if app.disk.last == nil {
    app.disk.first = slot
  }
  else {
    app.disk.last.watch.next = slot
  }
  app.disk.last = slot
}
fn disk_register(app: *App, slot: *Slot) bool {
  watched := &slot.watch
  if slot.document == nil || slot.file.length == 0 || slot.terminal.handle != nil {
    if watched.identity != 0 {
      blank: [1]u8 = [0]
      if disk_watch(app.disk.worker, slot.index, 0, &blank[0], &blank[0], 0) == 0 {
        return false
      }
      watched.identity = 0
    }
    watched.ready = false
    return true
  }
  if app.disk.worker == nil {
    app.disk.worker = disk_open()
    if app.disk.worker == nil {
      return false
    }
  }
  if watched.identity != slot.identity || watched.epoch != slot.document.saved_epoch || !buffer.equal(watched.path[..watched.length], files.name(&slot.file)) {
    if disk_watch(app.disk.worker, slot.index, slot.identity, &slot.file.path[0], &buffer.saved_text(slot.document)[0], slot.document.saved_length) == 0 {
      return false
    }
    watched.identity = slot.identity
    watched.epoch = slot.document.saved_epoch
    watched.length = copy_text(watched.path[..], files.name(&slot.file))
    watched.ready = false
  }
  return true
}
fn disk_process(app: *App, slot: *Slot) bool {
  pending := disk_pending(app.disk.worker, slot.index, slot.identity)
  if pending == 0 {
    slot.watch.ready = false
    return false
  }
  if pending < 0 {
    empty: [1]u8 = [0]
    status := disk_take(app.disk.worker, slot.index, slot.identity, &empty[0], 1)
    slot.watch.ready = false
    slot.disk_changed = status != 5
    return true
  }
  allocated := arena_owner.try_create(#cast(usize, pending))
  if allocated == nil {
    app.disk.retry = true
    disk_dirty_slot(app, slot.index)
    return false
  }
  defer arena_owner.release(allocated)
  bytes := mem.push_bytes_uninit(allocated, #cast(usize, pending))
  changed := false
  if disk_take(app.disk.worker, slot.index, slot.identity, &bytes[0], #len(bytes)) == 1 {
    content := bytes[..#len(bytes) - 1]
    if app.config.reload_clean_buffers && !buffer.dirty_cached(slot.document) && #len(content) <= buffer.Capacity && buffer.valid(content) {
      disk_replace(slot.document, content)
      slot.disk_changed = false
      disk_dirty_slot(app, slot.index)
    } else {
      slot.disk_changed = true
    }
    changed = true
  }
  slot.watch.ready = false
  return changed
}
fn disk_tick(app: *App) bool {
  // Bootstrap supports restored/manual fixtures; mutations maintain the queue.
  if !app.disk.initialized {
    app.disk.initialized = true
    for index in 0..#len(app.documents.slots) {
      disk_dirty_slot(app, index)
    }
  }
  ready := DiskReady{}
  for disk_next(app.disk.worker, &ready) != 0 {
    if ready.index < #len(app.documents.slots) {
      slot := app.documents.slots[ready.index]
      if slot.document != nil && slot.identity == ready.identity {
        slot.watch.ready = true
        disk_dirty_slot(app, ready.index)
      }
    }
  }
  first := app.disk.first
  app.disk.first = nil
  app.disk.last = nil
  app.disk.retry = false
  changed := false
  for first != nil {
    slot := first
    first = slot.watch.next
    slot.watch.next = nil
    slot.watch.dirty = false
    if !disk_register(app, slot) {
      app.disk.retry = true
      disk_dirty_slot(app, slot.index)
      continue
    }
    if slot.watch.ready && disk_process(app, slot) {
      changed = true
    }
  }
  return changed
}
fn disk_reload(app: *App, confirmed: bool) {
  if app.documents.file.length == 0 || app.documents.slots[app.documents.active].terminal.handle != nil {
    notice(app, "This buffer has no file to reload.")
    return
  }
  if buffer.dirty_cached(app.documents.current) && !confirmed {
    app.prompt_state.panel = Panel.FileConflict
    return
  }
  mark := mem.arena_mark(app.scratch)
  defer mem.arena_rewind(app.scratch, mark)
  path := files.name(app.documents.file)
  info := files.metadata(path)
  if !info.ok || (info.mode & 61440) != 32768 {
    notice(app, "File is missing or is not a regular file. Buffer preserved.")
    return
  }
  read := files.read_text(path)
  defer files.release_text(&read)
  if !read.ok || !buffer.valid(read.data) {
    notice(app, "File is unreadable, too large, or invalid text. Buffer preserved.")
    return
  }
  disk_replace(app.documents.current, read.data)
  document_lifecycle_changed(app, app.documents.active)
  app.documents.slots[app.documents.active].disk_changed = false
  app.prompt_state.panel = Panel.None
}
