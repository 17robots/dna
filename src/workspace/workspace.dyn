use "std/mem"
use "../buffer"
use "std/unicode/utf8"

pub struct SavedBuffer {
  secondary: buffer.SelectionSet,
  path: str,
  text: str,
  saved: str,
  // Encoding-only borrowed segments; the on-disk format stays contiguous.
  saved_parts: [3]str,
  split_saved: bool,
  filetype: str,
  cursor: usize,
  anchor: usize,
  used: bool,
  // Restore from the file on disk; text and saved are not stored.
  reload: bool,
  // With reload: unsaved edits as one replacement of file bytes
  // patch_low..patch_high by patch, valid only while the file still has
  // stamp (inode, size, modification seconds and nanoseconds).
  patched: bool,
  patch_low, patch_high: usize,
  patch: str,
  stamp: [4]u64,
  // With patched: when pieces is nonempty, the text is these pieces instead
  // of one replacement. Each piece is three little-endian words (1 for
  // literal bytes from patch, else 0 for bytes of the file; offset; length).
  pieces: str,
}
pub struct SavedPane {
  secondary: buffer.SelectionSet,
  used: bool,
  branch: bool,
  vertical: bool,
  parent: usize,
  first: usize,
  second: usize,
  slot: usize,
  cursor: usize,
  anchor: usize,
  scroll_x: usize,
  scroll_y: usize,
  percent: usize,
}
pub struct State {
  project: str,
  buffers: [16]SavedBuffer,
  additional: []SavedBuffer,
  storage: *mem.Arena,
  // Piece records and literals captured for recovery, owned by the state.
  patches: *mem.Arena,
  panes: [15]SavedPane,
  active: usize,
  focused: usize,
}
// Preserve the inline legacy representation while growing snapshots as needed.
pub fn buffer_count(state: *const State) usize {
  return 16 + state.additional.len
}
pub fn buffer_at(state: *const State, index: usize) *const SavedBuffer {
  if index < 16 { return &state.buffers[index] }
  return &state.additional[index - 16]
}
pub fn buffer_mut(state: *State, index: usize) *SavedBuffer {
  if index < 16 { return &state.buffers[index] }
  return &state.additional[index - 16]
}
pub fn prepare(state: *State, count: usize) bool {
  if count <= buffer_count(state) { return true }
  if count - 16 > (#cast(usize, -1) - mem.ArenaHeader) / #sizeof(SavedBuffer) { return false }
  storage := mem.arena_alloc((count - 16) * #sizeof(SavedBuffer) + mem.ArenaHeader)
  additional := mem.push_array<SavedBuffer>(storage, count - 16)
  _ = mem.copy(additional, state.additional)
  mem.arena_release(state.storage)
  state.storage = storage
  state.additional = additional
  return true
}
pub fn release(state: *State) {
  mem.arena_release(state.storage)
  state.storage = nil
  if state.patches != nil {
    mem.arena_release(state.patches)
    state.patches = nil
  }
  state.additional = state.additional[..0]
}
struct Reader { bytes: str, at: usize, valid: bool}
struct Writer { bytes: []u8, at: usize, valid: bool}

fn flag(value: bool) usize {
  if value { return 1 }
  return 0
}
fn number(out: *Writer, value: usize) {
  if out.bytes.len - out.at < 8 {
    out.valid = false
    return
  }
  for offset in 0..8 {
    out.bytes[out.at + offset] = (value >> (offset * 8)) & 255
  }
  out.at += 8
}
fn text(out: *Writer, value: str) {
  number(out, value.len)
  if value.len > out.bytes.len - out.at {
    out.valid = false
    return
  }
  if value.len > 0 {
    _ = buffer.copy_bytes(&out.bytes[out.at], &value[0], value.len)
    out.at += value.len
  }
}
fn get_number(input: *Reader) usize {
  if input.bytes.len - input.at < 8 {
    input.valid = false
    return 0
  }
  value: usize = 0
  for offset in 0..8 {
    value = value | (#cast(usize, input.bytes[input.at + offset]) << (offset * 8))
  }
  input.at += 8
  return value
}
// Length-prefixed binary bytes, without the UTF-8 check get_text applies.
fn get_bytes(input: *Reader, limit: usize) str {
  length := get_number(input)
  if length > limit || length > input.bytes.len - input.at {
    input.valid = false
    return ""
  }
  result := input.bytes[input.at..input.at + length]
  input.at += length
  return result
}
fn get_text(input: *Reader, limit: usize) str {
  length := get_number(input)
  if length > limit || length > input.bytes.len - input.at {
    input.valid = false
    return ""
  }
  result := input.bytes[input.at..input.at + length]
  input.at += length
  if !utf8.valid(result) {
    input.valid = false
  }
  for byte in result {
    if byte == 0 {
      input.valid = false
    }
  }
  return result
}
pub fn encode(state: *const State, output: []u8) usize {
  writer := Writer{bytes: output, valid: true}
  if state.additional.len > 0 {
    text(&writer, "DNA session 3")
  } else {
    text(&writer, "DNA session 2")
  }
  text(&writer, state.project)
  number(&writer, state.active)
  number(&writer, state.focused)
  if state.additional.len > 0 {
    number(&writer, buffer_count(state))
  }
  for index in 0..buffer_count(state) {
    item := buffer_at(state, index)
    if item.used && item.reload {
      // Flag 2: the path and position only; flag 3 adds the edit patch.
      if item.patched && item.pieces.len > 0 {
        number(&writer, 4)
      } else if item.patched {
        number(&writer, 3)
      } else {
        number(&writer, 2)
      }
      text(&writer, item.path)
      text(&writer, item.filetype)
      number(&writer, item.cursor)
      number(&writer, item.anchor)
      if item.patched {
        for value in item.stamp {
          number(&writer, #cast(usize, value))
        }
        if item.pieces.len > 0 {
          text(&writer, item.pieces)
        } else {
          number(&writer, item.patch_low)
          number(&writer, item.patch_high)
        }
        text(&writer, item.patch)
      }
      continue
    }
    number(&writer, flag(item.used))
    if item.used {
      text(&writer, item.path)
      text(&writer, item.text)
      if item.split_saved {
        length: usize = 0
        for part in item.saved_parts {
          length += part.len
        }
        number(&writer, length)
        if length > writer.bytes.len - writer.at {
          writer.valid = false
        } else {
          for part in item.saved_parts {
            if part.len > 0 {
              _ = buffer.copy_bytes(&writer.bytes[writer.at], &part[0], part.len)
              writer.at += part.len
            }
          }
        }
      } else {
        text(&writer, item.saved)
      }
      text(&writer, item.filetype)
      number(&writer, item.cursor)
      number(&writer, item.anchor)
      selections(&writer, &item.secondary)
    }
  }
  for index in 0..15 {
    pane := &state.panes[index]
    number(&writer, flag(pane.used))
    if pane.used {
      number(&writer, flag(pane.branch))
      number(&writer, flag(pane.vertical))
      number(&writer, pane.parent)
      number(&writer, pane.first)
      number(&writer, pane.second)
      number(&writer, pane.slot)
      number(&writer, pane.cursor)
      number(&writer, pane.anchor)
      number(&writer, pane.percent)
      number(&writer, pane.scroll_x)
      number(&writer, pane.scroll_y)
      selections(&writer, &pane.secondary)
    }
  }
  if !writer.valid { return 0 }
  return writer.at
}
fn tree(state: *const State, index: usize, parent: usize, seen: *u32) bool {
  if index >= 15 || (seen.* & (#cast(u32, 1) << #cast(u32, index))) != 0 { return false }
  seen.* = seen.* | (#cast(u32, 1) << #cast(u32, index))
  pane := &state.panes[index]
  if !pane.used || pane.parent != parent || pane.percent < 10 || pane.percent > 90 { return false }
  if pane.branch {
    return tree(state, pane.first, index, seen) && tree(state, pane.second, index, seen)
  }
  if pane.slot >= buffer_count(state) || !buffer_at(state, pane.slot).used { return false }
  item := buffer_at(state, pane.slot)
  // Reloaded text is unknown here; positions are clamped after the reload.
  if item.reload { return pane.scroll_x <= 100000000 && pane.scroll_y <= 100000000 }
  for selected in 0..pane.secondary.count {
    selection := pane.secondary.ranges[selected]
    if selection.cursor > item.text.len || selection.anchor > item.text.len { return false }
  }
  return pane.cursor <= item.text.len && pane.anchor <= item.text.len && pane.scroll_x <= 100000000 && pane.scroll_y <= 100000000
}
// Replaces owned metadata; source text remains borrowed until the next decode.
pub fn decode(source: str, state: *State) bool {
  release(state)
  mem.clear(state)
  success := false
  defer {
    if !success {
      release(state)
    }
  }
  reader := Reader{bytes: source, valid: true}
  version := get_text(&reader, 32)
  dynamic := buffer.equal(version, "DNA session 3")
  newer := dynamic || buffer.equal(version, "DNA session 2")
  if !newer && !buffer.equal(version, "DNA session 1") { return false }
  state.project = get_text(&reader, 4095)
  state.active = get_number(&reader)
  state.focused = get_number(&reader)
  if dynamic {
    count := get_number(&reader)
    if !reader.valid || count <= 16 || count > (source.len - reader.at) / 8 || !prepare(state, count) {
      return false
    }
  }
  for index in 0..buffer_count(state) {
    item := buffer_mut(state, index)
    used := get_number(&reader)
    if used > 4 || (used >= 2 && !newer) { return false }
    if used >= 2 {
      item.used = true
      item.reload = true
      item.path = get_text(&reader, 3999)
      item.filetype = get_text(&reader, 64)
      item.cursor = get_number(&reader)
      item.anchor = get_number(&reader)
      if used >= 3 {
        item.patched = true
        for index_stamp in 0..4 {
          item.stamp[index_stamp] = get_number(&reader)
        }
        if used == 4 {
          item.pieces = get_bytes(&reader, source.len)
          if item.pieces.len == 0 || item.pieces.len % 24 != 0 { return false }
        } else {
          item.patch_low = get_number(&reader)
          item.patch_high = get_number(&reader)
        }
        // Piece literals are bounded by the record; a single patch stays a
        // contiguous insertion bounded by buffer.Capacity.
        limit := buffer.Capacity
        if used == 4 {
          limit = source.len
        }
        item.patch = get_bytes(&reader, limit)
        if item.patch_low > item.patch_high || !utf8.valid(item.patch) { return false }
      }
      if item.path.len == 0 || item.path[0] != '/' { return false }
      for byte in item.path {
        if byte == 10 || byte == 13 { return false }
      }
      continue
    }
    item.used = used == 1
    if item.used {
      item.path = get_text(&reader, 3999)
      item.text = get_text(&reader, buffer.Capacity)
      item.saved = get_text(&reader, buffer.Capacity)
      item.filetype = get_text(&reader, 64)
      item.cursor = get_number(&reader)
      item.anchor = get_number(&reader)
      if newer && !get_selections(&reader, &item.secondary, item.text.len) { return false }
      if item.cursor > item.text.len || item.anchor > item.text.len { return false }
      if item.path.len > 0 && item.path[0] != '/' { return false }
      for byte in item.path {
        if byte == 10 || byte == 13 { return false }
      }
      for previous in 0..index {
        if item.path.len > 0 && buffer_at(state, previous).used && buffer.equal(buffer_at(state, previous).path, item.path) {
          return false
        }
      }
    }
  }
  for index in 0..15 {
    pane := &state.panes[index]
    present := get_number(&reader)
    if present > 1 { return false }
    pane.used = present == 1
    if pane.used {
      branch := get_number(&reader)
      vertical := get_number(&reader)
      if branch > 1 || vertical > 1 { return false }
      pane.branch = branch == 1
      pane.vertical = vertical == 1
      pane.parent = get_number(&reader)
      pane.first = get_number(&reader)
      pane.second = get_number(&reader)
      pane.slot = get_number(&reader)
      pane.cursor = get_number(&reader)
      pane.anchor = get_number(&reader)
      pane.percent = get_number(&reader)
      pane.scroll_x = get_number(&reader)
      pane.scroll_y = get_number(&reader)
      if newer && !get_selections(&reader, &pane.secondary, buffer.Capacity) { return false }
    }
  }
  if !reader.valid || reader.at != source.len || state.active >= buffer_count(state) || state.focused >= 15 || !buffer_at(state, state.active).used || !state.panes[state.focused].used || state.panes[state.focused].branch || state.panes[state.focused].slot != state.active {
    return false
  }
  seen: u32 = 0
  if !tree(state, 0, 0, &seen) { return false }
  for index in 0..15 {
    if state.panes[index].used && (seen & (#cast(u32, 1) << #cast(u32, index))) == 0 {
      return false
    }
  }
  success = state.project.len > 0 && state.project[0] == '/'
  return success
}

pub fn encoded_size(state: *const State) usize {
  size: usize = 8 + 13 + 8 + state.project.len + 16 + buffer_count(state) * 8 + 15 * 8
  if state.additional.len > 0 {
    size += 8
  }
  for index in 0..buffer_count(state) {
    item := buffer_at(state, index)
    if item.used && item.reload {
      size += 32 + item.path.len + item.filetype.len
      if item.patched {
        // Four stamp words, the range, and the patch with its length.
        size += 56 + item.patch.len
        if item.pieces.len > 0 {
          // The piece records with their length replace the two range words.
          size += item.pieces.len - 8
        }
      }
    } else if item.used {
      if item.split_saved {
        for part in item.saved_parts {
          size += part.len
        }
      }
      size += 56 + item.secondary.count * 16 + item.path.len + item.text.len + item.filetype.len
      if !item.split_saved {
        size += item.saved.len
      }
    }
  }
  for index in 0..15 {
    if state.panes[index].used {
      size += 96 + state.panes[index].secondary.count * 16
    }
  }
  return size
}
fn selections(out: *Writer, set: *const buffer.SelectionSet) {
  if set.count > 31 {
    out.valid = false
    return
  }
  number(out, set.count)
  for index in 0..set.count {
    number(out, set.ranges[index].cursor)
    number(out, set.ranges[index].anchor)
  }
}
fn get_selections(input: *Reader, set: *buffer.SelectionSet, limit: usize) bool {
  set.count = get_number(input)
  if set.count > 31 { return false }
  for index in 0..set.count {
    cursor := get_number(input)
    anchor := get_number(input)
    if cursor > limit || anchor > limit { return false }
    set.ranges[index] = buffer.Selection{cursor: cursor, anchor: anchor}
  }
  return input.valid
}
