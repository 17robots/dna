#target(kernel: darwin)
#link("System")
use "std/c"

extern fn host_getcwd "getcwd"(output: *u8, capacity: usize) *u8
extern fn host_chdir "chdir"(path: *const u8) i32
extern fn host_getpid "getpid"() i32
fn native_current_directory(destination: []u8) usize {
  if host_getcwd(&destination[0], #len(destination)) == nil { return 0 }
  return c.string_length(&destination[0], #len(destination))
}
fn native_change_directory(path: []const u8) bool {
  storage: [4096]u8 = []
  encoded := c.string_from_bytes(storage[..], path)
  return encoded.ok && host_chdir(encoded.value) == 0
}
fn native_process_id() u32 { return #cast(u32) host_getpid() }
fn native_small_pages(memory: []u8) { _ = memory }

extern fn host_environment "getenv"(name: *const u8) *const u8
// Pinned Dyn preview.17 runtime accessors. Importing std/process here also
// imports its POSIX process declarations, colliding with DNA's native module.
extern fn host_argument_count "dyn_arguments_count"() *i32
extern fn host_argument_length "dyn_arguments_length"(value: *const u8) usize
extern fn host_argument_vector "dyn_arguments_vector"() ***const u8
fn native_environment(name: []const u8, destination: []u8) EnvironmentResult {
  storage: [4096]u8 = []
  key := c.string_from_bytes(storage[..], name)
  if !key.ok { return EnvironmentResult{error: -28, kind: errors.Kind.Capacity} }
  value := host_environment(key.value)
  if value == nil { return EnvironmentResult{value: destination[..0], ok: true} }
  if #len(destination) == ~#cast(usize) 0 { return EnvironmentResult{kind: errors.Kind.Overflow} }
  parsed := c.bytes_from_string(value, #len(destination) + 1)
  if !parsed.ok || #len(parsed.value) > #len(destination) {
    return EnvironmentResult{error: -28, kind: errors.Kind.Capacity}
  }
  _ = mem.copy(destination, parsed.value)
  return EnvironmentResult{value: destination[..#len(parsed.value)], found: true, ok: true}
}
fn native_arguments(arena: *mem.Arena) ArgumentsResult {
  count_pointer := host_argument_count()
  if count_pointer == nil || count_pointer.* < 0 { return ArgumentsResult{kind: errors.Kind.InvalidState} }
  count := #cast(usize) count_pointer.*
  if count == 0 { return ArgumentsResult{ok: true} }
  if count > (~#cast(usize) 0) / #sizeof([]const u8) { return ArgumentsResult{kind: errors.Kind.Overflow} }
  vector_pointer := host_argument_vector()
  if vector_pointer == nil || vector_pointer.* == nil { return ArgumentsResult{kind: errors.Kind.InvalidState} }
  slots := mem.arena_push_uninit(arena, count * #sizeof([]const u8), #alignof([]const u8))
  if !slots.ok { return ArgumentsResult{kind: errors.Kind.Capacity} }
  values := (#cast(*[]const u8) slots.memory)[..count]
  vector := vector_pointer.*[..count]
  for index in 0..count {
    source := vector[index]
    if source == nil { return ArgumentsResult{kind: errors.Kind.InvalidState} }
    size := host_argument_length(source)
    allocation := mem.arena_push_uninit(arena, size, 1)
    if !allocation.ok { return ArgumentsResult{kind: errors.Kind.Capacity} }
    destination := arena.data[..0]
    if size > 0 { destination = allocation.memory[..size] }
    _ = mem.copy(destination, source[..size])
    values[index] = destination
  }
  return ArgumentsResult{values: values, ok: true}
}
