#target(kernel: windows)
#link("ucrt")

extern fn job_duplicate "_strdup"(text: *const u8) *u8
fn pred_find(text: *const u8, length: usize, needle: *const u8, size: usize) rawptr {
  if size == 0 {
    return #cast(rawptr, text)
  }
  if size > length {
    return nil
  }
  for index in 0..=length - size {
    if text[..length][index] == needle.* && pred_compare(&text[..length][index], needle, size) == 0 {
      return #cast(rawptr, &text[..length][index])
    }
  }
  return nil
}
