// The real tree input handlers use the same configured actions as documents.
fn tree_usability_smoke(app:*App, typography:*Typography) {
  saved:=app.tree
  saved_panel:=app.prompt_state.panel
  saved_vim:=app.config.vim_keys
  saved_bindings:=app.config.bindings
  saved_binding_count:=app.config.binding_count
  defer {
    app.tree=saved
    app.prompt_state.panel=saved_panel
    app.config.vim_keys=saved_vim
    app.config.bindings=saved_bindings
    app.config.binding_count=saved_binding_count
  }
  app.tree=TreeState{}
  tree:=&app.tree
  names:[5][]const u8=["alpha.dyn", "Beta.dyn", "notes.txt", "beta_test.dyn", "éclair.dyn"]
  for i in 0..5 {
    tree.nodes[i]=TreeNode{offset:#cast(u32, tree.names_used), length:#cast(u16, #len(names[i]))}
    tree.names_used+=copy_text(tree.names[tree.names_used..], names[i])
  }
  tree.count=5
  tree.open=true
  tree.loaded=true
  app.prompt_state.panel=Panel.Tree
  app.config.vim_keys=false
  tree_key(app, typography, KeyJ, 0)
  if tree.selected!=1 {
    #panic("tree Helix navigation")
  }
  tree_key(app, typography, KeySlash, 0)
  if !wants_text_input(app) {
    #panic("tree search text input enabled")
  }
  text_input(app, "beta")
  if tree.selected!=1 || !tree.searching {
    #panic("tree incremental visible search")
  }
  key_input(app, typography, KeyDown, 0)
  if tree.selected!=3 || !tree.searching || !buffer.equal(tree.search[..tree.search_length], "beta") {
    #panic("tree search Down must navigate matching rows without leaving search")
  }
  key_input(app, typography, KeyUp, 0)
  if tree.selected!=1 {
    #panic("tree search Up must navigate previous match")
  }
  key_input(app, typography, KeyN, ModCtrl)
  if tree.selected!=3 {
    #panic("tree search Ctrl-N picker alias")
  }
  key_input(app, typography, KeyP, ModCtrl)
  if tree.selected!=1 {
    #panic("tree search Ctrl-P picker alias")
  }
  key_input(app, typography, KeyJ, ModCtrl)
  if tree.selected!=3 {
    #panic("tree search Ctrl-J picker alias")
  }
  key_input(app, typography, KeyK, ModCtrl)
  if tree.selected!=1 {
    #panic("tree search Ctrl-K picker alias")
  }
  key_input(app, typography, KeyUp, 0)
  if tree.selected!=3 {
    #panic("tree search previous match wraps")
  }
  key_input(app, typography, KeyDown, 0)
  if tree.selected!=1 {
    #panic("tree search next match wraps")
  }
  tree_key(app, typography, KeyReturn, 0)
  tree_key(app, typography, KeyN, 0)
  if tree.selected!=3 || tree.searching {
    #panic("tree next search match")
  }
  tree_key(app, typography, KeyN, ModShift)
  if tree.selected!=1 {
    #panic("tree previous search match")
  }
  tree_key(app, typography, KeySlash, 0)
  text_input(app, "é")
  if tree.selected!=4 || tree.search_length!=2 {
    #panic("tree Unicode search")
  }
  tree_key(app, typography, KeyBackspace, 0)
  if tree.search_length!=0 || tree.selected!=1 {
    #panic("tree Unicode backspace restores origin")
  }
  key_input(app, typography, KeyDown, 0)
  if tree.selected!=1 || !tree.searching {
    #panic("empty tree query navigation preserves origin")
  }
  text_input(app, "missing")
  if !tree.search_failed || tree.selected!=1 {
    #panic("tree missing search preserves selection")
  }
  key_input(app, typography, KeyDown, 0)
  if !tree.search_failed || tree.selected!=1 {
    #panic("missing tree match navigation preserves selection")
  }
  tree_key(app, typography, KeyEscape, 0)
  if tree.searching || app.prompt_state.panel!=Panel.Tree || tree.selected!=1 || !buffer.equal(tree.search[..tree.search_length], "beta") {
    #panic("tree search cancellation restores navigation")
  }
  app.config.vim_keys=true
  tree.selected=3
  tree_key(app, typography, KeyG, 0)
  if tree.selected!=3 {
    #panic("tree Vim g waits for prefix")
  }
  tree_key(app, typography, KeyG, 0)
  if tree.selected!=0 {
    #panic("tree Vim gg moves first")
  }
  tree_key(app, typography, KeyG, ModShift)
  if tree.selected!=4 {
    #panic("tree Vim G moves last")
  }
  tree_key(app, typography, '2', 0)
  tree_key(app, typography, KeyK, 0)
  if tree.selected!=2 {
    #panic("tree Vim counted movement")
  }
  app.config.bindings[0]=settings.Binding{key:KeyX, scope:1, command:"move-down"}
  app.config.bindings[1]=settings.Binding{key:KeyY, scope:1, command:"move-up"}
  app.config.binding_count=2
  if !configured_key(app, typography, KeyX, 0) || tree.selected!=3 {
    #panic("tree configured move down")
  }
  if !configured_key(app, typography, KeyY, 0) || tree.selected!=2 {
    #panic("tree configured move up")
  }
  tree_search_open(tree)
  text_input(app, "x")
  if configured_key(app, typography, KeyX, 0) || tree.search_length!=1 {
    #panic("tree query ignores normal bindings")
  }
  tree_search_cancel(tree)
}
