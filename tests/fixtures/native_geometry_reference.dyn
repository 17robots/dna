// Frozen full-clip raster reference for pixel-coverage differential tests.
fn sdl_geometry(renderer, texture:rawptr, vertices:*const Vertex, count:i32, indices:*const i32, index_count:i32) bool {
  if texture!=nil || count<0 || index_count<0 || index_count%3!=0 {
    return false
  }
  surface:=native_surface()
  clip:=native_clip(surface)
  for triangle in 0..index_count/3 {
    ia:=indices[..#cast(usize, index_count)][#cast(usize, triangle*3)]
    ib:=indices[..#cast(usize, index_count)][#cast(usize, triangle*3+1)]
    ic:=indices[..#cast(usize, index_count)][#cast(usize, triangle*3+2)]
    if ia<0 || ib<0 || ic<0 || ia>=count || ib>=count || ic>=count {
      return false
    }
    a:=vertices[..#cast(usize, count)][#cast(usize, ia)]
    b:=vertices[..#cast(usize, count)][#cast(usize, ib)]
    c:=vertices[..#cast(usize, count)][#cast(usize, ic)]
    a.x=a.x*native_gui.sx+#cast(f32, native_gui.viewport.x)
    a.y=a.y*native_gui.sy+#cast(f32, native_gui.viewport.y)
    b.x=b.x*native_gui.sx+#cast(f32, native_gui.viewport.x)
    b.y=b.y*native_gui.sy+#cast(f32, native_gui.viewport.y)
    c.x=c.x*native_gui.sx+#cast(f32, native_gui.viewport.x)
    c.y=c.y*native_gui.sy+#cast(f32, native_gui.viewport.y)
    area:=native_edge(a, b, c.x, c.y)
    if area<0.0 {
      temporary:=b
      b=c
      c=temporary
      area=0.0-area
    }
    if area==0.0 {
      continue
    }
    for y in clip.y..clip.y+clip.height {
      for x in clip.x..clip.x+clip.width {
        wa:=native_edge(b, c, #cast(f32, x)+0.5, #cast(f32, y)+0.5)/area
        wb:=native_edge(c, a, #cast(f32, x)+0.5, #cast(f32, y)+0.5)/area
        wc:=1.0-wa-wb
        if (wa>0.0 || (wa==0.0 && native_top_left(b, c))) && (wb>0.0 || (wb==0.0 && native_top_left(c, a))) && (wc>0.0 || (wc==0.0 && native_top_left(a, b))) {
          native_blend(&surface, x, y, #cast(u8, (a.red*wa+b.red*wb+c.red*wc)*255.0), #cast(u8, (a.green*wa+b.green*wb+c.green*wc)*255.0), #cast(u8, (a.blue*wa+b.blue*wb+c.blue*wc)*255.0), #cast(u8, (a.alpha*wa+b.alpha*wb+c.alpha*wc)*255.0))
        }
      }
    }
  }
  return true
}
