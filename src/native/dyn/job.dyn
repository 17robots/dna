// Input text as runs the caller keeps alive until the job closes.
pub struct JobChunk { bytes: *const u8, length: usize }
// Formatter output limit; the buffer is mapped lazily, so only the bytes
// written occupy memory.
const JobOutputLimit: usize = 4294967296
struct JobWorker {
  thread: rawptr,
  chunks: *JobChunk,
  chunk_count: usize,
  lock: rawptr,
  status: i32,
  stop: bool,
  command: *u8,
  directory: *u8,
  input: *u8,
  output: *u8,
  timeout: u32,
  errors: [4096]u8,
  length: usize,
  used: usize,
  error_length: usize,
}

// Caller owns the handle. The worker owns process IO and publishes immutable
// results under the mutex. close requests cancellation, joins, then releases.
extern fn job_duplicate "strdup"(text: *const u8) *u8

fn job_stopped(job: *JobWorker) bool {
  rec_lock(job.lock)
  stopped := job.stop
  rec_unlock(job.lock)
  return stopped
}
fn job_run(context: rawptr) i32 {
  job := #cast(*JobWorker, context)
  child := proc_open(job.command, job.directory, true)
  status: i32 = 3
  sent: usize = 0
  deadline := proc_ticks() + #cast(u64, job.timeout)
  exited: i32 = 0
  for child.pid > 0 {
    if job_stopped(job) {
      status = 6
      break
    }
    if proc_ticks() >= deadline {
      status = 5
      break
    }
    if child.input >= 0 && sent == job.length {
      _ = rec_close(child.input)
      child.input = -1
    }
    if exited > 0 && child.output < 0 && child.error < 0 {
      status = 3
      if exited == 1 {
        status = 2
      }
      break
    }
    descriptors: [3]PollDescriptor = [PollDescriptor{fd: child.input, events: 4}, PollDescriptor{fd: child.output, events: 1}, PollDescriptor{fd: child.error, events: 1}]
    ready := proc_poll(&descriptors[0], 3, 20)
    if ready < 0 && rec_errno().* != 4 {
      break
    }
    if child.input >= 0 && (descriptors[0].returned & 28) != 0 {
      amount := job.length - sent
      if amount > 65536 {
        amount = 65536
      }
      source: *const u8 = nil
      if job.chunks != nil {
        // Find the chunk holding sent; chunks are few relative to writes.
        base: usize = 0
        for index in 0..job.chunk_count {
          chunk := job.chunks[..job.chunk_count][index]
          if sent < base + chunk.length {
            source = &chunk.bytes[..chunk.length][sent - base]
            if amount > base + chunk.length - sent {
              amount = base + chunk.length - sent
            }
            break
          }
          base += chunk.length
        }
      } else {
        source = &job.input[..job.length + 1][sent]
      }
      written := proc_write(child.input, source, amount)
      if written > 0 {
        sent += #cast(usize, written)
      }
      else if written < 0 && written != -11 && written != -4 {
        _ = rec_close(child.input)
        child.input = -1
      }
    }
    for stream in 1..3 {
      descriptor := &child.output
      if stream == 2 {
        descriptor = &child.error
      }
      if descriptor.* >= 0 && descriptors[stream].returned != 0 {
        bytes: [16384]u8 = []
        received := proc_read(descriptor.*, &bytes[0], 16384)
        if received == 0 || (received < 0 && received != -11 && received != -4) {
          _ = rec_close(descriptor.*)
          descriptor.* = -1
        }
        else if received > 0 {
          amount_read := #cast(usize, received)
          if stream == 1 {
            if amount_read > JobOutputLimit - 1 - job.used {
              status = 4
              break
            }
            _ = copy(&job.output[..JobOutputLimit][job.used], &bytes[0], amount_read)
            job.used += amount_read
          } else {
            proc_log(job.errors[..], &job.error_length, bytes[..amount_read])
          }
        }
      }
    }
    if status == 4 {
      break
    }
    if exited == 0 {
      exited = proc_peek(&child)
      if exited < 0 {
        break
      }
    }
  }
  proc_close(&child)
  job.output[..JobOutputLimit][job.used] = 0
  rec_lock(job.lock)
  job.status = status
  rec_unlock(job.lock)
  rec_notify()
  return 0
}
fn job_free(job: *JobWorker) {
  rec_free(#cast(rawptr, job.command))
  rec_free(#cast(rawptr, job.directory))
  rec_free(#cast(rawptr, job.input))
  rec_free(#cast(rawptr, job.chunks))
  rec_free(#cast(rawptr, job.output))
  if job.lock != nil {
    rec_mutex_free(job.lock)
  }
  rec_free(#cast(rawptr, job))
}
pub fn dna_job_open(command: *const u8, directory: *const u8, input: *const u8, length: usize, timeout: u32) *JobWorker {
  if length > 268435455 || (length > 0 && input == nil) {
    return nil
  }
  return job_open(command, directory, input, nil, 0, length, timeout)
}
// Like dna_job_open, with input as runs read in place: the caller keeps
// them alive until dna_job_close.
pub fn dna_job_open_chunks(command: *const u8, directory: *const u8, chunks: *const JobChunk, count: usize, length: usize, timeout: u32) *JobWorker {
  if count > 0 && chunks == nil {
    return nil
  }
  return job_open(command, directory, nil, chunks, count, length, timeout)
}
fn job_open(command: *const u8, directory: *const u8, input: *const u8, chunks: *const JobChunk, count: usize, length: usize, timeout: u32) *JobWorker {
  if command == nil || command.* == 0 || directory == nil || directory.* != 47 || timeout == 0 {
    return nil
  }
  job := #cast(*JobWorker, rec_alloc(1, #sizeof(JobWorker)))
  if job == nil {
    return nil
  }
  job.command = job_duplicate(command)
  job.directory = job_duplicate(directory)
  if chunks != nil {
    job.chunks = #cast(*JobChunk, rec_malloc(count * #sizeof(JobChunk) + 1))
    if job.chunks != nil && count > 0 {
      _ = copy(#cast(*u8, job.chunks), #cast(*const u8, chunks), count * #sizeof(JobChunk))
    }
    job.chunk_count = count
    job.input = rec_malloc(1)
  } else {
    job.input = rec_malloc(length + 1)
  }
  job.output = rec_malloc(JobOutputLimit)
  job.lock = rec_mutex()
  job.length = length
  job.timeout = timeout
  job.status = 1
  if job.command == nil || job.directory == nil || job.input == nil || job.output == nil || job.lock == nil || (chunks != nil && job.chunks == nil) {
    job_free(job)
    return nil
  }
  if length > 0 && chunks == nil {
    _ = copy(job.input, input, length)
  }
  job.thread = rec_thread(job_run, #cast(rawptr, job))
  if job.thread == nil {
    job_free(job)
    return nil
  }
  return job
}
pub fn dna_job_status(job: *JobWorker) i32 {
  if job == nil {
    return 0
  }
  rec_lock(job.lock)
  status := job.status
  rec_unlock(job.lock)
  return status
}
pub fn dna_job_output(job: *JobWorker, output: *u8, capacity: usize) usize {
  if job == nil || output == nil || dna_job_status(job) == 1 || job.used + 1 > capacity {
    return 0
  }
  _ = copy(output, job.output, job.used + 1)
  return job.used
}
// Output length once finished, or -1 while running.
pub fn dna_job_output_length(job: *JobWorker) isize {
  if job == nil || dna_job_status(job) == 1 {
    return -1
  }
  return #cast(isize, job.used)
}
pub fn dna_job_error(job: *JobWorker, output: *u8, capacity: usize) usize {
  if job == nil || output == nil || capacity == 0 || dna_job_status(job) == 1 {
    return 0
  }
  length := job.error_length
  if length >= capacity {
    length = capacity - 1
  }
  _ = copy(output, &job.errors[0], length)
  output[..capacity][length] = 0
  return length
}
pub fn dna_job_close(job: *JobWorker) {
  if job == nil {
    return
  }
  rec_lock(job.lock)
  job.stop = true
  rec_unlock(job.lock)
  rec_join(job.thread, nil)
  job_free(job)
}
