pub struct Language {
  server: [1024]u8,
  formatter: [1024]u8,
  extensions: [256]u8,
  name: [65]u8,
  name_length: usize,
  indent_width: usize,
  server_length: usize,
  formatter_length: usize,
  extensions_length: usize,
  insert_tabs: bool,
  format_on_save: bool,
  auto_start: bool,
  seen: u32,
}

fn store(output: []u8, text: str) bool {
  if text.len >= output.len { return false }
  index: usize = 0
  for byte in text {
    if byte == 0 || byte == 10 || byte == 13 { return false }
    output[index] = byte
    index += 1
  }
  output[index] = 0
  return true
}
fn language_section(result: *Settings, section: str) usize {
  name := section[10..]
  if name.len == 0 || name.len > 64 { return 16 }
  for byte in name {
    if !((byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 95) { return 16 }
  }
  index: usize = 0
  for index < result.language_count {
    item := &result.languages[index]
    if buffer.equal(item.name[..item.name_length], name) { return index }
    index += 1
  }
  if index == 16 { return 16 }
  added := &result.languages[index]
  _ = store(added.name[..], name)
  added.name_length = name.len
  result.language_count += 1
  return index
}
fn language_apply(language: *Language, key: str, text: str) bool {
  bit: u32 = 0
  case key {
    "indent_width" => {
      value := number(text)
      if value < 1.0 || value > 16.0 || #cast(f32, (#cast(usize, value))) != value { return false }
      bit = 1
      language.indent_width = #cast(usize, value)
    }
    "insert_tabs", "format_on_save", "auto_start" => {
      flag := buffer.equal(text, "true")
      if !flag && !buffer.equal(text, "false") { return false }
      if buffer.equal(key, "insert_tabs") {
        bit = 2
        language.insert_tabs = flag
      } else if buffer.equal(key, "format_on_save") {
        bit = 4
        language.format_on_save = flag
      } else {
        bit = 8
        language.auto_start = flag
      }
    }
    _ => {
      if text.len < 2 || text[0] != 34 || text[text.len - 1] != 34 { return false }
      content := text[1..text.len - 1]
      if buffer.equal(key, "server") {
        bit = 16
        if !store(language.server[..], content) { return false }
        language.server_length = content.len
      } else if buffer.equal(key, "formatter") {
        bit = 32
        if !store(language.formatter[..], content) { return false }
        language.formatter_length = content.len
      } else if buffer.equal(key, "extensions") {
        bit = 64
        if !store(language.extensions[..], content) { return false }
        language.extensions_length = content.len
      } else {
        return false
      }
    }
  }
  if (language.seen & bit) != 0 { return false }
  language.seen = language.seen | bit
  return true
}
pub fn language(result: *const Settings, name: str) *const Language {
  for index in 0..result.language_count {
    item := &result.languages[index]
    if buffer.equal(item.name[..item.name_length], name) { return item }
  }
  return nil
}
