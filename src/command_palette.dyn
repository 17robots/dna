fn command_name(app: *App, id: usize) str {
  if id >= PaletteRowBase { return palette_row_label(app, id - PaletteRowBase) }
  if id < BuiltinCommands { return command_info(id).label }
  if id >= PluginCommandBase && id < PluginCommandBase + app.plugin_state.command_count {
    entry := &app.plugin_state.commands[id - PluginCommandBase]
    if entry.length == 0 { return "" }
    return entry.label[..entry.label_length]
  }
  return ""
}
// Labels pad a shortcut after the title with two or more spaces.
fn command_title(label: str) str {
  end: usize = 0
  for end + 1 < label.len && !(label[end] == ' ' && label[end + 1] == ' ') {
    end += 1
  }
  if end + 1 >= label.len { return label }
  return label[..end]
}
fn command_shortcut(label: str) str {
  at := command_title(label).len
  for at < label.len && label[at] == ' ' {
    at += 1
  }
  return label[at..]
}
fn command_alias(id: usize, query: str) bool {
  if id >= BuiltinCommands || query.len == 0 { return false }
  aliases := command_info(id).aliases
  at: usize = 0
  for at < aliases.len {
    end := at
    for end < aliases.len && aliases[end] != '|' {
      end += 1
    }
    if buffer.equal(query, aliases[at..end]) { return true }
    at = end + 1
  }
  return false
}
fn matches(app: *App) {
  if !app.command_menu.cached || app.command_menu.context != app.explorer.commands || !buffer.equal(app.command_menu.query[..app.command_menu.query_length], app.prompt_state.text[..app.prompt_state.length]) {
    app.command_menu.count = 0
    app.command_menu.filter_runs += 1
    app.command_menu.query_length = copy_text(app.command_menu.query[..], app.prompt_state.text[..app.prompt_state.length])
    app.command_menu.cached = true
    app.command_menu.context = app.explorer.commands
    app.command_menu.row_count = 0
    app.command_menu.pool_used = 0
    app.command_menu.arguments = false
    // Fuzzy rank once per query; ties keep declaration order.
    query := app.prompt_state.text[..app.prompt_state.length]
    scores: [512]i32
    plain := !app.explorer.commands && !app.terminal_state.commands
    // Argument suggestions rank first; commands whose titles match the whole
    // query ("write explorer") still follow them.
    arguments := plain && palette_arguments(app, query, scores[..])
    for index in 0..PluginCommandBase + app.plugin_state.command_count {
      if app.explorer.commands && index != 5 && index != 6 && index != 16 && (index < 29 || index > 31) {
        continue
      }
      name := command_name(app, index)
      if name.len == 0 || (index < BuiltinCommands && !command_available(index) && !command_alias(index, query)) {
        continue
      }
      score := fuzzy_score(command_title(name), query)
      // Rows whose words start with the typed words come first: they are
      // the rows Enter runs.
      if score >= 0 && word_prefix_match(command_title(name), query) {
        score += 100000
      }
      if command_alias(index, query) {
        score = 1000000
      }
      if query.len == 0 {
        score += palette_recent_rank(app, index)
      }
      if score >= 0 {
        menu_insert(app, scores[..], index, score)
      }
    }
    if plain && !arguments {
      palette_option_rows(app, query, scores[..])
    }
  }
  app.prompt_state.match_count = app.command_menu.count
  for copied in 0..app.prompt_state.match_count {
    app.prompt_state.matches[copied] = app.command_menu.ids[copied]
  }
  if app.prompt_state.selected >= app.prompt_state.match_count {
    app.prompt_state.selected = 0
  }
}
// Built with the immediate-mode UI each drawn frame. Rows are keyed by
// command, so hover and selection fades follow a command as results reorder.
fn draw_command_palette(renderer: rawptr, app: *App, typography: *Typography, width: i32, height: i32) {
  matches(app)
  ui := &app.ui
  ui_panel_begin(ui, typography)
  scale := typography.scale
  line := typography.line
  count := app.prompt_state.match_count
  selected := app.prompt_state.selected
  rows: usize = 12
  room := (#cast(f32, height) * 0.7) / line - 2.0
  if room < 1.0 {
    rows = 1
  } else if #cast(usize, room) < rows {
    rows = #cast(usize, room)
  }
  shown := count
  if shown > rows {
    shown = rows
  }
  if shown == 0 {
    shown = 1
  }
  box_width := 680.0 * scale
  if box_width > #cast(f32, width) * 0.92 {
    box_width = #cast(f32, width) * 0.92
  }
  opening := app.view.animation.panel != .Commands
  // The palette's height follows its rows; placement uses that estimate.
  natural := platform.Rect{x: (#cast(f32, width) - box_width) / 2.0, y: #cast(f32, height) * 0.1, width: box_width, height: #cast(f32, (shown + 2)) * line + 20.0 * scale}
  if app.config.picker_style == .Dropdown {
    natural = picker_dropdown_rect(width, natural.height, scale)
  }
  target_rect := place_rect(app, SurfacePalette, width, height, 0.0, scale, natural)
  placed := animated_surface(app, SurfacePalette, target_rect, scale)
  minimum := line * 2.0 + 30.0 * scale
  if minimum > target_rect.height {
    minimum = target_rect.height
  }
  if placed.height < minimum {
    placed.height = minimum
    placed.y = target_rect.y + (target_rect.height - minimum) * 0.5
  }
  placed_rects[SurfacePalette] = placed
  available := placed.height - line - 30.0 * scale
  visible: usize = 1
  if available > line {
    visible = #cast(usize, available / line)
  }
  if shown > visible {
    shown = visible
  }
  viewport_changed := ui.palette_rows != shown
  box_width = placed.width
  palette := ui_make(ui, ui_hash(0, "palette"), UiFloating | UiBackground | UiBorder | UiClip)
  ui.boxes[palette].floating[0] = placed.x
  ui.boxes[palette].floating[1] = placed.y
  ui.boxes[palette].fill = theme().surface
  ui.boxes[palette].padding[0] = 10.0 * scale
  ui.boxes[palette].padding[1] = 10.0 * scale
  ui_size(ui, palette, UiAxisX, .Pixels, box_width / scale, 1.0)
  ui_size(ui, palette, UiAxisY, .Pixels, placed.height / scale, 1.0)
  ui_push(ui, palette)
  field := ui_make(ui, ui_key(ui, "field"), UiBackground)
  ui.boxes[field].axis = UiAxisX
  ui.boxes[field].fill = theme().line
  ui.boxes[field].padding[0] = typography.cell * 0.5
  ui_size(ui, field, UiAxisX, .Percent, 1.0, 1.0)
  ui_push(ui, field)
  query: [4200]u8
  query_length: usize = 0
  add_text(query[..], &query_length, "> ")
  add_text(query[..], &query_length, app.prompt_state.text[..app.prompt_state.length])
  add_text(query[..], &query_length, "_")
  _ = ui_label(ui, "query", query[..query_length], 0)
  if app.prompt_state.length == 0 {
    hint: str = "Type a command or :name args"
    if app.prompt_state.history_count > 0 {
      hint = "Up/Down history; Ctrl-N/P suggestions; Tab completes"
    }
    if app.explorer.commands {
      hint = "Explorer commands"
    }
    _ = ui_label(ui, "hint", hint, UiMuted)
  }
  ui_pop(ui)
  gap := ui_make(ui, ui_key(ui, "gap"), 0)
  ui_size(ui, gap, UiAxisY, .Pixels, 10.0, 1.0)
  list := ui_make(ui, ui_key(ui, "list"), UiClip | UiScroll)
  ui_size(ui, list, UiAxisX, .Percent, 1.0, 1.0)
  ui_size(ui, list, UiAxisY, .Pixels, line * #cast(f32, shown) / scale, 1.0)
  changed := ui.palette_query != app.command_menu.filter_runs
  ui_list_scroll(app, ui, list, count, selected, line * #cast(f32, shown), opening || changed, opening || changed || viewport_changed || selected != ui.palette_selected)
  if viewport_changed {
    motion.snap(&ui.boxes[list].scroll, ui.boxes[list].scroll_target)
  }
  window := ui_list_window(ui, list, count, line * #cast(f32, shown))
  // An empty query lists commands to browse; a typed one highlights a row only
  // when Enter would run it.
  highlight := app.prompt_state.length == 0 || app.command_menu.arguments || palette_row_runs(app, selected)
  ui_push(ui, list)
  ui_spacer(ui, "above", #cast(f32, window.first) * line)
  for row in window.first..window.last {
    id := app.prompt_state.matches[row]
    name := command_name(app, id)
    item := ui_make(ui, ui_hash_number(ui.boxes[list].key, id), UiClickable | UiHover)
    ui.boxes[item].axis = UiAxisX
    ui.boxes[item].value = row
    ui.boxes[item].padding[0] = typography.cell
    ui_size(ui, item, UiAxisX, .Percent, 1.0, 1.0)
    ui_size(ui, item, UiAxisY, .Pixels, line / scale, 1.0)
    ui_push(ui, item)
    title := ui_label(ui, "title", command_title(name), 0)
    // The title yields space so a shortcut stays readable on narrow windows.
    ui_size(ui, title, UiAxisX, .Percent, 1.0, 0.0)
    shortcut := command_shortcut(name)
    if shortcut.len > 0 {
      _ = ui_label(ui, "shortcut", shortcut, UiMuted)
    }
    ui_pop(ui)
    ui_animate(app, ui, item, row == selected && highlight)
  }
  ui_spacer(ui, "below", #cast(f32, (count - window.last)) * line)
  if count == 0 {
    nothing: str = "No matching commands"
    if app.command_menu.arguments {
      nothing = "No suggestions; Enter runs it as typed"
    }
    empty := ui_label(ui, "empty", nothing, UiMuted)
    ui.boxes[empty].padding[0] = typography.cell
  }
  ui_pop(ui)
  ui_pop(ui)
  // Keyboard moves keep the selection visible; the wheel scrolls freely.
  // Either way the list glides to its new offset.
  ui.palette_selected = selected
  ui.palette_rows = shown
  ui.palette_query = app.command_menu.filter_runs
  ui_layout(ui)
  ui_render(renderer, ui, typography, width, height)
}
// Mouse input for the palette, hit-tested against the last drawn frame.
// Returns true when the event was consumed.
fn command_palette_mouse(app: *App, typography: *Typography, x: f32, y: f32, pressed: bool, moved: bool) bool {
  ui := &app.ui
  if moved {
    ui_pointer(ui, x, y)
    return true
  }
  if !pressed { return true }
  hit := ui_hit(ui, x, y)
  if hit == 0 {
    palette := ui_make_lookup(ui, ui_hash(0, "palette"))
    if palette == 0 || !ui_contains(ui.boxes[palette].rect, x, y) {
      // Clicking outside dismisses the palette, like Escape.
      key_input(app, typography, KeyEscape, 0)
    }
    return true
  }
  row := ui.boxes[hit].value
  if row >= app.prompt_state.match_count { return true }
  app.prompt_state.selected = row
  command_run(app, typography, app.prompt_state.matches[row])
  return true
}

fn palette_recent_rank(app: *const App, id: usize) i32 {
  menu := &app.command_menu
  for index in 0..menu.recent_count {
    if menu.recent[index] == id { return #cast(i32, (8 - index) * 10) }
  }
  return 0
}
fn palette_recent_push(app: *App, id: usize) {
  menu := &app.command_menu
  found := menu.recent_count
  for index in 0..menu.recent_count {
    if menu.recent[index] == id {
      found = index
    }
  }
  if found == menu.recent_count && menu.recent_count < 8 {
    menu.recent_count += 1
  }
  if found == 8 {
    found = 7
  }
  at := found
  for at > 0 {
    menu.recent[at] = menu.recent[at - 1]
    at -= 1
  }
  menu.recent[0] = id
  menu.cached = false
}
fn run_command(app: *App, typography: *Typography, cmd: Command) {
  action(app, typography, command_id(cmd))
}
fn action(app: *App, typography: *Typography, id: usize) {
  if id < PaletteRowBase {
    palette_recent_push(app, id)
  }
  if id >= PaletteRowBase {
    palette_row_choose(app, typography, id - PaletteRowBase, false)
    return
  }
  if id >= PluginCommandBase {
    app.prompt_state.panel = .None
    plugin_run_command(app, id - PluginCommandBase)
    return
  }
  if id >= BuiltinCommands { return }
  // Commands that need an argument type their name into the palette, where
  // suggestions for it appear.
  if command_info(id).arguments.len > 0 && command_info(id).arguments[0] == '!' {
    palette_prefill(app, command_primary(id))
    return
  }
  cmd := command_from_id(id)
  case cmd {
    .FormatCancel => {
      format_release(app)
      save_cancel(app)
      app.prompt_state.panel = .None
      return
    }
    .SaveClose => {
      save_close(app)
      return
    }
    .SaveAll => {
      save_all(app, false)
      return
    }
    .SaveAllQuit => {
      save_all(app, true)
      return
    }
    .TrustProject => {
      trust_project(app, typography)
      return
    }
    .ConfigSources => {
      config_sources(app)
      return
    }
    .ShowModules => {
      modules_report(app)
      return
    }
    .FileCreate, .FileRename, .FileTrash => {
      if explorer_dirty(app) {
        notice(app, "Apply or discard staged explorer edits before using individual file actions.")
        return
      }
    }
    _ => {}
  }
  app.prompt_state.panel = .None
  case cmd {
    .OpenFile => {
      app.resource_state.kind = .None
      app.resource_state.fonts = false
      panel(app, .Open)
    }
    .Write => {
      if app.documents.file.length == 0 {
        panel(app, .SaveAs)
      } else {
        save_file(app, files.name(app.documents.file))
      }
    }
    .SaveAs => {
      panel(app, .SaveAs)
      app.prompt_state.length = copy_text(app.prompt_state.text[..], files.name(app.documents.file))
    }
    .Search => { search_open(app, .Search, false) }
    .FindNext => { search_repeat(app, false, false) }
    .Undo => { buffer.undo(app.documents.current) }
    .Redo => { buffer.redo(app.documents.current) }
    .Explorer => { explorer_open(app) }
    .LayoutLoad => { panel(app, .Layout) }
    .LayoutCompact => {
      app.view.popup_width = 0.64
      app.view.popup_height = 0.56
    }
    .LayoutWide => {
      app.view.popup_width = 0.86
      app.view.popup_height = 0.8
    }
    .ZoomIn => {
      if typography.points < 72.0 {
        typography.points += 1.0
      }
      resize_font(typography)
    }
    .ZoomOut => {
      if typography.points > 8.0 {
        typography.points -= 1.0
      }
      resize_font(typography)
    }
    .ZoomReset => {
      typography.points = app.config.font_size
      resize_font(typography)
    }
    .Recover => {
      error := files.recover(app.documents.file, app.documents.current, app.scratch)
      if error.len > 0 {
        notice(app, error)
      }
    }
    .DiscardChanges => {
      panel(app, .Message)
      app.prompt_state.message_length = copy_text(app.prompt_state.message[..], "Discard edits? Press D to discard, or Escape to cancel.")
      app.prompt_state.selected = DiscardConfirmId
    }
    .QuitAll => { request_quit(app) }
    .NewBuffer => { _ = new_buffer(app) }
    .FileCreate => { directory_file_op(app, .Create) }
    .FileRename => { directory_file_op(app, .Rename) }
    .FileTrash => { directory_file_op(app, .Trash) }
    .Buffers => { panel(app, .Buffers) }
    .NextBuffer => { next_buffer(app, false) }
    .PrevBuffer => { next_buffer(app, true) }
    .CloseBuffer => { quit_view(app) }
    .ToggleLineNumbers => { app.view.line_numbers = !app.view.line_numbers }
    .ToggleStatusLine => { app.view.status_line = !app.view.status_line }
    .ToggleRelativeNums => { app.view.relative_numbers = !app.view.relative_numbers }
    .ToggleHighlightLine => { app.view.highlight_line = !app.view.highlight_line }
    .ExplorerWrite => { explorer_preview(app) }
    .ExplorerDiscard => {
      app.explorer.quit_after_discard = false
      panel(app, .DirectoryDiscard)
    }
    .ExplorerRefresh => {
      directory_refresh(app)
      if app.prompt_state.panel != .Message {
        app.prompt_state.panel = .Directory
      }
    }
    .VSplit => { pane_split(app, true) }
    .HSplit => { pane_split(app, false) }
    .WindowClose => { pane_close(app) }
    .WindowOnly => { pane_only(app) }
    .TerminalPopup => { terminal_show(app, false, "") }
    .TerminalNew => { terminal_show(app, true, "") }
    .TerminalSplit => { terminal_promote(app) }
    .ConfigReload => { config_reload(app, typography, false) }
    .ConfigEdit => { open_file(app, app.configuration.path[..app.configuration.path_length]) }
    .ProjectDirectory => { notice(app, app.workspace.project[..app.workspace.project_length]) }
    .ChooseFont => { font_picker(app) }
    .ManageLanguages => { language_manager_open(app) }
    .ReloadLanguages => { syntax_release(app) }
    .TaskBuild => { run_task(app, app.config.build_command) }
    .TaskTest => { run_task(app, app.config.test_command) }
    .TaskRun => { run_task(app, app.config.run_command) }
    .TaskNextError => { task_next_error(app) }
    .VNew => { pane_new(app, true) }
    .HNew => { pane_new(app, false) }
    .GlobalSearch => { project_search_open(app) }
    .ChooseTheme => { resource_picker(app, .Themes) }
    .ChooseLayout => { resource_picker(app, .Layouts) }
    .FindSetting => { resource_picker(app, .Settings) }
    .EqualizePanes => { pane_equalize(app) }
    .SessionSave => { _ = session_save(app, "") }
    .SessionLoad => { _ = session_restore(app, "") }
    .PluginLog => { notice(app, app.plugin_state.log[..app.plugin_state.log_length]) }
    .PluginsDisable => { plugin_release(app) }
    .TaskDiagnostics => { task_picker(app) }
    .TaskPrevError => { task_previous_error(app) }
    .Recoveries => { resource_picker(app, .Recovery) }
    .PluginList => { plugin_list(app) }
    .LspComplete => { lsp_request(app, .Completion, "") }
    .LspHover => { lsp_request(app, .Hover, "") }
    .LspDefinition => { lsp_request(app, .Definition, "") }
    .LspReferences => { lsp_request(app, .References, "") }
    .LspRenameSymbol => { lsp_request(app, .Rename, "") }
    .LspCodeActions => { lsp_request(app, .CodeAction, "") }
    .LspDiagnostics => { diagnostics_show(app) }
    .LspConfig => { lsp_config(app) }
    .LspRestart => { _ = lsp_command(app, "lsp-restart", "") }
    .LspLog => { notice(app, app.lsp.log[..app.lsp.log_length]) }
    .LspStop => { lsp_release(app) }
    .DiskReload => { disk_reload(app, false) }
    .WindowsMenu => { panel(app, .Windows) }
    .GotoMenu => {
      app.input_state.goto_explorer = app.input_state.leader_explorer
      panel(app, .Goto)
    }
    .CommandsMenu => {
      app.explorer.commands = app.input_state.leader_explorer
      panel(app, .Commands)
    }
    .BufferDelete => { request_buffer_close(app) }
    .Suspend => { suspend_command(app) }
    .ToggleComment => { comment_toggle(app) }
    .FormatDocument => { format_start(app, false, "") }
    .FileSymbols => { lsp_symbols_open(app, .DocumentSymbol) }
    .WorkspaceSymbols => { lsp_symbols_open(app, .WorkspaceSymbol) }
    .TreeFocus => {
      if app.config.explorer_style == .Tree {
        tree_focus(app)
      } else {
        explorer_open(app)
      }
    }
    _ => {}
  }
}
// Commands the explorer palette offers; false for anything else.
fn explorer_command(app: *App, typography: *Typography, chosen: usize) bool {
  if chosen >= BuiltinCommands { return false }
  case command_from_id(chosen) {
    .ExplorerWrite, .ExplorerDiscard, .ExplorerRefresh => {
      action(app, typography, chosen)
      return true
    }
    .Undo => {
      buffer.undo(app.explorer.document)
      app.prompt_state.panel = .Directory
      return true
    }
    .Redo => {
      buffer.redo(app.explorer.document)
      app.prompt_state.panel = .Directory
      return true
    }
    .QuitAll => {
      app.prompt_state.panel = .None
      return true
    }
    _ => { return false }
  }
}
// Runs a palette row directly, as when it is clicked.
// Enter runs the highlighted row only when it was picked, or when the typed
// words start words of its title. Otherwise Enter reports an unknown command.
fn palette_row_runs(app: *App, row: usize) bool {
  if row >= app.prompt_state.match_count { return false }
  if palette_picked(app) { return true }
  query := app.prompt_state.text[..app.prompt_state.length]
  return word_prefix_match(command_title(command_name(app, app.prompt_state.matches[row])), query)
}
fn command_run(app: *App, typography: *Typography, id: usize) {
  app.terminal_state.commands = false
  if app.explorer.commands {
    app.explorer.commands = false
    _ = explorer_command(app, typography, id)
    return
  }
  action(app, typography, id)
}
