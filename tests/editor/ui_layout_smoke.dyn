// Golden geometry for DNA's indexed-widget adapter over std/ui/box. These
// assertions describe panel behavior independently of either solver's passes.
fn ui_layout_smoke() {
  owned := arena_owner.create(#sizeof(UiState) + 128)
  defer arena_owner.release(owned)
  ui := mem.push(UiState, owned)
  defer ui_release(ui)
  typography := Typography{}
  typography.scale = 1.0
  typography.cell = 8.0
  typography.line = 16.0
  ui_begin(ui, &typography)
  root := ui_make(ui, ui_hash(0, "geometry"), UiFloating)
  ui.boxes[root].floating = [100.0, 50.0]
  ui.boxes[root].padding = [10.0, 10.0]
  ui_size(ui, root, UiAxisX, UiSizeKind.Pixels, 200.0, 1.0)
  ui_size(ui, root, UiAxisY, UiSizeKind.Pixels, 120.0, 1.0)
  ui_push(ui, root)
  header := ui_label(ui, "header", "abc", UiClickable)
  ui.boxes[header].padding = [2.0, 2.0]
  list := ui_make(ui, ui_key(ui, "list"), UiScroll | UiClip)
  ui_size(ui, list, UiAxisX, UiSizeKind.Percent, 1.0, 1.0)
  ui_size(ui, list, UiAxisY, UiSizeKind.Percent, 1.0, 0.0)
  motion.snap(&ui.boxes[list].scroll, 15.0)
  ui.boxes[list].scroll_target = 15.0
  ui_push(ui, list)
  row := ui_make(ui, ui_key(ui, "row"), UiClickable)
  ui_size(ui, row, UiAxisX, UiSizeKind.Percent, 1.0, 1.0)
  ui_size(ui, row, UiAxisY, UiSizeKind.Pixels, 50.0, 1.0)
  second := ui_make(ui, ui_key(ui, "row"), UiClickable)
  ui_size(ui, second, UiAxisX, UiSizeKind.Percent, 1.0, 1.0)
  ui_size(ui, second, UiAxisY, UiSizeKind.Pixels, 50.0, 1.0)
  ui_pop(ui)
  footer := ui_make(ui, ui_key(ui, "footer"), 0)
  ui_size(ui, footer, UiAxisX, UiSizeKind.Percent, 1.0, 0.0)
  ui_size(ui, footer, UiAxisY, UiSizeKind.Pixels, 20.0, 1.0)
  floating := ui_make(ui, ui_key(ui, "floating"), UiFloating)
  ui.boxes[floating].floating = [300.0, 400.0]
  ui_size(ui, floating, UiAxisX, UiSizeKind.Pixels, 12.0, 1.0)
  ui_size(ui, floating, UiAxisY, UiSizeKind.Pixels, 12.0, 1.0)
  ui_pop(ui)
  ui_layout(ui)
  if ui.boxes[root].rect.x != 100.0 || ui.boxes[root].rect.y != 50.0 || ui.boxes[root].rect.width != 200.0 || ui.boxes[root].rect.height != 120.0 {
    #panic("shared layout absolute panel")
  }
  if ui.boxes[header].rect.x != 110.0 || ui.boxes[header].rect.y != 60.0 || ui.boxes[header].rect.width != 28.0 || ui.boxes[header].rect.height != 20.0 {
    #panic("shared layout padded text")
  }
  if ui.boxes[list].rect.x != 110.0 || ui.boxes[list].rect.y != 80.0 || ui.boxes[list].rect.width != 180.0 || ui.boxes[list].rect.height != 60.0 || ui.boxes[footer].rect.y != 140.0 {
    #panic("shared layout flexible list keeps footer")
  }
  if ui.boxes[row].rect.y != 65.0 || ui.boxes[second].rect.y != 115.0 || ui.boxes[list].content != 100.0 || ui.boxes[row].key == ui.boxes[second].key {
    #panic("shared layout scroll and repeated labels")
  }
  if ui.boxes[floating].rect.x != 300.0 || ui.boxes[floating].rect.y != 400.0 {
    #panic("shared layout floating coordinates")
  }
  if ui_hit(ui, 120.0, 70.0) != header || ui_hit(ui, 120.0, 82.0) != row || ui_hit(ui, 120.0, 142.0) != 0 {
    #panic("shared layout clipped hit geometry")
  }
  // Multiple panels share a draw frame. Laying out a later top-level panel
  // must preserve the earlier panel's geometry and input regions.
  other := ui_make(ui, ui_hash(0, "other-panel"), UiFloating)
  ui.boxes[other].floating = [600.0, 200.0]
  ui_size(ui, other, UiAxisX, UiSizeKind.Pixels, 80.0, 1.0)
  ui_size(ui, other, UiAxisY, UiSizeKind.Pixels, 30.0, 1.0)
  ui_layout(ui)
  if ui.boxes[other].rect.x != 600.0 || ui.boxes[root].rect.x != 100.0 || ui.boxes[root].rect.width != 200.0 || ui.boxes[row].rect.y != 65.0 || ui_hit(ui, 120.0, 82.0) != row {
    #panic("shared layout preserves earlier panel")
  }

}
