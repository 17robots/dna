// Escape from completion has the same mode/cursor semantics as ordinary Escape.
fn completion_escape_smoke(app:*App, typography:*Typography) {
  doc:=app.documents.current
  for vim in 0..2 {
    app.config.vim_keys=vim!=0
    app.prompt_state.panel=Panel.None
    app.view.insert=true
    app.view.extend=false
    app.input_state.pending=0
    app.register_state.pending=false
    _=buffer.load(doc, "alphabet alphabet al")
    buffer.move_to(doc, doc.length, false)
    app.lsp.pending=0
    app.lsp.kind=0
    completion_words(app)
    if !completion_visible(app) {
      #panic("Escape fixture needs completion")
    }
    revision:=doc.revision
    app.input_state.repeat_count=3
    key_input(app, typography, KeyEscape, 0)
    if app.view.insert || app.view.extend || app.prompt_state.panel!=Panel.None || app.input_state.repeat_count!=0 {
      #panic("Escape from autocomplete must enter normal mode in one key")
    }
    if doc.revision!=revision || !buffer.equal(buffer.all(doc), "alphabet alphabet al") {
      #panic("Escape from autocomplete changed text")
    }
    completion_tick(app)
    if completion_visible(app) || app.lsp.completion_due!=0 || app.lsp.results.active {
      #panic("Escape completion reopened after returning to normal mode")
    }
  }
  // Other result panels still dismiss without changing the editing mode.
  app.view.insert=true
  app.prompt_state.panel=Panel.LspResults
  app.lsp.results.kind=2
  key_input(app, typography, KeyEscape, 0)
  if !app.view.insert || app.prompt_state.panel!=Panel.None {
    #panic("non-completion results changed editing mode")
  }
  app.running=false
}
