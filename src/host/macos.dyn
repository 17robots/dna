#target(kernel: darwin)
#link("System")
use "std/c"
use "std/io"

extern fn host_getcwd "getcwd"(output: *u8, capacity: usize) *u8
extern fn host_chdir "chdir"(path: *const u8) i32
extern fn host_getpid "getpid"() i32
fn native_current_directory(destination: []u8) usize {
  if host_getcwd(&destination[0], destination.len) == nil { return 0 }
  return c.string_length(&destination[0], destination.len)
}
fn native_change_directory(path: []const u8) bool {
  storage: [4096]u8
  if path.len >= storage.len { return false }
  encoded := cstring.bounded(storage[..], path) catch { return false }
  return host_chdir(encoded) == 0
}
fn native_process_id() u32 {
  return #cast(u32, host_getpid())
}
fn native_small_pages(memory: []u8) {
  _ = memory
}

extern fn host_environment "getenv"(name: *const u8) *const u8
// Pinned Dyn runtime accessors. Importing std/process here also
// imports its POSIX process declarations, colliding with DNA's native module.
extern fn host_argument_count "dyn_arguments_count"() *i32
extern fn host_argument_length "dyn_arguments_length"(value: *const u8) usize
extern fn host_argument_vector "dyn_arguments_vector"() ***const u8
fn native_environment(name: []const u8, destination: []u8) []u8!io.IoErr {
  storage: [4096]u8
  if name.len >= storage.len { fail .Capacity }
  key := cstring.bounded(storage[..], name) catch { fail .Capacity }
  value := host_environment(key)
  if value == nil { fail .NotFound }
  if destination.len == ~#cast(usize, 0) { fail .Capacity }
  parsed := c.bytes_from_string(value, destination.len + 1) catch { fail .Capacity }
  if parsed.len > destination.len { fail .Capacity }
  _ = mem.copy(destination, parsed)
  return destination[..parsed.len]
}
fn native_arguments(arena: *mem.Arena) [][]const u8!io.IoErr {
  count_pointer := host_argument_count()
  if count_pointer == nil || count_pointer.* < 0 { fail .InvalidInput }
  count := #cast(usize, count_pointer.*)
  if count == 0 {
    empty: [][]const u8
    return empty
  }
  if count > (~#cast(usize, 0)) / #sizeof([]const u8) { fail .Capacity }
  vector_pointer := host_argument_vector()
  if vector_pointer == nil || vector_pointer.* == nil { fail .InvalidInput }
  values := mem.push_array<[]const u8>(arena, count)
  vector := #slice(vector_pointer.*, count)
  for index in 0..count {
    source := vector[index]
    if source == nil { fail .InvalidInput }
    size := host_argument_length(source)
    destination := mem.push_bytes(arena, size)
    _ = mem.copy(destination, #slice(source, size))
    values[index] = destination
  }
  return values
}
