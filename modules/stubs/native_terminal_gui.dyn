fn terminal_gui_close(terminal: *Terminal) { _ = terminal }
pub fn dna_terminal_invalidate_font(terminal: *Terminal) { terminal.font = nil }
pub fn dna_terminal_draw(terminal: *Terminal, renderer: rawptr, font: rawptr, x: f32, y: f32, width: f32, height: f32, cw: f32, lh: f32, focused: i32) {
  _ = terminal
  _ = renderer
  _ = font
  _ = x
  _ = y
  _ = width
  _ = height
  _ = cw
  _ = lh
  _ = focused
}
