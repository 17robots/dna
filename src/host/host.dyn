use "../cstring"
use arena_owner "../owned_arena"
use "std/io"
use "std/mem"

// Paths are UTF-8 on every host. Native adapters reserve room for a trailing NUL.
// Zero means failure; a successful current directory is never empty.
pub fn current_directory(destination: []u8) usize {
  if destination.len < 2 { return 0 }
  destination[0] = 0
  return native_current_directory(destination)
}
pub fn change_directory(path: str) bool {
  if path.len == 0 { return false }
  for byte in path {
    if byte == 0 { return false }
  }
  return native_change_directory(path)
}
pub fn process_id() u32 {
  return native_process_id()
}
pub fn write_error(text: str) {
  io.write(io.stderr(), text) catch {}
}
// This is an optional residency optimization, never required for correctness.
pub fn small_pages(memory: []u8) {
  if memory.len > 0 {
    native_small_pages(memory)
  }
}

// Environment values borrow destination. Argument values belong to the arena.
pub fn environment(name: str, destination: []u8) []u8!io.IoErr {
  if name.len == 0 { fail .InvalidInput }
  for byte in name {
    if byte == 0 || byte == '=' { fail .InvalidInput }
  }
  return try native_environment(name, destination)
}
pub fn arguments(arena: *mem.Arena) []str!io.IoErr {
  mark := mem.arena_mark(arena)
  errdefer mem.arena_rewind(arena, mark)
  return try native_arguments(arena)
}
