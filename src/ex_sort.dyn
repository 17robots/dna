use "std/mem"

// :[range]sort[!] [i] [n] [u]: sort whole lines. Without a range it sorts
// the whole file, as in Vim. ! reverses, i ignores case, n compares the first
// decimal number in each line (lines without one sort first), u keeps one of
// each run of equal lines. One undo restores the original order.
struct SortOptions { reverse, ignore_case, numeric, unique: bool }

fn vim_ex_sort(app: *App, doc: *buffer.Document, range_in: VimRange, text: []const u8, start: usize, bang: bool) bool {
  range := range_in
  if range.given == 0 {
    range.first = 0
    range.last = vim_last_row(doc)
  }
  options := SortOptions{reverse: bang}
  at := start
  for at < #len(text) && text[at] != '|' && text[at] != '"' {
    byte := text[at]
    if byte == 'i' {
      options.ignore_case = true
    } else if byte == 'n' {
      options.numeric = true
    } else if byte == 'u' {
      options.unique = true
    } else if byte != ' ' && byte != 9 {
      return vim_ex_fail(app, "E474: Invalid argument")
    }
    at += 1
  }
  if !vim_range_valid(app, doc, range) {
    return true
  }
  low := buffer.line_position(doc, range.first + 1)
  high := doc.length
  if range.last < vim_last_row(doc) {
    high = buffer.line_position(doc, range.last + 2)
  }
  if high <= low {
    return true
  }
  mark := mem.arena_mark(app.scratch)
  defer mem.arena_rewind(app.scratch, mark)
  source := mem.push_bytes_uninit(app.scratch, high - low)
  buffer.copy_range(doc, low, high, source)
  // A range ending at the end of a file without a final newline keeps it so.
  final_newline := source[#len(source) - 1] == 10
  count: usize = 0
  for byte in source {
    if byte == 10 {
      count += 1
    }
  }
  if !final_newline {
    count += 1
  }
  lines := mem.push_array([]const u8, app.scratch, count)
  scratch := mem.push_array([]const u8, app.scratch, count)
  line: usize = 0
  begin: usize = 0
  for index in 0..#len(source) {
    if source[index] == 10 {
      lines[line] = source[begin..index]
      line += 1
      begin = index + 1
    }
  }
  if !final_newline {
    lines[line] = source[begin..]
  }
  sort_lines(lines, scratch, options)
  output := mem.push_bytes_uninit(app.scratch, #len(source))
  used: usize = 0
  kept: usize = 0
  for index in 0..count {
    if options.unique && kept > 0 && sort_compare(lines[index], lines[index - 1], options) == 0 {
      continue
    }
    for byte in lines[index] {
      output[used] = byte
      used += 1
    }
    if index + 1 < count || final_newline {
      output[used] = 10
      used += 1
    }
    kept += 1
  }
  if !app.vim.ex.batch {
    app.prompt_state.panel = Panel.None
  }
  buffer.checkpoint(doc)
  doc.anchor = low
  doc.cursor = high
  if !buffer.replace(doc, output[..used]) {
    return vim_ex_fail(app, "Sorting exceeds document capacity.")
  }
  buffer.checkpoint(doc)
  doc.anchor = low
  doc.cursor = low
  if app.config.vim_keys {
    vim_place(app, low)
  }
  if count != kept {
    message: [64]u8
    message_used := copy_text(message[..], "")
    add_number(message[..], &message_used, count - kept)
    add_text(message[..], &message_used, " duplicate lines removed")
    status_note(app, message[..message_used])
  }
  return true
}

// Stable merge sort, so equal lines keep their order.
fn sort_lines(lines: [][]const u8, scratch: [][]const u8, options: SortOptions) {
  width: usize = 1
  for width < #len(lines) {
    low: usize = 0
    for low < #len(lines) {
      middle := low + width
      if middle > #len(lines) {
        middle = #len(lines)
      }
      high := middle + width
      if high > #len(lines) {
        high = #len(lines)
      }
      left := low
      right := middle
      out := low
      for left < middle || right < high {
        take_left := right >= high
        if left < middle && right < high {
          order := sort_compare(lines[left], lines[right], options)
          if options.reverse {
            take_left = order >= 0
          } else {
            take_left = order <= 0
          }
        }
        if take_left {
          scratch[out] = lines[left]
          left += 1
        } else {
          scratch[out] = lines[right]
          right += 1
        }
        out += 1
      }
      low = high
    }
    for index in 0..#len(lines) {
      lines[index] = scratch[index]
    }
    width *= 2
  }
}

fn sort_compare(a: []const u8, b: []const u8, options: SortOptions) i32 {
  if options.numeric {
    a_number := sort_number(a)
    b_number := sort_number(b)
    if a_number.found != b_number.found {
      if a_number.found {
        return 1
      }
      return -1
    }
    if a_number.value != b_number.value {
      if a_number.value < b_number.value {
        return -1
      }
      return 1
    }
    return 0
  }
  length := #len(a)
  if #len(b) < length {
    length = #len(b)
  }
  for index in 0..length {
    x := a[index]
    y := b[index]
    if options.ignore_case {
      x = lower(x)
      y = lower(y)
    }
    if x != y {
      if x < y {
        return -1
      }
      return 1
    }
  }
  if #len(a) == #len(b) {
    return 0
  }
  if #len(a) < #len(b) {
    return -1
  }
  return 1
}

struct SortNumber { value: i64, found: bool }
// The first decimal number in a line, with a directly preceding minus sign.
fn sort_number(line: []const u8) SortNumber {
  for index in 0..#len(line) {
    if line[index] >= '0' && line[index] <= '9' {
      negative := index > 0 && line[index - 1] == '-'
      value: i64 = 0
      at := index
      for at < #len(line) && line[at] >= '0' && line[at] <= '9' && value < 100000000000000000 {
        value = value * 10 + #cast(i64, line[at] - '0')
        at += 1
      }
      if negative {
        value = 0 - value
      }
      return SortNumber{value: value, found: true}
    }
  }
  return SortNumber{}
}
