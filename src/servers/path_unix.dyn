#target(family: unix)
use server_files "../filesystem"

fn server_path_separator()u8 {
  return 58
}

fn server_path_component(text:str)str {
  return text
}

extern fn server_access "access"(path:*const u8, mode:i32)i32

fn server_executable(path:str)bool {
  terminated:[4608]u8
  if path.len==0 || path.len>=terminated.len { return false }
  _=copy_text(terminated[..], path)
  return server_files.executable(path) && server_access(&terminated[0], 1)==0
}
