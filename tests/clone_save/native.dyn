use arena_owner "../../src/owned_arena"
use buffer "../../src/buffer"
use files "../../src/files"
use fs "../../src/filesystem"
use "std/mem"
use "std/io"

fn main() {
  if !fs.WholeFileClones {
    io.println("PASS clone (whole-file cloning not selected on this host)")
    return
  }
  size: usize = 17825792
  arena := arena_owner.create(#sizeof(buffer.Document) + size + 2097152)
  defer arena_owner.release(arena)
  text := mem.push_bytes(arena, size)
  for index in 0..size {
    text[index] = 97
  }
  fs.write_all("original.txt", text) catch {
    #panic("native clone fixture")
  }
  doc := buffer.allocate(arena)
  defer buffer.release(doc)
  state := files.State{}
  if files.open(&state, doc, "original.txt").len != 0 {
    #panic("native mapped open")
  }
  buffer.move_to(doc, doc.length, false)
  if !buffer.replace(doc, "APPEND") {
    #panic("native append")
  }
  job := files.SaveJob{}
  if !files.save_start(&job, &state, doc, "original.txt") || job.seed.descriptor < 0 {
    #panic("APFS save was not seeded")
  }
  files.save_write(&job)
  if files.save_finish(&job, &state, doc).len != 0 {
    #panic("native cloned save")
  }
  // The retained origin is now unlinked. A second save must still be exact.
  buffer.move_to(doc, doc.length, false)
  if !buffer.replace(doc, "SECOND") {
    #panic("native second edit")
  }
  if !files.save_start(&job, &state, doc, "original.txt") {
    #panic("native second start")
  }
  files.save_write(&job)
  if files.save_finish(&job, &state, doc).len != 0 {
    #panic("native second save")
  }
  disk := files.read_document("original.txt")
  if !disk.valid || disk.data.len != size + 12 || !buffer.equal(disk.data[..size], text) || !buffer.equal(disk.data[size..], "APPENDSECOND") {
    #panic("native clone bytes")
  }
  files.release_text(&disk)
  _ = fs.metadata("original.txt.dna-write") catch {
    io.println("PASS clone native APFS mapped document, seeded append, repeated save and exact bytes")
    return
  }
  #panic("native clone temporary leaked")
}
