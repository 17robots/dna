use "../host" host
use "../files" files

// Default language servers, started when the program is on PATH and the
// user has not configured that language's server (or set auto_start = false).
// Nothing is installed automatically; :server-install covers managed ones.
extern fn executable_access "access"(path: *const u8, mode: i32) i32

pub struct DefaultServer { language: []const u8, command: []const u8 }

pub fn default_server(index: usize) DefaultServer {
  servers: [44]DefaultServer = [
    DefaultServer{language: "rust", command: "rust-analyzer"},
    DefaultServer{language: "go", command: "gopls"},
    DefaultServer{language: "zig", command: "zls"},
    DefaultServer{language: "odin", command: "ols"},
    DefaultServer{language: "c", command: "clangd"},
    DefaultServer{language: "cpp", command: "clangd"},
    DefaultServer{language: "python", command: "pyright-langserver --stdio"},
    DefaultServer{language: "javascript", command: "typescript-language-server --stdio"},
    DefaultServer{language: "typescript", command: "typescript-language-server --stdio"},
    DefaultServer{language: "tsx", command: "typescript-language-server --stdio"},
    DefaultServer{language: "lua", command: "lua-language-server"},
    DefaultServer{language: "java", command: "jdtls"},
    DefaultServer{language: "kotlin", command: "kotlin-language-server"},
    DefaultServer{language: "c_sharp", command: "csharp-ls"},
    DefaultServer{language: "haskell", command: "haskell-language-server-wrapper --lsp"},
    DefaultServer{language: "ocaml", command: "ocamllsp"},
    DefaultServer{language: "elixir", command: "elixir-ls"},
    DefaultServer{language: "erlang", command: "erlang_ls"},
    DefaultServer{language: "gleam", command: "gleam lsp"},
    DefaultServer{language: "elm", command: "elm-language-server"},
    DefaultServer{language: "clojure", command: "clojure-lsp"},
    DefaultServer{language: "ruby", command: "ruby-lsp"},
    DefaultServer{language: "php", command: "intelephense --stdio"},
    DefaultServer{language: "scala", command: "metals"},
    DefaultServer{language: "dart", command: "dart language-server --protocol=lsp"},
    DefaultServer{language: "nix", command: "nil"},
    DefaultServer{language: "bash", command: "bash-language-server start"},
    DefaultServer{language: "fish", command: "fish-lsp start"},
    DefaultServer{language: "nu", command: "nu --lsp"},
    DefaultServer{language: "yaml", command: "yaml-language-server --stdio"},
    DefaultServer{language: "json", command: "vscode-json-language-server --stdio"},
    DefaultServer{language: "html", command: "vscode-html-language-server --stdio"},
    DefaultServer{language: "css", command: "vscode-css-language-server --stdio"},
    DefaultServer{language: "scss", command: "vscode-css-language-server --stdio"},
    DefaultServer{language: "markdown", command: "marksman server"},
    DefaultServer{language: "toml", command: "taplo lsp stdio"},
    DefaultServer{language: "dockerfile", command: "docker-langserver --stdio"},
    DefaultServer{language: "cmake", command: "cmake-language-server"},
    DefaultServer{language: "typst", command: "tinymist"},
    DefaultServer{language: "hcl", command: "terraform-ls serve"},
    DefaultServer{language: "svelte", command: "svelteserver --stdio"},
    DefaultServer{language: "vue", command: "vue-language-server --stdio"},
    DefaultServer{language: "glsl", command: "glsl_analyzer"},
    DefaultServer{language: "xml", command: "lemminx"},
  ]
  if index >= #len(servers) {
    return DefaultServer{}
  }
  return servers[index]
}
pub const DefaultServers: usize = 44

// Whether the command's program is an executable file on PATH.
pub fn on_path(command: []const u8) bool {
  program_end: usize = 0
  for program_end < #len(command) && command[program_end] != ' ' {
    program_end += 1
  }
  program := command[..program_end]
  if #len(program) == 0 {
    return false
  }
  storage: [8192]u8 = []
  path := host.environment("PATH", storage[..])
  if !path.ok || !path.found {
    return false
  }
  at: usize = 0
  for at <= #len(path.value) {
    end := at
    for end < #len(path.value) && path.value[end] != ':' {
      end += 1
    }
    if end > at {
      candidate: [4200]u8 = []
      length := copy_text(candidate[..], path.value[at..end])
      add_text(candidate[..], &length, "/")
      add_text(candidate[..], &length, program)
      // access follows symlinks (mise shims, /usr/bin/sh); exclude directories.
      info := files.metadata(candidate[..length])
      if executable_access(&candidate[0], 1) == 0 && (info.mode & 61440) != 16384 {
        return true
      }
    }
    at = end + 1
  }
  return false
}

fn copy_text(destination: []u8, source: []const u8) usize {
  if #len(source) >= #len(destination) {
    return 0
  }

  index: usize = 0
  for index < #len(source) {
    destination[index] = source[index]
    index += 1
  }
  destination[index] = 0
  return index
}
fn add_text(destination: []u8, used: *usize, source: []const u8) {
  if used.* + #len(source) >= #len(destination) {
    return
  }
  for byte in source {
    destination[used.*] = byte
    used.* += 1
  }
  destination[used.*] = 0
}
