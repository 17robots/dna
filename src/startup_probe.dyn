// Packaged startup validation exercises initialization, presentation and cleanup.
// Full behavioral tests are compiled separately from tests/editor.
fn startup_probe(app: *App, typography: *Typography, renderer: rawptr, window: rawptr, input_storage: []u8) {
  app.view.reduced_motion = true
  event := sdl.Event{}
  event.words[0] = 256
  if !sdl.push(&event) {
    #panic("startup probe event failed")
  }
}

fn finish_probe(app: *App) {}
