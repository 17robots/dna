// DNA's fixed-capacity owner boundary uses the SDK's stable arena handles.
use "std/mem"

pub fn try_create(capacity: usize) *mem.Arena {
  if capacity == 0 {
    return mem.arena_try_create(0).arena
  }
  if capacity > #cast(usize, -1) - mem.ArenaHeader {
    return nil
  }
  // Preserve DNA's payload budget while accounting for the SDK header.
  size := capacity + mem.ArenaHeader
  result := mem.arena_try_create_bounded(size, size)
  return result.arena
}

pub fn create(capacity: usize) *mem.Arena {
  result := try_create(capacity)
  if result == nil {
    #panic("cannot reserve owned arena memory")
  }
  return result
}

pub fn release(owner: *mem.Arena) {
  mem.arena_release(owner)
}
