#target(kernel: darwin)
#link("System")

extern fn syntax_dladdr "dladdr"(address: rawptr, info: *SyntaxLibraryInfo) i32
extern fn syntax_realpath "realpath"(path: *const u8, output: *u8) *u8
extern fn syntax_access "access"(path: *const u8, mode: i32) i32
fn syntax_module_path(output: *u8, capacity: usize) bool {
  if output == nil || capacity < 4096 {
    return false
  }
  info := SyntaxLibraryInfo{}
  return syntax_dladdr(#cast(rawptr, dna_syntax_open), &info) != 0 && syntax_realpath(info.filename, output) != nil
}
fn syntax_readable(path: *const u8) bool {
  return syntax_access(path, 4) == 0
}
fn syntax_helper_name() []const u8 {
  return "bin/dna-language"
}
