fn copy_text(destination: []u8, source: []const u8) usize {
  if #len(source) >= #len(destination) {
    return 0
  }

  index: usize = 0
  for index < #len(source) {
    destination[index] = source[index]
    index += 1
  }
  destination[index] = 0
  return index
}
fn add_text(destination: []u8, used: *usize, source: []const u8) {
  if used.* + #len(source) >= #len(destination) {
    return
  }
  for byte in source {
    destination[used.*] = byte
    used.* += 1
  }
  destination[used.*] = 0
}
fn lower(byte: u8) u8 {
  if byte >= 65 && byte <= 90 {
    return byte + 32
  }
  return byte
}
fn contains(text: []const u8, query: []const u8) bool {
  if #len(query) == 0 {
    return true
  }
  if #len(query) > #len(text) {
    return false
  }

  at: usize = 0
  for at + #len(query) <= #len(text) {
    index: usize = 0
    for index < #len(query) && lower(text[at + index]) == lower(query[index]) {
      index += 1
    }
    if index == #len(query) {
      return true
    }
    at += 1
  }
  return false
}
// True when every space-separated word of query starts a word of text,
// ignoring case: "sw th" and "theme" match "Switch theme", "wrtie" and
// "keys" match nothing. The palette runs only such rows on Enter, so a typo
// never runs an unrelated command picked by subsequence ranking.
fn word_prefix_match(text: []const u8, query: []const u8) bool {
  start: usize = 0
  matched := false
  for start < #len(query) {
    for start < #len(query) && query[start] == ' ' {
      start += 1
    }
    end := start
    for end < #len(query) && query[end] != ' ' {
      end += 1
    }
    if end > start {
      if !word_starts_with(text, query[start..end]) {
        return false
      }
      matched = true
    }
    start = end
  }
  return matched
}
fn word_starts_with(text: []const u8, word: []const u8) bool {
  for at in 0..#len(text) {
    if at > 0 {
      before := text[at - 1]
      if !(before == ' ' || before == '-' || before == '_' || before == '/' || before == ':' || before == '(' || before == '.') {
        continue
      }
    }
    if at + #len(word) > #len(text) {
      return false
    }
    index: usize = 0
    for index < #len(word) && lower(text[at + index]) == lower(word[index]) {
      index += 1
    }
    if index == #len(word) {
      return true
    }
  }
  return false
}
// Case-insensitive subsequence score shared by the command palette and
// completion. Word starts, runs and early matches rank higher; -1 = no match.
fn fuzzy_score(text: []const u8, query: []const u8) i32 {
  if #len(query) == 0 {
    return 0
  }
  score: i32 = 0
  wanted: usize = 0
  at: usize = 0
  run: bool = false
  first: usize = #len(text)
  for at < #len(text) && wanted < #len(query) {
    byte := text[at]
    if lower(byte) == lower(query[wanted]) {
      if first == #len(text) {
        first = at
      }
      score += 4
      if at == 0 {
        score += 24
      } else {
        before := text[at - 1]
        separator := before == ' ' || before == '-' || before == '_' || before == '/' || before == '.' || before == ':' || before == '(' || before == '<'
        camel := byte >= 'A' && byte <= 'Z' && before >= 'a' && before <= 'z'
        if separator || camel {
          score += 12
        }
      }
      if run {
        score += 8
      }
      if byte == query[wanted] {
        score += 1
      }
      run = true
      wanted += 1
    } else {
      run = false
    }
    at += 1
  }
  if wanted < #len(query) {
    return -1
  }
  penalty := first
  if penalty > 16 {
    penalty = 16
  }
  extra := #len(text) - #len(query)
  if extra > 32 {
    extra = 32
  }
  score -= #cast(i32, penalty)
  score -= #cast(i32, extra) / 4
  if score < 1 {
    score = 1
  }
  return score
}
