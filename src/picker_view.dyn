struct PickerState {
  worker: rawptr,
  generation, refresh_due: u64,
  pending, watching, watch_fallback: bool,
  index: *PickerIndex,
  arena: *mem.Arena,
  rows: usize,
  received_count: usize,
  epoch: u64,
  preview: PickerPreview,
  closing: bool,
  close_target: usize,
  close_return: usize,
  close_row: usize,
  close_query: [4096]u8,
  close_query_length: usize,
}

struct PickerPreview {
  bytes: [8192]u8,
  path: [4096]u8,
  path_length: usize,
  rows: usize,
  length: usize,
  epoch: u64,
  revision: u64,
  document: *buffer.Document,
  ready: bool,
}
struct KeyHint { key, label: str }

fn ui_text(typography: *Typography, text: str, x: f32, y: f32, color: Rgb) {
  if text.len == 0 { return }
  cached := cached_ui_text(typography, text)
  if cached != nil {
    if !tint(cached, color) || !ttf.draw(cached, x, y) {
      #panic("cached UI text")
    }
    return
  }
  if !tint(typography.chrome, color) || !ttf.set(typography.chrome, &text[0], text.len) || !ttf.draw(typography.chrome, x, y) {
    #panic("UI text")
  }
}
fn ui_box(renderer: rawptr, rect: platform.Rect, scale: f32) {
  inner := platform.Rect{x: rect.x + scale, y: rect.y + scale, width: rect.width - scale * 2.0, height: rect.height - scale * 2.0}
  if !paint(renderer, theme().border) || !platform.fill(renderer, &rect) || !paint(renderer, theme().surface) || !platform.fill(renderer, &inner) {
    #panic("UI border")
  }
}
fn goto_hint(index: usize) KeyHint {
  labels: [16]KeyHint = [
    KeyHint{key: "g", label: "file start"}, KeyHint{key: "e", label: "file end"},
    KeyHint{key: "h", label: "line start"}, KeyHint{key: "l", label: "line end"},
    KeyHint{key: "s", label: "first nonblank"}, KeyHint{key: "t", label: "screen top"},
    KeyHint{key: "c", label: "screen center"}, KeyHint{key: "b", label: "screen bottom"},
    KeyHint{key: "a", label: "last buffer"}, KeyHint{key: "f", label: "file under cursor"},
    KeyHint{key: "n", label: "next buffer"}, KeyHint{key: "p", label: "previous buffer"},
    KeyHint{key: "d", label: "definition"}, KeyHint{key: "r", label: "references"},
    KeyHint{key: "y", label: "type definition"}, KeyHint{key: "i", label: "implementation"},
  ]
  if index < 16 { return labels[index] }
  return KeyHint{key: "", label: ""}
}
fn view_hint(index: usize) KeyHint {
  labels: [5]KeyHint = [
    KeyHint{key: "z", label: "center cursor"}, KeyHint{key: "t", label: "cursor at top"},
    KeyHint{key: "b", label: "cursor at bottom"}, KeyHint{key: "k", label: "scroll up"},
    KeyHint{key: "j", label: "scroll down"},
  ]
  if index < 5 { return labels[index] }
  return KeyHint{key: "", label: ""}
}
fn bracket_hint(index: usize) KeyHint {
  labels: [10]KeyHint = [
    KeyHint{key: "d", label: "diagnostic"}, KeyHint{key: "D", label: "first/last diagnostic"},
    KeyHint{key: "g", label: "git change"}, KeyHint{key: "G", label: "first/last git change"},
    KeyHint{key: "f", label: "function"}, KeyHint{key: "t", label: "type"},
    KeyHint{key: "a", label: "parameter"}, KeyHint{key: "c", label: "comment"},
    KeyHint{key: "p", label: "paragraph"}, KeyHint{key: " ", label: "add blank line"},
  ]
  if index < 10 { return labels[index] }
  return KeyHint{key: "", label: ""}
}
fn key_hint(goto: bool, index: usize) KeyHint {
  if goto { return goto_hint(index) }
  info := command_info(leader_command(index))
  return KeyHint{key: info.key, label: info.hint}
}
fn vim_menu_active(app: *const App) bool {
  return vim_menu_prefix(app) != 0
}
fn vim_key_hint(app: *const App, index: usize) KeyHint {
  prefix := vim_menu_prefix(app)
  if prefix == 'g' {
    hints: [19]KeyHint = [
      KeyHint{key: "g", label: "first/count line"}, KeyHint{key: "e", label: "previous word end"},
      KeyHint{key: "E", label: "previous WORD end"}, KeyHint{key: "_", label: "last nonblank"},
      KeyHint{key: "j", label: "next line"}, KeyHint{key: "k", label: "previous line"},
      KeyHint{key: "0", label: "line start"}, KeyHint{key: "~", label: "toggle case operator"},
      KeyHint{key: "u", label: "lowercase operator"}, KeyHint{key: "U", label: "uppercase operator"},
      KeyHint{key: "v", label: "restore selection"}, KeyHint{key: "J", label: "join lines"},
      KeyHint{key: "d", label: "definition"}, KeyHint{key: "r", label: "references"},
      KeyHint{key: "y", label: "type definition"}, KeyHint{key: "i", label: "implementation"},
      KeyHint{key: "t", label: "next buffer"}, KeyHint{key: "T", label: "previous buffer"},
      KeyHint{key: "D", label: "definition"},
    ]
    if index < key_menu_count(app) { return hints[index] }
  }
  if prefix == 'z' {
    hints: [3]KeyHint = [KeyHint{key: "z", label: "center cursor"}, KeyHint{key: "t", label: "cursor at top"}, KeyHint{key: "b", label: "cursor at bottom"}]
    if index < 3 { return hints[index] }
  }
  if prefix == 'Z' {
    hints: [2]KeyHint = [KeyHint{key: "Z", label: "save and close"}, KeyHint{key: "Q", label: "exit editor"}]
    if index < 2 { return hints[index] }
  }
  if prefix == 'i' || prefix == 'a' {
    hints: [10]KeyHint = [
      KeyHint{key: "w", label: "word"}, KeyHint{key: "W", label: "WORD"}, KeyHint{key: "p", label: "paragraph"},
      KeyHint{key: "\"", label: "double quotes"}, KeyHint{key: "'", label: "single quotes"}, KeyHint{key: "`", label: "backticks"},
      KeyHint{key: "(", label: "parentheses"}, KeyHint{key: "[", label: "brackets"}, KeyHint{key: "{", label: "braces"}, KeyHint{key: "<", label: "angle brackets"},
    ]
    if index < 10 { return hints[index] }
  }
  return KeyHint{}
}
fn key_menu_count(app: *const App) usize {
  prefix := vim_menu_prefix(app)
  case prefix {
    'g' => {
      context := vim_menu_context(app)
      if context == 2 { return 7 }
      if context == 1 { return 10 }
      return 19
    }
    'z' => { return 3 }
    'Z' => { return 2 }
    'i', 'a' => { return 10 }
    _ => {}
  }
  case app.prompt_state.panel {
    .Leader => { return LeaderCommands + leader_custom_count(app) }
    .Goto => { return 16 }
    .View => { return 5 }
    .Bracket => { return 10 }
    .Windows => { return 10 }
    .Match => {
      // Surround steps take a delimiter; inside and around list objects.
      if app.match_state.stage == .Inside || app.match_state.stage == .Around { return 14 }
      if app.match_state.stage != .Menu { return 0 }
      return 6
    }
    _ => {}
  }
  return 11
}
fn key_menu_hint(app: *const App, index: usize) KeyHint {
  if vim_menu_active(app) { return vim_key_hint(app, index) }
  if app.prompt_state.panel == .Leader && index >= LeaderCommands {
    return leader_custom_hint(app, index - LeaderCommands)
  }
  hint := key_hint(app.prompt_state.panel == .Goto, index)
  if app.prompt_state.panel == .Leader && hint.key.len == 1 {
    // A [keys.space] binding on a built-in key shows what it does now.
    custom := leader_custom_for(app, hint.key[0])
    if custom != nil {
      hint.label = leader_custom_label(custom)
    }
  }
  if app.prompt_state.panel == .Windows {
    hint = window_hint(index)
  }
  if app.prompt_state.panel == .Match {
    hint = match_hint(app.match_state.stage, index)
  }
  if app.prompt_state.panel == .View {
    hint = view_hint(index)
  }
  if app.prompt_state.panel == .Bracket {
    hint = bracket_hint(index)
  }
  if app.prompt_state.panel == .Leader && app.input_state.leader_explorer && index == 6 {
    hint.label = "hide explorer"
  }
  return hint
}
const PrintableKeys: str = "!\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
// Space-menu bindings shown as hints: those starting with a plain ASCII
// character, once per first key.
fn leader_custom_first(binding: *const settings.Binding) u32 {
  step := binding_step(binding, 0)
  if step.character >= 33 && step.character < 127 { return step.character }
  return 0
}
fn leader_builtin(key: u32) bool {
  for index in 0..LeaderCommands {
    info := command_info(leader_command(index))
    if info.key.len == 1 && info.key[0] == key { return true }
  }
  return false
}
fn leader_custom_shown(app: *const App, index: usize) bool {
  binding := &app.config.bindings[index]
  if !binding_applies(app, binding, settings.KeysMode.Space) { return false }
  first := leader_custom_first(binding)
  if first == 0 || leader_builtin(first) { return false }
  for earlier in 0..index {
    other := &app.config.bindings[earlier]
    if binding_applies(app, other, settings.KeysMode.Space) && leader_custom_first(other) == first {
      return false
    }
  }
  return true
}
fn leader_custom_count(app: *const App) usize {
  if app.input_state.leader_explorer { return 0 }
  count: usize = 0
  for index in 0..app.config.binding_count {
    if leader_custom_shown(app, index) {
      count += 1
    }
  }
  return count
}
fn leader_custom_label(binding: *const settings.Binding) str {
  if binding_length(binding) > 1 { return "+more keys" }
  if binding.command.len > 5 && buffer.equal(binding.command[..5], "keys:") {
    return binding.command[5..]
  }
  return binding.command
}
fn leader_custom_for(app: *const App, key: u32) *const settings.Binding {
  if app.input_state.leader_explorer { return nil }
  typed: [1]settings.Stroke = [settings.Stroke{key: key, character: key}]
  found := binding_search(app, typed[..], settings.KeysMode.Space)
  if found.longer {
    for index in 0..app.config.binding_count {
      binding := &app.config.bindings[index]
      if binding_applies(app, binding, settings.KeysMode.Space) && binding_length(binding) > 1 && leader_custom_first(binding) == key {
        return binding
      }
    }
  }
  if found.has_exact { return &app.config.bindings[found.exact] }
  return nil
}
fn leader_custom_hint(app: *const App, wanted: usize) KeyHint {
  seen: usize = 0
  for index in 0..app.config.binding_count {
    if !leader_custom_shown(app, index) { continue }
    if seen == wanted {
      first := leader_custom_first(&app.config.bindings[index])
      at := #cast(usize, first - 33)
      shown := leader_custom_for(app, first)
      return KeyHint{key: PrintableKeys[at..at + 1], label: leader_custom_label(shown)}
    }
    seen += 1
  }
  return KeyHint{}
}
fn key_menu_is(panel: Panel) bool {
  return panel == .Leader || panel == .Goto || panel == .Windows || panel == .Match || panel == .View || panel == .Bracket
}
// Key menus: a clickable grid of hints anchored bottom-right.
fn draw_key_menu(renderer: rawptr, app: *App, typography: *Typography, width: i32, height: i32, status: f32) {
  ui := &app.ui
  ui_panel_begin(ui, typography)
  scale := typography.scale
  padding := 10.0 * scale
  margin := 12.0 * scale
  columns: usize = 2
  if #cast(f32, width) < typography.cell * 52.0 + padding * 2.0 {
    columns = 1
  }
  count := key_menu_count(app)
  rows := (count + columns - 1) / columns
  box_width := typography.cell * 25.0 * #cast(f32, columns) + padding * 2.0
  if box_width > #cast(f32, width) - margin * 2.0 {
    box_width = #cast(f32, width) - margin * 2.0
  }
  box_height := typography.line * #cast(f32, (rows + 2)) + padding * 2.0
  available := #cast(f32, height) - status - margin * 2.0
  if box_height > available {
    box_height = available
  }
  target := place_rect(app, SurfaceMenu, width, height, status, scale, platform.Rect{x: #cast(f32, width) - box_width - margin, y: #cast(f32, height) - status - box_height - margin, width: box_width, height: box_height})
  placed := animated_surface(app, SurfaceMenu, target, scale)
  box_width = placed.width
  box_height = placed.height
  menu := ui_make(ui, ui_hash(0, "key menu"), UiFloating | UiBackground | UiBorder | UiClip)
  ui.boxes[menu].floating[0] = placed.x
  ui.boxes[menu].floating[1] = placed.y
  ui.boxes[menu].fill = theme().surface
  ui.boxes[menu].padding[0] = padding
  ui.boxes[menu].padding[1] = padding
  ui_size(ui, menu, UiAxisX, .Pixels, box_width / scale, 1.0)
  ui_size(ui, menu, UiAxisY, .Pixels, box_height / scale, 1.0)
  ui_push(ui, menu)
  title: str = "space"
  prefix := vim_menu_prefix(app)
  if prefix == 'g' {
    title = "Vim g"
  }
  if prefix == 'z' {
    title = "Vim z"
  }
  if prefix == 'Z' {
    title = "Vim Z"
  }
  if prefix == 'i' {
    title = "Vim inside object"
  }
  if prefix == 'a' {
    title = "Vim around object"
  }
  if app.prompt_state.panel == .Goto {
    title = "goto (g)"
  }
  if app.prompt_state.panel == .Windows {
    title = "windows (space w / ctrl-w)"
  }
  if app.prompt_state.panel == .Match {
    title = match_title(app)
  }
  if app.prompt_state.panel == .View {
    title = "view (z)"
    if app.input_state.view_sticky {
      title = "view (Z, sticky)"
    }
  }
  if app.prompt_state.panel == .Bracket {
    title = "previous ([)"
    if app.input_state.bracket_forward {
      title = "next (])"
    }
  }
  _ = ui_label(ui, "title", title, UiMuted)
  grid := ui_make(ui, ui_key(ui, "grid"), 0)
  ui.boxes[grid].axis = UiAxisX
  ui_size(ui, grid, UiAxisX, .Percent, 1.0, 1.0)
  for column in 0..columns {
    ui_push(ui, grid)
    lane := ui_make(ui, ui_hash_number(ui.boxes[grid].key, column), 0)
    ui_size(ui, lane, UiAxisX, .Percent, 1.0 / #cast(f32, columns), 0.0)
    ui_push(ui, lane)
    index := column * rows
    for index < count && index < (column + 1) * rows {
      hint := key_menu_hint(app, index)
      entry := ui_make(ui, ui_hash_number(ui.boxes[lane].key, index), UiClickable | UiHover)
      ui.boxes[entry].axis = UiAxisX
      ui.boxes[entry].value = index
      ui_size(ui, entry, UiAxisX, .Percent, 1.0, 1.0)
      ui_push(ui, entry)
      shortcut := ui_label(ui, "key", hint.key, UiAccent)
      ui_size(ui, shortcut, UiAxisX, .Pixels, typography.cell * 3.0 / scale, 1.0)
      label := ui_label(ui, "label", hint.label, 0)
      ui_size(ui, label, UiAxisX, .Percent, 1.0, 0.0)
      ui_pop(ui)
      ui_animate(app, ui, entry, false)
      index += 1
    }
    ui_pop(ui)
    ui_pop(ui)
  }
  footer: str = "esc  cancel"
  if vim_menu_active(app) {
    footer = "esc cancels; counts/operators stay active"
  }
  if app.prompt_state.panel == .Match && (app.match_state.stage == .Inside || app.match_state.stage == .Around) {
    footer = "esc cancel; syntax objects need queries"
  }
  if app.prompt_state.panel == .Match && app.match_state.error {
    footer = "No object/pair, or edit limit. Esc cancels."
  }
  if app.prompt_state.panel == .Match && app.match_state.syntax_error {
    footer = "No syntax object; check query or wait."
  }
  _ = ui_label(ui, "footer", footer, UiMuted)
  ui_pop(ui)
  ui_layout(ui)
  ui_render(renderer, ui, typography, width, height)
}
// Clicking a hint presses its key.
fn key_menu_mouse(app: *App, typography: *Typography, x: f32, y: f32, pressed: bool, moved: bool) {
  ui := &app.ui
  if moved {
    ui_pointer(ui, x, y)
    return
  }
  if !pressed { return }
  hit := ui_hit(ui, x, y)
  if hit == 0 {
    menu := ui_make_lookup(ui, ui_hash(0, "key menu"))
    if menu == 0 || !ui_contains(ui.boxes[menu].rect, x, y) {
      key_input(app, typography, KeyEscape, 0)
    }
    return
  }
  hint := key_menu_hint(app, ui.boxes[hit].value)
  if hint.key.len == 0 { return }
  if vim_menu_active(app) {
    character := app.input_state.character
    app.input_state.character = hint.key[0]
    key_input(app, typography, hint.key[0], 0)
    app.input_state.character = character
    return
  }
  if app.prompt_state.panel == .Match && app.match_state.stage != .Menu {
    // Object and delimiter stages read typed characters.
    text_input(app, hint.key[..1])
    return
  }
  code := #cast(u32, hint.key[0])
  modifiers: u16 = 0
  if code >= 'A' && code <= 'Z' {
    code += 32
    modifiers = 1
  }
  key_input(app, typography, code, modifiers)
}

fn preview_update(app: *App, typography: *Typography, path: str, doc: *buffer.Document) {
  state := &app.picker_state.preview
  revision: u64 = 0
  if doc != nil {
    revision = doc.revision
  }
  if state.ready && state.epoch == app.picker_state.epoch && state.document == doc && state.revision == revision && state.rows == app.picker_state.rows && buffer.equal(state.path[..state.path_length], path) {
    return
  }
  state.ready = true
  state.epoch = app.picker_state.epoch
  state.document = doc
  state.revision = revision
  state.rows = app.picker_state.rows
  state.path_length = copy_text(state.path[..], path)
  mark := mem.arena_mark(app.scratch)
  defer mem.arena_rewind(app.scratch, mark)
  content: str = "No file selected."
  if doc != nil {
    content = buffer.all(doc)
  } else if path.len > 0 {
    // Only the top of the file is ever visible in the preview.
    read := files.read_prefix(app.scratch, path, 262144)
    meta := files.metadata(path) catch fs.Metadata{size: 1}
    if buffer.valid(read) && (read.len > 0 || meta.size == 0) {
      content = read
    } else {
      content = "Preview unavailable (binary or unreadable)."
    }
  }
  visible: usize = 0
  lines: usize = 0
  for visible < content.len && lines < app.picker_state.rows {
    if content[visible] == 10 {
      lines += 1
    }
    visible += 1
  }
  length := visible
  if length > 8191 {
    length = 8191
    for length > 0 && (content[length] & 192) == 128 {
      length -= 1
    }
  }
  state.length = copy_text(state.bytes[..], content[..length])
  if !ttf.set(typography.preview_text, &state.bytes[0], state.length) {
    #panic("picker preview text")
  }
}
// Show text in the preview pane, such as the language manager's details.
fn preview_show(app: *App, typography: *Typography, text: str) {
  state := &app.picker_state.preview
  length := text.len
  if length > 8191 {
    length = 8191
  }
  if state.ready && state.document == nil && state.path_length == 0 && state.length == length && buffer.equal(state.bytes[..length], text[..length]) {
    return
  }
  // A file preview must not match this text's cache key later.
  state.ready = false
  state.path_length = 0
  state.document = nil
  // Pickers always have at least one row, so file previews never reuse this.
  state.rows = 0
  state.length = copy_text(state.bytes[..], text[..length])
  state.ready = true
  if !ttf.set(typography.preview_text, &state.bytes[0], state.length) {
    #panic("picker preview text")
  }
}
// Open buffers reuse their live highlighting; files use a pooled preview parser.
fn picker_preview_colors(app: *App, path: str, doc: *buffer.Document, shown: str) str {
  if shown.len == 0 || !app.config.syntax_enabled { return shown[..0] }
  if doc != nil {
    for slot in app.documents.slots {
      if slot.document == doc && slot.syntax != nil && slot.syntax_revision == doc.revision && shown.len <= doc.length {
        return slot.colors[..shown.len]
      }
    }
  }
  if path.len == 0 { return shown[..0] }
  return preview_request(app, &app.previews.picker, preview_path_key(path), path, false, shown)
}
struct PickerGeometry {
  rect: platform.Rect,
  padding: f32,
  body_y: f32,
  rows: usize,
  preview: bool,
  footer: bool,
  list_width: f32,
}
// Compact and dropdown pickers: the query and a list sized to its matches,
// without the preview or footer.
fn picker_slim_geometry(app: *const App, typography: *const Typography, width: i32, height: i32, status: f32, count: usize) PickerGeometry {
  scale := typography.scale
  line := typography.line
  padding := 10.0 * scale
  limit: usize = 12
  if app.config.picker_style == .Dropdown {
    limit = 10
  }
  room := (#cast(f32, height) - status) * 0.7 / line - 2.0
  rows := count
  if rows > limit {
    rows = limit
  }
  if room < 1.0 {
    rows = 1
  } else if #cast(usize, room) < rows {
    rows = #cast(usize, room)
  }
  if rows == 0 {
    rows = 1
  }
  content := #cast(f32, (rows + 2)) * line + padding * 2.0
  natural := picker_compact_rect(width, height, status, content, scale)
  if app.config.picker_style == .Dropdown {
    natural = picker_dropdown_rect(width, content, scale)
  }
  rect := place_rect(app, SurfacePicker, width, height, status, scale, natural)
  // Explicit placement and window bounds can shorten the natural popup.
  // Scroll against rows that actually fit inside the final frame.
  placed_room := (rect.height - padding * 2.0) / line - 2.0
  if placed_room < 1.0 {
    rows = 1
  } else if #cast(usize, placed_room) < rows {
    rows = #cast(usize, placed_room)
  }
  return PickerGeometry{rect: rect, padding: padding, body_y: rect.y + padding + line * 2.0, rows: rows, preview: false, footer: false, list_width: rect.width - padding * 2.0}
}
fn picker_geometry(app: *const App, typography: *const Typography, width: i32, height: i32, status: f32, count: usize) PickerGeometry {
  if app.config.picker_style != .Full {
    return picker_slim_geometry(app, typography, width, height, status, count)
  }
  padding := 12.0 * typography.scale
  rect := place_rect(app, SurfacePicker, width, height, status, typography.scale, window_popup_rect(width, height, status))
  body_y := rect.y + padding + typography.line * 2.0
  body_height := rect.height - padding * 2.0 - typography.line * 3.0
  rows: usize = 1
  if body_height > typography.line {
    rows = #cast(usize, (body_height / typography.line))
  }
  // The language manager's details pane shows whatever the preview setting.
  preview := rect.width >= typography.cell * 80.0 && !app.resource_state.fonts && ((app.config.picker_preview && app.resource_state.kind == .None) || app.resource_state.kind == .Languages)
  list_width := rect.width - padding * 2.0
  if preview {
    list_width = (rect.width - padding * 3.0) * 0.45
    if app.resource_state.kind == .Languages {
      list_width = (rect.width - padding * 3.0) * 0.5
    }
  }
  return PickerGeometry{rect: rect, padding: padding, body_y: body_y, rows: rows, preview: preview, footer: true, list_width: list_width}
}
fn picker_state_counts(app: *App) PickerCounts {
  if app.prompt_state.panel == .Buffers {
    buffer_matches(app)
    return PickerCounts{count: app.prompt_state.match_count, selected: app.prompt_state.selected}
  }
  return PickerCounts{count: app.completion.count, selected: app.completion.selected}
}
struct PickerCounts { count, selected: usize }
// Keep at least one complete row while the frame settles, and size scrolling
// from the frame actually drawn rather than its eventual destination.
fn picker_visual_geometry(typography: *const Typography, target: PickerGeometry, rect: platform.Rect) PickerGeometry {
  result := target
  overhead: f32 = 2.0
  if target.footer {
    overhead = 3.0
  }
  minimum := target.padding * 2.0 + typography.line * (overhead + 1.0)
  if minimum > target.rect.height {
    minimum = target.rect.height
  }
  if rect.height < minimum {
    rect.height = minimum
    rect.y = target.rect.y + (target.rect.height - minimum) * 0.5
  }
  result.rect = rect
  result.body_y = rect.y + target.padding + typography.line * 2.0
  room := (rect.height - target.padding * 2.0) / typography.line - overhead
  result.rows = 1
  if room >= 1.0 {
    result.rows = #cast(usize, room)
  }
  if result.rows > target.rows {
    result.rows = target.rows
  }
  result.list_width = rect.width - target.padding * 2.0
  if target.preview {
    result.list_width = (rect.width - target.padding * 3.0) * 0.45
  }
  return result
}
// File, buffer and resource pickers: a list that scrolls smoothly beside an
// optional syntax-highlighted preview.
fn draw_picker(renderer: rawptr, app: *App, typography: *Typography, width: i32, height: i32, status: f32) {
  counts := picker_state_counts(app)
  count := counts.count
  selected := counts.selected
  geometry := picker_geometry(app, typography, width, height, status, count)
  animated_rect := animated_surface(app, SurfacePicker, geometry.rect, typography.scale)
  geometry = picker_visual_geometry(typography, geometry, animated_rect)
  rect := geometry.rect
  placed_rects[SurfacePicker] = rect
  padding := geometry.padding
  rows := geometry.rows
  preview := geometry.preview
  scale := typography.scale
  line := typography.line
  viewport_changed := app.picker_state.rows != rows
  app.picker_state.rows = rows
  buffers := app.prompt_state.panel == .Buffers
  ui := &app.ui
  ui_panel_begin(ui, typography)
  opening := app.view.animation.panel != .Open && app.view.animation.panel != .Buffers
  frame := ui_make(ui, ui_hash(0, "picker"), UiFloating | UiBackground | UiBorder | UiClip)
  ui.boxes[frame].floating[0] = rect.x
  ui.boxes[frame].floating[1] = rect.y
  ui.boxes[frame].fill = theme().surface
  ui.boxes[frame].padding[0] = padding
  ui.boxes[frame].padding[1] = padding
  ui_size(ui, frame, UiAxisX, .Pixels, rect.width / scale, 1.0)
  ui_size(ui, frame, UiAxisY, .Pixels, rect.height / scale, 1.0)
  ui_push(ui, frame)
  head := mem.push_bytes(ui.frame_arena, 8192)
  used: usize = 0
  if buffers {
    add_text(head, &used, "buffers > ")
  } else {
    case app.resource_state.kind {
      .Themes => { add_text(head, &used, "themes > ") }
      .Layouts => { add_text(head, &used, "layouts > ") }
      .Languages => {
        if app.language_manager.searching {
          add_text(head, &used, "languages / filter > ")
        } else {
          if app.language_manager.visual {
            add_text(head, &used, "languages VISUAL (")
          } else {
            add_text(head, &used, "languages (")
          }
          add_number(head, &used, language_manager_marked(app))
          add_text(head, &used, " marked) > ")
        }
      }
      .TaskOutput => { add_text(head, &used, "task diagnostics > ") }
      .Recovery => { add_text(head, &used, "recovery snapshots > ") }
      .None, .Settings => {}
    }
  }
  add_text(head, &used, app.prompt_state.text[..app.prompt_state.length])
  add_text(head, &used, "_")
  header := ui_label(ui, "header", head[..used], 0)
  ui_size(ui, header, UiAxisX, .Percent, 1.0, 0.0)
  spacer := ui_make(ui, ui_key(ui, "above divider"), 0)
  ui_size(ui, spacer, UiAxisY, .Pixels, line * 0.5 / scale, 1.0)
  divider := ui_make(ui, ui_key(ui, "divider"), UiBackground)
  ui.boxes[divider].fill = theme().border
  ui_size(ui, divider, UiAxisX, .Percent, 1.0, 1.0)
  ui_size(ui, divider, UiAxisY, .Pixels, 1.0, 1.0)
  below := ui_make(ui, ui_key(ui, "below divider"), 0)
  ui_size(ui, below, UiAxisY, .Pixels, line * 0.5 / scale - 1.0, 1.0)
  body := ui_make(ui, ui_key(ui, "body"), 0)
  ui.boxes[body].axis = UiAxisX
  ui_size(ui, body, UiAxisX, .Percent, 1.0, 1.0)
  ui_size(ui, body, UiAxisY, .Pixels, line * #cast(f32, rows) / scale, 1.0)
  ui_push(ui, body)
  list := ui_make(ui, ui_key(ui, "list"), UiClip | UiScroll)
  ui_size(ui, list, UiAxisX, .Pixels, geometry.list_width / scale, 1.0)
  ui_size(ui, list, UiAxisY, .Percent, 1.0, 1.0)
  ui_list_scroll(app, ui, list, count, selected, line * #cast(f32, rows), opening, opening || viewport_changed || selected != ui.picker_selected || count != ui.picker_count)
  // A resized viewport must not leave the unchanged selection clipped while
  // its former scroll offset catches up. Normal navigation still glides.
  if viewport_changed {
    motion.snap(&ui.boxes[list].scroll, ui.boxes[list].scroll_target)
  }
  window := ui_list_window(ui, list, count, line * #cast(f32, rows))
  ui_push(ui, list)
  preview_box: usize = 0
  ui_spacer(ui, "above", #cast(f32, window.first) * line)
  label := mem.push_bytes(ui.frame_arena, 8192)
  for row in window.first..window.last {
    length: usize = 0
    key: u64 = 0
    if buffers {
      slot := app.documents.slots[buffer_match(app, row)]
      name := files.name(&slot.file)
      key = ui_hash_number(ui.boxes[list].key, slot.identity & 1099511627775)
      if buffer_match(app, row) == app.documents.active {
        add_text(label[..], &length, "* ")
      }
      if buffer.dirty_cached(slot.document) {
        add_text(label[..], &length, "+ ")
      }
      if slot.terminal.handle != nil {
        add_text(label[..], &length, "Terminal")
      } else if name.len == 0 {
        add_text(label[..], &length, "Untitled")
      } else {
        leaf := name.len
        for leaf > 0 && name[leaf - 1] != '/' {
          leaf -= 1
        }
        add_text(label[..], &length, name[leaf..])
        add_text(label[..], &length, "  ")
        add_text(label[..], &length, name[..leaf])
      }
    } else {
      entry := &app.completion.entries[row]
      if app.resource_state.kind == .Languages {
        if row == selected {
          add_text(label[..], &length, "> ")
        } else {
          add_text(label[..], &length, "  ")
        }
      }
      add_text(label[..], &length, entry.name[..entry.length])
      key = ui_hash(ui.boxes[list].key, entry.name[..entry.length])
    }
    item := ui_make(ui, key, UiClickable | UiHover | UiText)
    ui_text_set(ui, item, label[..length])
    ui.boxes[item].value = row
    ui.boxes[item].padding[0] = typography.cell
    ui_size(ui, item, UiAxisX, .Percent, 1.0, 1.0)
    ui_size(ui, item, UiAxisY, .Pixels, line / scale, 1.0)
    highlighted := row == selected
    if !buffers && app.resource_state.kind == .Languages {
      language := app.language_manager.rows[row]
      if language < app.language_manager.entry_count && app.language_manager.entries[language].marked {
        highlighted = true
      }
    }
    ui_animate(app, ui, item, highlighted)
  }
  ui_spacer(ui, "below", #cast(f32, (count - window.last)) * line)
  if count == 0 {
    empty_text: str = "No matches"
    if !buffers && app.resource_state.kind == .None && !app.resource_state.fonts && app.picker_state.pending {
      empty_text = "Loading files..."
    }
    empty := ui_label(ui, "empty", empty_text, UiMuted)
    ui.boxes[empty].padding[0] = typography.cell
  }
  ui_pop(ui)
  if preview {
    gutter := ui_make(ui, ui_key(ui, "gutter"), 0)
    ui.boxes[gutter].axis = UiAxisX
    ui_size(ui, gutter, UiAxisX, .Pixels, padding / scale, 1.0)
    ui_size(ui, gutter, UiAxisY, .Percent, 1.0, 1.0)
    ui_push(ui, gutter)
    before := ui_make(ui, ui_key(ui, "before"), 0)
    ui_size(ui, before, UiAxisX, .Pixels, padding * 0.5 / scale, 1.0)
    separator := ui_make(ui, ui_key(ui, "separator"), UiBackground)
    ui.boxes[separator].fill = theme().border
    ui_size(ui, separator, UiAxisX, .Pixels, 1.0, 1.0)
    ui_size(ui, separator, UiAxisY, .Percent, 1.0, 1.0)
    ui_pop(ui)
    preview_box = ui_make(ui, ui_key(ui, "preview"), UiClip)
    ui_size(ui, preview_box, UiAxisX, .Percent, 1.0, 0.0)
    ui_size(ui, preview_box, UiAxisY, .Percent, 1.0, 1.0)
  }
  ui_pop(ui)
  if geometry.footer {
    footer: [512]u8
    footer_length: usize = 0
    if count > 0 {
      add_number(footer[..], &footer_length, selected + 1)
    } else {
      add_number(footer[..], &footer_length, 0)
    }
    add_text(footer[..], &footer_length, "/")
    add_number(footer[..], &footer_length, count)
    if app.resource_state.kind == .Languages {
      add_text(footer[..], &footer_length, "  i install  x remove  u update  R server  space/v mark  / filter")
    } else {
      add_text(footer[..], &footer_length, "  arrows choose  enter opens  double-click opens")
    }
    if buffers {
      add_text(footer[..], &footer_length, "  ctrl-x closes buffer")
    }
    add_text(footer[..], &footer_length, "  esc cancels")
    if !buffers && app.picker_state.index != nil {
      if app.picker_state.pending {
        add_text(footer[..], &footer_length, "  [indexing]")
      }
      if app.picker_state.index.limited {
        add_text(footer[..], &footer_length, "  [index limited]")
      }
      if app.completion.error {
        add_text(footer[..], &footer_length, "  [some paths unreadable]")
      }
    }
    // Keep the footer on the bottom edge: fill the remaining height first.
    filler := ui_make(ui, ui_key(ui, "filler"), 0)
    ui_size(ui, filler, UiAxisY, .Percent, 1.0, 0.0)
    footer_box := ui_label(ui, "footer", footer[..footer_length], UiMuted)
    ui_size(ui, footer_box, UiAxisX, .Percent, 1.0, 0.0)
  }
  ui_pop(ui)
  ui.picker_selected = selected
  ui.picker_count = count
  ui_layout(ui)
  ui_render(renderer, ui, typography, width, height)
  if preview {
    area := ui.boxes[preview_box].rect
    path: [4096]u8
    path_length: usize = 0
    doc: *buffer.Document = nil
    if selected < count {
      if buffers {
        chosen := app.documents.slots[buffer_match(app, selected)]
        doc = chosen.document
        path_length = copy_text(path[..], files.name(&chosen.file))
      } else {
        candidate := &app.completion.entries[selected]
        add_text(path[..], &path_length, app.completion.prefix[..app.completion.prefix_length])
        add_text(path[..], &path_length, candidate.name[..candidate.length])
      }
    }
    colors: str = ""
    if !buffers && app.resource_state.kind == .Languages {
      details := mem.push_bytes(ui.frame_arena, 8192)
      columns := #cast(usize, (area.width / typography.cell))
      if columns > 1 {
        columns -= 1
      }
      preview_show(app, typography, details[..language_manager_details(app, details, columns)])
    } else {
      preview_update(app, typography, path[..path_length], doc)
    }
    shown := app.picker_state.preview.bytes[..app.picker_state.preview.length]
    if buffers || app.resource_state.kind != .Languages {
      colors = picker_preview_colors(app, path[..path_length], doc, shown)
    }
    preview_spans_update(typography, &typography.picker_spans, typography.preview_text, shown, colors)
    preview_clip := platform.PixelRect{x: #cast(i32, area.x), y: #cast(i32, area.y), width: #cast(i32, area.width), height: #cast(i32, area.height)}
    if !platform.clip(renderer, &preview_clip) || !ttf.draw(typography.preview_text, area.x, area.y) {
      #panic("picker preview draw")
    }
    preview_spans_draw(&typography.picker_spans, area.x, area.y)
    if !platform.clip(renderer, nil) {
      #panic("picker preview reset")
    }
  }
}

fn picker_release(app: *App) {
  picker_index_close(app)
  if app.picker_state.index != nil {
    arena_owner.release(app.picker_state.arena)
    app.picker_state.arena = nil
    app.picker_state.index = nil
  }
}
// Click selects a row; double-click opens it; clicking outside cancels.
fn picker_ui_mouse(app: *App, typography: *Typography, x: f32, y: f32, pressed: bool, moved: bool, clicks: u8) {
  ui := &app.ui
  if !app.config.mouse_enabled { return }
  if moved {
    ui_pointer(ui, x, y)
    return
  }
  if !pressed { return }
  hit := ui_hit(ui, x, y)
  if hit == 0 {
    frame := ui_make_lookup(ui, ui_hash(0, "picker"))
    if frame == 0 || !ui_contains(ui.boxes[frame].rect, x, y) {
      key_input(app, typography, KeyEscape, 0)
    }
    return
  }
  row := ui.boxes[hit].value
  if app.prompt_state.panel == .Buffers {
    buffer_matches(app)
    if row >= app.prompt_state.match_count { return }
    app.prompt_state.selected = row
  } else {
    if row >= app.completion.count { return }
    app.completion.selected = row
    app.completion.chosen = true
    if app.resource_state.kind == .Languages {
      language_manager_visual_extend(app)
    }
  }
  if clicks >= 2 {
    submit(app, typography)
  }
}
