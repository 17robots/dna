#target(kernel: windows)
use server_files "../filesystem"
fn server_path_separator()u8 {
  return 59
}
fn server_path_component(text: str)str {
  if text.len >= 2 && text[0] == 34 && text[text.len - 1] == 34 { return text[1..text.len - 1] }
  return text
}
fn server_pathext(storage: []u8) str {
  configured := host.environment("PATHEXT", storage) catch {
    return ".COM;.EXE;.BAT;.CMD"
  }
  return configured
}
fn server_executable(path: str)bool {
  leaf: usize = 0
  for at in 0..path.len {
    if path[at] == 47 || path[at] == 92 {
      leaf = at + 1
    }
  }
  for at in leaf..path.len {
    if path[at] == 46 { return server_files.executable(path) }
  }
  storage: [4096]u8
  extensions := server_pathext(storage[..])
  at: usize = 0
  for at < extensions.len {
    end := at
    for end < extensions.len && extensions[end] != 59 {
      end += 1
    }
    suffix := extensions[at..end]
    if suffix.len > 1 && suffix[0] == 46 && path.len + suffix.len < 4608 {
      candidate: [4608]u8
      valid := true
      for byte in suffix {
        if byte == 47 || byte == 92 || byte == 34 || byte == 58 {
          valid = false
        }
      }
      if valid {
        length := copy_text(candidate[..], path)
        add_text(candidate[..], &length, suffix)
        if server_files.executable(candidate[..length]) { return true }
      }
    }
    at = end + 1
  }
  return false
}
