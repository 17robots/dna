use "../../src/layout" layout
fn main() {
  good := layout.parse("# popup\npopup_width = 0.8\npopup_height=0.6\nfont_size=22\n")
  if !good.valid || good.width != 0.8 || good.height != 0.6 || good.font_size != 22.0 {
    #panic("valid layout")
  }
  reduced := layout.parse("reduced_motion=1")
  if !reduced.valid || !reduced.reduced_motion || layout.parse("reduced_motion=2").valid || layout.parse("reduced_motion=0\nreduced_motion=1").valid {
    #panic("reduced motion setting")
  }
  hidden := layout.parse("line_numbers=0\nrelative_numbers=0\nstatus_line=0\nhighlight_line=0")
  if !hidden.valid || hidden.line_numbers || hidden.relative_numbers || hidden.status_line || hidden.highlight_line {
    #panic("chrome layout settings")
  }
  if layout.parse("status_line=2").valid || layout.parse("status_line=0\nstatus_line=1").valid {
    #panic("invalid chrome settings")
  }
  if layout.parse("popup_width=0.1").valid || layout.parse("font_size=100").valid || layout.parse("unknown=1").valid || layout.parse("font_size=20\nfont_size=21").valid || layout.parse("font_size=NaN").valid {
    #panic("invalid layout accepted")
  }
  nested := layout.parse("tree=\"v70(f,h50(f,f))\"\n")
  if !nested.valid || nested.node_count != 5 || !nested.nodes[0].vertical || nested.nodes[2].vertical || nested.nodes[0].percent != 70 {
    #panic("nested layout")
  }
  if layout.parse("tree=\"v99(f,f)\"\n").valid || layout.parse("tree=\"h50(f)\"\n").valid {
    #panic("invalid layout tree")
  }
}
