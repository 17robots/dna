use "std/font/system" fonts
use "std/mem"
use "std/bytes" byte_ops

// The C ABI stays unchanged while discovery moves to the shared Dyn layer.
// Only TrueType faces supported by std/font are listed: CFF and TTC fonts
// are skipped. Platform directories are scanned, without Fontconfig aliases,
// configuration or registry lookup. Explicit family misses return failure.
const font_scan_limit: usize = 4096

fn font_entries(arena: *mem.Arena) []fonts.Entry {
  entries := fonts.scan(arena, font_scan_limit)
  used: usize = 0
  for i in 0..#len(entries) {
    if entries[i].monospace {
      entries[used] = entries[i]
      used += 1
    }
  }
  return entries[..used]
}

pub fn dna_fonts(output: *u8, capacity: usize) usize {
  return font_values(output, capacity, false)
}

pub fn dna_font_families(output: *u8, capacity: usize) usize {
  return font_values(output, capacity, true)
}

fn font_values(output: *u8, capacity: usize, families: bool) usize {
  if output == nil || capacity == 0 {
    return 0
  }
  output.* = 0
  arena := mem.arena_create(65536)
  defer mem.arena_release(arena)
  entries := font_entries(arena)
  used: usize = 0
  for i in 0..#len(entries) {
    text := entries[i].path
    if families {
      text = entries[i].family
    }
    // One entry per line. Family queries list each family once, regardless
    // of the number of weights/styles installed under that name.
    duplicate: bool = false
    if families {
      for j in 0..i {
        if byte_ops.equal(entries[j].family, text) {
          duplicate = true
          break
        }
      }
    }
    for byte in text {
      if byte == 10 || byte == 13 {
        duplicate = true
      }
    }
    if duplicate {
      continue
    }
    length := #len(text)
    if capacity - used < 2 || length > capacity - used - 2 {
      break
    }
    _ = mem.copy(output[..capacity][used..used + length], text)
    used += length
    output[..capacity][used] = 10
    used += 1
  }
  output[..capacity][used] = 0
  return used
}

pub fn dna_default_font(output: *u8, capacity: usize) i32 {
  generic: []const u8 = "monospace\0"
  return dna_match_font(&generic[0], output, capacity)
}

fn font_generic_monospace(family: []const u8) bool {
  generic: []const u8 = "monospace"
  if #len(family) != #len(generic) {
    return false
  }
  for i in 0..#len(generic) {
    byte := family[i]
    if byte >= 65 && byte <= 90 {
      byte += 32
    }
    if byte != generic[i] {
      return false
    }
  }
  return true
}

pub fn dna_match_font(family: *const u8, output: *u8, capacity: usize) i32 {
  if family == nil || family.* == 0 || output == nil || capacity < 2 {
    return 0
  }
  arena := mem.arena_create(65536)
  defer mem.arena_release(arena)
  entries := font_entries(arena)
  requested := family[..string_length(family)]
  matched: *const fonts.Entry = &fonts.nil_entry
  if font_generic_monospace(requested) {
    matched = fonts.monospace(entries)
  }
  else {
    matched = fonts.find(entries, requested, 400, false)
  }
  length := #len(matched.path)
  if length == 0 || length >= capacity {
    return 0
  }
  _ = mem.copy(output[..length], matched.path)
  output[..capacity][length] = 0
  return 1
}
