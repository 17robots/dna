// Main-thread palette shared by the Dyn UI and the terminal adapter.
light_theme: bool = false
colors: [32]u32 = []
mask: u32 = 0
generation: u32 = 0

pub fn dna_theme_mode() i32 {
  if light_theme {
    return 1
  }
  return 0
}
pub fn dna_theme_select(light: bool) {
  light_theme = light
  mask = 0
  bump_generation()
}
fn bump_generation() {
  if generation == 4294967295 {
    generation = 0
  } else {
    generation += 1
  }
}
pub fn dna_theme_override(index: u32) u32 {
  if index < 32 && (mask & (#cast(u32) 1 << index)) != 0 {
    return colors[index]
  }
  return 16777216
}
pub fn dna_theme_set_override(index: u32, color: u32) {
  if index >= 32 || color > 16777215 {
    return
  }
  colors[index] = color
  mask |= #cast(u32) 1 << index
  bump_generation()
}
pub fn dna_theme_generation() u32 {
  return generation
}
