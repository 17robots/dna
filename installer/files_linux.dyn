#target(kernel: linux)
fn installer_symbolic_link(target, path:[]const u8) std_fs.Result { return std_fs.symbolic_link(target,path) }
fn installer_read_link(arena:*mem.Arena, path:[]const u8) std_fs.PathResult { return std_fs.read_link(arena,path) }
fn installer_remove_tree(path:[]const u8) std_fs.Result {
  frames:[128]std_fs.RemovalFrame=[]
  scratch:[65536]u8=[]
  return std_fs.remove_tree(path,frames[..],scratch[..])
}
