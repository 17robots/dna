// Direct SDL_ttf bindings. Text objects and their glyph atlas stay on the UI
// thread and are destroyed before their font, engine, and SDL renderer.
pub extern fn init "TTF_Init"() bool
pub extern fn quit "TTF_Quit"()
pub extern fn open "TTF_OpenFont"(path: *const u8, points: f32) rawptr
pub extern fn close "TTF_CloseFont"(font: rawptr)
pub extern fn font_size "TTF_SetFontSize"(font: rawptr, points: f32) bool
pub extern fn line_skip "TTF_SetFontLineSkip"(font: rawptr, pixels: i32)
pub extern fn measure "TTF_GetStringSize"(font: rawptr, text: *const u8, length: usize, width: *i32, height: *i32) bool
pub extern fn engine "TTF_CreateRendererTextEngine"(renderer: rawptr) rawptr
pub extern fn destroy_engine "TTF_DestroyRendererTextEngine"(engine: rawptr)
pub extern fn create "TTF_CreateText"(engine: rawptr, font: rawptr, text: *const u8, length: usize) rawptr
pub extern fn destroy "TTF_DestroyText"(text: rawptr)
pub extern fn set "TTF_SetTextString"(text: rawptr, bytes: *const u8, length: usize) bool
pub extern fn wrap "TTF_SetTextWrapWidth"(text: rawptr, pixels: i32) bool
pub extern fn color "TTF_SetTextColor"(text: rawptr, red: u8, green: u8, blue: u8, alpha: u8) bool
pub extern fn draw "TTF_DrawRendererText"(text: rawptr, x: f32, y: f32) bool
pub extern fn size "TTF_GetTextSize"(text: rawptr, width: *i32, height: *i32) bool
pub struct Substring { flags: u32, offset: i32, length: i32, line: i32, cluster: i32, x: i32, y: i32, width: i32, height: i32 }
pub extern fn substring "TTF_GetTextSubString"(text: rawptr, offset: i32, output: *Substring) bool
