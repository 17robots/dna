use "std/io"
fn main() {
  bytes: [256]u8 = []
  for index in 0..256 {
    bytes[index] = #cast(u8, index)
  }
  destination: [258]u8 = []
  destination[0] = 71
  destination[257] = 73
  _ = copy_bytes(&destination[1], &bytes[0], 256)
  for index in 0..256 {
    if destination[index+1] != #cast(u8, index) {
      #panic("bulk copy")
    }
  }
  if compare_bytes(&bytes[0], &destination[1], 256)!=0 || compare_bytes(&bytes[0], &destination[1], 0)!=0 {
    #panic("binary byte comparison")
  }
  destination[129]=127
  if compare_bytes(&bytes[0], &destination[1], 256)<=0 || compare_bytes(&destination[1], &bytes[0], 256)>=0 {
    #panic("unsigned byte comparison")
  }
  destination[129]=128
  if find_byte(&bytes[0], 0, 256)!=#cast(rawptr, &bytes[0]) || find_byte(&bytes[0], 255, 256)!=#cast(rawptr, &bytes[255]) || find_byte(&bytes[0], 255, 255)!=nil || find_byte(&bytes[0], 0, 0)!=nil || find_byte(&bytes[0], 257, 256)!=#cast(rawptr, &bytes[1]) {
    #panic("bounded binary byte search")
  }
  _ = move_bytes(&destination[2], &destination[1], 255)
  for index in 0..255 {
    if destination[index+2] != #cast(u8, index) {
      #panic("overlapping bulk move right")
    }
  }
  _ = move_bytes(&destination[1], &destination[2], 255)
  for index in 0..255 {
    if destination[index+1] != #cast(u8, index) {
      #panic("overlapping bulk move left")
    }
  }
  if destination[0] != 71 || destination[257] != 73 {
    #panic("bulk bounds")
  }
  _ = copy_bytes(&destination[1], &bytes[0], 0)
  test_fill(destination[..])
  _ = io.println(io.stdout(), "PASS bulk_memory: copy, overlap, fill, compare, search and bounds")
}
