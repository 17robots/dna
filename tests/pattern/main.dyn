use "../../src/pattern" pattern
fn main() {
  compiled := pattern.open("a(lpha)|é+")
  defer pattern.close(&compiled)
  if !compiled.ok {
    #panic("compile regex")
  }
  first := pattern.find(&compiled, "alpha éé z", 0)
  second := pattern.find(&compiled, "alpha éé z", first.end)
  if !first.found || first.start != 0 || first.end != 5 || !second.found || second.start != 6 || second.end != 10 {
    #panic("regex UTF8 matches")
  }
  invalid := pattern.open("(")
  defer pattern.close(&invalid)
  if invalid.ok {
    #panic("invalid pattern accepted")
  }
  byte_pattern := pattern.open("\\C")
  defer pattern.close(&byte_pattern)
  if byte_pattern.ok {
    #panic("byte matching must be disabled")
  }
  zero := pattern.open("(?=é)")
  defer pattern.close(&zero)
  empty := pattern.find(&zero, "aé", 0)
  if !empty.found || empty.start != 1 || empty.end != 1 {
    #panic("zero-width Unicode match")
  }
  unicode := pattern.open("\\w+")
  defer pattern.close(&unicode)
  word := pattern.find(&unicode, "é中", 0)
  if !word.found || word.end != 5 {
    #panic("Unicode character class")
  }
  expensive := pattern.open("(*NO_START_OPT)(a+)+$")
  defer pattern.close(&expensive)
  limited := pattern.find(&expensive, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!", 0)
  if !limited.error {
    #panic("regex work limit")
  }
  multiline := pattern.open_lines("^needle")
  defer pattern.close(&multiline)
  later := pattern.find(&multiline, "first\nneedle\n", 0)
  if !later.found || later.start != 6 || later.end != 12 {
    #panic("project multiline semantics")
  }
}
