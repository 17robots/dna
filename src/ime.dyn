struct Composition {
  bytes: [4096]u8,
  length: usize,
  start, selected: i32,
  // The surrounding text last published to the input method: its token,
  // where it starts in the document, and the document revision it describes.
  surrounding_token: u64,
  surrounding_base: usize,
  surrounding_revision: u64,
  surrounding_document: *buffer.Document,
}

// Bytes of context published on each side of the caret, within its line.
const SurroundingSide: usize = 1800

// Publish the caret's line (bounded) so input methods can see what they edit:
// reconversion, deleting before the caret, autocorrection.
fn surrounding_publish(window: rawptr, app: *App) {
  composition := &app.composition
  if !app.view.insert || app.prompt_state.panel != .None || app.documents.slots[app.documents.active].terminal.handle != nil {
    composition.surrounding_token = 0
    return
  }
  doc := app.documents.current
  cursor := doc.cursor
  anchor := doc.anchor
  low := buffer.line_start(doc, cursor)
  high := buffer.line_end(doc, cursor)
  if cursor > low + SurroundingSide {
    low = cursor - SurroundingSide
  }
  if high > cursor + SurroundingSide {
    high = cursor + SurroundingSide
  }
  // Keep both ends on UTF-8 boundaries.
  for low < cursor && (buffer.byte_at(doc, low) & 192) == 128 {
    low += 1
  }
  for high > cursor && high < doc.length && (buffer.byte_at(doc, high) & 192) == 128 {
    high -= 1
  }
  if anchor < low || anchor > high {
    anchor = cursor
  }
  text: [4096]u8
  buffer.copy_range(doc, low, high, text[..])
  token := platform.surrounding(window, text[..high - low], cursor - low, anchor - low)
  composition.surrounding_token = token
  composition.surrounding_base = low
  composition.surrounding_revision = doc.revision
  composition.surrounding_document = doc
}

// The input method replaced bytes of the published context. Apply it only
// when the document is still exactly what was published.
fn surrounding_edit_apply(app: *App) {
  edit := platform.ime_edit()
  composition := &app.composition
  doc := app.documents.current
  if edit.token == 0 || edit.token != composition.surrounding_token || doc != composition.surrounding_document || doc.revision != composition.surrounding_revision || !app.view.insert {
    return
  }
  low := composition.surrounding_base + edit.start
  high := composition.surrounding_base + edit.end
  if high < low || high > doc.length || !buffer.valid(edit.text) { return }
  doc.anchor = low
  doc.cursor = high
  if !buffer.replace(doc, edit.text) {
    status_error(app, "Input method edit exceeds document capacity.")
    return
  }
  doc.anchor = low + edit.text.len
  doc.cursor = doc.anchor
  composition.surrounding_token = 0
  platform.ime_edit_applied()
}


fn composition_update(app: *App, event: *const platform.EditingEvent) {
  app.composition.length = 0
  if !wants_text_input(app) || event.text == nil { return }
  length := c.string_length(event.text, 4096)
  if length == 4096 || !buffer.valid(#slice(event.text, length)) { return }
  app.composition.length = copy_text(app.composition.bytes[..], #slice(event.text, length))
  app.composition.start = event.start
  app.composition.selected = event.length
}
fn composition_draw(renderer: rawptr, window: rawptr, app: *App, typography: *Typography, width: i32, height: i32) {
  if !wants_text_input(app) {
    app.composition.length = 0
    return
  }
  x := app.config.document_padding * typography.scale
  y := #cast(f32, height) - typography.line * 3.0
  if app.prompt_state.panel == .None && app.documents.slots[app.documents.active].terminal.handle == nil {
    pane := &app.view.panes[app.view.focused]
    x = #cast(f32, pane.rect.x) + app.view.animation.file.cursor_x.value
    y = #cast(f32, pane.rect.y) + app.view.animation.file.cursor_y.value
  }
  if x < 0.0 {
    x = 0.0
  }
  if y < 0.0 {
    y = 0.0
  }
  if x > #cast(f32, width) - typography.cell {
    x = #cast(f32, width) - typography.cell
  }
  if y > #cast(f32, height) - typography.line {
    y = #cast(f32, height) - typography.line
  }
  logical_width: i32 = 0
  logical_height: i32 = 0
  if platform.window_size(window, &logical_width, &logical_height) && width > 0 && height > 0 {
    sx := #cast(f32, logical_width) / #cast(f32, width)
    sy := #cast(f32, logical_height) / #cast(f32, height)
    area := platform.PixelRect{x: #cast(i32, (x * sx)), y: #cast(i32, (y * sy)), width: #cast(i32, (typography.cell * sx)), height: #cast(i32, (typography.line * sy))}
    _ = platform.text_area(window, &area, 0)
  }
  surrounding_publish(window, app)
  composition := &app.composition
  if composition.length == 0 { return }
  if !ttf.set(typography.chrome, &composition.bytes[0], composition.length) { return }
  text_width: i32 = 0
  text_height: i32 = 0
  if !ttf.size(typography.chrome, &text_width, &text_height) { return }
  box := platform.Rect{x: x, y: y, width: #cast(f32, text_width) + typography.cell, height: typography.line}
  ui_box(renderer, box, typography.scale)
  if !tint(typography.chrome, theme().text) || !ttf.draw(typography.chrome, x, y) { return }
  underline := platform.Rect{x: x, y: y + typography.line - typography.scale * 2.0, width: #cast(f32, text_width), height: typography.scale}
  _ = paint(renderer, theme().text)
  _ = platform.fill(renderer, &underline)
}
