struct SpanText {
  text: rawptr,
  revision: u64,
  identity: u64,
  start: usize,
  end: usize,
  viewport_start: usize,
  viewport_end: usize,
  geometry_ready: bool,
  text_ready: bool,
  first: ttf.Substring,
  last: ttf.Substring,
  origin: ttf.Substring,
}
struct DisplayCounts {
  ready: bool,
  revision: u64,
  identity: u64,
  position: usize,
  column: usize,
  low: usize,
  high: usize,
  selected: usize,
}
struct CaretGeometry {value:ttf.Substring, text:rawptr, position:usize, ready:bool}
struct PaneText {
  owner:*mem.Arena,
  born:u64,
  caret_geometry:CaretGeometry,
  counts: DisplayCounts,
  caret: rawptr,
  caret_document: *const buffer.Document,
  spans: [128]SpanText,
  layout: LineLayout,
  text: rawptr,
  document: *buffer.Document,
  caret_revision: u64,
  revision: u64,
  identity: u64,
  caret_start: usize,
  caret_end: usize,
  start: usize,
  end: usize,
}
struct Typography {
  ui_cache: *UiTextCache,
  observer: *App,
  ui_born: u64,
  ui_owner: *mem.Arena,
  ui_hits, ui_updates, ui_creations: u64,
  pane_text: [15]*PaneText,
  // The cache of the pane being drawn (or last drawn): its text, caret line,
  // layout and what they currently hold.
  pane: *PaneText,
  caret_queries:u64,
  points: f32,
  scale: f32,
  cell: f32,
  line: f32,
  line_height: f32 = 1.25,
  primary_caret: rawptr,
  engine: rawptr,
  primary_document: rawptr,
  syntax_text: rawptr,
  original_font: rawptr,
  fallback_font: rawptr,
  configured_font: rawptr,
  preview_text: rawptr,
  explorer_preview: rawptr,
  explorer_preview_hash: u64,
  picker_spans, explorer_spans, hover_spans: PreviewSpans,
  font: rawptr,
  palette: rawptr,
  chrome: rawptr,
  directory_text: rawptr,
  directory_layout: LineLayout,
  palette_bytes: [16384]u8,
  directory_start: usize,
  directory_end: usize,
  current_pane: usize,
  palette_length: usize,
  document_updates: u64,
  rendered_view_revision: u64,
  directory_revision: u64,
  palette_updates: u64,
  palette_wrap: i32 = -1,
}

fn resize_font(typography: *Typography) {
  for pane_index in 0..15 {
    if typography.pane_text[pane_index]!=nil {
      typography.pane_text[pane_index].caret_document=nil
    }
  }
  ui_cache_clear(typography)
  // Terminal cells are fixed: an 8-wide, 16-tall unit per cell, and a font
  // size whose cursor height (size + 5) fills exactly one cell.
  if sdl.tui_active() {
    typography.points = 11.0
    typography.scale = 1.0
    typography.line_height = 1.0
  }
  for pane_index in 0..15 {
    if typography.pane_text[pane_index]==nil {
      continue
    }
    for span_index in 0..128 {
      span := &typography.pane_text[pane_index].spans[span_index]
      span.geometry_ready = false
      span.text_ready = false
    }
  }

  if !ttf.font_size(typography.font, typography.points * typography.scale) {
    #panic("font resize failed")
  }
  if typography.fallback_font != nil {
    _ = ttf.font_size(typography.fallback_font, typography.points * typography.scale)
  }

  requested := typography.points * typography.scale * typography.line_height
  pixels := #cast(i32, requested)
  if #cast(f32, pixels) < requested {
    pixels += 1
  }
  // Tall faces need more than nominal em height. In particular, forcing Noto
  // Sans Mono into a 1.25-em row clips descenders in status bars and lists.
  minimum := ttf.font_height(typography.font)
  if typography.fallback_font != nil {
    fallback_minimum := ttf.font_height(typography.fallback_font)
    if minimum < fallback_minimum {
      minimum = fallback_minimum
    }
  }
  if pixels < minimum {
    pixels = minimum
  }
  typography.line = #cast(f32, pixels)
  if sdl.tui_active() {
    typography.line = sdl.CellHeight
  }
  ttf.line_skip(typography.font, #cast(i32, typography.line))
  glyph: [2]u8 = [77, 0]
  width: i32 = 0
  height: i32 = 0

  if !ttf.measure(typography.font, &glyph[0], 1, &width, &height) {
    #panic("font measure failed")
  }

  typography.cell = #cast(f32, width)
}

// Each rendered pane owns its metadata and line/span cache. Closed, branch and
// never-drawn panes need no backing storage. Font invalidation never creates it.
fn pane_text_get(typography:*Typography, index:usize)*PaneText {
  if index>=15 {
    #panic("invalid typography pane")
  }
  if typography.pane_text[index]==nil {
    owner:=arena_owner.create(#sizeof(PaneText)+16)
    cached:=mem.push(PaneText, owner)
    cached.owner=owner
    if typography.observer!=nil {
      if typography.observer.render_trace.enabled {
        cached.born=render_clock()
      }
      allocation_record(typography.observer, "pane_text", #sizeof(PaneText)+16, cached.born, false)
    }
    typography.pane_text[index]=cached
  }
  return typography.pane_text[index]
}
// The pane's cache with its text and caret objects created. Pane 0 uses the
// primary objects made at startup.
fn pane_text_ready(typography:*Typography, index:usize)*PaneText {
  cached:=pane_text_get(typography, index)
  if cached.text==nil {
    if index==0 {
      cached.text=typography.primary_document
    } else {
      blank:[1]u8=[0]
      cached.text=ttf.create(typography.engine, typography.font, &blank[0], 0)
    }
    if cached.text==nil || !ttf.whitespace_visible(cached.text, true) || !ttf.wrap(cached.text, 0) {
      #panic("pane text allocation")
    }
  }
  if cached.caret==nil {
    if index==0 {
      cached.caret=typography.primary_caret
    } else {
      caret_blank:[1]u8=[0]
      cached.caret=ttf.create(typography.engine, typography.font, &caret_blank[0], 0)
    }
    if cached.caret==nil || !ttf.whitespace_visible(cached.caret, true) || !ttf.wrap(cached.caret, 0) {
      #panic("pane caret allocation")
    }
  }
  return cached
}
// The current pane cache, falling back to pane 0 before any pane has drawn.
fn current_pane_text(typography:*Typography)*PaneText {
  if typography.pane==nil {
    typography.pane=pane_text_ready(typography, 0)
  }
  return typography.pane
}
