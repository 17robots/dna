// Dropdown picker module: pickers and the command palette hang from the top
// edge of the window, like a menu pulled down from the title bar.
fn picker_dropdown_rect(width: i32, content_height: f32, scale: f32) sdl.Rect {
  box_width := 760.0 * scale
  if box_width > #cast(f32) width * 0.6 {
    box_width = #cast(f32) width * 0.6
  }
  if box_width < 320.0 * scale {
    box_width = #cast(f32) width
  }
  return sdl.Rect{x: (#cast(f32) width - box_width) / 2.0, y: 0.0, width: box_width, height: content_height}
}
