// italic: syntax styles drawn in italics where the frontend can (bit 0
// comment, 1 string, 2 keyword, 3 function, 4 type, 5 constant).
pub struct Palette { colors: [32]u32, mask: u32, light: bool, error_line: usize, italic: u8, italic_set: bool }
pub fn italic_styles(value: str) u8 {
  if value.len < 2 || value[0] != 34 || value[value.len - 1] != 34 { return 255 }
  words := value[1..value.len - 1]
  names: [6]str = ["comment", "string", "keyword", "function", "type", "constant"]
  result: u8 = 0
  at: usize = 0
  for at < words.len {
    for at < words.len && words[at] == ' ' {
      at += 1
    }
    end := at
    for end < words.len && words[end] != ' ' {
      end += 1
    }
    if end > at {
      found := false
      for index in 0..6 {
        if buffer.equal(words[at..end], names[index]) {
          result = result | (#cast(u8, 1) << #cast(u8, index))
          found = true
        }
      }
      if !found { return 255 }
    }
    at = end
  }
  return result
}

pub fn color_key(key: str) usize {
  case key {
    "border" => { return 0 }
    "background" => { return 1 }
    "surface" => { return 2 }
    "line" => { return 3 }
    "text" => { return 4 }
    "muted" => { return 5 }
    "selection" => { return 6 }
    "cursor" => { return 7 }
    "syntax_comment" => { return 8 }
    "syntax_string" => { return 9 }
    "syntax_keyword" => { return 10 }
    "syntax_function" => { return 11 }
    "syntax_type" => { return 12 }
    "syntax_constant" => { return 13 }
    "terminal_black" => { return 14 }
    "terminal_red" => { return 15 }
    "terminal_green" => { return 16 }
    "terminal_yellow" => { return 17 }
    "terminal_blue" => { return 18 }
    "terminal_magenta" => { return 19 }
    "terminal_cyan" => { return 20 }
    "terminal_white" => { return 21 }
    "terminal_bright_black" => { return 22 }
    "terminal_bright_red" => { return 23 }
    "terminal_bright_green" => { return 24 }
    "terminal_bright_yellow" => { return 25 }
    "terminal_bright_blue" => { return 26 }
    "terminal_bright_magenta" => { return 27 }
    "terminal_bright_cyan" => { return 28 }
    "terminal_bright_white" => { return 29 }
    "diagnostic_error" => { return 30 }
    "diagnostic_warning" => { return 31 }
    _ => {}
  }
  return 32
}
pub fn parse_palette(source: str, result: *Palette) bool {
  result.* = Palette{}
  at: usize = 0
  base_seen: bool = false
  explicit: u32 = 0
  italic_explicit: bool = false
  for at < source.len {
    result.error_line += 1
    end := at
    for end < source.len && source[end] != 10 {
      end += 1
    }
    line := trim(source[at..end])
    at = end + 1
    if line.len == 0 || line[0] == 35 { continue }
    split: usize = 0
    for split < line.len && line[split] != 61 {
      split += 1
    }
    if split == line.len { return false }
    key := trim(line[..split])
    value := trim(line[split + 1..])
    if buffer.equal(key, "base") {
      if base_seen { return false }
      base_seen = true
      // A built-in base fills every colour the file has not set yet; keys
      // after it still override.
      base := Palette{}
      if value.len < 2 || value[0] != 34 || value[value.len - 1] != 34 ||
        !builtin_palette(value[1..value.len - 1], &base) {
        return false
      }
      result.light = base.light
      for index in 0..32 {
        bit := #cast(u32, 1) << #cast(u32, index)
        if (base.mask & bit) != 0 && (explicit & bit) == 0 {
          result.colors[index] = base.colors[index]
          result.mask = result.mask | bit
        }
      }
      if base.italic_set && !italic_explicit {
        result.italic = base.italic
        result.italic_set = true
      }
      continue
    }
    if buffer.equal(key, "italic") {
      styles := italic_styles(value)
      if styles == 255 || italic_explicit { return false }
      result.italic = styles
      result.italic_set = true
      italic_explicit = true
      continue
    }
    index := color_key(key)
    if index == 32 || value.len != 9 || value[0] != 34 || value[1] != 35 || value[8] != 34 {
      return false
    }
    bit := #cast(u32, 1) << #cast(u32, index)
    if (explicit & bit) != 0 { return false }
    explicit = explicit | bit
    color: u32 = 0
    for digit in 2..8 {
      byte := value[digit]
      number: u32 = 16
      if byte >= 48 && byte <= 57 {
        number = byte - 48
      } else if byte >= 65 && byte <= 70 {
        number = #cast(u32, (byte - 65)) + 10
      } else if byte >= 97 && byte <= 102 {
        number = #cast(u32, (byte - 97)) + 10
      }
      if number == 16 { return false }
      color = color * 16 + number
    }
    result.colors[index] = color
    result.mask = result.mask | bit
  }
  result.error_line = 0
  return true
}
