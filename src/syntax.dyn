use "std/sync"

extern fn syntax_open_named "dna_syntax_open_named"(root: *const u8, name: *const u8) rawptr
extern fn syntax_name "dna_syntax_name"(syntax: rawptr) *const u8
extern fn syntax_open "dna_syntax_open"(root: *const u8, filename: *const u8) rawptr
extern fn syntax_update "dna_syntax_update"(syntax: rawptr, text: *const u8, length: u32, revision: u64)
struct SyntaxChange { revision: u64, low, old_high, high, old_length, row, column: u32 }
extern fn syntax_update_changed "dna_syntax_update_changed"(syntax: rawptr, text: *const u8, length: u32, revision: u64, change: *const SyntaxChange)
extern fn syntax_update_begin "dna_syntax_update_begin"(syntax: rawptr, length: u32, revision: u64) *u8
extern fn syntax_update_commit "dna_syntax_update_commit"(syntax: rawptr, length: u32, revision: u64, change: *const SyntaxChange)
struct SyntaxStream {
  context: rawptr,
  read: fn(rawptr, u32, *u32) *const u8,
  done: fn(rawptr),
  length, low, high: u32,
  revision, document_revision: u64,
}
extern fn syntax_stream "dna_syntax_stream"(syntax: rawptr, request: *const SyntaxStream) i32
extern fn syntax_stream_needed "dna_syntax_stream_needed"(syntax: rawptr, revision: u64) i32
// Rope reference counts belong to the UI thread. Workers only mark sources
// done; collection releases snapshots after their last read has finished.
struct SyntaxSnapshot {
  next: *SyntaxSnapshot,
  arena: *mem.Arena,
  text: buffer.TextSnapshot,
  done: sync.AtomicU32,
}
syntax_snapshots: *SyntaxSnapshot = nil
fn syntax_snapshot_read(context: rawptr, byte: u32, length: *u32) *const u8 {
  source := #cast(*SyntaxSnapshot, context)
  bytes := buffer.snapshot_chunk(&source.text, #cast(usize, byte))
  length.* = #cast(u32, #len(bytes))
  if #len(bytes) == 0 {
    return nil
  }
  return &bytes[0]
}
fn syntax_snapshot_done(context: rawptr) {
  sync.store_u32(&#cast(*SyntaxSnapshot, context).done, 1)
}
fn syntax_snapshot_collect() {
  link := &syntax_snapshots
  for link.* != nil {
    source := link.*
    if sync.load_u32(&source.done) == 0 {
      link = &source.next
      continue
    }
    link.* = source.next
    buffer.snapshot_release(&source.text)
    arena_owner.release(source.arena)
  }
}
extern fn syntax_colors "dna_syntax_colors"(syntax: rawptr, output: *u8, length: u32, revision: u64) i32
extern fn syntax_close "dna_syntax_close"(syntax: rawptr)
extern fn syntax_retire "dna_syntax_retire"(syntax: rawptr) i32
extern fn syntax_collect "dna_syntax_collect"(wait: i32)
extern fn language_helper "dna_language_helper"(output: *u8, capacity: usize) i32
extern fn syntax_object "dna_syntax_object"(syntax: rawptr, revision: u64, low: u32, high: u32, kind: u32, count: u32, start: *u32, end: *u32) i32
extern fn syntax_indent "dna_syntax_indent"(syntax: rawptr) u32
extern fn syntax_select "dna_syntax_select"(syntax: rawptr, revision: u64, low: u32, high: u32, mode: u32, start: *u32, end: *u32) i32

fn language_root(app: *App) {
  storage: [4096]u8 = []
  configured := host.environment("DNA_LANGUAGE_DIR", storage[..])
  if configured.ok && configured.found {
    app.workspace.language_root_length = copy_text(app.workspace.language_root[..], configured.value)
    language_root_absolute(app)
    return
  }

  base := host.environment("XDG_CONFIG_HOME", storage[..])
  if base.ok && base.found && #len(base.value) > 0 {
    app.workspace.language_root_length = copy_text(app.workspace.language_root[..], base.value)
  } else {
    home := host.environment("HOME", storage[..])
    if !home.ok || !home.found {
      return
    }
    app.workspace.language_root_length = copy_text(app.workspace.language_root[..], home.value)
    add_text(app.workspace.language_root[..], &app.workspace.language_root_length, "/.config")
  }
  add_text(app.workspace.language_root[..], &app.workspace.language_root_length, "/dna/languages")
  language_root_absolute(app)
}
fn language_root_absolute(app: *App) {
  if app.workspace.language_root_length == 0 || app.workspace.language_root[0] == '/' {
    return
  }
  relative: [4096]u8 = []
  length := copy_text(relative[..], app.workspace.language_root[..app.workspace.language_root_length])
  cwd := host.current_directory(app.workspace.language_root[..])
  if cwd <= 0 {
    app.workspace.language_root_length = 0
    return
  }
  app.workspace.language_root_length = cwd
  add_text(app.workspace.language_root[..], &app.workspace.language_root_length, "/")
  add_text(app.workspace.language_root[..], &app.workspace.language_root_length, relative[..length])
}
struct SyntaxState { first, filetype_first, filetype_last: *Slot }
struct SyntaxVisible { indices: [16]usize, count: usize }
// Parser owners form a small maintained list: visible panes plus two cached
// inactive parsers. Opening unrelated buffers never expands this workset.
fn syntax_track(app: *App, slot: *Slot) {
  if slot.syntax == nil || slot.syntax_owner != nil {
    return
  }
  slot.syntax_owner = app
  slot.syntax_previous = nil
  slot.syntax_next = app.syntax_state.first
  if slot.syntax_next != nil {
    slot.syntax_next.syntax_previous = slot
  }
  app.syntax_state.first = slot
}
fn syntax_untrack(slot: *Slot) {
  app := slot.syntax_owner
  if app == nil {
    return
  }
  if slot.syntax_previous == nil {
    app.syntax_state.first = slot.syntax_next
  }
  else {
    slot.syntax_previous.syntax_next = slot.syntax_next
  }
  if slot.syntax_next != nil {
    slot.syntax_next.syntax_previous = slot.syntax_previous
  }
  slot.syntax_owner = nil
  slot.syntax_next = nil
  slot.syntax_previous = nil
}
fn slot_syntax_release(slot: *Slot) {
  syntax_untrack(slot)
  if slot.syntax != nil {
    syntax_close(slot.syntax)
    slot.syntax = nil
  }
  slot.syntax_checked = false
  slot.syntax_revision = 0
  slot.syntax_used = 0
  slot.syntax_window_tag = 0
  slot.syntax_shown_tag = 0
  slot.syntax_shown_high = 0
}
fn syntax_release(app: *App) {
  for index in 0..#len(app.documents.slots) {
    slot_syntax_release(app.documents.slots[index])
  }
  preview_syntax_release(app)
  syntax_collect(1)
  syntax_snapshot_collect()
}
fn syntax_visible(app: *App) SyntaxVisible {
  visible := SyntaxVisible{}
  if app.documents.active < #len(app.documents.slots) {
    visible.indices[0] = app.documents.active
    visible.count = 1
  }
  for index in 0..15 {
    pane := &app.view.panes[index]
    if !pane.used || pane.branch || pane.slot >= #len(app.documents.slots) {
      continue
    }
    found := false
    for previous in 0..visible.count {
      if visible.indices[previous] == pane.slot {
        found = true
      }
    }
    if !found {
      visible.indices[visible.count] = pane.slot
      visible.count += 1
    }
  }
  return visible
}
fn syntax_trim(app: *App) {
  for true {
    count: usize = 0
    oldest: *Slot = nil
    slot := app.syntax_state.first
    for slot != nil {
      next := slot.syntax_next
      if slot.syntax == nil {
        syntax_untrack(slot)
      }
      else if !slot_visible(app, slot.index) {
        count += 1
        if oldest == nil || slot.syntax_used < oldest.syntax_used {
          oldest = slot
        }
      }
      slot = next
    }
    if count <= 2 {
      return
    }
    if syntax_retire(oldest.syntax) == 0 {
      return
    }
    syntax_untrack(oldest)
    oldest.syntax = nil
    oldest.syntax_checked = false
    oldest.syntax_revision = 0
    oldest.syntax_used = 0
  }
}
fn syntax_slot_tick(app: *App, slot: *Slot) bool {
  if slot.document == nil || slot.terminal.handle != nil || (slot.file.length == 0 && slot.filetype_length == 0) {
    return false
  }
  if !slot.syntax_checked {
    if slot.filetype_length == 0 {
      slot.syntax = syntax_open(&app.workspace.language_root[0], &slot.file.path[0])
    }
    else if !buffer.equal(slot.filetype[..slot.filetype_length], "text") {
      slot.syntax = syntax_open_named(&app.workspace.language_root[0], &slot.filetype[0])
    }
    slot.syntax_checked = true
    slot.syntax_window_tag = 0
    slot.syntax_shown_tag = 0
    slot.syntax_shown_high = 0
  }
  syntax_track(app, slot)
  if slot.syntax == nil {
    return false
  }
  slot.syntax_used = sdl.ticks()
  doc := slot.document
  if doc.length >= buffer.LargeFile {
    return syntax_window_tick(slot)
  }
  if slot.syntax_revision == doc.revision {
    return false
  }
  change := buffer.changes_since(doc, slot.syntax_revision)
  if change.found && change.old_length < buffer.LargeFile {
    row := buffer.row_at(doc, change.low)
    hint := SyntaxChange{revision: slot.syntax_revision, low: #cast(u32, change.low), old_high: #cast(u32, change.old_high), high: #cast(u32, change.high), old_length: #cast(u32, change.old_length), row: #cast(u32, row), column: #cast(u32, (change.low - buffer.row_start(doc, row)))}
    syntax_copy(slot.syntax, doc, &hint)
  } else {
    syntax_copy(slot.syntax, doc, nil)
  }
  if syntax_colors(slot.syntax, &slot.colors[0], #cast(u32, doc.length), doc.revision) != 0 {
    slot.syntax_revision = doc.revision
    return true
  }
  return false
}
// Color output extends beyond the drawn view. Parsing reads the whole snapshot.
const SyntaxMargin: usize = 524288
// Parser revisions for windows carry this bit, so they never match a document
// revision: tree queries (objects, selections) stay off in window mode.
const SyntaxWindowBit: u64 = 9223372036854775808
fn syntax_window_needed(slot: *const Slot) bool {
  doc := slot.document
  if slot.syntax_window_tag != 0 {
    covered := slot.syntax_view_low >= slot.syntax_window_low && slot.syntax_view_high <= slot.syntax_window_high
    return !covered || slot.syntax_window_revision != doc.revision
  }
  return true
}
// Largest retained color window while scrolling. Parsing uses the full snapshot.
const SyntaxWindowLimit: usize = 8388608
fn syntax_window_tick(slot: *Slot) bool {
  doc := slot.document
  if doc.length > 4294967294 {
    return false
  }
  if syntax_window_needed(slot) || syntax_stream_needed(slot.syntax, slot.syntax_window_tag) != 0 {
    low: usize = 0
    high := slot.syntax_view_high + SyntaxMargin
    if high > doc.length {
      high = doc.length
    }
    // Keep a stable color origin while nearby views fit the output bound.
    if slot.syntax_window_tag != 0 && slot.syntax_view_low >= slot.syntax_window_low && high >= slot.syntax_window_low && high - slot.syntax_window_low <= SyntaxWindowLimit && slot.syntax_window_low <= doc.length {
      low = slot.syntax_window_low
    } else {
      if slot.syntax_view_low > SyntaxMargin {
        low = slot.syntax_view_low - SyntaxMargin
      }
    }
    if high < low {
      high = low
    }
    if high - low > SyntaxWindowLimit {
      high = low + SyntaxWindowLimit
    }
    tag := ((slot.syntax_window_tag + 1) & (SyntaxWindowBit - 1)) | SyntaxWindowBit
    arena := arena_owner.create(#sizeof(SyntaxSnapshot) + 64)
    source := mem.push(SyntaxSnapshot, arena)
    source.arena = arena
    source.text = buffer.snapshot_take(doc)
    request := SyntaxStream{context: #cast(rawptr, source), read: syntax_snapshot_read, done: syntax_snapshot_done,
      length: #cast(u32, doc.length), low: #cast(u32, low), high: #cast(u32, high), revision: tag, document_revision: doc.revision}
    if syntax_stream(slot.syntax, &request) == 0 {
      buffer.snapshot_release(&source.text)
      arena_owner.release(arena)
      return false
    }
    source.next = syntax_snapshots
    syntax_snapshots = source
    slot.syntax_window_tag = tag
    slot.syntax_window_low = low
    slot.syntax_window_high = high
    slot.syntax_window_revision = doc.revision
  }
  // Older colors stay drawn while a moved window parses at the same revision.
  if slot.syntax_shown_tag == slot.syntax_window_tag {
    return false
  }
  if syntax_colors(slot.syntax, &slot.colors[0], #cast(u32, slot.syntax_window_high - slot.syntax_window_low), slot.syntax_window_tag) != 0 {
    slot.syntax_shown_low = slot.syntax_window_low
    slot.syntax_shown_high = slot.syntax_window_high
    slot.syntax_shown_tag = slot.syntax_window_tag
    slot.syntax_revision = doc.revision
    return true
  }
  return false
}
// Copy the document's chunks straight into the parser's buffer.
fn syntax_copy(syntax: rawptr, doc: *const buffer.Document, change: *const SyntaxChange) {
  if doc.length >= buffer.LargeFile {
    return
  }
  target := syntax_update_begin(syntax, #cast(u32, doc.length), doc.revision)
  if target == nil {
    return
  }
  buffer.copy_range(doc, 0, doc.length, target[..doc.length + 1])
  syntax_update_commit(syntax, #cast(u32, doc.length), doc.revision, change)
}
fn syntax_tick(app: *App) bool {
  syntax_collect(0)
  syntax_snapshot_collect()
  if !app.config.syntax_enabled {
    return false
  }
  changed := false
  visible := syntax_visible(app)
  for item in 0..visible.count {
    if syntax_slot_tick(app, app.documents.slots[visible.indices[item]]) {
      changed = true
    }
  }
  syntax_trim(app)
  if preview_syntax_tick(app) {
    changed = true
  }
  return changed
}
fn syntax_waiting(app: *App) bool {
  if preview_syntax_waiting(app) {
    return true
  }
  if !app.config.syntax_enabled {
    return false
  }
  visible := syntax_visible(app)
  for item in 0..visible.count {
    slot := app.documents.slots[visible.indices[item]]
    if slot.document == nil || slot.syntax == nil {
      continue
    }
    if slot.document.length >= buffer.LargeFile {
      if slot.document.length > 4294967294 {
        continue
      }
      if syntax_window_needed(slot) || slot.syntax_shown_tag != slot.syntax_window_tag {
        return true
      }
    }
    else if slot.syntax_revision != slot.document.revision {
      return true
    }
  }
  return false
}
fn syntax_color(style: u8) Rgb {
  colors := theme()
  if style == 1 {
    return colors.syntax_comment
  }
  if style == 2 {
    return colors.syntax_string
  }
  if style == 3 {
    return colors.syntax_keyword
  }
  if style == 4 {
    return colors.syntax_function
  }
  if style == 5 {
    return colors.syntax_type
  }
  return colors.syntax_constant
}
// Display-only projection while the asynchronous parser catches up. Journal
// ranges identify unchanged prefix/suffix bytes; edited bytes stay uncolored.
// Parser revision checks for selections, objects and indentation remain strict.
fn syntax_display_style(slot:*const Slot, change:buffer.ChangedRange, current:bool, at:usize) u8 {
  if slot.document.length >= buffer.LargeFile {
    if !current || at < slot.syntax_shown_low || at >= slot.syntax_shown_high {
      return 0
    }
    return slot.colors[at - slot.syntax_shown_low]
  }
  // Documents past the color table (only plain-text large files) stay uncolored.
  if at >= #len(slot.colors) || change.old_high + at >= #len(slot.colors) + change.high {
    return 0
  }
  if current {
    return slot.colors[at]
  }
  if at<change.low {
    return slot.colors[at]
  }
  if at<change.high {
    return 0
  }
  return slot.colors[change.old_high+at-change.high]
}
struct SyntaxDisplayInk {
  slot:*const Slot,
  change:buffer.ChangedRange,
  current:bool,
  offset:usize,
  palette:[7]u32,
}
fn syntax_display_ink(data:rawptr, offset:usize) u32 {
  state:=#cast(*SyntaxDisplayInk, data)
  style:=syntax_display_style(state.slot, state.change, state.current, state.offset+offset)
  if style>6 {
    style=0
  }
  return state.palette[style]
}
fn draw_syntax(renderer: rawptr, app: *App, typography: *Typography, viewport: TextViewport, x: f32, y: f32, clipping: sdl.PixelRect) bool {
  if !app.config.syntax_enabled {
    return false
  }
  slot := app.documents.slots[app.documents.active]
  doc := app.documents.current
  if slot.syntax == nil {
    return false
  }
  large := doc.length >= buffer.LargeFile
  if large {
    // Remember what is drawn so the next tick parses around it.
    writable := #cast(*Slot, slot)
    writable.syntax_view_low = viewport.start
    writable.syntax_view_high = viewport.end
    if viewport.end - viewport.start > 2 * SyntaxMargin {
      position := buffer.head(doc)
      if position >= viewport.start && position <= viewport.end {
        low := buffer.line_start(doc, position)
        high := buffer.line_end(doc, position)
        low = line_draw_start(doc, low, high)
        writable.syntax_view_low = low
        writable.syntax_view_high = line_draw_end(doc, low, high)
      }
    }
  }
  if slot.syntax_revision == 0 || (large && slot.syntax_revision != doc.revision) {
    return false
  }
  current:=slot.syntax_revision==doc.revision
  display_change:=buffer.ChangedRange{}
  if !current {
    display_change=buffer.changes_since(doc, slot.syntax_revision)
    // Never reuse unrelated/stale offsets when history was lost or a complete
    // replacement cannot be mapped safely. A fresh parse restores its colors.
    if !display_change.found || display_change.low>display_change.old_high || display_change.old_high>display_change.old_length || display_change.low>display_change.high || display_change.high>doc.length || display_change.old_length>#len(slot.colors) || doc.length>#len(slot.colors) {
      return false
    }
    if display_change.old_length-display_change.old_high!=doc.length-display_change.high {
      return false
    }
    // Undo deltas can start/end inside a shared UTF-8 encoding. Suppress the
    // whole touched scalar so provisional spans never split a codepoint.
    display_change.low=buffer.boundary(doc, display_change.low)
    end:=display_change.high
    for end<doc.length && (buffer.byte_at(doc, end)&192)==128 {
      end+=1
    }
    display_change.old_high+=end-display_change.high
    display_change.high=end
  }
  if !sdl.tui_active() {
    state:=SyntaxDisplayInk{slot:slot, change:display_change, current:current}
    state.palette[0]=rgb_value(theme().text)
    for style in 1..7 {
      state.palette[style]=rgb_value(syntax_color(#cast(u8, style)))
    }
    layout:=&current_pane_text(typography).layout
    for index in 0..layout.count {
      state.offset=layout.origins[index]
      text:=layout.lines[layout.rows[index]].text
      if !ttf.draw_colored(text, x, y+#cast(f32, index)*layout.line, syntax_display_ink, #cast(rawptr, &state)) {
        #panic("syntax line draw")
      }
    }
    return true
  }
  at := viewport.start
  span_index: usize = 0
  for at < viewport.end {
    row := buffer.row_at(doc, at)
    row_low := buffer.row_start(doc, row)
    row_high := buffer.line_end(doc, at)
    origin := line_draw_start(doc, row_low, row_high)
    shown := line_draw_end(doc, origin, row_high)
    if at < origin {
      at = origin
    }
    if at >= shown {
      at = row_high
      if at < doc.length {
        at += 1
      }
      continue
    }
    // Tabs/newlines have no colored ink. Split at them so tab stops retain the
    // positions from the original document layout, rather than a span's origin.
    if buffer.byte_at(doc, at) == 9 || buffer.byte_at(doc, at) == 10 {
      at += 1
      continue
    }
    style := syntax_display_style(slot, display_change, current, at)
    end := at + 1
    for end < shown && end < viewport.end && syntax_display_style(slot, display_change, current, end) == style && buffer.byte_at(doc, end) != 9 && buffer.byte_at(doc, end) != 10 {
      end += 1
    }
    if style != 0 {
      first := ttf.Substring{}
      last := ttf.Substring{}
      cached: *SpanText = nil
      if span_index < 128 && typography.current_pane<15 && typography.pane_text[typography.current_pane]!=nil {
        cached = &typography.pane_text[typography.current_pane].spans[span_index]
        if cached.identity != slot.identity || cached.revision != doc.revision || cached.start != at || cached.end != end {
          cached.identity = slot.identity
          cached.revision = doc.revision
          cached.start = at
          cached.end = end
          cached.geometry_ready = false
          cached.text_ready = false
        }
        if cached.viewport_start != viewport.start || cached.viewport_end != viewport.end {
          cached.viewport_start = viewport.start
          cached.viewport_end = viewport.end
          cached.geometry_ready = false
        }
      }
      span_index += 1
      geometry_ready: bool = false
      if cached != nil && cached.geometry_ready {
        first = cached.first
        last = cached.last
        geometry_ready = true
      }
      else {
        geometry_ready = layout_substring(&current_pane_text(typography).layout, doc, at, &first) && layout_substring(&current_pane_text(typography).layout, doc, buffer.previous(doc, end), &last)
        if cached != nil && geometry_ready {
          cached.first = first
          cached.last = last
          cached.geometry_ready = true
        }
      }
      if geometry_ready {
        left := #cast(i32, x) + first.x
        top := #cast(i32, y) + first.y
        right := #cast(i32, x) + last.x + last.width
        bottom := top + #cast(i32, typography.line)
        if left < clipping.x {
          left = clipping.x
        }
        if top < clipping.y {
          top = clipping.y
        }
        if right > clipping.x + clipping.width {
          right = clipping.x + clipping.width
        }
        if bottom > clipping.y + clipping.height {
          bottom = clipping.y + clipping.height
        }
        clip := sdl.PixelRect{ x: left, y: top, width: right - left, height: bottom - top }
        if clip.width > 0 && clip.height > 0 {
          span_start := ttf.Substring{}
          span_text := typography.syntax_text
          if cached != nil {
            if cached.text == nil {
              blank: [1]u8 = [0]
              cached.text = ttf.create(typography.engine, typography.font, &blank[0], 0)
              if cached.text == nil || !ttf.whitespace_visible(cached.text, true) || !ttf.wrap(cached.text, 0) {
                #panic("syntax cache allocation")
              }
            }
            span_text = cached.text
            if !cached.text_ready {
              if !ttf.set(span_text, buffer.pointer(doc, at, end), end - at) || !ttf.substring(span_text, 0, &cached.origin) {
                #panic("syntax span update")
              }
              cached.text_ready = true
            }
            span_start = cached.origin
          } else {
            if !ttf.set(span_text, buffer.pointer(doc, at, end), end - at) || !ttf.substring(span_text, 0, &span_start) {
              #panic("syntax overflow span")
            }
          }
          // Cached geometry is local to the text. Scroll/clip and theme remain live.
          ttf.italic(span_text, syntax_italic(style))
          if !sdl.clip(renderer, &clip) || !tint(span_text, syntax_color(style)) || !ttf.draw(span_text, x + #cast(f32, (first.x - span_start.x)), y + #cast(f32, (first.y - span_start.y))) {
            #panic("syntax span draw")
          }
        }
      }
    }
    at = end
  }
  _ = sdl.clip(renderer, &clipping)
  return true
}
fn language_install(app: *App, name: []const u8) {
  script: [4096]u8 = []
  if language_helper(&script[0], 4096) == 0 {
    notice(app, "Cannot locate language installer.")
    return
  }
  command: [32768]u8 = []
  used: usize = 0
  verb: []const u8 = "list"
  if #len(name) > 0 {
    for byte in name {
      if !((byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 95) {
        notice(app, "Language name must use lowercase letters, digits, and underscores.")
        return
      }
    }
    verb = "install"
  }
  if !platform_language_command(command[..], &used, app.workspace.language_root[..app.workspace.language_root_length], script[..c.string_length(&script[0], 4096)], verb, name) {
    notice(app, "Language tool command is too long.")
    return
  }
  terminal_show(app, true, command[..used])
}
fn indent_width(app: *App) usize {
  config := active_file_config(app)
  if config.indent_explicit {
    return config.indent_width
  }
  if app.documents.slots[app.documents.active].syntax != nil {
    return #cast(usize, syntax_indent(app.documents.slots[app.documents.active].syntax))
  }
  return config.indent_width
}
fn syntax_reset(slot: *Slot) {
  slot_syntax_release(slot)
  if slot.owner != nil {
    document_lifecycle_changed(slot.owner, slot.index)
  }
}
fn filetype_name(slot: *Slot) []const u8 {
  if slot.filetype_length > 0 {
    return slot.filetype[..slot.filetype_length]
  }
  if slot.syntax != nil {
    name := syntax_name(slot.syntax)
    return name[..c.string_length(name, 65)]
  }
  return filetype_path(files.name(&slot.file))
}
fn filetype_path(path: []const u8) []const u8 {
  if explorer_suffix(path, ".dyn") {
    return "dyn"
  }
  if explorer_suffix(path, ".py") || explorer_suffix(path, ".pyi") {
    return "python"
  }
  if explorer_suffix(path, ".ts") || explorer_suffix(path, ".mts") || explorer_suffix(path, ".cts") {
    return "typescript"
  }
  if explorer_suffix(path, ".tsx") {
    return "tsx"
  }
  if explorer_suffix(path, ".js") || explorer_suffix(path, ".jsx") || explorer_suffix(path, ".mjs") || explorer_suffix(path, ".cjs") {
    return "javascript"
  }
  if explorer_suffix(path, ".json") || explorer_suffix(path, ".jsonc") {
    return "json"
  }
  if explorer_suffix(path, ".yml") || explorer_suffix(path, ".yaml") {
    return "yaml"
  }
  if explorer_suffix(path, ".html") || explorer_suffix(path, ".htm") {
    return "html"
  }
  if explorer_suffix(path, ".css") {
    return "css"
  }
  if explorer_suffix(path, ".sh") || explorer_suffix(path, ".bash") {
    return "bash"
  }
  if explorer_suffix(path, ".rs") {
    return "rust"
  }
  if explorer_suffix(path, ".go") {
    return "go"
  }
  if explorer_suffix(path, ".c") || explorer_suffix(path, ".h") {
    return "c"
  }
  if explorer_suffix(path, ".cpp") || explorer_suffix(path, ".hpp") || explorer_suffix(path, ".cc") {
    return "cpp"
  }
  if explorer_suffix(path, ".toml") {
    return "toml"
  }
  return "text"
}
fn filetype_command(app: *App, requested: []const u8) {
  slot := app.documents.slots[app.documents.active]

  if slot.terminal.handle != nil {
    notice(app, "Terminal buffers do not have a filetype.")
    return
  }

  if #len(requested) > 0 {
    name := requested

    if buffer.equal(name, "plain") || buffer.equal(name, "plaintext") {
      name = "text"
    }
    if #len(name) > 64 {
      notice(app, "Filetype names must fit in 64 bytes.")
      return
    }
    for byte in name {
      if !((byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 95) {
        notice(app, "Filetype names use lowercase letters, digits, and underscores.")
        return
      }
    }
    syntax_reset(slot)
    slot.filetype_length = 0
    slot.inferred_filetype = false
    if !buffer.equal(name, "auto") {
      slot.filetype_length = copy_text(slot.filetype[..], name)
    }
    app.view.revision += 1
  }
  _ = syntax_tick(app)
  message: [256]u8 = []
  used: usize = 0
  add_text(message[..], &used, "Filetype: ")
  add_text(message[..], &used, filetype_name(slot))
  if slot.filetype_length == 0 {
    add_text(message[..], &used, " (automatic)")
  }
  if slot.filetype_length > 0 && slot.syntax == nil && !buffer.equal(slot.filetype[..slot.filetype_length], "text") {
    add_text(message[..], &used, "; grammar unavailable. Use :language-install ")
    add_text(message[..], &used, slot.filetype[..slot.filetype_length])
  }
  notice(app, message[..used])
}
fn use_tabs(app: *App) bool {
  return active_file_config(app).insert_tabs
}
fn filetype_dirty_slot(app: *App, index: usize) {
  if index >= #len(app.documents.slots) {
    return
  }
  slot := app.documents.slots[index]
  if slot.filetype_dirty {
    return
  }
  slot.filetype_dirty = true
  slot.filetype_next = nil
  if app.syntax_state.filetype_last == nil {
    app.syntax_state.filetype_first = slot
  }
  else {
    app.syntax_state.filetype_last.filetype_next = slot
  }
  app.syntax_state.filetype_last = slot
}
fn configured_filetype_slot(app: *App, slot: *Slot) {
  if slot.document == nil || slot.file.length == 0 || slot.filetype_length != 0 || slot.terminal.handle != nil {
    return
  }
  path := files.name(&slot.file)
  index: usize = 0
  for index < app.config.language_count {
    config := &app.config.languages[index]
    at: usize = 0
    for at < config.extensions_length {
      end := at
      for end < config.extensions_length && config.extensions[end] != 44 {
        end += 1
      }
      extension := settings.trim(config.extensions[at..end])
      at = end + 1
      if #len(extension) > 0 && explorer_suffix(path, extension) {
        slot.filetype_length = copy_text(slot.filetype[..], config.name[..config.name_length])
        slot.inferred_filetype = true
        slot_syntax_release(slot)
        lsp_document_dirty(app, slot.index)
        return
      }
    }
    index += 1
  }
}
fn configured_filetypes(app: *App) {
  first := app.syntax_state.filetype_first
  app.syntax_state.filetype_first = nil
  app.syntax_state.filetype_last = nil
  for first != nil {
    slot := first
    first = slot.filetype_next
    slot.filetype_next = nil
    slot.filetype_dirty = false
    configured_filetype_slot(app, slot)
  }
}
fn syntax_selection(app: *App, mode: u32) {
  slot := app.documents.slots[app.documents.active]
  doc := app.documents.current
  if slot.syntax == nil {
    notice(app, "Install a grammar for syntax selections.")
    return
  }
  selections := buffer.collect(doc)
  for index in 0..selections.count {
    if !syntax_range(&selections.items[index], slot.syntax, doc.revision, mode, 0, 0, false) {
      notice(app, "No syntax node available; parsing may still be pending.")
      return
    }
  }
  buffer.store(doc, &selections)
}
fn syntax_textobject(app: *App, key: u8, around: bool, count: usize) bool {
  slot := app.documents.slots[app.documents.active]
  doc := app.documents.current
  if slot.syntax == nil {
    return false
  }
  kind: u32 = 0
  if key == 't' {
    kind = 2
  } else if key == 'a' {
    kind = 4
  } else if key == 'c' {
    kind = 6
  }
  if around {
    kind += 1
  }
  selections := buffer.collect(doc)
  for index in 0..selections.count {
    if !syntax_range(&selections.items[index], slot.syntax, doc.revision, 0, kind, count, true) {
      return false
    }
  }
  buffer.store(doc, &selections)
  return true
}
// Replaces one selection with a syntax node (select mode) or text object
// (kind/count), keeping its direction.
fn syntax_range(selected: *buffer.Selection, syntax: rawptr, revision: u64, mode: u32, kind: u32, count: usize, object: bool) bool {
  range := buffer.ordered(selected.*)
  start: u32 = 0
  end: u32 = 0
  found: i32 = 0
  if object {
    found = syntax_object(syntax, revision, #cast(u32, range.anchor), #cast(u32, range.cursor), kind, #cast(u32, count), &start, &end)
  } else {
    found = syntax_select(syntax, revision, #cast(u32, range.anchor), #cast(u32, range.cursor), mode, &start, &end)
  }
  if found == 0 {
    return false
  }
  if selected.anchor > selected.cursor {
    selected.* = buffer.Selection{anchor: #cast(usize, end), cursor: #cast(usize, start)}
  } else {
    selected.* = buffer.Selection{anchor: #cast(usize, start), cursor: #cast(usize, end)}
  }
  return true
}
// Alt-a: select every sibling of each selection's node, including itself.
// Alt-I: select every child of each selection's node. Up to 32 selections.
fn syntax_select_all(app: *App, children: bool) {
  slot := app.documents.slots[app.documents.active]
  doc := app.documents.current
  if slot.syntax == nil {
    notice(app, "Install a grammar for syntax selections.")
    return
  }
  sources := buffer.collect(doc)
  results := buffer.Selections{}
  for index in 0..sources.count {
    source := buffer.ordered(sources.items[index])
    low := #cast(u32, source.anchor)
    high := #cast(u32, source.cursor)
    start: u32 = 0
    end: u32 = 0
    if !children {
      if syntax_select(slot.syntax, doc.revision, low, high, 0, &start, &end) == 0 {
        continue
      }
      low = start
      high = end
    }
    if syntax_select(slot.syntax, doc.revision, low, high, 1, &start, &end) == 0 {
      continue
    }
    for results.count < buffer.SelectionCapacity {
      duplicate := false
      for seen in 0..results.count {
        if results.items[seen].anchor == #cast(usize, start) && results.items[seen].cursor == #cast(usize, end) {
          duplicate = true
        }
      }
      if duplicate {
        break
      }
      results.items[results.count] = buffer.Selection{anchor: #cast(usize, start), cursor: #cast(usize, end)}
      results.count += 1
      if syntax_select(slot.syntax, doc.revision, start, end, 3, &start, &end) == 0 {
        break
      }
    }
  }
  if results.count == 0 {
    notice(app, "No syntax node available; parsing may still be pending.")
    return
  }
  buffer.store(doc, &results)
}

