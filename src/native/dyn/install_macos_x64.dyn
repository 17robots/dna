#target(kernel: darwin, arch: x86_64)
extern fn install_darwin_stat "stat$INODE64"(path:*const u8, info:*DarwinStat) i32
extern fn install_darwin_lstat "lstat$INODE64"(path:*const u8, info:*DarwinStat) i32
extern fn install_darwin_fstat "fstat$INODE64"(fd:i32, info:*DarwinStat) i32
extern fn install_darwin_fstatat "fstatat$INODE64"(fd:i32, path:*const u8, info:*DarwinStat, flags:i32) i32
extern fn install_darwin_readdir "readdir$INODE64"(directory:rawptr) *DarwinEntry
extern fn install_darwin_fdopendir "fdopendir$INODE64"(fd:i32) rawptr
