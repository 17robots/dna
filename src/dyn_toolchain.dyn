// Which dyn runs the Dyn language server. A project that pins Dyn with mise
// gets that compiler's server: a different dyn on PATH reports errors for
// standard-library names the project's SDK has, so valid code looks broken.

fn dyn_server_command(app: *App) str {
  if !dyn_pinned_by_mise(app) { return "dyn lsp" }
  if servers.on_path("mise") {
    // The server runs in the project root, so mise reads its configuration.
    return "mise exec -- dyn lsp"
  }
  status_error(app, "mise.toml pins dyn but mise is not on PATH; the Dyn server uses dyn from PATH")
  return "dyn lsp"
}

// Whether a mise file in the project root lists a dyn tool.
fn dyn_pinned_by_mise(app: *App) bool {
  names: [3]str = ["mise.toml", ".mise.toml", "mise.local.toml"]
  project := app.workspace.project[..app.workspace.project_length]
  if project.len == 0 { return false }
  for name in names {
    path: [4200]u8
    length := copy_text(path[..], project)
    add_text(path[..], &length, "/")
    add_text(path[..], &length, name)
    mark := mem.arena_mark(app.scratch)
    empty: []u8
    read := fs.read_all(app.scratch, path[..length], 65536) catch empty
    pinned := read.len > 0 && dyn_tool_listed(read)
    mem.arena_rewind(app.scratch, mark)
    if pinned { return true }
  }
  return false
}

// A [tools] key naming dyn: `dyn = "..."`, or a backend form such as
// `"github:17robots/dyn" = ...` / `[tools."github:17robots/dyn"]`.
fn dyn_tool_listed(text: str) bool {
  at: usize = 0
  for at < text.len {
    end := at
    for end < text.len && text[end] != 10 {
      end += 1
    }
    line := text[at..end]
    start: usize = 0
    for start < line.len && (line[start] == ' ' || line[start] == 9) {
      start += 1
    }
    line = line[start..]
    if line.len > 3 && buffer.equal(line[..3], "dyn") && (line[3] == ' ' || line[3] == '=') {
      return true
    }
    if contains(line, "/dyn\"") && !contains(line, "/dyn\"/") { return true }
    at = end + 1
  }
  return false
}
