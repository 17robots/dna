// Bounded line-oriented before/after hunk for confirmation dialogs.
fn diff_lines(out: []u8, used: *usize, text: str, prefix: str) {
  at: usize = 0
  lines: usize = 0
  for at < text.len && lines < 12 && used.* + 300 < out.len {
    end := at
    for end < text.len && text[end] != 10 {
      end += 1
    }
    shown := end
    if shown - at > 240 {
      shown = at + 240
      for shown > at && (text[shown] & 192) == 128 {
        shown -= 1
      }
    }
    add_text(out, used, prefix)
    add_text(out, used, text[at..shown])
    if shown < end {
      add_text(out, used, "…")
    }
    add_text(out, used, "\n")
    at = end + 1
    lines += 1
  }
  if at < text.len {
    add_text(out, used, "… preview truncated …\n")
  }
}
fn diff_preview(out: []u8, used: *usize, before: str, after: str) {
  prefix: usize = 0
  for prefix < before.len && prefix < after.len && before[prefix] == after[prefix] {
    prefix += 1
  }
  if prefix == before.len && prefix == after.len {
    add_text(out, used, "(unchanged)\n")
    return
  }
  start := prefix
  for start > 0 && before[start - 1] != 10 {
    start -= 1
  }
  old_end := before.len
  new_end := after.len
  for old_end > prefix && new_end > prefix && before[old_end - 1] == after[new_end - 1] {
    old_end -= 1
    new_end -= 1
  }
  for old_end < before.len && before[old_end] != 10 {
    old_end += 1
  }
  for new_end < after.len && after[new_end] != 10 {
    new_end += 1
  }
  if old_end < before.len {
    old_end += 1
  }
  if new_end < after.len {
    new_end += 1
  }
  row: usize = 1
  for at in 0..start {
    if before[at] == 10 {
      row += 1
    }
  }
  add_text(out, used, "@@ line ")
  add_number(out, used, row)
  add_text(out, used, " @@\n")
  diff_lines(out, used, before[start..old_end], "- ")
  diff_lines(out, used, after[start..new_end], "+ ")
}
