// Tree-sitter worker. UI publishes coalesced snapshots; worker owns mutable
// trees. Immutable copies allow navigation without waiting for parsing.
struct SyntaxPoint { row, column: u32 }
struct SyntaxEdit { start_byte, old_end_byte, new_end_byte: u32, start_point, old_end_point, new_end_point: SyntaxPoint }
struct SyntaxSource { payload: rawptr, read: *fn(rawptr, u32, SyntaxPoint, *u32) *const u8, encoding: u32, decode: rawptr }
struct SyntaxParseState { payload: rawptr, offset: u32, error: bool }
struct SyntaxQueryState { payload: rawptr, offset: u32 }
struct SyntaxParseOptions { payload: rawptr, progress: *fn(*SyntaxParseState) bool }
struct SyntaxQueryOptions { payload: rawptr, progress: *fn(*SyntaxQueryState) bool }
struct SyntaxRange { start, end, kind: u32 }
struct SyntaxWorker {
  name: [65]u8, library, parser, query, published, objects: rawptr,
  query_predicates, object_predicates: *Predicates,
  ranges: [1024]SyntaxRange, object_count: u32,
  thread, mutex, wake: rawptr, stopping, pending, ready, retry: bool, indent: u32,
  text: []u8, length: u32, revision, finished: u64,
  colors: []u8, cancel: native_atomic.AtomicU32, small_revisions: u32,
}
struct SyntaxInput { text: []u8, length: u32, revision: u64 }
struct SyntaxDeadline { worker: *SyntaxWorker, end: u64 }
struct SyntaxLibraryInfo { filename: *const u8, base: rawptr, symbol: *const u8, address: rawptr }
extern fn syntax_allocator "ts_set_allocator"(allocate: *fn(usize) rawptr, zero: *fn(usize, usize) rawptr, resize: *fn(rawptr, usize) rawptr, release: *fn(rawptr))
extern fn syntax_parser_new "ts_parser_new"() rawptr
extern fn syntax_parser_delete "ts_parser_delete"(parser: rawptr)
extern fn syntax_parser_reset "ts_parser_reset"(parser: rawptr)
extern fn syntax_language "ts_parser_set_language"(parser: rawptr, language: rawptr) bool
extern fn syntax_parse "ts_parser_parse_with_options"(parser: rawptr, retained: rawptr, source: SyntaxSource, options: SyntaxParseOptions) rawptr
extern fn syntax_tree_delete "ts_tree_delete"(tree: rawptr)
extern fn syntax_tree_copy "ts_tree_copy"(tree: rawptr) rawptr
extern fn syntax_tree_edit "ts_tree_edit"(tree: rawptr, edit: *const SyntaxEdit)
extern fn syntax_root "ts_tree_root_node"(tree: rawptr) TsNode
extern fn syntax_query_new "ts_query_new"(language: rawptr, source: *const u8, length: u32, offset: *u32, error: *u32) rawptr
extern fn syntax_query_delete "ts_query_delete"(query: rawptr)
extern fn syntax_cursor_new "ts_query_cursor_new"() rawptr
extern fn syntax_cursor_delete "ts_query_cursor_delete"(cursor: rawptr)
extern fn syntax_cursor_limit "ts_query_cursor_set_match_limit"(cursor: rawptr, limit: u32)
extern fn syntax_cursor_exec "ts_query_cursor_exec_with_options"(cursor: rawptr, query: rawptr, node: TsNode, options: *const SyntaxQueryOptions)
extern fn syntax_cursor_next "ts_query_cursor_next_capture"(cursor: rawptr, match: *TsMatch, capture: *u32) bool
extern fn syntax_capture_name "ts_query_capture_name_for_id"(query: rawptr, capture: u32, length: *u32) *const u8
extern fn syntax_descendant "ts_node_named_descendant_for_byte_range"(node: TsNode, low: u32, high: u32) TsNode
extern fn syntax_null "ts_node_is_null"(node: TsNode) bool
extern fn syntax_parent "ts_node_parent"(node: TsNode) TsNode
extern fn syntax_child "ts_node_named_child"(node: TsNode, index: u32) TsNode
extern fn syntax_previous "ts_node_prev_named_sibling"(node: TsNode) TsNode
extern fn syntax_next "ts_node_next_named_sibling"(node: TsNode) TsNode
