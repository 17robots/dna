}
fn command_named(name: str) usize {
  for id in 0..BuiltinCommands {
    info := command_info(id)
    at: usize = 0
    for at < info.aliases.len {
      end := at
      for end < info.aliases.len && info.aliases[end] != '|' {
        end += 1
      }
      if buffer.equal(name, info.aliases[at..end]) { return id }
      at = end + 1
    }
  }
  return PluginCommandBase
}
// Whether a command belongs in the palette and :help for this frontend.
// Hidden commands still run by their exact : name.
fn command_available(id: usize) bool {
  if id >= BuiltinCommands { return true }
  terminal := sdl.tui_active()
  case command_from_id(id) {
    // The terminal emulator owns the font and its size.
    .ZoomIn, .ZoomOut, .ZoomReset, .ChooseFont => { return !terminal }
    // A window has no shell job to suspend into.
    .Suspend => { return terminal }
    // "Switch theme" lists the themes as its suggestions; :themes still opens
    // the picker by name.
    .ChooseTheme => { return false }
    _ => { return true }
  }
}
const LeaderCommands: usize = 15
fn leader_command(index: usize) usize {
  ids: [15]Command = [
    .OpenFile,
    .Buffers,
    .Explorer,
    .TreeFocus,
    .GotoMenu,
    .NextBuffer,
    .PrevBuffer,
    .CloseBuffer,
    .CommandsMenu,
    .WindowsMenu,
    .TerminalPopup,
    .GlobalSearch,
    .LspHover,
    .FileSymbols,
    .WorkspaceSymbols,
  ]
  if index >= LeaderCommands { return PluginCommandBase }
  return command_id(ids[index])
}
