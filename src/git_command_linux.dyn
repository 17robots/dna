#target(kernel: linux)
// `git show HEAD:./NAME` for /bin/sh.
fn git_show_command(output: []u8, used: *usize, name: []const u8) bool {
  if 64 + 4 * #len(name) > #len(output) {
    return false
  }
  add_text(output, used, "git --no-pager show ")
  // The HEAD:./ prefix makes the path relative to the working directory.
  prefixed: [4200]u8 = []
  length := copy_text(prefixed[..], "HEAD:./")
  if length + #len(name) > #len(prefixed) {
    return false
  }
  add_text(prefixed[..], &length, name)
  shell_quote(output, used, prefixed[..length])
  add_text(output, used, " 2>/dev/null")
  return true
}
