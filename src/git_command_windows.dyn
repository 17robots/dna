#target(kernel: windows)
// `git show HEAD:./NAME` for cmd.exe; names with quotes or % are skipped.
fn git_show_command(output: []u8, used: *usize, name: []const u8) bool {
  if 64 + #len(name) > #len(output) {
    return false
  }
  for byte in name {
    if byte == '"' || byte == '%' || byte == '^' {
      return false
    }
  }
  add_text(output, used, "git --no-pager show \"HEAD:./")
  add_text(output, used, name)
  add_text(output, used, "\" 2>NUL")
  return true
}
