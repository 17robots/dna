fn setting_bool(out: []u8, used: *usize, value: bool) {
  if value {
    add_text(out, used, "true")
  } else {
    add_text(out, used, "false")
  }
}
fn setting_legacy(app: *App, typography: *Typography, key: []const u8) bool {
  description := ""
  default_value := ""
  bit: u32 = 0
  value: [4096]u8 = []
  used: usize = 0
  current: [4096]u8 = []
  current_length: usize = 0
  if buffer.equal(key, "font_size") {
    description = "Font size in logical points."
    default_value = "16"
    bit = 4
    setting_decimal(value[..], &used, app.config.font_size)
    setting_decimal(current[..], &current_length, typography.points)
  } else if buffer.equal(key, "line_height") {
    description = "Line height relative to font size."
    default_value = "1.25"
    bit = 8
    setting_decimal(value[..], &used, app.config.line_height)
    setting_decimal(current[..], &current_length, typography.line_height)
  } else if buffer.equal(key, "indent_width") {
    description = "Default indentation width; explicit language settings take priority."
    default_value = "4"
    bit = 16
    setting_decimal(value[..], &used, #cast(f32) app.config.indent_width)
    setting_decimal(current[..], &current_length, #cast(f32) indent_width(app))
  } else if buffer.equal(key, "reduced_motion") {
    description = "Disable animated motion."
    default_value = "false"
    bit = 32
    setting_bool(value[..], &used, app.config.reduced_motion)
    setting_bool(current[..], &current_length, app.view.reduced_motion)
  } else if buffer.equal(key, "line_numbers") {
    description = "Show the document gutter."
    default_value = "true"
    bit = 64
    setting_bool(value[..], &used, app.config.line_numbers)
    setting_bool(current[..], &current_length, app.view.line_numbers)
  } else if buffer.equal(key, "relative_numbers") {
    description = "Show distances from the cursor in the gutter."
    default_value = "true"
    bit = 128
    setting_bool(value[..], &used, app.config.relative_numbers)
    setting_bool(current[..], &current_length, app.view.relative_numbers)
  } else if buffer.equal(key, "status_line") {
    description = "Show mode, file, diagnostics and position."
    default_value = "true"
    bit = 256
    setting_bool(value[..], &used, app.config.status_line)
    setting_bool(current[..], &current_length, app.view.status_line)
  } else if buffer.equal(key, "highlight_line") {
    description = "Highlight the current document row."
    default_value = "true"
    bit = 512
    setting_bool(value[..], &used, app.config.highlight_line)
    setting_bool(current[..], &current_length, app.view.highlight_line)
  } else if buffer.equal(key, "explorer_icons") {
    description = "Draw icons outside editable filenames."
    default_value = "true"
    bit = 65536
    setting_bool(value[..], &used, app.config.explorer_icons)
    setting_bool(current[..], &current_length, app.config.explorer_icons)
  } else if buffer.equal(key, "explorer_columns") {
    description = "Keep the folders you walked through as columns beside the explorer."
    default_value = "true"
    bit = 131072
    setting_bool(value[..], &used, app.config.explorer_columns)
    setting_bool(current[..], &current_length, app.config.explorer_columns)
  } else if buffer.equal(key, "explorer_preview") {
    description = "Preview selected file contents."
    default_value = "true"
    bit = 262144
    setting_bool(value[..], &used, app.config.explorer_preview)
    setting_bool(current[..], &current_length, app.config.explorer_preview)
  } else if buffer.equal(key, "font") {
    description = "Explicit font file; takes priority over font_family."
    default_value = "automatic"
    bit = 1
    add_text(value[..], &used, app.config.font)
    add_text(current[..], &current_length, app.fonts.active_font_path[..app.fonts.active_font_length])
  } else if buffer.equal(key, "font_family") {
    description = "Fontconfig family lookup when no explicit font path is set. Current shows the resolved font file."
    default_value = "automatic"
    bit = 524288
    add_text(value[..], &used, app.config.font_family)
    add_text(current[..], &current_length, app.fonts.active_font_path[..app.fonts.active_font_length])
  } else if buffer.equal(key, "fallback_font") {
    description = "Fallback font file for missing glyphs."
    default_value = "none"
    bit = 4096
    add_text(value[..], &used, app.config.fallback)
    add_text(current[..], &current_length, app.fonts.active_fallback_path[..app.fonts.active_fallback_length])
  } else if buffer.equal(key, "close_last_buffer") {
    description = "Closing the last buffer: quit, keep an empty buffer, or auto (quit in the terminal, keep the window)."
    default_value = "auto"
    bit = 16777216
    names: [3][]const u8 = ["auto", "quit", "keep"]
    add_text(value[..], &used, names[app.config.close_last_buffer])
    add_text(current[..], &current_length, value[..used])
  } else if buffer.equal(key, "terminal_escape") {
    description = "Leave terminal input mode. Escape twice is also available."
    default_value = "ctrl-backslash"
    bit = 1024
    setting_key_name(value[..], &used, app.config.terminal_escape, app.config.terminal_modifiers)
    add_text(current[..], &current_length, value[..used])
  } else if buffer.equal(key, "shell") {
    description = "Shell executable for new terminal buffers."
    default_value = "login shell"
    bit = 2
    add_text(value[..], &used, app.config.shell)
    add_text(current[..], &current_length, app.config.shell)
  } else if buffer.equal(key, "theme") {
    description = "Built-in theme name or theme file path."
    default_value = "charcoal"
    bit = 2048
    add_text(value[..], &used, app.configuration.theme[..c.string_length(&app.configuration.theme[0], 4096)])
    add_text(current[..], &current_length, app.theme_state.name[..app.theme_state.name_length])
  } else if buffer.equal(key, "build_command") {
    description = "Command invoked by :build."
    default_value = "unset"
    bit = 8192
    add_text(value[..], &used, app.config.build_command)
    add_text(current[..], &current_length, app.config.build_command)
  } else if buffer.equal(key, "test_command") {
    description = "Command invoked by :test."
    default_value = "unset"
    bit = 16384
    add_text(value[..], &used, app.config.test_command)
    add_text(current[..], &current_length, app.config.test_command)
  } else if buffer.equal(key, "run_command") {
    description = "Command invoked by :run without arguments."
    default_value = "unset"
    bit = 32768
    add_text(value[..], &used, app.config.run_command)
    add_text(current[..], &current_length, app.config.run_command)
  } else {
    return false
  }

  if used == 0 {
    add_text(value[..], &used, default_value)
  }
  if current_length == 0 {
    add_text(current[..], &current_length, default_value)
  }

  app.configuration.setting_key_length = copy_text(app.configuration.setting_key[..], key)
  app.prompt_state.message_length = copy_text(app.prompt_state.message[..], key)

  add_text(app.prompt_state.message[..], &app.prompt_state.message_length, "\n\n")
  add_text(app.prompt_state.message[..], &app.prompt_state.message_length, description)
  add_text(app.prompt_state.message[..], &app.prompt_state.message_length, "\n\nCurrent: ")
  add_text(app.prompt_state.message[..], &app.prompt_state.message_length, current[..current_length])
  add_text(app.prompt_state.message[..], &app.prompt_state.message_length, "\nConfigured: ")
  add_text(app.prompt_state.message[..], &app.prompt_state.message_length, value[..used])
  add_text(app.prompt_state.message[..], &app.prompt_state.message_length, "\nDefault: ")
  add_text(app.prompt_state.message[..], &app.prompt_state.message_length, default_value)
  add_text(app.prompt_state.message[..], &app.prompt_state.message_length, "\nSource: ")
  if (app.config.explicit_legacy & bit) != 0 {
    add_text(app.prompt_state.message[..], &app.prompt_state.message_length, app.configuration.path[..app.configuration.path_length])
  } else {
    add_text(app.prompt_state.message[..], &app.prompt_state.message_length, "built-in default")
  }
  add_text(app.prompt_state.message[..], &app.prompt_state.message_length, "\n\nEnter opens config / Escape closes. Save and :config-reload to apply.")
  app.prompt_state.panel = Panel.Setting
  return true
}
