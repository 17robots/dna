use "../buffer"

pub struct Layout {
  nodes: [15]Node,
  node_count: usize,
  width: f32 = 0.64,
  height: f32 = 0.56,
  font_size: f32 = 20.0,
  line_numbers: bool = true,
  relative_numbers: bool = true,
  status_line: bool = true,
  highlight_line: bool = true,
  tree_set: bool,
  font_size_set: bool,
  reduced_motion: bool,
  ok: bool,
}

fn trim(text: []const u8) []const u8 {
  start: usize = 0
  end := #len(text)
  for start < end && (text[start] == 32 || text[start] == 9 || text[start] == 13) {
    start += 1
  }
  for end > start && (text[end - 1] == 32 || text[end - 1] == 9 || text[end - 1] == 13) {
    end -= 1
  }
  return text[start..end]
}
pub fn parse(source: []const u8) Layout {
  result := Layout{}
  offset: usize = 0
  seen: u16 = 0
  for offset < #len(source) {
    end := offset
    for end < #len(source) && source[end] != 10 {
      end += 1
    }
    line := trim(source[offset..end])
    offset = end + 1
    if #len(line) == 0 || line[0] == '#' {
      continue
    }
    split: usize = 0
    for split < #len(line) && line[split] != '=' {
      split += 1
    }
    if split == #len(line) {
      return Layout{}
    }
    key := trim(line[..split])
    digits := trim(line[split + 1..])
    if buffer.equal(key, "tree") {
      if result.tree_set || #len(digits) < 3 || digits[0] != 34 || digits[#len(digits) - 1] != 34 {
        return Layout{}
      }
      tree := digits[1..#len(digits) - 1]
      position: usize = 0
      if parse_tree_node(tree, &position, &result, 0) != 0 || position != #len(tree) {
        return Layout{}
      }
      result.tree_set = true
      seen = seen | 256
      continue
    }
    if #len(digits) == 0 || #len(digits) > 8 {
      return Layout{}
    }
    value: f32 = 0.0
    divisor: f32 = 1.0
    decimal := false
    count: usize = 0
    for byte in digits {
      if byte == '.' && !decimal {
        decimal = true
        continue
      }
      if byte < 48 || byte > 57 {
        return Layout{}
      }
      count += 1
      value = value * 10.0 + #cast(f32) (byte - 48)
      if decimal {
        divisor *= 10.0
      }
    }
    if count == 0 {
      return Layout{}
    }
    value /= divisor
    if buffer.equal(key, "popup_width") {
      if (seen & 1) != 0 || value < 0.25 || value > 1.0 {
        return Layout{}
      }
      result.width = value
      seen = seen | 1
    }
    else if buffer.equal(key, "popup_height") {
      if (seen & 2) != 0 || value < 0.25 || value > 1.0 {
        return Layout{}
      }
      result.height = value
      seen = seen | 2
    }
    else if buffer.equal(key, "font_size") {
      if (seen & 4) != 0 || value < 12.0 || value > 36.0 {
        return Layout{}
      }
      result.font_size = value
      result.font_size_set = true
      seen = seen | 4
    }
    else if buffer.equal(key, "line_numbers") {
      if (seen & 8) != 0 || (value != 0.0 && value != 1.0) {
        return Layout{}
      }
      result.line_numbers = value == 1.0
      seen = seen | 8
    }
    else if buffer.equal(key, "relative_numbers") {
      if (seen & 16) != 0 || (value != 0.0 && value != 1.0) {
        return Layout{}
      }
      result.relative_numbers = value == 1.0
      seen = seen | 16
    }
    else if buffer.equal(key, "status_line") {
      if (seen & 32) != 0 || (value != 0.0 && value != 1.0) {
        return Layout{}
      }
      result.status_line = value == 1.0
      seen = seen | 32
    }
    else if buffer.equal(key, "highlight_line") {
      if (seen & 64) != 0 || (value != 0.0 && value != 1.0) {
        return Layout{}
      }
      result.highlight_line = value == 1.0
      seen = seen | 64
    }
    else if buffer.equal(key, "reduced_motion") {
      if (seen & 128) != 0 || (value != 0.0 && value != 1.0) {
        return Layout{}
      }
      result.reduced_motion = value == 1.0
      seen = seen | 128
    }
    else {
      return Layout{}
    }
  }
  result.ok = seen != 0
  return result
}

pub struct Node {
  branch: bool,
  vertical: bool,
  first: usize,
  second: usize,
  parent: usize,
  percent: usize = 50,
}
fn parse_tree_node(text: []const u8, at: *usize, result: *Layout, parent: usize) usize {
  if at.* >= #len(text) || result.node_count == 15 {
    return 15
  }
  index := result.node_count
  result.node_count += 1
  result.nodes[index].parent = parent
  character := text[at.*]
  at.* += 1
  if character == 'f' {
    return index
  }
  if character != 'v' && character != 'h' {
    return 15
  }
  node := &result.nodes[index]
  node.branch = true
  node.vertical = character == 'v'
  percent: usize = 0
  digits: usize = 0
  for at.* < #len(text) && text[at.*] >= 48 && text[at.*] <= 57 {
    percent = percent * 10 + #cast(usize) (text[at.*] - 48)
    digits += 1
    at.* += 1
    if digits > 2 {
      return 15
    }
  }
  if digits == 0 || percent < 10 || percent > 90 || at.* >= #len(text) || text[at.*] != '(' {
    return 15
  }
  node.percent = percent
  at.* += 1
  node.first = parse_tree_node(text, at, result, index)
  if node.first == 15 || at.* >= #len(text) || text[at.*] != ',' {
    return 15
  }
  at.* += 1
  node.second = parse_tree_node(text, at, result, index)
  if node.second == 15 || at.* >= #len(text) || text[at.*] != ')' {
    return 15
  }
  at.* += 1
  return index
}
