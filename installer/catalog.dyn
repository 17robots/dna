use "std/io"
// Stable, bounded records for the editor's package manager, one per line and
// tab-separated. Registry names cannot contain tabs/newlines; installation
// state comes from actual files.
//   grammar NAME STATE EXTENSIONS FILENAMES URL   (comma lists)
//   server  NAME STATE NPM-PACKAGES EXECUTABLE
fn grammar_installed(root: []const u8, name: []const u8) bool {
  package_storage: [4096]u8
  file_storage: [4096]u8
  active := append_path(package_storage[..], root, name)
  version_storage: [4096]u8
  package := installer_package_path(active, version_storage[..])
  if #len(package) == 0 {
    return false
  }
  for leaf in ["parser.so", "highlights.scm", "extensions"] {
    info := std_fs.metadata(append_path(file_storage[..], package, leaf))
    if io.failed(info.failure) || (info.mode & 61440) != 32768 || info.size == 0 {
      return false
    }
  }
  return true
}
fn catalog(registry: *Registry, root: []const u8) {
  for index in 0..registry.count {
    state: []const u8 = "available"
    if grammar_installed(root, registry.entries[index].name) {
      state = "installed"
    }
    item := &registry.entries[index]
    // Extensions and file names one per line become comma lists.
    extension_storage: [4096]u8
    extension_length := extensions(item, extension_storage[..])
    names_storage: [4096]u8
    names_length := filenames(item, names_storage[..])
    for at in 0..extension_length {
      if extension_storage[at] == 10 {
        extension_storage[at] = ','
      }
    }
    for at in 0..names_length {
      if names_storage[at] == 10 {
        names_storage[at] = ','
      }
    }
    if extension_length > 0 {
      extension_length -= 1
    }
    if names_length > 0 {
      names_length -= 1
    }
    io.println("grammar\t{}\t{}\t{}\t{}\t{}", item.name, state, extension_storage[..extension_length], names_storage[..names_length], item.url)
  }
  for index in 0..9 {
    item := server_package(index)
    storage: [4096]u8
    info := std_fs.metadata(server_executable(root, item, storage[..]))
    state: []const u8 = "available"
    if !io.failed(info.failure) && installer_executable(server_executable(root, item, storage[..])) {
      state = "installed"
    }
    io.println("server\t{}\t{}\t{}\t{}", item.name, state, item.packages, item.executable)
  }
}
fn uninstall(root: []const u8, name: []const u8) {
  if !identifier(name) {
    #panic("invalid package name")
  }
  active_storage: [4096]u8
  target_storage: [4096]u8
  prefix_storage: [4096]u8
  active := append_path(active_storage[..], root, name)
  target_space := mem.arena_alloc(4096)
  defer mem.arena_release(target_space)
  target := installer_read_link(target_space, active)
  if io.failed(target.failure) {
    #panic("refusing to remove a package not managed by DNA")
  }
  used: usize = 0
  add(prefix_storage[..], &used, root)
  add(prefix_storage[..], &used, "/.")
  add(prefix_storage[..], &used, name)
  add(prefix_storage[..], &used, "-")
  if #len(target.value) != used + 6 || !equal(target.value[..used], prefix_storage[..used]) {
    #panic("package points outside its managed directory")
  }
  for byte in target.value[used..] {
    if !((byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z') || (byte >= '0' && byte <= '9')) {
      #panic("invalid managed version")
    }
  }
  if io.failed(std_fs.remove(active).failure) {
    #panic("cannot deactivate package")
  }
  removed := installer_remove_tree(target.value)
  if io.failed(removed.failure) && removed.failure.native != -2 {
    #panic("package deactivated but cleanup failed; refresh the package list")
  }
  io.println("Uninstalled {}. Older retained versions are unchanged.", name)
}
