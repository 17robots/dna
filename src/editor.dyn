use "std/c"
use "filesystem" fs
use "std/mem"
use "std/unicode/utf8"
use "./buffer"
use "./files"
use "./layout"
use "./platform" sdl
use "./settings"
use "./text" ttf

struct CommandMenuState {
  query: [4096]u8,
  query_length: usize,
  cached: bool,
  context: bool,
  ids: [512]usize,
  count: usize,
  filter_runs: u64,
  // Rows built per query: options and argument suggestions (PaletteRow).
  rows: [512]PaletteRow,
  row_count: usize,
  pool: [65536]u8,
  pool_used: usize,
  // The query is "verb arguments...": rows are suggestions for its last word,
  // which starts at fragment_start.
  arguments: bool,
  fragment_start: usize,
}

enum Panel { Buffers, Commands, Create, Diagnostics, Directory, DirectoryApply, DirectoryDiscard, FileConflict, Goto, Hover, Keep, Layout, Leader, LspEdit, LspResults, Match, Message, None, PluginGrant, PluginEdit, Open, ProjectSearch, Quit, Remove, Rename, ReplacePreview, SaveAs, Search, Select, Setting, Split, Terminal, TerminalClose, Trash, Windows, View, Bracket, Tree }

struct Entry { name: [512]u8,  length: usize,  inode, device: u64,  directory: bool,  mode: u16 }
fn notice(app: *App, text: []const u8) {
  app.prompt_state.message_length = copy_text(app.prompt_state.message[..], text)
  app.prompt_state.panel = Panel.Message
  app.prompt_state.selected = 0
}
fn hover_notice(app: *App, text: []const u8) {
  app.prompt_state.message_length = copy_text(app.prompt_state.message[..], text)
  app.prompt_state.panel = Panel.Hover
  app.prompt_state.selected = 0
  app.previews.hover_count = 0
}
fn panel(app: *App, kind: Panel) {
  buffer.checkpoint(app.documents.current)
  app.input_state.repeat_count = 0
  app.prompt_state.panel = kind
  app.prompt_state.length = 0
  app.prompt_state.text[0] = 0
  app.prompt_state.selected = 0
  if kind == Panel.Open {
    completion_refresh(app)
  }
}
fn submit(app: *App, typography: *Typography) {
  if app.prompt_state.panel == Panel.ProjectSearch {
    project_search_accept(app)
  }
  else if app.prompt_state.panel == Panel.Commands {
    command_submit(app, typography)
  }
  else if app.prompt_state.panel == Panel.Open {
    open_prompt(app, typography)
  }
  else if app.prompt_state.panel == Panel.Buffers {
    buffer_matches(app)
    if app.prompt_state.match_count > 0 {
      activate(app, app.prompt_state.matches[app.prompt_state.selected])
    }
  }
  else if app.prompt_state.panel == Panel.SaveAs {
    save_file(app, app.prompt_state.text[..app.prompt_state.length])
  }
  else if search_prompt(app.prompt_state.panel) {
    search_submit(app)
  }
  else if app.prompt_state.panel == Panel.Layout {
    mark := mem.arena_mark(app.scratch)
    defer mem.arena_rewind(app.scratch, mark)
    read := fs.read_all(app.scratch, app.prompt_state.text[..app.prompt_state.length], 4096)
    if !read.ok {
      notice(app, "Cannot read layout file.")
      return
    }
    parsed := layout.parse(read.data)
    if !parsed.ok {
      notice(app, "Invalid layout. Popup fractions: 0.25..1; font_size: 12..36; line_numbers, relative_numbers, status_line, highlight_line, reduced_motion: 0 or 1. No duplicate/unknown keys.")
      return
    }
    app.view.popup_width = parsed.width
    app.view.popup_height = parsed.height
    if parsed.font_size_set {
      typography.points = parsed.font_size
    }
    app.view.line_numbers = parsed.line_numbers
    app.view.relative_numbers = parsed.relative_numbers
    app.view.status_line = parsed.status_line
    app.view.highlight_line = parsed.highlight_line
    app.view.reduced_motion = parsed.reduced_motion
    if parsed.tree_set {
      layout_apply_tree(app, &parsed)
    }
    resize_font(typography)
    app.prompt_state.panel = Panel.None
  }
  else if app.prompt_state.panel == Panel.Directory {
    if explorer_dirty(app) {
      notice(app, "Apply or discard explorer edits before navigating.")
      return
    }
    explorer_selected(app)
    if app.directory_state.count == 0 || app.directory_state.selected >= app.directory_state.count {
      return
    }
    entry := &app.directory_state.entries[app.directory_state.selected]
    path_storage: [4096]u8 = []
    path := joined(app, entry.name[..entry.length], path_storage[..])
    if entry.directory {
      app.directory_state.length = copy_text(app.directory_state.path[..], path)
      directory_refresh(app)
    }
    else {
      open_file(app, path)
    }
  }
  else if app.prompt_state.panel == Panel.Create {
    if !valid_leaf(app.prompt_state.text[..app.prompt_state.length]) {
      notice(app, "Enter a single valid filename.")
      return
    }
    output: [4096]u8 = []
    destination := joined(app, app.prompt_state.text[..app.prompt_state.length], output[..])
    created := fs.create_exclusive(destination)
    if !created.ok {
      notice(app, "File exists, path is too long, or creation failed.")
      return
    }
    if !fs.close(&created.file).ok {
      notice(app, "File created, but closing it failed.")
      return
    }
    app.prompt_state.panel = Panel.Directory
    directory_refresh(app)
  }
  else if app.prompt_state.panel == Panel.DirectoryApply {
    explorer_apply(app)
  }
  else if app.prompt_state.panel == Panel.Rename {
    move_entry(app, false)
  }
  else if app.prompt_state.panel == Panel.Trash {
    move_entry(app, true)
  }
  else if app.prompt_state.panel == Panel.Message || app.prompt_state.panel == Panel.PluginGrant || app.prompt_state.panel == Panel.PluginEdit {
    cancel_buffer_close(app)
  }
}
fn popup_text(app: *App, output: []u8) usize {
  if app.prompt_state.panel == Panel.FileConflict {
    return copy_text(output, "Reload from disk? Unsaved buffer edits will be discarded.\n\nR  Reload disk contents\nS  Save edits to a different path\nK / Escape  Keep buffer edits")
  }
  if app.prompt_state.panel == Panel.TerminalClose {
    return copy_text(output, "Terminal processes are still running.\nEnter terminates them / C or Escape cancels")
  }
  if app.prompt_state.panel == Panel.LspResults {
    return lsp_popup(app, output)
  }
  if app.prompt_state.panel == Panel.Hover {
    return copy_text(output, app.prompt_state.message[..app.prompt_state.message_length])
  }
  if app.prompt_state.panel == Panel.Diagnostics {
    return diagnostics_popup(app, output)
  }
  used: usize = 0
  if app.prompt_state.panel == Panel.Commands {
    matches(app)
    add_text(output, &used, ":")
    add_text(output, &used, app.prompt_state.text[..app.prompt_state.length])
    add_text(output, &used, "_\n")
    first: usize = 0
    if app.prompt_state.selected > 3 {
      first = app.prompt_state.selected - 3
    }
    index := first
    for index < app.prompt_state.match_count && index < first + 4 {
      if index == app.prompt_state.selected {
        add_text(output, &used, "> ")
      } else {
        add_text(output, &used, "  ")
      }
      add_text(output, &used, command_name(app, app.prompt_state.matches[index]))
      add_text(output, &used, "\n")
      index += 1
    }
    if app.prompt_state.match_count == 0 {
      add_text(output, &used, "No matching commands.\n")
    }
  } else if search_prompt(app.prompt_state.panel) {
    if app.prompt_state.panel == Panel.Select {
      add_text(output, &used, "select: ")
    }
    else if app.prompt_state.panel == Panel.Split {
      add_text(output, &used, "split: ")
    }
    else if app.prompt_state.panel == Panel.Keep {
      add_text(output, &used, "keep: ")
    }
    else if app.prompt_state.panel == Panel.Remove {
      add_text(output, &used, "remove: ")
    }
    else if app.input_state.search_backwards {
      add_text(output, &used, "?")
    } else {
      add_text(output, &used, "/")
    }
    add_text(output, &used, app.prompt_state.text[..app.prompt_state.length])
    add_text(output, &used, "_\n")
    if app.prompt_state.length > 0 && app.search_state.status == 0 {
      add_number(output, &used, app.search_state.document.secondary.count + 1)
      add_text(output, &used, " selection(s). ")
    }
    add_text(output, &used, search_label(app))
  } else if app.prompt_state.panel == Panel.DirectoryApply {
    return explorer_plan_text(app, output)
  }
  else if app.prompt_state.panel == Panel.DirectoryDiscard {
    add_text(output, &used, "Discard staged explorer edits?\n\nD discards. Escape keeps them.")
  }
  else if app.prompt_state.panel == Panel.Setting || app.prompt_state.panel == Panel.Message || app.prompt_state.panel == Panel.PluginGrant || app.prompt_state.panel == Panel.PluginEdit || app.prompt_state.panel == Panel.LspEdit {
    add_text(output, &used, app.prompt_state.message[..app.prompt_state.message_length])
  }
  else if app.prompt_state.panel == Panel.Quit {
    add_text(output, &used, "Unsaved changes in ")
    closing_slot := app.documents.active
    if app.picker_state.closing {
      closing_slot = app.picker_state.close_target
    }
    closing_name := files.name(&app.documents.slots[closing_slot].file)
    if #len(closing_name) == 0 {
      closing_name = "Untitled"
    }
    add_text(output, &used, closing_name)
    add_text(output, &used, "\n\nS  Save and continue closing\nD  Discard and continue closing\nC / Escape  Cancel (keep buffer)")
  }
  else if app.prompt_state.panel == Panel.Trash {
    add_text(output, &used, "Move to .dna-trash (recoverable)\n\n")
    if app.directory_state.selected < app.directory_state.count {
      chosen := &app.directory_state.entries[app.directory_state.selected]
      add_text(output, &used, chosen.name[..chosen.length])
    }
    add_text(output, &used, "\n\nEnter confirms. Escape cancels. Existing trash files are never replaced.")
  } else {
    if app.prompt_state.panel == Panel.SaveAs {
      add_text(output, &used, "Save as (new destination only)")
    }
    else if app.prompt_state.panel == Panel.Search {
      add_text(output, &used, "Search / regular expression")
    }
    else if app.prompt_state.panel == Panel.Select {
      add_text(output, &used, "Select matches inside selections (s)")
    }
    else if app.prompt_state.panel == Panel.Split {
      add_text(output, &used, "Split selections on matches (S)")
    }
    else if app.prompt_state.panel == Panel.Layout {
      add_text(output, &used, "Load layout file")
    }
    else if app.prompt_state.panel == Panel.Create {
      add_text(output, &used, "Create file in current directory")
    }
    else if app.prompt_state.panel == Panel.Rename {
      add_text(output, &used, "Rename selected file to")
      if app.directory_state.selected < app.directory_state.count {
        add_text(output, &used, "\nFrom: ")
        renamed := &app.directory_state.entries[app.directory_state.selected]
        add_text(output, &used, renamed.name[..renamed.length])
      }
    }
    add_text(output, &used, "\n\n> ")
    add_text(output, &used, app.prompt_state.text[..app.prompt_state.length])
    add_text(output, &used, "_\n\n")
    if search_prompt(app.prompt_state.panel) {
      add_text(output, &used, search_label(app))
    } else {
      add_text(output, &used, "Enter confirms. Escape cancels.")
    }
  }
  return used
}
