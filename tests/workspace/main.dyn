use "../../src/workspace" workspace
use "../../src/buffer" buffer
fn main() {
  dynamic_workspace_checks()
  legacy_workspace_checks()
  state := workspace.State{project: "/tmp"}
  state.buffers[0] = workspace.SavedBuffer{used: true, path: "/tmp/a", text: "new\nα", saved: "old", cursor: 4, anchor: 0, filetype: "dyn"}
  state.panes[0] = workspace.SavedPane{used: true, percent: 50}
  state.buffers[0].secondary.count = 1
  state.buffers[0].secondary.ranges[0] = buffer.Selection{cursor: 6, anchor: 4}
  state.panes[0].secondary = state.buffers[0].secondary
  bytes: [8192]u8 = []
  length := workspace.encode(&state, bytes[..])
  if length == 0 {
    #panic("encode")
  }
  if length != workspace.encoded_size(&state) {
    #panic("session sizing")
  }
  // Segmenting the saved baseline must not change the session wire format.
  split_bytes: [8192]u8 = []
  state.buffers[0].split_saved = true
  state.buffers[0].saved_parts = ["o", "l", "d"]
  split_length := workspace.encode(&state, split_bytes[..])
  if split_length != length || split_length != workspace.encoded_size(&state) || !buffer.equal(bytes[..length], split_bytes[..split_length]) {
    #panic("segmented session encoding changed bytes or size")
  }
  state.buffers[0].split_saved = false
  // Large files in recovery snapshots are stored by path and reloaded.
  reload := workspace.State{project: "/tmp"}
  reload.buffers[0] = workspace.SavedBuffer{used: true, reload: true, path: "/tmp/big.log", filetype: "log", cursor: 900, anchor: 12}
  reload.panes[0] = workspace.SavedPane{used: true, percent: 50, slot: 0, cursor: 900, anchor: 12}
  reload_bytes: [8192]u8 = []
  reload_length := workspace.encode(&reload, reload_bytes[..])
  reloaded := workspace.State{}
  if reload_length == 0 || reload_length != workspace.encoded_size(&reload) || !workspace.decode(reload_bytes[..reload_length], &reloaded) {
    #panic("reload entry roundtrip")
  }
  if !reloaded.buffers[0].reload || !buffer.equal(reloaded.buffers[0].path, "/tmp/big.log") || !buffer.equal(reloaded.buffers[0].filetype, "log") || reloaded.buffers[0].cursor != 900 || reloaded.buffers[0].anchor != 12 || #len(reloaded.buffers[0].text) != 0 {
    #panic("reload entry fields")
  }
  // Unsaved edits of a reloaded file travel as one stamped patch.
  reload.buffers[0].patched = true
  reload.buffers[0].patch_low = 7
  reload.buffers[0].patch_high = 9
  reload.buffers[0].patch = "αβ\n"
  reload.buffers[0].stamp = [11, 12, 13, 14]
  reload_length = workspace.encode(&reload, reload_bytes[..])
  if reload_length == 0 || reload_length != workspace.encoded_size(&reload) || !workspace.decode(reload_bytes[..reload_length], &reloaded) {
    #panic("patched reload roundtrip")
  }
  patched := &reloaded.buffers[0]
  if !patched.reload || !patched.patched || patched.patch_low != 7 || patched.patch_high != 9 || !buffer.equal(patched.patch, "αβ\n") || patched.stamp[0] != 11 || patched.stamp[3] != 14 || patched.cursor != 900 {
    #panic("patched reload fields")
  }
  for cut in 0..reload_length {
    if workspace.decode(reload_bytes[..cut], &reloaded) {
      #panic("truncated patched reload accepted")
    }
  }
  // Edits far apart travel as pieces of the file plus literal bytes.
  records: [72]u8 = []
  words: [9]usize = [1, 0, 3, 0, 0, 300000000, 1, 3, 4]
  for word in 0..9 {
    for byte in 0..8 {
      records[word * 8 + byte] = #cast(u8, (words[word] >> (byte * 8)) & 255)
    }
  }
  reload.buffers[0].pieces = records[..]
  reload.buffers[0].patch = "AAA\nZZZ"
  reload_length = workspace.encode(&reload, reload_bytes[..])
  if reload_length == 0 || reload_length != workspace.encoded_size(&reload) {
    #panic("piece reload sizing")
  }
  if !workspace.decode(reload_bytes[..reload_length], &reloaded) {
    #panic("piece reload roundtrip")
  }
  if #len(reloaded.buffers[0].pieces) != 72 || !buffer.equal(reloaded.buffers[0].patch, "AAA\nZZZ") {
    #panic("piece reload fields")
  }
  reload.buffers[0].pieces = records[..0]
  reload.buffers[0].patched = false
  reload.buffers[0].path = "relative.log"
  reload_length = workspace.encode(&reload, reload_bytes[..])
  if workspace.decode(reload_bytes[..reload_length], &reloaded) {
    #panic("relative reload path accepted")
  }
  decoded := workspace.State{}
  if !workspace.decode(bytes[..length], &decoded) || !buffer.equal(decoded.buffers[0].text, "new\nα") || !buffer.equal(decoded.buffers[0].saved, "old") {
    #panic("roundtrip")
  }
  if decoded.buffers[0].secondary.count != 1 || decoded.panes[0].secondary.ranges[0].cursor != 6 {
    #panic("session selections")
  }
  size: usize = 0
  for size < length {
    if workspace.decode(bytes[..size], &decoded) {
      #panic("truncation accepted")
    }
    size += 1
  }
  state.panes[0].branch = true
  state.panes[0].first = 0
  state.panes[0].second = 0
  length = workspace.encode(&state, bytes[..])
  if workspace.decode(bytes[..length], &decoded) {
    #panic("cycle accepted")
  }
  state.panes[0].branch = false
  state.panes[0].slot = 16
  length = workspace.encode(&state, bytes[..])
  if workspace.decode(bytes[..length], &decoded) {
    #panic("invalid slot accepted")
  }
}

fn dynamic_workspace_checks() {
  state := workspace.State{project: "/tmp", active: 79}
  defer workspace.release(&state)
  if !workspace.prepare(&state, 80) || workspace.buffer_count(&state) != 80 {
    #panic("dynamic workspace allocation")
  }
  for index in 0..80 {
    item := workspace.buffer_mut(&state, index)
    item.* = workspace.SavedBuffer{used: true, text: "body", saved: "old", cursor: index % 5, filetype: "txt"}
  }
  workspace.buffer_mut(&state, 79).path = "/tmp/last"
  workspace.buffer_mut(&state, 78).* = workspace.SavedBuffer{used: true, reload: true, path: "/tmp/reload", cursor: 900}
  state.panes[0] = workspace.SavedPane{used: true, slot: 79, cursor: 2, percent: 50}
  bytes: [32768]u8 = []
  length := workspace.encode(&state, bytes[..])
  if length == 0 || length != workspace.encoded_size(&state) {
    #panic("dynamic sizing")
  }
  decoded := workspace.State{}
  defer workspace.release(&decoded)
  for iteration in 0..32 {
    if !workspace.decode(bytes[..length], &decoded) || workspace.buffer_count(&decoded) != 80 || decoded.active != 79 || decoded.panes[0].slot != 79 {
      #panic("eighty buffer session roundtrip")
    }
    for index in 0..80 {
      item := workspace.buffer_at(&decoded, index)
      if !item.used {
        #panic("session lost a buffer")
      }
      if index == 78 {
        if !item.reload || item.cursor != 900 {
          #panic("dynamic recovery entry")
        }
      } else if !buffer.equal(item.text, "body") || item.cursor != index % 5 {
        #panic("dynamic buffer content")
      }
    }
  }
  if workspace.prepare(&state, #cast(usize, -1)) || workspace.buffer_count(&state) != 80 || !buffer.equal(workspace.buffer_at(&state, 79).path, "/tmp/last") {
    #panic("failed growth preserves snapshot")
  }
  if !workspace.prepare(&state, 128) || !buffer.equal(workspace.buffer_at(&state, 79).text, "body") {
    #panic("snapshot growth preserves records")
  }
  // V3's count follows version, project, active and focused fields.
  count_offset: usize = 8 + 13 + 8 + 4 + 8 + 8
  invalid_counts: [4]usize = [0, 16, 100000000, #cast(usize, -1)]
  for count in invalid_counts {
    for offset in 0..8 {
      bytes[count_offset + offset] = #cast(u8, (count >> (offset * 8)))
    }
    if workspace.decode(bytes[..length], &decoded) || workspace.buffer_count(&decoded) != 16 {
      #panic("malformed dynamic count accepted or retained metadata")
    }
  }
  for offset in 0..8 {
    bytes[count_offset + offset] = #cast(u8, (#cast(usize, 80) >> (offset * 8)))
  }
  for cut in [0, 20, 48, 56, 60] {
    if workspace.decode(bytes[..cut], &decoded) {
      #panic("dynamic header truncation")
    }
  }
  if workspace.decode(bytes[..length-1], &decoded) {
    #panic("dynamic payload truncation")
  }
  if !workspace.decode(bytes[..length], &decoded) {
    #panic("dynamic decoder reusable after failure")
  }
  workspace.release(&decoded)
  workspace.release(&decoded)
}

// Frozen v1 layout: empty named workspace, one empty buffer, one leaf pane.
// V1 has no selection-count fields and must remain readable after v3 growth.
fn legacy_workspace_checks() {
  bytes: [433]u8 = []
  bytes[0] = 13
  version: []const u8 = "DNA session 1"
  _ = buffer.copy_bytes(&bytes[8], &version[0], #len(version))
  bytes[21] = 4
  project: []const u8 = "/tmp"
  _ = buffer.copy_bytes(&bytes[29], &project[0], #len(project))
  bytes[49] = 1
  bytes[225] = 1
  bytes[297] = 50
  state := workspace.State{}
  defer workspace.release(&state)
  if !workspace.decode(bytes[..], &state) || workspace.buffer_count(&state) != 16 || !state.buffers[0].used || state.panes[0].branch {
    #panic("legacy v1 compatibility")
  }
}
