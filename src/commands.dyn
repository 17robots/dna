// Command metadata shared by palette, exact command aliases and leader menu.
// Context-sensitive/argument commands keep their domain-specific parsers.
// arguments names what follows the command, for palette suggestions (see
// palette_arguments.dyn); a leading "!" means it is required, so choosing the
// command types its name into the palette instead of running it.
struct CommandInfo { label, aliases, key, hint, arguments: []const u8 }
const BuiltinCommands: usize = 112
const PluginCommandBase: usize = 128
fn command_info(id: usize) CommandInfo {
