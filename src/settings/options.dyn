pub fn option(index: usize) Option {
  return options[index]
}
// The table index of KEY, or OptionCount when no option has that name.
pub fn find(key: str) usize {
  for index in 0..OptionCount {
    if buffer.equal(options[index].key, key) { return index }
  }
  return OptionCount
}
// The name :set uses: the key, or the local name of an option spelled only
// inside its section ([modules] explorer).
pub fn set_name(spec: Option) str {
  if spec.only_in_section { return spec.local }
  return spec.key
}
// The option NAME names by its key or its :set name, or OptionCount.
pub fn lookup(name: str) usize {
  index := find(name)
  if index < OptionCount { return index }
  for candidate in 0..OptionCount {
    if buffer.equal(set_name(options[candidate]), name) { return candidate }
  }
  return OptionCount
}
// Whether a configuration layer set KEY, rather than leaving its default.
pub fn explicit(result: *const Settings, key: str) bool {
  index := find(key)
  return index < OptionCount && (result.explicit & (#cast(u64, 1) << index)) != 0
}
// The default as people read it.
pub fn shown_default(spec: Option) str {
  if spec.shown_default.len > 0 { return spec.shown_default }
  text := spec.default_value
  if text.len >= 2 && text[0] == '"' && text[text.len - 1] == '"' { return text[1..text.len - 1] }
  return text
}
// The name of choice CHOICE, or "" past the end of the list.
pub fn choice_name(spec: Option, choice: u8) str {
  index: u8 = 0
  at: usize = 0
  for at < spec.choices.len {
    end := at
    for end < spec.choices.len && spec.choices[end] != ' ' {
      end += 1
    }
    if index == choice { return spec.choices[at..end] }
    index += 1
    at = end + 1
  }
  return ""
}
// The index of quoted VALUE among NAMES, or 255 when it is not one of them.
fn choice_index(names: str, value: str) u8 {
  if value.len < 3 || value[0] != '"' || value[value.len - 1] != '"' { return 255 }
  wanted := value[1..value.len - 1]
  index: u8 = 0
  at: usize = 0
  for at < names.len {
    end := at
    for end < names.len && names[end] != ' ' {
      end += 1
    }
    if buffer.equal(names[at..end], wanted) { return index }
    index += 1
    at = end + 1
  }
  return 255
}
// Index of a module name within its slot, or 255 when unknown.
pub fn module_choice(slot: str, value: str) u8 {
  index := find(slot)
  if index == OptionCount || options[index].kind != .Choice { return 255 }
  return choice_index(options[index].choices, value)
}
// Check TEXT, a configuration value, against the option's rule and store it.
// False leaves RESULT unchanged.
fn apply(result: *Settings, index: usize, text: str) bool {
  spec := options[index]
  case spec.kind {
    .Flag => {
      if buffer.equal(text, "true") { return set_flag(result, spec.key, true) }
      if buffer.equal(text, "false") { return set_flag(result, spec.key, false) }
      return false
    }
    .Number => {
      value := number(text)
      if value < spec.minimum || value > spec.maximum || (spec.integer && #cast(f32, (#cast(usize, value))) != value) {
        return false
      }
      return set_number(result, spec.key, value)
    }
    .Text => {
      if text.len < 2 || text[0] != '"' || text[text.len - 1] != '"' { return false }
      value := text[1..text.len - 1]
      if value.len > spec.limit || (value.len == 0 && !spec.empty) { return false }
      if spec.plain {
        for byte in value {
          if byte < 32 || byte == '"' || byte == '\\' { return false }
        }
      }
      return set_text(result, spec.key, value)
    }
    .Choice => {
      choice := choice_index(spec.choices, text)
      if choice == 255 { return false }
      return set_choice(result, spec.key, choice)
    }
    .Key => {
      if text.len < 3 || text[0] != '"' || text[text.len - 1] != '"' { return false }
      escape := parse_key(text[1..text.len - 1])
      if escape.key == 0 || escape.modifiers == 0 { return false }
      result.terminal_escape = escape.key
      result.terminal_modifiers = escape.modifiers
      return true
    }
  }
}

// Each option's field, by kind. A key the table does not have reads as zero
// and refuses to store.
fn set_flag(result: *Settings, key: str, value: bool) bool {
  case key {
    "reduced_motion" => { result.reduced_motion = value }
    "line_numbers" => { result.line_numbers = value }
    "relative_numbers" => { result.relative_numbers = value }
    "status_line" => { result.status_line = value }
    "highlight_line" => { result.highlight_line = value }
    "explorer_icons" => { result.explorer_icons = value }
    "explorer_columns" => { result.explorer_columns = value }
    "explorer_preview" => { result.explorer_preview = value }
    "smooth_cursor" => { result.smooth_cursor = value }
    "smooth_scroll" => { result.smooth_scroll = value }
    "popup_transitions" => { result.popup_transitions = value }
    "mouse_enabled" => { result.mouse_enabled = value }
    "picker_preview" => { result.picker_preview = value }
    "syntax_enabled" => { result.syntax_enabled = value }
    "recovery_enabled" => { result.recovery_enabled = value }
    "reload_clean_buffers" => { result.reload_clean_buffers = value }
    "insert_tabs" => { result.insert_tabs = value }
    "final_newline" => { result.final_newline = value }
    "trim_trailing_whitespace" => { result.trim_trailing_whitespace = value }
    "automatic_completion" => { result.automatic_completion = value }
    "reload_config" => { result.reload_config = value }
    "equalize_splits" => { result.equalize_splits = value }
    "default_servers" => { result.default_servers = value }
    "explorer_close_on_open" => { result.explorer_close_on_open = value }
    _ => { return false }
  }
  return true
}
pub fn option_flag(result: *const Settings, key: str) bool {
  case key {
    "reduced_motion" => { return result.reduced_motion }
    "line_numbers" => { return result.line_numbers }
    "relative_numbers" => { return result.relative_numbers }
    "status_line" => { return result.status_line }
    "highlight_line" => { return result.highlight_line }
