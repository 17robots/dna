fn server_tool(app: *App, verb: []const u8, name: []const u8) {
  if buffer.equal(name, "dyn") {
    if buffer.equal(verb, "server-start") {
      lsp_start(app, "dyn", "dyn lsp")
    }
    else {
      notice(app, "Dyn's language server is included in the compiler. Install or update Dyn with mise; no separate server package is needed.")
    }
    return
  }
  if #len(name) == 0 || #len(name) > 64 {
    notice(app, "Supply a server name from :languages.")
    return
  }
  for byte in name {
    if !((byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 95) {
      notice(app, "Server name must use lowercase letters, digits, and underscores.")
      return
    }
  }
  helper: [4096]u8 = []
  if language_helper(&helper[0], 4096) == 0 {
    notice(app, "Cannot locate the language helper.")
    return
  }
  command: [32768]u8 = []
  used: usize = 0
  add_text(command[..], &used, "DNA_LANGUAGE_DIR=")
  shell_quote(command[..], &used, app.workspace.language_root[..app.workspace.language_root_length])
  add_text(command[..], &used, " ")
  shell_quote(command[..], &used, helper[..c.string_length(&helper[0], 4096)])
  add_text(command[..], &used, " ")
  if buffer.equal(verb, "server-start") {
    add_text(command[..], &used, "server-run")
  } else {
    add_text(command[..], &used, verb)
  }
  add_text(command[..], &used, " ")
  shell_quote(command[..], &used, name)
  if buffer.equal(verb, "server-start") {
    lsp_start(app, name, command[..used])
    for index in 0..8 {
      server := &app.lsp.servers[index]
      if server.process != nil && buffer.equal(server.language[..server.length], name) { server.managed = true }
    }
  } else {
    terminal_show(app, true, command[..used])
  }
}
