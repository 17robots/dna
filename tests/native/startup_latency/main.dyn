extern fn startup_clock "clock_gettime"(kind: i32, time: *StartupTime) i32
extern fn startup_number "strtod"(text: *const u8, end: rawptr) f64
struct StartupTime { seconds, nanoseconds: i64 }
reported: bool = false
pub fn SDL_RenderPresent(renderer: rawptr) bool {
  next := #cast(*fn(rawptr) bool) probe_next("SDL_RenderPresent\0")
  result := next(renderer)
  if !reported {
    reported = true
    now := StartupTime{}
    _ = startup_clock(1, &now)
    start := startup_number(probe_env("DNA_STARTUP_BEGIN\0"), nil)
    elapsed := (#cast(f64) now.seconds + #cast(f64) now.nanoseconds / 1000000000.0 - start) * 1000.0
    probe_log("DNA first frame ")
    probe_decimal(elapsed)
    probe_log(" ms\n")
    event := ProbeEvent{}
    probe_kind(#cast(rawptr) &event).* = 256
    _ = probe_push(#cast(rawptr) &event)
  }
  return result
}
