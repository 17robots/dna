// Stable, bounded records for the editor's package manager. Registry names
// cannot contain tabs/newlines; installation state comes from actual files.
fn grammar_installed(root: []const u8, name: []const u8) bool {
  package_storage: [4096]u8 = []
  file_storage: [4096]u8 = []
  active := append_path(package_storage[..], root, name)
  version_storage: [4096]u8 = []
  package := installer_package_path(active, version_storage[..])
  if #len(package) == 0 {
    return false
  }
  for leaf in ["parser.so", "highlights.scm", "extensions"] {
    info := std_fs.metadata(append_path(file_storage[..], package, leaf))
    if !info.ok || (info.mode & 61440) != 32768 || info.size == 0 {
      return false
    }
  }
  return true
}
fn catalog(registry: *Registry, root: []const u8) {
  for index in 0..registry.count {
    state: []const u8 = "available"
    if grammar_installed(root, registry.entries[index].name) {
      state = "installed"
    }
    _ = io.println(io.stdout(), "grammar\t{}\t{}", registry.entries[index].name, state)
  }
  for index in 0..9 {
    item := server_package(index)
    storage: [4096]u8 = []
    info := std_fs.metadata(server_executable(root, item, storage[..]))
    state: []const u8 = "available"
    if info.ok && installer_executable(server_executable(root, item, storage[..])) {
      state = "installed"
    }
    _ = io.println(io.stdout(), "server\t{}\t{}", item.name, state)
  }
}
fn uninstall(root: []const u8, name: []const u8) {
  if !identifier(name) {
    #panic("invalid package name")
  }
  active_storage: [4096]u8 = []
  target_storage: [4096]u8 = []
  prefix_storage: [4096]u8 = []
  active := append_path(active_storage[..], root, name)
  target_space := mem.arena_create(4096)
  defer mem.arena_release(target_space)
  target := installer_read_link(target_space, active)
  if !target.ok {
    #panic("refusing to remove a package not managed by DNA")
  }
  used: usize = 0
  add(prefix_storage[..], &used, root)
  add(prefix_storage[..], &used, "/.")
  add(prefix_storage[..], &used, name)
  add(prefix_storage[..], &used, "-")
  if #len(target.value) != used + 6 || !equal(target.value[..used], prefix_storage[..used]) {
    #panic("package points outside its managed directory")
  }
  for byte in target.value[used..] {
    if !((byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z') || (byte >= '0' && byte <= '9')) {
      #panic("invalid managed version")
    }
  }
  if !std_fs.remove(active).ok {
    #panic("cannot deactivate package")
  }
  removed := installer_remove_tree(target.value)
  if !removed.ok && removed.error != -2 {
    #panic("package deactivated but cleanup failed; refresh the package list")
  }
  _ = io.println(io.stdout(), "Uninstalled {}. Older retained versions are unchanged.", name)
}
