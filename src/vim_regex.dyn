// Vim regular expressions (:help pattern) translated to PCRE2 for the Vim
// keymap's / ? :s and :g. Magic levels \v \m \M \V, \c \C, groups \( \%( \),
// branches \| and \&, multis * \+ \= \? \{n,m} \{-n,m} \@= \@! \@<= \@<! \@>,
// \< \> \zs \ze, character classes (\s \d \w \a \l \u \x \o \h \k \i \f \p and
// their negations), \_x newline variants, [] collections with Vim's escapes
// and [:name:] classes, \%^ \%$ \%[] \%d \%x \%u \%U \%o, ~ and \1-\9.
//
// Position constraints PCRE2 cannot express (\%V \%# \%23l \%23c \%23v
// \%'m and their < > forms) become filters, each with a (?Cn) callout where
// it stands; the caller checks filter n at the callout's position. Vim's .
// and negated classes never match a line break, so negated classes exclude
// \n unless written with \_.

const VimRxNone: usize = 0xffffffffffffffff
// Filter value meaning "the cursor's line or column" (\%.l, \%.c, \%.v).
const VimRxCursor: usize = 0xfffffffffffffffe

struct VimRegexFilter { kind: u8, compare: u8, value: usize }
struct VimRegex {
  valid: bool,
  message: []const u8,
  // The pattern can match a line break, so matching one line at a time is
  // not enough.
  multiline: bool,
  // 'c' for \c, 'C' for \C, 0 when the pattern does not say.
  case: u8,
  filters: [8]VimRegexFilter,
  filter_count: usize,
}
struct RxOut { bytes: []u8, used: usize, overflow: bool }
struct RxGroup { open: usize, branch: usize, ze: bool }
struct RxToken { byte: u8, escaped: bool, size: usize }

fn rx_add(out: *RxOut, text: []const u8) {
  if out.used + #len(text) >= #len(out.bytes) {
    out.overflow = true
    return
  }
  for byte in text {
    out.bytes[out.used] = byte
    out.used += 1
  }
}
fn rx_byte(out: *RxOut, byte: u8) {
  single: [1]u8 = [byte]
  rx_add(out, single[..])
}
fn rx_insert(out: *RxOut, at: usize, text: []const u8) {
  if out.used + #len(text) >= #len(out.bytes) {
    out.overflow = true
    return
  }
  index := out.used
  for index > at {
    index -= 1
    out.bytes[index + #len(text)] = out.bytes[index]
  }
  for offset in 0..#len(text) {
    out.bytes[at + offset] = text[offset]
  }
  out.used += #len(text)
}
fn rx_one_of(byte: u8, set: []const u8) bool {
  for candidate in set {
    if candidate == byte {
      return true
    }
  }
  return false
}
// One byte matched literally, escaped when PCRE2 gives it a meaning.
fn rx_literal(out: *RxOut, byte: u8) {
  if rx_one_of(byte, "\\^$.|?*+()[]{}") {
    rx_byte(out, '\\')
  }
  rx_byte(out, byte)
}
fn rx_char_size(byte: u8) usize {
  if byte < 0xc0 {
    return 1
  }
  if byte < 0xe0 {
    return 2
  }
  if byte < 0xf0 {
    return 3
  }
  return 4
}
fn rx_token(source: []const u8, at: usize) RxToken {
  if source[at] == '\\' && at + 1 < #len(source) {
    return RxToken{byte: source[at + 1], escaped: true, size: 2}
  }
  return RxToken{byte: source[at], escaped: false, size: 1}
}
// Characters with a pattern meaning in some magic level; ^ and $ depend on
// their position and are handled apart.
fn rx_special_set(byte: u8) bool {
  return rx_one_of(byte, "()|+?={@%<>.*[~&")
}
// Whether the character has its meaning without a backslash at this level.
fn rx_plain_special(byte: u8, mode: u8) bool {
  if mode == 3 {
    return rx_special_set(byte)
  }
  if mode == 2 {
    return rx_one_of(byte, ".*[~")
  }
  return false
}
fn rx_is_special(token: RxToken, mode: u8) bool {
  return rx_special_set(token.byte) && token.escaped != rx_plain_special(token.byte, mode)
}
// $ means end-of-line only before the end of a branch.
fn rx_ends_branch(source: []const u8, at: usize, mode: u8) bool {
  if at >= #len(source) {
    return true
  }
  token := rx_token(source, at)
  if token.escaped && token.byte == 'n' {
    return true
  }
  return (token.byte == '|' || token.byte == ')' || token.byte == '&') && rx_is_special(token, mode)
}
// Class body for a class letter; negated classes are written [^body].
struct RxClass { body: []const u8, negated: bool, valid: bool }
fn rx_class(letter: u8) RxClass {
  if letter == 's' || letter == 'S' {
    return RxClass{body: " \\t", negated: letter == 'S', valid: true}
  }
  if letter == 'd' || letter == 'D' {
    return RxClass{body: "0-9", negated: letter == 'D', valid: true}
  }
  if letter == 'w' || letter == 'W' {
    return RxClass{body: "0-9A-Za-z_", negated: letter == 'W', valid: true}
  }
  if letter == 'a' || letter == 'A' {
    return RxClass{body: "A-Za-z", negated: letter == 'A', valid: true}
  }
  if letter == 'l' || letter == 'L' {
    return RxClass{body: "a-z", negated: letter == 'L', valid: true}
  }
  if letter == 'u' || letter == 'U' {
    return RxClass{body: "A-Z", negated: letter == 'U', valid: true}
  }
  if letter == 'x' || letter == 'X' {
    return RxClass{body: "0-9A-Fa-f", negated: letter == 'X', valid: true}
  }
  if letter == 'o' || letter == 'O' {
    return RxClass{body: "0-7", negated: letter == 'O', valid: true}
  }
  if letter == 'h' || letter == 'H' {
    return RxClass{body: "A-Za-z_", negated: letter == 'H', valid: true}
  }
  // \k \i \f \p and their digit-free upper-case forms.
  if letter == 'k' || letter == 'i' {
    return RxClass{body: "\\p{L}\\p{N}_", valid: true}
  }
  if letter == 'K' || letter == 'I' {
    return RxClass{body: "\\p{L}_", valid: true}
  }
  if letter == 'f' {
    return RxClass{body: "\\p{L}\\p{N}_/.\\-+,#$%~=", valid: true}
  }
  if letter == 'F' {
    return RxClass{body: "\\p{L}_/.\\-+,#$%~=", valid: true}
  }
  if letter == 'p' {
    return RxClass{body: "\\x20-\\x7e\\x{a0}-\\x{10ffff}", valid: true}
  }
  if letter == 'P' {
    return RxClass{body: "\\x20-\\x2f\\x3a-\\x7e\\x{a0}-\\x{10ffff}", valid: true}
  }
  return RxClass{}
}
fn rx_emit_class(out: *RxOut, class: RxClass, newline: bool) {
  rx_add(out, "[")
  if class.negated {
    rx_add(out, "^")
  }
  rx_add(out, class.body)
  if class.negated != newline {
    rx_add(out, "\\n")
  }
  rx_add(out, "]")
}
fn rx_hex(out: *RxOut, value: usize) {
  digits: [16]u8 = []
  count: usize = 0
  rest := value
  for count == 0 || rest > 0 {
    digit := #cast(u8, rest % 16)
    if digit < 10 {
      digits[count] = '0' + digit
    } else {
      digits[count] = 'a' + digit - 10
    }
    count += 1
    rest /= 16
  }
  rx_add(out, "\\x{")
  for count > 0 {
    count -= 1
    rx_byte(out, digits[count])
  }
  rx_add(out, "}")
}
fn rx_digit(byte: u8, base: usize) usize {
  value: usize = 99
  if byte >= '0' && byte <= '9' {
    value = #cast(usize, byte - '0')
  } else if byte >= 'a' && byte <= 'f' {
    value = #cast(usize, byte - 'a') + 10
  } else if byte >= 'A' && byte <= 'F' {
    value = #cast(usize, byte - 'A') + 10
  }
  if value >= base {
    return 99
  }
  return value
}
// A numbered character after \%d \%x \%u \%U \%o, or \d \o \x \u \U in [].
// Returns the index after the digits, or at when there were none.
fn rx_code(source: []const u8, at: usize, kind: u8, value: *usize) usize {
  base: usize = 16
  limit: usize = 2
  if kind == 'd' {
    base = 10
    limit = 10
  } else if kind == 'o' {
    base = 8
    limit = 4
  } else if kind == 'u' {
    limit = 4
  } else if kind == 'U' {
    limit = 8
  }
  index := at
  value.* = 0
  for index < #len(source) && index - at < limit && rx_digit(source[index], base) != 99 {
    value.* = value.* * base + rx_digit(source[index], base)
    index += 1
  }
  if value.* > 0x10ffff {
    value.* = 0x10ffff
  }
  return index
}
// [] collection starting after the [. Returns the index after its ], or 0
// when there is no closing ] (the [ is then a literal).
fn rx_collection(source: []const u8, at: usize, out: *RxOut, newline: bool, regex: *VimRegex) usize {
  index := at
  if index < #len(source) && source[index] == '^' {
    index += 1
  }
  if index < #len(source) && source[index] == ']' {
    index += 1
  }
  for index < #len(source) && source[index] != ']' {
    if source[index] == '[' && index + 1 < #len(source) && (source[index + 1] == ':' || source[index + 1] == '=' || source[index + 1] == '.') {
      close := index + 2
      for close + 1 < #len(source) && !(source[close] == source[index + 1] && source[close + 1] == ']') {
        close += 1
      }
      if close + 1 < #len(source) {
        index = close + 2
        continue
      }
    }
    if source[index] == '\\' && index + 1 < #len(source) {
      index += 2
      continue
    }
    index += 1
  }
  if index >= #len(source) {
    return 0
  }
  end := index
  index = at
  negated := false
  rx_add(out, "[")
  if source[index] == '^' {
    negated = true
    rx_add(out, "^")
    index += 1
  }
  if source[index] == ']' {
    rx_add(out, "\\]")
    index += 1
  }
  for index < end {
    byte := source[index]
    if byte == '[' && index + 1 < end && (source[index + 1] == ':' || source[index + 1] == '=' || source[index + 1] == '.') {
      kind := source[index + 1]
      close := index + 2
      for close + 1 < #len(source) && !(source[close] == kind && source[close + 1] == ']') {
        close += 1
      }
      if close + 1 < #len(source) && close + 1 <= end {
        name := source[index + 2..close]
        index = close + 2
        if kind != ':' {
          for item in name {
            rx_literal(out, item)
          }
        } else if buffer.equal(name, "return") {
          rx_add(out, "\\r")
        } else if buffer.equal(name, "tab") {
          rx_add(out, "\\t")
        } else if buffer.equal(name, "escape") {
          rx_add(out, "\\x1b")
        } else if buffer.equal(name, "backspace") {
          rx_add(out, "\\x08")
        } else if buffer.equal(name, "ident") || buffer.equal(name, "keyword") {
          rx_add(out, "\\p{L}\\p{N}_")
        } else if buffer.equal(name, "fname") {
          rx_add(out, "\\p{L}\\p{N}_/.\\-+,#$%~=")
        } else {
          rx_add(out, "[:")
          rx_add(out, name)
          rx_add(out, ":]")
        }
        continue
      }
    }
    if byte == '\\' && index + 1 < end {
      escaped := source[index + 1]
      index += 2
      if escaped == 'e' {
        rx_add(out, "\\x1b")
      } else if escaped == 't' {
        rx_add(out, "\\t")
      } else if escaped == 'r' {
        rx_add(out, "\\r")
      } else if escaped == 'b' {
        rx_add(out, "\\x08")
      } else if escaped == 'n' {
        rx_add(out, "\\n")
        regex.multiline = true
      } else if escaped == 'd' || escaped == 'o' || escaped == 'x' || escaped == 'u' || escaped == 'U' {
        value: usize = 0
        after := rx_code(source, index, escaped, &value)
        if after == index {
          rx_add(out, "\\\\")
          rx_literal(out, escaped)
        } else {
          rx_hex(out, value)
          index = after
        }
      } else if escaped == '\\' || escaped == ']' || escaped == '^' || escaped == '-' {
        rx_byte(out, '\\')
        rx_byte(out, escaped)
      } else {
        // Any other backslash in [] is a literal backslash.
        rx_add(out, "\\\\")
        index -= 1
      }
      continue
    }
    if byte == '[' || byte == '\\' {
      rx_byte(out, '\\')
    }
    rx_byte(out, byte)
    index += 1
  }
  if negated != newline {
    rx_add(out, "\\n")
  }
  if newline {
    regex.multiline = true
  }
  rx_add(out, "]")
  return end + 1
}
fn rx_close_ze(out: *RxOut, group: *RxGroup) {
  if group.ze {
    rx_add(out, ")")
    group.ze = false
  }
}
fn rx_fail(regex: *VimRegex, message: []const u8) usize {
  regex.valid = false
  regex.message = message
  return 0
}
// A \% position item: recorded, and a callout (?Cn) placed where it stands,
// so the matcher checks it at that point of the match.
fn rx_filter(regex: *VimRegex, out: *RxOut, kind: u8, compare: u8, value: usize) bool {
  if regex.filter_count == #len(regex.filters) {
    return false
  }
  regex.filters[regex.filter_count] = VimRegexFilter{kind: kind, compare: compare, value: value}
  regex.filter_count += 1
  number: [1]u8 = ['0' + #cast(u8, regex.filter_count)]
  rx_add(out, "(?C")
  rx_add(out, number[..])
  rx_add(out, ")")
  return true
}
// \% items after the %. Returns the index after the item, or 0 on error.
fn rx_percent(source: []const u8, at: usize, out: *RxOut, regex: *VimRegex, atom: *usize) usize {
  if at >= #len(source) {
    return rx_fail(regex, "E71: Invalid character after \\%")
  }
  byte := source[at]
  if byte == '^' {
    rx_add(out, "\\A")
    regex.multiline = true
    atom.* = VimRxNone
    return at + 1
  }
  if byte == '$' {
    rx_add(out, "\\z")
    regex.multiline = true
    atom.* = VimRxNone
    return at + 1
  }
  if byte == 'V' || byte == '#' {
    if !rx_filter(regex, out, byte, '=', 0) {
      return rx_fail(regex, "Too many \\% position items.")
    }
    atom.* = VimRxNone
    return at + 1
  }
  if byte == 'C' {
    return at + 1
  }
  if byte == 'd' || byte == 'x' || byte == 'u' || byte == 'U' || byte == 'o' {
    value: usize = 0
    after := rx_code(source, at + 1, byte, &value)
    if after == at + 1 {
      return rx_fail(regex, "E678: Invalid character after \\%[dxouU]")
    }
    atom.* = out.used
    rx_hex(out, value)
    return after
  }
  if byte == '[' {
    // \%[abc]: a, ab or abc, as long as possible.
    index := at + 1
    count: usize = 0
    atom.* = out.used
    for index < #len(source) && source[index] != ']' {
      rx_add(out, "(?:")
      if source[index] == '\\' && index + 1 < #len(source) {
        rx_literal(out, source[index + 1])
        index += 2
      } else {
        size := rx_char_size(source[index])
        if size == 1 {
          rx_literal(out, source[index])
        } else {
          for offset in 0..size {
            if index + offset < #len(source) {
              rx_byte(out, source[index + offset])
            }
          }
        }
        index += size
      }
      count += 1
    }
    if index >= #len(source) || count == 0 {
      return rx_fail(regex, "E69: Missing ] after \\%[")
    }
    for step in 0..count {
      rx_add(out, ")?")
    }
    return index + 1
  }
  // \%23l \%<23l \%>23l \%.l, the same with c and v, and \%'m \%<'m \%>'m.
  compare: u8 = '='
  index := at
  if source[index] == '<' || source[index] == '>' {
    compare = source[index]
    index += 1
  }
  if index < #len(source) && source[index] == 39 {
    if index + 1 >= #len(source) {
      return rx_fail(regex, "E71: Invalid character after \\%")
    }
    if !rx_filter(regex, out, 'm', compare, #cast(usize, source[index + 1])) {
      return rx_fail(regex, "Too many \\% position items.")
    }
    atom.* = VimRxNone
    return index + 2
  }
  value: usize = 0
  digits := index
  if index < #len(source) && source[index] == '.' {
    value = VimRxCursor
    index += 1
  } else {
    for index < #len(source) && source[index] >= '0' && source[index] <= '9' && value < 100000000 {
      value = value * 10 + #cast(usize, source[index] - '0')
      index += 1
    }
  }
  if index == digits || index >= #len(source) || (source[index] != 'l' && source[index] != 'c' && source[index] != 'v') {
    return rx_fail(regex, "E71: Invalid character after \\%")
  }
  if !rx_filter(regex, out, source[index], compare, value) {
    return rx_fail(regex, "Too many \\% position items.")
  }
  atom.* = VimRxNone
  return index + 1
}
// \{n,m} after the {. Returns the index after the }, or 0 on error.
fn rx_brace(source: []const u8, at: usize, out: *RxOut, regex: *VimRegex) usize {
  index := at
  lazy := false
  if index < #len(source) && source[index] == '-' {
    lazy = true
    index += 1
  }
  low_start := index
  for index < #len(source) && source[index] >= '0' && source[index] <= '9' {
    index += 1
  }
  low := source[low_start..index]
  comma := false
  high: []const u8 = ""
  if index < #len(source) && source[index] == ',' {
    comma = true
    index += 1
    high_start := index
    for index < #len(source) && source[index] >= '0' && source[index] <= '9' {
      index += 1
    }
    high = source[high_start..index]
  }
  if index < #len(source) && source[index] == '\\' {
    index += 1
  }
  if index >= #len(source) || source[index] != '}' {
    return rx_fail(regex, "E554: Syntax error in \\{...}")
  }
  if #len(low) == 0 && #len(high) == 0 {
    rx_add(out, "*")
  } else if !comma {
    rx_add(out, "{")
    rx_add(out, low)
    rx_add(out, "}")
    lazy = false
  } else {
    rx_add(out, "{")
    if #len(low) == 0 {
      rx_add(out, "0")
    } else {
      rx_add(out, low)
    }
    rx_add(out, ",")
    rx_add(out, high)
    rx_add(out, "}")
  }
  if lazy {
    rx_add(out, "?")
  }
  return index + 1
}
// \@= \@! \@> \@<= \@<! (with an optional byte limit before < ) around the
// previous atom. Returns the index after the item, or 0 on error.
fn rx_around(source: []const u8, at: usize, out: *RxOut, regex: *VimRegex, atom: usize) usize {
  index := at
  for index < #len(source) && source[index] >= '0' && source[index] <= '9' {
    index += 1
  }
  if index >= #len(source) {
    return rx_fail(regex, "E64: @ follows nothing")
  }
  prefix: []const u8 = ""
  if source[index] == '=' {
    prefix = "(?="
  } else if source[index] == '!' {
    prefix = "(?!"
  } else if source[index] == '>' {
    prefix = "(?>"
  } else if source[index] == '<' && index + 1 < #len(source) && source[index + 1] == '=' {
    prefix = "(?<="
    index += 1
  } else if source[index] == '<' && index + 1 < #len(source) && source[index + 1] == '!' {
    prefix = "(?<!"
    index += 1
  } else {
    return rx_fail(regex, "E59: Invalid character after \\@")
  }
  rx_insert(out, atom, prefix)
  rx_add(out, ")")
  return index + 1
}

// Translate source into a PCRE2 pattern body in output; returns its length.
// The caller adds (?m) and, for ignore case, (?i). previous is the last
// substitute string, for ~.
fn vim_regex(source: []const u8, magic: bool, previous: []const u8, output: []u8, regex: *VimRegex) usize {
  regex.* = VimRegex{valid: true}
  out := RxOut{bytes: output}
  mode: u8 = 2
  if !magic {
    mode = 1
  }
  groups: [32]RxGroup = []
  depth: usize = 0
  groups[0] = RxGroup{}
  atom := VimRxNone
  at: usize = 0
  for at < #len(source) && !out.overflow && regex.valid {
    token := rx_token(source, at)
    byte := token.byte
    fresh := out.used == groups[depth].branch
    if byte == '^' && ((mode >= 1 && !token.escaped && fresh) || (mode == 0 && token.escaped)) {
      rx_add(&out, "^")
      atom = VimRxNone
      at += token.size
      continue
    }
    if byte == '$' && ((mode >= 1 && !token.escaped) || (mode == 0 && token.escaped)) && rx_ends_branch(source, at + token.size, mode) {
      rx_add(&out, "$")
      atom = VimRxNone
      at += token.size
      continue
    }
    if token.escaped && !rx_special_set(byte) {
      at += 2
      if byte == 'v' {
        mode = 3
      } else if byte == 'm' {
        mode = 2
      } else if byte == 'M' {
        mode = 1
      } else if byte == 'V' {
        mode = 0
      } else if byte == 'c' {
        regex.case = 'c'
      } else if byte == 'C' {
        if regex.case != 'c' {
          regex.case = 'C'
        }
      } else if byte >= '1' && byte <= '9' {
        atom = out.used
        rx_byte(&out, '\\')
        rx_byte(&out, byte)
      } else if byte == 'z' {
        if at < #len(source) && source[at] == 's' {
          rx_add(&out, "\\K")
        } else if at < #len(source) && source[at] == 'e' {
          if !groups[depth].ze {
            rx_add(&out, "(?=")
            groups[depth].ze = true
          }
        } else {
          return rx_fail(regex, "E68: Invalid character after \\z")
        }
        at += 1
        atom = VimRxNone
      } else if byte == '_' {
        if at >= #len(source) {
          return rx_fail(regex, "E63: Invalid use of \\_")
        }
        next := source[at]
        at += 1
        if next == '^' {
          rx_add(&out, "^")
          atom = VimRxNone
        } else if next == '$' {
          rx_add(&out, "$")
          atom = VimRxNone
        } else if next == '.' {
          atom = out.used
          rx_add(&out, "[\\s\\S]")
          regex.multiline = true
        } else if next == '[' {
          atom = out.used
          after := rx_collection(source, at, &out, true, regex)
          if after == 0 {
            return rx_fail(regex, "E769: Missing ] after \\_[")
          }
          at = after
        } else if rx_class(next).valid {
          atom = out.used
          rx_emit_class(&out, rx_class(next), true)
          regex.multiline = true
        } else {
          return rx_fail(regex, "E63: Invalid use of \\_")
        }
      } else if byte == 'n' {
        atom = out.used
        rx_add(&out, "\\n")
        regex.multiline = true
      } else if byte == 't' {
        atom = out.used
        rx_add(&out, "\\t")
      } else if byte == 'e' {
        atom = out.used
        rx_add(&out, "\\x1b")
      } else if byte == 'r' {
        atom = out.used
        rx_add(&out, "\\r")
      } else if byte == 'b' {
        atom = out.used
        rx_add(&out, "\\x08")
      } else if rx_class(byte).valid {
        atom = out.used
        rx_emit_class(&out, rx_class(byte), false)
      } else {
        atom = out.used
        rx_literal(&out, byte)
      }
      continue
    }
    if !rx_special_set(byte) || !rx_is_special(token, mode) {
      // A literal character, whole UTF-8 sequence at once.
      atom = out.used
      if token.escaped || byte < 0x80 {
        rx_literal(&out, byte)
        at += token.size
        continue
      }
      size := rx_char_size(byte)
      for offset in 0..size {
        if at + offset < #len(source) {
          rx_byte(&out, source[at + offset])
        }
      }
      at += size
      continue
    }
    at += token.size
    if byte == '.' {
      atom = out.used
      rx_add(&out, ".")
    } else if byte == '*' || byte == '+' || byte == '=' || byte == '?' {
      if atom == VimRxNone {
        // A multi with nothing before it matches itself.
        atom = out.used
        rx_literal(&out, byte)
      } else if byte == '*' {
        rx_add(&out, "*")
      } else if byte == '+' {
        rx_add(&out, "+")
      } else {
        rx_add(&out, "?")
      }
    } else if byte == '{' {
      if atom == VimRxNone {
        return rx_fail(regex, "E64: { follows nothing")
      }
      after := rx_brace(source, at, &out, regex)
      if after == 0 {
        return 0
      }
      at = after
    } else if byte == '@' {
      if atom == VimRxNone {
        return rx_fail(regex, "E64: @ follows nothing")
      }
      after := rx_around(source, at, &out, regex, atom)
      if after == 0 {
        return 0
      }
      at = after
    } else if byte == '(' {
      if depth + 1 == #len(groups) {
        return rx_fail(regex, "E51: Too many \\(")
      }
      open := out.used
      rx_add(&out, "(")
      depth += 1
      groups[depth] = RxGroup{open: open, branch: out.used}
      atom = VimRxNone
    } else if byte == ')' {
      if depth == 0 {
        return rx_fail(regex, "E55: Unmatched \\)")
      }
      rx_close_ze(&out, &groups[depth])
      rx_add(&out, ")")
      atom = groups[depth].open
      depth -= 1
    } else if byte == '|' {
      rx_close_ze(&out, &groups[depth])
      rx_add(&out, "|")
      groups[depth].branch = out.used
      atom = VimRxNone
    } else if byte == '&' {
      // a\&b: b where a also matches.
      rx_close_ze(&out, &groups[depth])
      rx_insert(&out, groups[depth].branch, "(?=")
      rx_add(&out, ")")
      groups[depth].branch = out.used
      atom = VimRxNone
    } else if byte == '<' {
      rx_add(&out, "(?<![\\p{L}\\p{N}_])(?=[\\p{L}\\p{N}_])")
      atom = VimRxNone
    } else if byte == '>' {
      rx_add(&out, "(?<=[\\p{L}\\p{N}_])(?![\\p{L}\\p{N}_])")
      atom = VimRxNone
    } else if byte == '~' {
      atom = out.used
      rx_add(&out, "(?:")
      for item in previous {
        rx_literal(&out, item)
      }
      rx_add(&out, ")")
    } else if byte == '[' {
      atom = out.used
      after := rx_collection(source, at, &out, false, regex)
      if after == 0 {
        rx_literal(&out, '[')
      } else {
        at = after
      }
    } else if byte == '%' {
      if at < #len(source) && source[at] == '(' {
        if depth + 1 == #len(groups) {
          return rx_fail(regex, "E51: Too many \\(")
        }
        open := out.used
        rx_add(&out, "(?:")
        depth += 1
        groups[depth] = RxGroup{open: open, branch: out.used}
        atom = VimRxNone
        at += 1
      } else {
        after := rx_percent(source, at, &out, regex, &atom)
        if after == 0 {
          return 0
        }
        at = after
      }
    }
  }
  if !regex.valid {
    return 0
  }
  if depth != 0 {
    return rx_fail(regex, "E54: Unmatched \\(")
  }
  rx_close_ze(&out, &groups[0])
  if out.overflow {
    return rx_fail(regex, "Pattern is too long.")
  }
  return out.used
}
// A whole PCRE2 pattern for source: (?m), case, then the body. ignore is the
// case rule when the pattern has no \c or \C.
fn vim_regex_query(source: []const u8, magic: bool, ignore: bool, previous: []const u8, output: []u8, regex: *VimRegex) usize {
  if #len(output) < 16 {
    return rx_fail(regex, "Pattern is too long.")
  }
  length := vim_regex(source, magic, previous, output[10..], regex)
  if !regex.valid {
    return 0
  }
  prefix: []const u8 = "(?m)"
  if regex.case == 'c' || (regex.case == 0 && ignore) {
    prefix = "(?m)(?i)"
  }
  // The body was written after room for the prefix; move it into place.
  for index in 0..#len(prefix) {
    output[index] = prefix[index]
  }
  for index in 0..length {
    output[#len(prefix) + index] = output[10 + index]
  }
  return #len(prefix) + length
}
