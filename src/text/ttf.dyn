// The GUI text backend: SDL_ttf and DNA's tracked text objects. text.dyn's
// public functions call these unless the terminal frontend is active. Builds
// without the GUI replace this file with modules/stubs/text_ttf.dyn.
#link("SDL3_ttf")
pub extern fn init "TTF_Init"() bool
pub extern fn quit "TTF_Quit"()
extern fn ttf_open "TTF_OpenFont"(path: *const u8, points: f32) rawptr
extern fn ttf_close "TTF_CloseFont"(font: rawptr)
extern fn ttf_font_size "TTF_SetFontSize"(font: rawptr, points: f32) bool
extern fn ttf_line_skip "TTF_SetFontLineSkip"(font: rawptr, pixels: i32)
extern fn ttf_measure "TTF_GetStringSize"(font: rawptr, text: *const u8, length: usize, width: *i32, height: *i32) bool
extern fn ttf_engine "TTF_CreateRendererTextEngine"(renderer: rawptr) rawptr
extern fn ttf_destroy_engine "TTF_DestroyRendererTextEngine"(engine: rawptr)
extern fn ttf_create "dna_text_create"(engine: rawptr, font: rawptr, text: *const u8, length: usize) rawptr
extern fn ttf_destroy "dna_text_destroy"(text: rawptr)
extern fn ttf_set "TTF_SetTextString"(text: rawptr, bytes: *const u8, length: usize) bool
extern fn ttf_wrap "TTF_SetTextWrapWidth"(text: rawptr, pixels: i32) bool
extern fn ttf_color "TTF_SetTextColor"(text: rawptr, red: u8, green: u8, blue: u8, alpha: u8) bool
extern fn ttf_draw "TTF_DrawRendererText"(text: rawptr, x: f32, y: f32) bool
extern fn ttf_size "TTF_GetTextSize"(text: rawptr, width: *i32, height: *i32) bool
extern fn ttf_substring "TTF_GetTextSubString"(text: rawptr, offset: i32, output: *Substring) bool
extern fn ttf_whitespace_visible "TTF_SetTextWrapWhitespaceVisible"(text: rawptr, visible: bool) bool
extern fn ttf_at_point "TTF_GetTextSubStringForPoint"(text: rawptr, x: i32, y: i32, output: *Substring) bool
extern fn ttf_set_font "TTF_SetTextFont"(text: rawptr, font: rawptr) bool
extern fn ttf_add_fallback "TTF_AddFallbackFont"(font: rawptr, fallback: rawptr) bool
extern fn ttf_remove_fallback "TTF_RemoveFallbackFont"(font: rawptr, fallback: rawptr)
