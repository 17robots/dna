// A small Dyn program to edit in the migrated DNA preview.
// Change the vector, save, then run this directory with the local SDK.
use "std/io"
use "std/math"
use "std/mem"
use "std/strings"

fn main() {
  arena := mem.arena_create(0)
  defer mem.arena_release(arena)

  direction := math.Vec2{x: 3.0, y: 4.0}
  length := math.vec2_length(direction)
  unit := math.vec2_normalize(direction)

  // Variable-size output belongs to this arena.
  message := strings.format(arena, "length={}, unit=({}, {})", length, unit.x, unit.y)
  result := io.println(io.stdout(), "{}", message)
  if result.status == io.Status.Error {
    // OS failures are explicit; native error zero is still a failure.
    #panic("could not write the result")
  }
}
