struct SpanText {
  text: rawptr,
  revision: u64,
  identity: u64,
  start: usize,
  end: usize,
  viewport_start: usize,
  viewport_end: usize,
  geometry_ready: bool,
  text_ready: bool,
  first: ttf.Substring,
  last: ttf.Substring,
  origin: ttf.Substring,
}
struct DisplayCounts {
  ready: bool,
  revision: u64,
  identity: u64,
  position: usize,
  column: usize,
  low: usize,
  high: usize,
  selected: usize,
}
struct PaneText {
  counts: DisplayCounts,
  caret: rawptr,
  caret_document: *const buffer.Document,
  spans: [128]SpanText,
  layout: LineLayout,
  text: rawptr,
  document: *buffer.Document,
  caret_revision: u64,
  revision: u64,
  identity: u64,
  caret_start: usize,
  caret_end: usize,
  start: usize,
  end: usize,
}
struct Typography {
  ui_cache: *UiTextCache,
  observer: *App,
  ui_born: u64,
  ui_owner: mem.Arena,
  ui_hits, ui_updates, ui_creations: u64,
  pane_text: [15]PaneText,
  // The focused pane's line layout while it draws.
  layout: *LineLayout,
  caret_document: *const buffer.Document,
  points: f32,
  scale: f32,
  cell: f32,
  line: f32,
  line_height: f32 = 1.25,
  rendered_document: *buffer.Document,
  primary_caret: rawptr,
  engine: rawptr,
  primary_document: rawptr,
  syntax_text: rawptr,
  original_font: rawptr,
  fallback_font: rawptr,
  configured_font: rawptr,
  preview_text: rawptr,
  explorer_preview: rawptr,
  explorer_preview_hash: u64,
  picker_spans, explorer_spans, hover_spans: PreviewSpans,
  caret_text: rawptr,
  font: rawptr,
  document: rawptr,
  palette: rawptr,
  chrome: rawptr,
  directory_text: rawptr,
  directory_layout: LineLayout,
  palette_bytes: [16384]u8,
  caret_start: usize,
  caret_end: usize,
  document_start: usize,
  document_end: usize,
  directory_start: usize,
  directory_end: usize,
  current_pane: usize,
  palette_length: usize,
  document_updates: u64,
  caret_revision: u64,
  rendered_revision: u64,
  rendered_view_revision: u64,
  directory_revision: u64,
  palette_updates: u64,
  palette_wrap: i32 = -1,
}

fn resize_font(typography: *Typography) {
  ui_cache_clear(typography)
  // Terminal cells are fixed: an 8-wide, 16-tall unit per cell, and a font
  // size whose cursor height (size + 5) fills exactly one cell.
  if sdl.tui_active() {
    typography.points = 11.0
    typography.scale = 1.0
    typography.line_height = 1.0
  }
  for pane_index in 0..15 {
    for span_index in 0..128 {
      span := &typography.pane_text[pane_index].spans[span_index]
      span.geometry_ready = false
      span.text_ready = false
    }
  }

  if !ttf.font_size(typography.font, typography.points * typography.scale) {
    #panic("font resize failed")
  }
  if typography.fallback_font != nil {
    _ = ttf.font_size(typography.fallback_font, typography.points * typography.scale)
  }

  typography.line = #cast(f32) (#cast(i32) (typography.points * typography.scale * typography.line_height))
  if sdl.tui_active() {
    typography.line = sdl.CellHeight
  }
  ttf.line_skip(typography.font, #cast(i32) typography.line)
  glyph: [2]u8 = [77, 0]
  width: i32 = 0
  height: i32 = 0

  if !ttf.measure(typography.font, &glyph[0], 1, &width, &height) {
    #panic("font measure failed")
  }

  typography.cell = #cast(f32) width
}
