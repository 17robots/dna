#target(kernel: linux)
pub fn dna_language_resolve_directory(path: *const u8, output: *u8, capacity: usize) isize {
  if path == nil || output == nil || capacity == 0 {
    return -22
  }
  resolved: [4096]u8 = []
  if syntax_realpath(path, &resolved[0]) == nil {
    output.* = 0
    return -2
  }
  if install_resolve_direct(&resolved[0], output, capacity) == 0 {
    return -28
  }
  return #cast(isize, string_length(output))
}
