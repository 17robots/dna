fn copy_text(destination: []u8, source: str) usize {
  if source.len >= destination.len { return 0 }
  if source.len > 0 {
    buffer.copy(destination, source)
  }
  destination[source.len] = 0
  return source.len
}
fn add_text(destination: []u8, used: *usize, source: str) {
  if used.* + source.len >= destination.len { return }
  if source.len > 0 {
    buffer.copy(destination[used.*..], source)
    used.* += source.len
  }
  destination[used.*] = 0
}
fn lower(byte: u8) u8 {
  if byte >= 65 && byte <= 90 { return byte + 32 }
  return byte
}
fn contains(text: str, query: str) bool {
  if query.len == 0 { return true }
  if query.len > text.len { return false }

  first := lower(query[0])
  limit := text.len - query.len + 1
  for at in 0..limit {
    if lower(text[at]) != first { continue }
    index: usize = 1
    for index < query.len && lower(text[at + index]) == lower(query[index]) {
      index += 1
    }
    if index == query.len { return true }
  }
  return false
}
// True when every space-separated word of query starts a word of text,
// ignoring case: "sw th" and "theme" match "Switch theme", "wrtie" and
// "keys" match nothing. The palette runs only such rows on Enter, so a typo
// never runs an unrelated command picked by subsequence ranking.
fn word_prefix_match(text: str, query: str) bool {
  start: usize = 0
  matched := false
  for start < query.len {
    for start < query.len && query[start] == ' ' {
      start += 1
    }
    end := start
    for end < query.len && query[end] != ' ' {
      end += 1
    }
    if end > start {
      if !word_starts_with(text, query[start..end]) { return false }
      matched = true
    }
    start = end
  }
  return matched
}
fn word_starts_with(text: str, word: str) bool {
  for at in 0..text.len {
    if at > 0 {
      before := text[at - 1]
      if !(before == ' ' || before == '-' || before == '_' || before == '/' || before == ':' || before == '(' || before == '.') {
        continue
      }
    }
    if at + word.len > text.len { return false }
    index: usize = 0
    for index < word.len && lower(text[at + index]) == lower(word[index]) {
      index += 1
    }
    if index == word.len { return true }
  }
  return false
}
// Case-insensitive subsequence score shared by the command palette and
// completion. Word starts, runs and early matches rank higher; -1 = no match.
fn fuzzy_score(text: str, query: str) i32 {
  if query.len == 0 { return 0 }
  score: i32 = 0
  wanted: usize = 0
  at: usize = 0
  run: bool = false
  first: usize = text.len
  for at < text.len && wanted < query.len {
    byte := text[at]
    if lower(byte) == lower(query[wanted]) {
      if first == text.len {
        first = at
      }
      score += 4
      if at == 0 {
        score += 24
      } else {
        before := text[at - 1]
        separator := before == ' ' || before == '-' || before == '_' || before == '/' || before == '.' || before == ':' || before == '(' || before == '<'
        camel := byte >= 'A' && byte <= 'Z' && before >= 'a' && before <= 'z'
        if separator || camel {
          score += 12
        }
      }
      if run {
        score += 8
      }
      if byte == query[wanted] {
        score += 1
      }
      run = true
      wanted += 1
    } else {
      run = false
    }
    at += 1
  }
  if wanted < query.len { return -1 }
  penalty := first
  if penalty > 16 {
    penalty = 16
  }
  extra := text.len - query.len
  if extra > 32 {
    extra = 32
  }
  score -= #cast(i32, penalty)
  score -= #cast(i32, extra) / 4
  if score < 1 {
    score = 1
  }
  return score
}
