colors: u32 = 0
struct PaintedText { text: *const u8 }
extern fn highlight_color "TTF_GetTextColor"(text: rawptr, r: *u8, g: *u8, b: *u8, a: *u8) bool
extern fn highlight_equal "strcmp"(a: *const u8, b: *const u8) i32
fn matches(text: *const u8, expected: []const u8) bool {
  return highlight_equal(text, &expected[0]) == 0
}
pub fn TTF_DrawRendererText(text: rawptr, x: f32, y: f32) bool {
  r: u8 = 0
  g: u8 = 0
  b: u8 = 0
  a: u8 = 0
  bytes := (#cast(*PaintedText) text).text
  if bytes != nil && highlight_color(text, &r, &g, &b, &a) {
    if matches(bytes, "fn\0") && r == 174 && g == 156 && b == 190 {
      colors |= 1
    }
    if matches(bytes, "\x22hello\x22\0") && r == 165 && g == 183 && b == 152 {
      colors |= 2
    }
    if matches(bytes, "\x2f\x2f comment\0") && r == 132 && g == 140 && b == 132 {
      colors |= 4
    }
  }
  next := #cast(*fn(rawptr, f32, f32) bool) probe_next("TTF_DrawRendererText\0")
  return next(text, x, y)
}
pub fn SDL_RenderPresent(renderer: rawptr) bool {
  next := #cast(*fn(rawptr) bool) probe_next("SDL_RenderPresent\0")
  result := next(renderer)
  if colors == 7 {
    probe_log("PASS Tree-sitter keyword/string/comment painting\n")
    probe_exit(0)
  }
  return result
}
