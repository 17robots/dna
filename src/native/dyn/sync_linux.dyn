#target(kernel: linux)
#link("pthread")

extern fn sync_thread_create "pthread_create"(thread: *usize, attributes: rawptr, entry: fn(rawptr) rawptr, state: rawptr) i32
extern fn sync_thread_join "pthread_join"(thread: usize, result: rawptr) i32
extern fn sync_thread_self "pthread_self"() usize
fn sync_thread_is_self(handle: usize) bool {
  return handle == sync_thread_self()
}
