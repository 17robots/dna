#link("SDL3")
// SDL3 ABI declarations, checked against SDL3 headers. No C runtime shim.
pub struct Event { words: [16]u64 }
pub struct KeyEvent { kind: u32, reserved: u32, timestamp: u64, window: u32, device: u32, scancode: u32, key: u32, modifiers: u16, raw: u16, down: bool, repeated: bool }
pub struct TextEvent { kind: u32, reserved: u32, timestamp: u64, window: u32, text: *const u8 }
pub struct Rect { x: f32, y: f32, width: f32, height: f32 }
pub extern fn init "SDL_Init"(flags: u32) bool
pub extern fn quit "SDL_Quit"()
pub extern fn create_window "SDL_CreateWindow"(title: *const u8, width: i32, height: i32, flags: u64) rawptr
pub extern fn destroy_window "SDL_DestroyWindow"(window: rawptr)
pub extern fn create_renderer "SDL_CreateRenderer"(window: rawptr, name: *const u8) rawptr
pub extern fn destroy_renderer "SDL_DestroyRenderer"(renderer: rawptr)
pub extern fn color "SDL_SetRenderDrawColor"(renderer: rawptr, r: u8, g: u8, b: u8, a: u8) bool
pub extern fn clear "SDL_RenderClear"(renderer: rawptr) bool
pub extern fn present "SDL_RenderPresent"(renderer: rawptr) bool
pub extern fn scale "SDL_SetRenderScale"(renderer: rawptr, x: f32, y: f32) bool
pub extern fn fill "SDL_RenderFillRect"(renderer: rawptr, rectangle: *const Rect) bool
pub extern fn size "SDL_GetRenderOutputSize"(renderer: rawptr, width: *i32, height: *i32) bool
pub extern fn wait "SDL_WaitEvent"(event: *Event) bool
pub extern fn start_text "SDL_StartTextInput"(window: rawptr) bool
pub extern fn stop_text "SDL_StopTextInput"(window: rawptr) bool
pub extern fn push "SDL_PushEvent"(event: *Event) bool
pub extern fn display_scale "SDL_GetWindowDisplayScale"(window: rawptr) f32
pub extern fn wait_timeout "SDL_WaitEventTimeout"(event: *Event, milliseconds: i32) bool
pub extern fn title "SDL_SetWindowTitle"(window: rawptr, title: *const u8) bool
pub extern fn clipboard_set "SDL_SetClipboardText"(text: *const u8) bool
pub extern fn clipboard_get "SDL_GetClipboardText"() *const u8
pub extern fn free "SDL_free"(pointer: rawptr)
pub struct PixelRect { x: i32, y: i32, width: i32, height: i32 }
pub extern fn clip "SDL_SetRenderClipRect"(renderer: rawptr, rectangle: *const PixelRect) bool
