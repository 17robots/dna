use "../../src/layout" layout
fn main() {
  good := layout.parse("# popup\npopup_width = 0.8\npopup_height=0.6\nfont_size=22\n")
  if !good.ok || good.width != 0.8 || good.height != 0.6 || good.font_size != 22.0 { #panic("valid layout") }
  if layout.parse("popup_width=0.1").ok || layout.parse("font_size=100").ok || layout.parse("unknown=1").ok || layout.parse("font_size=20\nfont_size=21").ok || layout.parse("font_size=NaN").ok { #panic("invalid layout accepted") }
}
