use "../../src/servers" servers
use "std/bytes" byte_ops
fn main() {
  if !byte_ops.equal(servers.default_server(0).language, "rust") {
    #panic("catalog order")
  }
  for index in 0..servers.DefaultServers {
    entry := servers.default_server(index)
    if #len(entry.language) == 0 || #len(entry.command) == 0 {
      #panic("catalog entry")
    }
  }
  if #len(servers.default_server(servers.DefaultServers).language) != 0 {
    #panic("catalog bound")
  }
  if !servers.on_path("sh") || servers.on_path("") || servers.on_path("dna-no-such-language-server --stdio") {
    #panic("PATH discovery")
  }
}
