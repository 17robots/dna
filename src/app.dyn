// Root editor state; subsystem records own their related storage and bookkeeping.
use "std/mem"
struct App {
  render_trace: RenderTrace,
  // Reasons for the next frame (frames.dyn).
  render_pending: u32,
  operations: OperationState,
  running: bool = true,
  scratch: *mem.Arena,
  documents: Documents,
  view: Views,
  workspace: Workspace,
  config: settings.Settings,
  configuration: ConfigurationState,
  fonts: FontState,
  lsp: LspState,
  disk: DiskState,
  syntax_state: SyntaxState,
  recovery: RecoveryState,
  formatting: Formatting,
  language_manager: LanguageManager,
  composition: Composition,
  explorer: Explorer,
  tree: TreeState,
  file_ops: FileOps,
  macro_state: MacroState,
  register_state: RegisterState,
  plugin_state: PluginState,
  project_find: ProjectSearchState,
  replacement: ProjectReplaceState,
  picker_state: PickerState,
  previews: PreviewSyntaxState,
  ui: UiState,
  vim: VimState,
  project_config: ProjectConfig,
  command_menu: CommandMenuState,
  completion: CompletionState,
  terminal_state: TerminalUiState,
  pointer: PointerState,
  search_state: SearchState,
  match_state: MatchState,
  search_history: SearchHistory,
  prompt_state: PromptState,
  directory_state: DirectoryState,
  input_state: InputState,
  jumps: JumpList,
  resource_state: ResourceState,
  theme_state: ThemeState,
  title_state: WindowTitleState,
}

fn app_init(app: *App, scratch: *mem.Arena) {
  app.scratch = scratch
  app.running = true
  app.view.popup_width = 0.64
  app.view.popup_height = 0.56
  app.view.line_numbers = true
  app.view.relative_numbers = true
  app.view.status_line = true
  app.view.highlight_line = true
}
