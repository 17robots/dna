struct Composition { bytes: [4096]u8, length: usize, start, selected: i32 }

fn composition_update(app: *App, event: *const sdl.EditingEvent) {
  app.composition.length = 0
  if !wants_text_input(app) || event.text == nil {
    return
  }
  length := c.string_length(event.text, 4096)
  if length == 4096 || !buffer.valid(event.text[..length]) {
    return
  }
  app.composition.length = copy_text(app.composition.bytes[..], event.text[..length])
  app.composition.start = event.start
  app.composition.selected = event.length
}
fn composition_draw(renderer: rawptr, window: rawptr, app: *App, typography: *Typography, width: i32, height: i32) {
  if !wants_text_input(app) {
    app.composition.length = 0
    return
  }
  x := app.config.document_padding * typography.scale
  y := #cast(f32) height - typography.line * 3.0
  if app.prompt_state.panel == Panel.None && app.documents.slots[app.documents.active].terminal.handle == nil {
    pane := &app.view.panes[app.view.focused]
    x = #cast(f32) pane.rect.x + app.view.animation.file.cursor_x.value
    y = #cast(f32) pane.rect.y + app.view.animation.file.cursor_y.value
  }
  if x < 0.0 {
    x = 0.0
  }
  if y < 0.0 {
    y = 0.0
  }
  if x > #cast(f32) width - typography.cell {
    x = #cast(f32) width - typography.cell
  }
  if y > #cast(f32) height - typography.line {
    y = #cast(f32) height - typography.line
  }
  logical_width: i32 = 0
  logical_height: i32 = 0
  if sdl.window_size(window, &logical_width, &logical_height) && width > 0 && height > 0 {
    sx := #cast(f32) logical_width / #cast(f32) width
    sy := #cast(f32) logical_height / #cast(f32) height
    area := sdl.PixelRect{x: #cast(i32) (x * sx), y: #cast(i32) (y * sy), width: #cast(i32) (typography.cell * sx), height: #cast(i32) (typography.line * sy)}
    _ = sdl.text_area(window, &area, 0)
  }
  composition := &app.composition
  if composition.length == 0 {
    return
  }
  if !ttf.set(typography.chrome, &composition.bytes[0], composition.length) {
    return
  }
  text_width: i32 = 0
  text_height: i32 = 0
  if !ttf.size(typography.chrome, &text_width, &text_height) {
    return
  }
  box := sdl.Rect{x: x, y: y, width: #cast(f32) text_width + typography.cell, height: typography.line}
  ui_box(renderer, box, typography.scale)
  if !tint(typography.chrome, theme().text) || !ttf.draw(typography.chrome, x, y) {
    return
  }
  underline := sdl.Rect{x: x, y: y + typography.line - typography.scale * 2.0, width: #cast(f32) text_width, height: typography.scale}
  _ = paint(renderer, theme().text)
  _ = sdl.fill(renderer, &underline)
}
