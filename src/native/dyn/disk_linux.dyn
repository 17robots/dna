#target(kernel: linux)
extern fn disk_inotify "inotify_init1"(flags: i32) i32
extern fn disk_add "inotify_add_watch"(fd: i32, path: *const u8, mask: u32) i32
extern fn disk_remove "inotify_rm_watch"(fd: i32, wd: i32) i32
fn disk_changes_close(fd:i32) {
  _=rec_close(fd)
}

fn disk_target_watch(queue:i32, path:*const u8, parent:i32) bool {
  _=queue
  _=path
  _=parent
  return true
}

fn disk_targets_begin(queue:i32) {
  _=queue
}
fn disk_targets_end(queue:i32) {
  _=queue
}
