use "std/mem"
use "../buffer"

// One key of a binding. A printable character without Ctrl or Alt matches
// the typed character (so "$" and "A" work on any layout); other keys match
// the keycode and modifiers.
pub struct Stroke { key: u32, modifiers: u16, character: u32 }
pub const BindingSteps: usize = 4
pub const BindingLimit: usize = 128
// Scopes: 1 normal, 2 Space menu, 6 insert, 7 select/visual.
// The mode a [keys.MODE] table binds in.
pub enum KeysMode { None, Normal, Space, Insert, Select }
// The keymap a binding is for: [keys.MODE] applies to both, [keys.vim.MODE]
// and [keys.helix.MODE] to one.
pub enum BindingKeymap { Any, Helix, Vim }
// [modules] choices.
pub enum Frontend { Auto, Gui, Tui }
pub enum ExplorerStyle { Buffer, Tree }
pub enum PickerStyle { Full, Compact, Dropdown }
// Closing the last buffer: auto quits in the terminal and keeps the window.
pub enum CloseLastBuffer { Auto, Quit, Keep }
// keymap: 0 both, 1 helix only, 2 vim only.
pub struct Binding { key: u32, modifiers: u16, scope: KeysMode, keymap: BindingKeymap, from_project: bool, command: str, steps: [4]Stroke, count: usize }
// Where a surface shows: float at one of nine anchors, docked to a side
// (taking space from the editor panes), or next to the cursor. Sizes at or
// below 1 are fractions of the window; above 1, logical pixels.
pub enum PlaceMode { Default, Float, Dock, Cursor }
pub const PlaceSurfaces: usize = 8
pub enum PlaceSide { Left, Right, Top, Bottom }
pub struct Placement { mode: PlaceMode, anchor: u8, side: PlaceSide, width, height, size, margin: f32 }
pub fn place_surface(name: str) usize {
  names: [8]str = ["palette", "picker", "menu", "dialog", "explorer", "terminal", "completion", "hover"]
  for index in 0..8 {
    if buffer.equal(names[index], name) { return index }
  }
  return 8
}
// Anchors: 0 top-left, 1 top, 2 top-right, 3 left, 4 center, 5 right,
// 6 bottom-left, 7 bottom, 8 bottom-right. Sides: 0 left, 1 right, 2 top, 3 bottom.
pub fn place_anchor(name: str) u8 {
  names: [9]str = ["top-left", "top", "top-right", "left", "center", "right", "bottom-left", "bottom", "bottom-right"]
  for index in 0..9 {
    if buffer.equal(names[index], name) { return #cast(u8, index) }
  }
  return 255
}
// The side NAME names, written to side; false for any other name.
pub fn place_side(name: str, side: *PlaceSide) bool {
  case name {
    "left" => { side.* = .Left }
    "right" => { side.* = .Right }
    "top" => { side.* = .Top }
    "bottom" => { side.* = .Bottom }
    _ => { return false }
  }
  return true
}
pub fn place_side_name(side: PlaceSide) str {
  case side {
    .Left => { return "left" }
    .Right => { return "right" }
    .Top => { return "top" }
    .Bottom => { return "bottom" }
  }
}
// A left or right dock spans the window's height.
pub fn place_horizontal(side: PlaceSide) bool {
  return side == .Left || side == .Right
}
fn place_apply(place: *Placement, key: str, value: str) bool {
  if buffer.equal(key, "mode") || buffer.equal(key, "anchor") || buffer.equal(key, "side") {
    if value.len < 3 || value[0] != 34 || value[value.len - 1] != 34 { return false }
    text := value[1..value.len - 1]
    if buffer.equal(key, "mode") {
      case text {
        "float" => {
          place.mode = .Float
        }
        "dock" => {
          place.mode = .Dock
        }
        "cursor" => {
          place.mode = .Cursor
        }
        "default" => {
          // The surface's usual place; later keys in the section still apply.
          place.* = Placement{}
        }
        _ => {
          return false
        }
      }
      return true
    }
    if buffer.equal(key, "side") {
      if !place_side(text, &place.side) { return false }
      if place.mode == .Default {
        place.mode = .Dock
      }
      return true
    }
    choice := place_anchor(text)
    if choice == 255 { return false }
    place.anchor = choice
    if place.mode == .Default {
      place.mode = .Float
    }
    return true
  }
  amount := number(value)
  if amount < 0.0 || amount > 4000.0 { return false }
  case key {
    "width" => {
      place.width = amount
    }
    "height" => {
      place.height = amount
    }
    "size" => {
      place.size = amount
    }
    "margin" => {
      place.margin = amount
    }
    _ => {
      return false
    }
  }
  return true
}
pub struct Settings {
  languages: [16]Language,
  places: [8]Placement,
  bindings: [128]Binding,
  completion_delay_ms: f32,
  document_padding: f32,
  scroll_margin: f32,
  horizontal_scroll_margin: f32,
  cursor_animation_ms: f32,
  scroll_animation_ms: f32,
  popup_animation_ms: f32,
  cursor_thickness: f32,
  cursor_trail_size: f32,
  split_ratio: f32,
  popup_width: f32,
  popup_height: f32,
  popup_padding: f32,
  recovery_interval_ms: f32,
  lsp_timeout_ms: f32,
  lsp_change_delay_ms: f32,
  plugin_timeout_ms: f32,
  frame_interval_ms: f32,
  font_size: f32,
  line_height: f32,
  font_family, font, shell, build_command, test_command, run_command, fallback, theme_path: str,
  terminal_modifiers: u16,
  terminal_escape: u32,
  // Bit N: a configuration layer set options table entry N.
  explicit: u64,
  error_line, language_count, font_length, binding_count, shell_length: usize,
  indent_width: usize,
  light_theme, ok, reduced_motion: bool,
  automatic_completion: bool,
  vim_keys: bool,
  // [modules] slots.
  frontend: Frontend,
  explorer_style: ExplorerStyle,
  picker_style: PickerStyle,
  close_last_buffer: CloseLastBuffer,
  reload_config: bool,
  line_numbers: bool,
  relative_numbers: bool,
  status_line: bool,
  highlight_line: bool,
  trim_trailing_whitespace: bool,
  smooth_cursor: bool,
  equalize_splits: bool,
  default_servers: bool,
  smooth_scroll: bool,
  popup_transitions: bool,
  mouse_enabled: bool,
  picker_preview: bool,
  syntax_enabled: bool,
  recovery_enabled: bool,
  reload_clean_buffers: bool,
  explorer_icons: bool,
  explorer_columns: bool,
  explorer_preview: bool,
  explorer_close_on_open: bool,
  insert_tabs: bool,
  final_newline: bool,
}

pub fn defaults(result: *Settings) {
  mem.clear(result)
  for index in 0..OptionCount {
    if options[index].default_value.len > 0 {
      _ = apply(result, index, options[index].default_value)
    }
  }
}
pub fn trim(text: str) str {
  first: usize = 0
  last := text.len
  for first < last && (text[first] == 32 || text[first] == 9 || text[first] == 13) {
    first += 1
  }
  for last > first && (text[last - 1] == 32 || text[last - 1] == 9 || text[last - 1] == 13) {
    last -= 1
  }
  return text[first..last]
}
pub fn number(text: str) f32 {
  value: f32 = 0.0
  divisor: f32 = 1.0
  decimal: bool = false
  digits: usize = 0
  if text.len > 8 { return -1.0 }
  for byte in text {
    if byte == 46 && !decimal {
      decimal = true
      continue
    }
    if byte < 48 || byte > 57 { return -1.0 }
    digits += 1
    value = value * 10.0 + (byte - 48)
    if decimal {
      divisor *= 10.0
    }
  }
  if digits == 0 { return -1.0 }
  return value / divisor
}
// Layered configuration: the global file, then a project dna.toml over it.
// A project layer never sets locked or personal keys, and sets keys that run
// programs or load files only once trusted; each skip is recorded.
pub enum SkipReason { None, Locked, Personal, Untrusted }
pub struct Layer {
  project: bool,
  trusted: bool,
  // :set for this session: applies over the files like a project layer, but
  // may set personal keys. Locks still hold.
  session: bool,
  locks: [32]str,
  lock_count: usize,
  applied: [64]str,
  applied_count: usize,
  skipped: [32]str,
  skip_reasons: [32]SkipReason,
  skipped_count: usize,
}
pub fn parse(source: str, result: *Settings) bool {
  layer := Layer{}
  return parse_layer(source, result, &layer)
}
pub fn lock_matches(lock: str, section: str, key: str, canonical: str) bool {
  if buffer.equal(lock, canonical) || buffer.equal(lock, key) && section.len == 0 { return true }
  if section.len == 0 { return false }
  // A section name locks everything in it; section.key locks one entry.
  if buffer.equal(lock, section) || (section.len > 5 && buffer.equal(section[..5], "keys.") && buffer.equal(lock, "keys")) || (section.len > 10 && buffer.equal(section[..10], "languages.") && buffer.equal(lock, "languages")) || (section.len > 6 && buffer.equal(section[..6], "place.") && buffer.equal(lock, "place")) {
    return true
  }
  return lock.len == section.len + 1 + key.len && buffer.equal(lock[..section.len], section) && lock[section.len] == '.' && buffer.equal(lock[section.len + 1..], key)
}
fn personal_key(canonical: str) bool {
  index := find(canonical)
  return index < OptionCount && options[index].personal
}
// Keys that run programs or make DNA load files from the project.
fn trust_needed(section: str, key: str, canonical: str) bool {
  if section.len > 5 && buffer.equal(section[..5], "keys.") { return true }
  if section.len > 10 && buffer.equal(section[..10], "languages.") {
    return buffer.equal(key, "server") || buffer.equal(key, "formatter") || buffer.equal(key, "auto_start") || buffer.equal(key, "format_on_save")
  }
  index := find(canonical)
  return index < OptionCount && options[index].trusted
}
// Zero when the layer may apply the key, else the reason it is skipped.
fn layer_skip(layer: *Layer, section: str, key: str, canonical: str) SkipReason {
  if !layer.project { return .None }
  reason := SkipReason.None
  for index in 0..layer.lock_count {
    if lock_matches(layer.locks[index], section, key, canonical) {
      reason = .Locked
    }
  }
  if reason == .None && personal_key(canonical) && !layer.session {
    reason = .Personal
  }
  if reason == .None && !layer.trusted && trust_needed(section, key, canonical) {
    reason = .Untrusted
  }
  if reason != .None && layer.skipped_count < 32 {
    layer.skipped[layer.skipped_count] = canonical
    layer.skip_reasons[layer.skipped_count] = reason
    layer.skipped_count += 1
  }
  return reason
}
fn layer_applied(layer: *Layer, canonical: str) {
  if layer.applied_count < 64 {
    layer.applied[layer.applied_count] = canonical
    layer.applied_count += 1
  }
}
// lock = ["keymap", "theme", "languages"]: only in the global file.
fn parse_locks(layer: *Layer, value: str) bool {
  if layer.project || value.len < 2 || value[0] != 91 || value[value.len - 1] != 93 { return false }
  at: usize = 1
  for at < value.len - 1 {
    for at < value.len - 1 && (value[at] == 32 || value[at] == 44) {
      at += 1
    }
    if at == value.len - 1 { break }
    if value[at] != 34 || layer.lock_count == 32 { return false }
    at += 1
    start := at
    for at < value.len && value[at] != 34 {
      byte := value[at]
      if !((byte >= 'a' && byte <= 'z') || (byte >= '0' && byte <= '9') || byte == '_' || byte == '.') {
        return false
      }
      at += 1
    }
    if at == value.len || at == start { return false }
    layer.locks[layer.lock_count] = value[start..at]
    layer.lock_count += 1
    at += 1
  }
  return true
}
// The section parse_layer is reading: plain options, a [keys.MODE] table, a
// [languages.NAME] or [place.SURFACE] section, or a [project."PATH"] section
// (applied separately, through project_sections).
enum Section { Options, Keys, Language, Place, Project }
// Apply one file. The first (global) layer starts from defaults; a project
// layer applies over the result and may repeat keys the global file set.
pub fn parse_layer(source: str, result: *Settings, layer: *Layer) bool {
  if layer.project {
    result.error_line = 0
    for language in 0..result.language_count {
      result.languages[language].seen = 0
    }
  } else {
    defaults(result)
  }
  at: usize = 0
  seen: u64 = 0
  // What kind of section the next key belongs to.
  in_section := Section.Options
  scope := KeysMode.None
  keymap := BindingKeymap.Any
  language_index: usize = 16
  place_index: usize = PlaceSurfaces
  section: str = ""
  for at < source.len {
    result.error_line += 1
    end := at
    for end < source.len && source[end] != 10 {
      end += 1
    }
    line := trim(source[at..end])
    at = end + 1
    if line.len == 0 || line[0] == 35 { continue }
    if line[0] == 91 && line.len > 7 && buffer.equal(line[..6], "[keys.") && line[line.len - 1] == 93 {
      keys_scope := keys_section(line[6..line.len - 1])
      if keys_scope.scope == .None { return false }
      section = line[1..line.len - 1]
      in_section = .Keys
      scope = keys_scope.scope
      keymap = keys_scope.keymap
      continue
    }
    if line[0] == 91 {
      if line.len < 3 || line[line.len - 1] != 93 { return false }
      section = line[1..line.len - 1]
      in_section = .Options
      // [project."PATH"] applies separately, through project_sections.
      if project_section_path(section).valid {
        if layer.project { return false }
        in_section = .Project
        continue
      }
      if section.len > 6 && buffer.equal(section[..6], "place.") {
        place_index = place_surface(section[6..])
        if place_index == PlaceSurfaces { return false }
        in_section = .Place
        continue
      }
      if section.len > 10 && buffer.equal(section[..10], "languages.") {
        language_index = language_section(result, section)
        if language_index == 16 { return false }
        in_section = .Language
        continue
      }
      if !known_section(section) { return false }
      continue
    }
    if in_section == .Project { continue }
    split: usize = 0
    for split < line.len && line[split] != 61 {
      split += 1
    }
    if split == line.len { return false }
    key := trim(line[..split])
    value := trim(line[split + 1..])
    if in_section == .Language {
      if layer_skip(layer, section, key, key) != .None { continue }
      if !language_apply(&result.languages[language_index], key, value) { return false }
      layer_applied(layer, section)
      continue
    }
    if in_section == .Place {
      if layer_skip(layer, section, key, section) != .None { continue }
      if !place_apply(&result.places[place_index], key, value) { return false }
      layer_applied(layer, section)
      continue
    }
    if in_section == .Options && buffer.equal(key, "lock") {
      if !parse_locks(layer, value) { return false }
      continue
    }
    if in_section == .Keys && layer_skip(layer, section, key, section) != .None { continue }
    if in_section == .Keys {
      if key.len < 3 || key[0] != 34 || key[key.len - 1] != 34 || value.len < 3 || value.len > 129 || value[0] != 34 || value[value.len - 1] != 34 || result.binding_count == BindingLimit {
        return false
      }
      binding := parse_sequence(key[1..key.len - 1])
      if binding.count == 0 { return false }
      binding.scope = scope
      binding.keymap = keymap
      binding.command = value[1..value.len - 1]
      if binding.command.len > 5 && buffer.equal(binding.command[..5], "keys:") && !notation_valid(binding.command[5..]) {
        return false
      }
      replaced := false
      for previous in 0..result.binding_count {
        existing := &result.bindings[previous]
        if existing.scope == scope && existing.keymap == keymap && same_sequence(existing, &binding) {
          // A project binding overrides the global one; within a file it is a duplicate.
          if !layer.project || existing.from_project { return false }
          binding.from_project = true
          existing.* = binding
          replaced = true
        }
      }
      if !replaced {
        binding.from_project = layer.project
        result.bindings[result.binding_count] = binding
        result.binding_count += 1
      }
      layer_applied(layer, section)
      continue
    }
    if section.len == 0 {
      top := find(key)
      if top < OptionCount && options[top].only_in_section { return false }
    }
    canonical := section_key(section, key)
    if layer_skip(layer, section, key, canonical) != .None { continue }
    layer_applied(layer, canonical)
    index := find(canonical)
    if index == OptionCount { return false }
    bit := #cast(u64, 1) << index
    if (seen & bit) != 0 || !apply(result, index, value) { return false }
    seen = seen | bit
    result.explicit = result.explicit | seen
  }
  result.ok = true
  result.error_line = 0
  return true
}

pub fn parse_key(text: str) Binding {
  result := Binding{}
  remaining := text
  if remaining.len > 5 && buffer.equal(remaining[..5], "ctrl-") {
    result.modifiers = 192
    remaining = remaining[5..]
  } else if remaining.len > 4 && buffer.equal(remaining[..4], "alt-") {
    result.modifiers = 768
    remaining = remaining[4..]
  } else if remaining.len > 6 && buffer.equal(remaining[..6], "shift-") {
    result.modifiers = 3
    remaining = remaining[6..]
  }
  if remaining.len == 1 {
    result.key = remaining[0]
  } else if buffer.equal(remaining, "backslash") {
    result.key = 92
  } else if buffer.equal(remaining, "space") {
    result.key = 32
  } else if remaining.len >= 2 && remaining[0] == 102 {
    n := number(remaining[1..])
    if n >= 1.0 && n <= 12.0 && #cast(f32, (#cast(u32, n))) == n {
      result.key = 1073741881 + #cast(u32, n)
    }
  }
  return result
}

pub struct KeysScope { scope: KeysMode, keymap: BindingKeymap }
// [keys.MODE] or [keys.KEYMAP.MODE]: MODE is normal, insert, select (or
// visual) or space; KEYMAP is vim or helix.
pub fn keys_section(name: str) KeysScope {
  result := KeysScope{}
  mode := name
  if name.len > 4 && buffer.equal(name[..4], "vim.") {
    result.keymap = .Vim
    mode = name[4..]
  } else if name.len > 6 && buffer.equal(name[..6], "helix.") {
    result.keymap = .Helix
    mode = name[6..]
  }
  case mode {
    "normal" => {
      result.scope = .Normal
    }
    "space" => {
      result.scope = .Space
    }
    "insert" => {
      result.scope = .Insert
    }
    "select", "visual" => {
      result.scope = .Select
    }
    _ => {}
  }
  return result
}
fn same_sequence(left: *const Binding, right: *const Binding) bool {
  if left.count != right.count { return false }
  for index in 0..left.count {
    a := left.steps[index]
    b := right.steps[index]
    if a.key != b.key || a.modifiers != b.modifiers || a.character != b.character { return false }
  }
  return true
}
// "g x", "space f f", "ctrl-w v": up to four keys separated by spaces.
pub fn parse_sequence(text: str) Binding {
  result := Binding{}
  at: usize = 0
  for at < text.len {
    if text[at] == ' ' {
      at += 1
      continue
    }
    end := at
    for end < text.len && text[end] != ' ' {
      end += 1
    }
    if result.count == BindingSteps {
      result.count = 0
      return result
    }
    stroke := parse_stroke(text[at..end])
    if stroke.key == 0 && stroke.character == 0 {
      result.count = 0
      return result
    }
    result.steps[result.count] = stroke
    result.count += 1
    at = end
  }
  if result.count > 0 {
    result.key = result.steps[0].key
    result.modifiers = result.steps[0].modifiers
  }
  return result
}
fn lower_ascii(text: str, out: []u8) str {
  if text.len > out.len { return text }
  for byte, index in text {
    if byte >= 'A' && byte <= 'Z' {
      byte += 32
    }
    out[index] = byte
  }
  return out[..text.len]
}
// A named key's keycode, or 0.
pub fn key_named(name: str) u32 {
  storage: [16]u8
  lowered := lower_ascii(name, storage[..])
  case lowered {
    "space" => { return 32 }
    "backslash" => { return 92 }
    "esc", "escape" => { return 27 }
    "enter", "ret", "return", "cr" => {
      return 13
    }
    "tab" => { return 9 }
    "backspace", "bs" => { return 8 }
    "del", "delete" => { return 127 }
    "minus" => { return '-' }
    "lt", "less" => { return '<' }
    "insert", "ins" => { return 1073741897 }
    "home" => { return 1073741898 }
    "pageup" => { return 1073741899 }
    "end" => { return 1073741901 }
    "pagedown" => { return 1073741902 }
    "right" => { return 1073741903 }
    "left" => { return 1073741904 }
    "down" => { return 1073741905 }
    "up" => { return 1073741906 }
    _ => {}
  }
  if lowered.len >= 2 && lowered[0] == 'f' {
    n := number(lowered[1..])
    if n >= 1.0 && n <= 12.0 && #cast(f32, (#cast(u32, n))) == n {
      return 1073741881 + #cast(u32, n)
    }
  }
  return 0
}
// One key: optional ctrl-/alt-/shift- (or C-/A-/M-/S-) prefixes, then a
// character or a key name.
pub fn parse_stroke(text: str) Stroke {
  result := Stroke{}
  remaining := text
  for remaining.len > 2 {
    if remaining.len > 5 && buffer.equal(remaining[..5], "ctrl-") {
      result.modifiers |= 192
      remaining = remaining[5..]
    } else if remaining.len > 4 && buffer.equal(remaining[..4], "alt-") {
      result.modifiers |= 768
      remaining = remaining[4..]
    } else if remaining.len > 6 && buffer.equal(remaining[..6], "shift-") {
      result.modifiers |= 3
      remaining = remaining[6..]
    } else if remaining[1] == '-' && (remaining[0] == 'C' || remaining[0] == 'c') {
      result.modifiers |= 192
      remaining = remaining[2..]
    } else if remaining[1] == '-' && (remaining[0] == 'A' || remaining[0] == 'a' || remaining[0] == 'M' || remaining[0] == 'm') {
      result.modifiers |= 768
      remaining = remaining[2..]
    } else if remaining[1] == '-' && (remaining[0] == 'S' || remaining[0] == 's') {
      result.modifiers |= 3
      remaining = remaining[2..]
    } else {
      break
    }
  }
  if remaining.len == 0 { return result }
  named := key_named(remaining)
  if named != 0 {
    if named > 32 && named < 127 && named != 92 && (result.modifiers & 960) == 0 {
      // minus, lt: characters.
      result.character = named
      return result
    }
    result.key = named
    return result
  }
  size := utf8_size(remaining[0])
  if size != remaining.len { return result }
  character := utf8_value(remaining)
  if character < 33 || character == 127 { return result }
  if (result.modifiers & 960) == 0 {
    // shift-a is A; a plain character matches whatever produced it.
    if (result.modifiers & 3) != 0 && character >= 'a' && character <= 'z' {
      character -= 32
    }
    result.modifiers = 0
    result.character = character
    return result
  }
  if character >= 'A' && character <= 'Z' {
    character += 32
    result.modifiers |= 3
  }
  result.key = character
  return result
}
fn utf8_size(byte: u8) usize {
  if byte < 128 { return 1 }
  if byte >= 240 { return 4 }
  if byte >= 224 { return 3 }
  if byte >= 192 { return 2 }
  return 0
}
pub fn utf8_value(bytes: str) u32 {
  size := bytes.len
  if size == 1 { return bytes[0] }
  value: u32 = 0
  if size == 2 {
    value = bytes[0] & 31
  } else if size == 3 {
    value = bytes[0] & 15
  } else {
    value = bytes[0] & 7
  }
  for index in 1..size {
    value = (value << 6) | (bytes[index] & 63)
  }
  return value
}
// Vim key notation for "keys:" values: characters type themselves, <Name>
// is a key (<Esc>, <CR>, <C-w>, <lt> for a literal <). Returns the key at
// at, advancing past it; a zero stroke ends the text or marks an error.
pub fn notation_next(text: str, at: *usize) Stroke {
  result := Stroke{}
  if at.* >= text.len { return result }
  if text[at.*] == '<' {
    end := at.* + 1
    for end < text.len && text[end] != '>' {
      end += 1
    }
    if end < text.len && end > at.* + 1 {
      stroke := parse_stroke(text[at.* + 1..end])
      if stroke.key != 0 || stroke.character != 0 {
        at.* = end + 1
        return stroke
      }
    }
    // A lone < types itself.
  }
  size := utf8_size(text[at.*])
  if size == 0 || at.* + size > text.len {
    at.* = text.len + 1
    return result
  }
  result.character = utf8_value(text[at.*..at.* + size])
  if result.character == 32 {
    result.key = 32
  }
  at.* += size
  return result
}
fn notation_valid(text: str) bool {
  at: usize = 0
  count: usize = 0
  for at < text.len {
    stroke := notation_next(text, &at)
    if stroke.key == 0 && stroke.character == 0 { return false }
    count += 1
  }
  return count > 0
}
pub fn key_display(key: u32) str {
  names: str = "esc enter tab backspace delete insert home pageup end pagedown right left down up"
  codes: [14]u32 = [27, 13, 9, 8, 127, 1073741897, 1073741898, 1073741899, 1073741901, 1073741902, 1073741903, 1073741904, 1073741905, 1073741906]
  at: usize = 0
  for index in 0..14 {
    end := at
    for end < names.len && names[end] != ' ' {
      end += 1
    }
    if codes[index] == key { return names[at..end] }
    at = end + 1
  }
  return ""
}
