use "std/sync"

fault_target: sync.AtomicU32 = sync.AtomicU32{}
fault_calls: sync.AtomicU32 = sync.AtomicU32{}
fault_seen: sync.AtomicU32 = sync.AtomicU32{}

pub fn dna_test_syntax_arm(nth: u32) {
  sync.store_u32(&fault_calls, 0)
  sync.store_u32(&fault_seen, 0)
  sync.store_u32(&fault_target, nth)
}
pub fn dna_test_syntax_failed() u32 {
  return sync.load_u32(&fault_seen)
}
pub fn dna_memory_realloc(pointer: rawptr, size: usize, category: u32) rawptr {
  if category == 0 && sync.load_u32(&fault_target) != 0 {
    call := sync.fetch_add_u32(&fault_calls, 1) + 1
    if call == sync.load_u32(&fault_target) {
      sync.store_u32(&fault_target, 0)
      sync.store_u32(&fault_seen, 1)
      return nil
    }
  }
  next := #cast(*fn(rawptr, usize, u32) rawptr) probe_next("dna_memory_realloc\0")
  return next(pointer, size, category)
}
