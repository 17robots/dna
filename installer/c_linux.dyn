#target(kernel: linux)
#link("c")

extern fn system "system"(command: *const u8) i32
extern fn temporary "mkdtemp"(path: *u8) *u8
fn installer_absolute(path: []const u8) bool {
  return #len(path) > 0 && path[0] == 47
}
fn installer_package_path(path: []const u8, storage: []u8) []const u8 {
  if #len(path) >= #len(storage) {
    return storage[..0]
  }
  _ = mem.move(storage, path)
  storage[#len(path)] = 0
  return storage[..#len(path)]
}
fn installer_executable(path: []const u8) bool {
  info := std_fs.metadata(path)
  return info.ok && (info.mode & 61440) == 32768 && (info.mode & 73) != 0
}
