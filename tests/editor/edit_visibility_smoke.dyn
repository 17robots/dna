// Reuse the same document and visual viewport: reset must not conceal scroll lag.
fn edit_visibility_smoke(app:*App, typography:*Typography, renderer:rawptr) {
  doc:=app.documents.current
  saved_view:=app.view
  saved_smooth:=app.config.smooth_scroll
  saved_panel:=app.prompt_state.panel
  defer app.view=saved_view
  defer app.config.smooth_scroll=saved_smooth
  defer app.prompt_state.panel=saved_panel
  app.prompt_state.panel=Panel.None
  app.config.smooth_scroll=true
  app.view.reduced_motion=false
  app.view.insert=true
  app.view.line_numbers=false
  app.view.status_line=false
  app.view.scroll_x=0.0
  app.view.scroll_y=0.0
  app.view.animation.reset=true
  _=buffer.load(doc, "")
  draw_document(renderer, app, typography, 640, 400, true)
  app.view.animation.reset=false
  wide:[300]u8=[]
  for i in 0..300 {
    wide[i]=87
  }
  text_input(app, wide[..])
  draw_document(renderer, app, typography, 640, 400, true)
  margin:=app.config.document_padding*typography.scale
  width:=640.0-margin*2.0
  caret:=measure_position(doc, typography, doc.cursor)
  x:=text_caret_x(&caret, true)
  visual:=&app.view.animation.file
  if x<visual.x.value || x+typography.cell>visual.x.value+width+0.01 {
    #panic("first edit draw clips horizontal caret")
  }
  lines:[200]u8=[]
  for i in 0..100 {
    lines[i*2]=10
    lines[i*2+1]=87
  }
  text_input(app, lines[..])
  draw_document(renderer, app, typography, 640, 400, true)
  y:=#cast(f32, line_at(doc, doc.cursor)-1)*typography.line
  height:=400.0-margin*2.0
  if y<visual.y.value || y+typography.line>visual.y.value+height+0.01 {
    #panic("first edit draw clips vertical caret")
  }
  _=buffer.load(doc, "")
}
