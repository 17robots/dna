use "../../src/owned_arena" arena_owner
use "../../src/files" files
use "../../src/buffer" buffer
use "std/fs" std_fs
use "std/mem"
use "std/process" process
fn require_empty(error: []const u8) {
  if #len(error) != 0 {
    #panic(error)
  }
}
fn main() {
  arena := arena_owner.create(#sizeof(buffer.Document) + 2097152)
  defer arena_owner.release(arena)
  doc := buffer.allocate(arena)
  _ = buffer.load(doc, "first\n")
  state := files.State{}
  require_empty(files.save(&state, doc, "sample.txt", arena))
  if buffer.dirty(doc) || !std_fs.metadata("sample.txt").ok {
    #panic("new save")
  }
  if #syscall(90, &state.path[0], 448) != 0 {
    #panic("chmod fixture")
  }
  buffer.move_to(doc, doc.length, false)
  _ = buffer.replace(doc, "second\n")
  _ = buffer.replace(doc, "third\n")
  require_empty(files.save(&state, doc, "sample.txt", arena))
  if (std_fs.metadata("sample.txt").mode & 511) != 448 || std_fs.metadata("sample.txt.dna-recovery").ok {
    #panic("permissions or recovery cleanup")
  }
  _ = std_fs.write_all("sample.txt", "external\n")
  _ = buffer.replace(doc, "local\n")
  if #len(files.save(&state, doc, "sample.txt", arena)) == 0 {
    #panic("external conflict accepted")
  }
  check := std_fs.read_all(arena, "sample.txt", 100)
  if !check.ok || !buffer.equal(check.value, "external\n") {
    #panic("external content lost")
  }
  if #len(files.open(&state, doc, "sample.txt", arena)) == 0 {
    #panic("dirty open accepted")
  }
  require_empty(files.save(&state, doc, "new.txt", arena))
  if #len(files.save(&state, doc, "sample.txt", arena)) == 0 {
    #panic("save-as overwrite accepted")
  }
  buffer.move_to(doc, doc.length, false)
  _ = buffer.replace(doc, "recover me\n")
  if !std_fs.write_all("new.txt.dna-recovery", doc.bytes[..doc.length]).ok {
    #panic("legacy recovery fixture")
  }
  // Simulate a fresh editor after a crash: sidecar exists, original still saved.
  state.recovery_owned = false
  _ = buffer.load(doc, "")
  require_empty(files.open(&state, doc, "new.txt", arena))
  if !std_fs.metadata("new.txt.dna-recovery").ok {
    #panic("unclaimed legacy recovery lost")
  }
  require_empty(files.recover(&state, doc, arena))
  if !buffer.dirty(doc) || !buffer.find(doc, "recover me", false) {
    #panic("recover contents")
  }
  files.discard_recovery(&state)
  _ = buffer.load(doc, "")
  if #len(files.open(&state, doc, "link.txt", arena)) == 0 {
    #panic("symlink opened")
  }
  _ = buffer.replace(doc, "safe")
  if #len(files.save(&state, doc, "link.txt", arena)) == 0 {
    #panic("symlink replaced")
  }
  _ = buffer.load(doc, "unchanged")
  if #len(files.open(&state, doc, "binary.txt", arena)) == 0 || !buffer.equal(doc.bytes[..doc.length], "unchanged") {
    #panic("invalid read mutated document")
  }
  before := state
  revision := doc.revision
  invalid: [5]u8 = [110, 101, 119, 255, 10]
  if !std_fs.write_all("invalid-utf8.txt", invalid[..]).ok || !std_fs.write_all("new.txt.dna-recovery", "owned recovery").ok {
    #panic("invalid-open fixture")
  }
  state.recovery_owned = true
  if #len(files.open(&state, doc, "invalid-utf8.txt", arena)) == 0 || doc.revision != revision || !buffer.equal(doc.bytes[..doc.length], "unchanged") || !buffer.equal(files.name(&state), files.name(&before)) || !state.recovery_owned || !std_fs.metadata("new.txt.dna-recovery").ok {
    #panic("failed open changed buffer, filename or recovery ownership")
  }
  files.discard_recovery(&state)
  if !buffer.equal(files.open(&state, doc, "large.txt", arena), "File exceeds the 256 MiB limit.") {
    #panic("oversized read accepted")
  }
  if #len(files.open(&state, doc, "pipe.txt", arena)) == 0 {
    #panic("FIFO accepted")
  }
  resolved: [4096]u8 = []
  alternate: [4096]u8 = []
  a := files.resolve("./sample.txt", resolved[..])
  b := files.resolve("sample.txt", alternate[..])
  if #len(a) == 0 || !buffer.equal(a, b) {
    #panic("path aliases")
  }
}
