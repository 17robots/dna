// Traversal belongs to one worker. Each generation publishes growing immutable
// prefixes so a cold picker need not wait for the entire tree. Callers reject
// stale roots by generation; the worker only appends until the final snapshot.
// Paths live NUL-terminated in one growable pool, so memory follows the files
// found instead of a fixed row count. Growth happens under the lock because
// realloc may move rows a reader is copying; appends past count need none.
const PickerVisitLimit: usize = 262144
struct NativePicker {
  thread, lock, wake: rawptr,
  stop: sync.AtomicU32,
  generation: sync.AtomicU64,
  root: [4096]u8,
  published: u64,
  count, visited: usize,
  flags: u32,
  watch: *DiskDirectoryWatch,
  names: []u8,
  offsets: []usize,
}
struct PickerScan {
  owner: *NativePicker,
  generation: u64,
  count, visited, used: usize,
  flags: u32,
}
fn picker_cancelled(scan: *PickerScan) bool {
  return sync.load_u32(&scan.owner.stop) != 0 || sync.load_u64(&scan.owner.generation) != scan.generation
}
fn picker_capacity(current: usize, need: usize) usize {
  capacity := current
  if capacity < 4096 {
    capacity = 4096
  }
  for capacity < need {
    capacity *= 2
  }
  return capacity
}
fn picker_grow_names(worker: *NativePicker, need: usize) bool {
  if need <= #len(worker.names) {
    return true
  }
  capacity := picker_capacity(#len(worker.names), need)
  rec_lock(worker.lock)
  defer rec_unlock(worker.lock)
  old: rawptr = nil
  if #len(worker.names) != 0 {
    old = #cast(rawptr, &worker.names[0])
  }
  pointer := #cast(*u8, dna_memory_realloc(old, capacity, 1))
  if pointer == nil {
    return false
  }
  worker.names = pointer[..capacity]
  return true
}
fn picker_grow_offsets(worker: *NativePicker, need: usize) bool {
  if need <= #len(worker.offsets) {
    return true
  }
  capacity := picker_capacity(#len(worker.offsets), need)
  rec_lock(worker.lock)
  defer rec_unlock(worker.lock)
  old: rawptr = nil
  if #len(worker.offsets) != 0 {
    old = #cast(rawptr, &worker.offsets[0])
  }
  pointer := #cast(*usize, dna_memory_realloc(old, capacity * #sizeof(usize), 1))
  if pointer == nil {
    return false
  }
  worker.offsets = pointer[..capacity]
  return true
}
fn picker_publish(scan: *PickerScan, complete: bool) {
  worker := scan.owner
  rec_lock(worker.lock)
  if !picker_cancelled(scan) {
    worker.count = scan.count
    worker.visited = scan.visited
    worker.flags = scan.flags
    if !complete {
      worker.flags |= 8
    }
    worker.published = scan.generation
  }
  rec_unlock(worker.lock)
  rec_notify()
}
// Folders waiting to be read, as NUL-terminated relative paths. Traversal is
// breadth-first so files near the root are indexed before the visit budget is
// spent inside one deep subtree. Depth is the number of slashes in the path.
struct PickerQueue { bytes: []u8, head, used: usize }
fn picker_enqueue(scan: *PickerScan, queue: *PickerQueue, relative: *const u8, length: usize, depth: usize) {
  if depth > 12 {
    scan.flags |= 1
    return
  }
  if queue.used + length + 1 > #len(queue.bytes) {
    capacity := picker_capacity(#len(queue.bytes), queue.used + length + 1)
    old: rawptr = nil
    if #len(queue.bytes) != 0 {
      old = #cast(rawptr, &queue.bytes[0])
    }
    pointer := #cast(*u8, dna_memory_realloc(old, capacity, 1))
    if pointer == nil {
      scan.flags |= 1
      return
    }
    queue.bytes = pointer[..capacity]
  }
  _ = copy(&queue.bytes[queue.used], relative, length + 1)
  queue.used += length + 1
}
fn picker_directory(scan: *PickerScan, queue: *PickerQueue, path: *const u8, relative: *const u8, depth: usize) {
  rec_lock(scan.owner.lock)
  if dna_directory_watch_add(scan.owner.watch, path) == 0 {
    scan.flags |= 4
  }
  rec_unlock(scan.owner.lock)
  fd := rec_open(path, 589824, 0)
  if fd < 0 {
    scan.flags |= 2
    return
  }
  directory := install_fdopendir(fd)
  if directory == nil {
    _ = rec_close(fd)
    scan.flags |= 2
    return
  }
  defer _ = install_closedir(directory)
  for !picker_cancelled(scan) && scan.visited < PickerVisitLimit {
    entry := install_readdir(directory)
    if entry == nil {
      return
    }
    scan.visited += 1
    name := &entry.name[0]
    if name.* == 46 || !search_valid_name(name) {
      continue
    }
    name_length := string_length(name)
    prefix_length := string_length(relative)
    path_length := string_length(path)
    if prefix_length + name_length >= 512 || path_length + name_length + 2 >= 4096 {
      scan.flags |= 1
      continue
    }
    rel: [512]u8 = []
    _ = copy(&rel[0], relative, prefix_length)
    _ = copy(&rel[prefix_length], name, name_length + 1)
    info := InstallStat{}
    // Match the existing picker policy: follow links, bounded by depth/visits.
    if install_fstatat(search_dirfd(directory), name, &info, 0) != 0 {
      scan.flags |= 2
      continue
    }
    if (info.mode & 61440) == 16384 {
      skip_build: []const u8 = "build\0"
      skip_target: []const u8 = "target\0"
      skip_modules: []const u8 = "node_modules\0"
      if search_compare(name, &skip_build[0]) == 0 || search_compare(name, &skip_target[0]) == 0 || search_compare(name, &skip_modules[0]) == 0 {
        continue
      }
      if prefix_length + name_length + 1 >= 512 {
        scan.flags |= 1
        continue
      }
      rel[prefix_length + name_length] = 47
      rel[prefix_length + name_length + 1] = 0
      picker_enqueue(scan, queue, &rel[0], prefix_length + name_length + 1, depth + 1)
    } else if (info.mode & 61440) == 32768 {
      length := prefix_length + name_length
      if !picker_grow_names(scan.owner, scan.used + length + 1) || !picker_grow_offsets(scan.owner, scan.count + 1) {
        scan.flags |= 1
        return
      }
      scan.owner.offsets[scan.count] = scan.used
      _ = copy(&scan.owner.names[scan.used], &rel[0], length + 1)
      scan.used += length + 1
      scan.count += 1
      if scan.count == 64 || scan.count % 128 == 0 {
        picker_publish(scan, false)
      }
    }
  }
  if !picker_cancelled(scan) {
    scan.flags |= 1
  }
}
fn picker_walk(scan: *PickerScan, root: *const u8) {
  queue := PickerQueue{}
  defer {
    if #len(queue.bytes) != 0 {
      dna_memory_free(#cast(rawptr, &queue.bytes[0]))
    }
  }
  empty: [1]u8 = [0]
  picker_enqueue(scan, &queue, &empty[0], 0, 0)
  root_length := string_length(root)
  for queue.head < queue.used && !picker_cancelled(scan) {
    if scan.visited >= PickerVisitLimit {
      scan.flags |= 1
      return
    }
    relative: [512]u8 = []
    relative_length := string_length(&queue.bytes[queue.head])
    _ = copy(&relative[0], &queue.bytes[queue.head], relative_length + 1)
    queue.head += relative_length + 1
    depth: usize = 0
    for at in 0..relative_length {
      if relative[at] == 47 {
        depth += 1
      }
    }
    path: [4096]u8 = []
    _ = copy(&path[0], root, root_length + 1)
    if relative_length > 0 {
      if root_length + relative_length + 2 >= 4096 {
        scan.flags |= 1
        continue
      }
      path[root_length] = 47
      _ = copy(&path[root_length + 1], &relative[0], relative_length + 1)
    }
    picker_directory(scan, &queue, &path[0], &relative[0], depth)
  }
}
fn picker_worker(pointer: rawptr) i32 {
  worker := #cast(*NativePicker, pointer)
  completed: u64 = 0
  for {
    rec_lock(worker.lock)
    for sync.load_u32(&worker.stop) == 0 && completed == sync.load_u64(&worker.generation) {
      rec_wait(worker.wake, worker.lock)
    }
    if sync.load_u32(&worker.stop) != 0 {
      rec_unlock(worker.lock)
      break
    }
    completed = sync.load_u64(&worker.generation)
    root := worker.root
    dna_directory_watch_clear(worker.watch)
    _ = dna_directory_watch_poll(worker.watch)
    rec_unlock(worker.lock)
    scan := PickerScan{owner: worker, generation: completed}
    if root[0] != 0 {
      picker_walk(&scan, &root[0])
    }
    picker_publish(&scan, true)
  }
  return 0
}
pub fn dna_picker_open() *NativePicker {
  worker := #cast(*NativePicker, search_calloc(1, #sizeof(NativePicker), 1))
  if worker == nil {
    return nil
  }
  worker.lock = rec_mutex()
  worker.wake = rec_condition()
  worker.watch = dna_directory_watch_open()
  if worker.lock != nil && worker.wake != nil {
    worker.thread = rec_thread(picker_worker, #cast(rawptr, worker))
  }
  if worker.thread == nil {
    if worker.watch != nil {
      dna_directory_watch_close(worker.watch)
    }
    if worker.wake != nil {
      rec_condition_free(worker.wake)
    }
    if worker.lock != nil {
      rec_mutex_free(worker.lock)
    }
    search_free(#cast(rawptr, worker))
    return nil
  }
  return worker
}
pub fn dna_picker_submit(worker: *NativePicker, root: *const u8) u64 {
  if worker == nil {
    return 0
  }
  rec_lock(worker.lock)
  search_copy_text(worker.root[..], root)
  request_generation := sync.fetch_add_u64(&worker.generation, 1) + 1
  rec_signal(worker.wake)
  rec_unlock(worker.lock)
  return request_generation
}
// -1 stale, 0 pending, 1 complete, 2 partial. flags: limited=1,error=2,watch fallback=4.
pub fn dna_picker_poll(worker: *NativePicker, request_generation: u64, count: *usize, visited: *usize, flags: *u32) i32 {
  if worker == nil {
    return -1
  }
  rec_lock(worker.lock)
  defer rec_unlock(worker.lock)
  if sync.load_u64(&worker.generation) != request_generation {
    return -1
  }
  if worker.published != request_generation {
    return 0
  }
  count.* = worker.count
  visited.* = worker.visited
  flags.* = worker.flags & 7
  if (worker.flags & 8) != 0 {
    return 2
  }
  return 1
}
pub fn dna_picker_row(worker: *NativePicker, request_generation: u64, index: usize, output: *u8, capacity: usize) usize {
  if worker == nil {
    return 0
  }
  rec_lock(worker.lock)
  defer rec_unlock(worker.lock)
  if sync.load_u64(&worker.generation) != request_generation || worker.published != request_generation || index >= worker.count {
    return 0
  }
  row := &worker.names[worker.offsets[index]]
  length := string_length(row)
  if length >= capacity {
    return 0
  }
  _ = copy(output, row, length + 1)
  return length
}
pub fn dna_picker_changed(worker: *NativePicker) i32 {
  if worker == nil {
    return 0
  }
  rec_lock(worker.lock)
  defer rec_unlock(worker.lock)
  return dna_directory_watch_poll(worker.watch)
}
pub fn dna_picker_close(worker: *NativePicker) {
  if worker == nil {
    return
  }
  rec_lock(worker.lock)
  sync.store_u32(&worker.stop, 1)
  rec_signal(worker.wake)
  rec_unlock(worker.lock)
  rec_join(worker.thread, nil)
  dna_directory_watch_close(worker.watch)
  rec_condition_free(worker.wake)
  rec_mutex_free(worker.lock)
  if #len(worker.names) != 0 {
    dna_memory_free(#cast(rawptr, &worker.names[0]))
  }
  if #len(worker.offsets) != 0 {
    dna_memory_free(#cast(rawptr, &worker.offsets[0]))
  }
  search_free(#cast(rawptr, worker))
}
