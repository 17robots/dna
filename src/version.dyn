use "std/io"

const DnaVersion: str = "0.1.0-preview.21"

// Printed by --help; keep in step with README "Run".
const DnaUsage: str = "Usage: dna [--gui | --tui] [--] [FILE | DIRECTORY]\n\nOpen FILE, or open DIRECTORY as the project and show its explorer.\nWith no target, DNA opens an empty buffer in the current directory.\n\nOptions:\n  --gui          Use the window frontend.\n  --tui          Use the terminal frontend.\n  --             Treat every later argument as a path.\n  -h, --help     Show this help and exit.\n  --version      Show the version and exit.\n\nConfiguration: ~/.config/dna/config.toml (or DNA_CONFIG).\nIn the editor, :help lists commands and :keys lists key bindings.\n"

// Handle informational commands before allocating editor state or opening
// files. Returns the exit code, or -1 when the editor should start.
fn cli_early() i32 {
  owner := arena_owner.create(65536)
  defer arena_owner.release(owner)
  arguments := host.arguments(owner) catch {
    return -1
  }
  for index in 1..arguments.len {
    argument := arguments[index]
    if buffer.equal(argument, "--") { break }
    if buffer.equal(argument, "--version") || (arguments.len == 2 && buffer.equal(argument, "version")) {
      io.write(io.stdout(), "dna ") catch {}
      io.write(io.stdout(), DnaVersion) catch {}
      io.write(io.stdout(), "\n") catch {}
      return 0
    }
    if buffer.equal(argument, "--help") || buffer.equal(argument, "-h") || (arguments.len == 2 && buffer.equal(argument, "help")) {
      io.write(io.stdout(), DnaUsage) catch {}
      return 0
    }
    if argument.len > 1 && argument[0] == '-' && !buffer.equal(argument, "--tui") && !buffer.equal(argument, "--gui") {
      host.write_error("dna: unknown option '")
      host.write_error(argument)
      host.write_error("'\nTry 'dna --help'. Use 'dna -- ")
      host.write_error(argument)
      host.write_error("' to open a file with that name.\n")
      return 2
    }
  }
  return -1
}
