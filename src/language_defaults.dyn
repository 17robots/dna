use "./servers" servers
const DefaultServers: usize = servers.DefaultServers
fn default_server(index: usize) servers.DefaultServer {
  return servers.default_server(index)
}
fn on_path(command: []const u8) bool {
  return servers.on_path(command)
}

// Start the default server for a language once per session when available.
fn lsp_default_start(app: *App, name: []const u8) {
  if !app.config.default_servers {
    return
  }
  // Tests set DNA_DEFAULT_SERVERS=0 so results never depend on the PATH.
  switch: [8]u8 = []
  override := host.environment("DNA_DEFAULT_SERVERS", switch[..])
  if override.ok && override.found && buffer.equal(override.value, "0") {
    return
  }
  configured := settings.language(&app.config, name)
  // A configured server, or auto_start = false, is the user's choice.
  if configured != nil && ((configured.seen & 16) != 0 || ((configured.seen & 8) != 0 && !configured.auto_start)) {
    return
  }
  for index in 0..DefaultServers {
    entry := default_server(index)
    bit := #cast(u64) 1 << index
    if buffer.equal(entry.language, name) && (app.lsp.default_started & bit) == 0 {
      app.lsp.default_started = app.lsp.default_started | bit
      if lsp_for(app) == 8 {
        previous_panel := app.prompt_state.panel
        if managed_server_available(app, entry) {
          server_tool(app, "server-start", name)
        }
        else if on_path(entry.command) {
          lsp_start(app, name, entry.command)
        }
        app.prompt_state.panel = previous_panel
      }
      return
    }
  }
}

fn managed_server_available(app: *App, entry: servers.DefaultServer) bool {
  end: usize = 0
  for end < #len(entry.command) && entry.command[end] != ' ' {
    end += 1
  }
  path: [4096]u8 = []
  used: usize = 0
  add_text(path[..], &used, app.workspace.language_root[..app.workspace.language_root_length])
  add_text(path[..], &used, "/.servers/")
  add_text(path[..], &used, entry.language)
  add_text(path[..], &used, "/node_modules/.bin/")
  add_text(path[..], &used, entry.command[..end])
  info := fs.metadata(path[..used])
  return info.ok && (info.mode & 61440) == 32768 && (info.mode & 73) != 0
}
