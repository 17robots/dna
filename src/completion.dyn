use arena_owner "./owned_arena"
struct CompletionState {
  entries: [128]Entry,
  count: usize,
  selected: usize,
  chosen: bool,
  error: bool,
  prefix: [4096]u8,
  prefix_length: usize,
}

// Paths are NUL-terminated in names; offsets[row] is where each starts. Both
// are lazily committed reservations, so memory follows the files indexed.
const PickerIndexRows: usize = 262144
const PickerIndexBytes: usize = 33554432
struct PickerIndex {
  names: []u8,
  offsets: []usize,
  used: usize,
  count: usize,
  visited: usize,
  root: [4096]u8,
  root_length: usize,
  limited: bool,
  error: bool,
}

fn expand_home(path: str, output: []u8) str {
  if path.len > 0 && path[0] == '~' && (path.len == 1 || path[1] == '/') {
    home_storage: [4096]u8
    home := host.environment("HOME", home_storage[..]) catch {
      return output[..0]
    }
    if home.len + path.len >= output.len { return output[..0] }
    used: usize = 0
    add_text(output, &used, home)
    if path.len == 1 {
      add_text(output, &used, "/")
    } else {
      add_text(output, &used, path[1..])
    }
    return output[..used]
  }
  length := copy_text(output, path)
  return output[..length]
}
// Bounded, cached file-only index. Typing filters memory, not the filesystem.
fn picker_match(name: str, query: str) bool {
  at: usize = 0
  for byte in name {
    if at < query.len && lower(byte) == lower(query[at]) {
      at += 1
    }
  }
  return at == query.len
}
fn completion_refresh(app: *App) {
  if app.resource_state.kind == .Languages {
    language_manager_refresh(app)
    return
  }
  if app.resource_state.kind == .TaskOutput {
    task_refresh(app)
    return
  }
  if app.resource_state.fonts || app.resource_state.kind != .None {
    font_refresh(app)
    return
  }
  app.completion.count = 0
  app.completion.selected = 0
  app.completion.chosen = false
  app.completion.error = false
  expanded: [4096]u8
  path := expand_home(app.prompt_state.text[..app.prompt_state.length], expanded[..])
  split := path.len
  for split > 0 && path[split - 1] != '/' {
    split -= 1
  }
  app.completion.prefix_length = copy_text(app.completion.prefix[..], path[..split])
  directory: str = "."
  if split > 0 {
    directory = path[..split]
  }
  fragment := path[split..]
  if app.picker_state.index == nil {
    allocated := arena_owner.create(#sizeof(PickerIndex) + #alignof(usize) + #sizeof(usize) * PickerIndexRows + PickerIndexBytes)
    app.picker_state.arena = allocated
    allocated = nil
    // A fresh mapping is already zero; only touched entries become resident.
    app.picker_state.index = mem.push<PickerIndex>(app.picker_state.arena)
    app.picker_state.index.offsets = mem.push_array<usize>(app.picker_state.arena, PickerIndexRows)
    app.picker_state.index.names = mem.push_bytes(app.picker_state.arena, PickerIndexBytes)
  }
  index := app.picker_state.index
  changed_root := !buffer.equal(directory, index.root[..index.root_length])
  if changed_root || !app.picker_state.watching {
    if changed_root {
      index.root_length = copy_text(index.root[..], directory)
      index.count = 0
      index.visited = 0
      index.error = false
      index.limited = false
    }
    // Reopening the same root can draw its last complete list immediately.
    // Refresh asynchronously because watches are released while hidden.
    picker_index_submit(app)
  }
  _ = picker_index_receive(app)
  app.completion.error = index.error
  for pass in 0..3 {
    row: usize = 0
    for row < index.count && app.completion.count < 128 {
      name := picker_index_name(index, row)
      prefix := fragment.len <= name.len && contains(name[..fragment.len], fragment)
      substring := contains(name, fragment)
      if (pass == 0 && prefix) || (pass == 1 && !prefix && substring) || (pass == 2 && !substring && picker_match(name, fragment)) {
        output := &app.completion.entries[app.completion.count]
        output.length = copy_text(output.name[..], name)
        output.directory = false
        app.completion.count += 1
      }
      row += 1
    }
  }
}
fn complete_path(app: *App) bool {
  if app.completion.count == 0 { return false }
  entry := &app.completion.entries[app.completion.selected]
  if app.completion.prefix_length + entry.length >= 4096 {
    notice(app, "Completed path is too long.")
    return false
  }
  app.prompt_state.length = copy_text(app.prompt_state.text[..], app.completion.prefix[..app.completion.prefix_length])
  add_text(app.prompt_state.text[..], &app.prompt_state.length, entry.name[..entry.length])
  completion_refresh(app)
  return true
}
fn open_prompt(app: *App, typography: *Typography) {
  if app.resource_state.kind != .None {
    resource_select(app, typography)
    return
  }
  if app.resource_state.fonts {
    if app.completion.count > 0 {
      entry := &app.completion.entries[app.completion.selected]
      font_select(app, typography, entry.name[..entry.length])
    }
    return
  }
  expanded: [4096]u8
  path := expand_home(app.prompt_state.text[..app.prompt_state.length], expanded[..])
  info := files.metadata(path) catch fs.Metadata{}
  if !app.completion.chosen && (info.mode & 61440) == 32768 {
    open_file(app, path)
    return
  }
  if app.completion.count > 0 {
    if complete_path(app) {
      selected: [4096]u8
      chosen := expand_home(app.prompt_state.text[..app.prompt_state.length], selected[..])
      open_file(app, chosen)
    }
    return
  }
  // Keep an empty result in the picker; directories never turn into explorer rows.
}
// Enter in the palette: a selected suggestion fills in first; a folder or an
// option name waits for the rest of the input.
fn command_submit(app: *App, typography: *Typography) {
  if palette_enter(app) { return }
  command_history_remember(app)
  command_execute(app, typography)
}
// Run the palette text exactly as written (key bindings run theirs this way).
fn command_execute(app: *App, typography: *Typography) {
  text := app.prompt_state.text[..app.prompt_state.length]
  if app.terminal_state.commands {
    app.terminal_state.commands = false
    if buffer.equal(text, "q") || buffer.equal(text, "quit") {
      app.prompt_state.panel = .None
      return
    }
    if buffer.equal(text, "bd") {
      activate(app, app.terminal_state.slot)
      request_buffer_close(app)
      return
    }
  }
  if app.explorer.commands {
    app.explorer.commands = false
    if buffer.equal(text, "write") || buffer.equal(text, "w") {
      explorer_preview(app)
      return
    }
    if buffer.equal(text, "q") || buffer.equal(text, "quit") {
      app.prompt_state.panel = .None
      return
    }
    if buffer.equal(text, "undo") {
      buffer.undo(app.explorer.document)
      app.prompt_state.panel = .Directory
      return
    }
    if buffer.equal(text, "redo") {
      buffer.redo(app.explorer.document)
      app.prompt_state.panel = .Directory
      return
    }
    if buffer.equal(text, "discard") {
      run_command(app, typography, .ExplorerDiscard)
      return
    }
    if buffer.equal(text, "refresh") {
      run_command(app, typography, .ExplorerRefresh)
      return
    }
    app.explorer.commands = true
    matches(app)
    app.explorer.commands = false
    if app.prompt_state.match_count > 0 && palette_row_runs(app, app.prompt_state.selected) {
      if explorer_command(app, typography, app.prompt_state.matches[app.prompt_state.selected]) {
        return
      }
    }
    notice(app, "Explorer commands: write, undo, redo, refresh, discard, quit. Explorer :write takes no path.")
    return
  }
  // Forced forms: ! discards unsaved changes instead of asking.
  if buffer.equal(text, "q!") || buffer.equal(text, "quit!") || buffer.equal(text, "bd!") {
    app.prompt_state.panel = .None
    close_clean(app)
    return
  }
  if buffer.equal(text, "qa!") || buffer.equal(text, "qall!") || buffer.equal(text, "quit-all!") {
    app.prompt_state.panel = .None
    app.running = false
    return
  }
  if buffer.equal(text, "e!") || buffer.equal(text, "reload!") {
    app.prompt_state.panel = .None
    disk_reload(app, true)
    return
  }
  if buffer.equal(text, "w!") {
    run_command(app, typography, .Write)
    return
  }
  if buffer.equal(text, "messages") || buffer.equal(text, "mes") {
    status_messages_show(app)
    return
  }
  if buffer.equal(text, "marks") {
    vim_marks_show(app)
    return
  }
  if buffer.equal(text, "ls") || buffer.equal(text, "buffers!") {
    run_command(app, typography, .Buffers)
    return
  }
  // Search highlights end with the search; nothing stays highlighted to clear.
  if buffer.equal(text, "noh") || buffer.equal(text, "nohlsearch") {
    app.prompt_state.panel = .None
    return
  }
  // Vim spellings that DNA runs under another name.
  if (text.len > 4 && buffer.equal(text[..4], "sav ")) || (text.len > 7 && buffer.equal(text[..7], "saveas ")) || (text.len > 1 && text[0] == '!') {
    rewritten: [4096]u8
    used: usize = 0
    if text[0] == '!' {
      used = copy_text(rewritten[..], "run ")
      add_text(rewritten[..], &used, text[1..])
    } else {
      space: usize = 0
      for text[space] != ' ' {
        space += 1
      }
      used = copy_text(rewritten[..], "write")
      add_text(rewritten[..], &used, text[space..])
    }
    app.prompt_state.length = copy_text(app.prompt_state.text[..], rewritten[..used])
    command_execute(app, typography)
    return
  }
  if vim_ex_command(app, typography, text) {
    if text.len <= 1024 {
      app.vim_session.last_length = copy_text(app.vim_session.last[..], text)
    }
    return
  }
  split: usize = 0
  for split < text.len && text[split] != ' ' {
    split += 1
  }
  verb := text[..split]
  argument := split
  for argument < text.len && text[argument] == ' ' {
    argument += 1
  }
  // Bare, these do something of their own; their palette rows ask for an argument.
  if buffer.equal(text, "cd") {
    project_cd(app, "")
    return
  }
  if buffer.equal(text, "theme") {
    theme_current(app)
    return
  }
  if buffer.equal(text, "help") || buffer.equal(text, "h") {
    help_open(app, false)
    return
  }
  if buffer.equal(text, "keys") || buffer.equal(text, "keymaps") || buffer.equal(text, "map") {
    help_open(app, true)
    return
  }
  if (buffer.equal(verb, "set") || buffer.equal(verb, "se")) && argument < text.len {
    set_command(app, typography, text[argument..])
    return
  }
  if argument == text.len {
    command := command_named(verb)
    if command < BuiltinCommands {
      action(app, typography, command)
      return
    }
  }
  if buffer.equal(verb, "pipe") || buffer.equal(verb, "pipe-to") || buffer.equal(verb, "insert-output") || buffer.equal(verb, "append-output") {
    mode: u8 = 0
    case verb {
      "pipe-to" => {
        mode = 1
      }
      "insert-output" => {
        mode = 2
      }
      "append-output" => {
        mode = 3
      }
      _ => {}
    }
    shell_command(app, mode, text[argument..])
    return
  }
  if buffer.equal(text, "increment") || buffer.equal(text, "decrement") {
    increment_selections(app, 1, buffer.equal(text, "decrement"))
    app.prompt_state.panel = .None
    return
  }
  if buffer.equal(text, "comment") {
    comment_toggle(app)
    app.prompt_state.panel = .None
    return
  }
  if buffer.equal(verb, "keymap") {
    keymap_command(app, settings.trim(text[argument..]))
    return
  }
  if buffer.equal(verb, "frontend") {
    frontend_switch(app, settings.trim(text[argument..]))
    return
  }
  if buffer.equal(verb, "place") {
    place_command(app, settings.trim(text[argument..]))
    return
  }
  if buffer.equal(verb, "module") || buffer.equal(verb, "modules") {
    module_command(app, settings.trim(text[argument..]))
    return
  }
  if buffer.equal(verb, "reload") {
    disk_reload(app, false)
    return
  }
  if buffer.equal(verb, "format") {
    format_start(app, false, "")
    return
  }
  if buffer.equal(verb, "format-cancel") {
    format_release(app)
    save_cancel(app)
    app.prompt_state.panel = .None
    return
  }
  if buffer.equal(verb, "server-install") || buffer.equal(verb, "server-update") || buffer.equal(verb, "server-start") {
    server_tool(app, verb, settings.trim(text[argument..]))
    return
  }
  if lsp_command(app, verb, text[argument..]) { return }
  if (buffer.equal(verb, "open") || buffer.equal(verb, "e")) && argument < text.len {
    storage: [4096]u8
    path := expand_home(text[argument..], storage[..])
    open_file(app, path)
    return
  }
  if (buffer.equal(verb, "write") || buffer.equal(verb, "w")) && argument < text.len {
    output: [4096]u8
    destination := expand_home(text[argument..], output[..])
    save_file(app, destination)
    return
  }
  if buffer.equal(verb, "search-global") {
    query: [4096]u8
    query_length := copy_text(query[..], text[argument..])
    project_search_open(app)
    app.prompt_state.length = copy_text(app.prompt_state.text[..], query[..query_length])
    project_search_refresh(app)
    return
  }
  if buffer.equal(verb, "resize") {
    pane_resize(app, settings.number(text[argument..]))
    return
  }
  if buffer.equal(verb, "replace-preview") {
    app.replacement.text_length = copy_text(app.replacement.text[..], text[argument..])
    replace_prepare(app, app.replacement.text[..app.replacement.text_length])
    return
  }
  if buffer.equal(verb, "session-save") {
    _ = session_save(app, text[argument..])
    return
  }
  if buffer.equal(verb, "session-load") {
    _ = session_restore(app, text[argument..])
    return
  }
  if buffer.equal(verb, "plugin-load") {
    plugin_load_named(app, text[argument..])
    return
  }
  if buffer.equal(verb, "plugin-rollback") {
    plugin_rollback(app, text[argument..])
    return
  }
  if buffer.equal(verb, "plugin-update") {
    plugin_update(app, text[argument..])
    return
  }
  if buffer.equal(verb, "plugin-remove") {
    plugin_remove(app, text[argument..])
    return
  }
  if buffer.equal(verb, "plugin-disable") {
    plugin_disable_named(app, text[argument..])
    return
  }
  if buffer.equal(verb, "plugin-install") {
    plugin_install_named(app, text[argument..])
    return
  }
  if buffer.equal(verb, "layout-save") {
    layout_save(app, text[argument..])
    return
  }
  if buffer.equal(verb, "layout") && argument < text.len {
    target: [4096]u8
    target_length := copy_text(target[..], text[argument..])
    panel(app, .Layout)
    app.prompt_state.length = copy_text(app.prompt_state.text[..], target[..target_length])
    submit(app, typography)
    return
  }
  if buffer.equal(verb, "filetype") || buffer.equal(verb, "ft") || buffer.equal(verb, "set-language") {
    filetype_command(app, settings.trim(text[argument..]))
    return
  }
  if text.len > 17 && buffer.equal(text[..17], "language-install ") {
    language_install(app, settings.trim(text[17..]))
    return
  }
  if text.len > 4 && buffer.equal(text[..4], "run ") {
    terminal_show(app, true, text[4..])
    return
  }
  if text.len > 6 && buffer.equal(text[..6], "theme ") {
    theme_switch(app, typography, settings.trim(text[6..]))
    return
  }
  if text.len > 5 && buffer.equal(text[..5], "font ") {
    font_select(app, typography, text[5..])
    return
  }
  if text.len > 3 && buffer.equal(text[..3], "cd ") {
    project_cd(app, settings.trim(text[3..]))
    return
  }
  matches(app)
  if app.prompt_state.match_count > 0 && (app.command_menu.arguments || palette_row_runs(app, app.prompt_state.selected)) {
    action(app, typography, app.prompt_state.matches[app.prompt_state.selected])
    return
  }
  // Like Vim's E492: a typo never runs the nearest fuzzy match.
  app.prompt_state.panel = .None
  if text.len > 0 {
    status_error_with(app, "Not an editor command: ", text)
  }
}
