use "./pattern"
use "std/time"

struct SearchHistory { text: [4096]u8, length: usize }

struct SearchState {
  document: *buffer.Document,
  primary: buffer.Selection,
  secondary: buffer.SelectionSet,
  explorer: bool,
  extend: bool,
  status: u8,
  error_offset: usize,
  scroll_x: f32,
  scroll_y: f32,
  // Large documents search on a worker while the prompt stays responsive;
  // status is 5 until it reports.
  task: *pattern.SearchTask,
}

fn search_prompt(kind: Panel) bool {
  return kind == Panel.Search || kind == Panel.Select || kind == Panel.Split || kind == Panel.Keep || kind == Panel.Remove
}
fn search_open(app: *App, kind: Panel, explorer: bool) {
  doc := app.documents.current
  extending := app.view.extend
  scroll_x := app.view.scroll_x
  scroll_y := app.view.scroll_y
  if explorer {
    doc = app.explorer.document
    extending = app.explorer.extend
    scroll_x = app.explorer.scroll_x
    scroll_y = app.explorer.scroll_y
  }
  panel(app, kind)
  pattern.task_finish(app.search_state.task)
  app.search_state = SearchState{document: doc, primary: buffer.Selection{cursor: doc.cursor, anchor: doc.anchor}, secondary: doc.secondary, explorer: explorer, extend: extending, scroll_x: scroll_x, scroll_y: scroll_y}
}
fn search_restore(app: *App) {
  state := &app.search_state
  doc := state.document
  if doc == nil {
    return
  }
  doc.cursor = state.primary.cursor
  doc.anchor = state.primary.anchor
  doc.secondary = state.secondary
  if state.explorer {
    app.explorer.scroll_x = state.scroll_x
    app.explorer.scroll_y = state.scroll_y
  } else {
    app.view.scroll_x = state.scroll_x
    app.view.scroll_y = state.scroll_y
  }
}
fn search_close(app: *App) {
  pattern.task_finish(app.search_state.task)
  app.search_state.task = nil
  app.prompt_state.panel = Panel.None
  if app.search_state.explorer {
    app.prompt_state.panel = Panel.Directory
  }
}
// Where a search from selection starts: past an empty cursor going forward,
// at the selection's start going back.
fn search_base(doc: *const buffer.Document, selection: buffer.Selection, backwards: bool) usize {
  base := selection.cursor
  if !backwards {
    if selection.cursor == selection.anchor && base < doc.length {
      base = buffer.next(doc, base)
    }
    return base
  }
  if selection.anchor < base {
    base = selection.anchor
  }
  return base
}
fn search_step(doc: *const buffer.Document, compiled: *pattern.Pattern, selection: buffer.Selection, backwards: bool) pattern.Match {
  base := search_base(doc, selection, backwards)
  if !backwards {
    // Skip a zero-width match at the current cursor when repeating.
    result := pattern.find_document(compiled, doc, base)
    if result.found || result.error {
      return result
    }
    return pattern.find_document(compiled, doc, 0)
  }
  // Scan forward to the last match before the cursor. Positions strictly
  // advance, so the scan is linear and needs no attempt cap.
  previous := pattern.Match{}
  wrapped := pattern.Match{}
  at: usize = 0
  for at <= doc.length {
    candidate := pattern.find_document(compiled, doc, at)
    if candidate.error {
      return candidate
    }
    if !candidate.found {
      break
    }
    if candidate.start >= base && previous.found {
      return previous
    }
    wrapped = candidate
    if candidate.start < base {
      previous = candidate
    }
    if candidate.end > at {
      at = candidate.end
    } else {
      if candidate.end == doc.length {
        break
      }
      at = buffer.next(doc, candidate.end)
    }
  }
  if previous.found {
    return previous
  }
  return wrapped
}
fn search_range(doc: *const buffer.Document, original: buffer.Selection, match: pattern.Match, extending: bool, backwards: bool) buffer.Selection {
  if !extending {
    return buffer.Selection{anchor: match.start, cursor: match.end}
  }
  fixed := original.anchor
  if original.cursor < original.anchor {
    fixed = buffer.previous(doc, fixed)
  }
  destination := match.end
  if backwards {
    destination = match.start
  }
  if destination < fixed {
    return buffer.Selection{anchor: buffer.next(doc, fixed), cursor: destination}
  }
  return buffer.Selection{anchor: fixed, cursor: destination}
}
fn search_apply(doc: *buffer.Document, compiled: *pattern.Pattern, extending: bool, backwards: bool) u8 {
  // The primary must match; secondaries without a match stay where they are.
  selections := buffer.collect(doc)
  for index in 0..selections.count {
    original := selections.items[index]
    result := search_step(doc, compiled, original, backwards)
    if result.error {
      return 3
    }
    if result.found {
      selections.items[index] = search_range(doc, original, result, extending, backwards)
    } else if index == 0 {
      return 1
    }
  }
  buffer.store(doc, &selections)
  return 0
}
fn selection_add(output: *buffer.Selections, low: usize, high: usize) bool {
  for index in 0..output.count {
    if output.items[index].anchor == low && output.items[index].cursor == high {
      return true
    }
  }
  if output.count == buffer.SelectionCapacity {
    return false
  }
  output.items[output.count] = buffer.Selection{anchor: low, cursor: high}
  output.count += 1
  return true
}
fn select_matches(doc: *buffer.Document, compiled: *pattern.Pattern, split: bool) u8 {
  originals := buffer.collect(doc)
  output := buffer.Selections{}
  for current in 0..originals.count {
    range := buffer.ordered(originals.items[current])
    low := range.anchor
    high := range.cursor
    text := buffer.range(doc, low, high)
    at: usize = 0
    segment: usize = 0
    attempts: usize = 0
    for at <= #len(text) {
      if attempts == 4096 {
        return 3
      }
      attempts += 1
      found := pattern.find(compiled, text, at)
      if found.error {
        return 3
      }
      if !found.found {
        break
      }
      if split {
        if found.start > segment && !selection_add(&output, low + segment, low + found.start) {
          return 4
        }
        segment = found.end
      } else if !selection_add(&output, low + found.start, low + found.end) {
        return 4
      }
      if found.end > at {
        at = found.end
      }
      else {
        if found.end == #len(text) {
          break
        }
        at = buffer.next(doc, low + found.end) - low
      }
    }
    if split && segment < #len(text) && !selection_add(&output, low + segment, high) {
      return 4
    }
  }
  if output.count == 0 {
    return 1
  }
  buffer.store(doc, &output)
  return 0
}
fn search_preview(app: *App) {
  search_restore(app)
  state := &app.search_state
  state.status = 0
  pattern.task_finish(state.task)
  state.task = nil
  if app.prompt_state.length == 0 {
    return
  }
  doc := state.document
  if app.prompt_state.panel != Panel.Search && doc.length >= pattern.BackgroundMinimum {
    mode: u8 = 1
    if app.prompt_state.panel == Panel.Split {
      mode = 2
    } else if app.prompt_state.panel == Panel.Keep {
      mode = 3
    } else if app.prompt_state.panel == Panel.Remove {
      mode = 4
    }
    ranges := buffer.collect(doc)
    state.task = pattern.task_start_ranges(app.prompt_state.text[..app.prompt_state.length], doc, &ranges, mode)
    if state.task != nil {
      state.status = 5
      return
    }
  }
  if app.prompt_state.panel == Panel.Search && doc.length >= pattern.BackgroundMinimum && doc.secondary.count == 0 {
    backwards := app.input_state.search_backwards
    base := search_base(doc, buffer.Selection{anchor: doc.anchor, cursor: doc.cursor}, backwards)
    state.task = pattern.task_start(app.prompt_state.text[..app.prompt_state.length], doc, base, backwards)
    if state.task != nil {
      state.status = 5
      return
    }
  }
  compiled := pattern.open(app.prompt_state.text[..app.prompt_state.length])
  defer pattern.close(&compiled)
  if !compiled.ok {
    state.status = 2
    state.error_offset = compiled.error_offset
    return
  }
  if app.prompt_state.panel == Panel.Search {
    state.status = search_apply(state.document, &compiled, state.extend, app.input_state.search_backwards)
  }
  else if app.prompt_state.panel == Panel.Keep || app.prompt_state.panel == Panel.Remove {
    state.status = filter_selections(state.document, &compiled, app.prompt_state.panel == Panel.Remove)
  }
  else {
    state.status = select_matches(state.document, &compiled, app.prompt_state.panel == Panel.Split)
  }
}
// Apply a finished worker search. Returns true when the view changed.
fn search_tick(app: *App) bool {
  state := &app.search_state
  if state.task == nil || !pattern.task_done(state.task) {
    return false
  }
  result := pattern.task_result(state.task)
  ranges_status := pattern.task_status(state.task)
  ranges_output := pattern.task_output(state.task).*
  stale := pattern.task_revision(state.task) != state.document.revision
  pattern.task_finish(state.task)
  state.task = nil
  if stale {
    search_preview(app)
    return true
  }
  if app.prompt_state.panel != Panel.Search {
    state.status = ranges_status
    if ranges_status == 0 {
      buffer.store(state.document, &ranges_output)
    }
    return true
  }
  state.status = 1
  if result.error {
    state.status = 3
  }
  else if result.found {
    doc := state.document
    original := buffer.Selection{anchor: doc.anchor, cursor: doc.cursor}
    selection := search_range(doc, original, result, state.extend, app.input_state.search_backwards)
    doc.anchor = selection.anchor
    doc.cursor = selection.cursor
    state.status = 0
  }
  return true
}
fn search_pause() {
  _ = time.sleep(time.Millisecond)
}
fn search_waiting(app: *const App) bool {
  return app.search_state.task != nil
}
fn search_submit(app: *App) {
  // Enter while a worker searches waits for its answer.
  for app.search_state.task != nil && !pattern.task_done(app.search_state.task) {
    search_pause()
  }
  _ = search_tick(app)
  // An empty preview dismisses immediately; do not repeat an unsuccessful scan.
  // A large document's preview already ran on the worker; repeating it
  // would only start another.
  background := app.search_state.document != nil && app.search_state.document.length >= pattern.BackgroundMinimum
  if app.prompt_state.length > 0 && app.search_state.status != 1 && !(background && app.search_state.status == 0) {
    search_preview(app)
    for app.search_state.task != nil && !pattern.task_done(app.search_state.task) {
      search_pause()
    }
    _ = search_tick(app)
  }
  if app.prompt_state.length == 0 || app.search_state.status == 1 {
    search_restore(app)
    search_close(app)
    return
  }
  if app.search_state.status != 0 {
    return
  }
  if app.prompt_state.panel == Panel.Search {
    app.search_history.length = copy_text(app.search_history.text[..], app.prompt_state.text[..app.prompt_state.length])
  }
  search_close(app)
  vim_after_search(app)
}
fn search_repeat(app: *App, backwards: bool, explorer: bool) {
  if app.search_history.length == 0 {
    return
  }
  doc := app.documents.current
  extending := app.view.extend
  if !explorer {
    jump_push(app)
  }
  if explorer {
    doc = app.explorer.document
    extending = app.explorer.extend
  }
  if doc.length >= pattern.BackgroundMinimum && doc.secondary.count == 0 && search_repeat_windowed(app, doc, extending, backwards) {
    return
  }
  compiled := pattern.open(app.search_history.text[..app.search_history.length])
  defer pattern.close(&compiled)
  if !compiled.ok {
    return
  }
  result := search_apply(doc, &compiled, extending, backwards)
  if result != 0 {
    notice(app, "No match, or search exceeded its work limit.")
  }
}
// Repeat a search in a large document with the worker's windowed search,
// waiting for it: a backward step there never rescans from the top.
fn search_repeat_windowed(app: *App, doc: *buffer.Document, extending: bool, backwards: bool) bool {
  original := buffer.Selection{anchor: doc.anchor, cursor: doc.cursor}
  task := pattern.task_start(app.search_history.text[..app.search_history.length], doc, search_base(doc, original, backwards), backwards)
  if task == nil {
    return false
  }
  for !pattern.task_done(task) {
    search_pause()
  }
  result := pattern.task_result(task)
  pattern.task_finish(task)
  if result.found {
    selection := search_range(doc, original, result, extending, backwards)
    doc.anchor = selection.anchor
    doc.cursor = selection.cursor
  } else {
    notice(app, "No match, or search exceeded its work limit.")
  }
  return true
}
fn search_label(app: *const App) []const u8 {
  if app.prompt_state.length == 0 {
    return "Type a regular expression. Escape cancels."
  }
  if app.search_state.status == 1 {
    return "No matches. Enter or Escape closes."
  }
  if app.search_state.status == 2 {
    return "Invalid regular expression. Edit pattern or Escape to cancel."
  }
  if app.search_state.status == 3 {
    return "Pattern exceeded its work limit. Try a simpler expression."
  }
  if app.search_state.status == 4 {
    return "More than 32 selections. Narrow the pattern; selection unchanged."
  }
  if app.search_state.status == 5 {
    return "Searching..."
  }
  return "Enter accepts. Escape restores the original selection."
}

fn filter_selections(doc: *buffer.Document, compiled: *pattern.Pattern, remove: bool) u8 {
  originals := buffer.collect(doc)
  output := buffer.Selections{}
  for index in 0..originals.count {
    range := buffer.ordered(originals.items[index])
    found := pattern.find(compiled, buffer.range(doc, range.anchor, range.cursor), 0)
    if found.error {
      return 3
    }
    if found.found != remove {
      output.items[output.count] = originals.items[index]
      output.count += 1
    }
  }
  if output.count == 0 {
    return 1
  }
  buffer.store(doc, &output)
  return 0
}
