extern fn fallback_errno "__errno_location"() *i32
pub fn inotify_init1(flags: i32) i32 {
  _ = flags
  fallback_errno().* = 24
  return -1
}

pub fn pipe2(fds: *i32, flags: i32) i32 {
  name: []const u8 = "DNA_TEST_DISK_NO_CONTROL\0"
  disabled := probe_getenv(&name[0])
  if disabled != nil && disabled.* != 0 {
    fallback_errno().* = 24
    return -1
  }
  next := #cast(fn(*i32, i32) i32, probe_next("pipe2\0"))
  return next(fds, flags)
}
