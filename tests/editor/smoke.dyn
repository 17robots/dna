// Run only when the test runner supplies an isolated fixture directory.
fn workflow_smoke(app: *App, typography: *Typography) {
  location: [4096]u8 = []
  configured := host.environment("DNA_WORKFLOW_TEST", location[..])
  if !configured.ok || !configured.found {
    return
  }
  app.directory_state.length = copy_text(app.directory_state.path[..], configured.value)
  path: [4096]u8 = []
  initial := joined(app, "input.txt", path[..])
  key_input(app, typography, 111, 64)
  text_input(app, initial)
  key_input(app, typography, 13, 0)
  if app.prompt_state.panel != Panel.None || !buffer.equal(app.documents.current.bytes[..app.documents.current.length], "first\nsecond\n") {
    #panic("open workflow")
  }
  key_input(app, typography, 105, 0)
  text_input(app, "edited ")
  key_input(app, typography, 27, 0)
  key_input(app, typography, 113, 64)
  if app.prompt_state.panel != Panel.Quit {
    #panic("dirty quit confirmation")
  }
  key_input(app, typography, 27, 0)
  if !app.running || !buffer.dirty(app.documents.current) {
    #panic("quit cancellation")
  }
  key_input(app, typography, 58, 0)
  text_input(app, "write")
  key_input(app, typography, 13, 0)
  if app.prompt_state.panel != Panel.None || buffer.dirty(app.documents.current) {
    #panic("save workflow")
  }
  key_input(app, typography, 47, 0)
  text_input(app, "second")
  key_input(app, typography, 13, 0)
  if app.documents.current.anchor != 13 || app.documents.current.cursor != 19 {
    #panic("search workflow")
  }
  key_input(app, typography, 112, 64)
  text_input(app, "wide")
  key_input(app, typography, 13, 0)
  if app.view.popup_width != 0.86 || app.documents.current.anchor != 13 {
    #panic("palette layout preserves selection")
  }
  action(app, typography, 8)
  layout_storage: [4096]u8 = []
  layout_path := joined(app, "test.dna-layout", layout_storage[..])
  text_input(app, layout_path)
  key_input(app, typography, 13, 0)
  if app.prompt_state.panel != Panel.None || typography.points != 22.0 || app.view.popup_width != 0.8 || !app.view.reduced_motion {
    #panic("layout file workflow")
  }
  key_input(app, typography, 101, 64)
  action(app, typography, 18)
  text_input(app, "created.txt")
  key_input(app, typography, 13, 0)
  if app.prompt_state.panel != Panel.Directory {
    #panic("create workflow")
  }
  target: usize = 0
  for target < app.directory_state.count && !buffer.equal(app.directory_state.entries[target].name[..app.directory_state.entries[target].length], "created.txt") {
    target += 1
  }
  if target == app.directory_state.count {
    #panic("created entry missing")
  }
  app.directory_state.selected = target
  action(app, typography, 19)
  // The prompt starts from the current name.
  app.prompt_state.length = 0
  text_input(app, "renamed.txt")
  key_input(app, typography, 13, 0)
  if app.prompt_state.panel != Panel.Directory {
    #panic("rename workflow")
  }
  renamed: usize = 0
  for renamed < app.directory_state.count && !buffer.equal(app.directory_state.entries[renamed].name[..app.directory_state.entries[renamed].length], "renamed.txt") {
    renamed += 1
  }
  if renamed == app.directory_state.count {
    #panic("renamed entry missing")
  }
  app.directory_state.selected = renamed
  action(app, typography, 20)
  if app.prompt_state.panel != Panel.Trash {
    #panic("trash confirmation")
  }
  key_input(app, typography, 27, 0)
  action(app, typography, 7)
  app.directory_state.selected = renamed
  action(app, typography, 20)
  key_input(app, typography, 13, 0)
  if app.prompt_state.panel != Panel.Directory {
    #panic("trash workflow")
  }
  trash_storage: [4096]u8 = []
  trashed := joined(app, ".dna-trash/renamed.txt", trash_storage[..])
  if !files.metadata(trashed).ok {
    #panic("recoverable trash missing")
  }
  app.prompt_state.panel = Panel.None
  // Layout/zoom must produce real multiline font geometry.
  if !ttf.set(typography.document, &app.documents.current.bytes[0], app.documents.current.length) {
    #panic("smoke text")
  }
  width: i32 = 0
  height: i32 = 0
  if !ttf.size(typography.document, &width, &height) || #cast(f32) height < typography.line * 2.0 {
    #panic("multiline geometry")
  }
  typography.points = 30.0
  resize_font(typography)
  larger: i32 = 0
  if !ttf.size(typography.document, &width, &larger) || larger <= height {
    #panic("font zoom")
  }
  typography.points = 20.0
  resize_font(typography)
}
fn whitespace_smoke(app: *App, typography: *Typography) {
  doc := app.documents.current
  _ = buffer.load(doc, "a")
  app.view.insert = true
  buffer.move_to(doc, 1, false)
  text_input(app, " ")
  if !ttf.set(typography.document, &doc.bytes[0], doc.length) {
    #panic("space text update")
  }
  first := ttf.Substring{}
  if !ttf.substring(typography.document, #cast(i32) doc.cursor, &first) {
    #panic("space cursor")
  }
  text_input(app, " ")
  if !ttf.set(typography.document, &doc.bytes[0], doc.length) {
    #panic("second space update")
  }
  second := ttf.Substring{}
  if !ttf.substring(typography.document, #cast(i32) doc.cursor, &second) || second.x <= first.x {
    #panic("trailing space must advance cursor")
  }
  text_input(app, "\n    ")
  if !ttf.set(typography.document, &doc.bytes[0], doc.length) {
    #panic("indent text update")
  }
  indent := ttf.Substring{}
  space := ttf.Substring{}
  if !ttf.substring(typography.document, #cast(i32) doc.cursor, &indent) || indent.x <= 0 || indent.y <= second.y {
    #panic("indentation must advance cursor")
  }
  if !ttf.substring(typography.document, #cast(i32) doc.cursor - 1, &space) || space.width <= 0 {
    #panic("selected trailing space must have width")
  }
  if !buffer.equal(doc.bytes[..doc.length], "a  \n    ") {
    #panic("spaces must remain in document")
  }
  _ = buffer.load(doc, "")
  app.view.insert = false
}
fn session_smoke(app: *App, typography: *Typography) {
  original := app.documents.active
  original_doc := app.documents.current
  buffer.move_to(original_doc, 2, false)
  app.view.scroll_y = 30.0
  _ = buffer.replace(original_doc, "first edit")
  buffer.checkpoint(original_doc)
  key_input(app, typography, 58, 0)
  text_input(app, "enew")
  key_input(app, typography, 13, 0)
  if app.documents.current == original_doc || app.documents.count != 2 {
    #panic("new buffer must retain old document")
  }
  second := app.documents.active
  _ = buffer.replace(app.documents.current, "second edit")
  buffer.checkpoint(app.documents.current)
  key_input(app, typography, 32, 0)
  key_input(app, typography, 112, 0)
  if app.documents.active != original || app.view.scroll_y != 30.0 || !buffer.dirty(app.documents.current) {
    #panic("buffer view restoration")
  }
  buffer.undo(app.documents.current)
  if buffer.dirty(app.documents.current) {
    #panic("independent undo")
  }
  activate(app, second)
  if !buffer.equal(app.documents.current.bytes[..app.documents.current.length], "second edit") {
    #panic("other buffer edits retained")
  }
  key_input(app, typography, 32, 0)
  key_input(app, typography, 99, 0)
  if app.prompt_state.panel != Panel.Quit || !app.documents.closing_one {
    #panic("dirty close confirmation")
  }
  key_input(app, typography, 27, 0)
  if app.documents.count != 2 {
    #panic("close cancellation")
  }
  action(app, typography, 24)
  key_input(app, typography, 100, 0)
  if app.documents.count != 1 || app.documents.active != original {
    #panic("close only selected buffer")
  }
  // Quit must discover edits in an inactive buffer.
  _ = buffer.replace(app.documents.current, "unsaved")
  _ = new_buffer(app)
  request_quit(app)
  if app.prompt_state.panel != Panel.Quit || app.documents.active != original || !app.running {
    #panic("hidden dirty buffer quit")
  }
  key_input(app, typography, 27, 0)
  _ = buffer.load(app.documents.current, app.documents.current.saved[..app.documents.current.saved_length])
  next_buffer(app, false)
  close_clean(app)
  app.view.scroll_y = 0.0
  app.view.insert = false
  app.view.extend = false
  // Palette toggles remain accessible without control modifiers.
  key_input(app, typography, 59, 1)
  text_input(app, "toggle status line")
  key_input(app, typography, 13, 0)
  if app.view.status_line {
    #panic("status toggle")
  }
  action(app, typography, 26)
}
fn completion_smoke(app: *App, typography: *Typography) {
  storage: [4096]u8 = []
  directory := host.environment("DNA_WORKFLOW_TEST", storage[..])
  if !directory.ok || !directory.found {
    return
  }
  old := app.documents.active
  before := app.documents.count
  key_input(app, typography, 32, 0)
  key_input(app, typography, 102, 0)
  if app.prompt_state.panel != Panel.Open {
    #panic("leader open")
  }
  text_input(app, directory.value)
  text_input(app, "/sub")
  picker_wait_smoke(app)
  if app.completion.count != 1 || app.completion.entries[0].directory || !buffer.equal(app.completion.entries[0].name[..app.completion.entries[0].length], "subdir/other.txt") {
    #panic("flat file suggestions")
  }
  key_input(app, typography, 9, 0)
  if !contains(app.prompt_state.text[..app.prompt_state.length], "subdir/other.txt") {
    #panic("Tab file completion")
  }
  key_input(app, typography, 13, 0)
  if app.prompt_state.panel != Panel.None || !buffer.equal(app.documents.current.bytes[..app.documents.current.length], "other file\n") || app.documents.count != before + 1 {
    #panic("file completion and new buffer")
  }
  open_file(app, files.name(app.documents.file))
  if app.documents.count != before + 1 {
    #panic("duplicate open buffer")
  }
  key_input(app, typography, 32, 0)
  key_input(app, typography, 98, 0)
  text_input(app, "input.txt")
  key_input(app, typography, 13, 0)
  if app.documents.active != old {
    #panic("filtered buffer switcher")
  }
  next_buffer(app, false)
  close_clean(app)
  app.view.insert = false
  app.prompt_state.panel = Panel.None
  untouched := app.documents.current.length
  original_cursor := app.documents.current.cursor
  key_input(app, typography, 32, 0)
  key_input(app, typography, 111, 0)
  if app.prompt_state.panel != Panel.Leader || app.documents.current.length != untouched || app.documents.current.cursor != original_cursor {
    #panic("Space o must be unbound")
  }
  key_input(app, typography, 27, 0)
  // The goto menu is non-mutating until a destination is selected.
  buffer.move_to(app.documents.current, 3, false)
  app.view.insert = false
  app.prompt_state.panel = Panel.None
  key_input(app, typography, 103, 0)
  if app.prompt_state.panel != Panel.Goto || app.documents.current.cursor != 3 {
    #panic("goto menu must not jump immediately")
  }
  key_input(app, typography, 27, 0)
  if app.prompt_state.panel != Panel.None || app.documents.current.cursor != 3 {
    #panic("goto cancel")
  }
  key_input(app, typography, 103, 0)
  key_input(app, typography, 103, 0)
  if app.prompt_state.panel != Panel.None || app.documents.current.cursor != 0 {
    #panic("gg first line")
  }
  key_input(app, typography, 103, 0)
  key_input(app, typography, 101, 0)
  if app.documents.current.cursor != app.documents.current.length {
    #panic("ge end")
  }
  // Pickers live on Space b / Space f; g b and g f follow Helix (screen
  // bottom, file under cursor).
  key_input(app, typography, 32, 0)
  key_input(app, typography, 98, 0)
  if app.prompt_state.panel != Panel.Buffers {
    #panic("space buffer picker")
  }
  text_input(app, "no-such-buffer")
  key_input(app, typography, 13, 0)
  if app.prompt_state.panel != Panel.Buffers {
    #panic("empty buffer result")
  }
  key_input(app, typography, 27, 0)
  key_input(app, typography, 32, 0)
  key_input(app, typography, 102, 0)
  if app.prompt_state.panel != Panel.Open {
    #panic("space file picker")
  }
  text_input(app, directory.value)
  text_input(app, "/oth")
  picker_wait_smoke(app)
  if app.completion.count != 1 || app.completion.entries[0].directory {
    #panic("recursive filename query")
  }
  app.completion.chosen = true
  picker_index_submit(app)
  picker_wait_smoke(app)
  if app.completion.count != 1 || !app.completion.chosen || app.completion.selected != 0 {
    #panic("picker background refresh selection")
  }
  visited := app.picker_state.index.visited
  text_input(app, "r")
  if app.completion.count != 1 || app.picker_state.index.visited != visited {
    #panic("fuzzy picker query cache")
  }
  key_input(app, typography, 27, 0)
  expanded: [4096]u8 = []
  home: [4096]u8 = []
  env := host.environment("HOME", home[..])
  result := expand_home("~/", expanded[..])
  if env.ok && env.found && (#len(result) != #len(env.value) + 1 || !buffer.equal(result[..#len(env.value)], env.value)) {
    #panic("home expansion")
  }
}
fn explorer_smoke(app: *App, typography: *Typography) {
  configured_storage: [4096]u8 = []
  configured := host.environment("DNA_WORKFLOW_TEST", configured_storage[..])
  if !configured.ok || !configured.found {
    return
  }
  root: [4096]u8 = []
  root_length := copy_text(root[..], configured.value)
  add_text(root[..], &root_length, "/explorer")
  app.directory_state.length = copy_text(app.directory_state.path[..], root[..root_length])
  app.prompt_state.panel = Panel.Directory
  directory_refresh(app)
  doc := app.explorer.document
  if doc == nil {
    #panic("editable explorer allocation")
  }
  app.config.explorer_columns = true
  app.config.explorer_preview = true
  app.config.explorer_icons = true
  explorer_context_reset(app)
  if !app.directory_state.entries[0].directory || app.explorer.context.parent_selected >= app.explorer.context.parent_count {
    #panic("explorer directories first and parent context")
  }
  if !buffer.find(doc, "keep/", false) {
    #panic("directory navigation fixture")
  }
  buffer.move_to(doc, buffer.start(doc), false)
  explorer_context_preview(app)
  if !app.explorer.context.preview_directory || app.explorer.context.child_count != 1 {
    #panic("directory preview")
  }
  key_input(app, typography, 13, 0)
  if !contains(app.directory_state.path[..app.directory_state.length], "/keep") {
    #panic("explorer Enter directory")
  }
  key_input(app, typography, 8, 0)
  if !buffer.equal(app.directory_state.path[..app.directory_state.length], root[..root_length]) || buffer.row_id(doc, doc.cursor) != app.directory_state.selected + 1 || !buffer.equal(app.directory_state.entries[app.directory_state.selected].name[..app.directory_state.entries[app.directory_state.selected].length], "keep") {
    #panic("explorer parent restores selected child")
  }
  if !buffer.find(doc, "alpha.txt", false) {
    #panic("file preview fixture")
  }
  buffer.move_to(doc, buffer.start(doc), false)
  explorer_context_preview(app)
  if app.explorer.context.preview_directory || !contains(app.explorer.context.preview[..app.explorer.context.preview_length], "alpha contents") {
    #panic("file preview")
  }
  old_position := doc.cursor
  key_input(app, typography, 108, 0)
  key_input(app, typography, 108, 0)
  if !buffer.equal(app.directory_state.path[..app.directory_state.length], root[..root_length]) || doc.cursor <= old_position {
    #panic("Helix l must edit filenames")
  }
  key_input(app, typography, 104, 0)
  if app.prompt_state.panel != Panel.Directory || !buffer.equal(app.directory_state.path[..app.directory_state.length], root[..root_length]) {
    #panic("Helix h must not navigate parent")
  }

  opened_storage: [4096]u8 = []
  opened_path := joined(app, "alpha.txt", opened_storage[..])
  open_file(app, opened_path)
  explorer_open(app)
  original_length := doc.length
  key_input(app, typography, 32, 0)
  key_input(app, typography, 111, 0)
  if app.prompt_state.panel != Panel.Leader || !app.input_state.leader_explorer || doc.length != original_length || buffer.dirty(doc) {
    #panic("explorer Space o must not insert a line")
  }
  key_input(app, typography, 27, 0)
  if app.prompt_state.panel != Panel.Directory {
    #panic("explorer Space escape")
  }
  file_buffers := app.documents.count
  file_document := app.documents.current
  key_input(app, typography, 32, 0)
  key_input(app, typography, 99, 0)
  if app.prompt_state.panel != Panel.None || app.documents.count != file_buffers || app.documents.current != file_document {
    #panic("explorer menu must not close the file underneath")
  }
  explorer_open(app)
  selected_before := doc.cursor
  key_input(app, typography, 103, 0)
  if app.prompt_state.panel != Panel.Goto || !app.input_state.goto_explorer {
    #panic("explorer goto menu")
  }
  key_input(app, typography, 27, 0)
  if app.prompt_state.panel != Panel.Directory || doc.cursor != selected_before {
    #panic("explorer goto cancel")
  }
  // Rename using the real insert-mode path; the row id remains unchanged.
  if !buffer.find(doc, "alpha.txt", false) {
    #panic("explorer fixture")
  }
  key_input(app, typography, 99, 0)
  text_input(app, "renamed.txt")
  key_input(app, typography, 27, 0)
  if !explorer_dirty(app) || app.prompt_state.panel != Panel.Directory || app.explorer.insert {
    #panic("explorer insert mode")
  }
  key_input(app, typography, 117, 0)
  if explorer_dirty(app) {
    #panic("explorer undo")
  }
  key_input(app, typography, 117, 1)
  if !explorer_dirty(app) {
    #panic("explorer redo")
  }
  // New rows create files; deleted existing rows go to trash.
  buffer.move_to(doc, doc.length, false)
  key_input(app, typography, 105, 0)
  text_input(app, "created.txt\n")
  key_input(app, typography, 27, 0)
  if !buffer.find(doc, "delete.txt", false) {
    #panic("trash fixture")
  }
  key_input(app, typography, 120, 0)
  key_input(app, typography, 100, 0)
  key_input(app, typography, 27, 0)
  if app.prompt_state.panel != Panel.None || !explorer_dirty(app) {
    #panic("dismiss keeps draft")
  }
  action(app, typography, 7)
  if !explorer_dirty(app) || app.prompt_state.panel != Panel.Directory {
    #panic("reopen keeps draft")
  }
  key_input(app, typography, 58, 0)
  text_input(app, "write")
  key_input(app, typography, 13, 0)
  if app.prompt_state.panel != Panel.DirectoryApply || app.explorer.edit_count != 3 {
    #panic("directory plan preview")
  }
  existing_storage: [4096]u8 = []
  existing := joined(app, "alpha.txt", existing_storage[..])
  created_storage: [4096]u8 = []
  created := joined(app, "created.txt", created_storage[..])
  if !files.metadata(existing).ok || files.metadata(created).ok {
    #panic("preview mutated disk")
  }
  key_input(app, typography, 27, 0)
  if app.prompt_state.panel != Panel.Directory || !explorer_dirty(app) {
    #panic("cancel preview keeps edits")
  }
  explorer_preview(app)
  key_input(app, typography, 13, 0)
  if app.prompt_state.panel != Panel.Directory || explorer_dirty(app) || files.metadata(existing).ok || !files.metadata(created).ok {
    #panic("apply staged explorer edits")
  }
  if !buffer.equal(app.documents.current.bytes[..app.documents.current.length], "alpha contents") || !contains(files.name(app.documents.file), "/renamed.txt") {
    #panic("rename must update open buffer path")
  }
  close_clean(app)
  app.prompt_state.panel = Panel.Directory
  // Directory deletion stages a recoverable move, including nonempty children.
  child_storage: [4096]u8 = []
  child_path := joined(app, "keep/child.txt", child_storage[..])
  open_file(app, child_path)
  buffer.checkpoint(app.documents.current)
  _ = buffer.replace(app.documents.current, "unsaved")
  buffer.checkpoint(app.documents.current)
  app.prompt_state.panel = Panel.Directory
  if !buffer.find(doc, "keep/", false) {
    #panic("directory row fixture")
  }
  buffer.select_line(doc)
  _ = buffer.replace(doc, "")
  explorer_preview(app)
  if app.prompt_state.panel != Panel.Message {
    #panic("directory deletion must protect dirty child")
  }
  buffer.undo(app.documents.current)
  explorer_preview(app)
  if app.prompt_state.panel != Panel.DirectoryApply || !files.metadata(child_path).ok {
    #panic("directory trash preview")
  }
  key_input(app, typography, 27, 0)
  if !files.metadata(child_path).ok || !explorer_dirty(app) {
    #panic("directory trash cancel")
  }
  explorer_preview(app)
  key_input(app, typography, 13, 0)
  if app.prompt_state.panel != Panel.Directory || files.metadata(child_path).ok || !contains(files.name(app.documents.file), "/.dna-trash/keep/child.txt") {
    #panic("directory trash apply and child path")
  }
  close_clean(app)
  app.prompt_state.panel = Panel.Directory
  // Duplicate destinations fail; bracket-prefixed names are ordinary filenames.
  buffer.move_to(doc, doc.length, false)
  _ = buffer.replace(doc, "created.txt\n")
  if #len(explorer_plan(app)) == 0 {
    #panic("duplicate destination accepted")
  }
  explorer_load(app)
  buffer.move_to(doc, doc.length, false)
  _ = buffer.replace(doc, "[1] extra.txt\n")
  if #len(explorer_plan(app)) != 0 || app.explorer.edit_count != 1 {
    #panic("literal bracket filename rejected")
  }
  explorer_load(app)
  // New trailing-slash rows stage directories, sharing the filename namespace.
  buffer.move_to(doc, doc.length, false)
  _ = buffer.replace(doc, "new-folder/\n")
  explorer_preview(app)
  if app.prompt_state.panel != Panel.DirectoryApply || app.explorer.edit_count != 1 || app.explorer.edits[0].kind != FileAction.CreateDirectory {
    #panic("folder creation preview")
  }
  folder_storage: [4096]u8 = []
  folder_path := joined(app, "new-folder", folder_storage[..])
  if files.metadata(folder_path).ok {
    #panic("folder created before confirmation")
  }
  key_input(app, typography, 27, 0)
  if !explorer_dirty(app) || files.metadata(folder_path).ok {
    #panic("folder preview cancellation")
  }
  explorer_preview(app)
  explorer_apply(app)
  folder_info := files.metadata(folder_path)
  if !folder_info.ok || (folder_info.mode & 61440) != 16384 || explorer_dirty(app) {
    #panic("folder creation apply")
  }
  buffer.move_to(doc, doc.length, false)
  _ = buffer.replace(doc, "new-folder\n")
  if #len(explorer_plan(app)) == 0 {
    #panic("file folder duplicate accepted")
  }
  explorer_load(app)
  buffer.move_to(doc, doc.length, false)
  _ = buffer.replace(doc, "nested/child/\n")
  if #len(explorer_plan(app)) == 0 {
    #panic("nested folder path accepted")
  }
  explorer_load(app)
  // External collision after preview is rechecked on Enter.
  buffer.move_to(doc, doc.length, false)
  _ = buffer.replace(doc, "collision.txt\n")
  explorer_preview(app)
  if app.prompt_state.panel != Panel.DirectoryApply {
    #panic("collision preview")
  }
  collision_storage: [4096]u8 = []
  collision := joined(app, "collision.txt", collision_storage[..])
  if !fs.write_all(collision, "external").ok {
    #panic("collision fixture write")
  }
  explorer_apply(app)
  if app.prompt_state.panel != Panel.Message || !explorer_dirty(app) {
    #panic("external collision not refused")
  }
  app.explorer.quit_after_discard = false
  app.prompt_state.panel = Panel.DirectoryDiscard
  key_input(app, typography, 100, 0)
  // Source identity is rechecked after the preview, not just destination names.
  if !buffer.find(doc, "renamed.txt", false) {
    #panic("renamed row")
  }
  _ = buffer.replace(doc, "moved.txt")
  explorer_preview(app)
  if app.prompt_state.panel != Panel.DirectoryApply {
    #panic("source change preview")
  }
  renamed_storage: [4096]u8 = []
  renamed := joined(app, "renamed.txt", renamed_storage[..])
  backup_storage: [4096]u8 = []
  backup := joined(app, "external-backup.txt", backup_storage[..])
  if !fs.rename(renamed, backup).ok || !fs.write_all(renamed, "external replacement").ok {
    #panic("external replacement fixture")
  }
  explorer_apply(app)
  if app.prompt_state.panel != Panel.Message {
    #panic("changed source accepted")
  }
  if !fs.remove(renamed).ok || !fs.rename(backup, renamed).ok {
    #panic("restore external fixture")
  }
  app.explorer.quit_after_discard = false
  app.prompt_state.panel = Panel.DirectoryDiscard
  key_input(app, typography, 100, 0)
  // Unsaved affected documents, including a separately opened file, block apply.
  open_file(app, renamed)
  _ = buffer.replace(app.documents.current, "unsaved")
  if !buffer.find(doc, "renamed.txt", false) {
    #panic("dirty affected row")
  }
  _ = buffer.replace(doc, "moved.txt")
  explorer_preview(app)
  if app.prompt_state.panel != Panel.Message {
    #panic("affected unsaved buffer accepted")
  }
  buffer.undo(app.documents.current)
  close_clean(app)
  app.explorer.quit_after_discard = false
  app.prompt_state.panel = Panel.DirectoryDiscard
  key_input(app, typography, 100, 0)
  buffer.move_to(doc, doc.length, false)
  key_input(app, typography, 13, 0)
  if app.prompt_state.panel != Panel.Directory {
    #panic("empty explorer row navigation")
  }
  // Directory write commands cannot accidentally save the file underneath.
  if !buffer.find(doc, "created.txt", false) {
    #panic("created row")
  }
  _ = buffer.replace(doc, "another.txt")
  key_input(app, typography, 58, 0)
  text_input(app, "w ")
  text_input(app, configured.value)
  text_input(app, "/accidental.txt")
  key_input(app, typography, 13, 0)
  if app.prompt_state.panel != Panel.Message {
    #panic("explorer write path escaped context")
  }
  request_quit(app)
  if app.prompt_state.panel != Panel.DirectoryDiscard || !app.running {
    #panic("quit loses staged directory edits")
  }
  key_input(app, typography, 27, 0)
  if !explorer_dirty(app) {
    #panic("quit cancellation lost draft")
  }
  app.explorer.quit_after_discard = false
  app.prompt_state.panel = Panel.DirectoryDiscard
  key_input(app, typography, 100, 0)
  app.prompt_state.panel = Panel.None
}
fn palette_smoke(app: *App) {
  panel(app, Panel.Commands)
  text_input(app, "write")
  matches(app)
  before := app.command_menu.filter_runs
  matches(app)
  matches(app)
  if app.command_menu.filter_runs != before || app.prompt_state.match_count == 0 || app.prompt_state.matches[0] != 1 {
    #panic("palette query cache or ranking")
  }
  text_input(app, " explorer")
  matches(app)
  // "write " starts path suggestions; the matching command still shows.
  explorer_write := false
  for index in 0..app.prompt_state.match_count {
    explorer_write = explorer_write || app.prompt_state.matches[index] == 29
  }
  if app.command_menu.filter_runs != before + 1 || !explorer_write {
    #panic("palette cache invalidation")
  }
  app.prompt_state.length = copy_text(app.prompt_state.text[..], "write")
  app.explorer.commands = true
  matches(app)
  if app.prompt_state.match_count != 1 || app.prompt_state.matches[0] != 29 {
    #panic("explorer command context")
  }
  app.explorer.commands = false
  matches(app)
  if app.prompt_state.matches[0] != 1 {
    #panic("file command context restoration")
  }
  app.prompt_state.panel = Panel.None
}

fn viewport_smoke(renderer: rawptr, window: rawptr, app: *App, typography: *Typography) {
  original := app.documents.active
  if !new_buffer(app) {
    #panic("viewport buffer")
  }
  text: [8192]u8 = []
  used: usize = 0
  row: usize = 0
  for row < 200 {
    add_text(text[..], &used, "aé中  \n")
    row += 1
  }
  add_text(text[..], &used, "endé ")
  doc := app.documents.current
  _ = buffer.load(doc, text[..used])
  // Selecting the entire document while at EOF only shapes/draws visible text.
  doc.anchor = 0
  doc.cursor = doc.length
  app.view.extend = true
  draw(renderer, window, app, typography)
  if typography.document_start == 0 || typography.document_end != doc.length {
    #panic("EOF viewport bounds")
  }
  caret := ttf.Substring{}
  if !layout_substring(typography.layout, doc, doc.cursor, &caret) || caret.x <= 0 {
    #panic("viewport UTF8 cursor")
  }
  // Shrinking and growing the window keeps the caret's line in view.
  window_width: i32 = 0
  window_height: i32 = 0
  if !sdl.window_size(window, &window_width, &window_height) {
    #panic("window size")
  }
  heights: [3]i32 = [window_height / 4, window_height * 2, window_height]
  outputs: [3]i32 = []
  for step in 0..3 {
    wanted := heights[step]
    if !sdl.set_window_size(window, window_width, wanted) {
      #panic("window resize")
    }
    output_width: i32 = 0
    output_height: i32 = 0
    _ = sdl.size(renderer, &output_width, &output_height)
    outputs[step] = output_height
    draw(renderer, window, app, typography)
    caret_top := #cast(f32) (line_at(doc, doc.cursor) - 1) * typography.line
    if typography.document_end != doc.length || caret_top < app.view.scroll_y || caret_top + typography.line > app.view.scroll_y + #cast(f32) output_height {
      #panic("resized window must keep the caret line visible")
    }
  }
  if outputs[0] >= outputs[2] || outputs[1] <= outputs[2] {
    #panic("window resize must change the drawable size")
  }
  // Zoom changes the viewport and must retain the end-of-line cursor geometry.
  previous_points := typography.points
  typography.points = 30.5
  resize_font(typography)
  draw(renderer, window, app, typography)
  if typography.document_start > doc.cursor || typography.document_end != doc.length {
    #panic("zoom viewport bounds")
  }
  typography.points = previous_points
  resize_font(typography)
  buffer.move_to(doc, 0, false)
  app.view.extend = false
  draw(renderer, window, app, typography)
  if typography.document_start != 0 || typography.document_end >= doc.length || app.view.scroll_y != 0.0 {
    #panic("return to first viewport")
  }
  // A newline at EOF and then an empty document must both keep a valid cursor.
  _ = buffer.load(doc, "aé\n")
  buffer.move_to(doc, doc.length, false)
  draw(renderer, window, app, typography)
  _ = buffer.load(doc, "")
  draw(renderer, window, app, typography)
  close_clean(app)
  activate(app, original)
}

fn picker_render_smoke(renderer: rawptr, window: rawptr, app: *App, typography: *Typography) {
  app.view.insert = false
  app.prompt_state.panel = Panel.None
  app.view.reduced_motion = true
  key_input(app, typography, 32, 0)
  draw(renderer, window, app, typography)
  key_input(app, typography, 27, 0)
  key_input(app, typography, 103, 0)
  draw(renderer, window, app, typography)
  key_input(app, typography, 102, 0)
  text_input(app, "src")
  draw(renderer, window, app, typography)
  key_input(app, typography, 27, 0)
  key_input(app, typography, 103, 0)
  key_input(app, typography, 98, 0)
  draw(renderer, window, app, typography)
  key_input(app, typography, 27, 0)
}

fn editing_smoke(renderer: rawptr, window: rawptr, app: *App, typography: *Typography) {
  original := app.documents.active
  if !new_buffer(app) {
    #panic("editing fixture")
  }
  doc := app.documents.current
  _ = buffer.load(doc, "one two, aé中\nlast\n")
  app.view.insert = false
  app.view.extend = false
  key_input(app, typography, 119, 0)
  if doc.anchor != 0 || doc.cursor != 4 {
    #panic("word selection")
  }
  key_input(app, typography, 59, 256)
  if doc.cursor != 0 || doc.anchor != 4 {
    #panic("swap selection ends")
  }
  key_input(app, typography, 59, 256)
  key_input(app, typography, 118, 0)
  key_input(app, typography, 101, 0)
  if doc.anchor != 0 || doc.cursor != 7 {
    #panic("extend word selection")
  }
  key_input(app, typography, 27, 0)
  buffer.move_to(doc, 0, false)
  key_input(app, typography, 51, 0)
  key_input(app, typography, 119, 0)
  if doc.anchor != 0 || doc.cursor != 9 {
    #panic("counted words")
  }
  key_input(app, typography, 99, 0)
  text_input(app, "new ")
  key_input(app, typography, 27, 0)
  if !buffer.equal(doc.bytes[..doc.length], "new aé中\nlast\n") {
    #panic("change words")
  }
  key_input(app, typography, 117, 0)
  if !buffer.equal(doc.bytes[..doc.length], "one two, aé中\nlast\n") {
    #panic("word undo")
  }
  buffer.move_to(doc, 0, false)
  key_input(app, typography, 32, 0)
  key_input(app, typography, 119, 0)
  if app.prompt_state.panel != Panel.Windows {
    #panic("window menu")
  }
  draw(renderer, window, app, typography)
  key_input(app, typography, 118, 0)
  left := app.view.panes[0].first
  right := app.view.focused
  if !app.view.panes[0].branch || left == right || app.documents.current != doc {
    #panic("vertical split")
  }
  buffer.move_to(doc, 9, false)
  pane_store(app)
  draw(renderer, window, app, typography)
  if app.view.panes[left].rect.x != 0 || app.view.panes[right].rect.x <= 0 {
    #panic("split geometry")
  }
  pane_direction(app, 104)
  if app.view.focused != left || doc.cursor != 0 {
    #panic("independent pane cursor")
  }
  key_input(app, typography, 105, 0)
  text_input(app, "X")
  key_input(app, typography, 27, 0)
  pane_direction(app, 108)
  if app.view.focused != right || doc.cursor != 10 || doc.bytes[0] != 88 {
    #panic("shared edit tracks other cursor")
  }
  pane_direction(app, 104)
  key_input(app, typography, 117, 0)
  pane_direction(app, 108)
  if doc.cursor != 9 || doc.bytes[0] != 111 {
    #panic("undo tracks other pane cursor")
  }
  pane_direction(app, 104)
  key_input(app, typography, 117, 1)
  pane_direction(app, 108)
  if doc.cursor != 10 || doc.bytes[0] != 88 {
    #panic("redo tracks other pane cursor")
  }
  pane_split(app, false)
  draw(renderer, window, app, typography)
  cached_updates := typography.document_updates
  draw(renderer, window, app, typography)
  if typography.document_updates != cached_updates {
    #panic("unchanged split layouts reshaped")
  }
  if app.view.panes[app.view.focused].rect.y <= 0 {
    #panic("horizontal split")
  }
  pane_close(app)
  pane_close(app)
  if app.view.focused != 0 || app.view.panes[0].branch || !buffer.dirty(doc) {
    #panic("close panes keeps dirty buffer")
  }
  // Mouse geometry uses the shaped text and preserves UTF-8 boundaries.
  _ = buffer.load(doc, "aé中 words\nnext\n")
  app.view.scroll_x = 0.0
  app.view.scroll_y = 0.0
  draw(renderer, window, app, typography)
  origin := app.config.document_padding * typography.scale
  if app.view.line_numbers {
    origin += typography.cell * 7.0
  }
  mouse_select(app, typography, origin, app.config.document_padding * typography.scale + typography.line * 0.5, false, false, 1)
  mouse_select(app, typography, origin + typography.cell * 4.0, app.config.document_padding * typography.scale + typography.line * 0.5, true, false, 1)
  if doc.anchor != 0 || doc.cursor == 0 || buffer.boundary(doc, doc.cursor) != doc.cursor {
    #panic("mouse UTF8 drag")
  }
  mouse_select(app, typography, origin + typography.cell, app.config.document_padding * typography.scale + typography.line * 0.5, false, false, 2)
  if !buffer.equal(doc.bytes[buffer.start(doc)..buffer.end(doc)], "aé中") {
    #panic("mouse word selection")
  }
  // Fill the bounded tree, reject a ninth view, then collapse safely.
  splits: usize = 0
  for splits < 7 {
    pane_split(app, splits % 2 == 0)
    splits += 1
  }
  draw(renderer, window, app, typography)
  pane_split(app, true)
  if app.prompt_state.panel != Panel.Message {
    #panic("pane limit")
  }
  pane_only(app)
  draw(renderer, window, app, typography)
  released: usize = 1
  for released < 15 {
    if typography.pane_text[released].text != nil || typography.pane_text[released].caret != nil {
      #panic("closed pane kept text layouts")
    }
    released += 1
  }
  if app.view.focused != 0 || app.view.panes[0].branch {
    #panic("only window")
  }
  pane_split(app, true)
  if !new_buffer(app) {
    #panic("second pane buffer")
  }
  other := app.documents.active
  _ = buffer.load(app.documents.current, "different buffer")
  draw(renderer, window, app, typography)
  pane_direction(app, 104)
  if app.documents.current != doc {
    #panic("picker-style activation isolated to pane")
  }
  close_clean(app)
  draw(renderer, window, app, typography)
  if app.documents.current == nil || app.documents.active != other {
    #panic("buffer close rebinds views")
  }
  pane_only(app)
  close_clean(app)
  activate(app, original)
}

fn bindings_smoke(app: *App, typography: *Typography) {
  original := app.documents.active
  if !new_buffer(app) {
    #panic("quit binding fixture")
  }
  hidden := app.documents.active
  _ = buffer.replace(app.documents.current, "keep my unsaved work")
  if !new_buffer(app) {
    #panic("quit target fixture")
  }
  total := app.documents.count
  key_input(app, typography, 58, 0)
  text_input(app, "quit")
  matches(app)
  if app.prompt_state.match_count == 0 || app.prompt_state.matches[0] != 24 {
    #panic("quit palette must describe buffer close")
  }
  key_input(app, typography, 13, 0)
  if !app.running || app.documents.count != total - 1 || app.prompt_state.panel != Panel.None {
    #panic("quit must close only current buffer")
  }
  activate(app, hidden)
  key_input(app, typography, 58, 0)
  text_input(app, "q")
  key_input(app, typography, 13, 0)
  if app.prompt_state.panel != Panel.Quit || !app.documents.closing_one {
    #panic("quit must protect current dirty buffer")
  }
  key_input(app, typography, 27, 0)
  if !buffer.equal(app.documents.current.bytes[..app.documents.current.length], "keep my unsaved work") {
    #panic("cancel quit keeps edits")
  }
  // Quitting one of two views must not discard their shared dirty document.
  shared := app.documents.current
  shared_slot := app.documents.active
  shared_total := app.documents.count
  buffer.move_to(shared, 3, false)
  pane_split(app, true)
  buffer.move_to(shared, 9, false)
  key_input(app, typography, 58, 0)
  text_input(app, "q")
  key_input(app, typography, 13, 0)
  if app.prompt_state.panel != Panel.None || app.view.focused != 0 || app.view.panes[0].branch {
    #panic("q closes active split only")
  }
  if app.documents.current != shared || app.documents.active != shared_slot || app.documents.count != shared_total || shared.cursor != 3 || !buffer.dirty(shared) {
    #panic("q preserves other view and shared edits")
  }
  doc := app.documents.current
  _ = buffer.load(doc, "one two three\nnext")
  key_input(app, typography, 118, 0)
  key_input(app, typography, 108, 0)
  if doc.anchor != 0 || doc.cursor != 2 {
    #panic("visual mode must include initial and next character")
  }
  key_input(app, typography, 27, 0)
  buffer.move_to(doc, 0, false)
  key_input(app, typography, 102, 0)
  text_input(app, "t")
  if doc.anchor != 0 || doc.cursor != 5 {
    #panic("find character binding")
  }
  key_input(app, typography, 114, 0)
  text_input(app, "é")
  if !buffer.equal(doc.bytes[..doc.length], "éééééwo three\nnext") {
    #panic("replace character binding")
  }
  key_input(app, typography, 117, 0)
  if !buffer.equal(doc.bytes[..doc.length], "one two three\nnext") {
    #panic("replace undo")
  }
  close_clean(app)
  activate(app, original)
}

fn multiple_selection_smoke(renderer: rawptr, window: rawptr, app: *App, typography: *Typography) {
  original := app.documents.active
  if !new_buffer(app) {
    #panic("multicursor fixture")
  }
  doc := app.documents.current
  _ = buffer.load(doc, "abc\ndef\nghi\n")
  app.view.insert = false
  app.view.extend = false
  key_input(app, typography, 120, 0)
  if !buffer.equal(doc.bytes[buffer.start(doc)..buffer.end(doc)], "abc\n") || buffer.head(doc) != 3 {
    #panic("x excludes next line character")
  }
  draw(renderer, window, app, typography)
  if app.view.animation.file.cursor_y.value != app.config.document_padding * typography.scale {
    #panic("x caret must stay on selected line")
  }
  key_input(app, typography, 120, 0)
  if !buffer.equal(doc.bytes[buffer.start(doc)..buffer.end(doc)], "abc\ndef\n") {
    #panic("repeat x extends one line")
  }
  _ = buffer.load(doc, "abc\ndef\nghi\n")
  key_input(app, typography, 118, 0)
  key_input(app, typography, 108, 0)
  if doc.anchor != 0 || doc.cursor != 2 {
    #panic("visual selection inclusive")
  }
  key_input(app, typography, 104, 0)
  key_input(app, typography, 104, 0)
  if doc.anchor != 0 || doc.cursor != 1 {
    #panic("visual clamps at BOF")
  }
  key_input(app, typography, 27, 0)
  if app.view.extend || doc.anchor != 0 || doc.cursor != 1 {
    #panic("escape keeps selection")
  }
  key_input(app, typography, 99, 1)
  key_input(app, typography, 99, 1)
  if doc.secondary.count != 2 || doc.anchor != 8 || doc.cursor != 9 {
    #panic("C adds two cursors")
  }
  draw(renderer, window, app, typography)
  key_input(app, typography, 99, 0)
  text_input(app, "é")
  key_input(app, typography, 27, 0)
  if !buffer.equal(doc.bytes[..doc.length], "ébc\néef\néhi\n") || doc.secondary.count != 2 {
    #panic("multicursor change")
  }
  key_input(app, typography, 117, 0)
  if !buffer.equal(doc.bytes[..doc.length], "abc\ndef\nghi\n") || doc.secondary.count != 2 {
    #panic("multicursor undo atomically")
  }
  key_input(app, typography, 117, 1)
  if !buffer.equal(doc.bytes[..doc.length], "ébc\néef\néhi\n") || doc.secondary.count != 2 {
    #panic("multicursor redo")
  }
  key_input(app, typography, 105, 0)
  text_input(app, "!")
  key_input(app, typography, 8, 0)
  key_input(app, typography, 27, 0)
  if !buffer.equal(doc.bytes[..doc.length], "ébc\néef\néhi\n") {
    #panic("multicursor typing and backspace")
  }
  pane_split(app, true)
  key_input(app, typography, 44, 0)
  pane_store(app)
  draw(renderer, window, app, typography)
  pane_direction(app, 104)
  if doc.secondary.count != 2 {
    #panic("pane owns multiple selections")
  }
  pane_direction(app, 108)
  if doc.secondary.count != 0 {
    #panic("comma retains only primary in current pane")
  }
  pane_only(app)
  close_clean(app)
  activate(app, original)
}

