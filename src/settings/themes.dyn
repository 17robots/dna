// Built-in colour themes. Each palette lists every role as #RRGGBB hex in
// color_key order: UI (border background surface line text muted selection
// cursor), syntax (comment string keyword function type constant), ANSI
// normal and bright, then diagnostic error and warning. Palettes follow the
// upstream themes.

pub const BuiltinThemeNames: []const u8 = "charcoal\nlight\ncatppuccin-mocha\ncatppuccin-latte\ngruvbox-dark\ngruvbox-light\nnord\ndracula\ntokyo-night\none-dark\nsolarized-dark\nsolarized-light\nrose-pine\nkanagawa\neverforest\nrose-pine-moon\nrose-pine-dawn\ngithub-dark\ngithub-light\nayu-dark\nayu-mirage\nayu-light\nmonokai\n"

pub fn builtin_palette(name: []const u8, result: *Palette) bool {
  result.* = Palette{}
  if buffer.equal(name, "charcoal") {
    return true
  }
  if buffer.equal(name, "light") {
    result.light = true
    return true
  }
  hex: []const u8 = ""
  if buffer.equal(name, "catppuccin-mocha") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "45475A 1E1E2E 181825 2A2B3C CDD6F4 6C7086 45475A F5E0DC | 9399B2 A6E3A1 CBA6F7 89B4FA F9E2AF FAB387 | 45475A F38BA8 A6E3A1 F9E2AF 89B4FA F5C2E7 94E2D5 BAC2DE | 585B70 F38BA8 A6E3A1 F9E2AF 89B4FA F5C2E7 94E2D5 A6ADC8 | F38BA8 F9E2AF"
  }
  else if buffer.equal(name, "catppuccin-latte") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "BCC0CC EFF1F5 E6E9EF E6E9EF 4C4F69 8C8FA1 CCD0DA DC8A78 | 7C7F93 40A02B 8839EF 1E66F5 DF8E1D FE640B | 5C5F77 D20F39 40A02B DF8E1D 1E66F5 EA76CB 179299 ACB0BE | 6C6F85 D20F39 40A02B DF8E1D 1E66F5 EA76CB 179299 BCC0CC | D20F39 DF8E1D"
    result.light = true
  }
  else if buffer.equal(name, "gruvbox-dark") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "504945 282828 32302F 3C3836 EBDBB2 7C6F64 504945 D5C4A1 | 928374 B8BB26 FB4934 8EC07C FABD2F D3869B | 282828 CC241D 98971A D79921 458588 B16286 689D6A A89984 | 928374 FB4934 B8BB26 FABD2F 83A598 D3869B 8EC07C EBDBB2 | FB4934 FABD2F"
  }
  else if buffer.equal(name, "gruvbox-light") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "D5C4A1 FBF1C7 F2E5BC EBDBB2 3C3836 928374 D5C4A1 504945 | 928374 79740E 9D0006 427B58 B57614 8F3F71 | FBF1C7 CC241D 98971A D79921 458588 B16286 689D6A 7C6F64 | 928374 9D0006 79740E B57614 076678 8F3F71 427B58 3C3836 | 9D0006 B57614"
    result.light = true
  }
  else if buffer.equal(name, "nord") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "4C566A 2E3440 3B4252 3B4252 D8DEE9 616E88 434C5E D8DEE9 | 616E88 A3BE8C 81A1C1 88C0D0 8FBCBB B48EAD | 3B4252 BF616A A3BE8C EBCB8B 81A1C1 B48EAD 88C0D0 E5E9F0 | 4C566A BF616A A3BE8C EBCB8B 81A1C1 B48EAD 8FBCBB ECEFF4 | BF616A EBCB8B"
  }
  else if buffer.equal(name, "dracula") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "44475A 282A36 21222C 343746 F8F8F2 6272A4 44475A F8F8F2 | 6272A4 F1FA8C FF79C6 50FA7B 8BE9FD BD93F9 | 21222C FF5555 50FA7B F1FA8C BD93F9 FF79C6 8BE9FD F8F8F2 | 6272A4 FF6E6E 69FF94 FFFFA5 D6ACFF FF92DF A4FFFF FFFFFF | FF5555 FFB86C"
  }
  else if buffer.equal(name, "tokyo-night") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "3B4261 1A1B26 16161E 292E42 C0CAF5 565F89 283457 C0CAF5 | 565F89 9ECE6A BB9AF7 7AA2F7 2AC3DE FF9E64 | 15161E F7768E 9ECE6A E0AF68 7AA2F7 BB9AF7 7DCFFF A9B1D6 | 414868 F7768E 9ECE6A E0AF68 7AA2F7 BB9AF7 7DCFFF C0CAF5 | DB4B4B E0AF68"
  }
  else if buffer.equal(name, "one-dark") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "3E4452 282C34 21252B 2C313C ABB2BF 5C6370 3E4451 528BFF | 5C6370 98C379 C678DD 61AFEF E5C07B D19A66 | 3F4451 E06C75 98C379 E5C07B 61AFEF C678DD 56B6C2 ABB2BF | 4F5666 FF7B86 B1E18B EFB074 67CDFF E48BFF 63D4E0 D7DAE0 | E06C75 E5C07B"
  }
  else if buffer.equal(name, "solarized-dark") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "586E75 002B36 073642 073642 839496 586E75 174652 93A1A1 | 586E75 2AA198 859900 268BD2 B58900 D33682 | 073642 DC322F 859900 B58900 268BD2 D33682 2AA198 EEE8D5 | 002B36 CB4B16 586E75 657B83 839496 6C71C4 93A1A1 FDF6E3 | DC322F B58900"
  }
  else if buffer.equal(name, "solarized-light") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "93A1A1 FDF6E3 EEE8D5 EEE8D5 657B83 93A1A1 DDD6C1 586E75 | 93A1A1 2AA198 859900 268BD2 B58900 D33682 | 073642 DC322F 859900 B58900 268BD2 D33682 2AA198 EEE8D5 | 002B36 CB4B16 586E75 657B83 839496 6C71C4 93A1A1 FDF6E3 | DC322F B58900"
    result.light = true
  }
  else if buffer.equal(name, "rose-pine") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "403D52 191724 1F1D2E 21202E E0DEF4 6E6A86 403D52 EBBCBA | 6E6A86 F6C177 31748F EBBCBA 9CCFD8 C4A7E7 | 26233A EB6F92 31748F F6C177 9CCFD8 C4A7E7 EBBCBA E0DEF4 | 6E6A86 EB6F92 31748F F6C177 9CCFD8 C4A7E7 EBBCBA E0DEF4 | EB6F92 F6C177"
  }
  else if buffer.equal(name, "kanagawa") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "54546D 1F1F28 16161D 2A2A37 DCD7BA 727169 2D4F67 C8C093 | 727169 98BB6C 957FB8 7E9CD8 7AA89F FFA066 | 16161D C34043 76946A C0A36E 7E9CD8 957FB8 6A9589 C8C093 | 727169 E82424 98BB6C E6C384 7FB4CA 938AA9 7AA89F DCD7BA | E82424 FF9E3B"
    result.italic = 5
    result.italic_set = true
  }
  else if buffer.equal(name, "everforest") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "475258 2D353B 232A2E 343F44 D3C6AA 7A8478 543A48 D3C6AA | 859289 A7C080 E67E80 7FBBB3 DBBC7F D699B6 | 475258 E67E80 A7C080 DBBC7F 7FBBB3 D699B6 83C092 D3C6AA | 859289 E67E80 A7C080 DBBC7F 7FBBB3 D699B6 83C092 D3C6AA | E67E80 DBBC7F"
  }
  else if buffer.equal(name, "rose-pine-moon") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "44415A 232136 2A273F 2A283E E0DEF4 6E6A86 44415A EA9A97 | 6E6A86 F6C177 3E8FB0 EA9A97 9CCFD8 C4A7E7 | 393552 EB6F92 3E8FB0 F6C177 9CCFD8 C4A7E7 EA9A97 E0DEF4 | 6E6A86 EB6F92 3E8FB0 F6C177 9CCFD8 C4A7E7 EA9A97 E0DEF4 | EB6F92 F6C177"
  }
  else if buffer.equal(name, "rose-pine-dawn") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "DFDAD9 FAF4ED FFFAF3 F4EDE8 575279 9893A5 DFDAD9 D7827E | 9893A5 EA9D34 286983 D7827E 56949F 907AA9 | F2E9E1 B4637A 286983 EA9D34 56949F 907AA9 D7827E 575279 | 9893A5 B4637A 286983 EA9D34 56949F 907AA9 D7827E 575279 | B4637A EA9D34"
    result.light = true
  }
  else if buffer.equal(name, "github-dark") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "30363D 0D1117 161B22 161B22 E6EDF3 6E7681 264F78 2F81F7 | 8B949E A5D6FF FF7B72 D2A8FF FFA657 79C0FF | 484F58 FF7B72 3FB950 D29922 58A6FF BC8CFF 39C5CF B1BAC4 | 6E7681 FFA198 56D364 E3B341 79C0FF D2A8FF 56D4DD FFFFFF | F85149 D29922"
  }
  else if buffer.equal(name, "github-light") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "D0D7DE FFFFFF F6F8FA F6F8FA 1F2328 8C959F CEE1F8 0969DA | 6E7781 0A3069 CF222E 8250DF 953800 0550AE | 24292F CF222E 116329 4D2D00 0969DA 8250DF 1B7C83 6E7781 | 57606A A40E26 1A7F37 633C01 218BFF A475F9 3192AA 8C959F | CF222E 9A6700"
    result.light = true
  }
  else if buffer.equal(name, "ayu-dark") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "1B1F29 0B0E14 0D1017 131721 BFBDB6 565B66 1A3550 E6B450 | 636A72 AAD94C FF8F40 FFB454 59C2FF D2A6FF | 11151C EA6C73 7FD962 F9AF4F 53BDFA CDA1FA 90E1C6 C7C7C7 | 686868 F07178 AAD94C FFB454 59C2FF D2A6FF 95E6CB FFFFFF | D95757 FFB454"
  }
  else if buffer.equal(name, "ayu-mirage") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "2D3443 1F2430 1C212B 242936 CCCAC2 707A8C 33415E FFCC66 | 6C7A8B D5FF80 FFAD66 FFD173 73D0FF DFBFFF | 171B24 ED8274 87D96C FACC6E 6DCBFA DABAFA 90E1C6 C7C7C7 | 686868 F28779 D5FF80 FFD173 73D0FF DFBFFF 95E6CB FFFFFF | FF6666 FFD173"
  }
  else if buffer.equal(name, "ayu-light") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "D9D8D7 FCFCFC F3F4F5 EEF0F2 5C6166 8A9199 D4E3F6 F29718 | 8A9199 86B300 FA8D3E F2AE49 399EE6 A37ACC | 000000 EA6C6D 6CBF43 ECA944 3199E1 9E75C7 46BA94 BABABA | 686868 F07171 86B300 F2AE49 399EE6 A37ACC 4CBF99 D1D1D1 | E65050 F2AE49"
    result.light = true
  }
  else if buffer.equal(name, "monokai") {
    // UI | syntax | ANSI | bright ANSI | error warning
    hex = "49483E 272822 1E1F1C 3E3D32 F8F8F2 90908A 49483E F8F8F0 | 75715E E6DB74 F92672 A6E22E 66D9EF AE81FF | 272822 F92672 A6E22E F4BF75 66D9EF AE81FF A1EFE4 F8F8F2 | 75715E F92672 A6E22E F4BF75 66D9EF AE81FF A1EFE4 F9F8F5 | F92672 FD971F"
  }
  else {
    return false
  }
  at: usize = 0
  for index in 0..32 {
    for hex[at] == 32 || hex[at] == 124 {
      at += 1
    }
    color: u32 = 0
    for digit in 0..6 {
      byte := hex[at + digit]
      if byte <= 57 {
        color = color * 16 + #cast(u32) (byte - 48)
      } else {
        color = color * 16 + #cast(u32) (byte - 55)
      }
    }
    result.colors[index] = color
    at += 6
  }
  result.mask = 4294967295
  return true
}
