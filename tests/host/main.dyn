use arena_owner "../../src/owned_arena"
use "../../src/host"
use "std/io"
use "std/mem"
use fs "../../src/filesystem"

fn equal(a: []const u8, b: []const u8) bool {
  if a.len != b.len { return false }
  for index in 0..a.len {
    if a[index] != b[index] { return false }
  }
  return true
}
fn env_fails(name: []const u8, dst: []u8) bool {
  _ = host.environment(name, dst) catch { return true }
  return false
}
fn env_not_found(name: []const u8, dst: []u8) bool {
  _ = host.environment(name, dst) catch err {
    case err {
      .NotFound => { return true }
      _ => { return false }
    }
  }
  return false
}
fn main() {
  value: [128]u8
  environment := host.environment("DNA_HOST_TEST", value[..]) catch {
    #panic("environment Unicode")
  }
  if !equal(environment, "value café 日本語") {
    #panic("environment Unicode")
  }
  if !env_not_found("DNA_HOST_MISSING_7ab218", value[..]) {
    #panic("missing environment")
  }
  empty := host.environment("DNA_HOST_EMPTY", value[..]) catch {
    #panic("empty environment")
  }
  if empty.len != 0 {
    #panic("empty environment")
  }
  if !env_fails("DNA_HOST_TEST", value[..1]) {
    #panic("short environment destination")
  }
  if !env_fails("bad=name", value[..]) || !env_fails("bad\0name", value[..]) {
    #panic("invalid environment name")
  }
  allocated := arena_owner.create((8192))
  defer arena_owner.release(allocated)
  arguments := host.arguments(allocated) catch {
    #panic("argument count")
  }
  if arguments.len != 4 {
    #panic("argument count")
  }
  if !equal(arguments[1], "argument café 日本語") || arguments[2].len != 0 || !equal(arguments[3], "with space") {
    #panic("argument bytes")
  }
  _ = fs.metadata(".") catch {
    #panic("host and filesystem integration")
  }

  original: [4096]u8
  length := host.current_directory(original[..])
  if length == 0 || original[length] != 0 {
    #panic("current directory")
  }
  tiny: [1]u8
  if host.current_directory(tiny[..]) != 0 {
    #panic("short current directory buffer")
  }
  if host.change_directory("") || host.change_directory("invalid\0path") {
    #panic("invalid directory accepted")
  }
  if host.change_directory("dna-directory-that-does-not-exist-7ab218") {
    #panic("missing directory accepted")
  }
  if !host.change_directory("..") || !host.change_directory(original[..length]) {
    #panic("change directory and restore")
  }
  restored: [4096]u8
  if host.current_directory(restored[..]) != length {
    #panic("directory length changed")
  }
  for index in 0..length {
    if original[index] != restored[index] {
      #panic("directory changed")
    }
  }
  if host.process_id() == 0 {
    #panic("process id")
  }
  host.small_pages(tiny[..0])
  host.write_error("host stderr probe\n")
  io.println("PASS host paths, Unicode working directory, process id, stderr")
}
