// Workspace shutdown owns ordering; each subsystem releases its own storage.
// Background services and rendering resources stop before this function runs.
fn release_editor_state(app: *App) {
  ui_release(&app.ui)
  configuration_release(app)
  registers_release(app)
  macros_release(app)
  picker_release(app)
  explorer_release(app)
  documents_release(app)
}

// Keep the existing reverse-defer shutdown order. Trace each join separately so
// an intermittent close delay identifies the responsible service.
fn release_service(app: *App, name: []const u8, release: fn(*App)) {
  started := operation_begin(app)
  release(app)
  operation_end(app, name, started)
}
fn release_background_services(app: *App) {
  release_service(app, "shutdown_search", project_search_release)
  release_service(app, "shutdown_languages", language_manager_release)
  release_service(app, "shutdown_format", format_release)
  release_service(app, "shutdown_plugins", plugin_release)
  release_service(app, "shutdown_recovery", recovery_release)
  release_service(app, "shutdown_tree", tree_release)
  release_service(app, "shutdown_disk", disk_release)
  release_service(app, "shutdown_lsp", lsp_release)
  release_service(app, "shutdown_syntax", syntax_release)
  release_service(app, "shutdown_terminals", release_terminals)
}
