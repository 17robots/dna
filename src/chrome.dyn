use "std/math"

struct WindowTitleState {
  text: [8192]u8,
  name_start, name_end: usize,
  dirty, insert, extend, ready: bool,
}

fn add_number(output: []u8, used: *usize, number: usize) {
  digits: [24]u8
  value := number
  at: usize = 24
  for {
    at -= 1
    digits[at] = #cast(u8, value % 10) + '0'
    value /= 10
    if value == 0 { break }
  }
  add_text(output, used, digits[at..])
}
fn line_number(doc: *const buffer.Document) usize {
  return line_at(doc, doc.cursor)
}
fn line_at(doc: *const buffer.Document, position: usize) usize {
  return buffer.row_at(doc, position) + 1
}
fn chrome_text(typography: *Typography, text: str, x: f32, y: f32, active: bool) {
  color := theme().muted
  if active {
    color = theme().text
  }
  cached := cached_ui_text(typography, text)
  if cached != nil {
    if !tint(cached, color) || !ttf.draw(cached, x, y) {
      #panic("cached UI text")
    }
    return
  }
  if !tint(typography.chrome, color) || !ttf.set(typography.chrome, &text[0], text.len) || !ttf.draw(typography.chrome, x, y) {
    #panic("chrome draw failed")
  }
}
fn draw_chrome(renderer: rawptr, app: *App, typography: *Typography, width: i32, height: i32, margin: f32, gutter: f32, scroll_y: f32) {
  doc := app.documents.current
  position := doc.cursor
  if !app.view.insert {
    position = buffer.head(doc)
  }
  current := line_at(doc, position)
  if app.view.line_numbers {
    bottom := #cast(f32, height)
    if app.view.status_line {
      bottom -= typography.line
    }
    draw_gutter(doc, typography, margin + gutter, margin, bottom, scroll_y, app.view.relative_numbers, position, app.documents.slots[app.documents.active].git, gutter_phantom(app))
  }
  if app.view.status_line {
    draw_status(renderer, app, typography, width, height, margin, current, position)
  }
}

// Git markers sit in the gap between the numbers and the text.
fn draw_git_sign(typography: *Typography, kind: GitHunkKind, x: f32, y: f32) {
  text: str = "▎"
  color := theme().syntax_string
  case kind {
    .Modified => { color = theme().diagnostic_warning }
    .Deleted => {
      text = "▔"
      color = theme().diagnostic_error
    }
    .Added, .None => {}
  }
  if !tint(typography.chrome, color) || !ttf.set(typography.chrome, &text[0], text.len) || !ttf.draw(typography.chrome, x, y) {
    #panic("git sign draw failed")
  }
}
fn gutter_phantom(app: *const App) u8 {
  if app.config.vim_keys { return 1 }
  return 0
}
fn draw_gutter(doc: *const buffer.Document, typography: *Typography, right: f32, top: f32, bottom: f32, scroll_y: f32, relative: bool, position: usize, diff: *const GitDiff, phantom_mode: u8) {
  current := line_at(doc, position)
  // The row after a final newline is not a line in Vim: phantom_mode 1 shows
  // it as ~ (past the end), 2 leaves it unnumbered (explorer listings).
  phantom := phantom_mode != 0 && doc.length > 0 && doc.line_count > 1 && buffer.byte_at(doc, doc.length - 1) == 10
  first := #cast(usize, (scroll_y / typography.line))
  row := first + 1
  // Hunks are in row order; each covers its rows, a deletion the one row
  // it precedes.
  hunk: usize = 0
  hunks := git_current(diff, doc)
  y := top + #cast(f32, first) * typography.line - scroll_y
  for {
    if y >= bottom { break }
    if y + typography.line > top {
      number := row
      if relative && row != current {
        if row > current {
          number = row - current
        } else {
          number = current - row
        }
      }
      label: [32]u8
      length: usize = 0
      if phantom && row == doc.line_count && row != current {
        if phantom_mode == 1 {
          length = copy_text(label[..], "~")
        }
      } else {
        add_number(label[..], &length, number)
      }
      x := right - (#cast(f32, length) + 2.0) * typography.cell
      if length > 0 {
        chrome_text(typography, label[..length], x, y, row == current)
      }
      if hunks {
        index := row - 1
        for hunk < diff.hunk_count && git_hunk_end(diff.hunks[hunk]) <= index {
          hunk += 1
        }
        if hunk < diff.hunk_count {
          item := diff.hunks[hunk]
          // A deletion after the last line shows on the last line.
          if item.first <= index || (row >= doc.line_count && item.kind == .Deleted) {
            draw_git_sign(typography, item.kind, right - 1.75 * typography.cell, y)
          }
        }
      }
    }
    if row >= doc.line_count { break }
    row += 1
    y += typography.line
  }
}
const StatusBase: usize = 1000000
// One status segment; clickable segments run a command for their pane.
fn status_segment(app: *App, ui: *UiState, pane: usize, name: str, text: str, command: usize, flags: u32) {
  segment_flags := flags | UiText
  // Focus remains readable even when the caret is hidden by a panel or blink.
  // Use existing theme inks, keeping segment dimensions and hit targets stable.
  if pane != app.view.focused {
    segment_flags = segment_flags | UiMuted
  } else if buffer.equal(name, "mode") {
    segment_flags = segment_flags | UiBackground
  }
  if command != 0 {
    segment_flags = segment_flags | UiClickable | UiHover
  }
  segment := ui_make(ui, ui_key(ui, name), segment_flags)
  if (segment_flags & UiBackground) != 0 {
    ui.boxes[segment].fill = theme().selection
  }
  ui_text_set(ui, segment, text)
  ui.boxes[segment].value = StatusBase + pane * 1000 + command
  ui.boxes[segment].padding[0] = ui.cell
  ui_size(ui, segment, UiAxisX, .Text, 0.0, 1.0)
  ui_size(ui, segment, UiAxisY, .Percent, 1.0, 1.0)
  ui_animate(app, ui, segment, false)
}
// A new file label grows like a small tab. The source text stays opaque and
// the actual width is used by both layout and hit testing.
fn status_file_width(app: *App, ui: *UiState, pane: usize, target: f32) f32 {
  state := &ui.status_files[pane]
  identity := app.documents.slots[app.documents.active].identity
  now := app.view.animation.now
  changed := !state.ready || state.identity != identity || state.frame + 1 < ui.frame
  enabled := !platform.tui_active() && !app.view.reduced_motion && app.config.popup_transitions && app.config.popup_animation_ms > 0.0 && !app.pointer.dragging
  if changed {
    state.width = target
    if enabled && ui.frame > 1 {
      state.width = ui.cell * 2.0
    }
    state.sampled = now
    state.identity = identity
    state.ready = true
  }
  state.frame = ui.frame
  answering := (app.render_pending & (RenderKey | RenderText | RenderMouse | RenderIme)) != 0
  immediate := !enabled || (!changed && answering) || (app.render_pending & RenderWindow) != 0
  if immediate {
    state.width = target
  } else {
    elapsed := (now - state.sampled) / 1000.0
    if elapsed < 0.0 {
      elapsed = 0.0
    }
    if elapsed > 0.25 {
      elapsed = 0.25
    }
    rate: f32 = 70.0 * 40.0 / app.config.popup_animation_ms
    weight := 1.0 - #cast(f32, math.exp2_64(-#cast(f64, rate * elapsed)))
    state.width += (target - state.width) * weight
  }
  state.sampled = now
  remaining := target - state.width
  if remaining < 0.0 {
    remaining = -remaining
  }
  state.active = remaining >= 0.5
  if !state.active {
    state.width = target
  }
  if state.active {
    app.view.animation.active = true
  }
  return state.width
}
fn status_file_segment(app: *App, ui: *UiState, pane: usize, text: str) {
  status_segment(app, ui, pane, "file", text, 21, UiClip)
  segment := ui.boxes[ui_parent(ui)].last
  width := status_file_width(app, ui, pane, ui_text_width(ui, text) + ui.cell * 2.0)
  ui_size(ui, segment, UiAxisX, .Pixels, width / ui.scale, 1.0)
}
// Status line built from segments. Clicking the file or buffer count opens
// the buffer picker, the filetype sets the language, !N lists diagnostics,
// line:col opens goto, [+] saves and ": commands" opens the palette.
fn draw_status(renderer: rawptr, app: *App, typography: *Typography, width: i32, height: i32, margin: f32, current: usize, position: usize) {
  ui := &app.ui
  ui_panel_begin(ui, typography)
  doc := app.documents.current
  pane := typography.current_pane
  area := app.view.panes[pane].rect
  bar := ui_make(ui, ui_hash_number(ui_hash(0, "status"), pane), UiFloating | UiBackground | UiClip)
  ui.boxes[bar].axis = UiAxisX
  ui.boxes[bar].fill = theme().surface
  ui.boxes[bar].floating[0] = #cast(f32, area.x)
  ui.boxes[bar].floating[1] = #cast(f32, area.y) + #cast(f32, height) - typography.line
  ui.boxes[bar].padding[0] = margin - typography.cell
  if ui.boxes[bar].padding[0] < 0.0 {
    ui.boxes[bar].padding[0] = 0.0
  }
  ui_size(ui, bar, UiAxisX, .Pixels, #cast(f32, width) / typography.scale, 1.0)
  ui_size(ui, bar, UiAxisY, .Pixels, typography.line / typography.scale, 1.0)
  ui_push(ui, bar)
  mode: str = "NORMAL"
  if app.view.insert && app.config.vim_keys && app.vim.replacing {
    mode = "REPLACE"
  } else if app.view.insert {
    mode = "INSERT"
  } else if app.view.extend {
    mode = "SELECT"
  } else if app.config.vim_keys && app.vim.mode == .Visual {
    mode = "VISUAL"
  } else if app.config.vim_keys && app.vim.mode == .VisualLine {
    mode = "V-LINE"
  } else if app.config.vim_keys && app.vim.mode == .VisualBlock {
    mode = "V-BLOCK"
  }
  if app.macro_state.recording {
    recording: [32]u8
    length := copy_text(recording[..], mode)
    add_text(recording[..], &length, " REC")
    status_segment(app, ui, pane, "mode", recording[..length], 0, 0)
  } else {
    status_segment(app, ui, pane, "mode", mode, 0, 0)
  }
  path := files.name(app.documents.file)
  leaf := path.len
  for leaf > 0 && path[leaf - 1] != '/' {
    leaf -= 1
  }
  if path.len == 0 {
    status_file_segment(app, ui, pane, "Untitled")
  } else {
    status_file_segment(app, ui, pane, path[leaf..])
  }
  kind: [96]u8
  kind_length := copy_text(kind[..], "[")
  add_text(kind[..], &kind_length, filetype_name(app.documents.slots[app.documents.active]))
  add_text(kind[..], &kind_length, "]")
  status_segment(app, ui, pane, "filetype", kind[..kind_length], 54, 0)
  if app.documents.slots[app.documents.active].disk_changed {
    status_segment(app, ui, pane, "disk", "[disk changed: :reload]", 86, 0)
  }
  if app.lsp.failed {
    status_segment(app, ui, pane, "lsp", "[LSP error: :lsp-log]", 84, 0)
  }
  diagnostics := &app.documents.slots[app.documents.active].diagnostics
  if diagnostics.revision == doc.revision && diagnostics.count > 0 {
    problems: [32]u8
    problems_length := copy_text(problems[..], "!")
    add_number(problems[..], &problems_length, diagnostics.count)
    status_segment(app, ui, pane, "problems", problems[..problems_length], 80, 0)
  }
  if buffer.dirty_cached(doc) {
    status_segment(app, ui, pane, "dirty", "[+]", 1, 0)
  }
  buffers: [32]u8
  buffers_length: usize = 0
  add_number(buffers[..], &buffers_length, app.documents.count)
  if app.documents.count == 1 {
    add_text(buffers[..], &buffers_length, " buffer")
  } else {
    add_text(buffers[..], &buffers_length, " buffers")
  }
  status_segment(app, ui, pane, "buffers", buffers[..buffers_length], 21, 0)
  cached_pane:=pane_text_get(typography, typography.current_pane)
  counts := &cached_pane.counts
  identity := app.documents.slots[app.documents.active].identity
  low := buffer.start(doc)
  high := buffer.end(doc)
  invalid := !counts.ready || counts.revision != doc.revision || counts.identity != identity
  if invalid || counts.position != position {
    counts.column = buffer.codepoints(doc, buffer.line_start(doc, position), position) + 1
  }
  if invalid || counts.low != low || counts.high != high {
    counts.selected = buffer.codepoints(doc, low, high)
  }
  counts.ready = true
  counts.revision = doc.revision
  counts.identity = identity
  counts.position = position
  counts.low = low
  counts.high = high
  location: [48]u8
  location_length: usize = 0
  add_number(location[..], &location_length, current)
  add_text(location[..], &location_length, ":")
  add_number(location[..], &location_length, counts.column)
  status_segment(app, ui, pane, "location", location[..location_length], 90, 0)
  if doc.secondary.count > 0 {
    cursors: [32]u8
    cursors_length := copy_text(cursors[..], "cursors ")
    add_number(cursors[..], &cursors_length, doc.secondary.count + 1)
    status_segment(app, ui, pane, "cursors", cursors[..cursors_length], 0, 0)
  }
  // Vim normal mode keeps a one-character Helix-style selection internally;
  // only visual modes select anything the user can see.
  vim_selecting := !app.config.vim_keys || app.vim.mode == .Visual || app.vim.mode == .VisualLine || app.vim.mode == .VisualBlock || app.view.extend
  if doc.anchor != doc.cursor && vim_selecting {
    chosen: [32]u8
    chosen_length := copy_text(chosen[..], "selected ")
    add_number(chosen[..], &chosen_length, counts.selected)
    status_segment(app, ui, pane, "selected", chosen[..chosen_length], 0, 0)
  }
  if app.input_state.pending != 0 {
    status_segment(app, ui, pane, "pending", "awaiting character (Esc cancels)", 0, 0)
  } else if app.status_message.length > 0 && pane == app.view.focused {
    note_flags: u32 = UiClip
    if app.status_message.error {
      note_flags = note_flags | UiError
    }
    status_segment(app, ui, pane, "note", status_message_text(app), 0, note_flags)
  } else {
    status_segment(app, ui, pane, "commands", ": commands", 91, 0)
  }
  if diagnostics.revision == doc.revision {
    diagnostic_index: usize = 0
    for diagnostic_index < diagnostics.count {
      diagnostic := &diagnostics.items[diagnostic_index]
      if diagnostic.line <= current - 1 && diagnostic.end_line >= current - 1 {
        message: [600]u8
        message_length := copy_text(message[..], "| ")
        add_text(message[..], &message_length, diagnostic.text[..diagnostic.length])
        // The message yields space first and clips at the pane edge.
        status_segment(app, ui, pane, "message", message[..message_length], 80, UiClip)
        last := ui.boxes[bar].last
        ui_size(ui, last, UiAxisX, .Text, 0.0, 0.0)
        break
      }
      diagnostic_index += 1
    }
  }
  ui_pop(ui)
  ui_layout(ui)
  // Build in window coordinates; draw outside the pane viewport.
  if !platform.viewport(renderer, nil) {
    #panic("status viewport")
  }
  ui_render(renderer, ui, typography, area.x + width, area.y + height)
  if !platform.viewport(renderer, &area) {
    #panic("status viewport restore")
  }
}
