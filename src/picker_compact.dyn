// Compact picker module: pickers sized like the command palette, centred
// near the top of the window with no preview or footer.
fn picker_compact_rect(width: i32, height: i32, status: f32, content_height: f32, scale: f32) sdl.Rect {
  box_width := 680.0 * scale
  if box_width > #cast(f32) width * 0.92 {
    box_width = #cast(f32) width * 0.92
  }
  return sdl.Rect{x: (#cast(f32) width - box_width) / 2.0, y: (#cast(f32) height - status) * 0.1, width: box_width, height: content_height}
}
