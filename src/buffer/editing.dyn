// These operations preserve the half-open UTF-8 selection representation.
pub fn find_character(document: *Document, text: []const u8, backwards: bool, till: bool, count: usize, extend: bool) bool {
  origin := document.cursor
  at := origin
  found: usize = 0
  if backwards {
    if at == 0 {
      return false
    }
    at = previous(document, at)
    if document.anchor < origin {
      if at == 0 {
        return false
      }
      at = previous(document, at)
    }
  } else if document.anchor == origin {
    at = next(document, at)
  }
  for true {
    if at + #len(text) <= document.length && equal(range(document, at, at + #len(text)), text) {
      found += 1
      if found == count {
        destination := at
        if backwards {
          if till {
            destination = next(document, at)
          }
        }
        else if !till {
          destination = next(document, at)
        }
        if !extend {
          document.anchor = origin
        }
        document.cursor = destination
        return true
      }
    }
    if backwards {
      if at == 0 {
        break
      }
      at = previous(document, at)
    }
    else {
      if at >= document.length {
        break
      }
      at = next(document, at)
    }
  }
  return false
}
pub fn trim_selection(document: *Document) {
  low := start(document)
  high := end(document)
  for low < high && (byte_at(document, low) == 32 || byte_at(document, low) == 9 || byte_at(document, low) == 10 || byte_at(document, low) == 13) {
    low += 1
  }
  for high > low && (byte_at(document, high - 1) == 32 || byte_at(document, high - 1) == 9 || byte_at(document, high - 1) == 10 || byte_at(document, high - 1) == 13) {
    high -= 1
  }
  if document.cursor < document.anchor {
    document.cursor = low
    document.anchor = high
  } else {
    document.anchor = low
    document.cursor = high
  }
}
fn change_case_one(document: *Document, mode: u8) {
  low := start(document)
  high := end(document)
  if low == high {
    high = next(document, high)
  }
  checkpoint(document)
  // ASCII case changes preserve byte lengths, line indexes and tracked marks.
  size := high - low
  output := #cast(*u8, rope_malloc(size + 1))
  if output == nil {
    #panic("cannot allocate case change")
  }
  changed: bool = false
  for at in low..high {
    original := byte_at(document, at)
    byte := original
    if byte >= 65 && byte <= 90 && mode != 2 {
      byte += 32
    }
    else if byte >= 97 && byte <= 122 && mode != 1 {
      byte -= 32
    }
    output[..size + 1][at - low] = byte
    if byte != original {
      changed = true
    }
  }
  if changed {
    root := rope_replace(rope_retain(document.root), low, high, output[..size])
    before_change(document, low, high)
    set_root(document, root)
    document.revision += 1
  }
  rope_free(#cast(rawptr, output))
  document.anchor = low
  document.cursor = high
  checkpoint(document)
  if changed {
    notify_changed(document)
  }
}
// Each level removes a tab or up to `width` spaces.
fn indentation_removed(document: *const Document, at: usize, count: usize, width: usize) usize {
  remove: usize = 0
  for level in 0..count {
    if at + remove < document.length && byte_at(document, at + remove) == 9 {
      remove += 1
      continue
    }
    removed: usize = 0
    for at + remove < document.length && removed < width && byte_at(document, at + remove) == 32 {
      remove += 1
      removed += 1
    }
    if removed == 0 {
      break
    }
  }
  return remove
}
// One indentation level is a tab, or `width` spaces. Rewrite each selected
// byte once; update each index entry only after consuming its source row.
fn indent_lines_one(document: *Document, unindent: bool, count: usize, width: usize, tabs: bool) bool {
  low := line_start(document, start(document))
  last := end(document)
  if last > low && byte_at(document, last - 1) == 10 {
    last -= 1
  }
  first_row := row_at(document, low)
  last_row := row_at(document, last)
  high := line_end(document, last)
  rows := last_row - first_row + 1
  if count == 0 || count > 999 || width == 0 || width > 16 {
    return false
  }
  spaces := count * width
  if tabs {
    spaces = count
  }
  if !unindent && rows > Capacity / spaces {
    return false
  }
  checkpoint(document)
  padding: [16000]u8 = []
  if !unindent {
    fill: u8 = 32
    if tabs {
      fill = 9
    }
    for index in 0..spaces {
      padding[index] = fill
    }
  }
  // A single row needs no coordinate mapping. Reuse replace, which already
  // shifts its suffix and tracked positions efficiently.
  if rows == 1 {
    document.anchor = low
    document.cursor = low
    result_end := high
    if unindent {
      remove := indentation_removed(document, low, count, width)
      document.cursor += remove
      _ = replace(document, "")
      result_end -= remove
    } else {
      _ = replace(document, padding[..spaces])
      result_end += spaces
    }
    document.anchor = low
    document.cursor = result_end
    checkpoint(document)
    return true
  }

  // Mapping by row avoids collapsing marks or explorer identities inside a
  // single large replacement. Byte columns preserve even non-boundary marks.
  positions: [MarkCount]TextPosition = []
  for marker in 0..MarkCount {
    position := text_position(document, document.marks[marker])
    if position.row >= first_row && position.row <= last_row {
      if unindent {
        remove := indentation_removed(document, row_start(document, position.row), count, width)
        if position.column < remove {
          position.column = 0
        } else {
          position.column -= remove
        }
      } else {
        position.column += spaces
      }
    }
    positions[marker] = position
  }
  identity_rows: [256]usize = []
  for identity in 0..document.rows.count {
    identity_rows[identity] = document.line_count
    if document.rows.offsets[identity] <= document.length {
      identity_rows[identity] = row_at(document, document.rows.offsets[identity])
    }
  }
  // Preserve the same sparse bounds as the former per-row edits. Including
  // unchanged final-line text could move the undo delta past equal padding.
  changed_end := row_start(document, last_row)
  if unindent {
    changed_end += indentation_removed(document, changed_end, count, width)
  }
  // Build the rewritten rows once, then swap them in as one tree edit.
  capacity := high - low
  if !unindent {
    capacity += rows * spaces
  }
  output := #cast(*u8, rope_malloc(capacity + 1))
  if output == nil {
    #panic("cannot allocate indentation")
  }
  written: usize = 0
  for row in first_row..=last_row {
    at := row_start(document, row)
    ending := high
    if row < last_row {
      ending = row_start(document, row + 1)
    }
    if unindent {
      at += indentation_removed(document, at, count, width)
    } else {
      _ = copy_bytes(&output[..capacity + 1][written], &padding[0], spaces)
      written += spaces
    }
    if ending > at {
      rope_copy(document.root, at, ending, &output[..capacity + 1][written])
      written += ending - at
    }
  }
  root := rope_replace(rope_retain(document.root), low, high, output[..written])
  rope_free(#cast(rawptr, output))
  before_change(document, low, changed_end)
  set_root(document, root)
  result_end := low + written
  for marker in 0..MarkCount {
    document.marks[marker] = row_start(document, positions[marker].row) + positions[marker].column
  }
  for identity in 0..document.rows.count {
    if identity_rows[identity] < document.line_count {
      document.rows.offsets[identity] = row_start(document, identity_rows[identity])
    }
  }
  document.revision += 1
  document.anchor = low
  document.cursor = result_end
  checkpoint(document)
  notify_changed(document)
  return true
}
fn join_lines_one(document: *Document) {
  low := start(document)
  high := end(document)
  at := line_end(document, low)
  if high <= at {
    high = at
    if high < document.length {
      high = line_end(document, high + 1)
    }
  }
  checkpoint(document)
  for at < high && at < document.length {
    if byte_at(document, at) != 10 {
      at = next(document, at)
      continue
    }
    after := at + 1
    for after < document.length && (byte_at(document, after) == 32 || byte_at(document, after) == 9) {
      after += 1
    }
    document.anchor = at
    document.cursor = after
    _ = replace(document, " ")
    if after - at - 1 <= high - at {
      high -= after - at - 1
    } else {
      high = at + 1
    }
    at += 1
  }
  document.anchor = low
  document.cursor = high
  checkpoint(document)
}
pub fn line_position(document: *const Document, number: usize) usize {
  if number == 0 {
    return 0
  }
  return row_start(document, number - 1)
}

// Plan ranges in the original document before any mutation. Overlapping edits
// run once; completed ranges track shifts from later, lower-address edits.
pub fn change_case(document: *Document, mode: u8) {
  _ = batch_lines(document, 0, mode, 1, 4, false)
}
// Shift lines by `count` levels of four spaces.
pub fn indent_lines(document: *Document, unindent: bool, count: usize) bool {
  return indent_lines_by(document, unindent, count, 4, false)
}
// Shift lines by `count` levels of a tab or `width` spaces.
pub fn indent_lines_by(document: *Document, unindent: bool, count: usize, width: usize, tabs: bool) bool {
  mode: u8 = 0
  if unindent {
    mode = 1
  }
  return batch_lines(document, 1, mode, count, width, tabs)
}
pub fn join_lines(document: *Document) {
  _ = batch_lines(document, 2, 0, 1, 4, false)
}
fn batch_lines(document: *Document, operation: u8, mode: u8, repeats: usize, width: usize, tabs: bool) bool {
  begin_change(document)
  defer end_change(document)
  ranges: [32]EditRange = []
  count := document.secondary.count + 1
  ranges[0] = EditRange{low: start(document), high: end(document), primary: true, reversed: document.cursor < document.anchor}
  for index in 1..count {
    selected := document.secondary.ranges[index - 1]
    low := selected.anchor
    high := selected.cursor
    if low > high {
      swap := low
      low = high
      high = swap
    }
    ranges[index] = EditRange{low: low, high: high, reversed: selected.cursor < selected.anchor}
  }

  for index in 0..count {
    entry := &ranges[index]
    if operation == 0 && entry.low == entry.high {
      entry.high = next(document, entry.high)
    }
    if operation == 1 {
      entry.low = line_start(document, entry.low)
      if entry.high > entry.low && byte_at(document, entry.high - 1) == 10 {
        entry.high -= 1
      }
      entry.high = line_end(document, entry.high)
    }
    if operation == 2 {
      ending := line_end(document, entry.low)
      if entry.high <= ending {
        entry.high = ending
        if ending < document.length {
          entry.high = line_end(document, ending + 1)
        }
      }
    }
  }

  for index in 1..count {
    moving := ranges[index]
    at := index
    for at > 0 && ranges[at - 1].low > moving.low {
      ranges[at] = ranges[at - 1]
      at -= 1
    }
    ranges[at] = moving
    index += 1
  }

  merged: usize = 0

  for index in 0..count {
    merging := ranges[index]
    if merged > 0 && (merging.low < ranges[merged - 1].high || merging.low == ranges[merged - 1].low) {
      if merging.high > ranges[merged - 1].high {
        ranges[merged - 1].high = merging.high
      }
      if merging.primary {
        ranges[merged - 1].reversed = merging.reversed
      }
      ranges[merged - 1].primary = ranges[merged - 1].primary || merging.primary
    } else {
      ranges[merged] = merging
      merged += 1
    }
  }
  if operation == 1 {
    if repeats == 0 || repeats > 999 || width == 0 || width > 16 {
      return false
    }
    level := width
    if tabs {
      level = 1
    }
    if mode == 0 {
      rows: usize = 0
      for index in 0..merged {
        row_point := ranges[index].low
        rows += 1
        for row_point < ranges[index].high {
          row_point = line_end(document, row_point)
          if row_point >= ranges[index].high {
            break
          }
          row_point += 1
          rows += 1
        }
      }
      if rows > Capacity / (repeats * level) {
        return false
      }
    }
  }
  checkpoint(document)
  before_revision := document.revision
  document.batching = true
  document.secondary.count = 0
  index := merged
  for index > 0 {
    index -= 1
    editing := ranges[index]
    old_length := document.length
    document.anchor = editing.low
    document.cursor = editing.high
    if operation == 0 {
      change_case_one(document, mode)
    }
    else if operation == 1 {
      _ = indent_lines_one(document, mode != 0, repeats, width, tabs)
    }
    else {
      join_lines_one(document)
    }
    ranges[index].low = start(document)
    ranges[index].high = end(document)
    for later in index + 1..merged {
      if document.length >= old_length {
        added := document.length - old_length
        ranges[later].low += added
        ranges[later].high += added
      }
      else {
        removed := old_length - document.length
        ranges[later].low -= removed
        ranges[later].high -= removed
      }
    }
  }
  index = 0
  for index < merged {
    finished := ranges[index]
    final_anchor := finished.low
    final_cursor := finished.high
    if finished.reversed {
      final_anchor = finished.high
      final_cursor = finished.low
    }
    if finished.primary {
      document.anchor = final_anchor
      document.cursor = final_cursor
    }
    else {
      document.secondary.ranges[document.secondary.count] = Selection{anchor: final_anchor, cursor: final_cursor}
      document.secondary.count += 1
    }
    index += 1
  }
  document.batching = false
  checkpoint(document)
  if operation == 0 && document.revision != before_revision {
    document.history[document.history_at].line_positions = true
  }
  return true
}
