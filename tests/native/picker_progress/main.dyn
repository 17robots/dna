use "std/sync"
extern fn picker_probe_sleep "usleep"(microseconds: u32) i32
picker_probe_active: sync.AtomicU32
picker_probe_calls: sync.AtomicU32
picker_probe_waiting: sync.AtomicU32
picker_probe_released: sync.AtomicU32
pub fn dna_picker_probe_begin() {
  sync.store_u32(&picker_probe_calls, 0)
  sync.store_u32(&picker_probe_waiting, 0)
  sync.store_u32(&picker_probe_released, 0)
  sync.store_u32(&picker_probe_active, 1)
}
pub fn dna_picker_probe_blocked() u32 {
  return sync.load_u32(&picker_probe_waiting)
}
pub fn dna_picker_probe_release() {
  sync.store_u32(&picker_probe_released, 1)
}
pub fn fstatat(fd: i32, name: *const u8, output: rawptr, flags: i32) i32 {
  next := #cast(fn(i32, *const u8, rawptr, i32) i32, probe_next("fstatat\0"))
  if sync.load_u32(&picker_probe_active) != 0 && name != nil && name.* == 'f' {
    count := sync.fetch_add_u32(&picker_probe_calls, 1) + 1
    if count == 129 {
      sync.store_u32(&picker_probe_waiting, 1)
      for sync.load_u32(&picker_probe_released) == 0 {
        _ = picker_probe_sleep(1000)
      }
    }
  }
  return next(fd, name, output, flags)
}
