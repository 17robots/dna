#target(kernel: windows)
#link("kernel32")

extern fn sync_desktop_id "GetCurrentThreadId"() u32
fn sync_thread_create(output: *usize, attributes: rawptr, entry: fn(rawptr) rawptr, state: rawptr) i32 {
  return desktop_thread_create(output, attributes, entry, state)
}
fn sync_thread_join(handle: usize, result: rawptr) i32 {
  return desktop_thread_join(handle, result)
}
fn sync_thread_is_self(handle: usize) bool {
  owner := #cast(*DesktopThread, handle)
  return thread.id(owner.worker) == sync_desktop_id()
}
