// A bounded local preview keeps slow language analysis off the typing path.
// These are plain words, never inferred signatures, snippets or workspace edits.
fn completion_words(app: *App) {
  if app.prompt_state.panel != Panel.None || !app.view.insert || (completion_session(app) && app.lsp.results.count > 0) {
    return
  }
  doc := app.documents.current
  if doc.cursor != doc.anchor || doc.secondary.count != 0 {
    return
  }
  beginning := completion_prefix_start(doc, doc.cursor)
  prefix := doc.bytes[beginning..doc.cursor]
  if #len(prefix) == 0 || #len(prefix) > 128 {
    return
  }
  words: [128][]const u8 = []
  count: usize = 0
  low: usize = 0
  if doc.cursor > 32768 {
    low = doc.cursor - 32768
  }
  high := low + 65536
  if high > doc.length {
    high = doc.length
  }
  at := low
  // Never interpret a truncated token or UTF-8 sequence as a new word.
  if at > 0 {
    for at < high && completion_word_byte(doc.bytes[at]) {
      at += 1
    }
  }
  for at < high && count < 128 {
    for at < high && !completion_word_byte(doc.bytes[at]) {
      at += 1
    }
    start := at
    for at < high && completion_word_byte(doc.bytes[at]) {
      at += 1
    }
    if at == high && high < doc.length && completion_word_byte(doc.bytes[high]) {
      break
    }
    size := at - start
    if size <= #len(prefix) || size > 128 || (start <= beginning && at >= doc.cursor) {
      continue
    }
    if doc.bytes[start] >= '0' && doc.bytes[start] <= '9' {
      continue
    }
    word := doc.bytes[start..at]
    if !buffer.equal(word[..#len(prefix)], prefix) {
      continue
    }
    duplicate: bool = false
    for previous in 0..count {
      if buffer.equal(words[previous], word) {
        duplicate = true
        break
      }
    }
    if !duplicate {
      words[count] = word
      count += 1
    }
  }
  if count == 0 {
    return
  }
  allocated := mem.arena_create(262144)
  if !allocated.ok {
    return
  }
  output := (#cast(*u8) mem.arena_push_uninit_or_panic(&allocated.arena, 32768, 1))[..32768]
  used: usize = 0
  escaped: [1024]u8 = []
  add_text(output, &used, "[")
  for index in 0..count {
    if index > 0 {
      add_text(output, &used, ",")
    }
    add_text(output, &used, "{\"label\":")
    add_text(output, &used, json.write_string(escaped[..], words[index]))
    add_text(output, &used, ",\"detail\":\"word from file\"}")
  }
  add_text(output, &used, "]")
  parsed := json.parse(&allocated.arena, output[..used])
  if !parsed.ok {
    _ = mem.arena_release(&allocated.arena)
    return
  }
  lsp_results_release(app)
  state := &app.lsp.results
  state.arena = mem.arena_take(&allocated.arena)
  state.owned = true
  state.tracked_capacity = mem.arena_capacity(&state.arena)
  state.tracked_born = render_clock()
  allocation_record(app, "lsp_results", state.tracked_capacity, state.tracked_born, false)
  state.kind = 1
  state.server = app.lsp.server
  state.slot = app.documents.active
  state.identity = app.documents.slots[app.documents.active].identity
  state.revision = doc.revision
  state.position = doc.cursor
  state.origin = doc.cursor
  state.prefix_start = beginning
  state.insert = true
  state.active = true
  state.incomplete = true
  state.source = parsed.root.first
  completion_collect(state, doc)
  app.prompt_state.selected = 0
  app.prompt_state.panel = Panel.LspResults
  render_request(app, RenderLsp)
}
