// Full saved/checkpoint text is assembled only on request (e.g. reload saved
// text). Dirty checks and checkpoint diffs compare trees directly.
fn tree_text(document: *Document, root: *RopeNode) []u8 {
  length := rope_length(root)
  bytes := #cast(*u8, rope_malloc(length + 1))
  if bytes == nil {
    #panic("cannot allocate baseline text")
  }
  rope_copy(root, 0, length, bytes)
  bytes[..length + 1][length] = 0
  view := #cast(*TextView, rope_malloc(#sizeof(TextView)))
  if view == nil {
    #panic("cannot allocate baseline text")
  }
  // Owned like a flattened view; never matched by range lookups.
  view.low = 1
  view.high = 0
  view.bytes = bytes
  view.next = document.views
  document.views = view
  document.view_count += 1
  return bytes[..length + 1]
}
// Saved text plus a terminating NUL. Valid until the next edit or release_views.
pub fn saved_text(document: *Document) []u8 {
  return tree_text(document, document.saved_root)
}
pub fn checkpoint_text(document: *Document) []u8 {
  return tree_text(document, document.history[document.history_at].root)
}
// The saved baseline as spans. With a shared tree this is one span; callers
// concatenate the parts. Valid until the next edit or release_views.
pub fn saved_parts(document: *Document) [3][]const u8 {
  text := saved_text(document)
  empty := text[..0]
  return [text[..document.saved_length], empty, empty]
}
pub fn saved_equal(document: *const Document, text: []const u8) bool {
  if #len(text) != document.saved_length {
    return false
  }
  return rope_equal_bytes(document.saved_root, 0, text)
}
// FNV-1a hash of the saved text, walking the saved tree's leaves in place.
pub fn saved_hash(document: *const Document) u64 {
  value: u64 = 1469598103934665603
  at: usize = 0
  for at < document.saved_length {
    run := rope_run(document.saved_root, at)
    bytes := run.data[..run.high - run.low]
    for byte in bytes {
      value = #wrap((value ^ #cast(u64, byte)) * 1099511628211)
    }
    at = run.high
  }
  return value
}
