// Helix normal-mode bindings beyond the original set: view mode (z/Z),
// screen-relative and alternate-buffer goto, bracket navigation (]/[),
// search for selection (*), shrink to lines (Alt-x), align selections (&)
// and line-comment toggling (:comment).

use "std/time"

// Rows visible in the focused document pane.
fn view_rows(app: *App, typography: *Typography) usize {
  pane_init(app)
  height := #cast(f32, app.view.panes[app.view.focused].target_rect.height)
  available := height - app.config.document_padding * typography.scale * 2.0
  if app.view.status_line {
    available -= typography.line
  }
  if available < typography.line {
    return 1
  }
  return #cast(usize, (available / typography.line))
}
fn cursor_row(app: *App) usize {
  doc := app.documents.current
  head := doc.cursor
  if !app.view.insert {
    head = buffer.head(doc)
  }
  return buffer.row_at(doc, head)
}

// z / Z view mode. z closes after one command; Z stays until Escape.
fn view_open(app: *App, sticky: bool) {
  app.input_state.view_sticky = sticky
  panel(app, Panel.View)
}
fn view_key(app: *App, typography: *Typography, key: u32) {
  line := typography.line
  rows := view_rows(app, typography)
  row := cursor_row(app)
  height := #cast(f32, rows) * line
  if key == KeyZ || key == KeyC {
    app.view.scroll_y = #cast(f32, row) * line - (height - line) * 0.5
  }
  else if key == KeyT {
    app.view.scroll_y = #cast(f32, row) * line
  }
  else if key == KeyB {
    app.view.scroll_y = #cast(f32, (row + 1)) * line - height
  }
  else if key == KeyK || key == KeyUp {
    view_scroll_lines(app, typography, false)
  }
  else if key == KeyJ || key == KeyDown {
    view_scroll_lines(app, typography, true)
  }
  else {
    app.prompt_state.panel = Panel.None
    return
  }
  if app.view.scroll_y < 0.0 {
    app.view.scroll_y = 0.0
  }
  if !app.input_state.view_sticky {
    app.prompt_state.panel = Panel.None
  }
}
// Scroll one line; the cursor moves only when it would leave the view.
fn view_scroll_lines(app: *App, typography: *Typography, down: bool) {
  doc := app.documents.current
  line := typography.line
  rows := view_rows(app, typography)
  margin := #cast(usize, app.config.scroll_margin)
  if down {
    app.view.scroll_y += line
  }
  else if app.view.scroll_y >= line {
    app.view.scroll_y -= line
  }
  else {
    app.view.scroll_y = 0.0
  }
  first := #cast(usize, (app.view.scroll_y / line))
  row := cursor_row(app)
  if row < first + margin && first + margin < doc.line_count {
    goto_row(app, first + margin)
  }
  else if rows > margin && row + margin + 1 > first + rows {
    goto_row(app, first + rows - margin - 1)
  }
}
fn goto_row(app: *App, row: usize) {
  doc := app.documents.current
  target := row
  if target >= doc.line_count {
    target = doc.line_count - 1
  }
  buffer.checkpoint(doc)
  buffer.select_to(doc, buffer.row_start(doc, target), app.view.extend)
}
// gt / gc / gb: top, center or bottom of the visible screen (inside the
// scroll margin, like Helix's scrolloff).
fn goto_screen(app: *App, typography: *Typography, key: u32) {
  doc := app.documents.current
  rows := view_rows(app, typography)
  first := #cast(usize, (app.view.scroll_y / typography.line))
  margin := #cast(usize, app.config.scroll_margin)
  if margin * 2 >= rows {
    margin = 0
  }
  target := first + margin
  if key == KeyC {
    target = first + rows / 2
  }
  else if key == KeyB {
    target = first + rows - 1 - margin
  }
  if target >= doc.line_count {
    target = doc.line_count - 1
  }
  goto_row(app, target)
}
// ga: the previously active buffer.
fn goto_alternate(app: *App) {
  previous := app.documents.previous
  if previous >= #len(app.documents.slots) || previous == app.documents.active || app.documents.slots[previous].document == nil {
    notice(app, "No alternate buffer.")
    return
  }
  activate(app, previous)
}
// gf: open the file path in the selection, or under the cursor.
fn goto_file(app: *App) {
  doc := app.documents.current
  low := buffer.start(doc)
  high := buffer.end(doc)
  if high - low <= 1 {
    low = buffer.head(doc)
    high = low
    for low > 0 && path_byte(doc.bytes[low - 1]) {
      low -= 1
    }
    for high < doc.length && path_byte(doc.bytes[high]) {
      high += 1
    }
  }
  if high <= low || high - low >= 4000 {
    notice(app, "No file path under the cursor.")
    return
  }
  name := doc.bytes[low..high]
  storage: [4096]u8 = []
  path := expand_home(name, storage[..])
  if #len(path) > 0 && path[0] != '/' {
    // Relative paths resolve against the current file's directory first.
    directory_storage: [4096]u8 = []
    directory := files.name(app.documents.file)
    leaf := #len(directory)
    for leaf > 0 && directory[leaf - 1] != '/' {
      leaf -= 1
    }
    used := copy_text(directory_storage[..], directory[..leaf])
    add_text(directory_storage[..], &used, path)
    if leaf > 0 && files.metadata(directory_storage[..used]).ok {
      open_file(app, directory_storage[..used])
      return
    }
  }
  open_file(app, path)
}
fn path_byte(byte: u8) bool {
  return (byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z') || (byte >= '0' && byte <= '9') || byte == '/' || byte == '.' || byte == '_' || byte == '-' || byte == '~' || byte == '+'
}

// ] / [ navigation. The panel remembers the direction.
fn bracket_open(app: *App, forward: bool) {
  app.input_state.bracket_forward = forward
  panel(app, Panel.Bracket)
}
fn bracket_key(app: *App, key: u32, modifiers: u16) {
  app.prompt_state.panel = Panel.None
  forward := app.input_state.bracket_forward
  doc := app.documents.current
  shift := (modifiers & ModShift) != 0
  if key == KeyD && shift {
    diagnostic_edge(app, forward)
  }
  else if key == KeyD {
    diagnostic_jump(app, !forward)
  }
  else if key == KeyP {
    buffer.checkpoint(doc)
    buffer.select_to(doc, paragraph_edge(doc, buffer.head(doc), forward), app.view.extend)
  }
  else if key == KeySpace {
    blank_line(app, forward)
  }
}
// ]D / [D: last or first diagnostic in the buffer.
fn diagnostic_edge(app: *App, last: bool) {
  doc := app.documents.current
  saved_cursor := doc.cursor
  saved_anchor := doc.anchor
  if last {
    doc.cursor = doc.length
    doc.anchor = doc.length
  }
  else {
    doc.cursor = 0
    doc.anchor = 0
  }
  diagnostic_jump(app, last)
  if app.prompt_state.panel != Panel.None {
    doc.cursor = saved_cursor
    doc.anchor = saved_anchor
  }
}
fn blank_row(doc: *const buffer.Document, row: usize) bool {
  beginning := buffer.row_start(doc, row)
  for at in beginning..buffer.line_end(doc, beginning) {
    if doc.bytes[at] != ' ' && doc.bytes[at] != 9 && doc.bytes[at] != 13 {
      return false
    }
  }
  return true
}
// Start of the next (or previous) paragraph: the first non-blank line after
// a run of blank lines.
fn paragraph_edge(doc: *const buffer.Document, position: usize, forward: bool) usize {
  row := buffer.row_at(doc, position)
  if forward {
    for row + 1 < doc.line_count && !blank_row(doc, row) {
      row += 1
    }
    for row + 1 < doc.line_count && blank_row(doc, row) {
      row += 1
    }
    return buffer.row_start(doc, row)
  }
  if row > 0 {
    row -= 1
  }
  for row > 0 && blank_row(doc, row) {
    row -= 1
  }
  for row > 0 && !blank_row(doc, row - 1) {
    row -= 1
  }
  return buffer.row_start(doc, row)
}
// ]<space> / [<space>: add an empty line below or above, keeping the cursor.
fn blank_line(app: *App, below: bool) {
  doc := app.documents.current
  saved_cursor := doc.cursor
  saved_anchor := doc.anchor
  secondary := doc.secondary.count
  doc.secondary.count = 0
  head := buffer.head(doc)
  at := buffer.line_start(doc, head)
  if below {
    at = buffer.line_end(doc, head)
  }
  buffer.checkpoint(doc)
  doc.anchor = at
  doc.cursor = at
  if !buffer.replace(doc, "\n") {
    notice(app, "Adding a line exceeds document capacity.")
  }
  buffer.checkpoint(doc)
  if !below {
    saved_cursor += 1
    saved_anchor += 1
  }
  doc.cursor = saved_cursor
  doc.anchor = saved_anchor
  doc.secondary.count = secondary
}

// *: search for the primary selection's text (regex-escaped), adding \\b
// where the selection starts or ends on a word edge. Alt-*: no boundaries.
fn word_byte(byte: u8) bool {
  return (byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z') || (byte >= '0' && byte <= '9') || byte == '_'
}
fn search_selection(app: *App, boundaries: bool) {
  doc := app.documents.current
  low := buffer.start(doc)
  high := buffer.end(doc)
  if high <= low {
    high = buffer.next(doc, low)
  }
  text := app.search_history.text[..]
  capacity := #len(app.search_history.text)
  used: usize = 0
  if boundaries && high > low && word_byte(doc.bytes[low]) && (low == 0 || !word_byte(doc.bytes[low - 1])) {
    text[0] = '\\'
    text[1] = 'b'
    used = 2
  }
  at := low
  for at < high && used + 5 < capacity {
    byte := doc.bytes[at]
    if byte == '\\' || byte == '.' || byte == '^' || byte == '$' || byte == '*' || byte == '+' || byte == '?' || byte == '(' || byte == ')' || byte == '[' || byte == ']' || byte == '{' || byte == '}' || byte == '|' {
      text[used] = '\\'
      used += 1
    }
    text[used] = byte
    used += 1
    at += 1
  }
  if boundaries && at == high && high > low && word_byte(doc.bytes[high - 1]) && (high >= doc.length || !word_byte(doc.bytes[high])) {
    text[used] = '\\'
    text[used + 1] = 'b'
    used += 2
  }
  text[used] = 0
  app.search_history.length = used
}
// Alt-x: shrink each selection to the whole lines it fully covers.
fn shrink_to_lines(doc: *buffer.Document) {
  low := buffer.start(doc)
  high := buffer.end(doc)
  first := low
  if buffer.line_start(doc, low) != low {
    first = buffer.line_end(doc, low)
    if first < doc.length {
      first += 1
    }
  }
  last := high
  if high < doc.length && (high == 0 || doc.bytes[high - 1] != 10) {
    last = buffer.line_start(doc, high)
  }
  if last > first {
    doc.anchor = first
    doc.cursor = last
  }
}
// &: pad every selection with spaces so all start in the same column.
fn align_selections(app: *App) {
  doc := app.documents.current
  count := doc.secondary.count + 1
  starts: [32]usize = []
  ends: [32]usize = []
  reversed: [32]bool = []
  starts[0] = buffer.start(doc)
  ends[0] = buffer.end(doc)
  reversed[0] = doc.cursor < doc.anchor
  for index in 1..count {
    selection := doc.secondary.ranges[index - 1]
    reversed[index] = selection.cursor < selection.anchor
    starts[index] = selection.anchor
    ends[index] = selection.cursor
    if reversed[index] {
      starts[index] = selection.cursor
      ends[index] = selection.anchor
    }
  }
  target: usize = 0
  for index in 0..count {
    column := buffer.codepoints(doc, buffer.line_start(doc, starts[index]), starts[index])
    if column > target {
      target = column
    }
  }
  // Insert from the last position back, so earlier positions stay valid.
  order: [32]usize = []
  for index in 0..count {
    order[index] = index
  }
  for index in 1..count {
    moving := order[index]
    at := index
    for at > 0 && starts[order[at - 1]] < starts[moving] {
      order[at] = order[at - 1]
      at -= 1
    }
    order[at] = moving
  }
  doc.secondary.count = 0
  buffer.checkpoint(doc)
  spaces: [256]u8 = []
  for position in 0..count {
    index := order[position]
    column := buffer.codepoints(doc, buffer.line_start(doc, starts[index]), starts[index])
    pad := target - column
    if pad == 0 || pad > 256 {
      continue
    }
    for fill in 0..pad {
      spaces[fill] = ' '
    }
    doc.anchor = starts[index]
    doc.cursor = starts[index]
    if !buffer.replace(doc, spaces[..pad]) {
      notice(app, "Aligning exceeds document capacity.")
      break
    }
    // Shift this and every later selection by the inserted padding.
    for other in 0..count {
      if starts[other] > starts[index] || other == index {
        starts[other] += pad
        ends[other] += pad
      }
      else if ends[other] > starts[index] {
        ends[other] += pad
      }
    }
  }
  buffer.checkpoint(doc)
  for index in 0..count {
    anchor := starts[index]
    cursor := ends[index]
    if reversed[index] {
      anchor = ends[index]
      cursor = starts[index]
    }
    if index == 0 {
      doc.anchor = anchor
      doc.cursor = cursor
    }
    else {
      doc.secondary.ranges[index - 1] = buffer.Selection{anchor: anchor, cursor: cursor}
    }
  }
  doc.secondary.count = count - 1
}

// :comment toggles line comments on every line touched by the selections,
// using the filetype's line-comment token.
fn comment_token(app: *App) []const u8 {
  name := filetype_name(app.documents.slots[app.documents.active])
  if buffer.equal(name, "python") || buffer.equal(name, "bash") || buffer.equal(name, "sh") || buffer.equal(name, "toml") || buffer.equal(name, "yaml") || buffer.equal(name, "ruby") || buffer.equal(name, "make") || buffer.equal(name, "fish") || buffer.equal(name, "nix") {
    return "#"
  }
  if buffer.equal(name, "lua") || buffer.equal(name, "sql") || buffer.equal(name, "haskell") {
    return "--"
  }
  if buffer.equal(name, "dyn") || buffer.equal(name, "c") || buffer.equal(name, "cpp") || buffer.equal(name, "rust") || buffer.equal(name, "go") || buffer.equal(name, "zig") || buffer.equal(name, "javascript") || buffer.equal(name, "typescript") || buffer.equal(name, "tsx") || buffer.equal(name, "java") || buffer.equal(name, "jsonc") || buffer.equal(name, "odin") || buffer.equal(name, "swift") || buffer.equal(name, "kotlin") || buffer.equal(name, "css") {
    // "\x2f/" is "//": Dyn's grammar misreads a string that starts with
    // two slashes as a comment (preview 11).
    return "\x2f/"
  }
  return ""
}
fn comment_toggle(app: *App) {
  token := comment_token(app)
  if #len(token) == 0 {
    notice(app, "No line comment token for this filetype.")
    return
  }
  doc := app.documents.current
  first := buffer.row_at(doc, buffer.start(doc))
  ending := buffer.end(doc)
  if ending > buffer.start(doc) {
    ending -= 1
  }
  last := buffer.row_at(doc, ending)
  // Comment unless every non-blank line is already commented.
  commented := true
  for row in first..=last {
    if blank_row(doc, row) {
      continue
    }
    at := buffer.row_start(doc, row)
    for at < doc.length && (doc.bytes[at] == ' ' || doc.bytes[at] == 9) {
      at += 1
    }
    if at + #len(token) > doc.length || !buffer.equal(doc.bytes[at..at + #len(token)], token) {
      commented = false
    }
  }
  doc.secondary.count = 0
  buffer.checkpoint(doc)
  for row in #reverse(first..=last) {
    if blank_row(doc, row) {
      continue
    }
    at := buffer.row_start(doc, row)
    for at < doc.length && (doc.bytes[at] == ' ' || doc.bytes[at] == 9) {
      at += 1
    }
    if commented {
      remove := #len(token)
      if at + remove < doc.length && doc.bytes[at + remove] == ' ' {
        remove += 1
      }
      doc.anchor = at
      doc.cursor = at + remove
      _ = buffer.replace(doc, "")
    }
    else {
      inserted: [8]u8 = []
      used := copy_text(inserted[..], token)
      add_text(inserted[..], &used, " ")
      doc.anchor = at
      doc.cursor = at
      if !buffer.replace(doc, inserted[..used]) {
        notice(app, "Commenting exceeds document capacity.")
        break
      }
    }
  }
  buffer.checkpoint(doc)
  first_start := buffer.row_start(doc, first)
  last_end := buffer.line_end(doc, buffer.row_start(doc, last))
  doc.anchor = first_start
  doc.cursor = last_end
}
// Ctrl-a / :increment, :decrement: add to the number in (or after the head
// of) each selection on its line, then select the result. Ctrl-x stays
// buffer close, so decrement is the command.
fn number_range(doc: *const buffer.Document, selection: buffer.Selection) buffer.Selection {
  low := selection.anchor
  high := selection.cursor
  if low > high {
    low = selection.cursor
    high = selection.anchor
  }
  ending := buffer.line_end(doc, low)
  at := low
  for at > buffer.line_start(doc, low) && at < doc.length && digit(doc.bytes[at]) && digit(doc.bytes[at - 1]) {
    at -= 1
  }
  for at < ending && !digit(doc.bytes[at]) {
    at += 1
  }
  if at >= ending {
    return buffer.Selection{anchor: 0, cursor: 0}
  }
  start := at
  for at < ending && digit(doc.bytes[at]) {
    at += 1
  }
  if start > 0 && doc.bytes[start - 1] == '-' {
    start -= 1
  }
  return buffer.Selection{anchor: start, cursor: at}
}
fn digit(byte: u8) bool {
  return byte >= '0' && byte <= '9'
}
// Formats value +/- amount for the digits in doc.bytes[low..high].
fn number_text(doc: *const buffer.Document, low: usize, high: usize, amount: usize, decrease: bool, out: []u8) []const u8 {
  negative := doc.bytes[low] == '-'
  value: usize = 0
  at := low
  if negative {
    at += 1
  }
  for at < high && value < 100000000000000 {
    value = value * 10 + #cast(usize, (doc.bytes[at] - '0'))
    at += 1
  }
  down := decrease != negative
  if down && amount > value {
    value = amount - value
    negative = !negative
  }
  else if down {
    value -= amount
  }
  else {
    value += amount
  }
  if value == 0 {
    negative = false
  }
  length: usize = 0
  for {
    out[23 - length] = #cast(u8, (value % 10)) + '0'
    length += 1
    value /= 10
    if value == 0 {
      break
    }
  }
  if negative {
    out[23 - length] = '-'
    length += 1
  }
  return out[24 - length..24]
}
fn increment_selections(app: *App, amount: usize, decrease: bool) {
  doc := app.documents.current
  buffer.checkpoint(doc)
  selections := buffer.collect(doc)
  digits: [24]u8 = []
  for index in 0..selections.count {
    range := number_range(doc, selections.items[index])
    if range.cursor <= range.anchor {
      continue
    }
    text := number_text(doc, range.anchor, range.cursor, amount, decrease, digits[..])
    if buffer.replace_range(doc, range.anchor, range.cursor, text, &selections) {
      selections.items[index] = buffer.Selection{anchor: range.anchor, cursor: range.anchor + #len(text)}
    }
  }
  buffer.store(doc, &selections)
  buffer.checkpoint(doc)
}

// | Alt-| ! Alt-!: open the command prompt with the matching shell command.
fn shell_prompt(app: *App, verb: []const u8) {
  panel(app, Panel.Commands)
  app.prompt_state.length = copy_text(app.prompt_state.text[..], verb)
}
// :pipe (mode 0) replaces each selection with the command's output for it,
// :pipe-to (1) only feeds it, :insert-output (2) and :append-output (3)
// insert the output before or after each selection. Commands run through
// sh in the editor's working directory, one at a time, bounded by lsp_timeout_ms.
fn shell_command(app: *App, mode: u8, command: []const u8) {
  app.prompt_state.panel = Panel.None
  doc := app.documents.current
  if #len(command) == 0 || #len(command) >= 4096 {
    notice(app, "Shell command required.")
    return
  }
  command_text: [4096]u8 = []
  _ = copy_text(command_text[..4095], command)
  directory: [4096]u8 = []
  if host.current_directory(directory[..4095]) == 0 {
    directory[0] = '/'
  }
  reserved := arena_owner.create((buffer.Capacity + 1))
  defer arena_owner.release(reserved)
  output := mem.push_bytes_uninit(reserved, buffer.Capacity + 1)
  buffer.checkpoint(doc)
  selections := buffer.collect(doc)
  for index in 0..selections.count {
    range := buffer.ordered(selections.items[index])
    low := range.anchor
    high := range.cursor
    input: []const u8 = ""
    if mode < 2 {
      input = doc.bytes[low..high]
    }
    empty: [1]u8 = []
    source := &empty[0]
    if #len(input) > 0 {
      source = &doc.bytes[low]
    }
    job := job_open(&command_text[0], &directory[0], source, #len(input), #cast(u32, app.config.lsp_timeout_ms))
    if job == nil {
      notice(app, "Could not start the shell command.")
      break
    }
    status := job_status(job)
    for status == 1 {
      _ = time.sleep(time.Millisecond)
      status = job_status(job)
    }
    if status != 2 {
      error: [4096]u8 = []
      error_length := job_error(job, &error[0], 4096)
      job_close(job)
      if error_length > 0 {
        notice(app, error[..error_length])
      } else if status == 5 {
        notice(app, "Shell command timed out.")
      } else {
        notice(app, "Shell command failed.")
      }
      break
    }
    length := job_output(job, &output[0], #len(output))
    job_close(job)
    if mode == 1 {
      continue
    }
    if !buffer.valid(output[..length]) {
      notice(app, "Shell command produced invalid text.")
      break
    }
    // :pipe replaces the selection; the output commands insert beside it.
    at := low
    end := high
    if mode == 2 {
      end = low
    } else if mode == 3 {
      at = high
    }
    if !buffer.replace_range(doc, at, end, output[..length], &selections) {
      notice(app, "Shell output exceeds document capacity.")
      break
    }
    if mode == 0 {
      selections.items[index] = buffer.Selection{anchor: at, cursor: at + length}
    } else if mode == 2 {
      selections.items[index] = buffer.Selection{anchor: low + length, cursor: high + length}
    } else {
      selections.items[index] = buffer.Selection{anchor: low, cursor: high}
    }
  }
  buffer.store(doc, &selections)
  buffer.checkpoint(doc)
}
// Alt-J: join lines inside each selection like J, then select the inserted
// spaces (up to 32 selections).
fn join_select_spaces(app: *App) {
  doc := app.documents.current
  buffer.checkpoint(doc)
  selections := buffer.collect_ordered(doc)
  spaces := buffer.Selections{}
  for index in 0..selections.count {
    low := selections.items[index].anchor
    high := selections.items[index].cursor
    at := buffer.line_end(doc, low)
    if high <= at {
      high = at
      if high < doc.length {
        high = buffer.line_end(doc, high + 1)
      }
    }
    // Join bottom-up so earlier newline offsets stay valid.
    joins: [32]usize = []
    join_count: usize = 0
    for at < high && at < doc.length && join_count < 32 {
      if doc.bytes[at] == 10 {
        joins[join_count] = at
        join_count += 1
      }
      at = buffer.next(doc, at)
    }
    for join_count > 0 {
      join_count -= 1
      newline := joins[join_count]
      after := newline + 1
      for after < doc.length && (doc.bytes[after] == 32 || doc.bytes[after] == 9) {
        after += 1
      }
      length := doc.length
      if !buffer.replace_range(doc, newline, after, " ", &selections) {
        continue
      }
      buffer.shift(&spaces, newline, after, 1, length)
      if spaces.count < buffer.SelectionCapacity {
        spaces.items[spaces.count] = buffer.Selection{anchor: newline, cursor: newline + 1}
        spaces.count += 1
      }
    }
  }
  if spaces.count > 0 {
    buffer.sort(&spaces)
    buffer.store(doc, &spaces)
  } else {
    buffer.store(doc, &selections)
  }
  buffer.checkpoint(doc)
}
// Jump list: Ctrl-o back, Ctrl-i (Tab in most terminals) forward, Ctrl-s
// saves the current position. Large motions record the position they leave.
// Entry k keeps its offset in mark 992 + k of its document, so edits shift it.
const JumpCapacity: usize = 32
const JumpMarkBase: usize = 992
struct JumpList {
  slots: [32]usize,
  identities: [32]u64,
  // Ring storage: oldest entry at `first`; `at` is the logical position
  // (count when not traveling).
  first, count, at: usize,
}
fn jump_entry(app: *App, logical: usize) usize {
  return (app.jumps.first + logical) % JumpCapacity
}
fn jump_push(app: *App) {
  jumps := &app.jumps
  // A new jump drops the entries ahead of the current position.
  jumps.count = jumps.at
  slot := app.documents.active
  doc := app.documents.current
  if slot >= #len(app.documents.slots) || app.documents.slots[slot].document != doc {
    return
  }
  head := buffer.head(doc)
  if jumps.count > 0 {
    last := jump_entry(app, jumps.count - 1)
    if jumps.slots[last] == slot && jumps.identities[last] == app.documents.slots[slot].identity && doc.marks[JumpMarkBase + last] == head {
      jumps.at = jumps.count
      return
    }
  }
  if jumps.count == JumpCapacity {
    jumps.first = (jumps.first + 1) % JumpCapacity
    jumps.count -= 1
  }
  entry := jump_entry(app, jumps.count)
  jumps.slots[entry] = slot
  jumps.identities[entry] = app.documents.slots[slot].identity
  doc.marks[JumpMarkBase + entry] = head
  jumps.count += 1
  jumps.at = jumps.count
}
fn jump_go(app: *App, logical: usize) bool {
  entry := jump_entry(app, logical)
  slot := app.jumps.slots[entry]
  if slot >= #len(app.documents.slots) || app.documents.slots[slot].document == nil || app.documents.slots[slot].identity != app.jumps.identities[entry] {
    return false
  }
  if slot != app.documents.active {
    activate(app, slot)
  }
  doc := app.documents.slots[slot].document
  position := doc.marks[JumpMarkBase + entry]
  if position > doc.length {
    position = doc.length
  }
  doc.secondary.count = 0
  buffer.move_to(doc, position, false)
  app.jumps.at = logical
  return true
}
fn jump_back(app: *App) {
  jumps := &app.jumps
  if jumps.at == jumps.count {
    jump_push(app)
    jumps.at = jumps.count - 1
  }
  for jumps.at > 0 {
    if jump_go(app, jumps.at - 1) {
      return
    }
    jumps.at -= 1
  }
  notice(app, "At the start of the jump list.")
}
fn jump_forward(app: *App) {
  jumps := &app.jumps
  for jumps.at + 1 < jumps.count {
    if jump_go(app, jumps.at + 1) {
      return
    }
    jumps.at += 1
  }
  notice(app, "At the end of the jump list.")
}
