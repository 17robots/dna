#target(kernel: darwin)
extern fn map_darwin_file "mmap"(address:rawptr, length:usize, protection:i32, flags:i32, fd:i32, offset:i64) *u8
extern fn map_darwin_release "munmap"(bytes:*u8, length:usize) i32
fn map_guard_install() {
  // MAP_RESILIENT_MEDIA handles inaccessible backing pages in the kernel.
}
pub fn dna_map_file(fd:isize, length:u64) *u8 {
  if length==0 || fd<0 {
    return nil
  }
  mapped:=map_darwin_file(nil, #cast(usize, length), 1, 16386, #cast(i32, fd), 0)
  if #cast(isize, mapped)==-1 {
    return nil
  }
  return mapped
}
pub fn dna_unmap_file(bytes:*u8, length:u64) {
  _=map_darwin_release(bytes, #cast(usize, length))
}
pub fn dna_map_damaged() u64 {
  // Source stamp comparison reports truncation; no userspace fault repair runs.
  return 0
}
