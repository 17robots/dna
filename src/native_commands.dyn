// Internal tool commands share bounded literal argument construction.
fn shell_quote(output: []u8, used: *usize, text: []const u8) {
  add_text(output, used, "'")
  for byte in text {
    if byte == 39 {
      add_text(output, used, "'\\''")
    } else {
      single: [1]u8 = [byte]
      add_text(output, used, single[..])
    }
  }
  add_text(output, used, "'")
}

fn language_posix_command(output: []u8, used: *usize, root, helper, verb, name: []const u8) bool {
  used.* = 0
  if 32 + 4 * (#len(root) + #len(helper) + #len(verb) + #len(name)) >= #len(output) {
    return false
  }
  add_text(output, used, "DNA_LANGUAGE_DIR=")
  shell_quote(output, used, root)
  add_text(output, used, " ")
  shell_quote(output, used, helper)
  add_text(output, used, " ")
  shell_quote(output, used, verb)
  if #len(name) > 0 {
    add_text(output, used, " ")
    shell_quote(output, used, name)
  }
  return true
}
