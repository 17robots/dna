// Wake for the next real deadline. Worker notifications handle readiness;
// fallback polling is used only when notification setup failed.
fn deadline_wait(now: u64, deadline: u64, current: i32) i32 {
  if deadline == 0 {
    return current
  }
  if deadline <= now {
    return 0
  }
  remaining := deadline - now
  if remaining < #cast(u64, current) {
    return #cast(i32, remaining)
  }
  return current
}
fn editor_wait_ms(app: *App, notifications: bool) i32 {
  if app.documents.saving.active && !app.documents.saving.waiting {
    return 0
  }
  now := sdl.ticks()
  delay: i32 = 2147483647
  if app.config.reload_config && app.configuration.path_length > 0 {
    delay = deadline_wait(now, app.configuration.watch_due, delay)
  }
  if recovery_allowed(app) && recovery_needed(app) {
    delay = deadline_wait(now, app.recovery.time + recovery_delay(app), delay)
  }
  if app.lsp.pending == 0 && app.lsp.completion_due != 0 && app.view.insert && (app.prompt_state.panel == Panel.None || completion_visible(app)) {
    delay = deadline_wait(now, app.lsp.completion_due, delay)
  }
  delay = deadline_wait(now, app.pointer.hover_due, delay)
  delay = deadline_wait(now, terminal_escape_due(app), delay)
  if app.lsp.pending != 0 {
    delay = deadline_wait(now, app.lsp.deadline, delay)
    delay = deadline_wait(now, completion_preview_due(app), delay)
  }
  for index in 0..8 {
    if app.lsp.servers[index].process != nil {
      delay = deadline_wait(now, app.lsp.servers[index].deadline, delay)
    }
    if app.plugin_state.slots[index].process != nil {
      delay = deadline_wait(now, app.plugin_state.slots[index].deadline, delay)
    }
  }
  delay = lsp_wait_ms(app, delay)
  if !app.picker_state.pending {
    delay = deadline_wait(now, app.picker_state.refresh_due, delay)
  }
  if !notifications && app.picker_state.watching && delay > 250 {
    delay = 250
  }
  // Failed watcher allocation needs a retry even when no worker can notify us.
  if app.disk.retry && delay > 250 {
    delay = 250
  }
  if terminals_waiting_for_exit(app) && delay > 16 {
    delay = 16
  }
  if !notifications && (terminals_running(app) || syntax_waiting(app) || app.project_find.status == 1 || app.picker_state.pending || plugins_running(app) || app.formatting.process != nil || app.language_manager.process != nil || lsp_running(app)) && delay > 16 {
    delay = 16
  }
  if app.view.animation.active {
    delay = deadline_wait(now, app.view.animation.frame + animation_interval(app), delay)
  }
  if app.macro_state.remaining > 0 {
    return 0
  }
  return delay
}
fn lsp_running(app: *const App) bool {
  for index in 0..8 {
    if app.lsp.servers[index].process != nil {
      return true
    }
  }
  return false
}

// One ordered service phase, so input can interrupt between independent work.
// A phase may finish its own transaction; the slice budget is checked afterward.
fn background_step(app: *App, typography: *Typography, phase: *usize) {
  started := operation_begin(app)
  if phase.* == 0 {
    if app.pointer.hover_due != 0 && sdl.ticks() >= app.pointer.hover_due {
      app.pointer.hover_due = 0
      render_request(app, RenderHover)
    }
    if config_watch(app, typography) {
      render_request(app, RenderConfig)
    }
    _ = terminal_escape_tick(app)
    operation_end(app, "config", started)
  } else if phase.* == 1 {
    recovery_tick(app)
    operation_end(app, "recovery", started)
  } else if phase.* == 2 {
    if syntax_tick(app) {
      render_request(app, RenderSyntax)
    }
    operation_end(app, "syntax", started)
  } else if phase.* == 3 {
    if plugin_tick(app) {
      render_request(app, RenderPlugin)
    }
    operation_end(app, "plugins", started)
  } else if phase.* == 4 {
    configured_filetypes(app)
    lsp_auto_start(app)
    completion_tick(app)
    operation_end(app, "language_setup", started)
  } else if phase.* == 5 {
    changed := disk_tick(app)
    if tree_tick(app) {
      changed = true
    }
    if changed {
      render_request(app, RenderDisk)
    }
    operation_end(app, "disk", started)
  } else if phase.* == 6 {
    if lsp_tick(app) {
      render_request(app, RenderLsp)
    }
    completion_tick(app)
    operation_end(app, "lsp", started)
  } else if phase.* == 7 {
    changed := format_tick(app)
    if language_manager_tick(app) {
      changed = true
    }
    save_sequence_tick(app)
    if changed {
      render_request(app, RenderFormat)
    }
    operation_end(app, "format", started)
  } else if phase.* == 8 {
    changed := project_search_tick(app)
    if picker_index_tick(app) {
      changed = true
    }
    if changed {
      render_request(app, RenderSearch)
    }
    operation_end(app, "search", started)
  } else if phase.* == 9 {
    if macro_tick(app, typography) {
      render_request(app, RenderMacro)
    }
    operation_end(app, "macros", started)
  } else {
    if terminal_tick(app) {
      render_request(app, RenderTerminal)
    }
    operation_end(app, "terminal", started)
  }
  phase.* = (phase.* + 1) % 11
}
// Preserve one polled event for the caller; never drain or reorder input.
// At least one phase progresses after each input paint, including under floods.
fn background_input_slice(app: *App, typography: *Typography, phase: *usize, event: *sdl.Event) bool {
  deadline := sdl.ticks() + 2
  for true {
    background_step(app, typography, phase)
    if !app.running {
      return false
    }
    if render_trace_poll(app, event) {
      return true
    }
    if phase.* == 0 || sdl.ticks() >= deadline {
      return false
    }
  }
  return false
}
// Wait between animated frames. With vsync, presenting paces frames to the
// display, so only the configured floor applies; without it, follow the
// display refresh interval. frame_interval_ms stays a lower bound.
fn animation_interval(app: *const App) u64 {
  interval := app.config.frame_interval_ms
  if !app.view.vsync && app.view.refresh_ms > interval {
    interval = app.view.refresh_ms
  }
  // A fractional refresh interval must not wake before its deadline.
  rounded := #cast(u64, interval)
  if #cast(f32, rounded) < interval {
    rounded += 1
  }
  return rounded
}
fn display_refresh(app: *App, window: rawptr) {
  // Native backends may not expose a monitor mode. Keep timer-only animation
  // bounded in that case; synchronized presentation still follows the display.
  app.view.refresh_ms = 1000.0 / 60.0
  mode := sdl.display_mode(sdl.window_display(window))
  if mode != nil && mode.refresh > 1.0 {
    app.view.refresh_ms = 1000.0 / mode.refresh
  }
}
