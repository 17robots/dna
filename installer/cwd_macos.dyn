#target(kernel: darwin)
#link("System")
extern fn installer_getcwd "getcwd"(output:*u8, length:usize) *u8
fn installer_directory(output:[]u8) usize {
  if installer_getcwd(&output[0],#len(output))==nil { return 0 }
  return c.string_length(&output[0],#len(output))
}
fn installer_shell_tools() []const u8 {
  return "export PATH=\"$(brew --prefix coreutils)/libexec/gnubin:$(brew --prefix gnu-tar)/libexec/gnubin:$PATH\"\n"
}
