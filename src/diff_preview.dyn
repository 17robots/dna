// Bounded line-oriented before/after hunk for confirmation dialogs.
fn diff_lines(out: []u8, used: *usize, text: []const u8, prefix: []const u8) {
  at: usize = 0
  lines: usize = 0
  for at < #len(text) && lines < 12 && used.* + 300 < #len(out) {
    end := at
    for end < #len(text) && text[end] != 10 {
      end += 1
    }
    shown := end
    if shown - at > 240 {
      shown = at + 240
      for shown > at && (text[shown] & 192) == 128 {
        shown -= 1
      }
    }
    add_text(out, used, prefix)
    add_text(out, used, text[at..shown])
    if shown < end {
      add_text(out, used, "…")
    }
    add_text(out, used, "\n")
    at = end + 1
    lines += 1
  }
  if at < #len(text) {
    add_text(out, used, "… preview truncated …\n")
  }
}
fn diff_preview(out: []u8, used: *usize, before: []const u8, after: []const u8) {
  prefix: usize = 0
  for prefix < #len(before) && prefix < #len(after) && before[prefix] == after[prefix] {
    prefix += 1
  }
  if prefix == #len(before) && prefix == #len(after) {
    add_text(out, used, "(unchanged)\n")
    return
  }
  start := prefix
  for start > 0 && before[start - 1] != 10 {
    start -= 1
  }
  old_end := #len(before)
  new_end := #len(after)
  for old_end > prefix && new_end > prefix && before[old_end - 1] == after[new_end - 1] {
    old_end -= 1
    new_end -= 1
  }
  for old_end < #len(before) && before[old_end] != 10 {
    old_end += 1
  }
  for new_end < #len(after) && after[new_end] != 10 {
    new_end += 1
  }
  if old_end < #len(before) {
    old_end += 1
  }
  if new_end < #len(after) {
    new_end += 1
  }
  row: usize = 1
  for at in 0..start {
    if before[at] == 10 {
      row += 1
    }
  }
  add_text(out, used, "@@ line ")
  add_number(out, used, row)
  add_text(out, used, " @@\n")
  diff_lines(out, used, before[start..old_end], "- ")
  diff_lines(out, used, after[start..new_end], "+ ")
}
