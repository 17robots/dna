#target(kernel: linux)
// Called by the owning thread before launching allocation-free load workers.
// libc selects the correct affinity syscall on x86-64 and arm64 alike.
extern fn load_affinity "sched_getaffinity"(pid: i32, size: usize, mask: *u8) i32
fn load_cpus() usize {
  mask: [128]u8 = []
  if load_affinity(0, #len(mask), &mask[0]) != 0 {
    return 1
  }
  count: usize = 0
  for value in mask {
    byte := value
    for byte != 0 {
      count += #cast(usize, byte & 1)
      byte >>= 1
    }
  }
  if count == 0 {
    return 1
  }
  return count
}
