// Frozen native texture raster and general blend before clipped span rendering.
fn reference_texture_blend(surface: *software.Surface, x, y: i32, r, g, b, a: u8) {
  if a==0 {
    return
  }
  clip:=native_clip(surface.*)
  if !ui.contains(clip, x, y) {
    return
  }
  at:=#cast(usize, y)*surface.stride+#cast(usize, x)*4
  if a==255 {
    surface.pixels[at]=r
    surface.pixels[at+1]=g
    surface.pixels[at+2]=b
    surface.pixels[at+3]=255
    return
  }
  alpha:=#cast(u32, a)
  old:=#cast(u32, surface.pixels[at+3])
  denominator:=alpha*255+old*(255-alpha)
  channels:[3]u8=[r, g, b]
  for i in 0..3 {
    surface.pixels[at+i]=#cast(u8, (#cast(u32, channels[i])*alpha*255+#cast(u32, surface.pixels[at+i])*old*(255-alpha)+denominator/2)/denominator)
  }
  surface.pixels[at+3]=#cast(u8, (denominator+127)/255)
}
fn reference_texture(renderer: rawptr, texture: rawptr, source, destination: *const Rect) bool {
  if texture==nil {
    return false
  }
  t:=#cast(*NativeTexture, texture)
  src:=Rect{width:#cast(f32, t.width), height:#cast(f32, t.height)}
  dst:=Rect{width:#cast(f32, native_gui.viewport.width)/native_gui.sx, height:#cast(f32, native_gui.viewport.height)/native_gui.sy}
  if source!=nil {
    src=source.*
  }
  if destination!=nil {
    dst=destination.*
  }
  if src.width<=0.0 || src.height<=0.0 || dst.width<=0.0 || dst.height<=0.0 {
    return false
  }
  surface:=native_surface()
  width:=#cast(i32, dst.width*native_gui.sx)
  height:=#cast(i32, dst.height*native_gui.sy)
  for y in 0..height {
    for x in 0..width {
      tx:=#cast(i32, src.x+#cast(f32, x)*src.width/#cast(f32, width))
      ty:=#cast(i32, src.y+#cast(f32, y)*src.height/#cast(f32, height))
      if tx>=0 && ty>=0 && tx<t.width && ty<t.height {
        at:=(#cast(usize, ty)*#cast(usize, t.width)+#cast(usize, tx))*4
        reference_texture_blend(&surface, native_gui.viewport.x+#cast(i32, dst.x*native_gui.sx)+x, native_gui.viewport.y+#cast(i32, dst.y*native_gui.sy)+y, t.pixels[at], t.pixels[at+1], t.pixels[at+2], #cast(u8, (#cast(u32, t.pixels[at+3])*#cast(u32, t.alpha)+127)/255))
      }
    }
  }
  return true
}
