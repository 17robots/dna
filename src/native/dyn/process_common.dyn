// Process helpers every desktop kernel shares.

struct PollDescriptor { fd: i32, events, returned: i16 }

fn proc_watch(fd: i32, writing: i32) {
  dna_watch(fd, writing)
}

fn proc_unwatch(fd: i32) {
  dna_unwatch(fd)
}

fn proc_none() OwnedProcess {
  return OwnedProcess{ input: -1, output: -1, error: -1 }
}

fn proc_take(child: *OwnedProcess) OwnedProcess {
  owned := child.*
  child.* = proc_none()
  return owned
}

fn proc_log(log: []u8, used: *usize, bytes: str) {
  amount := bytes.len
  if amount >= log.len {
    amount = log.len - 1
  }
  keep := used.*
  if keep > log.len - 1 - amount {
    keep = log.len - 1 - amount
  }
  if keep > 0 {
    _ = proc_move(&log[0], &log[used.* - keep], keep)
  }
  if amount > 0 {
    _ = copy(&log[keep], &bytes[bytes.len - amount], amount)
  }
  used.* = keep + amount
  log[used.*] = 0
}

fn proc_close_fds(fds: []i32) {
  for fd in fds {
    if fd >= 0 {
      _ = rec_close(fd)
    }
  }
}
