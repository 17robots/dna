#target(kernel: linux)
pub fn dna_plugin_install(manifest, executable, root, name, leaf: *const u8) i32 {
  return install_exchange_install(manifest, executable, root, name, leaf)
}
pub fn dna_plugin_remove(root, name: *const u8) i32 {
  return install_exchange_remove(root, name)
}
pub fn dna_plugin_rollback(root, name: *const u8) i32 {
  return install_exchange_rollback(root, name)
}
pub fn dna_plugin_resolve(path: *const u8, output: *u8, capacity: usize) i32 {
  return install_resolve_direct(path, output, capacity)
}
