    "popup_transitions" => { return result.popup_transitions }
    "mouse_enabled" => { return result.mouse_enabled }
    "picker_preview" => { return result.picker_preview }
    "syntax_enabled" => { return result.syntax_enabled }
    "recovery_enabled" => { return result.recovery_enabled }
    "reload_clean_buffers" => { return result.reload_clean_buffers }
    "insert_tabs" => { return result.insert_tabs }
    "final_newline" => { return result.final_newline }
    "trim_trailing_whitespace" => { return result.trim_trailing_whitespace }
    "automatic_completion" => { return result.automatic_completion }
    "reload_config" => { return result.reload_config }
    "equalize_splits" => { return result.equalize_splits }
    "default_servers" => { return result.default_servers }
    "explorer_close_on_open" => { return result.explorer_close_on_open }
    _ => { return false }
  }
}
fn set_number(result: *Settings, key: str, value: f32) bool {
  case key {
    "font_size" => { result.font_size = value }
    "line_height" => { result.line_height = value }
    "indent_width" => { result.indent_width = #cast(usize, value) }
    "document_padding" => { result.document_padding = value }
    "scroll_margin" => { result.scroll_margin = value }
    "horizontal_scroll_margin" => { result.horizontal_scroll_margin = value }
    "cursor_animation_ms" => { result.cursor_animation_ms = value }
    "scroll_animation_ms" => { result.scroll_animation_ms = value }
    "popup_animation_ms" => { result.popup_animation_ms = value }
    "cursor_thickness" => { result.cursor_thickness = value }
    "split_ratio" => { result.split_ratio = value }
    "popup_width" => { result.popup_width = value }
    "popup_height" => { result.popup_height = value }
    "popup_padding" => { result.popup_padding = value }
    "recovery_interval_ms" => { result.recovery_interval_ms = value }
    "lsp_timeout_ms" => { result.lsp_timeout_ms = value }
    "lsp_change_delay_ms" => { result.lsp_change_delay_ms = value }
    "plugin_timeout_ms" => { result.plugin_timeout_ms = value }
    "frame_interval_ms" => { result.frame_interval_ms = value }
    "completion_delay_ms" => { result.completion_delay_ms = value }
    "cursor_trail_size" => { result.cursor_trail_size = value }
    _ => { return false }
  }
  return true
}
pub fn option_number(result: *const Settings, key: str) f32 {
  case key {
    "font_size" => { return result.font_size }
    "line_height" => { return result.line_height }
    "indent_width" => { return #cast(f32, result.indent_width) }
    "document_padding" => { return result.document_padding }
    "scroll_margin" => { return result.scroll_margin }
    "horizontal_scroll_margin" => { return result.horizontal_scroll_margin }
    "cursor_animation_ms" => { return result.cursor_animation_ms }
    "scroll_animation_ms" => { return result.scroll_animation_ms }
    "popup_animation_ms" => { return result.popup_animation_ms }
    "cursor_thickness" => { return result.cursor_thickness }
    "split_ratio" => { return result.split_ratio }
    "popup_width" => { return result.popup_width }
    "popup_height" => { return result.popup_height }
    "popup_padding" => { return result.popup_padding }
    "recovery_interval_ms" => { return result.recovery_interval_ms }
    "lsp_timeout_ms" => { return result.lsp_timeout_ms }
    "lsp_change_delay_ms" => { return result.lsp_change_delay_ms }
    "plugin_timeout_ms" => { return result.plugin_timeout_ms }
    "frame_interval_ms" => { return result.frame_interval_ms }
    "completion_delay_ms" => { return result.completion_delay_ms }
    "cursor_trail_size" => { return result.cursor_trail_size }
    _ => { return 0.0 }
  }
}
fn set_text(result: *Settings, key: str, value: str) bool {
  case key {
    "font" => {
      result.font = value
      result.font_length = value.len
    }
    "shell" => {
      result.shell = value
      result.shell_length = value.len
    }
    "font_family" => { result.font_family = value }
    "fallback_font" => { result.fallback = value }
    "build_command" => { result.build_command = value }
    "test_command" => { result.test_command = value }
    "run_command" => { result.run_command = value }
    // A built-in theme name or a theme file path.
    "theme" => {
      if buffer.equal(value, "light") {
        result.light_theme = true
      } else if !buffer.equal(value, "charcoal") {
        result.theme_path = value
      }
    }
    _ => { return false }
  }
  return true
}
pub fn option_text(result: *const Settings, key: str) str {
  case key {
    "font" => { return result.font }
    "shell" => { return result.shell }
    "font_family" => { return result.font_family }
    "fallback_font" => { return result.fallback }
    "build_command" => { return result.build_command }
    "test_command" => { return result.test_command }
    "run_command" => { return result.run_command }
    "theme" => {
      if result.theme_path.len > 0 { return result.theme_path }
      if result.light_theme { return "light" }
      return "charcoal"
    }
    _ => { return "" }
  }
}
// choice is the index of the name in the option's choices.
pub fn set_choice(result: *Settings, key: str, choice: u8) bool {
  case key {
    "close_last_buffer" => {
      case choice {
        0 => { result.close_last_buffer = .Auto }
        1 => { result.close_last_buffer = .Quit }
        _ => { result.close_last_buffer = .Keep }
      }
    }
    "keymap" => { result.vim_keys = choice == 1 }
    "frontend" => {
      case choice {
        0 => { result.frontend = .Auto }
        1 => { result.frontend = .Gui }
        _ => { result.frontend = .Tui }
      }
    }
    "explorer_style" => {
      case choice {
        0 => { result.explorer_style = .Buffer }
        _ => { result.explorer_style = .Tree }
      }
    }
    "picker_style" => {
      case choice {
        0 => { result.picker_style = .Full }
        1 => { result.picker_style = .Compact }
        _ => { result.picker_style = .Dropdown }
      }
    }
    _ => { return false }
  }
  return true
}
pub fn option_choice(result: *const Settings, key: str) u8 {
  case key {
    "close_last_buffer" => { return #cast(u8, result.close_last_buffer) }
    "keymap" => {
      if result.vim_keys { return 1 }
      return 0
    }
    "frontend" => { return #cast(u8, result.frontend) }
    "explorer_style" => { return #cast(u8, result.explorer_style) }
    "picker_style" => { return #cast(u8, result.picker_style) }
    _ => { return 0 }
  }
}

fn known_section(section: str) bool {
  for index in 0..OptionCount {
    if buffer.equal(options[index].section, section) { return true }
  }
  return false
}
// The option KEY names inside [SECTION], or a name no option has.
fn section_key(section: str, key: str) str {
  if section.len == 0 { return key }
  for index in 0..OptionCount {
    spec := options[index]
    if buffer.equal(spec.section, section) && buffer.equal(spec.local, key) { return spec.key }
  }
  // keymap was read from [editor] before [modules] existed.
  if buffer.equal(section, "editor") && buffer.equal(key, "keymap") { return "keymap" }
  return "!unknown-section-setting"
}
