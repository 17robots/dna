use "std/mem"
use "std/io"

records: *mem.Arena
live: i32
fn rec_malloc(size: usize) rawptr {
  live += 1
  return #cast(rawptr, &mem.push_array(u64, records, (size + 7) / 8)[0])
}
fn rec_free(pointer: rawptr) {
  _ = pointer
  live -= 1
}
struct Handoff { lock, condition: rawptr, ready: bool, waiting: sync.AtomicU32, value: i32 }
fn worker(context: rawptr) i32 {
  state := #cast(*Handoff, context)
  dna_mutex_lock(state.lock)
  sync.store_u32(&state.waiting, 1)
  for !state.ready {
    dna_condition_wait(state.condition, state.lock)
  }
  state.value += 1
  dna_mutex_unlock(state.lock)
  return 37
}
fn main() {
  records = mem.arena_create(65536)
  defer mem.arena_release(records)
  if dna_thread_create(nil, nil) != nil {
    #panic("nil callback accepted")
  }
  for index in 0..32 {
    _ = index
    state := Handoff{lock: dna_mutex_create(), condition: dna_condition_create()}
    if state.lock == nil || state.condition == nil {
      #panic("synchronization allocation")
    }
    thread := dna_thread_create(worker, #cast(rawptr, &state))
    if thread == nil {
      #panic("thread creation")
    }
    for sync.load_u32(&state.waiting) == 0 {
      _ = time.sleep(time.Millisecond)
    }
    dna_mutex_lock(state.lock)
    state.ready = true
    dna_condition_signal(state.condition)
    dna_mutex_unlock(state.lock)
    result: i32 = 0
    dna_thread_join(thread, &result)
    if result != 37 || state.value != 1 {
      #panic("handoff or join result")
    }
    dna_condition_destroy(state.condition)
    dna_mutex_destroy(state.lock)
    if live != 0 {
      #panic("thread record leak")
    }
  }
  _ = io.println(io.stdout(), "PASS threads: condition handoff, callback result, repeated lifecycle")
}
