// The GUI backend: SDL3 itself. platform.dyn's public functions call these
// unless the terminal frontend is active. Builds without the GUI replace this
// file with modules/stubs/platform_sdl.dyn and link no SDL.
#link("SDL3")
extern fn sdl_system_cursor "SDL_CreateSystemCursor"(id: u32) rawptr
extern fn sdl_set_cursor "SDL_SetCursor"(cursor: rawptr) bool
extern fn sdl_destroy_cursor "SDL_DestroyCursor"(cursor: rawptr)
extern fn sdl_render_vsync "SDL_SetRenderVSync"(renderer: rawptr, vsync: i32) bool
extern fn sdl_key_from_scancode "SDL_GetKeyFromScancode"(scancode: u32, modifiers: u16, key_event: bool) u32
extern fn sdl_window_display "SDL_GetDisplayForWindow"(window: rawptr) u32
extern fn sdl_display_mode "SDL_GetCurrentDisplayMode"(display: u32) *const DisplayMode
pub extern fn init "SDL_Init"(flags: u32) bool
pub extern fn quit "SDL_Quit"()
extern fn sdl_create_window "SDL_CreateWindow"(title: *const u8, width: i32, height: i32, flags: u64) rawptr
extern fn sdl_destroy_window "SDL_DestroyWindow"(window: rawptr)
extern fn sdl_create_renderer "SDL_CreateRenderer"(window: rawptr, name: *const u8) rawptr
extern fn sdl_destroy_renderer "SDL_DestroyRenderer"(renderer: rawptr)
extern fn sdl_color "SDL_SetRenderDrawColor"(renderer: rawptr, r: u8, g: u8, b: u8, a: u8) bool
extern fn sdl_clear "SDL_RenderClear"(renderer: rawptr) bool
extern fn sdl_present "SDL_RenderPresent"(renderer: rawptr) bool
extern fn sdl_scale "SDL_SetRenderScale"(renderer: rawptr, x: f32, y: f32) bool
extern fn sdl_fill "SDL_RenderFillRect"(renderer: rawptr, rectangle: *const Rect) bool
extern fn sdl_geometry "SDL_RenderGeometry"(renderer: rawptr, texture: rawptr, vertices: *const Vertex, count: i32, indices: *const i32, index_count: i32) bool
extern fn sdl_size "SDL_GetRenderOutputSize"(renderer: rawptr, width: *i32, height: *i32) bool
extern fn sdl_wait "SDL_WaitEvent"(event: *Event) bool
extern fn sdl_start_text "SDL_StartTextInput"(window: rawptr) bool
extern fn sdl_stop_text "SDL_StopTextInput"(window: rawptr) bool
extern fn sdl_push "SDL_PushEvent"(event: *Event) bool
extern fn sdl_display_scale "SDL_GetWindowDisplayScale"(window: rawptr) f32
extern fn sdl_wait_timeout "SDL_WaitEventTimeout"(event: *Event, milliseconds: i32) bool
extern fn sdl_title "SDL_SetWindowTitle"(window: rawptr, title: *const u8) bool
extern fn sdl_clipboard_set "SDL_SetClipboardText"(text: *const u8) bool
extern fn sdl_clipboard_get "SDL_GetClipboardText"() *const u8
extern fn sdl_free "SDL_free"(pointer: rawptr)
extern fn sdl_clip "SDL_SetRenderClipRect"(renderer: rawptr, rectangle: *const PixelRect) bool
extern fn sdl_poll "SDL_PollEvent"(event: *Event) bool
extern fn sdl_create_texture "SDL_CreateTexture"(renderer: rawptr, format: u32, access: i32, width: i32, height: i32) rawptr
extern fn sdl_destroy_texture "SDL_DestroyTexture"(texture: rawptr)
extern fn sdl_texture_blend "SDL_SetTextureBlendMode"(texture: rawptr, mode: u32) bool
extern fn sdl_texture_alpha "SDL_SetTextureAlphaMod"(texture: rawptr, alpha: u8) bool
extern fn sdl_target "SDL_SetRenderTarget"(renderer: rawptr, texture: rawptr) bool
extern fn sdl_render_texture "SDL_RenderTexture"(renderer: rawptr, texture: rawptr, source: *const Rect, destination: *const Rect) bool
extern fn sdl_viewport "SDL_SetRenderViewport"(renderer: rawptr, rectangle: *const PixelRect) bool
extern fn sdl_window_size "SDL_GetWindowSize"(window: rawptr, width: *i32, height: *i32) bool
extern fn sdl_modifiers "SDL_GetModState"() u16
extern fn sdl_clear_composition "SDL_ClearComposition"(window: rawptr) bool
extern fn sdl_text_area "SDL_SetTextInputArea"(window: rawptr, area: *const PixelRect, cursor: i32) bool
extern fn sdl_set_window_size "SDL_SetWindowSize"(window: rawptr, width: i32, height: i32) bool
extern fn sdl_sync_window "SDL_SyncWindow"(window: rawptr) bool
