fn text_hit_smoke() {
  // A Hebrew/Arabic cluster spans two source bytes and twenty visual pixels.
  hit:=ttf.Substring{flags:5, offset:10, length:2, x:100, width:20}
  if text_hit_offset(&hit, 102.0)!=12 || text_hit_offset(&hit, 118.0)!=10 {
    #panic("RTL clicks must follow logical source direction")
  }
  if text_caret_x(&hit, true)!=120.0 || text_caret_x(&hit, false)!=100.0 {
    #panic("RTL insert caret uses leading edge while block covers the glyph")
  }
  hit.flags=4
  if text_hit_offset(&hit, 102.0)!=10 || text_hit_offset(&hit, 118.0)!=12 {
    #panic("LTR clicks retain their source direction")
  }
  if text_caret_x(&hit, true)!=100.0 || text_caret_x(&hit, false)!=100.0 {
    #panic("LTR insert and block carets retain their visual origin")
  }
  hit.length=0
  hit.flags=5
  if text_hit_offset(&hit, 102.0)!=10 || text_hit_offset(&hit, 118.0)!=10 {
    #panic("line edge clicks retain the zero-length caret")
  }
}
