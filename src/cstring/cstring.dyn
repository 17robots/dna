// Encode a C string in borrowed storage without allocating or changing storage
// on input/capacity failure. Paths remain byte strings on POSIX.
use "std/c"
use "std/parse" parse
use "std/mem"

pub fn bounded(destination: []u8, source: []const u8) c.StringResult {
  if #len(source) == #cast(usize, -1) {
    return c.StringResult{ failure: parse.Failure{ kind: parse.Kind.Overflow } }
  }
  for byte in source {
    if byte == 0 {
      return c.StringResult{ failure: parse.Failure{ kind: parse.Kind.Syntax } }
    }
  }
  required := #len(source) + 1
  if #len(destination) < required {
    return c.StringResult{ failure: parse.Failure{ kind: parse.Kind.Capacity }, required: required }
  }
  _ = mem.move(destination, source)
  destination[#len(source)] = 0
  return c.StringResult{ value: &destination[0], required: required }
}
