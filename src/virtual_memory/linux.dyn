#target(kernel: linux)
#link("c")
extern fn vm_getpagesize "getpagesize"() i32
fn native_reserve(size: usize, sparse: bool) mem.ArenaResult {
  _ = sparse
  // Anonymous private RW pages, without reserving swap (MAP_NORESERVE).
  address := #syscall(9, 0, size, 3, 16418, -1, 0)
  if address < 0 {
    return mem.ArenaResult{error: mem.ErrorKind.System, code: address}
  }
  return mem.ArenaResult{arena: mem.Arena{data: (#cast(*u8) address)[..size], owns_memory: true}, ok: true}
}
fn native_commit(address: *u8, length: usize) bool {
  _ = address
  _ = length
  return true
}
fn native_discard(address: *u8, length: usize) bool {
  return #syscall(28, address, length, 4) == 0
}
fn native_page_size() usize {
  size := vm_getpagesize()
  if size <= 0 {
    return 0
  }
  return #cast(usize) size
}
fn native_small_pages(memory: []u8) {
  _ = #syscall(28, &memory[0], #len(memory), 15)
}
