fn expand_home(path: []const u8, output: []u8) []const u8 {
  if #len(path) > 0 && path[0] == '~' && (#len(path) == 1 || path[1] == '/') {
    home_storage: [4096]u8 = [] result := process.environment("HOME", home_storage[..])
    if !result.ok || !result.found || #len(result.value) + #len(path) >= #len(output) { return output[..0] }
    used: usize = 0 add_text(output, &used, result.value)
    if #len(path) == 1 { add_text(output, &used, "/") } else { add_text(output, &used, path[1..]) }
    return output[..used]
  }
  length := copy_text(output, path) return output[..length]
}
fn completion_refresh(app: *App) {
  app.completion_count = 0 app.completion_selected = 0 app.completion_chosen = false app.completion_error = false
  expanded: [4096]u8 = [] path := expand_home(app.prompt[..app.prompt_length], expanded[..])
  split := #len(path) for split > 0 && path[split - 1] != '/' { split -= 1 }
  app.completion_prefix_length = copy_text(app.completion_prefix[..], path[..split])
  directory: []const u8 = "." if split > 0 { directory = path[..split] }
  fragment := path[split..]
  storage: [8192]u8 = [] opened := fs.open_directory(directory, storage[..])
  if !opened.ok { app.completion_error = true return }
  defer _ = fs.close_directory(&opened.directory)
  for app.completion_count < 128 {
    item := fs.directory_next(&opened.directory) if !item.ok { app.completion_error = item.error != 0 break }
    if #len(item.name) < #len(fragment) || #len(item.name) >= 512 || !utf8.valid(item.name) { continue }
    if !buffer.equal(item.name[..#len(fragment)], fragment) { continue }
    valid: bool = true for byte in item.name { if byte < 32 { valid = false } } if !valid { continue }
    entry := &app.completions[app.completion_count]
    entry.length = copy_text(entry.name[..], item.name) entry.directory = item.kind == 4 app.completion_count += 1
  }
}
fn complete_path(app: *App) bool {
  if app.completion_count == 0 { return false }
  entry := &app.completions[app.completion_selected]
  required := app.completion_prefix_length + entry.length + 1
  if required >= 4096 { notice(app, "Completed path is too long.") return false }
  app.prompt_length = copy_text(app.prompt[..], app.completion_prefix[..app.completion_prefix_length])
  add_text(app.prompt[..], &app.prompt_length, entry.name[..entry.length])
  if entry.directory { add_text(app.prompt[..], &app.prompt_length, "/") }
  completion_refresh(app) return true
}
fn open_prompt(app: *App) {
  if app.completion_chosen { _ = complete_path(app) }
  expanded: [4096]u8 = [] path := expand_home(app.prompt[..app.prompt_length], expanded[..])
  info := files.metadata(path)
  if info.ok && (info.mode & 61440) == 16384 {
    app.prompt_length = copy_text(app.prompt[..], path)
    if app.prompt_length > 0 && app.prompt[app.prompt_length - 1] != '/' { add_text(app.prompt[..], &app.prompt_length, "/") }
    completion_refresh(app) return
  }
  if !info.ok && app.completion_count > 0 {
    if complete_path(app) {
      finished: [4096]u8 = [] chosen := expand_home(app.prompt[..app.prompt_length], finished[..])
      if app.prompt_length > 0 && app.prompt[app.prompt_length - 1] == '/' { return }
      open_file(app, chosen)
    }
    return
  }
  open_file(app, path)
}
fn command_submit(app: *App, typography: *Typography) {
  text := app.prompt[..app.prompt_length]
  split: usize = 0 for split < #len(text) && text[split] != ' ' { split += 1 }
  verb := text[..split] argument := split for argument < #len(text) && text[argument] == ' ' { argument += 1 }
  if (buffer.equal(verb, "open") || buffer.equal(verb, "e")) && argument < #len(text) {
    storage: [4096]u8 = [] path := expand_home(text[argument..], storage[..]) open_file(app, path) return
  }
  if (buffer.equal(verb, "write") || buffer.equal(verb, "w")) && argument < #len(text) {
    output: [4096]u8 = [] destination := expand_home(text[argument..], output[..]) save_file(app, destination) return
  }
  if buffer.equal(text, "w") || buffer.equal(text, "write") { action(app, typography, 1) }
  else if buffer.equal(text, "q") || buffer.equal(text, "quit") { action(app, typography, 16) }
  else if buffer.equal(text, "e") || buffer.equal(text, "open") { action(app, typography, 0) }
  else if buffer.equal(text, "b") || buffer.equal(text, "buffers") { action(app, typography, 21) }
  else if buffer.equal(text, "bn") { action(app, typography, 22) }
  else if buffer.equal(text, "bp") { action(app, typography, 23) }
  else if buffer.equal(text, "bd") { action(app, typography, 24) }
  else if buffer.equal(text, "enew") { action(app, typography, 17) }
  else { matches(app) if app.match_count > 0 { action(app, typography, app.matches[app.selected]) } }
}
