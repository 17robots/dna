#target(kernel: darwin)
#link("System")
use "std/c" cstrings

// Darwin arm64 uses the 64-bit inode ABI without the Intel $INODE64 suffix.
// Layouts: apple-oss-distributions/xnu bsd/sys/{stat,dirent,cdefs}.h.
struct DarwinStat {
  device: i32, mode, links: u16, inode: u64,
  uid, gid: u32, special_device: i32,
  access_seconds, access_nanoseconds, modified_seconds, modified_nanoseconds: i64,
  changed_seconds, changed_nanoseconds, birth_seconds, birth_nanoseconds: i64,
  size, blocks: i64, block_size: i32, flags, generation: u32,
  spare: i32, spare_quad: [2]i64,
}
struct DarwinEntry {
  inode, seek: u64, record_length, name_length: u16, kind: u8, name: [1024]u8,
}
pub struct Directory { handle: *u8, storage: []u8 }
extern fn darwin_open "open"(path: *const u8, flags: i32, ...) i32
extern fn darwin_errno "__error"() *i32
extern fn darwin_stat "stat"(path: *const u8, result: *DarwinStat) i32
extern fn darwin_lstat "lstat"(path: *const u8, result: *DarwinStat) i32
extern fn darwin_fstat "fstat"(file: i32, result: *DarwinStat) i32
extern fn darwin_opendir "opendir"(path: *const u8) *u8
extern fn darwin_readdir "readdir"(directory: *u8) *DarwinEntry
extern fn darwin_closedir "closedir"(directory: *u8) i32
extern fn darwin_rename "rename"(source: *const u8, destination: *const u8) i32
extern fn darwin_rename_exclusive "renamex_np"(source: *const u8, destination: *const u8, flags: u32) i32
extern fn darwin_unlink "unlink"(path: *const u8) i32
extern fn darwin_mkdir "mkdir"(path: *const u8, mode: u16) i32
extern fn darwin_rmdir "rmdir"(path: *const u8) i32
extern fn darwin_readlink "readlink"(path: *const u8, destination: *u8, capacity: usize) isize
extern fn darwin_fchmod "fchmod"(file: i32, mode: u16) i32

fn darwin_path(path: []const u8, storage: []u8) *const u8 {
  if #len(path) == 0 {
    return nil
  }
  encoded := cstrings.string_from_bytes(storage, path)
  if !encoded.ok {
    return nil
  }
  return encoded.value
}
fn darwin_error() isize {
  return 0 - #cast(isize) darwin_errno().*
}
fn darwin_result(value: i32) Result {
  if value == 0 {
    return Result{ok: true}
  }
  code := darwin_error()
  return Result{error: code, kind: errors.darwin(code)}
}
fn darwin_metadata(value: i32, info: *const DarwinStat) Metadata {
  if value != 0 {
    code := darwin_error()
    return Metadata{error: code, kind: errors.darwin(code)}
  }
  return Metadata{size: #cast(u64) info.size, inode: info.inode,
    device: #cast(u64) #cast(u32) info.device, mode: info.mode, ok: true}
}
pub fn metadata(path: []const u8) Metadata {
  storage: [4096]u8 = []
  name := darwin_path(path, storage[..])
  if name == nil {
    return Metadata{error: -22, kind: errors.Kind.InvalidInput}
  }
  info := DarwinStat{}
  return darwin_metadata(darwin_stat(name, &info), &info)
}
pub fn metadata_nofollow(path: []const u8) Metadata {
  storage: [4096]u8 = []
  name := darwin_path(path, storage[..])
  if name == nil {
    return Metadata{error: -22, kind: errors.Kind.InvalidInput}
  }
  info := DarwinStat{}
  return darwin_metadata(darwin_lstat(name, &info), &info)
}
pub fn file_metadata(file: *const File) Metadata {
  if !is_open(file) {
    return Metadata{error: -9, kind: errors.Kind.InvalidState}
  }
  info := DarwinStat{}
  return darwin_metadata(darwin_fstat(#cast(i32) file.descriptor, &info), &info)
}
pub fn open_directory(path: []const u8, storage: []u8) DirectoryResult {
  if #len(storage) < 1024 {
    return DirectoryResult{error: -22, kind: errors.Kind.InvalidInput}
  }
  path_storage: [4096]u8 = []
  name := darwin_path(path, path_storage[..])
  if name == nil {
    return DirectoryResult{error: -22, kind: errors.Kind.InvalidInput}
  }
  handle := darwin_opendir(name)
  if handle == nil {
    code := darwin_error()
    return DirectoryResult{error: code, kind: errors.darwin(code)}
  }
  return DirectoryResult{directory: Directory{handle: handle, storage: storage}, ok: true}
}
// Returned names borrow caller storage until the next directory_next call.
pub fn directory_next(directory: *Directory) DirectoryEntry {
  if directory.handle == nil {
    return DirectoryEntry{error: -9, error_kind: errors.Kind.InvalidState}
  }
  for {
    darwin_errno().* = 0
    entry := darwin_readdir(directory.handle)
    if entry == nil {
      code := darwin_error()
      if code == -4 {
        continue
      }
      return DirectoryEntry{error: code, error_kind: errors.darwin(code)}
    }
    length := #cast(usize) entry.name_length
    if length >= 1024 || length > #len(directory.storage) || entry.name[length] != 0 {
      return DirectoryEntry{error: -5, error_kind: errors.Kind.System}
    }
    dot := length == 1 && entry.name[0] == '.'
    dot_dot := length == 2 && entry.name[0] == '.' && entry.name[1] == '.'
    if !dot && !dot_dot {
      for i in 0..length {
        directory.storage[i] = entry.name[i]
      }
      return DirectoryEntry{name: directory.storage[..length], kind: entry.kind, ok: true}
    }
  }
  return DirectoryEntry{}
}
pub fn close_directory(directory: *Directory) Result {
  if directory.handle == nil {
    return Result{error: -9, kind: errors.Kind.InvalidState}
  }
  handle := directory.handle
  directory.* = Directory{}
  return darwin_result(darwin_closedir(handle))
}
fn darwin_move(source: []const u8, destination: []const u8, exclusive: bool) Result {
  source_storage: [4096]u8 = []
  destination_storage: [4096]u8 = []
  old_name := darwin_path(source, source_storage[..])
  new_name := darwin_path(destination, destination_storage[..])
  if old_name == nil || new_name == nil {
    return Result{error: -22, kind: errors.Kind.InvalidInput}
  }
  if exclusive {
    return darwin_result(darwin_rename_exclusive(old_name, new_name, 4))
  }
  return darwin_result(darwin_rename(old_name, new_name))
}
pub fn rename(source: []const u8, destination: []const u8) Result {
  return darwin_move(source, destination, false)
}
pub fn rename_noreplace(source: []const u8, destination: []const u8) Result {
  return darwin_move(source, destination, true)
}
pub fn remove(path: []const u8) Result {
  storage: [4096]u8 = []
  name := darwin_path(path, storage[..])
  if name == nil {
    return Result{error: -22, kind: errors.Kind.InvalidInput}
  }
  return darwin_result(darwin_unlink(name))
}
pub fn make_directory(path: []const u8, mode: usize) Result {
  storage: [4096]u8 = []
  name := darwin_path(path, storage[..])
  if name == nil || mode > 65535 {
    return Result{error: -22, kind: errors.Kind.InvalidInput}
  }
  return darwin_result(darwin_mkdir(name, #cast(u16) mode))
}
pub fn remove_directory(path: []const u8) Result {
  storage: [4096]u8 = []
  name := darwin_path(path, storage[..])
  if name == nil {
    return Result{error: -22, kind: errors.Kind.InvalidInput}
  }
  return darwin_result(darwin_rmdir(name))
}
pub fn read_link(path: []const u8, destination: []u8) PathResult {
  storage: [4096]u8 = []
  name := darwin_path(path, storage[..])
  if name == nil || #len(destination) == 0 {
    return PathResult{error: -22, kind: errors.Kind.InvalidInput}
  }
  length := darwin_readlink(name, &destination[0], #len(destination))
  if length < 0 {
    code := darwin_error()
    return PathResult{error: code, kind: errors.darwin(code)}
  }
  if #cast(usize) length == #len(destination) {
    return PathResult{error: -63, kind: errors.Kind.Capacity}
  }
  return PathResult{path: destination[..#cast(usize) length], ok: true}
}
pub fn set_permissions(file: *File, mode: usize) Result {
  if !is_open(file) {
    return Result{error: -9, kind: errors.Kind.InvalidState}
  }
  if mode > 65535 {
    return Result{error: -22, kind: errors.Kind.InvalidInput}
  }
  return darwin_result(darwin_fchmod(#cast(i32) file.descriptor, #cast(u16) mode))
}

// No creation flag: open's variadic mode argument is intentionally absent.
pub fn open_nofollow(path: []const u8) FileResult {
  storage: [4096]u8 = []
  name := darwin_path(path, storage[..])
  if name == nil {
    return FileResult{error: -22, kind: errors.Kind.InvalidInput}
  }
  descriptor := darwin_open(name, 16777476) // O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK
  if descriptor < 0 {
    code := darwin_error()
    return FileResult{error: code, kind: errors.darwin(code)}
  }
  return FileResult{file: adopt_handle(#cast(isize) descriptor), ok: true}
}

fn atomic_create_exclusive(path: []const u8) FileResult {
  return base.create_exclusive(path)
}
pub fn create_private_exclusive(path: []const u8) FileResult {
  storage: [4096]u8 = []
  name := darwin_path(path, storage[..])
  if name == nil {
    return FileResult{error: -22, kind: errors.Kind.InvalidInput}
  }
  descriptor := darwin_open(name, 16779778, #cast(i32) 384)
  if descriptor < 0 {
    code := darwin_error()
    return FileResult{error: code, kind: errors.darwin(code)}
  }
  return FileResult{file: adopt_handle(#cast(isize) descriptor), ok: true}
}
pub fn preserve_permissions(file: *File, source: []const u8) Result {
  info := metadata(source)
  if !info.ok {
    return Result{error: info.error, kind: info.kind}
  }
  return set_permissions(file, #cast(usize) (info.mode & 511))
}
