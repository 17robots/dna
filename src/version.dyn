use "std/io"

const DnaVersion: []const u8 = "0.1.0-preview.11"

// Handle informational commands before allocating editor state or opening files.
fn cli_version() bool {
  owner := arena_owner.create(65536)
  defer arena_owner.release(owner)
  arguments := host.arguments(owner)
  if !arguments.ok {
    return false
  }
  requested := false
  for index in 1..#len(arguments.values) {
    argument := arguments.values[index]
    if buffer.equal(argument, "--") {
      break
    }
    if buffer.equal(argument, "--version") || (#len(arguments.values) == 2 && buffer.equal(argument, "version")) {
      requested = true
      break
    }
  }
  if !requested {
    return false
  }
  _ = io.write(io.stdout(), "dna ")
  _ = io.write(io.stdout(), DnaVersion)
  _ = io.write(io.stdout(), "\n")
  return true
}
