// DNA's filesystem boundary supplements the pinned SDK's portable byte I/O.
use "std/fs" std_fs
use "std/mem"
use "std/io"

pub type File = std_fs.File
pub type FileResult = std_fs.FileResult
pub type Result = std_fs.Result
pub type ReadAllResult = std_fs.ReadAllResult
pub struct Metadata { size, inode, device: u64, mode: u16, failure: io.Failure }
// Identity of an open file's current contents: equal stamps mean nothing
// replaced or rewrote it in between.
pub struct Stamp { inode, size, modify_seconds, modify_nanos, change_seconds, change_nanos: u64, ok: bool }
pub struct PathResult { path: []u8, failure: io.Failure }
pub struct DirectoryResult { directory: Directory, failure: io.Failure }
pub struct DirectoryEntry { name: []const u8, kind: u8, found: bool, failure: io.Failure }
pub struct AtomicFile { file: File, destination, temporary: []const u8, active: bool }
pub struct AtomicResult { transaction: AtomicFile, failure: io.Failure }

pub fn open(path: []const u8) FileResult {
  return std_fs.open(path)
}
pub fn create(path: []const u8) FileResult {
  return std_fs.create(path)
}
pub fn create_exclusive(path: []const u8) FileResult {
  return std_fs.create_exclusive(path)
}
pub fn append(path: []const u8) FileResult {
  return std_fs.append(path)
}
pub fn adopt_handle(handle: isize) File {
  return std_fs.adopt_handle(handle)
}
pub fn is_open(file: *const File) bool {
  return std_fs.is_open(file)
}
pub fn close(file: *File) {
  std_fs.close(file)
}
pub fn read(file: *File, destination: []u8) Result {
  return std_fs.read(file, destination)
}
pub fn write(file: *File, source: []const u8) Result {
  return std_fs.write(file, source)
}
// Position only the private save output; source descriptors stay unchanged.
pub fn seek(file: *File, offset: usize) Result {
  if offset > 9223372036854775807 {
    return Result{ failure: io.Failure{ kind: io.Kind.InvalidInput } }
  }
  result := std_fs.seek(file, #cast(isize, offset), 0)
  return Result{ failure: result.failure }
}
pub fn sync(file: *File) Result {
  return std_fs.sync(file)
}
pub fn read_all(arena: *mem.Arena, path: []const u8, maximum: usize) ReadAllResult {
  return std_fs.read_all(arena, path, maximum)
}
pub fn write_all(path: []const u8, source: []const u8) Result {
  return std_fs.write_all(path, source)
}

// Borrow paths until commit/abort. The caller supplies a sibling temporary.
pub fn atomic_begin(destination: []const u8, temporary: []const u8) AtomicResult {
  if #len(destination) == 0 || #len(temporary) == 0 {
    return AtomicResult{ failure: io.Failure{ kind: io.Kind.InvalidInput, native: -22 } }
  }
  created := atomic_create_exclusive(temporary)
  if created.failure.kind != io.Kind.Ok {
    return AtomicResult{ failure: io.Failure{ kind: created.failure.kind, native: created.failure.native } }
  }
  return AtomicResult{transaction: AtomicFile{file: created.value, destination: destination, temporary: temporary, active: true}}
}
pub fn atomic_commit(transaction: *AtomicFile) Result {
  if !transaction.active {
    return Result{ failure: io.Failure{ kind: io.Kind.InvalidState, native: -22 } }
  }
  synced := sync(&transaction.file)
  if synced.failure.kind != io.Kind.Ok {
    return synced
  }
  close(&transaction.file)
  renamed := rename(transaction.temporary, transaction.destination)
  if renamed.failure.kind == io.Kind.Ok {
    transaction.active = false
  }
  return renamed
}
pub fn atomic_abort(transaction: *AtomicFile) Result {
  if !transaction.active {
    return Result{ failure: io.Failure{ kind: io.Kind.InvalidState, native: -22 } }
  }
  if is_open(&transaction.file) {
    _ = close(&transaction.file)
  }
  removed := remove(transaction.temporary)
  if removed.failure.kind == io.Kind.Ok {
    transaction.active = false
  }
  return removed
}

// Private session/recovery contents must never be exposed through a temporary
// file created with a broader inherited/default access policy.
pub fn atomic_begin_private(destination: []const u8, temporary: []const u8) AtomicResult {
  if #len(destination) == 0 || #len(temporary) == 0 {
    return AtomicResult{ failure: io.Failure{ kind: io.Kind.InvalidInput, native: -22 } }
  }
  created := create_private_exclusive(temporary)
  if created.failure.kind != io.Kind.Ok {
    return AtomicResult{ failure: io.Failure{ kind: created.failure.kind, native: created.failure.native } }
  }
  return AtomicResult{transaction: AtomicFile{file: created.value, destination: destination, temporary: temporary, active: true}}
}
