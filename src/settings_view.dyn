extern fn config_directories "dna_make_directories"(path: *const u8) i32

fn setting_decimal(out: []u8, used: *usize, value: f32) {
  scaled := #cast(usize, (value * 1000.0 + 0.5))
  add_number(out, used, scaled / 1000)
  fraction := scaled % 1000
  if fraction == 0 { return }
  add_text(out, used, ".")
  digits: [3]u8 = [#cast(u8, (48 + fraction / 100)), #cast(u8, (48 + (fraction / 10) % 10)), #cast(u8, (48 + fraction % 10))]
  length: usize = 3
  for length > 0 && digits[length - 1] == 48 {
    length -= 1
  }
  add_text(out, used, digits[..length])
}
fn setting_bool(out: []u8, used: *usize, value: bool) {
  if value {
    add_text(out, used, "true")
  } else {
    add_text(out, used, "false")
  }
}
// The configured value of SPEC as configuration text, without quotes.
fn setting_value_text(app: *const App, spec: settings.Option, out: []u8) str {
  used: usize = 0
  case spec.kind {
    .Flag => { setting_bool(out, &used, settings.option_flag(&app.config, spec.key)) }
    .Number => { setting_decimal(out, &used, settings.option_number(&app.config, spec.key)) }
    .Text => { return settings.option_text(&app.config, spec.key) }
    .Choice => { return settings.choice_name(spec, settings.option_choice(&app.config, spec.key)) }
    .Key => { setting_key_name(out, &used, app.config.terminal_escape, app.config.terminal_modifiers) }
  }
  return out[..used]
}
// What DNA uses now, for options whose running value can differ from the
// configuration (a font that failed to load, a toggled gutter). False for
// options that take effect exactly as configured.
fn setting_current(app: *App, typography: *Typography, key: str, out: []u8, current: *str) bool {
  used: usize = 0
  case key {
    "font_size" => { setting_decimal(out, &used, typography.points) }
    "line_height" => { setting_decimal(out, &used, typography.line_height) }
    "indent_width" => { setting_decimal(out, &used, #cast(f32, indent_width(app))) }
    "reduced_motion" => { setting_bool(out, &used, app.view.reduced_motion) }
    "line_numbers" => { setting_bool(out, &used, app.view.line_numbers) }
    "relative_numbers" => { setting_bool(out, &used, app.view.relative_numbers) }
    "status_line" => { setting_bool(out, &used, app.view.status_line) }
    "highlight_line" => { setting_bool(out, &used, app.view.highlight_line) }
    "font", "font_family" => {
      current.* = app.fonts.active_font_path[..app.fonts.active_font_length]
      return true
    }
    "fallback_font" => {
      current.* = app.fonts.active_fallback_path[..app.fonts.active_fallback_length]
      return true
    }
    "theme" => {
      current.* = app.theme_state.name[..app.theme_state.name_length]
      return true
    }
    _ => { return false }
  }
  current.* = out[..used]
  return true
}
fn setting_inspect(app: *App, typography: *Typography, key: str) bool {
  if setting_group(app, key) { return true }
  index := settings.lookup(key)
  if index == settings.OptionCount { return false }
  spec := settings.option(index)
  value_storage: [64]u8
  configured := setting_value_text(app, spec, value_storage[..])
  if configured.len == 0 {
    configured = settings.shown_default(spec)
  }
  current_storage: [64]u8
  current := configured
  if setting_current(app, typography, spec.key, current_storage[..], &current) && current.len == 0 {
    current = settings.shown_default(spec)
  }
  message := app.prompt_state.message[..]
  used := &app.prompt_state.message_length
  app.configuration.setting_key_length = copy_text(app.configuration.setting_key[..], spec.key)
  used.* = copy_text(message, settings.set_name(spec))
  add_text(message, used, "\n\n")
  add_text(message, used, spec.description)
  add_text(message, used, "\n\nCurrent: ")
  add_text(message, used, current)
  add_text(message, used, "\nConfigured: ")
  add_text(message, used, configured)
  add_text(message, used, "\nDefault: ")
  add_text(message, used, settings.shown_default(spec))
  add_text(message, used, "\nSource: ")
  if settings.explicit(&app.config, spec.key) {
    add_text(message, used, app.configuration.path[..app.configuration.path_length])
  } else {
    add_text(message, used, "built-in default")
  }
  add_text(message, used, "\nSection form: [")
  add_text(message, used, spec.section)
  add_text(message, used, "] ")
  add_text(message, used, spec.local)
  add_text(message, used, "\n\nEnter opens config / Escape closes. Save and :config-reload to apply.")
  app.prompt_state.panel = .Setting
  return true
}
fn setting_edit(app: *App) {
  key := app.configuration.setting_key[..app.configuration.setting_key_length]
  cfg_info := files.metadata(app.configuration.path[..app.configuration.path_length]) catch fs.Metadata{}
  if cfg_info.mode == 0 {
    parent: [4096]u8
    length := app.configuration.path_length
    for length > 0 && app.configuration.path[length - 1] != '/' {
      length -= 1
    }
    if length == 0 {
      notice(app, "Configuration needs an absolute path.")
      return
    }
    _ = copy_text(parent[..], app.configuration.path[..length])
    if config_directories(&parent[0]) == 0 {
      notice(app, "Cannot create configuration directory.")
      return
    }
    if !new_buffer(app) { return }
    if !files.set_name(app.documents.file, app.configuration.path[..app.configuration.path_length]) {
      notice(app, "Invalid configuration path.")
      return
    }
    _ = buffer.replace(app.documents.current, "# DNA configuration. Use :settings to discover options.\n")
    buffer.checkpoint(app.documents.current)
  } else {
    open_file(app, app.configuration.path[..app.configuration.path_length])
    if app.prompt_state.panel == .Message { return }
  }
  index := settings.find(key)
  if buffer.find(app.documents.current, key, false) || index == settings.OptionCount { return }
  _ = buffer.find(app.documents.current, settings.option(index).local, false)
}
