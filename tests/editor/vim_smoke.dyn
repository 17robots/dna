// Vim profile through key_input/text_input, as the native backend delivers them: keys
// always, text only while inserting (text input is off in normal mode).
fn vim_type(app: *App, typography: *Typography, keys: []const u8) {
  for byte in keys {
    inserting := app.view.insert
    key := #cast(u32, byte)
    modifiers: u16 = 0
    character := #cast(u32, byte)
    if byte == 27 {
      key = KeyEscape
      character = 0
    } else if byte == 10 {
      key = KeyReturn
      character = 0
    } else if byte >= 'A' && byte <= 'Z' {
      key = #cast(u32, byte) + 32
      modifiers = ModShift
    }
    app.input_state.character = character
    key_input(app, typography, key, modifiers)
    app.input_state.character = 0
    if inserting && byte != 27 && byte != 10 {
      single: [1]u8 = [byte]
      text_input(app, single[..])
    } else if inserting && byte == 10 && app.view.insert {
      text_input(app, "\n")
    }
  }
}
fn vim_ex(app: *App, typography: *Typography, command: []const u8) {
  key_input(app, typography, KeyColon, 0)
  if app.prompt_state.panel != Panel.Commands {
    line: [256]u8 = []
    used := copy_text(line[..], "vim : opens the command palette, before :")
    add_text(line[..], &used, command)
    #panic(line[..used])
  }
  text_input(app, command)
  key_input(app, typography, KeyReturn, 0)
}
fn vim_control_key(app: *App, typography: *Typography, key: u32) {
  key_input(app, typography, key, ModCtrl)
}
fn vim_expect(app: *App, text: []const u8, head: usize, message: []const u8) {
  doc := app.documents.current
  if !buffer.equal(buffer.all(doc), text) || buffer.head(doc) != head || app.view.insert || app.vim.mode != VimMode.Normal {
    line: [4096]u8 = []
    used: usize = 0
    add_text(line[..], &used, "vim smoke: ")
    add_text(line[..], &used, message)
    add_text(line[..], &used, " | head ")
    add_number(line[..], &used, buffer.head(doc))
    add_text(line[..], &used, " want ")
    add_number(line[..], &used, head)
    if app.view.insert {
      add_text(line[..], &used, " (insert)")
    }
    add_text(line[..], &used, " text [")
    shown := doc.length
    if shown > 200 {
      shown = 200
    }
    add_text(line[..], &used, buffer.range(doc, 0, shown))
    add_text(line[..], &used, "]\n")
    _ = #syscall(1, 2, &line[0], used)
    #panic("vim key behaviour")
  }
}
fn vim_start(app: *App, text: []const u8) {
  doc := app.documents.current
  _ = buffer.load(doc, text)
  app.prompt_state.panel = Panel.None
  app.view.insert = false
  app.view.extend = false
  vim_reset(app)
  vim_place(app, 0)
}
fn vim_smoke(app: *App, typography: *Typography) {
  saved_keys := app.config.vim_keys
  app.config.vim_keys = true
  defer app.config.vim_keys = saved_keys
  config := active_file_config(app)
  saved_file_config := config.*
  defer config.* = saved_file_config
  config.indent_explicit = true
  config.indent_width = 4
  config.insert_tabs = false
  // Empty inner objects must still accept a change at the insertion point.
  vim_start(app, "() [] {}\n")
  vim_type(app, typography, "ci(x\x1b")
  vim_expect(app, "(x) [] {}\n", 1, "ci( inserts inside an empty pair")
  // Completed and canceled operators must not count a later text object.
  for command in ["2yy", "2yw", "2ygg", "2yi(", "2yiz", "2yi[", "2y\x1b", "2yi\x1b", "2yfZ"] {
    vim_start(app, "((x))\nsecond\n")
    // Operator-count coverage must not depend on a compositor clipboard seat.
    // Native clipboard acquisition is qualified separately with real input.
    app.vim.register = 1
    vim_type(app, typography, command)
    vim_place(app, 2)
    vim_type(app, typography, "vi(")
    doc := app.documents.current
    if app.vim.mode != VimMode.Visual || buffer.start(doc) != 2 || buffer.end(doc) != 3 {
      line: [256]u8 = []
      used := copy_text(line[..], "completed/canceled operator before vi(: ")
      add_text(line[..], &used, command)
      add_text(line[..], &used, " | mode ")
      add_number(line[..], &used, #cast(usize, app.vim.mode))
      add_text(line[..], &used, " panel ")
      add_number(line[..], &used, #cast(usize, app.prompt_state.panel))
      add_text(line[..], &used, " selection ")
      add_number(line[..], &used, buffer.start(doc))
      add_text(line[..], &used, ":")
      add_number(line[..], &used, buffer.end(doc))
      add_text(line[..], &used, " operator/count/pending ")
      add_number(line[..], &used, #cast(usize, app.vim.operator))
      add_text(line[..], &used, "/")
      add_number(line[..], &used, app.vim.operator_count)
      add_text(line[..], &used, "/")
      add_number(line[..], &used, #cast(usize, app.vim.pending))
      #panic(line[..used])
    }
  }
  // Counts survive operator prefixes and multiply with motion counts.
  vim_start(app, "a a a a a a a a a\n")
  vim_type(app, typography, "2d3fa")
  vim_expect(app, " a a\n", 0, "2d3fa multiplies operator and find counts")
  vim_start(app, "a b c d e f g\n")
  vim_type(app, typography, "2dw.")
  vim_expect(app, "e f g\n", 0, "dot repeat retains the completed command count")
  // Motions.
  vim_start(app, "hello world foo\nsecond line here\n\nlast (a (b) c) end\n")
  vim_type(app, typography, "w")
  vim_expect(app, buffer.all(app.documents.current), 6, "w")
  vim_type(app, typography, "e")
  vim_expect(app, buffer.all(app.documents.current), 10, "e")
  vim_type(app, typography, "b0$")
  vim_expect(app, buffer.all(app.documents.current), 14, "b 0 $")
  vim_type(app, typography, "j")
  vim_expect(app, buffer.all(app.documents.current), 31, "$ then j keeps end of line")
  vim_type(app, typography, "gg2w")
  vim_expect(app, buffer.all(app.documents.current), 12, "gg 2w")
  vim_type(app, typography, "G")
  vim_expect(app, buffer.all(app.documents.current), 34, "G to last line first non-blank")
  vim_type(app, typography, "f(%")
  vim_expect(app, buffer.all(app.documents.current), 47, "f( then % matches")
  vim_type(app, typography, "%;")
  vim_expect(app, buffer.all(app.documents.current), 42, "% back then ; repeats f(")
  vim_type(app, typography, "2G}")
  vim_expect(app, buffer.all(app.documents.current), 33, "} to the blank line")
  vim_type(app, typography, "{")
  vim_expect(app, buffer.all(app.documents.current), 0, "{ to the start")
  // Operators, counts, undo and dot repeat.
  vim_start(app, "one two three four\n")
  vim_type(app, typography, "dw")
  vim_expect(app, "two three four\n", 0, "dw")
  vim_type(app, typography, ".")
  vim_expect(app, "three four\n", 0, ". repeats dw")
  vim_type(app, typography, "u")
  vim_expect(app, "two three four\n", 0, "u undoes the repeat")
  vim_type(app, typography, "2dw")
  vim_expect(app, "four\n", 0, "2dw")
  vim_type(app, typography, "x")
  vim_expect(app, "our\n", 0, "x")
  vim_type(app, typography, "$x")
  vim_expect(app, "ou\n", 1, "x at line end steps back")
  vim_start(app, "alpha beta\n")
  vim_type(app, typography, "cwgamma\x1b")
  vim_expect(app, "gamma beta\n", 4, "cw changes to the word end")
  vim_type(app, typography, "w.")
  vim_expect(app, "gamma gamma\n", 10, ". repeats the change with its text")
  vim_type(app, typography, "0ciwx\x1b")
  vim_expect(app, "x gamma\n", 0, "ciw")
  vim_type(app, typography, "D")
  vim_expect(app, "\n", 0, "D")
  // Lines: dd, yy, p, P, o, O, J, >>, counts.
  vim_start(app, "a\nb\nc\nd\n")
  vim_type(app, typography, "dd")
  vim_expect(app, "b\nc\nd\n", 0, "dd")
  vim_type(app, typography, "p")
  vim_expect(app, "b\na\nc\nd\n", 2, "p puts the line below")
  vim_type(app, typography, "yyP")
  vim_expect(app, "b\na\na\nc\nd\n", 2, "yy P puts above")
  vim_type(app, typography, "2dd")
  vim_expect(app, "b\nc\nd\n", 2, "2dd")
  vim_type(app, typography, "Gdd")
  vim_expect(app, "b\nc\n", 2, "dd on the last line")
  vim_type(app, typography, "ggJ")
  vim_expect(app, "b c\n", 1, "J joins with a space")
  vim_type(app, typography, "onew\x1b")
  vim_expect(app, "b c\nnew\n", 6, "o opens a line below")
  vim_type(app, typography, "Otop\x1b")
  vim_expect(app, "b c\ntop\nnew\n", 6, "O opens a line above")
  vim_type(app, typography, ">>")
  vim_expect(app, "b c\n    top\nnew\n", 8, ">> indents")
  vim_type(app, typography, "<<")
  vim_expect(app, "b c\ntop\nnew\n", 4, "<< unindents")
  // Insert variants, counts and r, ~, Ctrl-a.
  vim_start(app, "  word\n")
  vim_type(app, typography, "A!\x1b")
  vim_expect(app, "  word!\n", 6, "A appends")
  vim_type(app, typography, "I-\x1b")
  vim_expect(app, "  -word!\n", 2, "I inserts at the first non-blank")
  vim_type(app, typography, "3ax\x1b")
  vim_expect(app, "  -xxxword!\n", 5, "3a repeats the insert")
  vim_type(app, typography, "0wrZ")
  vim_expect(app, "  Zxxxword!\n", 2, "w from the indent, then r")
  vim_start(app, "abc 41\n")
  vim_type(app, typography, "rZ~")
  vim_expect(app, "zbc 41\n", 1, "r then ~ toggles it back")
  vim_type(app, typography, "~")
  vim_expect(app, "zBc 41\n", 2, "~ toggles and moves")
  vim_control_key(app, typography, KeyA)
  vim_expect(app, "zBc 42\n", 5, "Ctrl-a increments")
  app.vim.count = 5
  vim_control_key(app, typography, KeyX)
  vim_expect(app, "zBc 37\n", 5, "5 Ctrl-x decrements")
  // Text objects and case operators.
  vim_start(app, "call(one, two) end\n")
  vim_type(app, typography, "fodi(")
  vim_expect(app, "call() end\n", 5, "di(")
  vim_type(app, typography, "wgUiw")
  vim_expect(app, "call() END\n", 7, "gUiw")
  vim_type(app, typography, "0guu")
  vim_expect(app, "call() end\n", 0, "guu")
  vim_type(app, typography, "daw")
  vim_expect(app, "() end\n", 0, "daw")
  // Visual modes.
  vim_start(app, "one two\nthree four\nfive\n")
  vim_type(app, typography, "vjd")
  vim_expect(app, "hree four\nfive\n", 0, "vjd deletes charwise through the column")
  vim_type(app, typography, "Vjd")
  vim_expect(app, "", 0, "Vjd deletes lines")
  vim_start(app, "abc\nabc\nabc\n")
  vim_type(app, typography, "l")
  vim_control_key(app, typography, KeyV)
  vim_type(app, typography, "jjd")
  vim_expect(app, "ac\nac\nac\n", 1, "Ctrl-v block delete")
  vim_start(app, "keep this\n")
  vim_type(app, typography, "wviwy0P")
  vim_expect(app, "thiskeep this\n", 3, "viw y then P")
  vim_type(app, typography, "gv")
  if app.vim.mode != VimMode.Visual {
    #panic("gv restores the visual selection")
  }
  vim_type(app, typography, "\x1b")
  // Named registers and the black hole.
  vim_start(app, "red green\n")
  vim_type(app, typography, "\"ayiw")
  vim_expect(app, "red green\n", 0, "\"ayiw")
  vim_type(app, typography, "w\"_dw")
  vim_expect(app, "red \n", 3, "dw on the last word keeps the newline")
  vim_type(app, typography, "\"ap")
  vim_expect(app, "red red\n", 6, "\"a register survives a black-hole delete")
  // More operators and line forms.
  vim_start(app, "  abc\nx\n")
  vim_type(app, typography, "ccnew\x1b")
  vim_expect(app, "  new\nx\n", 4, "cc keeps the indentation")
  vim_start(app, "a\nb\nc\n")
  vim_type(app, typography, "dj")
  vim_expect(app, "c\n", 0, "dj deletes two lines")
  vim_start(app, "a\nb\nc\n")
  vim_type(app, typography, "jdG")
  vim_expect(app, "a\n", 0, "dG deletes to the end")
  vim_start(app, "x\n")
  vim_type(app, typography, "3oab\x1b")
  vim_expect(app, "x\nab\nab\nab\n", 9, "3o repeats the opened line")
  vim_start(app, "a\nb\n")
  vim_type(app, typography, "A;\x1bj.")
  vim_expect(app, "a;\nb;\n", 4, ". repeats an append")
  vim_start(app, "a\nb\n")
  vim_type(app, typography, "Vj>")
  vim_expect(app, "    a\n    b\n", 4, "V> indents the lines")
  vim_start(app, "one two\n")
  vim_type(app, typography, "yiwwviwp")
  vim_expect(app, "one one\n", 4, "visual p replaces the selection")
  vim_start(app, "a\nb\n")
  vim_type(app, typography, "YjP")
  vim_expect(app, "a\na\nb\n", 2, "Y then P")
  vim_start(app, "say \"hi there\" now\n")
  vim_type(app, typography, "fhci\"x\x1b")
  vim_expect(app, "say \"x\" now\n", 5, "ci\" changes inside quotes")
  vim_start(app, "a,b,c,d\n")
  vim_type(app, typography, "t,;")
  vim_expect(app, "a,b,c,d\n", 2, "t, then ; skips the adjacent match")
  vim_type(app, typography, ",")
  vim_expect(app, "a,b,c,d\n", 2, ", reverses as T,")
  vim_start(app, "abcdef\n")
  vim_type(app, typography, "3xu")
  vim_expect(app, "abcdef\n", 0, "u restores 3x")
  vim_control_key(app, typography, KeyR)
  vim_expect(app, "def\n", 0, "Ctrl-r redoes")
  vim_type(app, typography, "d2l")
  vim_expect(app, "f\n", 0, "d2l")
  // Macros: qa ... q, then @a.
  vim_start(app, "a\nb\nc\n")
  vim_type(app, typography, "qaA;\x1bjq@a")
  vim_expect(app, "a;\nb;\nc\n", 6, "@a replays the macro")
  // / search rests on the match start; n repeats.
  vim_start(app, "foo bar foo bar\n")
  vim_type(app, typography, "/")
  text_input(app, "bar")
  key_input(app, typography, KeyReturn, 0)
  vim_expect(app, "foo bar foo bar\n", 4, "/ search")
  vim_type(app, typography, "n")
  vim_expect(app, "foo bar foo bar\n", 12, "n")
  vim_type(app, typography, "dn")
  vim_expect(app, "foo bar\n", 4, "dn deletes to the wrapped match")
  // Ex commands through the palette: :N and :s.
  vim_start(app, "foo one\nfoo two foo\nbar\n")
  vim_ex(app, typography, "%s/foo/X/g")
  vim_expect(app, "X one\nX two X\nbar\n", 6, ":%s///g")
  vim_ex(app, typography, "1")
  vim_expect(app, "X one\nX two X\nbar\n", 0, ":1")
  vim_ex(app, typography, "s/one/[&]/")
  vim_expect(app, "X [one]\nX two X\nbar\n", 0, ":s with &")
  vim_ex(app, typography, "2,3s/X\\|bar/y/g")
  vim_expect(app, "X [one]\ny two y\ny\n", 16, ":2,3s with alternation")
  vim_type(app, typography, "ggVj\x1b")
  vim_ex(app, typography, "'<,'>s/y/z/")
  vim_expect(app, "X [one]\nz two y\ny\n", 8, ":'<,'>s")
  vim_ex(app, typography, "%s/nothing/x/")
  vim_expect(app, "X [one]\nz two y\ny\n", 8, ":s without a match")
  // : from visual mode prefills '<,'> so :s covers every selected line.
  vim_start(app, "a a\na a\na a\nb\n")
  vim_type(app, typography, "Vjj")
  vim_ex(app, typography, "s/a/c/g")
  vim_expect(app, "c c\nc c\nc c\nb\n", 8, "visual :s/a/c/g")
  // Vim pattern syntax and substitute parity.
  vim_start(app, "foo bar\n")
  vim_ex(app, typography, "s/\\(\\w\\+\\) \\(\\w\\+\\)/\\u\\2 \\U\\1/")
  vim_expect(app, "Bar FOO\n", 0, ":s groups and case")
  vim_start(app, "a1b22\n")
  vim_ex(app, typography, "s/\\v(\\d+)/<\\1>/g")
  vim_expect(app, "a<1>b<22>\n", 0, ":s very magic")
  vim_start(app, "cat concat cat\n")
  vim_ex(app, typography, "s/\\<cat\\>/dog/g")
  vim_expect(app, "dog concat dog\n", 0, ":s word bounds")
  vim_start(app, "a\nb\nc\nd\n")
  vim_ex(app, typography, "2,$s/$/;/")
  vim_expect(app, "a\nb;\nc;\nd;\n", 8, ":2,$s")
  vim_start(app, "a\nb\nc\n")
  vim_ex(app, typography, ".,.+1s/^/#/")
  vim_expect(app, "#a\n#b\nc\n", 3, ":.,.+1s")
  vim_start(app, "x\nstart\ny\nend\nz\n")
  vim_ex(app, typography, "/start/,/end/s/^/-/")
  vim_expect(app, "x\n-start\n-y\n-end\nz\n", 12, ":/a/,/b/s")
  vim_start(app, "a\nb\nc\n")
  vim_ex(app, typography, "%s/\\n//")
  vim_expect(app, "abc\n", 0, ":%s/\\n// joins")
  vim_start(app, "abc\n")
  vim_ex(app, typography, "s/x*/-/g")
  vim_expect(app, "-a-b-c-\n", 0, ":s empty matches")
  vim_start(app, "foobar\n")
  vim_ex(app, typography, "s/foo\\zsbar/X/")
  vim_expect(app, "fooX\n", 0, ":s \\zs")
  vim_start(app, "aaa\n")
  vim_ex(app, typography, "s/a\\{-1,}/X/")
  vim_expect(app, "Xaa\n", 0, ":s lazy brace")
  vim_start(app, "ab\ncd\n")
  vim_ex(app, typography, "%s/[^x]\\+/Z/g")
  vim_expect(app, "Z\nZ\n", 2, ":s negated collection stops at line end")
  vim_ex(app, typography, "1s/Z/~~/")
  vim_expect(app, "ZZ\nZ\n", 0, ":s ~ in the string")
  vim_start(app, "Foo foo\n")
  vim_ex(app, typography, "s/foo/x/gi")
  vim_expect(app, "x x\n", 0, ":s i flag")
  vim_start(app, "Foo foo\n")
  vim_ex(app, typography, "s/\\cFOO/x/g")
  vim_expect(app, "x x\n", 0, ":s \\c")
  vim_start(app, "aaaa\n")
  vim_type(app, typography, "vl\x1b")
  vim_ex(app, typography, "s/\\%Va/b/g")
  vim_expect(app, "bbaa\n", 0, ":s \\%V")
  vim_start(app, "a a\na a\n")
  vim_ex(app, typography, "s/a/b/")
  vim_expect(app, "b a\na a\n", 0, ":s first")
  vim_type(app, typography, "j&")
  vim_expect(app, "b a\nb a\n", 4, "& repeats")
  vim_type(app, typography, "g&")
  vim_expect(app, "b b\nb b\n", 4, "g& repeats on every line")
  vim_start(app, "a1\nb\na2\nc\n")
  vim_ex(app, typography, "g/a/s/\\d/X/")
  vim_expect(app, "aX\nb\naX\nc\n", 5, ":g/a/s ends on the last line it ran on")
  vim_ex(app, typography, "v/a/d")
  vim_expect(app, "aX\naX\n", 3, ":v/a/d")
  vim_start(app, "x\ny\n")
  vim_ex(app, typography, "%norm Az")
  vim_expect(app, "xz\nyz\n", 4, ":%norm ends on the last line")
  vim_start(app, "a\nb\nc\n")
  vim_type(app, typography, "qqA!\x1bq")
  vim_ex(app, typography, "2,3norm @q")
  vim_expect(app, "a!\nb!\nc!\n", 7, ":norm @q runs the macro")
  // A failing motion aborts the macro and its remaining count.
  vim_start(app, "a\nb\nc\n")
  vim_type(app, typography, "qaA;\x1bjq10@a")
  vim_expect(app, "a;\nb;\nc;\n", 7, "10@a stops when j fails")
  vim_start(app, "a\nb\nc\n")
  vim_ex(app, typography, "s/$/!/")
  vim_type(app, typography, "j@:j@@")
  vim_expect(app, "a!\nb!\nc!\n", 6, "@: and @@ repeat the ex command")
  // Macros are register text: q stores it, qA appends, yank makes a macro.
  vim_start(app, "a\nb\nc\n")
  vim_type(app, typography, "qaA!\x1bq")
  if !buffer.equal(app.register_state.named[0].text, "A!\x1b") {
    #panic("vim qa stores the keys as text in register a")
  }
  vim_type(app, typography, "qAjq")
  vim_type(app, typography, "u2@a")
  vim_expect(app, "a!\nb!\nc\n", 6, "qA appends to the macro")
  vim_start(app, "x\nabc\n")
  vim_type(app, typography, "\"ayyj@a")
  vim_expect(app, "x\nbc\n", 2, "a yanked line runs as a macro")
  vim_start(app, "1\n2\n3\n")
  vim_type(app, typography, "qaqqaA.\x1bj@aq@a")
  vim_expect(app, "1.\n2.\n3.\n", 7, "a recursive macro runs until j fails")
  // :move, :copy, :join, :g top-down.
  vim_start(app, "a\nb\nc\n")
  vim_ex(app, typography, "m$")
  vim_expect(app, "b\nc\na\n", 4, ":m$")
  vim_ex(app, typography, "m0")
  vim_expect(app, "a\nb\nc\n", 0, ":m0")
  vim_ex(app, typography, "2,3m0")
  vim_expect(app, "b\nc\na\n", 2, ":2,3m0")
  vim_ex(app, typography, "1t.")
  vim_expect(app, "b\nc\nb\na\n", 4, ":1t. copies below the cursor line")
  vim_ex(app, typography, "3,4co0")
  vim_expect(app, "b\na\nb\nc\nb\na\n", 2, ":3,4co0")
  vim_start(app, "1\n2\n3\n")
  vim_ex(app, typography, "g/^/m0")
  vim_expect(app, "3\n2\n1\n", 0, ":g/^/m0 reverses, top-down")
  vim_start(app, "a\nx\nx\nb\n")
  vim_ex(app, typography, "g/x/.,+1d")
  vim_expect(app, "a\nb\n", 2, ":g skips a marked line an earlier command deleted")
  vim_start(app, "a\n  b\nc\n")
  vim_ex(app, typography, "j")
  vim_expect(app, "a b\nc\n", 1, ":j")
  vim_start(app, "a\nb\nc\n")
  vim_ex(app, typography, "1,3j!")
  vim_expect(app, "abc\n", 2, ":j!")
  // "A appends to a register.
  vim_start(app, "x\ny\n")
  vim_type(app, typography, "\"ayyj\"Ayy")
  if !buffer.equal(app.register_state.named[0].text, "x\ny\n") || !app.register_state.named[0].linewise {
    #panic("vim \"Ayy appends to register a")
  }
  vim_ex(app, typography, "reg a")
  // Options.
  vim_start(app, "Foo\n")
  vim_ex(app, typography, "set ic")
  vim_ex(app, typography, "s/foo/x/")
  vim_expect(app, "x\n", 0, ":set ic")
  vim_start(app, "foo Foo\n")
  vim_ex(app, typography, "set scs")
  vim_ex(app, typography, "s/Foo/y/")
  vim_expect(app, "foo y\n", 0, ":set scs matches case with an upper case letter")
  vim_ex(app, typography, "s/foo/z/")
  vim_expect(app, "z y\n", 0, ":set scs ignores case without one")
  vim_ex(app, typography, "set noic noscs gd")
  vim_start(app, "a a\n")
  vim_ex(app, typography, "s/a/b/")
  vim_expect(app, "b b\n", 0, ":set gd")
  vim_ex(app, typography, "s/b/c/g")
  vim_expect(app, "c b\n", 0, ":set gd inverts g")
  vim_ex(app, typography, "set nogd")
  // Position items are checked where they stand in the pattern.
  vim_start(app, "ab\nab\n")
  vim_ex(app, typography, "%s/b\\n\\%2la/Z/")
  vim_expect(app, "aZb\n", 0, "\\%2l inside a pattern")
  vim_start(app, "foo\nfoo\nfoo\n")
  vim_type(app, typography, "/")
  text_input(app, "\\%>2lfoo")
  key_input(app, typography, KeyReturn, 0)
  vim_expect(app, "foo\nfoo\nfoo\n", 8, "/ with \\%>2l")
  // Case conversion beyond ASCII.
  vim_start(app, "éa\n")
  vim_ex(app, typography, "s/.*/\\U&/")
  vim_expect(app, "ÉA\n", 0, "\\U converts accented letters")
  vim_start(app, "a a a\n")
  vim_ex(app, typography, "s/a/b/gc")
  vim_type(app, typography, "yny")
  vim_expect(app, "b a b\n", 0, ":s///gc")
  vim_start(app, "foo(bar)\n")
  vim_type(app, typography, "/")
  text_input(app, "(bar)")
  key_input(app, typography, KeyReturn, 0)
  vim_expect(app, "foo(bar)\n", 3, "/ uses Vim syntax")
  // Line 0 in a range is line 1; an empty end is not an underflow.
  vim_start(app, "X one\nz two\n")
  vim_ex(app, typography, "0,1s/X/W/")
  vim_expect(app, "W one\nz two\n", 0, ":0,1s")
  vim_ex(app, typography, "2,s/z/q/")
  // Rejected, the palette stays open with the command for correction.
  key_input(app, typography, KeyEscape, 0)
  vim_expect(app, "W one\nz two\n", 0, ":2,s is rejected, not a crash")
  // Every indent path follows the file's width and tab preference.
  config.indent_width = 2
  vim_start(app, "a\nb\n")
  vim_type(app, typography, ">>")
  vim_expect(app, "  a\nb\n", 2, ">> uses file width")
  vim_type(app, typography, "<<Vj>")
  vim_expect(app, "  a\n  b\n", 2, "visual indent uses file width")
  config.insert_tabs = true
  vim_start(app, "a\nb\n")
  vim_type(app, typography, ">>")
  vim_expect(app, "\ta\nb\n", 1, ">> inserts a tab")
  vim_type(app, typography, "<<")
  vim_expect(app, "a\nb\n", 0, "<< removes a tab")
  // Escape cancels pending operators and counts.
  vim_start(app, "abc\n")
  vim_type(app, typography, "3d\x1bx")
  vim_expect(app, "bc\n", 0, "Escape cancels 3d")
  // `.` repeats a visual change on a region of the same size at the cursor.
  vim_start(app, "1\n2\n3\n4\n5\n6\n7\n")
  vim_type(app, typography, "Vjd.")
  vim_expect(app, "5\n6\n7\n", 0, "V . repeats over as many lines")
  vim_start(app, "abcdefghij\n")
  vim_type(app, typography, "vlld.")
  vim_expect(app, "ghij\n", 0, "v . repeats over as many characters")
  vim_start(app, "one two three four\n")
  vim_type(app, typography, "vecX\x1bw.")
  vim_expect(app, "X X three four\n", 2, "visual c repeats with its text")
  vim_start(app, "xxxx\n")
  vim_type(app, typography, "vlrZll.")
  vim_expect(app, "ZZZZ\n", 2, "visual r leaves the cursor at the start and repeats")
  // Marks: m sets, ` goes exactly, ' goes linewise; both work as motions.
  vim_start(app, "a\nb\nc\nd\ne\n")
  vim_type(app, typography, "jmaGd'a")
  vim_expect(app, "a\n", 0, "d'a deletes lines to the mark")
  vim_start(app, "a\nb\nc\nd\ne\n")
  vim_type(app, typography, "jmaG`ax")
  vim_expect(app, "a\n\nc\nd\ne\n", 2, "`a returns to the mark")
  vim_start(app, "one\ntwo\nthree\n")
  vim_type(app, typography, "G''x")
  vim_expect(app, "ne\ntwo\nthree\n", 0, "'' returns to the last jump")
  vim_start(app, "a\nb\nc\n")
  vim_type(app, typography, "jjmaggOnew\x1b`ax")
  vim_expect(app, "new\na\nb\n\n", 8, "marks move with edits above them")
  vim_start(app, "a\nb\n")
  vim_type(app, typography, "`zx")
  vim_expect(app, "\nb\n", 0, "an unset mark does not move")
  // Custom bindings: per-keymap tables, key sequences, keys: mappings, none.
  binding_config := settings.Settings{}
  settings.defaults(&binding_config)
  if !settings.parse("[keys.vim.normal]\n\"Y\" = \"keys:y$\"\n\"X\" = \"keys:dd\"\n\"g z\" = \"keys:x\"\n\"s\" = \"none\"\n[keys.helix.normal]\n\"Y\" = \"none\"\n\"D\" = \"keys:xd\"\n[keys.vim.insert]\n\"j k\" = \"keys:<Esc>\"\n[keys.visual]\n\"ctrl-a\" = \"keys:<Esc>0\"\n", &binding_config) || binding_config.binding_count != 8 {
    #panic("keys tables parse")
  }
  rejected := settings.Settings{}
  settings.defaults(&rejected)
  if settings.parse("[keys.bogus]\n\"a\" = \"pwd\"\n", &rejected) || settings.parse("[keys.normal]\n\"a b c d e\" = \"pwd\"\n", &rejected) || settings.parse("[keys.normal]\n\"ctrl-\" = \"pwd\"\n", &rejected) || settings.parse("[keys.vim.normal]\n\"a\" = \"x\"\n\"a\" = \"y\"\n", &rejected) {
    #panic("invalid keys tables must be rejected")
  }
  if !settings.parse("[keys.vim.normal]\n\"a\" = \"x\"\n[keys.helix.normal]\n\"a\" = \"y\"\n[keys.space]\n\"z\" = \"pwd\"\n\"q q\" = \"keys:<lt>x<C-w>v\"\n", &rejected) {
    #panic("same key in two keymap tables")
  }
  saved_bindings := app.config.bindings
  saved_binding_count := app.config.binding_count
  app.config.bindings = rejected.bindings
  app.config.binding_count = rejected.binding_count
  app.prompt_state.panel = Panel.Leader
  app.input_state.leader_explorer = false
  if key_menu_count(app) != LeaderCommands + 2 || !buffer.equal(key_menu_hint(app, LeaderCommands).label, "pwd") || !buffer.equal(key_menu_hint(app, LeaderCommands + 1).label, "+more keys") {
    #panic("space menu lists custom bindings")
  }
  app.prompt_state.panel = Panel.None
  app.config.bindings = binding_config.bindings
  app.config.binding_count = binding_config.binding_count
  vim_start(app, "abc def\nxyz\n")
  vim_type(app, typography, "wYP")
  vim_expect(app, "abc defdef\nxyz\n", 6, "Y = keys:y$ (vim table wins over helix)")
  vim_start(app, "a\nb\nc\nd\n")
  vim_type(app, typography, "X.")
  vim_expect(app, "c\nd\n", 0, "keys:dd repeats with . once per use")
  vim_start(app, "abc\n")
  vim_type(app, typography, "lgz")
  vim_expect(app, "ac\n", 1, "g z sequence")
  vim_start(app, "a\nb\nc\n")
  vim_type(app, typography, "Ggg")
  vim_expect(app, "a\nb\nc\n", 0, "a broken sequence replays its keys (gg)")
  vim_start(app, "abc\n")
  vim_type(app, typography, "s")
  vim_expect(app, "abc\n", 0, "none unbinds a key")
  vim_start(app, "\n")
  vim_type(app, typography, "ihijk")
  vim_expect(app, "hi\n", 1, "insert j k leaves insert mode")
  vim_start(app, "\n")
  vim_type(app, typography, "ijxjj\x1b")
  vim_expect(app, "jxjj\n", 3, "a broken insert sequence types its keys")
  vim_start(app, "abc\n")
  vim_type(app, typography, "llv")
  vim_control_key(app, typography, 'a')
  vim_type(app, typography, "x")
  vim_expect(app, "bc\n", 0, "shared visual table")
  vim_start(app, "\n")
  vim_type(app, typography, "ij")
  app.binding_state.deadline = 0
  _ = binding_tick(app, typography)
  vim_type(app, typography, "k\x1b")
  vim_expect(app, "jk\n", 1, "a timed-out sequence types its keys")
  app.config.vim_keys = false
  vim_start(app, "a\nb\n")
  vim_type(app, typography, "D")
  vim_expect(app, "b\n", 0, "helix table keys:xd")
  vim_start(app, "a\nb\n")
  vim_type(app, typography, "X")
  if app.documents.current.length != 4 {
    #panic("a vim-only binding ran in helix")
  }
  app.config.vim_keys = true
  app.config.bindings = saved_bindings
  app.config.binding_count = saved_binding_count
  vim_start(app, "")
}
