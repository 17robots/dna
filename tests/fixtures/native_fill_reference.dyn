// Frozen clear/rectangle fill before row-span bulk transfers.
fn reference_clear(renderer: rawptr) bool {
  surface := native_surface()
  for y in 0..surface.height {
    for x in 0..surface.width {
      at := #cast(usize, y)*surface.stride+#cast(usize, x)*4
      surface.pixels[at] = native_gui.color.r
      surface.pixels[at+1] = native_gui.color.g
      surface.pixels[at+2] = native_gui.color.b
      surface.pixels[at+3] = native_gui.color.a
    }
  }
  return true
}
fn reference_fill(renderer: rawptr, rect: *const Rect) bool {
  if rect == nil {
    return false
  }
  surface := native_surface()
  command := ui.Command{kind:ui.Kind.Rectangle, color:native_gui.color, clip:native_clip(surface), bounds:ui.Rect{x:native_gui.viewport.x+#cast(i32, rect.x*native_gui.sx), y:native_gui.viewport.y+#cast(i32, rect.y*native_gui.sy), width:#cast(i32, rect.width*native_gui.sx), height:#cast(i32, rect.height*native_gui.sy)}}
  return software.render(&surface, &command, software.Font{}).ok
}
