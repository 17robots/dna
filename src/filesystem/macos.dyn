#target(kernel: darwin)
use "../cstring"
use "std/dynlib"
use "std/sync"
use "std/io"

#link("System")

// Darwin arm64 uses the 64-bit inode ABI without the Intel $INODE64 suffix.
// Layouts: apple-oss-distributions/xnu bsd/sys/{stat,dirent,cdefs}.h.
struct DarwinStat {
  device: i32, mode, links: u16, inode: u64,
  uid, gid: u32, special_device: i32,
  access_seconds, access_nanoseconds, modified_seconds, modified_nanoseconds: i64,
  changed_seconds, changed_nanoseconds, birth_seconds, birth_nanoseconds: i64,
  size, blocks: i64, block_size: i32, flags, generation: u32,
  spare: i32, spare_quad: [2]i64,
}

struct DarwinEntry {
  inode, seek: u64, record_length, name_length: u16, kind: u8, name: [1024]u8,
}

pub struct Directory { handle: *u8, storage: []u8, ended: bool }

extern fn darwin_open "open"(path: *const u8, flags: i32, ...) i32

extern fn darwin_closedir "closedir"(directory: *u8) i32

extern fn darwin_rename "rename"(source: *const u8, destination: *const u8) i32

extern fn darwin_rename_exclusive "renamex_np"(source: *const u8, destination: *const u8, flags: u32) i32

extern fn darwin_unlink "unlink"(path: *const u8) i32

extern fn darwin_mkdir "mkdir"(path: *const u8, mode: u16) i32

extern fn darwin_rmdir "rmdir"(path: *const u8) i32

extern fn darwin_readlink "readlink"(path: *const u8, destination: *u8, capacity: usize) isize

extern fn darwin_fchmod "fchmod"(file: i32, mode: u16) i32

// The SDK thread module also imports __error. Resolving this accessor
// avoids duplicate foreign declarations when filesystem and buffer coexist.
// Initialize before a fallible libc call so loader work cannot alter its errno.
darwin_errno_once: sync.Once = sync.Once{}

darwin_errno_get: fn() *i32 = nil

fn darwin_prepare_errno() {
  if sync.once_begin(&darwin_errno_once) {
    // Darwin RTLD_DEFAULT searches process-lifetime system libraries.
    symbol := dynlib.symbol(#cast(rawptr, #cast(isize, -2)), "__error") catch {
      #panic("libSystem errno accessor unavailable")
    }
    if symbol == nil {
      #panic("libSystem errno accessor unavailable")
    }
    darwin_errno_get = #cast(fn() *i32, symbol)
    sync.once_complete(&darwin_errno_once)
  }
}

fn darwin_errno() *i32 {
  darwin_prepare_errno()
  return darwin_errno_get()
}

fn darwin_path(path: str, storage: []u8) *const u8 {
  darwin_prepare_errno()
  if path.len == 0 || path.len >= storage.len { return nil }
  return cstring.bounded(storage, path) catch nil
}

fn darwin_error() isize {
  return 0 - #cast(isize, darwin_errno().*)
}

fn darwin_check(value: i32) !io.IoErr {
  if value != 0 { fail io.darwin_err(darwin_error()) }
}

fn darwin_metadata(value: i32, info: *const DarwinStat) Metadata!io.IoErr {
  if value != 0 { fail io.darwin_err(darwin_error()) }
  return Metadata{ size: #cast(u64, info.size), inode: info.inode, device: #cast(u32, info.device), mode: info.mode }
}

pub fn metadata(path: str) Metadata!io.IoErr {
  storage: [4096]u8
  name := darwin_path(path, storage[..])
  if name == nil { fail .InvalidInput }
  info := DarwinStat{}
  return try darwin_metadata(darwin_stat(name, &info), &info)
}

pub fn metadata_nofollow(path: str) Metadata!io.IoErr {
  storage: [4096]u8
  name := darwin_path(path, storage[..])
  if name == nil { fail .InvalidInput }
  info := DarwinStat{}
  return try darwin_metadata(darwin_lstat(name, &info), &info)
}

pub fn file_metadata(file: *const File) Metadata!io.IoErr {
  darwin_prepare_errno()
  if !is_open(file) { fail .InvalidInput }
  info := DarwinStat{}
  return try darwin_metadata(darwin_fstat(#cast(i32, file.descriptor), &info), &info)
}

pub fn open_directory(path: str, storage: []u8) Directory!io.IoErr {
  if storage.len < 1024 { fail .InvalidInput }
  path_storage: [4096]u8
  name := darwin_path(path, path_storage[..])
  if name == nil { fail .InvalidInput }
  handle := darwin_opendir(name)
  if handle == nil { fail io.darwin_err(darwin_error()) }
  return Directory{ handle: handle, storage: storage }
}

// Returned names borrow caller storage until the next directory_next call.
pub fn directory_next(directory: *Directory) DirectoryEntry!io.IoErr {
  if directory.handle == nil { fail .InvalidInput }
  for {
    darwin_errno().* = 0
    entry := darwin_readdir(directory.handle)
    if entry == nil {
      code := darwin_error()
      if code == -4 { continue }
      if code == 0 {
        directory.ended = true
        return DirectoryEntry{}
      }
      fail io.darwin_err(code)
    }
    length := #cast(usize, entry.name_length)
    if length >= 1024 || length > directory.storage.len || entry.name[length] != 0 {
      fail .System(-5)
    }
    dot := length == 1 && entry.name[0] == '.'
    dot_dot := length == 2 && entry.name[0] == '.' && entry.name[1] == '.'
    if !dot && !dot_dot {
      for i in 0..length {
        directory.storage[i] = entry.name[i]
      }
      return DirectoryEntry{ name: directory.storage[..length], kind: entry.kind }
    }
  }
  return DirectoryEntry{}
}

pub fn close_directory(directory: *Directory) {
  darwin_prepare_errno()
  if directory.handle == nil { return }
  handle := directory.handle
  directory.* = Directory{}
  _ = darwin_closedir(handle)
}

fn darwin_move(source: str, destination: str, exclusive: bool) !io.IoErr {
  source_storage: [4096]u8
  destination_storage: [4096]u8
  old_name := darwin_path(source, source_storage[..])
  new_name := darwin_path(destination, destination_storage[..])
  if old_name == nil || new_name == nil { fail .InvalidInput }
  if exclusive {
    try darwin_check(darwin_rename_exclusive(old_name, new_name, 4))
  } else {
    try darwin_check(darwin_rename(old_name, new_name))
  }
}

pub fn rename(source: str, destination: str) !io.IoErr {
  try darwin_move(source, destination, false)
}

pub fn rename_noreplace(source: str, destination: str) !io.IoErr {
  try darwin_move(source, destination, true)
}

pub fn remove(path: str) !io.IoErr {
  storage: [4096]u8
  name := darwin_path(path, storage[..])
  if name == nil { fail .InvalidInput }
  try darwin_check(darwin_unlink(name))
}

pub fn make_directory(path: str, mode: usize) !io.IoErr {
  storage: [4096]u8
  name := darwin_path(path, storage[..])
  if name == nil || mode > 65535 { fail .InvalidInput }
  try darwin_check(darwin_mkdir(name, #cast(u16, mode)))
}

pub fn remove_directory(path: str) !io.IoErr {
  storage: [4096]u8
  name := darwin_path(path, storage[..])
  if name == nil { fail .InvalidInput }
  try darwin_check(darwin_rmdir(name))
}

pub fn read_link(path: str, destination: []u8) []u8!io.IoErr {
  storage: [4096]u8
  name := darwin_path(path, storage[..])
  if name == nil || destination.len == 0 { fail .InvalidInput }
  length := darwin_readlink(name, &destination[0], destination.len)
  if length < 0 { fail io.darwin_err(darwin_error()) }
  if #cast(usize, length) == destination.len { fail .Capacity }
  return destination[..#cast(usize, length)]
}

pub fn set_permissions(file: *File, mode: usize) !io.IoErr {
  darwin_prepare_errno()
  if !is_open(file) || mode > 65535 { fail .InvalidInput }
  try darwin_check(darwin_fchmod(#cast(i32, file.descriptor), #cast(u16, mode)))
}

// No creation flag: open's variadic mode argument is intentionally absent.
pub fn open_nofollow(path: str) File!io.IoErr {
  storage: [4096]u8
  name := darwin_path(path, storage[..])
  if name == nil { fail .InvalidInput }
  descriptor := darwin_open(name, 16777476) // O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK
  if descriptor < 0 { fail io.darwin_err(darwin_error()) }
  return adopt_handle(descriptor)
}

pub fn create_private_exclusive(path: str) File!io.IoErr {
  storage: [4096]u8
  name := darwin_path(path, storage[..])
  if name == nil { fail .InvalidInput }
  descriptor := darwin_open(name, 16779778, #cast(i32, 384))
  if descriptor < 0 { fail io.darwin_err(darwin_error()) }
  return adopt_handle(descriptor)
}

// Identity, size and times of an open file, from fstat.
pub fn file_stamp(file: *const File) Stamp {
  info := DarwinStat{}
  if darwin_fstat(#cast(i32, file.descriptor), &info) != 0 { return Stamp{} }
  return Stamp{inode: info.inode, size: #cast(u64, info.size), modify_seconds: #cast(u64, info.modified_seconds), modify_nanos: #cast(u64, info.modified_nanoseconds), change_seconds: #cast(u64, info.changed_seconds), change_nanos: #cast(u64, info.changed_nanoseconds), valid: true}
}

// APFS clones only whole files (clonefile), so there is no range copy;
// callers write instead.
pub fn copy_range(source: *const File, offset: u64, destination: *File, length: usize, transferred: *usize) !io.IoErr {
  _ = source
  _ = offset
  _ = destination
  _ = length
  transferred.* = 0
  fail .Unsupported
}

extern fn darwin_mmap "mmap"(address: rawptr, length: usize, protection: i32, flags: i32, descriptor: i32, offset: i64) *u8

extern fn darwin_munmap "munmap"(address: *u8, length: usize) i32

// MAP_PRIVATE | MAP_RESILIENT_MEDIA: inaccessible backing pages (including
// truncation) become zero pages, never SIGBUS; cached private pages may
// retain their previous contents. Origin stamps still reject
// saving text from a changed file. Older kernels may refuse the flag; fall
// back to reading rather than retrying with an unguarded mapping.
pub fn map_file(descriptor: isize, length: u64) *u8 {
  if length == 0 || descriptor < 0 { return nil }
  bytes := darwin_mmap(nil, #cast(usize, length), 1, 16386, #cast(i32, descriptor), 0)
  if #cast(isize, bytes) == -1 { return nil }
  return bytes
}

pub fn unmap_file(bytes: *u8, length: u64) {
  _ = darwin_munmap(bytes, #cast(usize, length))
}

// APFS can seed a save with a whole-file copy-on-write clone. The ordinary
// exclusive-create save remains the fallback on unsupported volumes.
pub const WholeFileClones: bool = true

extern fn darwin_clone "fclonefileat"(source: i32, directory: i32, path: *const u8, flags: u32) i32

extern fn darwin_truncate "ftruncate"(file: i32, length: i64) i32

pub fn clone_exclusive(source: *const File, path: str) File!io.IoErr {
  if !is_open(source) { fail .InvalidInput }
  info := file_metadata(source) catch { fail .Unsupported }
  // A read-only origin can still be saved through replacement. Do not change
  // its permissions merely to enable this optimization.
  if (info.mode & 61440) != 32768 || (info.mode & 128) == 0 { fail .Unsupported }
  storage: [4096]u8
  name := darwin_path(path, storage[..])
  if name == nil { fail .InvalidInput }
  // AT_FDCWD, CLONE_NOFOLLOW | CLONE_NOOWNERCOPY. The target must not exist.
  if darwin_clone(#cast(i32, source.descriptor), -2, name, 3) != 0 {
    fail io.darwin_err(darwin_error())
  }
  errdefer _ = darwin_unlink(name)
  // O_RDWR | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK. Refuse a substituted
  // symlink and never block on a substituted FIFO while opening the clone.
  descriptor := darwin_open(name, 16777478)
  if descriptor < 0 { fail io.darwin_err(darwin_error()) }
  file := adopt_handle(descriptor)
  errdefer close(&file)
  cloned := file_metadata(&file) catch { fail .InvalidInput }
  if (cloned.mode & 61440) != 32768 || cloned.size != info.size { fail .InvalidInput }
  return file
}

pub fn resize(file: *File, length: usize) !io.IoErr {
  darwin_prepare_errno()
  if !is_open(file) || length > 9223372036854775807 { fail .InvalidInput }
  try darwin_check(darwin_truncate(#cast(i32, file.descriptor), #cast(i64, length)))
}
