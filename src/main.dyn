use "std/process"
fn queue_key(value: u32, modifiers: u16) {
  event := sdl.Event{} key := #cast(*sdl.KeyEvent) &event
  key.kind = 768 key.key = value key.modifiers = modifiers key.down = true
  if !sdl.push(&event) { #panic("queue key failed") }
}
fn main() {
  owned := mem.arena_create(#sizeof(App) + 128)
  scratch := mem.arena_create(2097152)
  if !owned.ok || !scratch.ok { #panic("editor allocation failed") }
  defer _ = mem.arena_release(&owned.arena)
  defer _ = mem.arena_release(&scratch.arena)
  app := #cast(*App) mem.arena_push(&owned.arena, #sizeof(App), #alignof(App))
  app.scratch = &scratch.arena app.running = true app.popup_width = 0.64 app.popup_height = 0.56
  app.line_numbers = true app.relative_numbers = true app.status_line = true app.highlight_line = true
  if !new_buffer(app) { #panic("document allocation failed") }
  defer release_buffers(app)
  cwd := #syscall(79, &app.directory[0], 4096)
  if cwd <= 0 { #panic("working directory unavailable") }
  app.directory_length = #cast(usize) cwd - 1
  arguments := process.arguments(&scratch.arena)
  if !arguments.ok { #panic("arguments unavailable") }
  if #len(arguments.values) > 1 && #len(arguments.values[1]) > 0 { open_file(app, arguments.values[1]) }
  if !sdl.init(32) { #panic("SDL video init failed") }
  defer sdl.quit()
  title: [64]u8 = [] encoded_title := c.string_from_bytes(title[..], "DNA")
  if !encoded_title.ok { #panic("title capacity") }
  window := sdl.create_window(encoded_title.value, 1100, 760, 8224)
  if window == nil { #panic("window creation failed") }
  defer sdl.destroy_window(window)
  renderer := sdl.create_renderer(window, nil)
  if renderer == nil { #panic("renderer creation failed") }
  defer sdl.destroy_renderer(renderer)
  if !ttf.init() { #panic("font init failed") }
  defer ttf.quit()
  font_path: [4096]u8 = []
  configured := process.environment("DNA_FONT", font_path[..4095])
  if !configured.ok { #panic("DNA_FONT is too long or unavailable") }
  if configured.found { font_path[#len(configured.value)] = 0 }
  else {
    default_font := c.string_from_bytes(font_path[..], "/usr/share/fonts/TTF/ZedMonoNerdFontMono-Regular.ttf")
    if !default_font.ok { #panic("font path capacity") }
  }
  font := ttf.open(&font_path[0], 20.0)
  if font == nil && !configured.found {
    fallback := c.string_from_bytes(font_path[..], "/usr/share/fonts/noto/NotoSansMono-Regular.ttf")
    if fallback.ok { font = ttf.open(fallback.value, 20.0) }
  }
  if font == nil { #panic("font unavailable: set DNA_FONT to a font file") }
  defer ttf.close(font)
  engine := ttf.engine(renderer) if engine == nil { #panic("text engine failed") }
  defer ttf.destroy_engine(engine)

  document := ttf.create(engine, font, &app.document.bytes[0], app.document.length)
  if document == nil { #panic("document text failed") }
  defer ttf.destroy(document)
  empty: [1]u8 = [0]
  palette := ttf.create(engine, font, &empty[0], 0)
  if palette == nil { #panic("palette text failed") }
  defer ttf.destroy(palette)
  if !ttf.whitespace_visible(document, true) || !ttf.wrap(document, 0) || !ttf.color(document, 205, 214, 224, 255) || !ttf.color(palette, 218, 228, 235, 255) { #panic("text style failed") }
  chrome := ttf.create(engine, font, &empty[0], 0)
  if chrome == nil { #panic("chrome text failed") }
  defer ttf.destroy(chrome)
  typography := Typography{chrome: chrome,font: font, document: document, palette: palette, points: 20.0, scale: sdl.display_scale(window)}
  if typography.scale <= 0.0 { typography.scale = 1.0 }
  resize_font(&typography)
  environment: [16]u8 = [] smoke := process.environment("DYN_EDITOR_SMOKE", environment[..])
  input_storage: [64]u8 = []
  if smoke.ok && smoke.found {
    if #sizeof(sdl.Event) != 128 || #sizeof(sdl.KeyEvent) != 40 || #sizeof(sdl.TextEvent) != 32 || #sizeof(ttf.Substring) != 36 { #panic("unexpected ABI") }
    whitespace_smoke(app, &typography)
    workflow_smoke(app, &typography)
    completion_smoke(app, &typography)
    session_smoke(app, &typography)
    _ = buffer.load(app.document, "one\ntwo\nthree\n") app.file.length = 0 app.panel = Panel.None
    queue_key(105, 0)
    simulated := sdl.Event{} incoming := #cast(*sdl.TextEvent) &simulated incoming.kind = 771
    input_text := c.string_from_bytes(input_storage[..], "aé中") incoming.text = input_text.value
    if !sdl.push(&simulated) { #panic("queue text failed") }
    queue_key(8, 0) queue_key(13, 0) queue_key(27, 0)
    queue_key(117, 0) queue_key(117, 1)
    queue_key(32, 0) queue_key(27, 0)
    queue_key(113, 64) queue_key(100, 0)
  }
  draw(renderer, window, app, &typography)
  event := sdl.Event{} receiving: bool = false
  for app.running {
    wants_text := prompting(app) || (app.panel == Panel.None && app.insert)
    if wants_text != receiving {
      if wants_text { if !sdl.start_text(window) { #panic("start input failed") } }
      else { if !sdl.stop_text(window) { #panic("stop input failed") } }
      receiving = wants_text
    }
    if !sdl.wait_timeout(&event, 500) {
      recovery_index: usize = 0 for recovery_index < 16 {
        slot := &app.slots[recovery_index]
        if slot.document != nil && slot.document.revision != slot.recovery_revision {
          slot.recovery_revision = slot.document.revision
          error := files.snapshot(&slot.file, slot.document)
          if #len(error) > 0 { notice(app, error) draw(renderer, window, app, &typography) }
        }
        recovery_index += 1
      }
      continue
    }
    // Preserve event order, but draw once per bounded batch instead of once
    // for both key-down and its following text event. Bound prevents starvation.
    processed: usize = 0 redraw: bool = false
    for true {
      kind := #cast(u32) (event.words[0] & 4294967295)
      if kind == 256 || kind == 528 { action(app, &typography, 16) }
      else if kind == 768 { key := #cast(*const sdl.KeyEvent) &event key_input(app, &typography, key.key, key.modifiers) }
      else if kind == 771 {
        received := #cast(*const sdl.TextEvent) &event
        if received.text != nil {
          length := c.string_length(received.text, 65536)
          if length < 65536 { text_input(app, received.text[..length]) } else { notice(app, "Text input exceeds capacity.") }
        }
      }
      if kind >= 512 && kind <= 540 {
        scale := sdl.display_scale(window)
        if scale > 0.0 && scale != typography.scale { typography.scale = scale resize_font(&typography) }
      }
      if kind == 768 || kind == 771 || kind == 256 || (kind >= 512 && kind <= 540) { redraw = true }
      input_now := prompting(app) || (app.panel == Panel.None && app.insert)
      if input_now != receiving {
        if input_now { if !sdl.start_text(window) { #panic("start input failed") } }
        else { if !sdl.stop_text(window) { #panic("stop input failed") } }
        receiving = input_now
      }
      processed += 1
      if !app.running || processed >= 64 || !sdl.poll(&event) { break }
    }
    if redraw { draw(renderer, window, app, &typography) }
  }
  if !buffer.dirty(app.document) { files.discard_recovery(app.file) }
  if smoke.ok && smoke.found {
    if !buffer.equal(app.document.bytes[..app.document.length], "one\ntwo\nthree\n") || app.insert { #panic("editing smoke failed") }
  }
}
