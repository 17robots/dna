use "std/mem"

// Returned arenas own an OS mapping and must be released with mem.arena_release.
// Sparse Windows arenas are inaccessible until explicitly committed: do not use
// arena_push (which zeroes memory) before committing the affected page range.
pub fn reserve(size: usize, sparse: bool) mem.ArenaResult {
  if size == 0 { return mem.ArenaResult{error: mem.ErrorKind.Capacity} }
  return native_reserve(size, sparse)
}
// Commit only ranges within a live reservation returned by reserve. Recommitting
// committed pages preserves their bytes. This is not a heap/borrowed-buffer API.
pub fn commit(address: *u8, length: usize) bool {
  if length == 0 { return true }
  if address == nil || length > (~#cast(usize) 0) - #cast(usize) address { return false }
  return native_commit(address, length)
}
// Caller relinquishes whole pages. Contents are unspecified after success;
// commit before reusing sparse Windows pages. Darwin reclamation is advisory.
pub fn discard(address: *u8, length: usize) bool {
  if length == 0 { return true }
  size := page_size()
  if address == nil || size == 0 || #cast(usize) address % size != 0 || length % size != 0 { return false }
  if length > (~#cast(usize) 0) - #cast(usize) address { return false }
  return native_discard(address, length)
}
pub fn page_size() usize { return native_page_size() }
pub fn small_pages(memory: []u8) { if #len(memory) > 0 { native_small_pages(memory) } }
