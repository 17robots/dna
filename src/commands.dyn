}
fn command_named(name: []const u8) usize {
  for id in 0..BuiltinCommands {
    info := command_info(id)
    at: usize = 0
    for at < #len(info.aliases) {
      end := at
      for end < #len(info.aliases) && info.aliases[end] != '|' {
        end += 1
      }
      if buffer.equal(name, info.aliases[at..end]) {
        return id
      }
      at = end + 1
    }
  }
  return PluginCommandBase
}
fn leader_command(index: usize) usize {
  ids: [12]usize = [0, 21, 7, 90, 22, 23, 24, 91, 89, 36, 55, 75]
  if index >= 12 {
    return PluginCommandBase
  }
  return ids[index]
}
