#target(kernel: linux)
use process "std/process"
use "std/c"

fn native_current_directory(destination: []u8) usize {
  result := #syscall(79, &destination[0], destination.len)
  if result <= 0 { return 0 }
  return #cast(usize, result) - 1
}
fn native_change_directory(path: []const u8) bool {
  storage: [4096]u8
  if path.len >= storage.len { return false }
  encoded := cstring.bounded(storage[..], path) catch { return false }
  return #syscall(80, encoded) == 0
}
fn native_process_id() u32 {
  return #cast(u32, #syscall(39))
}
fn native_small_pages(memory: []u8) {
  // Static arrays need not start on a page boundary. Advise only the pages
  // containing this valid span; both endpoint pages already belong to it.
  address := #cast(usize, &memory[0])
  prefix := address % 4096
  if memory.len > #cast(usize, -1) - prefix - 4095 { return }
  length := (memory.len + prefix + 4095) / 4096 * 4096
  _ = #syscall(28, address - prefix, length, 15)
}

fn native_environment(name: []const u8, destination: []u8) []u8!io.IoErr {
  temporary := arena_owner.create(0)
  defer arena_owner.release(temporary)
  value := try process.environment(temporary, name)
  if value.len > destination.len { fail .Capacity }
  _ = mem.move(destination, value)
  return destination[..value.len]
}
fn native_arguments(arena: *mem.Arena) [][]const u8!io.IoErr {
  return try process.arguments(arena)
}
