use "std/mem"

// :[range]sort[!] [i] [n] [u]: sort whole lines. Without a range it sorts
// the whole file, as in Vim. ! reverses, i ignores case, n compares the first
// decimal number in each line (lines without one sort first), u keeps one of
// each run of equal lines. One undo restores the original order.
struct SortOptions { reverse, ignore_case, numeric, unique: bool }

fn vim_ex_sort(app: *App, doc: *buffer.Document, range_in: VimRange, text: str, start: usize, bang: bool) bool {
  range := range_in
  if range.given == 0 {
    range.first = 0
    range.last = vim_last_row(doc)
  }
  options := SortOptions{reverse: bang}
  at := start
  for at < text.len && text[at] != '|' && text[at] != '"' {
    byte := text[at]
    if byte == 'i' {
      options.ignore_case = true
    } else if byte == 'n' {
      options.numeric = true
    } else if byte == 'u' {
      options.unique = true
    } else if byte != ' ' && byte != 9 { return vim_ex_fail(app, "E474: Invalid argument") }
    at += 1
  }
  if !vim_range_valid(app, doc, range) { return true }
  low := buffer.line_position(doc, range.first + 1)
  high := doc.length
  if range.last < vim_last_row(doc) {
    high = buffer.line_position(doc, range.last + 2)
  }
  if high <= low { return true }
  mark := mem.arena_mark(app.scratch)
  defer mem.arena_rewind(app.scratch, mark)
  source := mem.push_bytes(app.scratch, high - low)
  buffer.copy_range(doc, low, high, source)
  // A range ending at the end of a file without a final newline keeps it so.
  final_newline := source[source.len - 1] == 10
  count: usize = 0
  for byte in source {
    if byte == 10 {
      count += 1
    }
  }
  if !final_newline {
    count += 1
  }
  lines := mem.push_array<str>(app.scratch, count)
  scratch := mem.push_array<str>(app.scratch, count)
  line: usize = 0
  begin: usize = 0
  for index in 0..source.len {
    if source[index] == 10 {
      lines[line] = source[begin..index]
      line += 1
      begin = index + 1
    }
  }
  if !final_newline {
    lines[line] = source[begin..]
  }
  sort_lines(lines, scratch, options)
  output := mem.push_bytes(app.scratch, source.len)
  used: usize = 0
  kept: usize = 0
  for index in 0..count {
    if options.unique && kept > 0 && sort_compare(lines[index], lines[index - 1], options) == 0 {
      continue
    }
    if lines[index].len > 0 {
      buffer.copy(output[used..], lines[index])
      used += lines[index].len
    }
    if index + 1 < count || final_newline {
      output[used] = 10
      used += 1
    }
    kept += 1
  }
  if !app.vim.ex.batch {
    app.prompt_state.panel = .None
  }
  buffer.checkpoint(doc)
  doc.anchor = low
  doc.cursor = high
  if !buffer.replace(doc, output[..used]) {
    return vim_ex_fail(app, "Sorting exceeds document capacity.")
  }
  buffer.checkpoint(doc)
  doc.anchor = low
  doc.cursor = low
  if app.config.vim_keys {
    vim_place(app, low)
  }
  if count != kept {
    message: [64]u8
    message_used := copy_text(message[..], "")
    add_number(message[..], &message_used, count - kept)
    add_text(message[..], &message_used, " duplicate lines removed")
    status_note(app, message[..message_used])
  }
  return true
}

// Stable merge sort, so equal lines keep their order.
fn sort_lines(lines: []str, scratch: []str, options: SortOptions) {
  width: usize = 1
  for width < lines.len {
    low: usize = 0
    for low < lines.len {
      middle := low + width
      if middle > lines.len {
        middle = lines.len
      }
      high := middle + width
      if high > lines.len {
        high = lines.len
      }
      left := low
      right := middle
      out := low
      for left < middle || right < high {
        take_left := right >= high
        if left < middle && right < high {
          order := sort_compare(lines[left], lines[right], options)
          if options.reverse {
            take_left = order >= 0
          } else {
            take_left = order <= 0
          }
        }
        if take_left {
          scratch[out] = lines[left]
          left += 1
        } else {
          scratch[out] = lines[right]
          right += 1
        }
        out += 1
      }
      low = high
    }
    for index in 0..lines.len {
      lines[index] = scratch[index]
    }
    width *= 2
  }
}

fn sort_compare(a: str, b: str, options: SortOptions) i32 {
  if options.numeric {
    a_value := sort_number(a) catch {
      _ = sort_number(b) catch { return 0 }
      return -1
    }
    b_value := sort_number(b) catch { return 1 }
    if a_value < b_value { return -1 }
    if a_value > b_value { return 1 }
    return 0
  }
  length := a.len
  if b.len < length {
    length = b.len
  }
  for index in 0..length {
    x := a[index]
    y := b[index]
    if options.ignore_case {
      x = lower(x)
      y = lower(y)
    }
    if x != y {
      if x < y { return -1 }
      return 1
    }
  }
  if a.len == b.len { return 0 }
  if a.len < b.len { return -1 }
  return 1
}

// The first decimal number in a line, with a directly preceding minus sign.
fn sort_number(line: str) i64! {
  for index in 0..line.len {
    if line[index] >= '0' && line[index] <= '9' {
      negative := index > 0 && line[index - 1] == '-'
      value: i64 = 0
      at := index
      for at < line.len && line[at] >= '0' && line[at] <= '9' && value < 100000000000000000 {
        value = value * 10 + (line[at] - '0')
        at += 1
      }
      if negative {
        value = 0 - value
      }
      return value
    }
  }
  fail
}
