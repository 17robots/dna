use "../../src/settings" settings
fn main() {
  direct := settings.Settings{}
  defaults := settings.Settings{}
  settings.defaults(&defaults)
  if direct.completion_delay_ms != 25.0 || defaults.completion_delay_ms != 25.0 || defaults.lsp_change_delay_ms != 50.0 || defaults.cursor_animation_ms != 50.0 || defaults.scroll_animation_ms != 50.0 || defaults.popup_animation_ms != 50.0 {
    #panic("interactive timing defaults")
  }
  timing := settings.Settings{}
  if !settings.parse("[lsp]\ncompletion_delay_ms = 10\n", &timing) || timing.completion_delay_ms != 10.0 || !settings.parse("[lsp]\ncompletion_delay_ms = 50\n", &timing) || timing.completion_delay_ms != 50.0 || settings.parse("[lsp]\ncompletion_delay_ms = 9\n", &timing) {
    #panic("completion timing bounds and explicit compatibility")
  }
  parsed := settings.Settings{}
  _ = settings.parse("font_size = 24\nline_height = 1.2\nfont = \"/tmp/font.ttf\"\nindent_width = 2\nreduced_motion = true\n", &parsed)
  if !parsed.ok || parsed.font_size != 24.0 || parsed.indent_width != 2 || !parsed.reduced_motion || parsed.font_length != 13 {
    #panic("config values")
  }
  duplicate := settings.Settings{}
  _ = settings.parse("font_size = 20\nfont_size = 22\n", &duplicate)
  if duplicate.ok || duplicate.error_line != 2 {
    #panic("config duplicate")
  }
  if settings.parse("font_size = 400\n", &parsed) || settings.parse("unknown = true\n", &parsed) || settings.parse("indent_width = 1.5\n", &parsed) {
    #panic("config bounds")
  }
  if !settings.parse("# defaults\n", &parsed) {
    #panic("empty config")
  }
  if !parsed.explorer_icons || !parsed.explorer_columns || !parsed.explorer_preview {
    #panic("explorer defaults")
  }
  if !settings.parse("explorer_icons = false\nexplorer_columns = false\nexplorer_preview = false\n", &parsed) || parsed.explorer_icons || parsed.explorer_columns || parsed.explorer_preview {
    #panic("explorer settings")
  }
  if settings.parse("explorer_icons = true\nexplorer_icons = false", &parsed) {
    #panic("duplicate explorer setting")
  }
  if !settings.parse("[editor]\nfont_size = 15\nfont_family = \"monospace\"\npadding = 12\n[cursor]\nsmooth = false\nanimation_ms = 0\n", &parsed) || parsed.font_size != 15.0 || parsed.document_padding != 12.0 || parsed.smooth_cursor || parsed.cursor_animation_ms != 0.0 {
    #panic("sectioned settings")
  }
  if parsed.cursor_trail_size != 1.0 || !settings.parse("[cursor]\ntrail_size = 0.5\n", &parsed) || parsed.cursor_trail_size != 0.5 || settings.parse("[cursor]\ntrail_size = 2\n", &parsed) {
    #panic("cursor trail setting")
  }
  if settings.parse("document_padding = 12\n[editor]\npadding = 20", &parsed) || settings.parse("[editor]\npadding = -1", &parsed) || settings.parse("[unknown]\nx = true", &parsed) {
    #panic("section validation")
  }
  if !settings.parse("[languages.dyn]\nindent_width = 4\ninsert_tabs = true\nformatter = \"dyn fmt -\"\nformat_on_save = true\nserver = \"dyn lsp\"\nauto_start = true\nextensions = \".dyn,.dy\"\n", &parsed) {
    #panic("language settings")
  }
  language := settings.language(&parsed, "dyn")
  if language == nil || language.indent_width != 4 || !language.insert_tabs || !language.format_on_save || !language.auto_start || language.server_length != 7 {
    #panic("language values")
  }
  if settings.parse("[languages.dyn]\nserver = \"a\"\nserver = \"b\"", &parsed) || settings.parse("[languages.]", &parsed) || settings.parse("[languages.dyn]\nindent_width = 17", &parsed) {
    #panic("language validation")
  }
  colors := settings.Palette{}
  if !settings.parse_palette("diagnostic_error = \"#123456\"\ndiagnostic_warning = \"#abcdef\"\n", &colors) || colors.colors[30] != 1193046 || colors.colors[31] != 11259375 {
    #panic("diagnostic palette")
  }
  if !settings.parse_palette("base = \"light\"\nbackground = \"#0123aB\"\nsyntax_keyword = \"#123456\"\nterminal_red = \"#FF0000\"\n", &colors) || !colors.light || colors.colors[1] != 74667 || colors.colors[10] != 1193046 || colors.colors[15] != 16711680 {
    #panic("custom theme colors")
  }
  if settings.parse_palette("text = \"#12345Z\"", &colors) || settings.parse_palette("unknown = \"#123456\"", &colors) || settings.parse_palette("text = \"#123456\"\ntext = \"#abcdef\"", &colors) {
    #panic("invalid theme accepted")
  }
  if !settings.parse_palette("base = \"charcoal\"", &colors) || colors.mask != 0 || colors.light {
    #panic("theme base inheritance")
  }
  names := settings.BuiltinThemeNames
  at: usize = 0
  count: usize = 0
  for at < #len(names) {
    end := at
    for names[end] != 10 {
      end += 1
    }
    builtin := settings.Palette{}
    if !settings.builtin_palette(names[at..end], &builtin) {
      #panic("built-in theme name")
    }
    if count >= 2 && (builtin.mask != 0xFFFFFFFF || builtin.colors[1] == builtin.colors[4]) {
      #panic("built-in theme palette")
    }
    count += 1
    at = end + 1
  }
  if count < 10 || settings.builtin_palette("no-such-theme", &colors) {
    #panic("built-in theme list")
  }
  if !settings.builtin_palette("gruvbox-light", &colors) || !colors.light || colors.colors[1] != 0xFBF1C7 {
    #panic("light built-in theme")
  }
  if !settings.parse_palette("background = \"#010203\"\nbase = \"nord\"\ntext = \"#040506\"\n", &colors) || colors.mask != 0xFFFFFFFF || colors.light || colors.colors[1] != 0x010203 || colors.colors[4] != 0x040506 || colors.colors[10] != 0x81A1C1 {
    #panic("built-in theme base")
  }
  if !settings.parse_palette("base = \"kanagawa\"", &colors) || !colors.italic_set || colors.italic != 5 || !settings.parse_palette("base = \"kanagawa\"\nitalic = \"\"", &colors) || colors.italic != 0 {
    #panic("built-in theme italics")
  }
  if settings.parse_palette("base = \"no-such-theme\"", &colors) || settings.parse_palette("text = \"#123456\"\nbase = \"nord\"\ntext = \"#abcdef\"", &colors) {
    #panic("invalid theme base accepted")
  }
  // mode = "default" restores a surface's usual place before later keys.
  if !settings.parse("[place.picker]\nside = \"left\"\nsize = 0.3\nmode = \"default\"\nanchor = \"top-right\"\nwidth = 312.5", &parsed) || parsed.places[1].mode != settings.PlaceFloat || parsed.places[1].anchor != 2 || parsed.places[1].size != 0.0 || parsed.places[1].width != 312.5 {
    #panic("place mode default")
  }
  if !settings.parse("theme = \"~/themes/custom.toml\"", &parsed) || #len(parsed.theme_path) == 0 {
    #panic("config custom theme path")
  }
  editorconfig_checks()
  project_checks()
}

fn editorconfig_checks() {
  // Formerly exponential: the test runner's deadline also gates this regression.
  difficult := "*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*b"
  if settings.glob_match(difficult, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") {
    #panic("adversarial glob matched")
  }
  if !settings.glob_match(difficult, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab") {
    #panic("long wildcard match rejected")
  }
  if settings.glob_match("{a,*a}{a,*a}{a,*a}{a,*a}{a,*a}{a,*a}{a,*a}{a,*a}{a,*a}{a,*a}b", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") {
    #panic("adversarial alternatives matched")
  }
  globs: [17][]const u8 = ["*", "*.py", "src/*.c", "**.js", "{*.json,*.yml}", "file[0-9].txt", "file[!0-9].txt", "?.md", "lib/**/x.c", "v{1..3}.txt", "a\\*b", "{a,b{c,d}}.t", "*.{py,pyi}", "Makefile", "[Mm]akefile", "docs/*.md", "*.c"]
  paths: [17][]const u8 = ["x.txt", "main.py", "src/m.c", "a/b/c.js", "c.yml", "file7.txt", "filex.txt", "r.md", "lib/a/b/x.c", "v2.txt", "a*b", "bd.t", "m.pyi", "Makefile", "makefile", "docs/a.md", "m.c"]
  for index in 0..17 {
    if !settings.glob_match(globs[index], paths[index]) {
      #panic("glob should match")
    }
  }
  misses: [8][]const u8 = ["*.py", "src/*.c", "file[0-9].txt", "file[!0-9].txt", "?.md", "v{1..3}.txt", "{a,b}.t", "*.c"]
  miss_paths: [8][]const u8 = ["main.pyc", "src/a/m.c", "filex.txt", "file7.txt", "rr.md", "v4.txt", "c.t", "src/m.cc"]
  for index in 0..8 {
    if settings.glob_match(misses[index], miss_paths[index]) {
      #panic("glob should not match")
    }
  }
  // Globs without '/' match in any directory; with '/' they are anchored.
  if !settings.editorconfig_section_matches("*.py", "pkg/sub/m.py") || settings.editorconfig_section_matches("/src/*.c", "lib/src/m.c") || !settings.editorconfig_section_matches("/src/*.c", "src/m.c") {
    #panic("editorconfig section anchoring")
  }
  text := "# comment\nroot = true\n\n[*]\nindent_style = space\nindent_size = 4\ninsert_final_newline = true\n\n[*.go]\nindent_style = tab\nindent_size = unset\n\n[Makefile]\nindent_style = tab\ntab_width = 8\nTrim_Trailing_Whitespace = TRUE\n"
  if !settings.editorconfig_root(text) || settings.editorconfig_root("[*]\nroot = true\n") {
    #panic("editorconfig root")
  }
  result := settings.EditorConfig{}
  settings.editorconfig_apply(text, "cmd/main.go", &result)
  if !result.matched || result.indent_style != settings.EditorTab || result.indent_size != 0 || result.insert_final_newline != 2 {
    #panic("editorconfig go")
  }
  result = settings.EditorConfig{}
  settings.editorconfig_apply(text, "Makefile", &result)
  if result.indent_style != settings.EditorTab || result.indent_size != 4 || result.tab_width != 8 || result.trim_trailing_whitespace != 2 {
    #panic("editorconfig makefile")
  }
  result = settings.EditorConfig{}
  settings.editorconfig_apply("[*.md]\nindent_size = 2\n", "notes.txt", &result)
  if result.matched || result.indent_size != 0 {
    #panic("editorconfig unmatched")
  }
}

fn project_checks() {
  // Theme and fonts are personal: a dna.toml cannot set them.
  global := settings.Settings{}
  if !settings.parse("theme = \"nord\"\nfont_size = 14", &global) {
    #panic("global personal keys")
  }
  layer := settings.Layer{project: true, trusted: true}
  if !settings.parse_layer("theme = \"dracula\"\nfont_size = 30\nindent_width = 2\n", &global, &layer) || buffer_text_differs(global.theme_path, "nord") || global.font_size != 14.0 || global.indent_width != 2 || layer.skipped_count != 2 || layer.skip_reasons[0] != settings.SkipPersonal {
    #panic("project personal keys")
  }
  // [project."PATH"] sections: skipped by the plain parse, extracted for a
  // matching location with every other line blanked.
  source := "indent_width = 3\n[project.\"~/work/app\"]\ntheme = \"dracula\"\n\n[project.\"/srv/other\"]\ntheme = \"nord\"\n[project.\"~/work\"]\nfont_size = 20\n"
  plain := settings.Settings{}
  if !settings.parse(source, &plain) || plain.indent_width != 3 || #len(plain.theme_path) != 0 {
    #panic("project sections skipped")
  }
  output: [512]u8 = []
  at: usize = 0
  matched: usize = 0
  for settings.project_section_next(source, "/home/u/work/app/src/main.c", "/home/u", &at, output[..#len(source)]) {
    section := settings.Settings{}
    section_layer := settings.Layer{project: true, trusted: true, session: true}
    settings.defaults(&section)
    if !settings.parse_layer(output[..#len(source)], &section, &section_layer) {
      #panic("project section parse")
    }
    if matched == 0 && buffer_text_differs(section.theme_path, "dracula") {
      #panic("first project section")
    }
    if matched == 1 && section.font_size != 20.0 {
      #panic("second project section")
    }
    matched += 1
  }
  if matched != 2 {
    #panic("project section count")
  }
  // ~/work/app does not hold ~/work/application; ~/work does.
  at = 0
  matched = 0
  for settings.project_section_next(source, "/home/u/work/application", "/home/u", &at, output[..#len(source)]) {
    matched += 1
  }
  if matched != 1 {
    #panic("project path boundary")
  }
  invalid := settings.Settings{}
  project_layer := settings.Layer{project: true}
  if settings.parse_layer("[project.\"/x\"]\ntheme = \"nord\"\n", &invalid, &project_layer) {
    #panic("dna.toml cannot hold project sections")
  }
}
fn buffer_text_differs(text: []const u8, expected: []const u8) bool {
  if #len(text) != #len(expected) {
    return true
  }
  for index in 0..#len(text) {
    if text[index] != expected[index] {
      return true
    }
  }
  return false
}
