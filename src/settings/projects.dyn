// [project."PATH"] sections in the global config: personal settings for one
// project (a theme to tell it apart, a font size). They live in your own
// file, so unlike a repository's dna.toml they may set personal keys and need
// no :trust. Only top-level keys are allowed inside one.

pub struct SectionPath { valid: bool, path: str }
pub fn project_section_path(section: str) SectionPath {
  if section.len < 11 || !buffer.equal(section[..9], "project.\"") || section[section.len - 1] != 34 {
    return SectionPath{}
  }
  path := section[9..section.len - 1]
  for byte in path {
    if byte == 34 { return SectionPath{} }
  }
  return SectionPath{valid: true, path: path}
}
// True when `location` is the section's directory or inside it. PATH may
// start with ~ for `home`.
fn project_path_contains(path: str, home: str, location: str) bool {
  expanded: [4096]u8
  used: usize = 0
  rest := path
  if path.len > 0 && path[0] == '~' && (path.len == 1 || path[1] == '/') {
    if home.len == 0 || home.len >= 4000 { return false }
    for byte in home {
      expanded[used] = byte
      used += 1
    }
    rest = path[1..]
  }
  if used + rest.len >= expanded.len { return false }
  for byte in rest {
    expanded[used] = byte
    used += 1
  }
  for used > 1 && expanded[used - 1] == '/' {
    used -= 1
  }
  if used == 0 || location.len < used || !buffer.equal(location[..used], expanded[..used]) {
    return false
  }
  return location.len == used || location[used] == '/' || expanded[used - 1] == '/'
}
// Finds the next [project."PATH"] section, from byte `at.*`, whose PATH
// holds `location`. Writes `source` to `output` with every other line
// emptied, so parse errors keep the file's line numbers, and returns true.
pub fn project_section_next(source: str, location: str, home: str, at: *usize, output: []u8) bool {
  if output.len < source.len { return false }
  for at.* < source.len {
    end := at.*
    for end < source.len && source[end] != 10 {
      end += 1
    }
    line := trim(source[at.*..end])
    at.* = end + 1
    if line.len < 2 || line[0] != 91 || line[line.len - 1] != 93 { continue }
    section := project_section_path(line[1..line.len - 1])
    if !section.valid || !project_path_contains(section.path, home, location) { continue }
    // Keep this section's lines up to the next header; blank the rest.
    body_start := at.*
    body_end := body_start
    for body_end < source.len {
      line_end := body_end
      for line_end < source.len && source[line_end] != 10 {
        line_end += 1
      }
      body_line := trim(source[body_end..line_end])
      if body_line.len > 0 && body_line[0] == 91 { break }
      body_end = line_end + 1
    }
    if body_end > source.len {
      body_end = source.len
    }
    for byte, index in source {
      if byte != 10 && (index < body_start || index >= body_end) {
        byte = 32
      }
      output[index] = byte
    }
    return true
  }
  return false
}
