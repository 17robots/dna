use "./buffer" buffer
use "std/mem"
use "std/time"
use "std/io"
fn main() {
  owner := mem.arena_create(#sizeof(buffer.Document))
  defer mem.arena_release(owner)
  doc := buffer.allocate(owner)
  text: [1000000]u8 = []
  at: usize = 0
  for at < 1000000 {
    text[at] = 97
    if at % 80 == 79 {
      text[at] = 10
    }
    at += 1
  }
  _ = buffer.load(doc, text[..])
  dirty_mode: usize = 0
  for dirty_mode < 2 {
    started := time.monotonic_now()
    checks: usize = 0
    for checks < 2000 {
      changed: bool = false
      if dirty_mode == 0 {
        changed = buffer.dirty(doc)
      } else {
        changed = buffer.dirty_cached(doc)
      }
      if changed {
        #panic("dirty benchmark changed clean document")
      }
      checks += 1
    }
    dirty_elapsed := time.elapsed(started, time.monotonic_now()).value
    _ = io.println(io.stdout(), "dirty mode {}: 2000 checks, {} ns", dirty_mode, dirty_elapsed)
    dirty_mode += 1
  }
  position: usize = 0
  for position < 3 {
    before := time.monotonic_now()
    step: usize = 0
    for step < 200 {
      point: usize = 0
      if position == 1 {
        point = doc.length / 2
      } else if position == 2 {
        point = doc.length
      }
      buffer.move_to(doc, point, false)
      _ = buffer.replace(doc, "z")
      if !buffer.dirty_cached(doc) {
        #panic("insert must mark document dirty")
      }
      buffer.erase(doc, true)
      if buffer.dirty_cached(doc) {
        #panic("backspace must restore clean document")
      }
      step += 1
    }
    elapsed := time.elapsed(before, time.monotonic_now()).value / 400
    _ = io.println(io.stdout(), "position {} mean edit {} ns", position, elapsed)
    if doc.length != 1000000 || !buffer.equal(doc.bytes[..doc.length], text[..]) {
      #panic("benchmark edit corrupted text")
    }
    position += 1
  }
  for location in 0..3 {
    point: usize = 0
    if location == 1 {
      point = 500000
    }
    if location == 2 {
      point = 999998
    }
    before := time.monotonic_now()
    for step in 0..200 {
      document_replace: [2][]const u8 = ["z", "a"]
      for replacement in document_replace {
        doc.anchor = point
        doc.cursor = point + 1
        if !buffer.replace(doc, replacement) {
          #panic("equal-length replacement")
        }
      }
    }
    elapsed := time.elapsed(before, time.monotonic_now()).value / 400
    _ = io.println(io.stdout(), "position {} mean equal-length replacement {} ns", location, elapsed)
    if !buffer.equal(doc.bytes[..doc.length], text[..]) || doc.line_count != 12501 {
      #panic("equal-length replacement changes text or lines")
    }
  }

  // Keep whole-range commands and numeric jumps visible alongside keystroke costs.
  sizes: [3]usize = [1000, 5000, 10000]
  for rows in sizes {
    _ = buffer.load(doc, text[..rows * 80])
    doc.anchor = 0
    doc.cursor = doc.length
    started := time.monotonic_now()
    if !buffer.indent_lines_by(doc, false, 1, 4, false) {
      #panic("bulk indentation benchmark")
    }
    elapsed := time.elapsed(started, time.monotonic_now()).value
    _ = io.println(io.stdout(), "indent {} rows: {} ns", rows, elapsed)
    buffer.undo(doc)
    if !buffer.equal(doc.bytes[..doc.length], text[..rows * 80]) {
      #panic("bulk indentation undo")
    }
  }
  _ = buffer.load(doc, text[..])
  checksum: usize = 0
  started := time.monotonic_now()
  for step in 0..10000 {
    checksum += buffer.line_position(doc, 12001 + step % 500)
  }
  elapsed := time.elapsed(started, time.monotonic_now()).value
  if checksum != 9799600000 {
    #panic("numeric jump benchmark")
  }
  _ = io.println(io.stdout(), "10000 indexed numeric jumps: {} ns", elapsed)
}
