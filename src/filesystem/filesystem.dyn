// DNA's filesystem boundary supplements the SDK's portable byte I/O.
use std_fs "std/fs"
use "std/mem"
use "std/io"

pub type File = std_fs.File
pub type Metadata = std_fs.Metadata
// Identity of an open file's current contents: equal stamps mean nothing
// replaced or rewrote it in between.
pub struct Stamp { inode, size, modify_seconds, modify_nanos, change_seconds, change_nanos: u64, valid: bool }
pub type DirectoryEntry = std_fs.DirectoryEntry
pub struct AtomicFile { file: File, destination, temporary: []const u8, active: bool }

pub fn open(path: []const u8) File!io.IoErr {
  return try std_fs.open(path)
}
pub fn create(path: []const u8) File!io.IoErr {
  return try std_fs.create(path)
}
pub fn create_exclusive(path: []const u8) File!io.IoErr {
  return try std_fs.create_exclusive(path)
}
pub fn append(path: []const u8) File!io.IoErr {
  return try std_fs.append(path)
}
pub fn adopt_handle(handle: isize) File {
  return std_fs.adopt_handle(handle)
}
pub fn is_open(file: *const File) bool {
  return std_fs.is_open(file)
}
pub fn close(file: *File) {
  std_fs.close(file)
}
// Moves ownership out of file, leaving it unopened.
pub fn take(file: *File) File {
  owned := file.*
  file.* = File{}
  return owned
}
pub fn read(file: *File, destination: []u8) usize!io.IoErr {
  return try std_fs.read(file, destination)
}
pub fn write(file: *File, source: []const u8) !io.IoErr {
  try std_fs.write(file, source)
}
// Position only the private save output; source descriptors stay unchanged.
pub fn seek(file: *File, offset: usize) !io.IoErr {
  if offset > 9223372036854775807 { fail .InvalidInput }
  _ = try std_fs.seek(file, #cast(isize, offset), 0)
}
pub fn sync(file: *File) !io.IoErr {
  try std_fs.sync(file)
}
pub fn read_all(arena: *mem.Arena, path: []const u8, maximum: usize) []u8!io.IoErr {
  return try std_fs.read_all(arena, path, maximum)
}
pub fn write_all(path: []const u8, source: []const u8) !io.IoErr {
  try std_fs.write_all(path, source)
}

// Borrow paths until commit/abort. The caller supplies a sibling temporary.
pub fn atomic_begin(destination: []const u8, temporary: []const u8) AtomicFile!io.IoErr {
  if destination.len == 0 || temporary.len == 0 { fail .InvalidInput }
  created := try atomic_create_exclusive(temporary)
  return AtomicFile{ file: created, destination: destination, temporary: temporary, active: true }
}
pub fn atomic_commit(transaction: *AtomicFile) !io.IoErr {
  if !transaction.active { fail .InvalidInput }
  try sync(&transaction.file)
  close(&transaction.file)
  try rename(transaction.temporary, transaction.destination)
  transaction.active = false
}
pub fn atomic_abort(transaction: *AtomicFile) !io.IoErr {
  if !transaction.active { fail .InvalidInput }
  if is_open(&transaction.file) {
    close(&transaction.file)
  }
  try remove(transaction.temporary)
  transaction.active = false
}

// Private session/recovery contents must never be exposed through a temporary
// file created with a broader inherited/default access policy.
pub fn atomic_begin_private(destination: []const u8, temporary: []const u8) AtomicFile!io.IoErr {
  if destination.len == 0 || temporary.len == 0 { fail .InvalidInput }
  created := try create_private_exclusive(temporary)
  return AtomicFile{ file: created, destination: destination, temporary: temporary, active: true }
}
