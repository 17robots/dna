#target(kernel: windows)
#link("ucrt")

extern fn job_duplicate "_strdup"(text: *const u8) *u8
fn pred_find(text: *const u8, length: usize, needle: *const u8, size: usize) rawptr {
  if size == 0 {
    return #cast(rawptr, text)
  }
  if size > length {
    return nil
  }
  for index in 0..=length - size {
    if text[..length][index] == needle.* && pred_compare(&text[..length][index], needle, size) == 0 {
      return #cast(rawptr, &text[..length][index])
    }
  }
  return nil
}

use "std/dynlib" predicate_library
use "std/sync" predicate_sync
predicate_once: predicate_sync.Once
predicate_compare: fn(*const u8, *const u8, usize)i32
predicate_byte:fn(*const u8, i32, usize)rawptr
predicate_string:fn(*const u8, *const u8)i32
fn predicate_initialize() {
  if predicate_sync.once_begin(&predicate_once) {
    library:=predicate_library.open("ucrtbase.dll", predicate_library.Now)
    if !library.ok {
      #panic("cannot load Windows predicate CRT")
    }
    symbol:=predicate_library.symbol(library.value, "memcmp")
    if !symbol.ok {
      #panic("missing Windows predicate comparison")
    }
    predicate_compare=#cast(fn(*const u8, *const u8, usize)i32, symbol.value)
    found:=predicate_library.symbol(library.value, "memchr")
    compared:=predicate_library.symbol(library.value, "strcmp")
    if !found.ok || !compared.ok {
      #panic("missing Windows search CRT")
    }
    predicate_byte=#cast(fn(*const u8, i32, usize)rawptr, found.value)
    predicate_string=#cast(fn(*const u8, *const u8)i32, compared.value)
    predicate_sync.once_complete(&predicate_once)
  }
}
fn pred_compare(left:*const u8, right:*const u8, length:usize)i32 {
  predicate_initialize()
  return predicate_compare(left, right, length)
}

fn search_byte(bytes:*const u8, value:i32, length:usize)rawptr {
  predicate_initialize()
  return predicate_byte(bytes, value, length)
}
fn search_compare(left:*const u8, right:*const u8)i32 {
  predicate_initialize()
  return predicate_string(left, right)
}
