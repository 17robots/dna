#target(kernel: windows)

// Console records provide bounded raw input without a detached blocking reader.
// The wake event is first in the wait set, so ignored/key-up floods cannot
// starve cancellation. Leave waits for the sole reader before closing handles.
struct WinTtyCoordinate { x, y: i16 }
struct WinTtyRectangle { left, top, right, bottom: i16 }
struct WinTtyScreen { size, cursor: WinTtyCoordinate, attributes: u16, window: WinTtyRectangle, maximum: WinTtyCoordinate }
struct WinTtyRecord { kind, padding: u16, data: [4]u32 }
struct WinTtyKey { down: i32, repeat, key, scan, character: u16, control: u32 }
struct WinTtyMouse { position: WinTtyCoordinate, buttons, control, flags: u32 }
struct WinTtyStartup { size: u32, reserved, desktop, title: rawptr, x, y, width, height, columns, rows, fill, flags: u32, show, reserved_size: u16, reserved_bytes, input, output, error: rawptr }
struct WinTtyProcess { process, thread: rawptr, pid, tid: u32 }
struct WinTtyHandoff { executable, command, argument: [32768]u16, environment: [65536]u16 }
struct WinTtyAPI {
  standard: fn(u32) rawptr,
  mode: fn(rawptr, *u32) i32,
  set_mode: fn(rawptr, u32) i32,
  input_page, output_page: fn() u32,
  set_input_page, set_output_page: fn(u32) i32,
  screen: fn(rawptr, *WinTtyScreen) i32,
  create_event: fn(rawptr, i32, i32, *const u16) rawptr,
  set_event: fn(rawptr) i32,
  wait: fn(u32, *rawptr, i32, u32) u32,
  count: fn(rawptr, *u32) i32,
  read: fn(rawptr, *WinTtyRecord, u32, *u32) i32,
  duplicate: fn(rawptr, rawptr, rawptr, *rawptr, u32, i32, u32) i32,
  process: fn() rawptr,
  ticks: fn() u64,
  control: fn(fn(u32) i32, i32) i32,
  exit: fn(u32),
  command_line: fn() *const u16,
  arguments: fn(*const u16, *i32) **u16,
  local_free: fn(rawptr) rawptr,
  executable: fn(rawptr, *u16, u32) u32,
  environment: fn() *u16,
  free_environment: fn(*u16) i32,
  compare: fn(*const u16, i32, *const u16, i32, i32) i32,
  create_process: fn(*const u16, *u16, rawptr, rawptr, i32, u32, rawptr, rawptr, *WinTtyStartup, *WinTtyProcess) i32,
  wait_process: fn(rawptr, u32) u32,
}
win_tty_api: WinTtyAPI
win_tty_once: win_io_sync.Once
win_tty_lock: win_io_sync.Mutex
win_tty_idle: win_io_sync.Condition
win_tty_entered: bool
win_tty_closing: bool
win_tty_readers: usize
win_tty_input: rawptr
win_tty_output: rawptr
win_tty_wake: rawptr
win_tty_saved_input: u32
win_tty_saved_output: u32
win_tty_saved_input_page: u32
win_tty_saved_output_page: u32
win_tty_pending: [32]u8
win_tty_length: usize
win_tty_offset: usize
win_tty_repeat: u16
win_tty_surrogate: u16
win_tty_button: u32 = 3
win_tty_columns: i32
win_tty_rows: i32
win_tty_executable: [65536]u8
fn win_tty_prepare() {
  win_io_prepare()
  if win_io_sync.once_begin(&win_tty_once) {
    kernel := win_io_loader.open("kernel32.dll", 0)
    shell := win_io_loader.open("shell32.dll", 0)
    if !kernel.ok || !shell.ok {
      #panic("missing Windows console library")
    }
    win_tty_api.standard = #cast(fn(u32) rawptr, win_io_symbol(kernel.value, "GetStdHandle"))
    win_tty_api.mode = #cast(fn(rawptr, *u32)i32, win_io_symbol(kernel.value, "GetConsoleMode"))
    win_tty_api.set_mode = #cast(fn(rawptr, u32)i32, win_io_symbol(kernel.value, "SetConsoleMode"))
    win_tty_api.input_page = #cast(fn()u32, win_io_symbol(kernel.value, "GetConsoleCP"))
    win_tty_api.output_page = #cast(fn()u32, win_io_symbol(kernel.value, "GetConsoleOutputCP"))
    win_tty_api.set_input_page = #cast(fn(u32)i32, win_io_symbol(kernel.value, "SetConsoleCP"))
    win_tty_api.set_output_page = #cast(fn(u32)i32, win_io_symbol(kernel.value, "SetConsoleOutputCP"))
    win_tty_api.screen = #cast(fn(rawptr, *WinTtyScreen)i32, win_io_symbol(kernel.value, "GetConsoleScreenBufferInfo"))
    win_tty_api.create_event = #cast(fn(rawptr, i32, i32, *const u16)rawptr, win_io_symbol(kernel.value, "CreateEventW"))
    win_tty_api.set_event = #cast(fn(rawptr)i32, win_io_symbol(kernel.value, "SetEvent"))
    win_tty_api.wait = #cast(fn(u32, *rawptr, i32, u32)u32, win_io_symbol(kernel.value, "WaitForMultipleObjects"))
    win_tty_api.count = #cast(fn(rawptr, *u32)i32, win_io_symbol(kernel.value, "GetNumberOfConsoleInputEvents"))
    win_tty_api.read = #cast(fn(rawptr, *WinTtyRecord, u32, *u32)i32, win_io_symbol(kernel.value, "ReadConsoleInputW"))
    win_tty_api.duplicate = #cast(fn(rawptr, rawptr, rawptr, *rawptr, u32, i32, u32)i32, win_io_symbol(kernel.value, "DuplicateHandle"))
    win_tty_api.process = #cast(fn()rawptr, win_io_symbol(kernel.value, "GetCurrentProcess"))
    win_tty_api.ticks = #cast(fn()u64, win_io_symbol(kernel.value, "GetTickCount64"))
    win_tty_api.control = #cast(fn(fn(u32)i32, i32)i32, win_io_symbol(kernel.value, "SetConsoleCtrlHandler"))
    win_tty_api.exit = #cast(fn(u32), win_io_symbol(kernel.value, "ExitProcess"))
    win_tty_api.command_line = #cast(fn()*const u16, win_io_symbol(kernel.value, "GetCommandLineW"))
    win_tty_api.arguments = #cast(fn(*const u16, *i32)**u16, win_io_symbol(shell.value, "CommandLineToArgvW"))
    win_tty_api.local_free = #cast(fn(rawptr)rawptr, win_io_symbol(kernel.value, "LocalFree"))
    win_tty_api.executable = #cast(fn(rawptr, *u16, u32)u32, win_io_symbol(kernel.value, "GetModuleFileNameW"))
    win_tty_api.environment = #cast(fn()*u16, win_io_symbol(kernel.value, "GetEnvironmentStringsW"))
    win_tty_api.free_environment = #cast(fn(*u16)i32, win_io_symbol(kernel.value, "FreeEnvironmentStringsW"))
    win_tty_api.compare = #cast(fn(*const u16, i32, *const u16, i32, i32)i32, win_io_symbol(kernel.value, "CompareStringOrdinal"))
    win_tty_api.create_process = #cast(fn(*const u16, *u16, rawptr, rawptr, i32, u32, rawptr, rawptr, *WinTtyStartup, *WinTtyProcess)i32, win_io_symbol(kernel.value, "CreateProcessW"))
    win_tty_api.wait_process = #cast(fn(rawptr, u32)u32, win_io_symbol(kernel.value, "WaitForSingleObject"))
    win_io_sync.once_complete(&win_tty_once)
  }
}
fn win_tty_duplicate(handle: rawptr) rawptr {
  result: rawptr = nil
  process := win_tty_api.process()
  if win_tty_api.duplicate(process, handle, process, &result, 0, 0, 2)==0 {
    return nil
  }
  return result
}
fn win_tty_restore() {
  _=win_tty_api.set_mode(win_tty_input, win_tty_saved_input)
  _=win_tty_api.set_mode(win_tty_output, win_tty_saved_output)
  _=win_tty_api.set_input_page(win_tty_saved_input_page)
  _=win_tty_api.set_output_page(win_tty_saved_output_page)
}
fn tty_enter_host() bool {
  win_tty_prepare()
  win_io_sync.lock(&win_tty_lock)
  defer win_io_sync.unlock(&win_tty_lock)
  if win_tty_entered {
    return true
  }
  input:=win_tty_duplicate(win_tty_api.standard(4294967286))
  output:=win_tty_duplicate(win_tty_api.standard(4294967285))
  if input==nil || output==nil {
    if input!=nil {
      _=win_io_api.close(input)
    }
    if output!=nil {
      _=win_io_api.close(output)
    }
    return false
  }
  win_tty_input=input
  win_tty_output=output
  if win_tty_api.mode(input, &win_tty_saved_input)==0 || win_tty_api.mode(output, &win_tty_saved_output)==0 {
    _=win_io_api.close(input)
    _=win_io_api.close(output)
    win_tty_input=nil
    win_tty_output=nil
    return false
  }
  win_tty_saved_input_page=win_tty_api.input_page()
  win_tty_saved_output_page=win_tty_api.output_page()
  raw: u32=(win_tty_saved_input & ~#cast(u32, 359)) | 664
  if win_tty_api.set_mode(input, raw)==0 || win_tty_api.set_mode(output, win_tty_saved_output|13)==0 || win_tty_api.set_input_page(65001)==0 || win_tty_api.set_output_page(65001)==0 {
    win_tty_restore()
    _=win_io_api.close(input)
    _=win_io_api.close(output)
    win_tty_input=nil
    win_tty_output=nil
    return false
  }
  tty_input=win_io_adopt(input, 0)
  tty_output=win_io_adopt(output, 1)
  if tty_input<0 || tty_output<0 {
    // Adoption closes only failed handles. Restore through the console's
    // original standard handles when either duplicate was consumed on failure.
    _=win_tty_api.set_mode(win_tty_api.standard(4294967286), win_tty_saved_input)
    _=win_tty_api.set_mode(win_tty_api.standard(4294967285), win_tty_saved_output)
    _=win_tty_api.set_input_page(win_tty_saved_input_page)
    _=win_tty_api.set_output_page(win_tty_saved_output_page)
    if tty_input>=0 {
      _=rec_close(tty_input)
    }
    if tty_output>=0 {
      _=rec_close(tty_output)
    }
    win_tty_input=nil
    win_tty_output=nil
    tty_input=-1
    tty_output=-1
    return false
  }
  win_tty_wake=win_tty_api.create_event(nil, 0, 0, nil)
  if win_tty_wake==nil {
    win_tty_restore()
    _=rec_close(tty_input)
    _=rec_close(tty_output)
    win_tty_input=nil
    win_tty_output=nil
    tty_input=-1
    tty_output=-1
    return false
  }
  tty_wake_descriptor=0
  win_tty_closing=false
  win_tty_entered=true
  win_tty_length=0
  win_tty_repeat=0
  win_tty_surrogate=0
  win_tty_button=3
  _=tty_size_host(&win_tty_columns, &win_tty_rows)
  return true
}
fn tty_leave_host() {
  win_tty_prepare()
  win_io_sync.lock(&win_tty_lock)
  defer win_io_sync.unlock(&win_tty_lock)
  if !win_tty_entered {
    return
  }
  win_tty_closing=true
  _=win_tty_api.set_event(win_tty_wake)
  for win_tty_readers!=0 {
    win_io_sync.condition_wait(&win_tty_idle, &win_tty_lock)
  }
  win_tty_restore()
  _=rec_close(tty_input)
  _=rec_close(tty_output)
  _=win_io_api.close(win_tty_wake)
  win_tty_input=nil
  win_tty_output=nil
  win_tty_wake=nil
  tty_input=-1
  tty_output=-1
  tty_wake_descriptor=-1
  win_tty_entered=false
}
fn tty_wake_create() i32 {
  win_tty_prepare()
  win_io_sync.lock(&win_tty_lock)
  defer win_io_sync.unlock(&win_tty_lock)
  if win_tty_wake==nil {
    return -1
  }
  return 0
}
fn tty_wake_signal(bytes:*const u8) {
  _=bytes
  win_tty_prepare()
  win_io_sync.lock(&win_tty_lock)
  if win_tty_wake!=nil {
    _=win_tty_api.set_event(win_tty_wake)
  }
  win_io_sync.unlock(&win_tty_lock)
}
fn win_tty_control(number:u32)i32 {
  if number==2 || number==5 || number==6 {
    dna_tty_leave()
  }
  return 0
}
fn tty_register_handlers() {
  win_tty_prepare()
  _=tty_atexit(tty_exit_handler)
  _=win_tty_api.control(win_tty_control, 1)
}
fn tty_fatal_host(number:i32) {
  win_tty_prepare()
  win_tty_api.exit(#cast(u32, 128+number))
}
fn tty_suspend_host() i32 {
  return 0
}
fn tty_size_host(columns, rows:*i32)i32 {
  win_tty_prepare()
  handle:=win_tty_output
  if handle==nil {
    handle=win_tty_api.standard(4294967285)
  }
  screen:=WinTtyScreen{}
  if win_tty_api.screen(handle, &screen)==0 {
    return 0
  }
  width:=#cast(i32, screen.window.right)-#cast(i32, screen.window.left)+1
  height:=#cast(i32, screen.window.bottom)-#cast(i32, screen.window.top)+1
  if width<=0 || height<=0 {
    return 0
  }
  columns.*=width
  rows.*=height
  return 1
}
fn win_tty_put(byte:u8) {
  win_tty_pending[win_tty_length]=byte
  win_tty_length+=1
}
fn win_tty_text(text:[]const u8) {
  for byte in text {
    win_tty_put(byte)
  }
}
fn win_tty_number(number:u32) {
  digits:[10]u8=[]
  used:usize=0
  for {
    digits[used]=#cast(u8, number%10)+48
    used+=1
    number/=10
    if number==0 {
      break
    }
  }
  for used>0 {
    used-=1
    win_tty_put(digits[used])
  }
}
fn win_tty_rune(value:u32) {
  if value<128 {
    win_tty_put(#cast(u8, value))
  } else if value<2048 {
    win_tty_put(#cast(u8, 192|(value>>6)))
    win_tty_put(#cast(u8, 128|(value&63)))
  } else if value<65536 {
    win_tty_put(#cast(u8, 224|(value>>12)))
    win_tty_put(#cast(u8, 128|((value>>6)&63)))
    win_tty_put(#cast(u8, 128|(value&63)))
  } else {
    win_tty_put(#cast(u8, 240|(value>>18)))
    win_tty_put(#cast(u8, 128|((value>>12)&63)))
    win_tty_put(#cast(u8, 128|((value>>6)&63)))
    win_tty_put(#cast(u8, 128|(value&63)))
  }
}
fn win_tty_key(key:*const WinTtyKey) {
  if key.down==0 || key.repeat==0 {
    return
  }
  character:=#cast(u32, key.character)
  control:=key.control
  alt:bool=(control&3)!=0 && !((control&1)!=0 && (control&12)!=0)
  modifier:u32=1
  if (control&16)!=0 {
    modifier+=1
  }
  if alt {
    modifier+=2
  }
  if (control&12)!=0 {
    modifier+=4
  }
  if character!=0 || (key.key==32 && (control&12)!=0) {
    if character>=55296 && character<=56319 {
      win_tty_surrogate=key.character
      return
    }
    if alt {
      win_tty_put(27)
    }
    if win_tty_surrogate!=0 {
      if character>=56320 && character<=57343 {
        character=65536+(#cast(u32, win_tty_surrogate)-55296)*1024+character-56320
      } else {
        win_tty_rune(65533)
      }
      win_tty_surrogate=0
    } else if character>=56320 && character<=57343 {
      character=65533
    }
    if character==8 {
      character=127
    }
    if character==9 && (control&16)!=0 {
      win_tty_text("\x1b[Z")
    } else {
      win_tty_rune(character)
    }
  } else {
    letter:u8=0
    number:u32=0
    if key.key==37 {
      letter=68
    } else if key.key==38 {
      letter=65
    } else if key.key==39 {
      letter=67
    } else if key.key==40 {
      letter=66
    } else if key.key==36 {
      letter=72
    } else if key.key==35 {
      letter=70
    } else if key.key==45 {
      number=2
    } else if key.key==46 {
      number=3
    } else if key.key==33 {
      number=5
    } else if key.key==34 {
      number=6
    } else if key.key>=112 && key.key<=115 {
      letter=#cast(u8, key.key-112)+80
    } else if key.key>=116 && key.key<=123 {
      codes:[8]u32=[15, 17, 18, 19, 20, 21, 23, 24]
      number=codes[#cast(usize, key.key-116)]
    } else {
      return
    }
    if letter>=80 && letter<=83 && modifier==1 {
      win_tty_text("\x1bO")
      win_tty_put(letter)
    } else {
      win_tty_text("\x1b[")
      if number!=0 {
        win_tty_number(number)
      } else if modifier!=1 {
        win_tty_put(49)
      }
      if modifier!=1 {
        win_tty_put(59)
        win_tty_number(modifier)
      }
      if number!=0 {
        win_tty_put(126)
      } else {
        win_tty_put(letter)
      }
    }
  }
  win_tty_repeat=key.repeat
}
fn win_tty_mouse(mouse:*const WinTtyMouse) {
  screen:=WinTtyScreen{}
  if win_tty_api.screen(win_tty_output, &screen)==0 {
    return
  }
  x:=#cast(i32, mouse.position.x)-#cast(i32, screen.window.left)+1
  y:=#cast(i32, mouse.position.y)-#cast(i32, screen.window.top)+1
  if x<=0 || y<=0 {
    return
  }
  button:u32=3
  released:bool=false
  if (mouse.buttons&1)!=0 {
    button=0
  } else if (mouse.buttons&2)!=0 {
    button=2
  } else if (mouse.buttons&4)!=0 {
    button=1
  }
  if (mouse.flags&4)!=0 {
    button=64
    if (mouse.buttons&2147483648)!=0 {
      button=65
    }
  } else if (mouse.flags&8)!=0 {
    button=66
    if (mouse.buttons&2147483648)!=0 {
      button=67
    }
  } else if (mouse.flags&1)!=0 {
    button+=32
  } else if button==3 {
    button=win_tty_button
    released=true
  } else {
    win_tty_button=button
  }
  if (mouse.control&16)!=0 {
    button+=4
  }
  if (mouse.control&3)!=0 {
    button+=8
  }
  if (mouse.control&12)!=0 {
    button+=16
  }
  win_tty_text("\x1b[<")
  win_tty_number(button)
  win_tty_put(59)
  win_tty_number(#cast(u32, x))
  win_tty_put(59)
  win_tty_number(#cast(u32, y))
  if released {
    win_tty_put(109)
  } else {
    win_tty_put(77)
  }
  win_tty_repeat=1
}
fn win_tty_drain(buffer:*u8, capacity:i32)i32 {
  used:usize=0
  for used<#cast(usize, capacity) && win_tty_repeat>0 {
    buffer[..#cast(usize, capacity)][used]=win_tty_pending[win_tty_offset]
    used+=1
    win_tty_offset+=1
    if win_tty_offset==win_tty_length {
      win_tty_offset=0
      win_tty_repeat-=1
    }
  }
  return #cast(i32, used)
}
fn win_tty_read_end() {
  win_io_sync.lock(&win_tty_lock)
  win_tty_readers-=1
  win_io_sync.condition_broadcast(&win_tty_idle)
  win_io_sync.unlock(&win_tty_lock)
}
fn tty_read_host(buffer:*u8, capacity, timeout:i32)i32 {
  win_tty_prepare()
  if capacity<=0 {
    return 0
  }
  win_io_sync.lock(&win_tty_lock)
  if !win_tty_entered || win_tty_closing {
    win_io_sync.unlock(&win_tty_lock)
    return -1
  }
  if win_tty_readers!=0 {
    win_io_sync.unlock(&win_tty_lock)
    return 0
  }
  win_tty_readers=1
  targets:[2]rawptr=[win_tty_wake, win_tty_input]
  win_io_sync.unlock(&win_tty_lock)
  defer win_tty_read_end()
  if win_tty_repeat>0 {
    return win_tty_drain(buffer, capacity)
  }
  start:=win_tty_api.ticks()
  for {
    win_io_sync.lock(&win_tty_lock)
    closing:=win_tty_closing
    win_io_sync.unlock(&win_tty_lock)
    if closing {
      return -1
    }
    interval:u32=100
    if timeout>=0 {
      elapsed:=win_tty_api.ticks()-start
      if elapsed>=#cast(u64, timeout) {
        interval=0
      } else if #cast(u64, timeout)-elapsed<100 {
        interval=#cast(u32, #cast(u64, timeout)-elapsed)
      }
    }
    result:=win_tty_api.wait(2, &targets[0], 0, interval)
    if result==0 {
      return -2
    }
    if result==258 {
      columns:i32=0
      rows:i32=0
      if tty_size_host(&columns, &rows)!=0 && (columns!=win_tty_columns || rows!=win_tty_rows) {
        win_tty_columns=columns
        win_tty_rows=rows
        sync.store_u32(&tty_resize_pending, 1)
        return -2
      }
      if timeout>=0 && win_tty_api.ticks()-start>=#cast(u64, timeout) {
        return 0
      }
      continue
    }
    if result!=1 {
      return -1
    }
    count:u32=0
    if win_tty_api.count(win_tty_input, &count)==0 {
      return -1
    }
    if count==0 {
      continue
    }
    record:=WinTtyRecord{}
    received:u32=0
    if win_tty_api.read(win_tty_input, &record, 1, &received)==0 {
      return -1
    }
    if received==0 {
      continue
    }
    win_tty_length=0
    win_tty_offset=0
    if record.kind==4 {
      sync.store_u32(&tty_resize_pending, 1)
      return -2
    } else if record.kind==1 {
      win_tty_key(#cast(*const WinTtyKey, &record.data[0]))
    } else if record.kind==2 {
      win_tty_mouse(#cast(*const WinTtyMouse, &record.data[0]))
    }
    if win_tty_repeat>0 {
      return win_tty_drain(buffer, capacity)
    }
    if timeout>=0 && win_tty_api.ticks()-start>=#cast(u64, timeout) {
      return 0
    }
  }
  return -1
}
fn tty_arguments() isize {
  win_tty_prepare()
  count:i32=0
  arguments:=win_tty_api.arguments(win_tty_api.command_line(), &count)
  if arguments==nil {
    return -1
  }
  defer _=win_tty_api.local_free(#cast(rawptr, arguments))
  used:usize=0
  for index in 0..count {
    argument:=arguments[..#cast(usize, count)][#cast(usize, index)]
    units:usize=0
    for argument[..32768][units]!=0 && units<32767 {
      units+=1
    }
    amount:=win_io_host.utf8(65001, 128, argument, #cast(i32, units), &tty_command_line[used], #cast(i32, 65535-used), nil, nil)
    if amount<0 || (amount==0 && units!=0) {
      return -1
    }
    used+=#cast(usize, amount)
    tty_command_line[used]=0
    used+=1
    if used>=65535 {
      return -1
    }
  }
  return #cast(isize, used)
}
fn tty_executable_path() *const u8 {
  win_tty_prepare()
  wide:[32768]u16=[]
  size:=win_tty_api.executable(nil, &wide[0], 32768)
  if size==0 || size>=32768 {
    return nil
  }
  used:=win_io_host.utf8(65001, 128, &wide[0], #cast(i32, size), &win_tty_executable[0], 65535, nil, nil)
  if used<=0 {
    return nil
  }
  win_tty_executable[#cast(usize, used)]=0
  return &win_tty_executable[0]
}
fn win_tty_quote(output:[]u16, used:*usize, argument:*const u16) bool {
  if used.*>32760 {
    return false
  }
  if used.*!=0 {
    output[used.*]=32
    used.*+=1
  }
  output[used.*]=34
  used.*+=1
  at:usize=0
  for {
    slashes:usize=0
    for argument[..32768][at]==92 {
      slashes+=1
      at+=1
    }
    unit:=argument[..32768][at]
    count:=slashes
    if unit==34 || unit==0 {
      count*=2
    }
    if unit==34 {
      count+=1
    }
    if count+2>32767-used.* {
      return false
    }
    for index in 0..count {
      output[used.*]=92
      used.*+=1
    }
    if unit==0 {
      break
    }
    output[used.*]=unit
    used.*+=1
    at+=1
  }
  output[used.*]=34
  used.*+=1
  output[used.*]=0
  return true
}
fn win_tty_environment(space:*WinTtyHandoff, session:*const u8) bool {
  source:=win_tty_api.environment()
  if source==nil {
    return false
  }
  defer _=win_tty_api.free_environment(source)
  key:[]const u8="DNA_HANDOFF="
  for index in 0..#len(key) {
    space.argument[index]=#cast(u16, key[index])
  }
  if !win_io_path(session, space.argument[#len(key)..]) {
    return false
  }
  extra:usize=#len(key)
  for space.argument[extra]!=0 {
    extra+=1
  }
  extra+=1
  used:usize=0
  at:usize=0
  inserted:bool=false
  for source[..65536][at]!=0 {
    length:usize=0
    for at+length<65535 && source[..65536][at+length]!=0 {
      length+=1
    }
    if at+length>=65535 {
      return false
    }
    same:bool=length>=#len(key)
    if same {
      for index in 0..#len(key) {
        value:=source[..65536][at+index]
        if value>=97 && value<=122 {
          value-=32
        }
        if value!=#cast(u16, key[index]) {
          same=false
          break
        }
      }
    }
    if !same {
      if !inserted && win_tty_api.compare(&source[..65536][at], #cast(i32, length), &space.argument[0], #cast(i32, extra-1), 1)==3 {
        if extra>=65536-used {
          return false
        }
        for index in 0..extra {
          space.environment[used+index]=space.argument[index]
        }
        used+=extra
        inserted=true
      }
      if length+1>=65536-used {
        return false
      }
      for index in 0..=length {
        space.environment[used+index]=source[..65536][at+index]
      }
      used+=length+1
    }
    at+=length+1
  }
  if !inserted {
    if extra>=65536-used {
      return false
    }
    for index in 0..extra {
      space.environment[used+index]=space.argument[index]
    }
    used+=extra
  }
  space.environment[used]=0
  return true
}
fn tty_handoff_host(executable:*const u8, arguments:**const u8, session:*const u8) bool {
  win_tty_prepare()
  space:=#cast(*WinTtyHandoff, rec_alloc(1, #sizeof(WinTtyHandoff)))
  if space==nil {
    return false
  }
  defer rec_free(#cast(rawptr, space))
  if !win_io_path(executable, space.executable[..]) || !win_tty_environment(space, session) {
    return false
  }
  used:usize=0
  count:usize=0
  for count<256 && arguments[..256][count]!=nil {
    argument:=arguments[..256][count]
    if argument.*==0 {
      space.argument[0]=0
    } else if !win_io_path(argument, space.argument[..]) {
      return false
    }
    if !win_tty_quote(space.command[..], &used, &space.argument[0]) {
      return false
    }
    count+=1
  }
  if count==0 || count==256 {
    return false
  }
  startup:=WinTtyStartup{size:#cast(u32, #sizeof(WinTtyStartup))}
  child:=WinTtyProcess{}
  if win_tty_api.create_process(&space.executable[0], &space.command[0], nil, nil, 0, 1024, #cast(rawptr, &space.environment[0]), nil, &startup, &child)==0 {
    return false
  }
  _=win_io_api.close(child.thread)
  result:=win_tty_api.wait_process(child.process, 4294967295)
  _=win_io_api.close(child.process)
  return result==0
}
